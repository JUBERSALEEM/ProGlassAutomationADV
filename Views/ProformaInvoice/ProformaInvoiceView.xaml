<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.15" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ListBoxItem custom style: flat, no default selection borders -->
        <Style x:Key="InvoiceRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="14,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context Menu styling -->
        <Style x:Key="AppContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SideMenuBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style x:Key="AppMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  Margin="6,0,0,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="20,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Keyboard shortcuts scoped to this view -->
    <UserControl.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeleteInvoiceCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding ViewInvoiceCommand}"/>
        <KeyBinding Key="F2" Command="{Binding EditInvoiceCommand}"/>
    </UserControl.InputBindings>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,90,30,30">

                <!-- Header -->
                <DockPanel Margin="10,0,10,20">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Right-click a row for options  •  Del to delete  •  F2 to edit  •  Enter to view"
                                   FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Content="+ Add Sample Invoice"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddInvoiceCommand}"/>
                </DockPanel>

                <!-- Invoice List Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="All Invoices" Style="{StaticResource SectionTitleStyle}"/>

                        <Grid>
                            <!-- Table (visible when invoices exist) -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInvoices}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Table Header -->
                                <Border Background="{DynamicResource MenuHoverBrush}"
                                        CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="INVOICE NO" Style="{StaticResource GridHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="1" Text="CUSTOMER" Style="{StaticResource GridHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="2" Text="DATE" Style="{StaticResource GridHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource GridHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="4" Text="AMOUNT" Style="{StaticResource GridHeaderTextStyle}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Invoice Rows (ListBox for selection + keyboard) -->
                                <ListBox ItemsSource="{Binding Invoices}"
                                         SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource InvoiceRowStyle}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <!-- Context Menu (right-click) -->
                                    <ListBox.ContextMenu>
                                        <ContextMenu Style="{StaticResource AppContextMenuStyle}">
                                            <MenuItem Header="View"
                                                      InputGestureText="Enter"
                                                      Style="{StaticResource AppMenuItemStyle}"
                                                      Command="{Binding ViewInvoiceCommand}"
                                                      CommandParameter="{Binding SelectedInvoice}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#128065;" FontSize="14"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Edit"
                                                      InputGestureText="F2"
                                                      Style="{StaticResource AppMenuItemStyle}"
                                                      Command="{Binding EditInvoiceCommand}"
                                                      CommandParameter="{Binding SelectedInvoice}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#9998;" FontSize="14"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Delete"
                                                      InputGestureText="Del"
                                                      Style="{StaticResource AppMenuItemStyle}"
                                                      Command="{Binding DeleteInvoiceCommand}"
                                                      CommandParameter="{Binding SelectedInvoice}"
                                                      Foreground="#EF4444">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#128465;" FontSize="14"
                                                               Foreground="#EF4444"
                                                               VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding InvoiceNo}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CustomerName}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Date}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="3"
                                                        Background="{DynamicResource MenuHoverBrush}"
                                                        CornerRadius="10"
                                                        Padding="10,4"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="4" Text="{Binding Amount, StringFormat='₹ {0:N0}'}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Empty State -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,40">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInvoices}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#128196;"
                                           FontSize="64"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           Opacity="0.4"/>
                                <TextBlock Text="No invoices yet"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,16,0,6"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock Text="Click '+ Add Sample Invoice' above to get started"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>