<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:step1="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step1CompanySetup"
             xmlns:step2="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step2ProjectSpecs"
             xmlns:step3="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step3ClientProfile"
             xmlns:step4="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator"
             xmlns:step5="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step5DataGrid"
             xmlns:step6="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             FontFamily="Segoe UI">

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          Margin="0,60,0,0">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================== LEFT SIDEBAR ========================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                CornerRadius="14"
                Margin="14,8,8,14"
                Padding="10,14">
            <StackPanel>

                <TextBlock Text="INVOICE BUILDER"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="6,0,0,12"/>

                <!-- Wizard Steps List -->
                <ItemsControl ItemsSource="{Binding WizardSteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.GoToStepCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="0,1"
                                    HorizontalContentAlignment="Stretch"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="StepBorder"
                                                CornerRadius="10"
                                                Padding="10,8">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Step Number Circle -->
                                                <Border x:Name="NumberCircle"
                                                        Grid.Column="0"
                                                        Width="22" Height="22"
                                                        CornerRadius="11"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="NumberText"
                                                               Text="{Binding StepNumber}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Step Title + Subtitle -->
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Margin="8,0,0,0">
                                                    <TextBlock x:Name="TitleText"
                                                               Text="{Binding Title}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="SubtitleText"
                                                               Text="{Binding Subtitle}"
                                                               FontSize="10"
                                                               Margin="0,1,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    <Condition Binding="{Binding IsActive}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="StepBorder" Property="Background"
                                                        Value="{DynamicResource MenuHoverBrush}"/>
                                            </MultiDataTrigger>

                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="StepBorder" Property="Background"
                                                        Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="NumberCircle" Property="Background"
                                                        Value="#FFFFFF"/>
                                                <Setter TargetName="NumberText" Property="Foreground"
                                                        Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="TitleText" Property="Foreground"
                                                        Value="White"/>
                                                <Setter TargetName="SubtitleText" Property="Foreground"
                                                        Value="#CCFFFFFF"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter TargetName="NumberCircle" Property="Background"
                                                        Value="{DynamicResource MenuHoverBrush}"/>
                                                <Setter TargetName="NumberText" Property="Foreground"
                                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                <Setter TargetName="TitleText" Property="Foreground"
                                                        Value="{DynamicResource PrimaryForegroundBrush}"/>
                                                <Setter TargetName="SubtitleText" Property="Foreground"
                                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                <Setter TargetName="NumberCircle" Property="Background"
                                                        Value="#22C55E"/>
                                                <Setter TargetName="NumberText" Property="Foreground"
                                                        Value="White"/>
                                                <Setter TargetName="NumberText" Property="Text"
                                                        Value="✓"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>

        <!-- ========================== RIGHT CONTENT AREA ========================== -->
        <Border Grid.Column="1"
                Margin="8,8,14,14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Progress Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Border Background="{DynamicResource MenuHoverBrush}"
                            Height="4"
                            CornerRadius="2"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Grid.ColumnSpan="{Binding CurrentStepNumber}"
                                Background="{DynamicResource AccentBrush}"
                                Height="4"
                                CornerRadius="2"
                                HorizontalAlignment="Stretch"/>
                    </Grid>
                </Grid>

                <!-- Step Content Area -->
                <Border Grid.Row="1"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        CornerRadius="14"
                        Padding="20">

                    <Grid>
                        <!-- Step 1 View -->
                        <ContentControl Content="{Binding Step1VM}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepNumber}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <step1:CompanySetupView/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Step 2 View -->
                        <ContentControl Content="{Binding Step2VM}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepNumber}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <step2:ProjectSpecsView/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Step 3 View -->
                        <ContentControl Content="{Binding Step3VM}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepNumber}" Value="3">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <step3:ClientProfileView/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Step 4 View -->
                        <ContentControl Content="{Binding Step4VM}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepNumber}" Value="4">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <step4:PricingEstimatorView/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Step 5 View -->
                        <ContentControl Content="{Binding Step5VM}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepNumber}" Value="5">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <step5:DataGridView/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Step 6 View  (NEW — Phase 7.11a) -->
                        <ContentControl Content="{Binding Step6VM}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepNumber}" Value="6">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <step6:OtherChargesView/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Step 7 Placeholder (only Step 7 is not yet built) -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepNumber}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStepNumber}" Value="2">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStepNumber}" Value="3">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStepNumber}" Value="4">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStepNumber}" Value="5">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStepNumber}" Value="6">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="&#128220;"
                                       FontSize="48"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding CurrentStep.Title}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentStep.Subtitle}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>
                            <Border Background="{DynamicResource MenuHoverBrush}"
                                    CornerRadius="6"
                                    Padding="14,8"
                                    Margin="0,18,0,0"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="This step is not built yet — coming in a future phase"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </Border>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- Bottom Navigation Bar -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding PreviousStepCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BackBorder"
                                        Background="{DynamicResource ModuleBackgroundBrush}"
                                        CornerRadius="8"
                                        Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#10094;"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="Back"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="BackBorder" Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BackBorder" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="{Binding StepProgressText}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2"
                            Command="{Binding NextStepCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="NextBorder"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="8"
                                        Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Continue"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="&#10095;"
                                                   FontSize="11"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="NextBorder" Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="NextBorder" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>