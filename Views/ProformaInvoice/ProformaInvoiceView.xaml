<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:step1="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step1CompanySetup"
             xmlns:step2="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step2ProjectSpecs"
             xmlns:step3="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step3ClientProfile"
             xmlns:step4="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator"
             xmlns:step5="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step5DataGrid"
             xmlns:step6="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges"
             xmlns:step7="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview"
             xmlns:pilist="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             FontFamily="Segoe UI">

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          Margin="0,60,0,0">

        <!-- ════════════════════════════════════════════════════════════════
             LIST VIEW — Module Landing Page (shown when IsListView = true)
             Users browse saved invoices, then create new or edit existing.
        ════════════════════════════════════════════════════════════════ -->
        <Border Margin="14,8,14,14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar with NEW INVOICE button -->
                <Border Grid.Row="0"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        CornerRadius="10,10,0,0"
                        Padding="16,12"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource MenuHoverBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource AccentBrush}"
                                    Width="32" Height="32" CornerRadius="8"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#128194;" FontSize="16" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="PROFORMA INVOICES"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock Text="Browse, create, edit, and export proforma invoices"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding NewInvoiceCommand}"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White"
                                Cursor="Hand"
                                BorderThickness="0"
                                Padding="20,10">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="NewBtn"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="+" FontSize="18" FontWeight="Bold"
                                                       Margin="0,-4,8,0" VerticalAlignment="Center"
                                                       Foreground="White"/>
                                            <TextBlock Text="NEW INVOICE" FontSize="12" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NewBtn" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Embedded SavedInvoicesList -->
                <ContentControl Grid.Row="1"
                                Content="{Binding SavedInvoicesListVM}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <pilist:SavedInvoicesListView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════
             WIZARD VIEW — 7-step builder (shown when IsWizardView = true)
             Contains sidebar + progress bar + step content + bottom nav.
        ════════════════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWizardView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================== LEFT SIDEBAR ========================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    CornerRadius="14"
                    Margin="14,8,8,14"
                    Padding="10,14">
                <StackPanel>

                    <!-- Back to List — prominent button at top of sidebar -->
                    <Button Command="{Binding BackToListCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            Margin="0,0,0,14"
                            HorizontalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BackToListBorder"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="10"
                                        Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#10094;"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Invoice List"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BackToListBorder" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="INVOICE BUILDER"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="6,0,0,12"/>

                    <!-- Wizard Steps List -->
                    <ItemsControl ItemsSource="{Binding WizardSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.GoToStepCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,1"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="StepBorder"
                                                    CornerRadius="10"
                                                    Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border x:Name="NumberCircle"
                                                            Grid.Column="0"
                                                            Width="22" Height="22"
                                                            CornerRadius="11"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <TextBlock x:Name="NumberText"
                                                                   Text="{Binding StepNumber}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Margin="8,0,0,0">
                                                        <TextBlock x:Name="TitleText"
                                                                   Text="{Binding Title}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="SubtitleText"
                                                                   Text="{Binding Subtitle}"
                                                                   FontSize="10"
                                                                   Margin="0,1,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding IsActive}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="StepBorder" Property="Background"
                                                            Value="{DynamicResource MenuHoverBrush}"/>
                                                </MultiDataTrigger>

                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="StepBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="NumberCircle" Property="Background" Value="#FFFFFF"/>
                                                    <Setter TargetName="NumberText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="TitleText" Property="Foreground" Value="White"/>
                                                    <Setter TargetName="SubtitleText" Property="Foreground" Value="#CCFFFFFF"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter TargetName="NumberCircle" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                                    <Setter TargetName="NumberText" Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <Setter TargetName="SubtitleText" Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter TargetName="NumberCircle" Property="Background" Value="#22C55E"/>
                                                    <Setter TargetName="NumberText" Property="Foreground" Value="White"/>
                                                    <Setter TargetName="NumberText" Property="Text" Value="✓"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- ========================== RIGHT CONTENT AREA ========================== -->
            <Border Grid.Column="1"
                    Margin="8,8,14,14">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Progress Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Border Background="{DynamicResource MenuHoverBrush}"
                                Height="4"
                                CornerRadius="2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Grid.ColumnSpan="{Binding CurrentStepNumber}"
                                    Background="{DynamicResource AccentBrush}"
                                    Height="4"
                                    CornerRadius="2"
                                    HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Grid>

                    <!-- Step Content Area -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource ModuleBackgroundBrush}"
                            CornerRadius="14"
                            Padding="20">
                        <Grid>
                            <ContentControl Content="{Binding Step1VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}" Value="1">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step1:CompanySetupView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <ContentControl Content="{Binding Step2VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}" Value="2">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step2:ProjectSpecsView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <ContentControl Content="{Binding Step3VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}" Value="3">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step3:ClientProfileView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <ContentControl Content="{Binding Step4VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}" Value="4">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step4:PricingEstimatorView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <ContentControl Content="{Binding Step5VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}" Value="5">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step5:DataGridView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <ContentControl Content="{Binding Step6VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}" Value="6">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step6:OtherChargesView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <ContentControl Content="{Binding Step7VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}" Value="7">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step7:PrintPreviewView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Grid>
                    </Border>

                    <!-- Bottom Navigation Bar -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Back to List (bottom nav duplicate for convenience) -->
                        <Button Grid.Column="0"
                                Command="{Binding BackToListCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ListBorder"
                                            Background="White"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            Padding="14,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#10094;"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,7,0"/>
                                            <TextBlock Text="Invoice List"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ListBorder" Property="Background"
                                                    Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="ListBorder" Property="BorderBrush"
                                                    Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Back Step -->
                        <Button Grid.Column="1"
                                Command="{Binding PreviousStepCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BackBorder"
                                            Background="{DynamicResource ModuleBackgroundBrush}"
                                            CornerRadius="8"
                                            Padding="16,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#10094;"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock Text="Back"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="BackBorder" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BackBorder" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Step Progress -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding StepProgressText}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <!-- Continue -->
                        <Button Grid.Column="3"
                                Command="{Binding NextStepCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="NextBorder"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="8"
                                            Padding="16,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Continue"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="&#10095;"
                                                       FontSize="11"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="NextBorder" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NextBorder" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>