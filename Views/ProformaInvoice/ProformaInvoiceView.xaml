<!--
═══════════════════════════════════════════════════════════════════════
FILE: Views/ProformaInvoice/ProformaInvoiceView.xaml
═══════════════════════════════════════════════════════════════════════
CHAT 15 — PHASE 3
Changes:
  W-01  xmlns:step2 → Step2ClientProfile namespace (was Step2ProjectSpecs)
  W-02  xmlns:step3 → Step3ProjectSpecs namespace (was Step3ClientProfile)
  W-03  Step2VM ContentControl renders step2:ClientProfileView
  W-04  Step3VM ContentControl renders step3:ProjectSpecsView
  W-05  Steps 1,4,5,6,7 ContentControls unchanged
  W-06  Sidebar, footer, hero card, progress bar fully preserved
  W-07  BUG-82/83/84 deferred notes preserved

CHAT 17 — LAYOUT FIX
  BUG-82 FIXED: Removed hardcoded Margin="0,60,0,0" from root Grid.
                App shell now reserves header space via layout, not overlay.
                Empty band at top of page eliminated.
  List Border top margin reduced 12→4 to align tighter with app header.
═══════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:step1="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step1CompanySetup"
             xmlns:step2="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step2ClientProfile"
             xmlns:step3="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step3ProjectSpecs"
             xmlns:step4="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator"
             xmlns:step5="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step5DataGrid"
             xmlns:step6="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges"
             xmlns:step7="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview"
             xmlns:step8="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step8Attachments"
             xmlns:step9="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step9ProfitLoss"
             xmlns:pilist="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!--
    ═══════════════════════════════════════════════════════════════════
    UX CLEANUP — Chat 14 Phase 1 (preserved)
    ═══════════════════════════════════════════════════════════════════

    UX-CLEANUP-01: Removed duplicate "Invoice List" pill button from
                   the footer bar. Sidebar hero card at top-left is
                   now the ONLY way to return to invoice list from
                   within the wizard. Cleaner UX, no duplicate paths.

    Preserved:
      ✅ Sidebar "Invoice List" hero card (top-left, always visible)
      ✅ Footer "Back" button (step navigation — different purpose)
      ✅ Footer "STEP X OF 7" label
      ✅ Footer "Continue" hero button
      ✅ All 7 step ContentControls
      ✅ Progress bar with ColumnSpan binding

    Deferred bugs status:
      BUG-82 [FIXED in Chat 17] Magic Margin="0,60,0,0" removed.
      BUG-83 [LOW] Grid.ColumnSpan binding — reclassified non-bug.
      BUG-84 [LOW] All 7 step controls eager-instantiated — deferred.
    ═══════════════════════════════════════════════════════════════════
    -->

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════
             HERO PILL BUTTON — deep indigo · white text · fully rounded
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="HeroPillButton" TargetType="Button">
            <Setter Property="Height"          Value="44"/>
            <Setter Property="MinWidth"        Value="150"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#4338CA"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22"
                                Padding="22,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3730A3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             GHOST PILL BUTTON — outlined · indigo text
             (kept in resources — future features may use it)
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="GhostPillButton" TargetType="Button">
            <Setter Property="Height"          Value="44"/>
            <Setter Property="MinWidth"        Value="130"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{DynamicResource ModuleBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="22"
                                Padding="22,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4338CA"/>
                                <Setter TargetName="Root" Property="Background"  Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E0E7FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             NEUTRAL PILL BUTTON — softer secondary · muted surface
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="NeutralPillButton" TargetType="Button">
            <Setter Property="Height"          Value="44"/>
            <Setter Property="MinWidth"        Value="110"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{DynamicResource MenuHoverBrush}"
                                CornerRadius="22"
                                Padding="22,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════════
         ROOT
         CHAT 17 BUG-82 FIX: Removed Margin="0,60,0,0".
         The app-shell header no longer overlays content — it reserves
         its own layout space. Empty band at top eliminated.
    ══════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          Margin="0">

        <!-- ══════════════════════════════════════════════════════════
             LIST VIEW
        ══════════════════════════════════════════════════════════ -->
        <Border Margin="20,4,20,20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- List header + Add Invoice button -->
                <Grid Grid.Row="0" Margin="8,4,8,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Proforma Invoices"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Browse, create, edit and export proforma invoices with ease."
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding NewInvoiceCommand}"
                            Style="{StaticResource HeroPillButton}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Background="#FFFFFF"
                                    Width="22"
                                    Height="22"
                                    CornerRadius="11"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="+"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-2,0,0"/>
                            </Border>
                            <TextBlock Text="Add Invoice"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Saved invoices list -->
                <ContentControl Grid.Row="1"
                                Content="{Binding SavedInvoicesListVM}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <pilist:SavedInvoicesListView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             WIZARD VIEW
        ══════════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWizardView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════════════
                 SIDEBAR
                 Contains the ONLY "Invoice List" navigation button.
                 Wizard step list auto-reflects updated WizardSteps
                 titles from ProformaInvoiceViewModel (File 4).
            ══════════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    CornerRadius="20"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Margin="20,4,10,20"
                    SnapsToDevicePixels="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar top — hero card + labels -->
                    <StackPanel Grid.Row="0" Margin="16,20,16,0">

                        <!-- Hero card — "Invoice List" back button -->
                        <Button Command="{Binding BackToListCommand}"
                                HorizontalContentAlignment="Stretch"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="Transparent"
                                Margin="0,0,0,20">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BackHero"
                                            CornerRadius="16"
                                            Padding="18,16"
                                            SnapsToDevicePixels="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0"
                                                                 EndPoint="1,1">
                                                <GradientStop Color="#4338CA" Offset="0"/>
                                                <GradientStop Color="#6366F1" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel>
                                            <Grid>
                                                <Border Background="#33FFFFFF"
                                                        Width="34"
                                                        Height="34"
                                                        CornerRadius="17"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="&#xE8AB;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Background="#33FFFFFF"
                                                        Width="28"
                                                        Height="28"
                                                        CornerRadius="14"
                                                        HorizontalAlignment="Right">
                                                    <TextBlock Text="&#xE76B;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="Invoice List"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       Margin="0,14,0,2"/>
                                            <TextBlock Text="Back to all invoices"
                                                       FontSize="10"
                                                       Foreground="#CCFFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BackHero"
                                                    Property="Opacity"
                                                    Value="0.92"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="BackHero"
                                                    Property="Opacity"
                                                    Value="0.80"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Text="Invoice Builder"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="4,0,0,4"/>
                        <TextBlock Text="8 steps to complete"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Opacity="0.7"
                                   Margin="4,0,0,12"/>
                    </StackPanel>

                    <!-- Sidebar step list — titles auto-updated via WizardSteps binding -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="12,0,12,0">
                        <ItemsControl ItemsSource="{Binding WizardSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.GoToStepCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Margin="0,3"
                                            HorizontalContentAlignment="Stretch"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="StepBorder"
                                                        CornerRadius="14"
                                                        Padding="12,12"
                                                        SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Step number circle -->
                                                        <Border x:Name="NumberCircle"
                                                                Grid.Column="0"
                                                                Width="28"
                                                                Height="28"
                                                                CornerRadius="14"
                                                                Background="{DynamicResource TintIndigoBrush}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                            <TextBlock x:Name="NumberText"
                                                                       Text="{Binding StepNumber}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Step title + subtitle -->
                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Margin="12,0,0,0">
                                                            <TextBlock x:Name="TitleText"
                                                                       Text="{Binding Title}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock x:Name="SubtitleText"
                                                                       Text="{Binding Subtitle}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                       Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <ControlTemplate.Triggers>

                                                    <!-- Hover (not active) -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsMouseOver,
                                                                                         RelativeSource={RelativeSource Self}}"
                                                                       Value="True"/>
                                                            <Condition Binding="{Binding IsActive}"
                                                                       Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="StepBorder"
                                                                Property="Background"
                                                                Value="{DynamicResource MenuHoverBrush}"/>
                                                    </MultiDataTrigger>

                                                    <!-- Active step -->
                                                    <DataTrigger Binding="{Binding IsActive}"
                                                                 Value="True">
                                                        <Setter TargetName="StepBorder"
                                                                Property="Background"
                                                                Value="#4338CA"/>
                                                        <Setter TargetName="NumberCircle"
                                                                Property="Background"
                                                                Value="#FFFFFF"/>
                                                        <Setter TargetName="NumberText"
                                                                Property="Foreground"
                                                                Value="#4338CA"/>
                                                        <Setter TargetName="TitleText"
                                                                Property="Foreground"
                                                                Value="White"/>
                                                        <Setter TargetName="TitleText"
                                                                Property="FontWeight"
                                                                Value="Bold"/>
                                                        <Setter TargetName="SubtitleText"
                                                                Property="Foreground"
                                                                Value="#CCFFFFFF"/>
                                                    </DataTrigger>

                                                    <!-- Completed step — checkmark -->
                                                    <DataTrigger Binding="{Binding IsCompleted}"
                                                                 Value="True">
                                                        <Setter TargetName="NumberCircle"
                                                                Property="Background"
                                                                Value="#D1FAE5"/>
                                                        <Setter TargetName="NumberText"
                                                                Property="Text"
                                                                Value="&#xE73E;"/>
                                                        <Setter TargetName="NumberText"
                                                                Property="FontFamily"
                                                                Value="Segoe MDL2 Assets"/>
                                                        <Setter TargetName="NumberText"
                                                                Property="FontSize"
                                                                Value="11"/>
                                                        <Setter TargetName="NumberText"
                                                                Property="Foreground"
                                                                Value="#047857"/>
                                                    </DataTrigger>

                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Progress summary card -->
                    <Border Grid.Row="2"
                            Margin="16,12,16,20"
                            Background="{DynamicResource TintIndigoBrush}"
                            CornerRadius="14"
                            Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Current Step"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" • "
                                           FontSize="10"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding CurrentStepNumber, Mode=OneWay}"/>
                                    <Run Text=" of 8"/>
                                </TextBlock>
                            </StackPanel>

                            <!--
                                BUG-83 verified non-bug: Grid.ColumnSpan binds
                                to CurrentStepNumber (Int32). Valid in WPF.
                                Progress fills 1/7 through 7/7 as step advances.
                            -->
                            <Grid Margin="0,8,0,0">
                                <Border Background="{DynamicResource TintIndigoBrush}"
                                        Height="4"
                                        CornerRadius="2"/>
                                <!-- 9 columns — one per wizard step
                                     (PHASE B: was 8, Step 9 = Profit & Loss) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Grid.ColumnSpan="{Binding CurrentStepNumber}"
                                            Background="{DynamicResource AccentBrush}"
                                            Height="4"
                                            CornerRadius="2"
                                            HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════
                 RIGHT CONTENT AREA
            ══════════════════════════════════════════════════════ -->
            <Border Grid.Column="1"
                    Margin="10,4,20,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Step content panel -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource ModuleBackgroundBrush}"
                            CornerRadius="20"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Grid>

                            <!-- STEP 1 — Company Setup (unchanged) -->
                            <ContentControl Content="{Binding Step1VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}"
                                                         Value="1">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step1:CompanySetupView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <!--
                                STEP 2 — CLIENT PROFILE (W-03: SWAPPED)
                                Before: step2:ProjectSpecsView
                                After:  step2:ClientProfileView
                                DataContext = Step2VM (ClientProfileViewModel)
                                DataTrigger Value stays "2" — only the view changes
                            -->
                            <ContentControl Content="{Binding Step2VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}"
                                                         Value="2">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step2:ClientProfileView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <!--
                                STEP 3 — PROJECT SPECS (W-04: SWAPPED)
                                Before: step3:ClientProfileView
                                After:  step3:ProjectSpecsView
                                DataContext = Step3VM (ProjectSpecsViewModel)
                                DataTrigger Value stays "3" — only the view changes
                            -->
                            <ContentControl Content="{Binding Step3VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}"
                                                         Value="3">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step3:ProjectSpecsView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <!-- STEP 4 — Pricing Estimator (unchanged) -->
                            <ContentControl Content="{Binding Step4VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}"
                                                         Value="4">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step4:PricingEstimatorView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <!-- STEP 5 — Data Grid (unchanged) -->
                            <ContentControl Content="{Binding Step5VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}"
                                                         Value="5">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step5:DataGridView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <!-- STEP 6 — Other Charges (unchanged) -->
                            <ContentControl Content="{Binding Step6VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}"
                                                         Value="6">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step6:OtherChargesView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <!-- STEP 7 — Print Preview (unchanged) -->
                            <ContentControl Content="{Binding Step7VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}"
                                                         Value="7">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step7:PrintPreviewView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <!-- STEP 8 — Attachments (NEW)
                                 Same ContentControl + DataTrigger pattern as
                                 steps 1-7. DataContext = Step8VM. -->
                            <ContentControl Content="{Binding Step8VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}"
                                                         Value="8">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step8:AttachmentsStepView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <!-- STEP 9 — Profit & Loss (PHASE B)
                                 Identical ContentControl + DataTrigger
                                 pattern as steps 1-8. DataContext = Step9VM. -->
                            <ContentControl Content="{Binding Step9VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}"
                                                         Value="9">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step9:ProfitLossStepView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                        </Grid>
                    </Border>

                    <!--
                        FOOTER BAR — UX-CLEANUP-01 preserved
                        Layout: [Back] .... [STEP X OF 7] .... [Continue]
                    -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource ModuleBackgroundBrush}"
                            CornerRadius="20"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Margin="0,16,0,0"
                            Padding="20,14"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- BACK — step navigation only -->
                            <Button Grid.Column="0"
                                    Command="{Binding PreviousStepCommand}"
                                    Style="{StaticResource NeutralPillButton}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="&#xE76B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="Back"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- STEP X OF 7 -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding StepProgressText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <!-- CONTINUE -->
                            <Button Grid.Column="2"
                                    Command="{Binding NextStepCommand}"
                                    Style="{StaticResource HeroPillButton}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Continue"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE76C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>