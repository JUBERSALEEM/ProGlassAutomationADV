<!--
═══════════════════════════════════════════════════════════════════════
FILE: Views/ProformaInvoice/ProformaInvoiceView.xaml
═══════════════════════════════════════════════════════════════════════
Industrial wizard chrome (approved spec).
  Rail 32 px · one workbench · footer 48 px.
  Bindings, commands and AutomationIds unchanged.
  Theme: DynamicResource only (light / dark / Monet).
═══════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:step1="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step1CompanySetup"
             xmlns:step2="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step2ClientProfile"
             xmlns:step3="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step3ProjectSpecs"
             xmlns:step4="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator"
             xmlns:step5="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step5DataGrid"
             xmlns:step6="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges"
             xmlns:step7="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview"
             xmlns:step8="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step8Attachments"
             xmlns:step9="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step9ProfitLoss"
             xmlns:pilist="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource WindowBackgroundBrush}">

        <!-- ══════════════════════════════════════════════════════════
             LIST VIEW
        ══════════════════════════════════════════════════════════ -->
        <Border Margin="20,4,20,20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="8,4,8,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Proforma Invoices"
                                   Style="{StaticResource ModulePageTitleStyle}"/>
                        <TextBlock Text="Saved quotations ready to convert into job orders"
                                   Style="{StaticResource ModulePageSubtitleStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding NewInvoiceCommand}"
                            Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE710;"
                            Content="NEW INVOICE"
                            VerticalAlignment="Center"
                            ToolTip="Create a new proforma invoice"
                            AutomationProperties.AutomationId="ProformaInvoice.NewInvoiceButton"
                            AutomationProperties.Name="New Invoice"/>
                </Grid>

                <ContentControl Grid.Row="1"
                                Content="{Binding SavedInvoicesListVM}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <pilist:SavedInvoicesListView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             WIZARD VIEW
        ══════════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWizardView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- RAIL — 32 px, LIST + 9 steps -->
            <Border Grid.Row="0" Style="{StaticResource PiRailBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding BackToListCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="Back to the invoice list">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BackBorder"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Height="24"
                                        Padding="8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72B;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="LIST"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BackBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding WizardSteps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.GoToStepCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="2,0"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}"
                                        ToolTip="{Binding Subtitle}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="StepBorder"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    Height="40"
                                                    Padding="8,0"
                                                    SnapsToDevicePixels="True">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center">
                                                    <Border x:Name="NumberCircle"
                                                            Width="20" Height="20"
                                                            CornerRadius="2"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource OutlineBrush}"
                                                            BorderThickness="1"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,6,0">
                                                        <TextBlock x:Name="NumberText"
                                                                   Text="{Binding StepNumber}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock x:Name="TitleText"
                                                               Text="{Binding RailLabel}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter TargetName="NumberCircle" Property="Background"
                                                            Value="{DynamicResource SuccessBrush}"/>
                                                    <Setter TargetName="NumberCircle" Property="BorderBrush"
                                                            Value="{DynamicResource SuccessBrush}"/>
                                                    <Setter TargetName="NumberText" Property="Text" Value="&#xE73E;"/>
                                                    <Setter TargetName="NumberText" Property="FontFamily"
                                                            Value="Segoe MDL2 Assets"/>
                                                    <Setter TargetName="NumberText" Property="Foreground"
                                                            Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="StepBorder" Property="Background"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="TitleText" Property="Foreground"
                                                            Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                    <Setter TargetName="NumberCircle" Property="Background"
                                                            Value="Transparent"/>
                                                    <Setter TargetName="NumberCircle" Property="BorderBrush"
                                                            Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                    <Setter TargetName="NumberText" Property="Foreground"
                                                            Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver,
                                                                                     RelativeSource={RelativeSource Self}}"
                                                                   Value="True"/>
                                                        <Condition Binding="{Binding IsActive}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="TitleText" Property="Foreground"
                                                            Value="{DynamicResource PrimaryForegroundBrush}"/>
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- WORKBENCH — no extra wrapping card -->
            <Grid Grid.Row="1" Margin="24,12,24,12">
                <ContentControl Content="{Binding Step1VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <step1:CompanySetupView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding Step2VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <step2:ClientProfileView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding Step3VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="3">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <step3:ProjectSpecsView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding Step4VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="4">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <step4:PricingEstimatorView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding Step5VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="5">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <step5:DataGridView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding Step6VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="6">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <step6:OtherChargesView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding Step7VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="7">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <step7:PrintPreviewView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding Step8VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="8">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <step8:AttachmentsStepView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding Step9VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="9">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <step9:ProfitLossStepView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>

            <!-- FOOTER — 48 px bar, not a second card -->
            <Border Grid.Row="2" Style="{StaticResource PiFooterBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding PreviousStepCommand}"
                            Style="{StaticResource PiFooterGhostButton}"
                            AutomationProperties.AutomationId="ProformaInvoice.BackButton"
                            AutomationProperties.Name="Back">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE76B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Back"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="{Binding StepProgressText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2"
                            Command="{Binding NextStepCommand}"
                            Style="{StaticResource PiFooterPrimaryButton}"
                            AutomationProperties.AutomationId="ProformaInvoice.ContinueButton"
                            AutomationProperties.Name="Continue">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Continue"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
