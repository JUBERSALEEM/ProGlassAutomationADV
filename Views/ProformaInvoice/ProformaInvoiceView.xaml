<!--
═══════════════════════════════════════════════════════════════════════
FILE: Views/ProformaInvoice/ProformaInvoiceView.xaml
═══════════════════════════════════════════════════════════════════════
Industrial station deck — left rail, work surface, command bar.
ProgressPercent is OneWay (ProgressBar defaults to TwoWay and crashes).
Bindings, commands and AutomationIds preserved.
═══════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:step1="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step1CompanySetup"
             xmlns:step2="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step2ClientProfile"
             xmlns:step3="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step3ProjectSpecs"
             xmlns:step4="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator"
             xmlns:step5="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step5DataGrid"
             xmlns:step6="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges"
             xmlns:step7="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview"
             xmlns:step8="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step8Attachments"
             xmlns:step9="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step9ProfitLoss"
             xmlns:pilist="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource WindowBackgroundBrush}">

        <!-- LIST -->
        <Border Margin="20,4,20,20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="8,4,8,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PROFORMA INVOICES" Style="{StaticResource ModulePageTitleStyle}"/>
                        <TextBlock Text="Quotations ready to convert into job orders"
                                   Style="{StaticResource ModulePageSubtitleStyle}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding NewInvoiceCommand}"
                            Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE710;"
                            Content="NEW INVOICE"
                            VerticalAlignment="Center"
                            ToolTip="Create a new proforma invoice"
                            AutomationProperties.AutomationId="ProformaInvoice.NewInvoiceButton"
                            AutomationProperties.Name="New Invoice"/>
                </Grid>
                <ContentControl Grid.Row="1" Content="{Binding SavedInvoicesListVM}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <pilist:SavedInvoicesListView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Border>

        <!-- WIZARD — left station rail + work deck -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWizardView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PiStationRailStyle}"
                    Width="Auto"
                    HorizontalAlignment="Stretch">
                <DockPanel>
                    <Button DockPanel.Dock="Top"
                            Command="{Binding BackToListCommand}"
                            Style="{StaticResource PiFooterGhostButton}"
                            Height="32"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,12"
                            Content="LIST"
                            ToolTip="Back to the invoice list"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="{Binding StepProgressText}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <ProgressBar Style="{StaticResource PiProgressTrackStyle}"
                                     Value="{Binding ProgressPercent, Mode=OneWay}"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding WizardSteps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.GoToStepCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,0,0,4"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}"
                                        ToolTip="{Binding Subtitle}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="StepBorder"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="3,0,0,0"
                                                    Padding="10,8"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="NumberText"
                                                               Text="{Binding StationCode}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TitleText"
                                                               Grid.Column="1"
                                                               Text="{Binding RailLabel}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter TargetName="NumberText" Property="Text" Value="&#xE73E;"/>
                                                    <Setter TargetName="NumberText" Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                                    <Setter TargetName="NumberText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="StepBorder" Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                                    <Setter TargetName="StepBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <Setter TargetName="TitleText" Property="FontWeight" Value="Bold"/>
                                                    <Setter TargetName="NumberText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding IsActive}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="StepBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <Setter TargetName="NumberText" Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PiStationHeaderBarStyle}"
                        Padding="16,0" MinHeight="44">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CurrentStationCode}"
                                   Style="{StaticResource PiStationCodeStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentStationTitle}"
                                   Style="{StaticResource PiStationTitleStyle}"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding StepProgressText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="16,12">
                    <ContentControl Content="{Binding Step1VM}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepNumber}" Value="1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate><step1:CompanySetupView/></DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <ContentControl Content="{Binding Step2VM}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepNumber}" Value="2">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate><step2:ClientProfileView/></DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <ContentControl Content="{Binding Step3VM}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepNumber}" Value="3">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate><step3:ProjectSpecsView/></DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <ContentControl Content="{Binding Step4VM}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepNumber}" Value="4">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate><step4:PricingEstimatorView/></DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <ContentControl Content="{Binding Step5VM}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepNumber}" Value="5">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate><step5:DataGridView/></DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <ContentControl Content="{Binding Step6VM}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepNumber}" Value="6">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate><step6:OtherChargesView/></DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <ContentControl Content="{Binding Step7VM}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepNumber}" Value="7">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate><step7:PrintPreviewView/></DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <ContentControl Content="{Binding Step8VM}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepNumber}" Value="8">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate><step8:AttachmentsStepView/></DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <ContentControl Content="{Binding Step9VM}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepNumber}" Value="9">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate><step9:ProfitLossStepView/></DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource PiCommandFooterStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding PreviousStepCommand}"
                                Style="{StaticResource PiFooterGhostButton}"
                                Content="BACK"
                                AutomationProperties.AutomationId="ProformaInvoice.BackButton"
                                AutomationProperties.Name="Back"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentStationTitle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Command="{Binding NextStepCommand}"
                                Style="{StaticResource PiFooterPrimaryButton}"
                                Content="CONTINUE"
                                AutomationProperties.AutomationId="ProformaInvoice.ContinueButton"
                                AutomationProperties.Name="Continue"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
