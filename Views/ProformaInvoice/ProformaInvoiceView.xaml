<!--
    PI shell — steps 1–9 live in a single top panel. No sidebar.
    Bindings, commands and AutomationIds preserved.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:step1="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step1CompanySetup"
             xmlns:step2="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step2ClientProfile"
             xmlns:step3="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step3ProjectSpecs"
             xmlns:step4="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator"
             xmlns:step5="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step5DataGrid"
             xmlns:step6="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges"
             xmlns:step7="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview"
             xmlns:step8="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step8Attachments"
             xmlns:step9="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step9ProfitLoss"
             xmlns:pilist="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="Transparent">

        <!-- LIST -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="12,4,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource ProformaInvoice.ProformaInvoices}" Style="{StaticResource ModulePageTitleStyle}"/>
                    <TextBlock Text="{DynamicResource ProformaInvoice.SavedQuotationsReadyConvertJobOrders}"
                               Style="{StaticResource ModulePageSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding NewFromInquiryCommand}"
                            Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE710;"
                            Content="{DynamicResource ProformaInvoice.NEWInquiry}"
                            ToolTip="{DynamicResource ProformaInvoice.CreateNewProformaInvoiceConfirmedInquiry}"
                            AutomationProperties.AutomationId="ProformaInvoice.NewFromInquiryButton"
                            AutomationProperties.Name="New From Inquiry"/>
                    <Button Margin="8,0,0,0"
                            Command="{Binding NewInvoiceCommand}"
                            Style="{StaticResource OutlinedPillButton}"
                            Content="{DynamicResource ProformaInvoice.BlankRecommended}"
                            ToolTip="{DynamicResource ProformaInvoice.CreateBlankProformaInvoiceWithoutInquiryUse}"
                            AutomationProperties.AutomationId="ProformaInvoice.NewInvoiceButton"
                            AutomationProperties.Name="New Invoice Blank"/>
                </StackPanel>
            </Grid>
            <ContentControl Grid.Row="1" Margin="12,0,12,8" Content="{Binding SavedInvoicesListVM}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <pilist:SavedInvoicesListView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>

        <!-- WIZARD -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWizardView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                    Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Command="{Binding BackToListCommand}"
                            Style="{StaticResource OutlinedPillButton}"
                            Content="{DynamicResource ProformaInvoice.Invoices}"
                            Tag="&#xE72B;"
                            VerticalAlignment="Center"
                            ToolTip="{DynamicResource ProformaInvoice.BackInvoiceList}"/>

                    <ItemsControl Grid.Column="2"
                                  ItemsSource="{Binding WizardSteps}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.GoToStepCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="{DynamicResource Border.NoneThickness}"
                                        Padding="0"
                                        Margin="2,0"
                                        Height="36"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}"
                                        ToolTip="{Binding Subtitle}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Chip"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                                                    Padding="4,4"
                                                    SnapsToDevicePixels="True">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Border x:Name="Dot"
                                                            Width="20" Height="20"
                                                            CornerRadius="{DynamicResource Radius.Medium}"
                                                            Background="{DynamicResource SurfaceTertiaryBrush}"
                                                            Margin="0,0,6,0" Style="{StaticResource SurfacePrimaryStyle}">
                                                        <TextBlock x:Name="Num"
                                                                   Text="{Binding StationCode}"
                                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock x:Name="Lbl"
                                                               Text="{Binding RailLabel}"
                                                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter TargetName="Num" Property="Text" Value="&#xE73E;"/>
                                                    <Setter TargetName="Num" Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource TintGreenBrush}"/>
                                                    <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                    <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Setter TargetName="Lbl" Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Column="4"
                               Text="{Binding StepProgressText}"
                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,14,20,8">
                <ContentControl Content="{Binding Step1VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate><step1:CompanySetupView/></DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
                <ContentControl Content="{Binding Step2VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate><step2:ClientProfileView/></DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
                <ContentControl Content="{Binding Step3VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="3">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate><step3:ProjectSpecsView/></DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
                <ContentControl Content="{Binding Step4VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="4">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate><step4:PricingEstimatorView/></DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
                <ContentControl Content="{Binding Step5VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="5">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate><step5:DataGridView/></DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
                <ContentControl Content="{Binding Step6VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="6">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate><step6:OtherChargesView/></DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
                <ContentControl Content="{Binding Step7VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="7">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate><step7:PrintPreviewView/></DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
                <ContentControl Content="{Binding Step8VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="8">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate><step8:AttachmentsStepView/></DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
                <ContentControl Content="{Binding Step9VM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStepNumber}" Value="9">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate><step9:ProfitLossStepView/></DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="{DynamicResource Border.TopHairlineThickness}"
                    Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding PreviousStepCommand}"
                            Style="{StaticResource OutlinedPillButton}"
                            Content="{DynamicResource Action.Back}"
                            AutomationProperties.AutomationId="ProformaInvoice.BackButton"
                            AutomationProperties.Name="Back"/>
                    <ProgressBar Grid.Column="1"
                                 Height="4" Maximum="1" Minimum="0"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 Margin="28,0"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource SurfaceTertiaryBrush}"
                                 BorderThickness="{DynamicResource Border.NoneThickness}"/>
                    <Button Grid.Column="2"
                            Command="{Binding NextStepCommand}"
                            Style="{StaticResource PrimaryPillButton}"
                            Content="{DynamicResource ProformaInvoice.Continue}"
                            AutomationProperties.AutomationId="ProformaInvoice.ContinueButton"
                            AutomationProperties.Name="Continue"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
