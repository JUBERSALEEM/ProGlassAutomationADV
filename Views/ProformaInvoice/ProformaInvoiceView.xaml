<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             FontFamily="Segoe UI">

    <Grid Background="{DynamicResource WindowBackgroundBrush}">

        <!-- Placeholder content — wizard sidebar + step area will be added in next step -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="&#128220;"
                       FontSize="72"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AccentBrush}"
                       Margin="0,0,0,20"/>

            <TextBlock Text="{Binding Title}"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding Subtitle}"
                       FontSize="14"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,30"/>

            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="12"
                    Padding="24,16"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#9881;"
                               FontSize="16"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="Step 0 complete — Wizard shell coming next"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>

    </Grid>
</UserControl>