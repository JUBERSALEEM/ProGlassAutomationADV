<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:step1="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step1CompanySetup"
             xmlns:step2="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step2ProjectSpecs"
             xmlns:step3="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step3ClientProfile"
             xmlns:step4="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator"
             xmlns:step5="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step5DataGrid"
             xmlns:step6="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges"
             xmlns:step7="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview"
             xmlns:pilist="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════════
             HERO PILL BUTTON — deep indigo · white text · fully rounded
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="HeroPillButton" TargetType="Button">
            <Setter Property="Height"          Value="44"/>
            <Setter Property="MinWidth"        Value="150"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#4338CA"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22"
                                Padding="22,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3730A3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             GHOST PILL BUTTON — outlined · indigo text
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="GhostPillButton" TargetType="Button">
            <Setter Property="Height"          Value="44"/>
            <Setter Property="MinWidth"        Value="130"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{DynamicResource ModuleBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="22"
                                Padding="22,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4338CA"/>
                                <Setter TargetName="Root" Property="Background"  Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E0E7FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             NEUTRAL PILL BUTTON — softer secondary · muted surface
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="NeutralPillButton" TargetType="Button">
            <Setter Property="Height"          Value="44"/>
            <Setter Property="MinWidth"        Value="110"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{DynamicResource MenuHoverBrush}"
                                CornerRadius="22"
                                Padding="22,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════════════
         ROOT
    ══════════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          Margin="0,60,0,0">

        <!-- ════════════════════════════════════════════════════════════
             LIST VIEW
        ════════════════════════════════════════════════════════════ -->
        <Border Margin="20,12,20,20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="8,4,8,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Proforma Invoices"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Browse, create, edit and export proforma invoices with ease."
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding NewInvoiceCommand}"
                            Style="{StaticResource HeroPillButton}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Background="#FFFFFF"
                                    Width="22" Height="22"
                                    CornerRadius="11"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="+"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#4338CA"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-2,0,0"/>
                            </Border>
                            <TextBlock Text="Add Invoice"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <ContentControl Grid.Row="1"
                                Content="{Binding SavedInvoicesListVM}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <pilist:SavedInvoicesListView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════
             WIZARD VIEW
        ════════════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWizardView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    CornerRadius="20"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Margin="20,12,10,20"
                    SnapsToDevicePixels="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,20,16,0">

                        <Button Command="{Binding BackToListCommand}"
                                HorizontalContentAlignment="Stretch"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="Transparent"
                                Margin="0,0,0,20">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BackHero"
                                            CornerRadius="16"
                                            Padding="18,16"
                                            SnapsToDevicePixels="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#4338CA" Offset="0"/>
                                                <GradientStop Color="#6366F1" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel>
                                            <Grid>
                                                <Border Background="#33FFFFFF"
                                                        Width="34" Height="34"
                                                        CornerRadius="17"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="&#xE8AB;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Background="#33FFFFFF"
                                                        Width="28" Height="28"
                                                        CornerRadius="14"
                                                        HorizontalAlignment="Right">
                                                    <TextBlock Text="&#xE76B;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="Invoice List"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       Margin="0,14,0,2"/>
                                            <TextBlock Text="Back to all invoices"
                                                       FontSize="10"
                                                       Foreground="#CCFFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BackHero" Property="Opacity" Value="0.92"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="BackHero" Property="Opacity" Value="0.80"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Text="Invoice Builder"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="4,0,0,4"/>
                        <TextBlock Text="7 steps to complete"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Opacity="0.7"
                                   Margin="4,0,0,12"/>

                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="12,0,12,0">
                        <ItemsControl ItemsSource="{Binding WizardSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.GoToStepCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Margin="0,3"
                                            HorizontalContentAlignment="Stretch"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">

                                                <Border x:Name="StepBorder"
                                                        CornerRadius="14"
                                                        Padding="12,12"
                                                        SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border x:Name="NumberCircle"
                                                                Grid.Column="0"
                                                                Width="28" Height="28"
                                                                CornerRadius="14"
                                                                Background="#EEF2FF"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                            <TextBlock x:Name="NumberText"
                                                                       Text="{Binding StepNumber}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="#4338CA"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Margin="12,0,0,0">
                                                            <TextBlock x:Name="TitleText"
                                                                       Text="{Binding Title}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock x:Name="SubtitleText"
                                                                       Text="{Binding Subtitle}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                       Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                    </Grid>
                                                </Border>

                                                <ControlTemplate.Triggers>

                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsMouseOver,
                                                                                RelativeSource={RelativeSource Self}}"
                                                                       Value="True"/>
                                                            <Condition Binding="{Binding IsActive}"
                                                                       Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="StepBorder"
                                                                Property="Background"
                                                                Value="{DynamicResource MenuHoverBrush}"/>
                                                    </MultiDataTrigger>

                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter TargetName="StepBorder"
                                                                Property="Background" Value="#4338CA"/>
                                                        <Setter TargetName="NumberCircle"
                                                                Property="Background" Value="#FFFFFF"/>
                                                        <Setter TargetName="NumberText"
                                                                Property="Foreground" Value="#4338CA"/>
                                                        <Setter TargetName="TitleText"
                                                                Property="Foreground" Value="White"/>
                                                        <Setter TargetName="TitleText"
                                                                Property="FontWeight" Value="Bold"/>
                                                        <Setter TargetName="SubtitleText"
                                                                Property="Foreground" Value="#CCFFFFFF"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter TargetName="NumberCircle"
                                                                Property="Background" Value="#D1FAE5"/>
                                                        <Setter TargetName="NumberText"
                                                                Property="Text" Value="&#xE73E;"/>
                                                        <Setter TargetName="NumberText"
                                                                Property="FontFamily"
                                                                Value="Segoe MDL2 Assets"/>
                                                        <Setter TargetName="NumberText"
                                                                Property="FontSize" Value="11"/>
                                                        <Setter TargetName="NumberText"
                                                                Property="Foreground" Value="#047857"/>
                                                    </DataTrigger>

                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Margin="16,12,16,20"
                            Background="#EEF2FF"
                            CornerRadius="14"
                            Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Current Step"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#4338CA"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" • "
                                           FontSize="10"
                                           Foreground="#4338CA"
                                           VerticalAlignment="Center"/>
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#4338CA"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding CurrentStepNumber, Mode=OneWay}"/>
                                    <Run Text=" of 7"/>
                                </TextBlock>
                            </StackPanel>

                            <Grid Margin="0,8,0,0">
                                <Border Background="#DBEAFE"
                                        Height="4"
                                        CornerRadius="2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Grid.ColumnSpan="{Binding CurrentStepNumber}"
                                            Background="#4338CA"
                                            Height="4"
                                            CornerRadius="2"
                                            HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!-- RIGHT CONTENT -->
            <Border Grid.Column="1"
                    Margin="10,12,20,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource ModuleBackgroundBrush}"
                            CornerRadius="20"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Grid>

                            <ContentControl Content="{Binding Step1VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}" Value="1">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step1:CompanySetupView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <ContentControl Content="{Binding Step2VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}" Value="2">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step2:ProjectSpecsView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <ContentControl Content="{Binding Step3VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}" Value="3">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step3:ClientProfileView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <ContentControl Content="{Binding Step4VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}" Value="4">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step4:PricingEstimatorView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <ContentControl Content="{Binding Step5VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}" Value="5">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step5:DataGridView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <ContentControl Content="{Binding Step6VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}" Value="6">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step6:OtherChargesView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <ContentControl Content="{Binding Step7VM}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepNumber}" Value="7">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <step7:PrintPreviewView/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{DynamicResource ModuleBackgroundBrush}"
                            CornerRadius="20"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Margin="0,16,0,0"
                            Padding="20,14"
                            SnapsToDevicePixels="True">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Command="{Binding BackToListCommand}"
                                    Style="{StaticResource GhostPillButton}"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="&#xE76B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="#4338CA"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="Invoice List"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#4338CA"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Command="{Binding PreviousStepCommand}"
                                    Style="{StaticResource NeutralPillButton}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="&#xE76B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="Back"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding StepProgressText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="3"
                                    Command="{Binding NextStepCommand}"
                                    Style="{StaticResource HeroPillButton}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Continue"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE76C;"
                                               FontFamily="Segoe MDL2 Assets"
