<!--
═══════════════════════════════════════════════════════════════════════
FILE: Views/ProformaInvoice/Step2ClientProfile/ClientProfileView.xaml
═══════════════════════════════════════════════════════════════════════
One workbench: CUSTOMER IDENTITY + BILLING | saved clients.
Bindings, commands and AutomationIds unchanged.
Theme: DynamicResource only (light / dark / Monet).
═══════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step2ClientProfile.ClientProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1100"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock"
               BasedOn="{StaticResource PiFieldLabelStyle}"/>
        <Style x:Key="InlineWarningStyle" TargetType="TextBlock"
               BasedOn="{StaticResource ModuleInlineWarningStyle}"/>
        <Style x:Key="ViewAllLinkStyle" TargetType="Button"
               BasedOn="{StaticResource PiViewAllLinkStyle}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="CLIENT PROFILE &amp; REFERENCES"
                       Style="{StaticResource ModulePageTitleStyle}"/>
            <TextBlock Text="Customer identity, billing address and the salesman on this quotation."
                       Style="{StaticResource ModulePageSubtitleStyle}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PiWorkSurfaceStyle}" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,12,0">

                        <TextBlock Text="CUSTOMER IDENTITY"
                                   Style="{StaticResource PiSectionLabelStyle}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="Client company name as it appears on the invoice">
                                    <Run Text="CUSTOMER / BILL TO NAME"/>
                                    <Run Text=" *" Foreground="{DynamicResource DangerBrush}"/>
                                </TextBlock>
                                <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Enter the client's full company name"
                                         AutomationProperties.AutomationId="ProformaInvoice.CustomerName"
                                         AutomationProperties.Name="Customer name"/>
                                <TextBlock Text="{Binding CustomerNameValidationMessage}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource InlineWarningStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCustomerNameError}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="Client's 15-digit UAE TRN for VAT compliance">
                                    <Run Text="CUSTOMER TRN"/>
                                </TextBlock>
                                <TextBox Text="{Binding CustomerTrn, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Enter the client's 15-digit UAE TRN (digits only)"
                                         MaxLength="15"/>
                                <TextBlock Text="{Binding CustomerTrnValidationMessage}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource InlineWarningStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustomerTrnValid}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="Your internal reference code for this client account">
                                    <Run Text="CUSTOMER REFERENCE CODE"/>
                                </TextBlock>
                                <TextBox Text="{Binding CustomerReferenceCode, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Optional internal client reference code"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="Your salesman assigned to this client">
                                    <Run Text="RESPONSIBLE SALES REPRESENTATIVE"/>
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              Style="{StaticResource PiEditableComboBoxStyle}"
                                              ItemsSource="{Binding SalesmanOptions}"
                                              Text="{Binding SalesRepresentative, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Select or type a salesman name. New names saved automatically."/>
                                    <Border Grid.Column="1"
                                            Width="16" Height="16"
                                            CornerRadius="{DynamicResource CardCornerRadius}"
                                            BorderThickness="2"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadingSalesmanOptions}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.RenderTransform>
                                            <RotateTransform x:Name="SalesmanSpinTransform"
                                                             CenterX="8" CenterY="8"/>
                                        </Border.RenderTransform>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="SalesmanSpinTransform"
                                                            Storyboard.TargetProperty="Angle"
                                                            From="0" To="360" Duration="0:0:1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="Name of the person preparing this document">
                                    <Run Text="DOCUMENT PREPARED BY"/>
                                </TextBlock>
                                <TextBox Text="{Binding DocumentPreparedBy, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Enter the name of the document preparer"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="BILLING &amp; CONTACT"
                                   Style="{StaticResource PiSectionLabelStyle}"/>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       ToolTip="Client's full registered billing address">
                                <Run Text="BILLING / REGISTERED ADDRESS"/>
                            </TextBlock>
                            <TextBox Text="{Binding BillingAddress, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Enter the client's full billing address"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="Name of the client executive this invoice is addressed to">
                                    <Run Text="ATTENTION EXECUTIVE NAME"/>
                                </TextBlock>
                                <TextBox Text="{Binding AttentionExecutiveName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="e.g. Mr. Ahmed Al Rashid"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="Client's primary contact mobile or office number">
                                    <Run Text="CLIENT CONTACT MOBILE / TEL"/>
                                </TextBlock>
                                <TextBox Text="{Binding ClientContactPhone, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="e.g. +971 50 123 4567"/>
                            </StackPanel>
                        </Grid>

                        <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="10,8"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility"      Value="Collapsed"/>
                                    <Setter Property="Background"      Value="{DynamicResource TintGreenBrush}"/>
                                    <Setter Property="BorderBrush"     Value="{DynamicResource SuccessBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLoadedProfile}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource SuccessBrush}">
                                <Run Text="Loaded: "/>
                                <Run Text="{Binding LoadedProfileName}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="1" Style="{StaticResource PiVerticalRuleStyle}"/>

                <DockPanel Grid.Column="2">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SAVED CLIENTS"
                                       Style="{StaticResource PiSectionLabelStyle}"
                                       Margin="0"/>
                            <TextBlock Text="Click a row to fill the form"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding RefreshCardsCommand}"
                                ToolTip="Refresh saved clients from database"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="RefreshBg"
                                            Background="Transparent"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="6,4">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RefreshBg"
                                                    Property="Background"
                                                    Value="{DynamicResource TintIndigoBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoadingCards}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="14" Height="14"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                BorderThickness="2"
                                BorderBrush="{DynamicResource AccentBrush}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="ClientSpinTransform" CenterX="7" CenterY="7"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetName="ClientSpinTransform"
                                                Storyboard.TargetProperty="Angle"
                                                From="0" To="360" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                        <TextBlock Text="Loading…"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Top">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource ModuleErrorBannerStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCardsError}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CardsErrorMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock DockPanel.Dock="Top"
                               Text="No saved clients yet. Save an invoice to build the library."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoSavedClients}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button DockPanel.Dock="Bottom"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Command="{Binding ShowAllClientsCommand}"
                            ToolTip="Show all saved client profiles">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource ViewAllLinkStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMoreClients}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextDecorations="Underline">
                            <Run Text="View all ("/>
                            <Run Text="{Binding TotalClientCount, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </Button>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SavedClientCards}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoadingCards}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasNoSavedClients}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PiSlimRowStyle}"
                                            ToolTip="Click to auto-fill all client details">
                                        <Border.InputBindings>
                                            <MouseBinding
                                                MouseAction="LeftClick"
                                                Command="{Binding DataContext.LoadClientCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding CustomerName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding TrnMasked, Mode=OneWay}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding BillingAddressPreview, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource PiUsageBadgeStyle}"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="{Binding UsageBadgeText}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
