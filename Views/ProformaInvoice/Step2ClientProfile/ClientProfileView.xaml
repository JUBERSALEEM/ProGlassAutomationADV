<!-- Step 2 — flat industrial form. No cards.
     Optional fields bind Visibility to Services.Features.ProformaFieldVisibility.
     Customer Name is DB-required and stays always visible. -->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step2ClientProfile.ClientProfileView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:features="clr-namespace:ProGlassAutomation.Services.Features"
             xmlns:shared="clr-namespace:ProGlassAutomation.Views.Shared"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="34"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource PiStationIdentityStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="02" Style="{StaticResource PiStationCodeStyle}"/>
                        <TextBlock Text="CLIENT" Style="{StaticResource PiStationTitleStyle}"/>
                        <TextBlock Text="Bill-to party, TRN and sales contact"
                                   Style="{StaticResource PiStationHintStyle}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="BILL TO" Style="{StaticResource PiSectionLabelStyle}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PiFieldLabelStyle}">
                            <Run Text="CUSTOMER NAME"/><Run Text=" *" Foreground="{DynamicResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ProformaInvoice.CustomerName"
                                 AutomationProperties.Name="Customer name"/>
                        <TextBlock Text="{Binding CustomerNameValidationMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModuleInlineWarningStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCustomerNameError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Visibility="{Binding Path=ShowCustomerTrn,
                                    Source={x:Static features:ProformaFieldVisibility.Instance},
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="CUSTOMER TRN" Style="{StaticResource PiFieldLabelStyle}"/>
                        <TextBox Text="{Binding CustomerTrn, UpdateSourceTrigger=PropertyChanged}" MaxLength="15"
                                 AutomationProperties.AutomationId="ProformaInvoice.CustomerTrn"
                                 AutomationProperties.Name="Customer TRN"/>
                        <TextBlock Text="{Binding CustomerTrnValidationMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModuleInlineWarningStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomerTrnValid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="4"
                                Visibility="{Binding Path=ShowCustomerReferenceCode,
                                    Source={x:Static features:ProformaFieldVisibility.Instance},
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="REFERENCE CODE" Style="{StaticResource PiFieldLabelStyle}"/>
                        <TextBox Text="{Binding CustomerReferenceCode, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ProformaInvoice.CustomerReferenceCode"
                                 AutomationProperties.Name="Customer reference code"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Visibility="{Binding Path=ShowSalesRepresentative,
                                    Source={x:Static features:ProformaFieldVisibility.Instance},
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="SALES REPRESENTATIVE" Style="{StaticResource PiFieldLabelStyle}"/>
                        <Grid>
                            <ComboBox Style="{StaticResource PiEditableComboBoxStyle}"
                                      ItemsSource="{Binding SalesmanOptions}"
                                      Text="{Binding SalesRepresentative, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.AutomationId="ProformaInvoice.SalesRepresentative"
                                      AutomationProperties.Name="Sales representative"/>
                            <TextBlock Text="…" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingSalesmanOptions}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Visibility="{Binding Path=ShowDocumentPreparedBy,
                                    Source={x:Static features:ProformaFieldVisibility.Instance},
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="PREPARED BY" Style="{StaticResource PiFieldLabelStyle}"/>
                        <TextBox Text="{Binding DocumentPreparedBy, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ProformaInvoice.DocumentPreparedBy"
                                 AutomationProperties.Name="Prepared by"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4"
                                Visibility="{Binding Path=ShowAttentionExecutive,
                                    Source={x:Static features:ProformaFieldVisibility.Instance},
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="ATTENTION" Style="{StaticResource PiFieldLabelStyle}"/>
                        <TextBox Text="{Binding AttentionExecutiveName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ProformaInvoice.AttentionExecutive"
                                 AutomationProperties.Name="Attention (Kind Attn.)"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12"
                      Visibility="{Binding Path=ShowClientContactPhone,
                          Source={x:Static features:ProformaFieldVisibility.Instance},
                          Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Phone.Label}" Style="{StaticResource PiFieldLabelStyle}"
                                   TextOptions.TextFormattingMode="Display"/>
                        <shared:CountryPhoneControl
                                 PhoneText="{Binding ClientContactPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ProformaInvoice.ClientContactPhone"
                                 AutomationProperties.Name="Client contact phone"/>
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="{Binding Path=ShowBillingAddress,
                                Source={x:Static features:ProformaFieldVisibility.Instance},
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="BILLING ADDRESS" Style="{StaticResource PiFieldLabelStyle}"/>
                    <TextBox Text="{Binding BillingAddress, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalContentAlignment="Top"
                             AutomationProperties.AutomationId="ProformaInvoice.BillingAddress"
                             AutomationProperties.Name="Billing address"/>
                </StackPanel>

                <TextBlock Margin="0,12,0,0" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SuccessBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLoadedProfile}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="Loaded: "/><Run Text="{Binding LoadedProfileName, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" HorizontalAlignment="Center"/>

        <DockPanel Grid.Column="2">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="SAVED" Style="{StaticResource PiSectionLabelStyle}" Margin="0" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Command="{Binding RefreshCardsCommand}"
                        Style="{StaticResource PiIconButtonStyle}" ToolTip="Refresh saved clients from database">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBodyLarge}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Button>
            </Grid>
            <TextBlock DockPanel.Dock="Top" Text="Loading…" FontSize="{StaticResource TextBody}"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoadingCards}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock DockPanel.Dock="Top" Text="{Binding CardsErrorMessage}" FontSize="{StaticResource TextBody}"
                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCardsError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock DockPanel.Dock="Top" Text="No saved clients yet."
                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoSavedClients}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Command="{Binding ShowAllClientsCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PiViewAllLinkStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMoreClients}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock FontSize="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextDecorations="Underline">
                    <Run Text="View all ("/><Run Text="{Binding TotalClientCount, Mode=OneWay}"/><Run Text=")"/>
                </TextBlock>
            </Button>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SavedClientCards}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingCards}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasNoSavedClients}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PiListRowStyle}" ToolTip="Click to auto-fill all client details">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.LoadClientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CustomerName}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TrnMasked}" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding UsageBadgeText}" FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
