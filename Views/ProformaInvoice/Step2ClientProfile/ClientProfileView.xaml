<!--
    Step 2 — Client. Approved mockup composition:
    one workbench, 3-column identity grid + billing address | saved clients.
    Bindings, commands and AutomationIds unchanged.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step2ClientProfile.ClientProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1100"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Border Style="{StaticResource PiWorkSurfaceStyle}" Padding="16,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,14,0">

                    <TextBlock Text="CLIENT"
                               Style="{StaticResource PiSectionLabelStyle}"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PiFieldLabelStyle}"
                                       ToolTip="Client company name as it appears on the invoice">
                                <Run Text="CUSTOMER NAME"/>
                                <Run Text=" *" Foreground="{DynamicResource DangerBrush}"/>
                            </TextBlock>
                            <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Enter the client's full company name"
                                     AutomationProperties.AutomationId="ProformaInvoice.CustomerName"
                                     AutomationProperties.Name="Customer name"/>
                            <TextBlock Text="{Binding CustomerNameValidationMessage}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ModuleInlineWarningStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCustomerNameError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CUSTOMER TRN"
                                       Style="{StaticResource PiFieldLabelStyle}"
                                       ToolTip="Client's 15-digit UAE TRN for VAT compliance"/>
                            <TextBox Text="{Binding CustomerTrn, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Enter the client's 15-digit UAE TRN (digits only)"
                                     MaxLength="15"/>
                            <TextBlock Text="{Binding CustomerTrnValidationMessage}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ModuleInlineWarningStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomerTrnValid}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="REFERENCE CODE"
                                       Style="{StaticResource PiFieldLabelStyle}"
                                       ToolTip="Your internal reference code for this client account"/>
                            <TextBox Text="{Binding CustomerReferenceCode, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Optional internal client reference code"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SALES REPRESENTATIVE"
                                       Style="{StaticResource PiFieldLabelStyle}"
                                       ToolTip="Your salesman assigned to this client"/>
                            <Grid>
                                <ComboBox Style="{StaticResource PiEditableComboBoxStyle}"
                                          ItemsSource="{Binding SalesmanOptions}"
                                          Text="{Binding SalesRepresentative, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Select or type a salesman name. New names saved automatically."/>
                                <TextBlock Text="…"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,28,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoadingSalesmanOptions}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PREPARED BY"
                                       Style="{StaticResource PiFieldLabelStyle}"
                                       ToolTip="Name of the person preparing this document"/>
                            <TextBox Text="{Binding DocumentPreparedBy, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Enter the name of the document preparer"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="ATTENTION"
                                       Style="{StaticResource PiFieldLabelStyle}"
                                       ToolTip="Name of the client executive this invoice is addressed to"/>
                            <TextBox Text="{Binding AttentionExecutiveName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="e.g. Mr. Ahmed Al Rashid"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PHONE"
                                       Style="{StaticResource PiFieldLabelStyle}"
                                       ToolTip="Client's primary contact mobile or office number"/>
                            <TextBox Text="{Binding ClientContactPhone, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="e.g. +971 50 123 4567"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="BILLING ADDRESS"
                               Style="{StaticResource PiFieldLabelStyle}"
                               ToolTip="Client's full registered billing address"/>
                    <TextBox Text="{Binding BillingAddress, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Enter the client's full billing address"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="72"
                             VerticalContentAlignment="Top"/>

                    <TextBlock Margin="0,12,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SuccessBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLoadedProfile}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Loaded: "/>
                        <Run Text="{Binding LoadedProfileName}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Style="{StaticResource PiVerticalRuleStyle}"/>

            <DockPanel Grid.Column="2">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SAVED CLIENTS"
                                   Style="{StaticResource PiSectionLabelStyle}"
                                   Margin="0"/>
                        <TextBlock Text="Click a row to fill the form"
                                   Style="{StaticResource PiInlineMetaStyle}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding RefreshCardsCommand}"
                            Style="{StaticResource PiIconButtonStyle}"
                            ToolTip="Refresh saved clients from database"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </Button>
                </Grid>

                <TextBlock DockPanel.Dock="Top"
                           Text="Loading…"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingCards}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding CardsErrorMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCardsError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock DockPanel.Dock="Top"
                           Text="No saved clients yet. Save an invoice to build the library."
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoSavedClients}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button DockPanel.Dock="Bottom"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        Command="{Binding ShowAllClientsCommand}"
                        ToolTip="Show all saved client profiles">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PiViewAllLinkStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMoreClients}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               TextDecorations="Underline">
                        <Run Text="View all ("/>
                        <Run Text="{Binding TotalClientCount, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </Button>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SavedClientCards}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoadingCards}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasNoSavedClients}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PiSlimRowStyle}"
                                        ToolTip="Click to auto-fill all client details">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.LoadClientCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CustomerName}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding TrnMasked, Mode=OneWay}"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding BillingAddressPreview, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Style="{StaticResource PiUsageBadgeStyle}"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="{Binding UsageBadgeText}"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
