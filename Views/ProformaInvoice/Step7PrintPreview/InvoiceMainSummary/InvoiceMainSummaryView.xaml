<!--
    Step 7 left form: label + field rows. Not icon line-items.
    Bindings unchanged.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.InvoiceMainSummary.InvoiceMainSummaryView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="520"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DiscountKindChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="10,4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NumericInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="INVOICE SUMMARY" Style="{StaticResource PiSectionLabelStyle}"/>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Glass subtotal" Style="{StaticResource SummaryLabelStyle}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding GlassMaterialsSubtotal, StringFormat=AED {0:N2}}"
                       Style="{StaticResource SummaryValueStyle}"/>
        </Grid>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Other charges" Style="{StaticResource SummaryLabelStyle}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding OtherChargesSubtotal, StringFormat=AED {0:N2}}"
                       Style="{StaticResource SummaryValueStyle}"/>
        </Grid>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Net subtotal" Style="{StaticResource SummaryLabelStyle}" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding NetSubtotal, StringFormat=AED {0:N2}}"
                       Style="{StaticResource SummaryValueStyle}"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="DISCOUNT"
                       Style="{StaticResource PiFieldLabelStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                <RadioButton Content="AED"
                             GroupName="PiDiscountKind"
                             IsChecked="{Binding IsAedDiscount, Mode=TwoWay}"
                             Style="{StaticResource DiscountKindChip}"
                             Margin="0,0,4,0"
                             ToolTip="Discount as a dirham amount, e.g. 500.23"/>
                <RadioButton Content="%"
                             GroupName="PiDiscountKind"
                             IsChecked="{Binding IsPercentageDiscount, Mode=TwoWay}"
                             Style="{StaticResource DiscountKindChip}"
                             ToolTip="Discount as a percent of net subtotal"/>
            </StackPanel>
            <TextBox Grid.Column="2"
                     Text="{Binding DiscountValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                     Style="{StaticResource NumericInputStyle}"
                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                     HorizontalAlignment="Left"
                     MinWidth="96"
                     ToolTip="Type the discount in AED (or % if that pill is on)"/>
            <TextBlock Grid.Column="3"
                       Text="{Binding DiscountUnitLabel}"
                       FontSize="{StaticResource TextBody}" FontWeight="Bold"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       VerticalAlignment="Center"
                       Margin="6,0,12,0"/>
            <TextBlock Grid.Column="4"
                       Text="{Binding DiscountAmount, StringFormat=- AED {0:N2}}"
                       FontSize="{StaticResource TextBody}" FontWeight="Bold"
                       Foreground="{DynamicResource DangerBrush}"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="ROUND TO"
                       Style="{StaticResource PiFieldLabelStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="AED"
                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox Text="{Binding RoundToGrandTotal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                         Style="{StaticResource NumericInputStyle}"
                         behaviors:TextBoxBehaviors.AcceptDecimals="True"
                         MinWidth="110"
                         ToolTip="Customer even figure, e.g. 15500.00. APPLY writes the AED discount on net subtotal."/>
                <Button Content="APPLY"
                        Command="{Binding ApplyRoundToCommand}"
                        Style="{StaticResource PiFooterPrimaryButton}"
                        Height="32"
                        MinWidth="88"
                        Margin="10,0,0,0"
                        ToolTip="Apply an AED discount so grand total equals this amount"/>
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Text="{Binding RoundToHint}"
                       FontSize="{StaticResource TextCaption}"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="220"
                       Margin="12,0,0,0"/>
        </Grid>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Subtotal before VAT" Style="{StaticResource SummaryLabelStyle}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SubtotalBeforeVat, StringFormat=AED {0:N2}}"
                       Style="{StaticResource SummaryValueStyle}"/>
        </Grid>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ToggleButton Grid.Column="0"
                          Style="{StaticResource PiToggleSwitch}"
                          IsChecked="{Binding IsVatApplicable, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          AutomationProperties.Name="VAT applicable"/>
            <TextBlock Grid.Column="1"
                       Text="VAT"
                       FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="3"
                     Text="{Binding VatPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}"
                     Style="{StaticResource NumericInputStyle}"
                     IsEnabled="{Binding IsVatApplicable}"/>
            <TextBlock Grid.Column="4"
                       Text="%"
                       FontSize="{StaticResource TextBody}" FontWeight="Bold"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       VerticalAlignment="Center"
                       Margin="6,0,12,0"/>
            <TextBlock Grid.Column="5"
                       Text="{Binding VatAmount, StringFormat=+ AED {0:N2}}"
                       FontSize="{StaticResource TextBody}" FontWeight="Bold"
                       Foreground="{DynamicResource SuccessBrush}"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="GRAND TOTAL AED"
                       FontSize="{StaticResource TextSection}" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding GrandTotalVatInclusive, StringFormat=AED {0:N2}}"
                       FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
        </Grid>
    </StackPanel>
</UserControl>
