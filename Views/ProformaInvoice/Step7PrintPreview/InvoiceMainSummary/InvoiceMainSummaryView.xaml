<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.InvoiceMainSummary.InvoiceMainSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Style x:Key="LineLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LineValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NumericInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Border Background="{DynamicResource ModuleBackgroundBrush}"
            CornerRadius="12"
            Padding="24"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}">
        <StackPanel>

            <!-- ═══ HEADER ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Background="{DynamicResource AccentBrush}"
                        Width="40" Height="40" CornerRadius="8"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#128176;"
                               FontSize="18" Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Background="{DynamicResource MenuHoverBrush}" Height="1" Margin="0,0,0,16"/>

            <!-- ═══ INCOMING FROM PREVIOUS STEPS ═══ -->

            <!-- Glass Materials Subtotal -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="&#128220;" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Glass Materials Total (Ex VAT)"
                               Style="{StaticResource LineLabelStyle}"/>
                    <TextBlock Text=" — from Step 5 DataGrid"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding GlassMaterialsSubtotal, StringFormat=AED {0:N2}}"
                           Style="{StaticResource LineValueStyle}"/>
            </Grid>

            <!-- Other Charges Subtotal -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="&#128295;" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Other Processing / Delivery Total"
                               Style="{StaticResource LineLabelStyle}"/>
                    <TextBlock Text=" — from Step 6 Other Charges"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding OtherChargesSubtotal, StringFormat=AED {0:N2}}"
                           Style="{StaticResource LineValueStyle}"/>
            </Grid>

            <Border Background="{DynamicResource MenuHoverBrush}" Height="1" Margin="0,4,0,12"/>

            <!-- Net Subtotal -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Estimated Net Subtotal"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding NetSubtotal, StringFormat=AED {0:N2}}"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- ═══ DISCOUNT INPUT ═══ -->

            <Border Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="&#128184; Discount:"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DiscountTypeOptions}"
                              SelectedItem="{Binding SelectedDiscountType}"
                              Height="38"
                              MaxWidth="140"
                              HorizontalAlignment="Left"
                              VerticalContentAlignment="Center"
                              Margin="0,0,10,0"/>

                    <TextBox Grid.Column="2"
                             Text="{Binding DiscountValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}"
                             Style="{StaticResource NumericInputStyle}"/>

                    <TextBlock Grid.Column="3"
                               Text="{Binding DiscountUnitLabel}"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,16,0"/>

                    <TextBlock Grid.Column="4"
                               Text="{Binding DiscountAmount, StringFormat=- AED {0:N2}}"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource DangerBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Background="{DynamicResource MenuHoverBrush}" Height="1" Margin="0,4,0,12"/>

            <!-- Subtotal Before VAT -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Subtotal Before VAT"
                           Style="{StaticResource LineLabelStyle}"
                           FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding SubtotalBeforeVat, StringFormat=AED {0:N2}}"
                           Style="{StaticResource LineValueStyle}"/>
            </Grid>

            <!-- ═══ VAT INPUT ═══ -->

            <Border Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsVatApplicable, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Cursor="Hand"
                              Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="1"
                               Text="&#128200; UAE VAT Applicable"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <!-- Spacer column — no TextBlock needed -->

                    <TextBox Grid.Column="3"
                             Text="{Binding VatPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}"
                             Style="{StaticResource NumericInputStyle}"
                             IsEnabled="{Binding IsVatApplicable}"/>

                    <TextBlock Grid.Column="4"
                               Text="%"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,16,0"/>

                    <TextBlock Grid.Column="5"
                               Text="{Binding VatAmount, StringFormat=+ AED {0:N2}}"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ═══ GRAND TOTAL BAND ═══ -->

            <Border Background="{DynamicResource AccentBrush}"
                    CornerRadius="12"
                    Padding="20,16"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="&#128142;"
                               FontSize="22"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="TOTAL EST VALUE"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="White" Opacity="0.9"/>
                        <TextBlock Text="(VAT Inclusive)"
                                   FontSize="10"
                                   Foreground="White" Opacity="0.7"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding GrandTotalVatInclusive, StringFormat=AED {0:N2}}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </StackPanel>
    </Border>
</UserControl>