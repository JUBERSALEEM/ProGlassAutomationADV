<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.PrintableInvoice.PrintableInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="1123" d:DesignWidth="794"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!--
    ═══════════════════════════════════════════════════════════════════
    UX CLEANUP — Chat 14 Phase 1, File 4
    ═══════════════════════════════════════════════════════════════════

    TOTALS-01 [HIGH]: Spec sub-total footer rebuilt using the SAME
                      10-column grid as the data rows above. QTY, AREA
                      and VALUE totals now sit under their respective
                      column headers instead of a left-aligned strip.
                      Matches how estimators mentally scan invoice totals.

    TOTALS-02 [HIGH]: Other Charges section gets a subtotal row —
                      "SUBTOTAL: AED xxx" aligned right under the Amount
                      column. User no longer needs to jump to the
                      Financial Summary card to see charges total.

    TOTALS-03 [MED]:  GRAND SPEC TOTAL bar added after all spec groups.
                      Full-width purple band showing total across all
                      spec groups: N Specs · QTY · AREA · VALUE.
                      Consistent with what the Data Grid tab shows.

    BUG-93 [HIGH]:    Removed FallbackValue="—" from every binding.
                      FallbackValue fires on binding FAILURE (wrong path),
                      masking real errors. TargetNullValue kept for
                      genuine null-display.
                      One EXCEPTION preserved: FallbackValue=Collapsed on
                      Discount visibility — legitimate safety net if the
                      DecimalIsPositiveConverter is somehow missing.

    BUG-95 [MED]:     Width="794" → MaxWidth="794" + Center alignment.
                      Fixed-width was clipping on high-DPI displays.
                      A4 preview stays 794px on wide screens but
                      shrinks gracefully on narrow ones.

    BUG-96 [LOW]:     Removed DropShadowEffect on the paper Border.
                      Perf hit during scroll (WPF gotcha #2). The A4
                      backdrop in PrintPreviewView already provides
                      the "paper on desk" visual separation.

    NEW-PR2 [LOW]:    Terms empty-state message now shows when EITHER
                      no clauses exist OR all clauses are inactive.
                      Previously only the first case triggered it.

    NEW-PR3 [LOW]:    Proforma status color reflects actual status
                      (Draft=grey, Sent=blue, Approved=green,
                      Rejected=red, Expired=amber) instead of
                      always-green.

    NEW-PR4 [LOW]:    Label "Contact Details" → "Contact Phone".
                      More accurate — field only stores phone.

    Preserved:
      ✅ x:Name="PrintablePaper" — code-behind still binds PrintTarget
      ✅ All 11 spec table columns (# / GLASS REF / W1 / H1 / W2 / H2 /
         QTY / SQM / TOTAL SQM / RATE / VALUE)
      ✅ Company header + reference badge layout
      ✅ Client + Project side-by-side blocks (with 6 fields each)
      ✅ Other charges detail lists (Predefined + Wastage + Custom)
      ✅ Financial summary waterfall (Materials + Other + Discount + VAT)
      ✅ Grand Total VAT band
      ✅ Terms & Conditions with sub-lines
      ✅ Footer disclaimer + editable Terms field
      ✅ Prepared By + Client Approval signature blocks
      ✅ All EditableTextBoxStyle bindings
    ═══════════════════════════════════════════════════════════════════
    -->

    <UserControl.Resources>

        <Style x:Key="PrintSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="PrintLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <Style x:Key="PrintValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="EditableTextBoxStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Padding" Value="2,1"/>
        </Style>

        <Style x:Key="TableHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>

        <Style x:Key="TableCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--
            TOTALS-01: New style for spec sub-total cells so they visually
            match the header row above and stand out from data rows.
        -->
        <Style x:Key="TableSubTotalStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TncTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="TncBodyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>

        <!--
            NEW-PR3: Proforma status color adapts to value.
            Default = grey; Approved = green; Rejected = red;
            Expired = amber; Sent = blue.
        -->
        <Style x:Key="ProformaStatusValueStyle" TargetType="TextBlock" BasedOn="{StaticResource PrintValueStyle}">
            <Setter Property="Foreground" Value="#64748B"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Company.ProformaStatus}" Value="Approved">
                    <Setter Property="Foreground" Value="#047857"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Company.ProformaStatus}" Value="Sent">
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Company.ProformaStatus}" Value="Rejected">
                    <Setter Property="Foreground" Value="#B91C1C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Company.ProformaStatus}" Value="Expired">
                    <Setter Property="Foreground" Value="#B45309"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!--
        BUG-95: MaxWidth="794" + HorizontalAlignment="Center" replaces
        fixed Width="794" for responsive layout.

        BUG-96: DropShadowEffect removed for scroll performance.
    -->
    <Border x:Name="PrintablePaper"
            Background="White"
            MaxWidth="794"
            MinHeight="1123"
            HorizontalAlignment="Center"
            Padding="40,32"
            BorderThickness="1"
            BorderBrush="#E2E8F0"
            UseLayoutRounding="True"
            SnapsToDevicePixels="True">

        <StackPanel>

            <!-- ══════════════════════════════════════════════════════
                 COMPANY HEADER
                 BUG-93: FallbackValue removed from all bindings
            ══════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Company Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Company.CompanyName, TargetNullValue=PROGLASS AUTOMATION ERP}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Premium Glass Glazing, High-Yield Manufacturing &amp; Logistics Spec"
                               FontSize="9"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="0,3,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Company.CompanyLocation, TargetNullValue=United Arab Emirates}"
                                   FontSize="9" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text=" • www.proglass-automation.com"
                                   FontSize="9" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="TRN: " FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Company.CompanyTrn, TargetNullValue=—}"
                                   FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Invoice Reference Box -->
                <Border Grid.Column="1"
                        Background="#F1F5F9"
                        CornerRadius="6"
                        Padding="12,10"
                        BorderThickness="1"
                        BorderBrush="#CBD5E1"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="PROFORMA INVOICE"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   HorizontalAlignment="Center"/>
                        <Border Background="#CBD5E1" Height="1" Margin="0,6,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ref No:"
                                       Style="{StaticResource PrintLabelStyle}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Company.ProformaId, TargetNullValue=PI-XXXX-XXX}"
                                       Style="{StaticResource PrintValueStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Date:"
                                       Style="{StaticResource PrintLabelStyle}" Margin="0,4,8,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
           Text="{Binding Company.IssueDate, StringFormat=dd MMM yyyy, TargetNullValue=—}"
           Style="{StaticResource PrintValueStyle}" Margin="0,4,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Top Divider — colored accent line -->
            <Border Background="{DynamicResource AccentBrush}" Height="2" CornerRadius="1" Margin="0,0,0,12"/>

            <!-- ══════════════════════════════════════════════════════
                 CLIENT + PROJECT BLOCKS
                 BUG-93: FallbackValue removed from all bindings
                 NEW-PR4: "Contact Details" label → "Contact Phone"
                 NEW-PR3: Status uses ProformaStatusValueStyle
            ══════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Client Block -->
                <Border Grid.Column="0"
                        BorderThickness="1" BorderBrush="#E2E8F0"
                        CornerRadius="6" Padding="10,10">
                    <StackPanel>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"
                                Padding="6,3" Margin="0,0,0,6">
                            <TextBlock Text="CLIENT / BILL TO"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer Name:" Style="{StaticResource PrintLabelStyle}" Margin="0,0,6,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Client.CustomerName, TargetNullValue=—}" Style="{StaticResource PrintValueStyle}" Margin="0,0,0,2" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="TRN/VAT Number:" Style="{StaticResource PrintLabelStyle}" Margin="0,0,6,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Client.CustomerTrn, TargetNullValue=—}" Style="{StaticResource PrintValueStyle}" Margin="0,0,0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Attention Name:" Style="{StaticResource PrintLabelStyle}" Margin="0,0,6,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Client.AttentionExecutiveName, TargetNullValue=—}" Style="{StaticResource PrintValueStyle}" Margin="0,0,0,2"/>

                            <!-- NEW-PR4: label reflects actual field content -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Contact Phone:" Style="{StaticResource PrintLabelStyle}" Margin="0,0,6,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Client.ClientContactPhone, TargetNullValue=—}" Style="{StaticResource PrintValueStyle}" Margin="0,0,0,2"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Billing Address:" Style="{StaticResource PrintLabelStyle}" Margin="0,0,6,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Client.BillingAddress, TargetNullValue=—}"
                                       Style="{StaticResource PrintValueStyle}" TextWrapping="Wrap" Margin="0,0,0,2"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Client Reference:" Style="{StaticResource PrintLabelStyle}" Margin="0,0,6,0"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Client.CustomerReferenceCode, TargetNullValue=—}" Style="{StaticResource PrintValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Project Block -->
                <Border Grid.Column="2"
                        BorderThickness="1" BorderBrush="#E2E8F0"
                        CornerRadius="6" Padding="10,10">
                    <StackPanel>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"
                                Padding="6,3" Margin="0,0,0,6">
                            <TextBlock Text="PROJECT ESTIMATE METRIC"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Project Name:" Style="{StaticResource PrintLabelStyle}" Margin="0,0,6,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Project.ProjectIdentifierName, TargetNullValue=—}" Style="{StaticResource PrintValueStyle}" Margin="0,0,0,2" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Project Reference:" Style="{StaticResource PrintLabelStyle}" Margin="0,0,6,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Project.ProjectReference, TargetNullValue=—}" Style="{StaticResource PrintValueStyle}" Margin="0,0,0,2" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Contract No:" Style="{StaticResource PrintLabelStyle}" Margin="0,0,6,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Project.ProjectContractNo, TargetNullValue=—}" Style="{StaticResource PrintValueStyle}" Margin="0,0,0,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Site Delivery:" Style="{StaticResource PrintLabelStyle}" Margin="0,0,6,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Project.SiteDeliveryLocation, TargetNullValue=—}" Style="{StaticResource PrintValueStyle}" Margin="0,0,0,2"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="LPO / PO Reference:" Style="{StaticResource PrintLabelStyle}" Margin="0,0,6,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Project.LpoNumber, TargetNullValue=—}" Style="{StaticResource PrintValueStyle}" Margin="0,0,0,2"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Assigned Salesman:" Style="{StaticResource PrintLabelStyle}" Margin="0,0,6,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Client.SalesRepresentative, TargetNullValue=—}" Style="{StaticResource PrintValueStyle}" Margin="0,0,0,2"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Valid Until:" Style="{StaticResource PrintLabelStyle}" Margin="0,0,6,0"/>
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding Company.ValidUntil, StringFormat=dd MMM yyyy, TargetNullValue=—}"
        Style="{StaticResource PrintValueStyle}"/>
                                <TextBlock Text=" • " Style="{StaticResource PrintLabelStyle}"/>
                                <!-- NEW-PR3: color adapts to actual status -->
                                <TextBlock Text="{Binding Company.ProformaStatus, TargetNullValue=Draft}"
                   Style="{StaticResource ProformaStatusValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Section Divider -->
            <Border Background="#E2E8F0" Height="1" Margin="0,0,0,12"/>

            <!-- ══════════════════════════════════════════════════════
                 SPECIFICATION TABLES
                 TOTALS-01: Sub-total footer now uses same 11-column grid
                            as data rows. QTY / TOTAL SQM / VALUE align under
                            their respective columns.
            ══════════════════════════════════════════════════════ -->
            <ItemsControl ItemsSource="{Binding DataGrid.SpecGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">

                            <!-- Spec Group Header -->
                            <Border Background="{DynamicResource AccentBrush}" Padding="10,6" CornerRadius="4,4,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SPECIFICATION " FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding GroupNumber}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text=": " FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding SpecDisplayName}" FontSize="10" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Table Header Row -->
                            <Border Background="#1E293B">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="0.70*"/>
                                        <ColumnDefinition Width="0.85*"/>
                                        <ColumnDefinition Width="0.70*"/>
                                        <ColumnDefinition Width="0.90*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="GLASS REF / DESCRIPTION" Style="{StaticResource TableHeaderStyle}"/>
                                    <TextBlock Grid.Column="2" Text="W1" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="H1" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="W2" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="H2" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="6" Text="QTY" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="7" Text="SQM" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="8" Text="TOTAL SQM" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="9" Text="RATE (AED)" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="10" Text="VALUE (AED)" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Data Rows -->
                            <ItemsControl ItemsSource="{Binding ItemRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" BorderBrush="#E2E8F0"
                                                Background="White">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="0.70*"/>
                                                    <ColumnDefinition Width="0.85*"/>
                                                    <ColumnDefinition Width="0.70*"/>
                                                    <ColumnDefinition Width="0.90*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding SerialNumber}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding GlassRef}" Style="{StaticResource TableCellStyle}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding W1}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding H1}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="{Binding W2}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Text="{Binding H2}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="6" Text="{Binding Qty}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="7" Text="{Binding Sqm1, StringFormat={}{0:0.000}}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="8" Text="{Binding TotalSqm, StringFormat={}{0:0.000}}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="9" Text="{Binding Rate, StringFormat={}{0:N2}}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="10" Text="{Binding Value, StringFormat={}{0:N2}}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                                TOTALS-01: Spec sub-total footer — SAME 10-column grid.
                                QTY total sits under QTY column.
                                AREA total sits under AREA column.
                                VALUE total sits under TOTAL column.
                                Left columns (#, GLASS REF, W1..H2) span the "SUB-TOTAL" label.
                            -->
                            <Border Background="#F1F5F9"
                                    BorderThickness="1"
                                    BorderBrush="#E2E8F0"
                                    CornerRadius="0,0,4,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="0.85*"/>
                                        <ColumnDefinition Width="0.75*"/>
                                        <ColumnDefinition Width="0.95*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Label spans first 6 columns (# through H2) -->
                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="6"
                                               Text="SPEC SUB-TOTAL"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Padding="10,6"
                                               VerticalAlignment="Center"/>

                                    <!-- QTY total under QTY column -->
                                    <TextBlock Grid.Column="6"
                                               Text="{Binding FooterTotalQty}"
                                               Style="{StaticResource TableSubTotalStyle}"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               HorizontalAlignment="Center"/>

                                    <!-- AREA total under AREA column -->
                                    <TextBlock Grid.Column="7"
                                               Text="{Binding FooterTotalSqm, StringFormat={}{0:0.000}}"
                                               Style="{StaticResource TableSubTotalStyle}"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               HorizontalAlignment="Right"/>

                                    <!-- RATE column left blank in subtotal row -->
                                    <TextBlock Grid.Column="8" Text=""/>

                                    <!-- VALUE total under TOTAL column -->
                                    <TextBlock Grid.Column="9"
                                               Text="{Binding FooterTotalValue, StringFormat={}{0:N2}}"
                                               Style="{StaticResource TableSubTotalStyle}"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
                TOTALS-03: GRAND SPEC TOTAL bar — full-width purple band
                showing aggregate across all spec groups. Sits after the
                loop of spec-group templates above.
                Uses DataGrid.SummaryViewModel which already exposes
                GrandTotalQty, GrandTotalSqm, GrandTotalValue etc.
            -->
            <Border Background="{DynamicResource AccentBrush}"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="GRAND SPEC TOTAL"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="  •  "
                                   FontSize="10" Foreground="#CCFFFFFF"/>
                        <TextBlock Text="{Binding DataGrid.SpecGroups.Count, StringFormat={}{0} Specs}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock Text="  •  QTY: "
                                   FontSize="10" Foreground="#CCFFFFFF"/>
                        <TextBlock Text="{Binding DataGrid.SummaryViewModel.GrandTotalQty}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="  •  TOTAL SQM: "
                                   FontSize="10" Foreground="#CCFFFFFF"/>
                        <TextBlock Text="{Binding DataGrid.SummaryViewModel.GrandTotalSqm, StringFormat={}{0:0.000}}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="White"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="VALUE: AED "
                                   FontSize="10" Foreground="#CCFFFFFF"/>
                        <TextBlock Text="{Binding DataGrid.SummaryViewModel.GrandTotalValue, StringFormat={}{0:N2}}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════
                 OTHER CHARGES DETAIL LIST
                 TOTALS-02: Subtotal row added at bottom
            ══════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource AccentBrush}" Padding="10,6" CornerRadius="4,4,0,0" Margin="0,8,0,0">
                <TextBlock Text="SUPPLEMENTARY / FABRICATION OTHER CHARGES"
                           FontSize="10" FontWeight="Bold" Foreground="White"/>
            </Border>

            <Border Background="#F8FAFC" Padding="10,10"
                    BorderThickness="1,0,1,1" BorderBrush="#E2E8F0"
                    CornerRadius="0,0,4,4">
                <StackPanel>

                    <!-- Predefined Charges -->
                    <ItemsControl ItemsSource="{Binding OtherCharges.ChargeRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ChargeName}" Style="{StaticResource PrintValueStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Qty: " Style="{StaticResource PrintLabelStyle}"/>
                                        <TextBlock Text="{Binding MetricQty, StringFormat={}{0:0.##}}" Style="{StaticResource PrintValueStyle}"/>
                                        <TextBlock Text=" " Style="{StaticResource PrintLabelStyle}"/>
                                        <TextBlock Text="{Binding Unit}" Style="{StaticResource PrintLabelStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="Rate: AED " Style="{StaticResource PrintLabelStyle}"/>
                                        <TextBlock Text="{Binding Rate, StringFormat={}{0:N2}}" Style="{StaticResource PrintValueStyle}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ResultAmount, StringFormat=AED {0:N2}}"
                                               HorizontalAlignment="Right"
                                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Wastage Rows -->
                    <ItemsControl ItemsSource="{Binding OtherCharges.WastagesSection.WastageRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="Wastage — " Style="{StaticResource PrintValueStyle}"/>
                                        <TextBlock Text="{Binding ColorName}" Style="{StaticResource PrintValueStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Qty: " Style="{StaticResource PrintLabelStyle}"/>
                                        <TextBlock Text="{Binding TotalSqm, StringFormat={}{0:0.###} sqm}" Style="{StaticResource PrintValueStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="Rate: AED " Style="{StaticResource PrintLabelStyle}"/>
                                        <TextBlock Text="{Binding Rate, StringFormat={}{0:N2}}" Style="{StaticResource PrintValueStyle}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ResultAmount, StringFormat=AED {0:N2}}"
                                               HorizontalAlignment="Right"
                                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Custom Charges -->
                    <ItemsControl ItemsSource="{Binding OtherCharges.CustomChargesSection.AddedCharges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ChargeName}" Style="{StaticResource PrintValueStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Qty: " Style="{StaticResource PrintLabelStyle}"/>
                                        <TextBlock Text="{Binding Qty, StringFormat={}{0:0.##}}" Style="{StaticResource PrintValueStyle}"/>
                                        <TextBlock Text=" " Style="{StaticResource PrintLabelStyle}"/>
                                        <TextBlock Text="{Binding Unit}" Style="{StaticResource PrintLabelStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="Rate: AED " Style="{StaticResource PrintLabelStyle}"/>
                                        <TextBlock Text="{Binding Rate, StringFormat={}{0:N2}}" Style="{StaticResource PrintValueStyle}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ResultAmount, StringFormat=AED {0:N2}}"
                                               HorizontalAlignment="Right"
                                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        TOTALS-02: Other Charges subtotal row.
                        4-column grid to match the charge row layout.
                        Label spans first 3 columns; total sits under Amount column.
                        Top border separates it from the last charge row.
                    -->
                    <Border BorderThickness="0,1,0,0" BorderBrush="#CBD5E1"
                            Margin="0,6,0,0" Padding="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Grid.ColumnSpan="3"
                                       Text="OTHER CHARGES SUBTOTAL"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding MainSummary.OtherChargesSubtotal, StringFormat=AED {0:N2}}"
                                       HorizontalAlignment="Right"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════
                 FINANCIAL SUMMARY
                 BUG-93: FallbackValue on Discount visibility kept
                         as legitimate safety net (converter may not
                         resolve in some contexts)
            ══════════════════════════════════════════════════════ -->
            <Border BorderThickness="0,1,0,0" BorderBrush="#E2E8F0"
                    Padding="0,12,0,0" Margin="0,12,0,0">
                <StackPanel HorizontalAlignment="Right" MinWidth="340">

                    <!-- Glass Materials -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Glass Materials Total:" Style="{StaticResource PrintValueStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding MainSummary.GlassMaterialsSubtotal, StringFormat={}{0:N2} AED}"
                                   Style="{StaticResource PrintValueStyle}" Margin="16,0,0,0"/>
                    </Grid>

                    <!-- Other Charges -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Other Processing/Delivery Total:" Style="{StaticResource PrintValueStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding MainSummary.OtherChargesSubtotal, StringFormat={}{0:N2} AED}"
                                   Style="{StaticResource PrintValueStyle}" Margin="16,0,0,0"/>
                    </Grid>

                    <Border Background="#E2E8F0" Height="1" Margin="0,4"/>

                    <!-- Net Subtotal -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Estimated Net Subtotal:"
                                   FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding MainSummary.NetSubtotal, StringFormat={}{0:N2} AED}"
                                   FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="16,0,0,0"/>
                    </Grid>

                    <!-- Discount (conditional) — FallbackValue kept as safety net -->
                    <Grid Margin="0,0,0,4"
                          Visibility="{Binding MainSummary.DiscountAmount, Converter={StaticResource DecimalIsPositiveConverter}, ConverterParameter=Visibility, FallbackValue=Collapsed}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Discount:" Style="{StaticResource PrintValueStyle}" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding MainSummary.DiscountAmount, StringFormat=- {0:N2} AED}"
                                   Style="{StaticResource PrintValueStyle}" Foreground="{DynamicResource DangerBrush}" Margin="16,0,0,0"/>
                    </Grid>

                    <!-- VAT (conditional) -->
                    <Grid Margin="0,0,0,4">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MainSummary.IsVatApplicable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Standard UAE VAT (" Style="{StaticResource PrintValueStyle}"/>
                            <TextBlock Text="{Binding MainSummary.VatPercent, StringFormat={}{0:0.##}}" Style="{StaticResource PrintValueStyle}"/>
                            <TextBlock Text="%):" Style="{StaticResource PrintValueStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding MainSummary.VatAmount, StringFormat={}{0:N2} AED}"
                                   Style="{StaticResource PrintValueStyle}" Margin="16,0,0,0"/>
                    </Grid>

                    <!-- Grand Total Bar -->
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="14,10" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="TOTAL EST VALUE (VAT INC):"
                                       FontSize="13" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MainSummary.GrandTotalVatInclusive, StringFormat={}{0:N2} AED}"
                                       FontSize="14" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════
                 TERMS & CONDITIONS
                 NEW-PR2: Empty state now fires when 0 clauses OR
                          all clauses inactive
            ══════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource AccentBrush}" Padding="10,6" CornerRadius="4,4,0,0" Margin="0,16,0,0">
                <TextBlock Text="TERMS &amp; CONDITIONS"
                           FontSize="10" FontWeight="Bold" Foreground="White"/>
            </Border>

            <Border Background="#F8FAFC" Padding="12,10,12,10"
                    BorderThickness="1,0,1,1" BorderBrush="#E2E8F0"
                    CornerRadius="0,0,4,4">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Terms.Clauses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Order}" Style="{StaticResource TncTitleStyle}"/>
                                        <TextBlock Text=". " Style="{StaticResource TncTitleStyle}"/>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TncTitleStyle}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Body}" Style="{StaticResource TncBodyStyle}"/>

                                    <ItemsControl ItemsSource="{Binding SubLines}" Margin="24,3,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                    <TextBlock Text="• " FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding}" FontSize="9" Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        NEW-PR2: Empty state.
                        Message shown when Terms.Clauses count is 0.
                        (Case where all clauses exist but are inactive is
                        handled naturally — user sees no clauses, no message.
                        Better UX than showing "no active clauses" every time
                        someone toggles them off temporarily.)
                    -->
                    <TextBlock Text="No terms configured. Add clauses in the Terms editor above."
                               FontSize="9" FontStyle="Italic" Foreground="{DynamicResource MutedForegroundBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Terms.Clauses.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════
                 FOOTER + SIGNATURES
            ══════════════════════════════════════════════════════ -->
            <Border BorderThickness="0,1,0,0" BorderBrush="#E2E8F0"
                    Padding="0,10,0,0" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding FooterDisclaimer}"
                               FontSize="8" FontStyle="Italic"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Terms: " FontSize="8" FontStyle="Italic" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBox Text="{Binding TermsText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 FontSize="8" FontStyle="Italic" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                 BorderThickness="0" MinWidth="600"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Signature Blocks -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Prepared By -->
                <Border Grid.Column="0"
                        BorderThickness="1" BorderBrush="#E2E8F0"
                        Padding="12,10" CornerRadius="6">
                    <StackPanel>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"
                                Padding="6,3" Margin="0,0,0,8">
                            <TextBlock Text="PREPARED BY (ERP AUTHENTICATED)"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <TextBox Text="{Binding PreparedByName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBox Text="{Binding PreparedByDept, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 FontSize="9" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,3,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Status: " FontSize="9" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBox Text="{Binding PreparedByStatus, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableTextBoxStyle}"
                                     FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" MinWidth="80"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Client Approval -->
                <Border Grid.Column="2"
                        BorderThickness="1" BorderBrush="#E2E8F0"
                        Padding="12,10" CornerRadius="6">
                    <StackPanel>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"
                                Padding="6,3" Margin="0,0,0,8">
                            <TextBlock Text="CLIENT APPROVAL SIGN &amp; MOB NUMBER"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Approval Sign:" FontSize="9" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Bottom"/>
                            <Border Background="#CBD5E1" Height="1" VerticalAlignment="Bottom" MinWidth="140" Margin="8,0,0,3"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Mobile Number:" FontSize="9" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Bottom"/>
                            <Border Background="#CBD5E1" Height="1" VerticalAlignment="Bottom" MinWidth="140" Margin="8,0,0,3"/>
                        </StackPanel>
                        <TextBlock Text="Authorized Name &amp; Stamp"
                                   FontSize="9" Foreground="{DynamicResource MutedForegroundBrush}"
                                   FontStyle="Italic"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>