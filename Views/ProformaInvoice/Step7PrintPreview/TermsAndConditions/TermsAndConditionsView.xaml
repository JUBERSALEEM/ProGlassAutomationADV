<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.TermsAndConditions.TermsAndConditionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:ProGlassAutomation.Models.ProformaInvoice.Step7PrintPreview.TermsAndConditions"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TitleBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputBoxStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SmallIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="{DynamicResource ModuleBackgroundBrush}"
            CornerRadius="10" Padding="16"
            BorderThickness="1.5" BorderBrush="{DynamicResource AccentBrush}">

        <StackPanel>

            <!-- ── HEADER + Global actions ── -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📜" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding AddCustomClauseCommand}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White" FontWeight="Bold" FontSize="10"
                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="14" FontWeight="Bold" Margin="0,-2,6,0"/>
                            <TextBlock Text="ADD CUSTOM CLAUSE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ResetToDefaultsCommand}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource MenuHoverBrush}" BorderThickness="1"
                            Foreground="{DynamicResource PrimaryForegroundBrush}" FontWeight="SemiBold" FontSize="10"
                            Padding="12,6" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⟲" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="RESET TO DEFAULTS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource MenuHoverBrush}" Height="1" Margin="0,0,0,12"/>

            <!-- ── LIST OF CLAUSES ── -->
            <ItemsControl ItemsSource="{Binding Clauses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TermClause}">
                        <Border Background="{DynamicResource WindowBackgroundBrush}"
                                CornerRadius="8" Padding="12" Margin="0,0,0,10"
                                BorderThickness="1" BorderBrush="{DynamicResource MenuHoverBrush}">
                            <StackPanel>

                                <!-- ── Clause header row: order badge + active toggle + title editor + actions -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Order badge -->
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource AccentBrush}"
                                            Width="26" Height="26" CornerRadius="4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Order}" FontSize="11" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Active checkbox -->
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding IsActive}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ToolTip="Include this clause on printed invoice"/>

                                    <!-- Title editor -->
                                    <TextBox Grid.Column="2"
                                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TitleBoxStyle}"
                                             Margin="0,0,8,0"/>

                                    <!-- Row actions -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                ToolTip="Move up">
                                            <TextBlock Text="▲"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                ToolTip="Move down">
                                            <TextBlock Text="▼"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.RemoveClauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                Foreground="#EF4444"
                                                ToolTip="Delete clause">
                                            <TextBlock Text="✕"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- ── Body text editor -->
                                <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBoxStyle}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="40"
                                         Margin="30,0,0,0"
                                         VerticalContentAlignment="Top"/>

                                <!-- ── Validity days picker (only for Validity clause) -->
                                <StackPanel Orientation="Horizontal" Margin="30,8,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:TermClauseType.Validity}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Validity Days:" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox ItemsSource="{Binding DataContext.ValidityDayOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding ValidityDays}"
                                              MinWidth="80" Height="30" VerticalContentAlignment="Center"/>
                                    <TextBlock Text=" (2-7 days depending on current market conditions)"
                                               FontSize="9" FontStyle="Italic"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>

                                <!-- ── Payment Terms sub-lines (only for PaymentTerms clause) -->
                                <StackPanel Margin="30,8,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:TermClauseType.PaymentTerms}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="PAYMENT SUB-CONDITIONS:" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Command="{Binding DataContext.AddPaymentSubLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                Padding="6,2" Margin="10,0,0,0" Cursor="Hand"
                                                Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="+" Margin="0,-2,4,0"/>
                                                <TextBlock Text="ADD LINE"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding SubLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="•" FontSize="14" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Mode=OneWay}"
                                                             Style="{StaticResource InputBoxStyle}"
                                                             FontSize="11"
                                                             IsReadOnly="True"
                                                             ToolTip="To edit, remove this line and add a new one"/>
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource SmallIconButtonStyle}"
                                                            Foreground="#EF4444"
                                                            Command="{Binding DataContext.RemovePaymentSubLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Remove line">
                                                        <TextBlock Text="✕"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <TextBlock Text="No terms configured. Click '+ ADD CUSTOM CLAUSE' or 'RESET TO DEFAULTS' to begin."
                       FontSize="11" FontStyle="Italic"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       HorizontalAlignment="Center" Margin="0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Clauses.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </StackPanel>
    </Border>
</UserControl>