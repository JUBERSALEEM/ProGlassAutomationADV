<!--
    Step 7 terms checklist. Compact rows, not a card per clause.
    All edit / reorder / payment-subline bindings kept.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.TermsAndConditions.TermsAndConditionsView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:ProGlassAutomation.Models.ProformaInvoice.Step7PrintPreview.TermsAndConditions"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="520"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TitleBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputBoxStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,8">
            <TextBlock Text="TERMS CHECKLIST" Style="{StaticResource PiSectionLabelStyle}" Margin="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding AddCustomClauseCommand}"
                        Style="{StaticResource PiGhostChipButton}"
                        Margin="0,0,8,0"
                        Content="+ CLAUSE"/>
                    <Button Command="{Binding ResetToDefaultsCommand}"
                            Style="{StaticResource PiViewAllLinkStyle}">
                        <TextBlock Text="Reset defaults" TextDecorations="Underline"/>
                    </Button>
            </StackPanel>
        </Grid>

        <ItemsControl ItemsSource="{Binding Clauses}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:TermClause}">
                    <Border BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource PiToggleSwitch}"
                                              IsChecked="{Binding IsActive}"
                                              VerticalAlignment="Center"
                                              ToolTip="Include this clause on the printed invoice"
                                              AutomationProperties.Name="Include term"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TitleBoxStyle}"
                                         Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PiIconButtonStyle}"
                                            ToolTip="Move up">
                                        <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PiIconButtonStyle}"
                                            ToolTip="Move down">
                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.RemoveClauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PiIconButtonStyle}"
                                            ToolTip="Delete clause">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBoxStyle}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="40"
                                     Margin="64,6,0,0"
                                     VerticalContentAlignment="Top"/>

                            <StackPanel Orientation="Horizontal" Margin="64,6,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:TermClauseType.Validity}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Validity days"
                                           Style="{StaticResource PiInlineMetaStyle}"
                                           Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding DataContext.ValidityDayOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding ValidityDays}"
                                          Style="{StaticResource PiComboBoxStyle}"
                                          Height="28"
                                          MinWidth="72"/>
                            </StackPanel>

                            <StackPanel Margin="64,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:TermClauseType.PaymentTerms}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="PAYMENT LINES"
                                               Style="{StaticResource PiSectionLabelStyle}"
                                               Margin="0"
                                               VerticalAlignment="Center"/>
                                    <Button Command="{Binding DataContext.AddPaymentSubLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PiGhostChipButton}"
                                            Margin="10,0,0,0"
                                            Content="+ LINE"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding SubLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Mode=OneWay}"
                                                         Style="{StaticResource InputBoxStyle}"
                                                         FontSize="11"
                                                         IsReadOnly="True"
                                                         ToolTip="To edit, remove this line and add a new one"/>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource PiIconButtonStyle}"
                                                        Command="{Binding DataContext.RemovePaymentSubLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Remove line">
                                                    <TextBlock Text="&#xE711;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="No terms configured. Add a clause or reset to defaults."
                   FontSize="11"
                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                   Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Clauses.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
