<!--
    Step 7 terms checklist. Compact rows, not a card per clause.
    All edit / reorder / payment-subline bindings kept.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.TermsAndConditions.TermsAndConditionsView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:ProGlassAutomation.Models.ProformaInvoice.Step7PrintPreview.TermsAndConditions"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="520"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        
        
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource ProformaInvoice.TermsChecklist}" Style="{StaticResource PiSectionLabelStyle}" Margin="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding AddCustomClauseCommand}"
                        Style="{StaticResource PiGhostChipButton}"
                        Margin="0,0,8,0"
                        Content="{DynamicResource ProformaInvoice.Clause}"/>
                    <Button Command="{Binding ResetToDefaultsCommand}"
                            Style="{StaticResource PiViewAllLinkStyle}">
                        <TextBlock Text="{DynamicResource ProformaInvoice.ResetDefaults}" TextDecorations="Underline"/>
                    </Button>
            </StackPanel>
        </Grid>

        <ItemsControl ItemsSource="{Binding Clauses}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:TermClause}">
                    <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource PiToggleSwitch}"
                                              IsChecked="{Binding IsActive}"
                                              VerticalAlignment="Center"
                                              ToolTip="{DynamicResource ProformaInvoice.IncludeClausePrintedInvoice}"
                                              AutomationProperties.Name="Include term"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.SemiBold}"
                                         Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PiIconButtonStyle}"
                                            ToolTip="{DynamicResource ProformaInvoice.Move2}">
                                        <TextBlock Text="&#xE70E;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PiIconButtonStyle}"
                                            ToolTip="{DynamicResource ProformaInvoice.Move}">
                                        <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.RemoveClauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PiIconButtonStyle}"
                                            ToolTip="{DynamicResource ProformaInvoice.DeleteClause}">
                                        <TextBlock Text="&#xE711;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input.TextBox}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="40"
                                     Margin="64,6,0,0"
                                     VerticalContentAlignment="Top"/>

                            <StackPanel Orientation="Horizontal" Margin="64,6,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:TermClauseType.Validity}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{DynamicResource ProformaInvoice.ValidityDays}"
                                           Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding DataContext.ValidityDayOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding ValidityDays}"
                                          Style="{StaticResource PiComboBoxStyle}"
                                          Height="28"
                                          MinWidth="72"/>
                            </StackPanel>

                            <StackPanel Margin="64,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:TermClauseType.PaymentTerms}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource ProformaInvoice.PaymentLines}"
                                               Margin="0"
                                               VerticalAlignment="Center"/>
                                    <Button Command="{Binding DataContext.AddPaymentSubLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PiGhostChipButton}"
                                            Margin="10,0,0,0"
                                            Content="{DynamicResource ProformaInvoice.LINE}"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding SubLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Mode=OneWay}"
                                                         Style="{StaticResource Input.TextBox}"
                                                         FontSize="{DynamicResource FontSize.Body}"
                                                         IsReadOnly="True"
                                                         ToolTip="{DynamicResource ProformaInvoice.EditRemoveLineAddNewOne}"/>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource PiIconButtonStyle}"
                                                        Command="{Binding DataContext.RemovePaymentSubLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{DynamicResource ProformaInvoice.RemoveLine}">
                                                    <TextBlock Text="&#xE711;"
                                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{DynamicResource ProformaInvoice.NoTermsConfiguredAddClauseResetDefaults}"
                   FontSize="{DynamicResource FontSize.Body}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Clauses.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
