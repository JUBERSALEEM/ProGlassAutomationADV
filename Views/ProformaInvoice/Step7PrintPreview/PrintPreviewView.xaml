<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.PrintPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:summary="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.InvoiceMainSummary"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Background="{DynamicResource AccentBrush}"
                        Width="30" Height="30" CornerRadius="6"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#128220;"
                               FontSize="15" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Title}"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle}"
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Margin="0,0,0,12" TextWrapping="Wrap"/>
            <Border Background="{DynamicResource MenuHoverBrush}" Height="1" Margin="0,0,0,20"/>

            <!-- ============================================================
                 PHASE 7.12 — INVOICE MAIN SUMMARY (financial totals card)
            ============================================================ -->
            <summary:InvoiceMainSummaryView DataContext="{Binding InvoiceMainSummary}"/>

            <!-- Phase status note -->
            <Border Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="6" Padding="12,8"
                    Margin="0,30,0,20" HorizontalAlignment="Left">
                <TextBlock FontSize="10"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           TextWrapping="Wrap">
                    <Run FontWeight="Bold" Foreground="{DynamicResource AccentBrush}">Phase 7.12 complete.</Run>
                    <Run>Invoice Main Summary with Discount (% or AED) and toggleable VAT is live. Terms &amp; Conditions, ERP conversion, and PDF export coming in future phases.</Run>
                </TextBlock>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>