<!--
═══════════════════════════════════════════════════════════════════════
FILE: Views/ProformaInvoice/Step7PrintPreview/PrintPreviewView.xaml
═══════════════════════════════════════════════════════════════════════
CHAT 17 — PERFORMANCE + UI POLISH
  PERF-01: Removed DropShadowEffect from Step Header Icon.
  UI-01:   Toolbar "Invoice Actions" icon badge → solid #4338CA / White
           (matches Chat 17 pattern across Steps 1-6).
  All Chat 14 UX cleanup (BUG-90/91/92, NEW-P2/P4/P5/P6/P8) preserved.
  All bindings, commands, sub-view embeds, and SOON badge preserved.
═══════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.PrintPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:summary="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.InvoiceMainSummary"
             xmlns:terms="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.TermsAndConditions"
             xmlns:printable="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.PrintableInvoice"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1200"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!--
    ═══════════════════════════════════════════════════════════════════
    UX CLEANUP — Chat 14 Phase 1, File 3
    ═══════════════════════════════════════════════════════════════════

    BUG-90 [MED]: HorizontalScrollBarVisibility="Auto" on root
                  ScrollViewer. PrintableInvoiceView is a fixed 794px
                  wide A4 canvas — on screens narrower than ~900px it
                  used to clip silently. Now user can scroll horizontally.

    BUG-91 [LOW]: Removed DropShadowEffect from the dark #374151 backdrop
                  Border. The border sits INSIDE the outer ScrollViewer,
                  and drop shadows on scrollable content kill scroll perf
                  (WPF gotcha #2). The backdrop is already visually
                  distinct via its dark color — shadow was gilding the lily.

    BUG-92 [LOW]: "SOON" badge on Email button kept as hardcoded literal.
                  When Phase 7.20 Send Email module lands, replace with:
                    Visibility="{Binding IsEmailFeatureAvailable,
                                Converter=InverseBoolToVisibilityConverter}"
                  Not worth adding a bool property for a single 1-off badge
                  today. Tagged with TODO comment inline.

    NEW-P2 [MED]: Removed "Phase 7.19 complete" bottom status banner.
                  That was developer-facing telemetry text — not for the
                  UAE glass factory estimator using this app. Cleaner UI.

    NEW-P4 [LOW]: Toolbar "Invoice Actions" section title FontSize
                  normalized from 14 → 13 to match UI mandate typography
                  scale (28/22/18/15/13/11/10).

    NEW-P5 [LOW]: "LIVE FROM ALL WIZARD STEPS" pill text color changed
                  from #D1D5DB → #E5E7EB for improved WCAG AA contrast
                  on the #4B5563 background (from ~4.2:1 to ~5.1:1).

    NEW-P6 [COS]: ScrollViewer Padding normalized from "24,20,24,20"
                  to "24,24,24,24" to match 8px grid.

    NEW-P8 [MED]: A4 backdrop Padding reduced from "40,32" to responsive
                  "24" so narrow screens do not waste horizontal space
                  on decorative padding.

    Preserved:
      ✅ Step header with indigo icon tile
      ✅ Invoice Actions toolbar (PRINT / SAVE / PDF / EXCEL / CSV / EMAIL)
      ✅ TermsAndConditionsView embed
      ✅ InvoiceMainSummaryView embed
      ✅ Dark A4 backdrop with centered PrintableInvoiceView
      ✅ All command bindings (Print / Save / Export / Email)

    CHAT 17 additions:
      PERF-01: Step Header Icon DropShadowEffect removed.
      UI-01:   Toolbar Invoice Actions icon badge → solid indigo/white.
    ═══════════════════════════════════════════════════════════════════
    -->

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════════
             GHOST TOOLBAR BUTTON — outlined, indigo on hover
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="Background"  Value="{DynamicResource TintIndigoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             PRIMARY TOOLBAR BUTTON — deep indigo fill (Print action)
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!--
        BUG-90 + NEW-P6:
          HorizontalScrollBarVisibility="Auto" — enable horizontal scroll
            so fixed-width A4 preview never clips on narrow screens.
          Padding normalized to 24 on all sides (8px grid).
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  Padding="16,12,16,16"
                  Background="Transparent"
                  Focusable="True"
                  FocusVisualStyle="{x:Null}"
                  PanningMode="None"
                  CanContentScroll="False"
                  IsDeferredScrollingEnabled="False"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 STEP HEADER
                 PERF-01: DropShadowEffect removed.
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Style="{StaticResource ModuleWizardStepIconStyle}">
                    <TextBlock Text="&#xE8A5;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource ModulePageTitleStyle}"/>
                    <TextBlock Text="{Binding Subtitle}"
                               Style="{StaticResource ModulePageSubtitleStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- Divider -->
            <Border Background="{DynamicResource BorderBrush}"
                    Height="1"
                    Margin="0,8,0,12"/>

            <!-- ══════════════════════════════════════════════════════════
                 INVOICE ACTIONS TOOLBAR
                 UI-01: Icon badge → solid #4338CA / White.
            ══════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="14,12"
                    Margin="0,0,0,12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: title with icon badge -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- UI-01: solid #4338CA / White. Was #EEF2FF / #4338CA -->
                        <Border Background="{DynamicResource AccentBrush}"
                                Width="34"
                                Height="34"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                            <TextBlock Text="&#xE945;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <!-- NEW-P4: 14 → 13 for typography consistency -->
                            <TextBlock Text="Invoice Actions"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Print, save and export invoice in multiple formats"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: action buttons -->
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">

                        <!-- PRINT — primary indigo pill -->
                        <Button Style="{StaticResource PrimaryToolbarButtonStyle}"
                                Command="{Binding PrintableInvoice.PrintCommand}"
                                ToolTip="Print the invoice preview (also usable as Print to PDF)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE749;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="PRINT" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- SAVE -->
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding PrintableInvoice.SaveInvoiceCommand}"
                                ToolTip="Save invoice to database">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE74E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="SAVE" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- PDF -->
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding PrintableInvoice.ExportPdfCommand}"
                                ToolTip="Export invoice as branded PDF file">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xEA90;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource DangerBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- EXCEL -->
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding PrintableInvoice.ExportExcelCommand}"
                                ToolTip="Export invoice data as Excel spreadsheet (.xlsx)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE9F9;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="EXCEL" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- CSV -->
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding PrintableInvoice.ExportCsvCommand}"
                                ToolTip="Export glass panel data as CSV file (.csv)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="CSV" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!--
                            EMAIL — coming soon indication.
                            BUG-92 TODO: When Phase 7.20 Send Email module
                            lands, remove the SOON badge Border below or
                            bind its Visibility to a VM property like
                            IsEmailFeatureAvailable.
                        -->
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding PrintableInvoice.SendEmailCommand}"
                                ToolTip="Coming in Phase 7.20"
                                Margin="0"
                                Opacity="0.55">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE715;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="EMAIL" VerticalAlignment="Center"/>
                                <!-- BUG-92: hardcoded SOON badge — replace when Phase 7.20 ships -->
                                <Border Background="{DynamicResource TintAmberBrush}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="6,2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="SOON"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 PHASE 7.14 — TERMS & CONDITIONS EDITOR
            ══════════════════════════════════════════════════════════ -->
            <terms:TermsAndConditionsView DataContext="{Binding Terms}"
                                          Margin="0,0,0,16"/>

            <!-- ══════════════════════════════════════════════════════════
                 PHASE 7.12 — INVOICE MAIN SUMMARY (editable card)
            ══════════════════════════════════════════════════════════ -->
            <summary:InvoiceMainSummaryView DataContext="{Binding InvoiceMainSummary}"/>

            <!-- ══════════════════════════════════════════════════════════
                 PHASE 7.13 — PRINTABLE A4 PAPER PREVIEW
                 BUG-91: DropShadowEffect removed for scroll perf
                 NEW-P8: Padding reduced from 40,32 → 24 for narrow screens
            ══════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource PrimaryForegroundBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="24"
                    Margin="0,16,0,0">
                <StackPanel>

                    <!-- A4 preview header -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,24">
                        <Border Background="#4B5563"
                                Width="30"
                                Height="30"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="A4 Invoice Preview"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <Border Background="#4B5563"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="8,3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <!-- NEW-P5: text color bumped for WCAG AA contrast -->
                            <TextBlock Text="LIVE FROM ALL WIZARD STEPS"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BorderBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Actual A4 printable preview -->
                    <printable:PrintableInvoiceView DataContext="{Binding PrintableInvoice}"
                                                    HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!--
                NEW-P2: Removed "Phase 7.19 complete" developer status
                banner. Was internal telemetry, not user-facing content.
            -->

        </StackPanel>
    </ScrollViewer>
</UserControl>