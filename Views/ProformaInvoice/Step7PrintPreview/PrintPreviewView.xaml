<!--
    Step 7 — Preview. Approved board:
    left steel controls (summary, terms checklist, save/export at BOTTOM)
    · right paper-white A4.
    Paper stays #FFFFFF. Print ink unchanged.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.PrintPreviewView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:summary="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.InvoiceMainSummary"
             xmlns:terms="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.TermsAndConditions"
             xmlns:printable="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step7PrintPreview.PrintableInvoice"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="0.85*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="0,0,8,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Command="{Binding PrintableInvoice.SaveInvoiceCommand}"
                            Style="{StaticResource PiFooterPrimaryButton}"
                            Content="{DynamicResource ProformaInvoice.SAVE}"
                            ToolTip="{DynamicResource ProformaInvoice.SaveInvoiceConfirmationHappensStep8}"
                            Margin="0,0,8,0"/>
                    <Button Command="{Binding PrintableInvoice.ExportPdfCommand}"
                            Style="{StaticResource PiFooterGhostButton}"
                            Content="{DynamicResource DeliveryNote.ExportPDF}"
                            ToolTip="{DynamicResource ProformaInvoice.ExportInvoiceBrandedPDF}"
                            Margin="0,0,8,0"/>
                    <Button Command="{Binding PrintableInvoice.ExportExcelCommand}"
                            Style="{StaticResource PiFooterGhostButton}"
                            Content="{DynamicResource DeliveryNote.ExportExcel}"
                            ToolTip="{DynamicResource ProformaInvoice.ExportInvoiceDataExcel}"
                            Margin="0,0,8,0"/>
                    <Button x:Name="ActionsMenuButton"
                            Style="{StaticResource PiFooterGhostButton}"
                            Content="{DynamicResource ProformaInvoice.MORE}"
                            ToolTip="{DynamicResource ProformaInvoice.PrintMoreExportOptions}"
                            behaviors:DropdownButtonBehavior.Popup="{Binding ElementName=ActionsMenuPopup}"/>
                    <Popup x:Name="ActionsMenuPopup"
                           PlacementTarget="{Binding ElementName=ActionsMenuButton}"
                           Placement="Top"
                           HorizontalAlignment="Left"
                           VerticalOffset="-4"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="6"
                                MinWidth="200">
                            <StackPanel>
                                <Button Style="{StaticResource PiInvoiceMenuActionItem}"
                                        Tag="&#xE749;" Content="{DynamicResource Action.Print}"
                                        Command="{Binding PrintableInvoice.PrintCommand}"
                                        ToolTip="{DynamicResource ProformaInvoice.PrintInvoicePreview}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Button Style="{StaticResource PiInvoiceMenuActionItem}"
                                        Tag="&#xE8A5;" Content="{DynamicResource DeliveryNote.ExportCSV}"
                                        Command="{Binding PrintableInvoice.ExportCsvCommand}"
                                        ToolTip="{DynamicResource ProformaInvoice.ExportGlassPanelDataCSV}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Button Style="{StaticResource PiInvoiceMenuActionItem}"
                                        Tag="&#xE715;" Content="{DynamicResource ProformaInvoice.EmailSoon}"
                                        Command="{Binding PrintableInvoice.SendEmailCommand}"
                                        ToolTip="{DynamicResource ProformaInvoice.ComingPhase720}"
                                        IsEnabled="False"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <StackPanel>
                        <Border Style="{StaticResource PiStationIdentityStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="07" Style="{StaticResource PiStationCodeStyle}"/>
                                <TextBlock Text="{DynamicResource Phone.Preview}" Style="{StaticResource PiStationTitleStyle}"/>
                                <TextBlock Text="{DynamicResource ProformaInvoice.TotalsTermsLeftA4Right}"
                                           Style="{StaticResource PiStationHintStyle}"/>
                            </StackPanel>
                        </Border>
                        <summary:InvoiceMainSummaryView DataContext="{Binding InvoiceMainSummary}"/>
                        <terms:TermsAndConditionsView DataContext="{Binding Terms}" Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Column="2"
                Background="#FFFFFF"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Padding="16"
                SnapsToDevicePixels="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Background="Transparent">
                <printable:PrintableInvoiceView DataContext="{Binding PrintableInvoice}"
                                                HorizontalAlignment="Center"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
