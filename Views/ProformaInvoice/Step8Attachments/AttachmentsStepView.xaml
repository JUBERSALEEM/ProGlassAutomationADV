<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/ProformaInvoice/Step8Attachments/AttachmentsStepView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Proforma Invoice — Step 8 Attachments

     Wizard step 8 UI. Mirrors the Delivery Note attachments section:
     add image / add PDF, thumbnail list, open/rename/delete per row.

     Binds to AttachmentsStepViewModel (DataContext set by the wizard's
     ContentControl DataTemplate in ProformaInvoiceView.xaml).
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step8Attachments.AttachmentsStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Soft card used across the step -->
        <Style x:Key="S8Card" TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource ElevatedSurfaceBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"
                    Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Primary action pill -->
        <Style x:Key="S8AddButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="{DynamicResource PillCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary action pill (rename/delete/open on rows) -->
        <Style x:Key="S8RowAction" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{DynamicResource MenuHoverBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ═════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource S8Card}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon badge -->
                <Border Grid.Column="0"
                        Width="46" Height="46"
                        CornerRadius="14"
                        Background="{DynamicResource TintIndigoBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="📎"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Attachments"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock FontSize="12"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}">
                        <Run Text="Site photos, drawings &amp; approvals for invoice "/>
                        <Run Text="{Binding ProformaId, Mode=OneWay,
                                            FallbackValue='(set ID in Step 1)'}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Count pill -->
                <Border Grid.Column="2"
                        Background="{DynamicResource TintIndigoBrush}"
                        CornerRadius="{DynamicResource PillCornerRadius}"
                        Padding="14,7"
                        VerticalAlignment="Center">
                    <TextBlock FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}">
                        <Run Text="{Binding AttachmentsCount, Mode=OneWay}"/>
                        <Run Text=" file(s)"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- ══ ACTIONS ════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="2,16,0,4">

            <Button Style="{StaticResource S8AddButton}"
                    Command="{Binding AddImageCommand}"
                    IsEnabled="{Binding HasProformaId}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🖼️" Margin="0,0,8,0"/>
                    <TextBlock Text="Add Image"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource S8AddButton}"
                    Margin="10,0,0,0"
                    Command="{Binding AddPdfCommand}"
                    IsEnabled="{Binding HasProformaId}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📄" Margin="0,0,8,0"/>
                    <TextBlock Text="Add PDF"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource S8RowAction}"
                    Margin="10,0,0,0"
                    Padding="14,10"
                    Command="{Binding RefreshCommand}"
                    ToolTip="Reload attachments from disk">
                <TextBlock Text="↻  Refresh"/>
            </Button>
        </StackPanel>

        <!-- ══ LIST ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="0,12,0,0">

            <!-- Empty state -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource S8Card}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoAttachments}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="30">
                    <TextBlock Text="🗂️"
                               FontSize="40"
                               HorizontalAlignment="Center"
                               Opacity="0.7"/>
                    <TextBlock Text="No attachments yet"
                               FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,4"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="Add site photos, drawings or signed approvals — max 10 MB each."
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </Border>

            <!-- Attachment rows -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAttachments}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <ItemsControl ItemsSource="{Binding Attachments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    Padding="14,10"
                                    Margin="0,0,0,10"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Preview / type icon -->
                                    <Grid Grid.Column="0"
                                          Width="56" Height="56"
                                          VerticalAlignment="Center">
                                        <Border CornerRadius="10"
                                                Background="{DynamicResource TintGrayBrush}">
                                            <TextBlock Text="{Binding TypeIcon}"
                                                       FontSize="24"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Border CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImage}"
                                                                     Value="True">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Preview}"
                                                            Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>

                                    <!-- Name + meta -->
                                    <StackPanel Grid.Column="1"
                                                Margin="14,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <Run Text="{Binding FileSizeDisplay, Mode=OneWay}"/>
                                            <Run Text="  •  "/>
                                            <Run Text="{Binding UploadedAtDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Row actions -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource S8RowAction}"
                                                Command="{Binding DataContext.OpenAttachmentCommand,
                                                            RelativeSource={RelativeSource
                                                                AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="Open"/>
                                        </Button>
                                        <Button Style="{StaticResource S8RowAction}"
                                                Command="{Binding DataContext.RenameAttachmentCommand,
                                                            RelativeSource={RelativeSource
                                                                AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="Rename"/>
                                        </Button>
                                        <Button Style="{StaticResource S8RowAction}"
                                                Command="{Binding DataContext.DeleteAttachmentCommand,
                                                            RelativeSource={RelativeSource
                                                                AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="Delete"
                                                       Foreground="{DynamicResource DangerBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ══ STATUS ═════════════════════════════════════════════════ -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Margin="2,8,0,0"
                   Foreground="{DynamicResource AccentBrush}"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
