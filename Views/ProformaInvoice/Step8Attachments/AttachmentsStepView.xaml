<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/ProformaInvoice/Step8Attachments/AttachmentsStepView.xaml
     Industrial file table. Bindings and commands unchanged.
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step8Attachments.AttachmentsStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ATTACHMENTS"
                           Style="{StaticResource ModulePageTitleStyle}"/>
                <TextBlock Style="{StaticResource ModulePageSubtitleStyle}">
                    <Run Text="Site photos, drawings and approvals for "/>
                    <Run Text="{Binding ProformaId, Mode=OneWay,
                                        FallbackValue='(set ID in Step 1)'}"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryPillButton}"
                        Tag="&#xE728;" Content="+ IMAGE"
                        ToolTip="Attach an image file"
                        Command="{Binding AddImageCommand}"
                        IsEnabled="{Binding HasProformaId}"/>
                <Button Style="{StaticResource PrimaryPillButton}"
                        Tag="&#xE8A5;" Content="+ PDF"
                        Margin="8,0,0,0"
                        ToolTip="Attach a PDF file"
                        Command="{Binding AddPdfCommand}"
                        IsEnabled="{Binding HasProformaId}"/>
                <Button Style="{StaticResource OutlinedPillButton}"
                        Tag="&#xE72C;" Content="REFRESH"
                        Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Reload attachments from disk"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PiWorkSurfaceStyle}" Padding="0">
            <Grid>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoAttachments}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="30">
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.7"/>
                        <TextBlock Text="No attachments yet"
                                   FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Add site photos, drawings or signed approvals — max 10 MB each."
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="360"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </Border>

                <DockPanel>
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAttachments}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>

                    <Border DockPanel.Dock="Top" Style="{StaticResource PiTableHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TYPE"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="NAME"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Grid.Column="2" Text="SIZE"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Grid.Column="3" Text="ADDED"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Grid.Column="4" Text="ACTIONS"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Attachments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource OutlineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="10,8"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding AttachmentType}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FileName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding FileSizeDisplay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding UploadedAtDisplay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="4"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <Button Style="{StaticResource RowPrimaryButton}"
                                                        Tag="&#xE8B7;" Content="OPEN"
                                                        ToolTip="Open the attachment"
                                                        Command="{Binding DataContext.OpenAttachmentCommand,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource RowOutlinedButton}"
                                                        Tag="&#xE8E5;" Content="RENAME"
                                                        ToolTip="Rename the attachment"
                                                        Command="{Binding DataContext.RenameAttachmentCommand,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource RowDangerButton}"
                                                        Tag="&#xE74D;" Content="DELETE"
                                                        ToolTip="Delete the attachment"
                                                        Command="{Binding DataContext.DeleteAttachmentCommand,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Margin="2,8,0,0"
                   Foreground="{DynamicResource AccentBrush}"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
