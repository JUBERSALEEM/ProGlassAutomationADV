<!--
    Step 8 — Files. Full-bleed industrial vault:
    TYPE | NAME | SIZE | ADDED | ACTIONS. + IMAGE + PDF.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step8Attachments.AttachmentsStepView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="08" Style="{StaticResource PiStationCodeStyle}"/>
                        <TextBlock Style="{StaticResource PiStationTitleStyle}">
                            <TextBlock.Inlines>
                                <Run Text="{DynamicResource Attachments.FilesTitle}"/>
                                <Run Text="  ·  "/>
                                <Run Text="{Binding ProformaId}"/>
                            </TextBlock.Inlines>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource PiGhostChipButton}"
                                Content="{DynamicResource ProformaInvoice.Image}"
                                ToolTip="{DynamicResource ProformaInvoice.AttachImageFile}"
                                Command="{Binding AddImageCommand}"
                                IsEnabled="{Binding HasProformaId}"/>
                        <Button Style="{StaticResource PiGhostChipButton}"
                                Content="{DynamicResource ProformaInvoice.PDF}"
                                Margin="8,0,0,0"
                                ToolTip="{DynamicResource ProformaInvoice.AttachPDFFile}"
                                Command="{Binding AddPdfCommand}"
                                IsEnabled="{Binding HasProformaId}"/>
                        <Button Style="{StaticResource PiIconButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding RefreshCommand}"
                                ToolTip="{DynamicResource ProformaInvoice.ReloadAttachmentsDisk}">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextBodyLarge}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding StatusMessage}"
                       FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                       Margin="16,6,16,12"
                       Foreground="{DynamicResource AccentBrush}"
                       TextWrapping="Wrap"/>

            <TextBlock DockPanel.Dock="Top"
                       Text="{DynamicResource ProformaInvoice.NoAttachmentsAddSitePhotosDrawingsSigned}"
                       FontSize="{StaticResource TextBody}"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Margin="16,12,16,8"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoAttachments}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <Border DockPanel.Dock="Top" Style="{StaticResource PiTableHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Common.Type}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Common.Name}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource ProformaInvoice.SIZE}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="3" Text="{DynamicResource ProformaInvoice.Added}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="4" Text="{DynamicResource Common.Actions}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Attachments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding AttachmentType}"
                                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FileName}"
                                                   FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding FileSizeDisplay}"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding UploadedAtDisplay}"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="4"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource RowPrimaryButton}"
                                                    Tag="&#xE8B7;" Content="{DynamicResource Action.Open}"
                                                    Command="{Binding DataContext.OpenAttachmentCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource RowOutlinedButton}"
                                                    Tag="&#xE8E5;" Content="{DynamicResource ProformaInvoice.Rename}"
                                                    Command="{Binding DataContext.RenameAttachmentCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource RowDangerButton}"
                                                    Tag="&#xE74D;" Content="{DynamicResource Action.Delete}"
                                                    Command="{Binding DataContext.DeleteAttachmentCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>
</UserControl>
