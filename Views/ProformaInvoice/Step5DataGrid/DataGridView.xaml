<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step5DataGrid.DataGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:summary="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step5DataGrid.GrandTotalSummary"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════
         SENIOR POLISH — KEYBOARD SHORTCUTS
         Ctrl+Shift+N → Add New Spec Group
         Ctrl+N is contextual — bound per SpecGroup below (routes to
         AddRowCommand of the closest group). Global Ctrl+N would be
         ambiguous when multiple spec groups exist.
    ═══════════════════════════════════════════════════════════════ -->
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control+Shift" Key="N"
                    Command="{Binding AddSpecGroupCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════════
             COMPACT INTEGER INPUT (W1, H1, W2, H2, Qty)
             Height=28 for tight grid cells + AcceptIntegersOnly
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="CompactIntInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus"  Value="True"/>
            <Setter Property="behaviors:TextBoxBehaviors.AcceptIntegersOnly" Value="True"/>
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="FontWeight"               Value="SemiBold"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="Height"                   Value="28"/>
            <Setter Property="Width"                    Value="60"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="SelectionBrush"           Value="#4338CA"/>
            <Setter Property="SnapsToDevicePixels"      Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush"     Value="#4338CA"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             COMPACT DECIMAL INPUT (Rate, BaseRate, SurchargePercent)
             Height=28 + AcceptDecimals
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="CompactDecimalInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="behaviors:TextBoxBehaviors.AcceptDecimals"   Value="True"/>
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="FontWeight"               Value="SemiBold"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="Height"                   Value="28"/>
            <Setter Property="Width"                    Value="60"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="SelectionBrush"           Value="#4338CA"/>
            <Setter Property="SnapsToDevicePixels"      Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush"     Value="#4338CA"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             COMPACT TEXT INPUT (GlassRef — allows any text)
             Height=28 + no numeric filter
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="CompactTextInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="FontWeight"               Value="SemiBold"/>
            <Setter Property="Padding"                  Value="6,0"/>
            <Setter Property="Height"                   Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="SelectionBrush"           Value="#4338CA"/>
            <Setter Property="SnapsToDevicePixels"      Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush"     Value="#4338CA"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             FIELD LABEL — 11px SemiBold muted
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             INLINE HEADER LABEL — for BASE RATE / SURCHARGE labels
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="HeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,6,0"/>
        </Style>

        <!-- Chevron path for ComboBox dropdown arrows -->
        <Style x:Key="ChevronPathStyle" TargetType="Path">
            <Setter Property="Data"                Value="M 0 0 L 4 4 L 8 0 Z"/>
            <Setter Property="Fill"                Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <!-- ComboBoxItem — indigo selected state -->
        <Style x:Key="ThemedComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding"    Value="12,8"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#4338CA"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed ComboBox — indigo focus, MDL2 chevron -->
        <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="FontWeight"               Value="SemiBold"/>
            <Setter Property="Padding"                  Value="12,0"/>
            <Setter Property="Height"                   Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="ItemContainerStyle"       Value="{StaticResource ThemedComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>
                                    <Path Grid.Column="1" x:Name="Arrow" Style="{StaticResource ChevronPathStyle}"/>
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource ModuleBackgroundBrush}"
                                        BorderBrush="#4338CA"
                                        BorderThickness="1.5"
                                        CornerRadius="8"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.20" Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#6366F1"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource PrimaryForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush"     Value="#4338CA"/>
                                <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="#4338CA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Editable ComboBox (spec name search) -->
        <Style x:Key="EditableComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Padding"                  Value="12,0"/>
            <Setter Property="Height"                   Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsEditable"               Value="True"/>
            <Setter Property="IsTextSearchEnabled"      Value="True"/>
            <Setter Property="ItemContainerStyle"       Value="{StaticResource ThemedComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Background="Transparent"
                                             Foreground="{TemplateBinding Foreground}"
                                             BorderThickness="0"
                                             Padding="{TemplateBinding Padding}"
                                             VerticalContentAlignment="Center"
                                             FontSize="{TemplateBinding FontSize}"
                                             CaretBrush="{DynamicResource PrimaryForegroundBrush}"
                                             SelectionBrush="#4338CA"
                                             Focusable="True"
                                             IsReadOnly="False"/>
                                    <ToggleButton Grid.Column="1"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Cursor="Hand"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path Style="{StaticResource ChevronPathStyle}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource ModuleBackgroundBrush}"
                                        BorderBrush="#4338CA"
                                        BorderThickness="1.5"
                                        CornerRadius="8"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.20" Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush"     Value="#4338CA"/>
                                <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Virtualized row container style -->
        <Style x:Key="VirtualizedRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Margin"          Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBorder"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Padding="0,3"
                                Margin="0,0,0,1"
                                Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ══ ROOT SCROLL — SmoothScrollBehavior 60fps ══════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20,24,20"
                  CanContentScroll="False"
                  IsDeferredScrollingEnabled="False"
                  PanningMode="None"
                  Focusable="True"
                  FocusVisualStyle="{x:Null}"
                  Background="Transparent"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 STEP HEADER
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Background="#4338CA"
                        Width="44" Height="44"
                        CornerRadius="12"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12"
                                          ShadowDepth="2"
                                          Direction="270"
                                          Color="#4338CA"
                                          Opacity="0.30"/>
                    </Border.Effect>
                    <TextBlock Text="&#xF0E2;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{Binding Title}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <Border Background="{DynamicResource BorderBrush}"
                    Height="1"
                    Margin="0,16,0,20"/>

            <!-- ══════════════════════════════════════════════════════════
                 TOP BAR
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="Manage your specification groups below."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="TIP: Press Ctrl+Shift+N to add a new spec group · Right-click a group's grid to paste from Excel"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">
                    <TextBlock Text="Total Spec Groups:"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Border Background="#4338CA"
                            CornerRadius="10"
                            Padding="14,6"
                            MinWidth="46">
                        <TextBlock Text="{Binding TotalSpecGroups}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 EMPTY STATE (when no spec groups exist)
                 Note: VM auto-creates one on load, so this is defensive
            ══════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="40,32"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Stretch"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TotalSpecGroups}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <Border Background="#EEF2FF"
                            Width="72" Height="72"
                            CornerRadius="36"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <TextBlock Text="&#xF0E2;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="32"
                                   Foreground="#4338CA"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No spec groups yet"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Each spec group represents a unique glass type + specification combination."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,4"
                               TextAlignment="Center"
                               MaxWidth="380"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Press Ctrl+Shift+N or click the button below to get started."
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 SPEC GROUPS LIST
            ══════════════════════════════════════════════════════════ -->
            <ItemsControl ItemsSource="{Binding SpecGroups}" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,16"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                SnapsToDevicePixels="True">
                            <!-- Contextual Ctrl+N shortcut — routes to THIS group's AddRow -->
                            <Border.InputBindings>
                                <KeyBinding Modifiers="Control" Key="N"
                                            Command="{Binding AddRowCommand}"/>
                            </Border.InputBindings>
                            <StackPanel>

                                <!-- ── Group header row ── -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#4338CA"
                                            Width="32" Height="32"
                                            CornerRadius="8"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GroupNumber}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding GroupName}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Base rate (decimal) -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,14,0">
                                        <TextBlock Text="BASE RATE:" Style="{StaticResource HeaderLabelStyle}"/>
                                        <TextBox Text="{Binding BaseRate, StringFormat={}{0:0.##}}"
                                                 Style="{StaticResource CompactDecimalInputStyle}"/>
                                    </StackPanel>

                                    <!-- Surcharge % (decimal) -->
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0">
                                        <TextBlock Text="SURCHARGE %:" Style="{StaticResource HeaderLabelStyle}"/>
                                        <TextBox Text="{Binding SurchargePercent, StringFormat={}{0:0.##}}"
                                                 Style="{StaticResource CompactDecimalInputStyle}"/>
                                    </StackPanel>

                                    <Button Grid.Column="4"
                                            Command="{Binding DataContext.RemoveSpecGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="Remove Spec Group">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="RB"
                                                        Background="Transparent"
                                                        CornerRadius="8"
                                                        Padding="8,6">
                                                    <TextBlock Text="&#xE74D;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               Foreground="#B91C1C"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RB" Property="Background" Value="#FEE2E2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- ── Effective rate badge ── -->
                                <Border Background="#ECFDF5"
                                        BorderBrush="#A7F3D0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,7"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   Foreground="#047857"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Effective Rate:"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="AED"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#047857"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding EffectiveRate, StringFormat={}{0:N2}}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#047857"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text=" / sqm"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- ── Glass type + specification dropdowns ── -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="GLASS TYPE" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding DataContext.GlassTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SelectedGlassType}"
                                                  Style="{StaticResource ThemedComboBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="SPECIFICATION (pick saved or type custom)"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding FilteredSpecs}"
                                                  DisplayMemberPath="SpecName"
                                                  Text="{Binding SelectedSpecName, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource EditableComboBoxStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ══════════════════════════════════════
                                     GLASS PANEL ITEMS TABLE
                                ══════════════════════════════════════ -->
                                <Border Background="{DynamicResource WindowBackgroundBrush}"
                                        CornerRadius="10"
                                        Padding="12"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        SnapsToDevicePixels="True">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Paste from Excel (Ctrl+V)"
                                                      Command="{Binding PasteExcelCommand}"
                                                      FontSize="12"/>
                                            <MenuItem Header="Add New Row (Ctrl+N)"
                                                      Command="{Binding AddRowCommand}"
                                                      FontSize="12"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="GLASS PANEL ITEMS"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="#4338CA"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="Rows: "
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Border Background="#EEF2FF"
                                                        CornerRadius="6"
                                                        Padding="10,3"
                                                        MinWidth="34">
                                                    <TextBlock Text="{Binding TotalRows}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#4338CA"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Column headers -->
                                        <Border Background="{DynamicResource MenuHoverBrush}"
                                                CornerRadius="6"
                                                Padding="4,7">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TotalRows}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="0.7*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"  Text="#"          FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"  Text="GLASS REF"  FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0,0,0"/>
                                                <TextBlock Grid.Column="2"  Text="W1"         FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3"  Text="H1"         FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="4"  Text="W2"         FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="5"  Text="H2"         FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="6"  Text="QTY"        FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="7"  Text="SQM"        FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="8"  Text="T.SQM"      FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center" ToolTip="Total SQM (SQM × Qty)"/>
                                                <TextBlock Grid.Column="9"  Text="RATE"       FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="10" Text="VALUE"      FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- ═══════════════════════════════════════════════════
                                             Virtualized data rows
                                             SENIOR POLISH:
                                             • SmartScrollBubblingBehavior — wheel events bubble
                                               to outer ScrollViewer when at boundary
                                             • DataGridNavigationBehavior — virtualization-safe
                                               Tab/Enter/Arrow nav (Chat 10 fix)
                                        ═══════════════════════════════════════════════════ -->
                                        <ListView
    ItemsSource="{Binding ItemRows}"
    ItemContainerStyle="{StaticResource VirtualizedRowContainerStyle}"
    Background="Transparent"
    BorderThickness="0"
    HorizontalContentAlignment="Stretch"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
    ScrollViewer.VerticalScrollBarVisibility="Disabled"
    ScrollViewer.CanContentScroll="False"
    VirtualizingPanel.IsVirtualizing="True"
    VirtualizingPanel.VirtualizationMode="Recycling"
    VirtualizingPanel.IsContainerVirtualizable="True"
    VirtualizingPanel.ScrollUnit="Pixel"
    behaviors:DataGridNavigationBehavior.EnableExcelNav="True">
                                            <ListView.Template>
                                                <ControlTemplate TargetType="ListView">
                                                    <ItemsPresenter/>
                                                </ControlTemplate>
                                            </ListView.Template>
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel
                                                    IsVirtualizing="True"
                                                    VirtualizationMode="Recycling"/>
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26"/>
                                                            <ColumnDefinition Width="1.8*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="0.7*"/>
                                                            <ColumnDefinition Width="0.9*"/>
                                                            <ColumnDefinition Width="0.9*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="26"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding SerialNumber}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- GlassRef — text, no filter -->
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding GlassRef, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource CompactTextInputStyle}"
                                                                 Margin="2,0"/>
                                                        <!-- W1 — integer -->
                                                        <TextBox Grid.Column="2"
                                                                 Text="{Binding W1, UpdateSourceTrigger=LostFocus}"
                                                                 Style="{StaticResource CompactIntInputStyle}"
                                                                 Width="Auto" Margin="2,0"/>
                                                        <!-- H1 — integer -->
                                                        <TextBox Grid.Column="3"
                                                                 Text="{Binding H1, UpdateSourceTrigger=LostFocus}"
                                                                 Style="{StaticResource CompactIntInputStyle}"
                                                                 Width="Auto" Margin="2,0"/>
                                                        <!-- W2 — integer -->
                                                        <TextBox Grid.Column="4"
                                                                 Text="{Binding W2, UpdateSourceTrigger=LostFocus}"
                                                                 Style="{StaticResource CompactIntInputStyle}"
                                                                 Width="Auto" Margin="2,0"/>
                                                        <!-- H2 — integer -->
                                                        <TextBox Grid.Column="5"
                                                                 Text="{Binding H2, UpdateSourceTrigger=LostFocus}"
                                                                 Style="{StaticResource CompactIntInputStyle}"
                                                                 Width="Auto" Margin="2,0"/>
                                                        <!-- Qty — integer -->
                                                        <TextBox Grid.Column="6"
                                                                 Text="{Binding Qty, UpdateSourceTrigger=LostFocus}"
                                                                 Style="{StaticResource CompactIntInputStyle}"
                                                                 Width="Auto" Margin="2,0"/>
                                                        <TextBlock Grid.Column="7"
                                                                   Text="{Binding Sqm1, StringFormat={}{0:0.000}}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="8"
                                                                   Text="{Binding TotalSqm, StringFormat={}{0:0.000}}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- Rate — decimal -->
                                                        <TextBox Grid.Column="9"
                                                                 Text="{Binding Rate, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}"
                                                                 Style="{StaticResource CompactDecimalInputStyle}"
                                                                 Width="Auto" Margin="1,0"/>
                                                        <TextBlock Grid.Column="10"
                                                                   Text="{Binding Value, StringFormat=AED {0:N2}}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="#047857"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,4,0"/>
                                                        <Button Grid.Column="11"
                                                                Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                ToolTip="Delete Row"
                                                                HorizontalAlignment="Center">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="DB"
                                                                            Background="Transparent"
                                                                            CornerRadius="6"
                                                                            Padding="5,3">
                                                                        <TextBlock Text="&#xE711;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="#B91C1C"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="DB" Property="Background" Value="#FEE2E2"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <!-- Footer totals -->
                                        <Border Background="{DynamicResource MenuHoverBrush}"
                                                CornerRadius="6"
                                                Padding="4,8"
                                                Margin="0,6,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TotalRows}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="0.7*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1"
                                                           Text="SUBTOTAL"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#4338CA"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding FooterTotalLm1, StringFormat=LM:{0:0.00}}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding FooterTotalSqm, StringFormat=SQ:{0:0.00}}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding FooterTotalLm2, StringFormat=LM:{0:0.00}}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding FooterTotalSqm2, StringFormat=SQ:{0:0.00}}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6"
                                                           Text="{Binding FooterTotalQty, StringFormat={}{0} pcs}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="8"
                                                           Text="{Binding FooterTotalSqm, StringFormat={}{0:0.000} sqm}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="10"
                                                           Text="{Binding FooterTotalValue, StringFormat=AED {0:N2}}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#047857"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Empty state -->
                                        <StackPanel HorizontalAlignment="Center" Margin="0,16,0,10">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TotalRows}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Background="#EEF2FF"
                                                    Width="48" Height="48"
                                                    CornerRadius="24"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,10">
                                                <TextBlock Text="&#xE7C3;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="20"
                                                           Foreground="#4338CA"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="No rows yet"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Press Ctrl+N or click below to add your first glass panel. Right-click to paste from Excel."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="320"
                                                       TextAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Add row button -->
                                        <Button Command="{Binding AddRowCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Margin="0,8,0,0"
                                                Cursor="Hand"
                                                HorizontalAlignment="Left"
                                                ToolTip="Add new row (Ctrl+N)">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="AB"
                                                            Background="{DynamicResource ModuleBackgroundBrush}"
                                                            CornerRadius="8"
                                                            Padding="14,10"
                                                            BorderThickness="1.5"
                                                            BorderBrush="#4338CA">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="+"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       Foreground="#4338CA"
                                                                       Margin="0,0,8,0"/>
                                                            <TextBlock Text="ADD ITEM ROW"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="#4338CA"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="AB" Property="Background" Value="#EEF2FF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="AB" Property="Background" Value="#4338CA"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ── Add spec group button ── -->
            <Button Command="{Binding AddSpecGroupCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="0,4,0,0"
                    Cursor="Hand"
                    HorizontalAlignment="Left"
                    ToolTip="Add new spec group (Ctrl+Shift+N)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AGB"
                                Background="#4338CA"
                                CornerRadius="8"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="ADD NEW SPEC GROUP"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AGB" Property="Background" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="AGB" Property="Background" Value="#3730A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ══════════════════════════════════════════════════════════
                 PHASE 7.10d — Grand Total Summary
            ══════════════════════════════════════════════════════════ -->
            <summary:GrandTotalSummaryView DataContext="{Binding SummaryViewModel}"
                                           Margin="0,12,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>