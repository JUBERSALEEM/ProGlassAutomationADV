<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step5DataGrid.DataGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             FontFamily="Segoe UI">

    <!-- ============ SHARED STYLES ============ -->
    <UserControl.Resources>

        <!-- ===== Compact Input Style for Base Rate / Surcharge ===== -->
        <Style x:Key="CompactInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource MenuHoverBrush}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush"
                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Field Label ===== -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ===== Header Label ===== -->
        <Style x:Key="HeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- ===== Chevron Path (Custom Arrow) ===== -->
        <Style x:Key="ChevronPathStyle" TargetType="Path">
            <Setter Property="Data" Value="M 0 0 L 4 4 L 8 0 Z"/>
            <Setter Property="Fill" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== ComboBoxItem Style (shared) ===== -->
        <Style x:Key="ThemedComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Themed ComboBox — NON-editable (Glass Type dropdown) ===== -->
        <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>

                                    <Path Grid.Column="1"
                                          x:Name="Arrow"
                                          Style="{StaticResource ChevronPathStyle}"/>
                                </Grid>
                            </Border>

                            <ToggleButton x:Name="ToggleButton"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource ModuleBackgroundBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="6"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush"
                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                                <Setter TargetName="Arrow" Property="Fill"
                                        Value="{DynamicResource PrimaryForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="Fill"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Editable ComboBox — Full custom template (Spec Name dropdown) ===== -->
        <Style x:Key="EditableComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Background="Transparent"
                                             Foreground="{TemplateBinding Foreground}"
                                             BorderThickness="0"
                                             Padding="{TemplateBinding Padding}"
                                             VerticalContentAlignment="Center"
                                             FontSize="{TemplateBinding FontSize}"
                                             CaretBrush="{DynamicResource PrimaryForegroundBrush}"
                                             SelectionBrush="{DynamicResource AccentBrush}"
                                             Focusable="True"
                                             IsReadOnly="False"/>

                                    <ToggleButton x:Name="ToggleButton"
                                                  Grid.Column="1"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Cursor="Hand"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path x:Name="Arrow"
                                                          Style="{StaticResource ChevronPathStyle}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource ModuleBackgroundBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="6"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush"
                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel>

            <!-- ============ HEADER ============ -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,6">
                <Border Background="{DynamicResource AccentBrush}"
                        Width="28" Height="28"
                        CornerRadius="6"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#128203;"
                               FontSize="14"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Title}"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </StackPanel>

            <TextBlock Text="{Binding Subtitle}"
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"/>

            <Border Background="{DynamicResource MenuHoverBrush}"
                    Height="1"
                    Margin="0,0,0,14"/>

            <!-- ============ TOTAL SPEC GROUPS COUNTER ============ -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Manage your specification groups below. Each group contains multiple glass items with dimensions and rates."
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">
                    <TextBlock Text="Total Spec Groups:"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Border Background="{DynamicResource AccentBrush}"
                            CornerRadius="6"
                            Padding="12,4"
                            MinWidth="40">
                        <TextBlock Text="{Binding TotalSpecGroups}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============ SPEC GROUPS LIST ============ -->
            <ItemsControl ItemsSource="{Binding SpecGroups}"
                          Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                CornerRadius="10"
                                Padding="16"
                                Margin="0,0,0,10"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource MenuHoverBrush}">
                            <StackPanel>

                                <!-- ===== Group Header Row ===== -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{DynamicResource AccentBrush}"
                                            Width="28" Height="28"
                                            CornerRadius="6"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GroupNumber}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding GroupName}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,14,0">
                                        <TextBlock Text="BASE RATE:"
                                                   Style="{StaticResource HeaderLabelStyle}"/>
                                        <TextBox Text="{Binding BaseRate, StringFormat={}{0:0.##}}"
                                                 Style="{StaticResource CompactInputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0">
                                        <TextBlock Text="SURCHARGE %:"
                                                   Style="{StaticResource HeaderLabelStyle}"/>
                                        <TextBox Text="{Binding SurchargePercent, StringFormat={}{0:0.##}}"
                                                 Style="{StaticResource CompactInputStyle}"/>
                                    </StackPanel>

                                    <Button Grid.Column="4"
                                            Command="{Binding DataContext.RemoveSpecGroupCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Cursor="Hand"
                                            ToolTip="Remove this spec group">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="RemoveBorder"
                                                        Background="Transparent"
                                                        CornerRadius="6"
                                                        Padding="8,6">
                                                    <TextBlock Text="&#128465;"
                                                               FontSize="14"
                                                               Foreground="#EF4444"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RemoveBorder"
                                                                Property="Background"
                                                                Value="#22EF4444"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- ===== Effective Rate Live Display ===== -->
                                <Border Background="#1622C55E"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Effective Rate:"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="AED"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#22C55E"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding EffectiveRate, StringFormat={}{0:N2}}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#22C55E"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text=" / sqm"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- ===== GLASS TYPE + SPECIFICATION DROPDOWNS ===== -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="GLASS TYPE"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding DataContext.GlassTypeOptions,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SelectedGlassType}"
                                                  Style="{StaticResource ThemedComboBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="SPECIFICATION (pick saved or type custom)"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding FilteredSpecs}"
                                                  DisplayMemberPath="SpecName"
                                                  Text="{Binding SelectedSpecName, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource EditableComboBoxStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ============ NEW: ITEM ROWS SECTION ============ -->
                                <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                        CornerRadius="6"
                                        Padding="12"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource MenuHoverBrush}">
                                    <StackPanel>

                                        <!-- Header with title + count -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="GLASS PANEL ITEMS"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="Rows: "
                                                           FontSize="10"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Border Background="{DynamicResource MenuHoverBrush}"
                                                        CornerRadius="4"
                                                        Padding="8,2"
                                                        MinWidth="30">
                                                    <TextBlock Text="{Binding TotalRows}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Simple row list (columns come in 7.8b) -->
                                        <ItemsControl ItemsSource="{Binding ItemRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource MenuHoverBrush}"
                                                            CornerRadius="4"
                                                            Padding="10,6"
                                                            Margin="0,0,0,4">
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                            <Run Text="Row #"/>
                                                            <Run Text="{Binding SerialNumber}" FontWeight="Bold"/>
                                                            <Run Text=" — awaiting cells (next sub-phase)"/>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Empty state message -->
                                        <TextBlock Text="No rows yet. Click below to add your first glass panel."
                                                   FontSize="11"
                                                   FontStyle="Italic"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TotalRows}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- ADD ITEM ROW button -->
                                        <Button Command="{Binding AddRowCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Margin="0,6,0,0"
                                                Cursor="Hand"
                                                HorizontalAlignment="Left">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="AddRowBorder"
                                                            Background="{DynamicResource ModuleBackgroundBrush}"
                                                            CornerRadius="6"
                                                            Padding="12,7"
                                                            BorderThickness="1"
                                                            BorderBrush="{DynamicResource AccentBrush}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="+"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0"/>
                                                            <TextBlock Text="ADD ITEM ROW"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="AddRowBorder" Property="Opacity" Value="0.75"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ ADD NEW SPEC GROUP BUTTON ============ -->
            <Button Command="{Binding AddSpecGroupCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Margin="0,4,0,0"
                    Cursor="Hand"
                    HorizontalAlignment="Left">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AddBorder"
                                Background="{DynamicResource ModuleBackgroundBrush}"
                                CornerRadius="8"
                                Padding="16,10"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource AccentBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="ADD NEW SPEC GROUP"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AddBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>