<!--
    Step 5 — stacked spec groups, page scroll.
    Do NOT put the row list in a * TabControl/ListView viewport:
    that collapsed the grid to zero height and virtualized empty rows
    away when the user dragged them.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step5DataGrid.DataGridView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:controls="clr-namespace:ProGlassAutomation.Controls.AutoCompleteTextBox"
             xmlns:summary="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step5DataGrid.GrandTotalSummary"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1100"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control+Shift" Key="N" Command="{Binding AddSpecGroupCommand}"/>
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding OpenGlobalFindCommand}"/>
        <KeyBinding Modifiers="Control" Key="H" Command="{Binding OpenGlobalFindReplaceCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="GridCellStyle" TargetType="TextBox" BasedOn="{StaticResource LineItemsIntCellStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MaxHeight" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="GridDecStyle" TargetType="TextBox" BasedOn="{StaticResource LineItemsDecimalCellStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MaxHeight" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="GridTextStyle" TargetType="TextBox" BasedOn="{StaticResource LineItemsTextCellStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MaxHeight" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="GridRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="AllowDrop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBorder"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                Padding="0,2"
                                Background="Transparent"
                                HorizontalAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter TargetName="RowBorder" Property="Background"
                                        Value="{DynamicResource TintAmberBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="RowBorder" Property="Background"
                                        Value="{DynamicResource TintBlueBrush}"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="RowBorder" Property="BorderThickness"
                                        Value="3,0,0,1"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  Focusable="False"
                  Background="Transparent"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel>

            <StackPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="05" Style="{StaticResource PiStationCodeStyle}"/>
                    <TextBlock Text="CUT LIST" Style="{StaticResource PiStationTitleStyle}"/>
                </StackPanel>
                <TextBlock Text="GLASS REF · W1 H1 W2 H2 · QTY · SQM · T.SQM · RATE · VALUE."
                           Style="{StaticResource ModulePageSubtitleStyle}"
                           TextWrapping="Wrap"/>

                <Grid Margin="0,10,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding ImportCutListCommand}"
                            Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE8B5;"
                            Height="32" MinWidth="88" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            ToolTip="Import REF / W1 / H1 / W2 / H2 / QTY from Excel, CSV, PDF or photo"
                            Content="IMPORT"/>

                    <Button x:Name="ExportMenuButton"
                            Grid.Column="1"
                            Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xEDE1;"
                            Height="32" MinWidth="96" Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Click="ExportMenuButton_Click"
                            ToolTip="Export this cut list"
                            Content="EXPORT ▾">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource ModernContextMenuStyle}"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Excel"
                                          Style="{StaticResource ModernMenuItemStyle}"
                                          Command="{Binding ExportExcelCommand}"/>
                                <MenuItem Header="CSV"
                                          Style="{StaticResource ModernMenuItemStyle}"
                                          Command="{Binding ExportCsvCommand}"/>
                                <MenuItem Header="PDF"
                                          Style="{StaticResource ModernMenuItemStyle}"
                                          Command="{Binding ExportPdfCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <TextBlock Grid.Column="2"
                               Text="{Binding IoStatus}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IoStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="SPECS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="10,4"
                                MinWidth="36"
                                Margin="0,0,10,0">
                            <TextBlock Text="{Binding TotalSpecGroups}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <Button Command="{Binding AddSpecGroupCommand}"
                                Style="{StaticResource PiGhostChipButton}"
                                Height="32"
                                ToolTip="Add new spec group (Ctrl+Shift+N)"
                                Content="+ ADD SPEC"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding SpecGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="12,10"
                                Margin="0,0,0,10"
                                SnapsToDevicePixels="True">
                            <Border.InputBindings>
                                <KeyBinding Modifiers="Control" Key="N" Command="{Binding AddRowCommand}"/>
                            </Border.InputBindings>
                            <StackPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Background="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,1">
                                        <TextBlock Text="{Binding GroupNumber}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="GLASS TYPE" Style="{StaticResource PiFieldLabelStyle}" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding DataContext.GlassTypeOptions,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SelectedGlassType}"
                                                  Style="{StaticResource PiComboBoxStyle}"
                                                  Height="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="SPECIFICATION" Style="{StaticResource PiFieldLabelStyle}" Margin="0,0,0,2"/>
                                        <controls:AutoCompleteTextBox
                                            ItemsSource="{Binding FilteredSpecs}"
                                            Text="{Binding SpecTypedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedItem="{Binding SelectedSpecItem, Mode=TwoWay}"
                                            IsDropDownOpen="{Binding IsSpecDropdownOpen, Mode=TwoWay}"
                                            DisplayMemberPath="SpecName"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                                        <TextBlock Text="BASE" Style="{StaticResource PiFieldLabelStyle}" Margin="0,0,0,2"
                                                   ToolTip="{Binding ImportedPrice, StringFormat=Imported AED {0:N2}}"/>
                                        <TextBox Text="{Binding BaseRate, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource GridDecStyle}"
                                                 Width="80"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                                        <TextBlock Text="SURCHARGE %" Style="{StaticResource PiFieldLabelStyle}" Margin="0,0,0,2"
                                                   ToolTip="{Binding SurchargeRate, StringFormat=With surcharge AED {0:N2}}"/>
                                        <TextBox Text="{Binding SurchargePercent, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource GridDecStyle}"
                                                 Width="64"/>
                                    </StackPanel>
                                    <Button Grid.Column="10"
                                            Command="{Binding DataContext.RemoveSpecGroupCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PiIconButtonStyle}"
                                            VerticalAlignment="Bottom"
                                            ToolTip="Remove spec group">
                                        <TextBlock Text="&#xE74D;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                    </Button>
                                </Grid>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding SpecDisplayName}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="{Binding SheetSelectionSummary}"
                                               FontSize="10"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSheetSelectionSummary}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Border Style="{StaticResource PiTableHeaderStyle}" Padding="6,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="0.75*"/>
                                            <ColumnDefinition Width="0.75*"/>
                                            <ColumnDefinition Width="0.75*"/>
                                            <ColumnDefinition Width="0.75*"/>
                                            <ColumnDefinition Width="0.65*"/>
                                            <ColumnDefinition Width="0.85*"/>
                                            <ColumnDefinition Width="0.75*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="26"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="#" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="1" Text="GLASS REF" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="2" Text="W1" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="3" Text="H1" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="4" Text="W2" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="5" Text="H2" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="6" Text="QTY" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="7" Text="SQM" Style="{StaticResource LineItemsHeaderTextStyle}"
                                                   ToolTip="Unit panel area"/>
                                        <TextBlock Grid.Column="8" Text="TOTAL SQM" Style="{StaticResource LineItemsHeaderTextStyle}"
                                                   ToolTip="Total SQM (SQM × Qty)"/>
                                        <TextBlock Grid.Column="9" Text="RATE" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="10" Text="VALUE" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <ListView ItemsSource="{Binding ItemRows}"
                                          ItemContainerStyle="{StaticResource GridRowStyle}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="0"
                                          Margin="0"
                                          MinHeight="44"
                                          AllowDrop="False"
                                          Focusable="True"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.CanContentScroll="False"
                                          behaviors:DataGridNavigationBehavior.EnableExcelNav="True">
                                    <ListView.Template>
                                        <ControlTemplate TargetType="ListView">
                                            <ItemsPresenter/>
                                        </ControlTemplate>
                                    </ListView.Template>
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Add New Row (Ctrl+N)" Command="{Binding AddRowCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Find… (Ctrl+F)" Command="{Binding OpenFindCommand}"/>
                                            <MenuItem Header="Find and Replace… (Ctrl+H)" Command="{Binding OpenFindReplaceCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Paste — click a cell first, then Ctrl+V"
                                                      Command="{Binding PasteExcelCommand}"/>
                                        </ContextMenu>
                                    </ListView.ContextMenu>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="0.75*"/>
                                                    <ColumnDefinition Width="0.75*"/>
                                                    <ColumnDefinition Width="0.75*"/>
                                                    <ColumnDefinition Width="0.75*"/>
                                                    <ColumnDefinition Width="0.65*"/>
                                                    <ColumnDefinition Width="0.85*"/>
                                                    <ColumnDefinition Width="0.75*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding SerialNumber}" Style="{StaticResource LineItemsSerialStyle}"/>
                                                <TextBox Grid.Column="1" Text="{Binding GlassRef, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GridTextStyle}" Margin="2,0"/>
                                                <TextBox Grid.Column="2" Text="{Binding W1, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GridCellStyle}" Margin="2,0"/>
                                                <TextBox Grid.Column="3" Text="{Binding H1, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GridCellStyle}" Margin="2,0"/>
                                                <TextBox Grid.Column="4" Text="{Binding W2, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GridCellStyle}" Margin="2,0"/>
                                                <TextBox Grid.Column="5" Text="{Binding H2, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GridCellStyle}" Margin="2,0"/>
                                                <TextBox Grid.Column="6" Text="{Binding Qty, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GridCellStyle}" Margin="2,0"/>
                                                <TextBlock Grid.Column="7" Text="{Binding Sqm1, StringFormat={}{0:0.000}}" Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                <TextBlock Grid.Column="8" Text="{Binding TotalSqm, StringFormat={}{0:0.000}}" Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                <TextBox Grid.Column="9" Text="{Binding Rate, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GridDecStyle}" Margin="1,0"/>
                                                <TextBlock Grid.Column="10" Text="{Binding Value, StringFormat=AED {0:N2}}" Style="{StaticResource LineItemsMoneyStyle}"/>
                                                <Button Grid.Column="11"
                                                        Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PiIconButtonStyle}"
                                                        ToolTip="Delete row (Ctrl+Delete)">
                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0" SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="0.75*"/>
                                            <ColumnDefinition Width="0.75*"/>
                                            <ColumnDefinition Width="0.75*"/>
                                            <ColumnDefinition Width="0.75*"/>
                                            <ColumnDefinition Width="0.65*"/>
                                            <ColumnDefinition Width="0.85*"/>
                                            <ColumnDefinition Width="0.75*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="26"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox Width="64" Text="{Binding BulkRowCountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource GridCellStyle}"
                                                     ToolTip="Number of rows to generate (max 10,000)"/>
                                            <Button Command="{Binding GenerateRowsCommand}"
                                                    Style="{StaticResource PiGhostChipButton}"
                                                    Margin="6,0,8,0"
                                                    Height="24"
                                                    Content="GENERATE"/>
                                            <Button Command="{Binding AddRowCommand}"
                                                    Style="{StaticResource PiGhostChipButton}"
                                                    Height="24"
                                                    Content="+ ADD ROW"/>
                                        </StackPanel>

                                        <!-- Total QTY under QTY column -->
                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding FooterTotalQty, Mode=OneWay}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Total SQM under TOTAL SQM column -->
                                        <TextBlock Grid.Column="8"
                                                   Text="{Binding FooterTotalSqm, StringFormat={}{0:0.00}, Mode=OneWay}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Total value under VALUE column -->
                                        <TextBlock Grid.Column="10"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,4,0">
                                            <Run Text="AED "/><Run Text="{Binding FooterTotalValue, StringFormat={}{0:N2}, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <summary:GrandTotalSummaryView DataContext="{Binding SummaryViewModel}"
                                           Margin="0,4,0,8"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
