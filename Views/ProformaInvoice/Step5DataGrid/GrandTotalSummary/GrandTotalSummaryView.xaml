<!--
═══════════════════════════════════════════════════════════════════════
FILE: Views/ProformaInvoice/Step5DataGrid/GrandTotalSummary/GrandTotalSummaryView.xaml

CHAT 20 — Fix A8 applied. Zero known issues.

FIXES APPLIED:
  A8 : Grand total indigo row now collapses when TotalSpecGroups = 0.
       Previously the row showed 0 pcs / 0.000 sqm / AED 0.00
       simultaneously with the "No spec groups yet" empty state.
       Now both states are mutually exclusive and visually clean.

ADDITIONAL:
  A8b: Column headers Grid and divider Border also collapse when
       TotalSpecGroups = 0 — no floating headers above empty state.

PRESERVED EXACTLY:
  ✅ All styles (ColHeaderStyle, RowCellStyle, GrandCellStyle)
  ✅ Per-spec-group summary rows (SummaryRows ItemsControl)
  ✅ Grand total indigo gradient hero row
  ✅ Empty state panel
  ✅ All bindings (TotalSpecGroups, SummaryRows, GrandTotal*)
  ✅ DropShadowEffect on summary card and grand total row
  ✅ Column layout and alignment
  ✅ Color coding (blue SQM, violet LM, green Value)
═══════════════════════════════════════════════════════════════════════
-->
<UserControl
    x:Class="ProGlassAutomation.Views.ProformaInvoice.Step5DataGrid.GrandTotalSummary.GrandTotalSummaryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="900"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextHintingMode="Fixed"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Column header style -->
        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Body row cell style -->
        <Style x:Key="RowCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Grand total row cell style (white on indigo) -->
        <Style x:Key="GrandCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════════════
         SUMMARY CARD — indigo accent border, elevated shadow
    ══════════════════════════════════════════════════════════════════ -->
    <Border Background="{DynamicResource ModuleBackgroundBrush}"
            CornerRadius="14"
            Padding="22"
            Margin="0,16,0,0"
            BorderThickness="1"
            BorderBrush="#4338CA">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="3"
                              Direction="270"
                              Color="#4338CA"
                              Opacity="0.10"/>
        </Border.Effect>

        <StackPanel>

            <!-- ── Card Header ── -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon badge -->
                <Border Grid.Column="0"
                        Background="{DynamicResource AccentBrush}"
                        Width="36" Height="36"
                        CornerRadius="10"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="2"
                                          Direction="270"
                                          Color="#4338CA"
                                          Opacity="0.30"/>
                    </Border.Effect>
                    <TextBlock Text="&#xE9D2;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Title + subtitle -->
                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Grand Total Summary"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="Per-spec breakdown and data grid grand totals"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Spec groups pill -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Spec Groups:"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Border Background="{DynamicResource AccentBrush}"
                            CornerRadius="10"
                            Padding="12,4"
                            MinWidth="42">
                        <TextBlock Text="{Binding TotalSpecGroups}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ── Divider ── -->
            <Border Background="{DynamicResource BorderBrush}"
                    Height="1"
                    Margin="0,0,0,14"/>

            <!-- ── Column headers
                 A8b FIX: Hidden when TotalSpecGroups = 0.
                 No floating headers above empty state.
            ── -->
            <Grid Margin="0,0,0,4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TotalSpecGroups}"
                                         Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="#"
                           Style="{StaticResource ColHeaderStyle}"/>
                <TextBlock Grid.Column="1"
                           Text="SPEC GROUP"
                           Style="{StaticResource ColHeaderStyle}"/>
                <TextBlock Grid.Column="2"
                           Text="QTY"
                           Style="{StaticResource ColHeaderStyle}"
                           HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3"
                           Text="TOTAL SQM"
                           Style="{StaticResource ColHeaderStyle}"
                           HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4"
                           Text="TOTAL LM"
                           Style="{StaticResource ColHeaderStyle}"
                           HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5"
                           Text="VALUE (AED)"
                           Style="{StaticResource ColHeaderStyle}"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- ── Per-spec-group rows ── -->
            <ItemsControl ItemsSource="{Binding SummaryRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0,10"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Margin="0,0,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <!-- Group number badge -->
                                <Border Grid.Column="0"
                                        Background="{DynamicResource TintIndigoBrush}"
                                        Width="28" Height="28"
                                        CornerRadius="8"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GroupNumber}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Spec label -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayLabel}"
                                           Style="{StaticResource RowCellStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="6,0,0,0"/>

                                <!-- QTY -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding TotalQty,
                                               StringFormat={}{0} pcs}"
                                           Style="{StaticResource RowCellStyle}"
                                           HorizontalAlignment="Right"/>

                                <!-- SQM — Info Blue -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding TotalSqm,
                                               StringFormat={}{0:0.000} sqm}"
                                           Style="{StaticResource RowCellStyle}"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource AccentBrush}"/>

                                <!-- LM — Deep Violet -->
                                <TextBlock Grid.Column="4"
                                           Text="{Binding TotalLm,
                                               StringFormat={}{0:0.00} lm}"
                                           Style="{StaticResource RowCellStyle}"
                                           HorizontalAlignment="Right"
                                           Foreground="#7C3AED"/>

                                <!-- VALUE — Deep Forest Green -->
                                <TextBlock Grid.Column="5"
                                           Text="{Binding TotalValue,
                                               StringFormat=AED {0:N2}}"
                                           Style="{StaticResource RowCellStyle}"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ── Grand total row — deep indigo hero card
                 A8 FIX: Collapsed when TotalSpecGroups = 0.
                 Was previously always visible showing all zeros,
                 conflicting with the empty state panel below.
            ── -->
            <Border CornerRadius="10"
                    Padding="10,14"
                    Margin="0,12,0,0"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Default visible — shown when groups exist -->
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <!-- A8 FIX: Hide when no spec groups exist -->
                            <DataTrigger Binding="{Binding TotalSpecGroups}"
                                         Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#4338CA" Offset="0"/>
                        <GradientStop Color="#6366F1" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14"
                                      ShadowDepth="3"
                                      Direction="270"
                                      Color="#4338CA"
                                      Opacity="0.35"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- Trophy icon -->
                    <TextBlock Grid.Column="0"
                               Text="&#xEB95;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="GRAND TOTAL"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding GrandTotalQty,
                                   StringFormat={}{0} pcs}"
                               Style="{StaticResource GrandCellStyle}"
                               HorizontalAlignment="Right"/>

                    <TextBlock Grid.Column="3"
                               Text="{Binding GrandTotalSqm,
                                   StringFormat={}{0:0.000} sqm}"
                               Style="{StaticResource GrandCellStyle}"
                               HorizontalAlignment="Right"/>

                    <TextBlock Grid.Column="4"
                               Text="{Binding GrandTotalLm,
                                   StringFormat={}{0:0.00} lm}"
                               Style="{StaticResource GrandCellStyle}"
                               HorizontalAlignment="Right"/>

                    <TextBlock Grid.Column="5"
                               Text="{Binding GrandTotalValue,
                                   StringFormat=AED {0:N2}}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Empty state
                 Shown when TotalSpecGroups = 0.
                 Mutually exclusive with grand total row (above).
            ── -->
            <StackPanel HorizontalAlignment="Center"
                        Margin="0,20,0,4">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TotalSpecGroups}"
                                         Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Background="{DynamicResource TintIndigoBrush}"
                        Width="44" Height="44"
                        CornerRadius="22"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                    <TextBlock Text="&#xE9D2;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="No spec groups yet"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Add a spec group above to see totals here."
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>