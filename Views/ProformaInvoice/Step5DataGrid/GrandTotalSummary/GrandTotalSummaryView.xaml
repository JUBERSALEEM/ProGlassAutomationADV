<!--
    Step 5 grand-total strip. Slim table — not a gradient hero card.
    Bindings unchanged.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step5DataGrid.GrandTotalSummary.GrandTotalSummaryView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="180"
             d:DesignWidth="900"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <StackPanel>
        <Grid Margin="0,0,0,2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TotalSpecGroups}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="#" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="1" Text="{DynamicResource ProformaInvoice.SPECGroup}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="2" Text="QTY" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="3" Text="{DynamicResource DeliveryNote.TotalSQM}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="4" Text="{DynamicResource Inquiry.Value}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
        </Grid>

        <ItemsControl ItemsSource="{Binding SummaryRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                            Padding="0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding GroupNumber}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayLabel}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding TotalQty, StringFormat={}{0} pcs}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding TotalSqm, StringFormat={}{0:0.000}}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="4"
                                       Text="{Binding TotalValue, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Padding="0,8,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TotalSpecGroups}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1"
                           Text="{DynamicResource ProformaInvoice.GrandTotal}"
                           FontSize="{DynamicResource FontSize.Body}"
                           FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding GrandTotalQty, StringFormat={}{0} pcs}"
                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding GrandTotalSqm, StringFormat={}{0:0.000}}"
                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Grid.Column="4"
                           Text="{Binding GrandTotalLm, StringFormat={}{0:0.00}}"
                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Grid.Column="5"
                           Text="{Binding GrandTotalValue, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                           FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource SuccessBrush}"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
