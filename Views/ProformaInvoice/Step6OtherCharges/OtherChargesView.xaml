<!--
═══════════════════════════════════════════════════════════════════════
FILE: Views/ProformaInvoice/Step6OtherCharges/OtherChargesView.xaml
═══════════════════════════════════════════════════════════════════════
CHAT 17 — PERFORMANCE + UI POLISH
  PERF-01: Removed DropShadowEffect from Step Header Icon.
  PERF-02: Removed DropShadowEffect from Metric Discovery Hub container.
           Indigo BorderBrush + BorderThickness=1 preserved for emphasis.
  UI-01:   Metric Hub section header icon → solid #4338CA / White.
  All bindings, MultiDataTriggers, ComboBox visibility rules, and
  Bug 4 / Bug 5 fixes preserved exactly.
═══════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges.OtherChargesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:beh="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:wastages="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges.Wastages"
             xmlns:custom="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges.CustomCharges"
             mc:Ignorable="d"
             d:DesignHeight="1200"
             d:DesignWidth="1200"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════════
             RATE NUMERIC INPUT — compact for table cells
             Green when active (money editable), muted when inactive
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="RateInputStyle" TargetType="TextBox">
            <Setter Property="Background"                Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"                Value="#047857"/>
            <Setter Property="BorderThickness"           Value="1"/>
            <Setter Property="BorderBrush"               Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize"                  Value="12"/>
            <Setter Property="FontWeight"                Value="Bold"/>
            <Setter Property="Padding"                   Value="8,0"/>
            <Setter Property="Height"                    Value="30"/>
            <Setter Property="MinWidth"                  Value="64"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush"     Value="#047857"/>
                                <Setter TargetName="B" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"          Value="{DynamicResource SecondaryForegroundBrush}"/>
                                <Setter TargetName="B" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             CUSTOM POLISH INLINE INPUT — for description + manual qty
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="CustomInputStyle" TargetType="TextBox">
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush"     Value="#4338CA"/>
                                <Setter TargetName="B" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             METRIC CARD — hub display cards
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="Margin"          Value="4"/>
            <Setter Property="MinWidth"        Value="150"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20,32,20">
        <StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 STEP HEADER
                 PERF-01: DropShadowEffect removed.
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Background="#4338CA"
                        Width="44"
                        Height="44"
                        CornerRadius="12"
                        VerticalAlignment="Center">
                    <!-- Segoe MDL2 money / receipt icon -->
                    <TextBlock Text="&#xE8C7;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{Binding Title}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- Divider -->
            <Border Background="{DynamicResource BorderBrush}"
                    Height="1"
                    Margin="0,20,0,20"/>

            <!-- ══════════════════════════════════════════════════════════
                 AUTOMATED METRIC DISCOVERY HUB
                 PERF-02: DropShadowEffect removed. BorderBrush indigo kept.
            ══════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="14"
                    Padding="18"
                    BorderThickness="1"
                    BorderBrush="#4338CA"
                    Margin="0,0,0,18">

                <StackPanel>

                    <!-- Section title with icon badge — UI-01: solid #4338CA / White -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#4338CA"
                                Width="28"
                                Height="28"
                                CornerRadius="8"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                            <TextBlock Text="&#xE9D2;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Automated Metric Discovery Hub"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Auto-calculated from your data grid rows"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Metrics row 1 — Glass LM + Pieces -->
                    <WrapPanel>
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="TOTAL GLASS 1 (LM1)" FontSize="10" FontWeight="Bold" Foreground="#4338CA"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding MetricHub.TotalLm1, StringFormat={}{0:0.##}}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text=" lm" FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="TOTAL GLASS 2 (LM2)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding MetricHub.TotalLm2, StringFormat={}{0:0.##}}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text=" lm" FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="COMBINED GLASS (LM)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding MetricHub.CombinedLm, StringFormat={}{0:0.##}}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text=" lm" FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="TOTAL PIECES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding MetricHub.TotalPieces}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text=" pcs" FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="DOUBLE GLASS (1+1)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding MetricHub.DoubleGlassPieces}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text=" pcs" FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Metrics row 2 — SQM + refs -->
                    <WrapPanel Margin="0,6,0,0">
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="AREA GLASS 1 (SQM1)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding MetricHub.TotalSqm1, StringFormat={}{0:0.##}}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text=" sqm" FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="AREA GLASS 2 (SQM2)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding MetricHub.TotalSqm2, StringFormat={}{0:0.##}}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text=" sqm" FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="COMBINED AREA (SQM)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding MetricHub.CombinedSqm, StringFormat={}{0:0.##}}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text=" sqm" FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="DGU CAVITY AREA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding MetricHub.DguCavityArea, StringFormat={}{0:0.##}}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text=" sqm" FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Primary glass refs card -->
                        <Border Style="{StaticResource MetricCardStyle}" MinWidth="320" MaxWidth="520">
                            <StackPanel>
                                <TextBlock Text="PRIMARY GLASS REFS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <ItemsControl ItemsSource="{Binding MetricHub.PrimaryGlassRefs}" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#EEF2FF"
                                                    CornerRadius="6"
                                                    Padding="10,4"
                                                    Margin="0,0,4,4"
                                                    ToolTip="{Binding}">
                                                <TextBlock Text="{Binding}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#4338CA"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 ACTIVE WORKSHEET ROWS HEADER + TOTAL PILL
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Active Worksheet Rows"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="These charges are calculated dynamically based on target variables selected by the user."
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#ECFDF5"
                        BorderBrush="#A7F3D0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,10"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total Other Charges: "
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalOtherCharges, StringFormat=AED {0:N2}}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#047857"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 TABLE HEADER
                 QTY / SQM column preserved (Bug 4 fix from Chat 7)
            ══════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="2.6*"/>
                        <ColumnDefinition Width="2.3*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ACTIVE"                          FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="CHARGE ITEM &amp; DESCRIPTION"    FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <TextBlock Grid.Column="2" Text="TARGET SOURCE / POLISH TYPE"     FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <!-- Bug 4: was "METRIC QTY" — now shows QTY / SQM for unit clarity -->
                    <TextBlock Grid.Column="3" Text="QTY / SQM"                        FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="RATE (AED)"                       FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="FORMULA &amp; RESULT (AED)"       FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 CHARGE ROWS
            ══════════════════════════════════════════════════════════ -->
            <ItemsControl ItemsSource="{Binding ChargeRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Padding="12,12"
                                Margin="0,0,0,2">
                            <StackPanel>

                                <!-- Main row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="2.6*"/>
                                        <ColumnDefinition Width="2.3*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Active checkbox -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsActive, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Cursor="Hand"/>

                                    <!-- Name + description -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                                        <TextBlock Text="{Binding ChargeName}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Source dropdown (non-polish rows) -->
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding AvailableSources}"
                                              SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel"
                                              IsEnabled="{Binding IsActive}"
                                              Height="32"
                                              VerticalContentAlignment="Center"
                                              Margin="0,0,10,0">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPolishRow}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>

                                    <!-- Polish sub-type dropdown (polish rows only) -->
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding AvailablePolishSubTypes}"
                                              SelectedItem="{Binding SelectedPolishSubType, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel"
                                              IsEnabled="{Binding IsActive}"
                                              Height="32"
                                              VerticalContentAlignment="Center"
                                              Margin="0,0,10,0">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPolishRow}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>

                                    <!-- Metric qty badge — Deep Royal Blue -->
                                    <Border Grid.Column="3"
                                            Background="#DBEAFE"
                                            CornerRadius="8"
                                            Padding="10,5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding MetricQty, StringFormat={}{0:0.###}}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="#1E40AF"/>
                                            <TextBlock Text=" "/>
                                            <TextBlock Text="{Binding Unit}"
                                                       FontSize="10"
                                                       Foreground="#1E40AF"
                                                       Opacity="0.75"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,0,1"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Rate input (Bug 5 preserved) -->
                                    <TextBox Grid.Column="4"
                                             Text="{Binding Rate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}"
                                             Style="{StaticResource RateInputStyle}"
                                             beh:TextBoxBehaviors.AcceptDecimals="True"
                                             IsEnabled="{Binding IsActive}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                                    <!-- Formula & result -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding FormulaDisplay}"
                                               FontSize="11"
                                               TextAlignment="Right"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#047857"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- ══════════════════════════════════════
                                     CUSTOM POLISH INLINE EDITOR
                                     BUG FIX: was hardcoded #151E2C (broke dark mode)
                                     Now uses indigo tint — theme-safe
                                ══════════════════════════════════════ -->
                                <Border Background="#EEF2FF"
                                        CornerRadius="10"
                                        Padding="14,12"
                                        Margin="60,10,0,0"
                                        BorderThickness="1"
                                        BorderBrush="#C7D2FE">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsPolishRow}"     Value="True"/>
                                                        <Condition Binding="{Binding IsCustomPolish}"  Value="True"/>
                                                        <Condition Binding="{Binding IsActive}"        Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="CUSTOM DESCRIPTION:"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#4338CA"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding CustomPolishDescription, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CustomInputStyle}"
                                                 Margin="0,0,14,0"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="MANUAL QTY (lm):"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#4338CA"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <!-- Bug 5: AcceptDecimals preserved -->
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding CustomPolishQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}"
                                                 Style="{StaticResource CustomInputStyle}"
                                                 beh:TextBoxBehaviors.AcceptDecimals="True"
                                                 MinWidth="90"/>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ══════════════════════════════════════════════════════════
                 PHASE 7.11c — GLASS WASTAGES SECTION
            ══════════════════════════════════════════════════════════ -->
            <wastages:WastagesSectionView DataContext="{Binding WastagesSection}"/>

            <!-- ══════════════════════════════════════════════════════════
                 PHASE 7.11d — CUSTOM MANUAL CHARGES SECTION
            ══════════════════════════════════════════════════════════ -->
            <custom:CustomChargesSectionView DataContext="{Binding CustomChargesSection}"/>

            <!-- ══════════════════════════════════════════════════════════
                 PHASE STATUS NOTE
            ══════════════════════════════════════════════════════════ -->
            <Border Background="#EEF2FF"
                    BorderBrush="#C7D2FE"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,30,0,20"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE930;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="#4338CA"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock FontSize="11"
                               Foreground="#4338CA"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center">
                        <Run FontWeight="Bold">Step 6 Complete.</Run>
                        <Run>All predefined charges, polish sub-types, color-aggregated wastages, and manual custom charges are implemented and integrated into the total.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>