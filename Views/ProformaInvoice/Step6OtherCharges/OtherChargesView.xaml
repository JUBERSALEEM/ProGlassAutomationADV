<!--
    Step 6 — Charges. Approved mockup composition:
    one workbench, KPI strip, then three table bands:
    Predefined · Wastage · Custom. Bindings and popups unchanged.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges.OtherChargesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:beh="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:wastages="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges.Wastages"
             xmlns:custom="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges.CustomCharges"
             mc:Ignorable="d"
             d:DesignHeight="1200"
             d:DesignWidth="1200"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="RateInputStyle" TargetType="TextBox">
            <Setter Property="beh:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomInputStyle" TargetType="TextBox">
            <Setter Property="beh:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SpecTargetToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="&#xE70D;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Border Padding="0">
            <StackPanel>

                <Border Style="{StaticResource PiMetricStripStyle}" Padding="0,4,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PiKpiCellStyle}">
                            <StackPanel>
                                <TextBlock Text="LM1" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding MetricHub.TotalLm1, StringFormat={}{0:0.##}}" Style="{StaticResource PiKpiValueStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PiKpiCellStyle}">
                            <StackPanel>
                                <TextBlock Text="LM2" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding MetricHub.TotalLm2, StringFormat={}{0:0.##}}" Style="{StaticResource PiKpiValueStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PiKpiCellStyle}">
                            <StackPanel>
                                <TextBlock Text="LM COMBINED" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding MetricHub.CombinedLm, StringFormat={}{0:0.##}}" Style="{StaticResource PiKpiValueStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource PiKpiCellStyle}">
                            <StackPanel>
                                <TextBlock Text="PIECES" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding MetricHub.TotalPieces}" Style="{StaticResource PiKpiValueStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource PiKpiCellStyle}">
                            <StackPanel>
                                <TextBlock Text="DGU PCS" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding MetricHub.DoubleGlassPieces}" Style="{StaticResource PiKpiValueStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="5" Style="{StaticResource PiKpiCellStyle}">
                            <StackPanel>
                                <TextBlock Text="SQM1" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding MetricHub.TotalSqm1, StringFormat={}{0:0.##}}" Style="{StaticResource PiKpiValueStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Style="{StaticResource PiKpiCellStyle}">
                            <StackPanel>
                                <TextBlock Text="SQM2" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding MetricHub.TotalSqm2, StringFormat={}{0:0.##}}" Style="{StaticResource PiKpiValueStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="7" Style="{StaticResource PiKpiCellStyle}">
                            <StackPanel>
                                <TextBlock Text="SQM COMBINED" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding MetricHub.CombinedSqm, StringFormat={}{0:0.##}}" Style="{StaticResource PiKpiValueStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="8" Style="{StaticResource PiKpiCellStyle}" BorderThickness="0">
                            <StackPanel>
                                <TextBlock Text="DGU CAVITY" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding MetricHub.DguCavityArea, StringFormat={}{0:0.##}}" Style="{StaticResource PiKpiValueStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Text="PREDEFINED CHARGES" Style="{StaticResource PiBandTitleStyle}" Margin="0,4,0,6"/>

                <Border Style="{StaticResource PiTableHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="2.4*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.8*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ON" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                        <TextBlock Grid.Column="1" Text="CHARGE" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="2" Text="BASIS" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="3" Text="QTY" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                        <TextBlock Grid.Column="4" Text="RATE" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                        <TextBlock Grid.Column="5" Text="RESULT" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding ChargeRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="2.4*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="1.8*"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Cursor="Hand"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding ChargeName}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Grid Grid.Column="2" Margin="0,0,8,0">
                                            <TextBlock Text="1 TRIP × Rate"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDeliveryRow}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDeliveryRow}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <ComboBox ItemsSource="{Binding AvailablePolishSubTypes}"
                                                          SelectedItem="{Binding SelectedPolishSubType, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayLabel"
                                                          IsEnabled="{Binding IsActive}"
                                                          Height="28"
                                                          VerticalContentAlignment="Center"
                                                          Margin="0,0,0,4">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPolishRow}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>

                                                <ToggleButton x:Name="TargetToggle"
                                                              Content="{Binding TargetSelection.SummaryText, FallbackValue='Select specs and metric…'}"
                                                              Style="{StaticResource SpecTargetToggleStyle}"
                                                              IsEnabled="{Binding IsActive}"/>

                                                <Popup IsOpen="{Binding IsChecked, ElementName=TargetToggle}"
                                                       StaysOpen="False"
                                                       PlacementTarget="{Binding ElementName=TargetToggle}"
                                                       AllowsTransparency="True"
                                                       PopupAnimation="Fade">
                                                    <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                                            BorderBrush="{DynamicResource AccentBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Padding="14"
                                                            MinWidth="480"
                                                            MaxWidth="720"
                                                            MaxHeight="480">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                      HorizontalScrollBarVisibility="Disabled">
                                                            <StackPanel DataContext="{Binding TargetSelection}">
                                                                <TextBlock Text="SELECT SPECS"
                                                                           Style="{StaticResource PiSectionLabelStyle}"/>
                                                                <ItemsControl ItemsSource="{Binding AvailableSpecs}" Margin="0,0,0,12">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                                      Cursor="Hand"
                                                                                      Margin="0,0,0,6"
                                                                                      Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                                      VerticalContentAlignment="Top"
                                                                                      ToolTip="{Binding DisplayName}">
                                                                                <TextBlock Text="{Binding DisplayName}"
                                                                                           FontSize="12"
                                                                                           TextWrapping="Wrap"
                                                                                           Margin="4,0,0,0"/>
                                                                            </CheckBox>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,10"/>
                                                                <TextBlock Text="SELECT METRIC"
                                                                           Style="{StaticResource PiSectionLabelStyle}"/>
                                                                <ListBox ItemsSource="{Binding AvailableMetrics}"
                                                                         SelectedItem="{Binding SelectedMetric, Mode=TwoWay}"
                                                                         BorderThickness="0"
                                                                         Background="Transparent"
                                                                         Margin="0,0,0,10">
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <RadioButton IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                                         Cursor="Hand"
                                                                                         Margin="0,3"
                                                                                         Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                                         ToolTip="{Binding DisplayName}">
                                                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" TextWrapping="Wrap" Margin="4,0,0,0"/>
                                                                            </RadioButton>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                    <ListBox.ItemContainerStyle>
                                                                        <Style TargetType="ListBoxItem">
                                                                            <Setter Property="Padding" Value="0"/>
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                                        <ContentPresenter/>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </ListBox.ItemContainerStyle>
                                                                </ListBox>
                                                                <TextBlock FontSize="11" FontWeight="Bold"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           TextWrapping="Wrap">
                                                                    <Run Text="RESULT: "/>
                                                                    <Run Text="{Binding SummaryText, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Popup>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding MetricQty, StringFormat={}{0:0.###}}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                                        <TextBox Grid.Column="4"
                                                 Text="{Binding Rate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}"
                                                 Style="{StaticResource RateInputStyle}"
                                                 beh:TextBoxBehaviors.AcceptDecimals="True"
                                                 IsEnabled="{Binding IsActive}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding FormulaDisplay}"
                                                   FontSize="11"
                                                   TextAlignment="Right"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Grid Margin="56,8,0,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPolishRow}" Value="True"/>
                                                            <Condition Binding="{Binding IsCustomPolish}" Value="True"/>
                                                            <Condition Binding="{Binding IsActive}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CUSTOM"
                                                   Style="{StaticResource PiFieldLabelStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding CustomPolishDescription, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CustomInputStyle}"
                                                 Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="2" Text="QTY (lm)"
                                                   Style="{StaticResource PiFieldLabelStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding CustomPolishQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}"
                                                 Style="{StaticResource CustomInputStyle}"
                                                 beh:TextBoxBehaviors.AcceptDecimals="True"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <wastages:WastagesSectionView DataContext="{Binding WastagesSection}"/>
                <custom:CustomChargesSectionView DataContext="{Binding CustomChargesSection}"/>

                <Border Style="{StaticResource LineItemsFooterStyle}" Margin="0,12,0,0">
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               HorizontalAlignment="Right">
                        <Run Text="Wastage AED "/>
                        <Run Text="{Binding WastagesSection.TotalWastageValue, StringFormat={}{0:N2}, Mode=OneWay}"/>
                        <Run Text="  ·  Custom AED "/>
                        <Run Text="{Binding CustomChargesSection.TotalCustomChargesValue, StringFormat={}{0:N2}, Mode=OneWay}"/>
                        <Run Text="  ·  Combined "/>
                        <Run Text="{Binding TotalOtherCharges, StringFormat=AED {0:N2}, Mode=OneWay}"
                             FontWeight="Bold"
                             Foreground="{DynamicResource SuccessBrush}"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
