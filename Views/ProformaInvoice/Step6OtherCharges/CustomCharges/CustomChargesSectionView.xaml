<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges.CustomCharges.CustomChargesSectionView"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:beh="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="280" d:DesignWidth="1200"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="FormInputStyle" TargetType="TextBox">
            <Setter Property="beh:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FormNumericInputStyle" TargetType="TextBox" BasedOn="{StaticResource FormInputStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="CUSTOM CHARGES" Style="{StaticResource PiBandTitleStyle}"/>

        <Border Style="{StaticResource PiTableHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ON" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                <TextBlock Grid.Column="1" Text="CHARGE NAME" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="2" Text="QTY" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                <TextBlock Grid.Column="3" Text="UNIT" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                <TextBlock Grid.Column="4" Text="RATE" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                <TextBlock Grid.Column="5" Text="AMOUNT" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding AddedCharges}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="0"
                                          Style="{StaticResource PiToggleSwitch}"
                                          IsChecked="{Binding IsActive}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Custom charge on"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ChargeName}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Qty, StringFormat={}{0:0.###}}"
                                       FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Unit}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Grid.Column="4"
                                       Text="{Binding Rate, StringFormat=AED {0:N2}}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Grid.Column="5"
                                       Text="{Binding FormulaDisplay}"
                                       FontSize="11" FontWeight="Bold"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                            <Button Grid.Column="6"
                                    Command="{Binding DataContext.RemoveChargeCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource PiIconButtonStyle}"
                                    ToolTip="Remove charge">
                                <TextBlock Text="&#xE711;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CHARGE NAME" Style="{StaticResource PiFieldLabelStyle}" Margin="0,0,0,3"/>
                <TextBox Text="{Binding InputName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormInputStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="QTY" Style="{StaticResource PiFieldLabelStyle}" Margin="0,0,0,3"/>
                <TextBox beh:TextBoxBehaviors.AcceptDecimals="True"
                         Style="{StaticResource FormNumericInputStyle}">
                    <TextBox.Text>
                        <Binding Path="InputQty" Mode="TwoWay"
                                 UpdateSourceTrigger="LostFocus"
                                 ConverterCulture="en-US"/>
                    </TextBox.Text>
                </TextBox>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="UNIT" Style="{StaticResource PiFieldLabelStyle}" Margin="0,0,0,3"/>
                <ComboBox ItemsSource="{Binding UnitOptions}"
                          SelectedItem="{Binding InputUnit}"
                          Style="{StaticResource PiComboBoxStyle}"
                          Height="28"/>
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Text="RATE" Style="{StaticResource PiFieldLabelStyle}" Margin="0,0,0,3"/>
                <TextBox beh:TextBoxBehaviors.AcceptDecimals="True"
                         Style="{StaticResource FormNumericInputStyle}">
                    <TextBox.Text>
                        <Binding Path="InputRate" Mode="TwoWay"
                                 UpdateSourceTrigger="LostFocus"
                                 ConverterCulture="en-US"/>
                    </TextBox.Text>
                </TextBox>
            </StackPanel>
            <Button Grid.Column="8"
                    Command="{Binding AddChargeCommand}"
                    Style="{StaticResource PiFooterPrimaryButton}"
                    Height="28"
                    MinWidth="72"
                    VerticalAlignment="Bottom"
                    Content="ADD"/>
        </Grid>
    </StackPanel>
</UserControl>
