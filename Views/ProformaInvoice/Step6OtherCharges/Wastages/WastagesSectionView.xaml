<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges.Wastages.WastagesSectionView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="1200"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="RowInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RateInputStyle" TargetType="TextBox" BasedOn="{StaticResource RowInputStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SourceToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="&#xE70D;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,16,0,6">
            <TextBlock Text="WASTAGE CHARGES" Style="{StaticResource PiBandTitleStyle}" Margin="0"/>
            <Button HorizontalAlignment="Right"
                    Command="{Binding AddWastageCommand}"
                    Style="{StaticResource PiGhostChipButton}">
                <TextBlock Text="+ ADD ROW"
                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Button>
        </Grid>

        <Border Style="{StaticResource PiTableHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ON" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                <TextBlock Grid.Column="1" Text="COLOUR" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="2" Text="SOURCE" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="3" Text="SQM" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                <TextBlock Grid.Column="4" Text="RATE" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                <TextBlock Grid.Column="5" Text="SETUP" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                <TextBlock Grid.Column="6" Text="AMOUNT" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding WastageRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0"
                                              Style="{StaticResource PiToggleSwitch}"
                                              IsChecked="{Binding IsActive}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Wastage on"/>
                                <Grid Grid.Column="1" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ColorName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource RowInputStyle}"
                                             Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SideDisplay}"
                                               Style="{StaticResource PiFieldLabelStyle}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Grid.Column="2" Margin="0,0,8,0">
                                    <ToggleButton x:Name="SourceToggle"
                                                  Style="{StaticResource SourceToggleButtonStyle}"
                                                  ToolTip="{Binding SourceSummaryText}">
                                        <TextBlock Text="{Binding SourceSummaryText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=SourceToggle}"
                                           StaysOpen="False"
                                           PlacementTarget="{Binding ElementName=SourceToggle}"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                Background="{DynamicResource ElevatedSurfaceBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="{DynamicResource CardCornerRadius}"
                                                Padding="12"
                                                MaxHeight="320"
                                                Width="380">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <TextBlock Text="CHOOSE SQM SOURCES"
                                                               FontSize="{StaticResource TextCaption}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               Margin="0,0,0,10"/>
                                                    <ItemsControl ItemsSource="{Binding AvailableSources}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                          Margin="0,0,0,6"
                                                                          Cursor="Hand">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding DisplayLabel}"
                                                                                   FontSize="{StaticResource TextBody}"
                                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                                        <TextBlock Text="{Binding SqmValue, StringFormat={}{0:0.000} sqm}"
                                                                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                                   Margin="10,0,0,0"/>
                                                                    </StackPanel>
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding SourceSummaryText}"
                                                               FontSize="{StaticResource TextBody}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding TotalSqm, StringFormat={}{0:0.000}}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding Rate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.####}}"
                                         Style="{StaticResource RateInputStyle}"
                                         behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                         IsEnabled="{Binding IsManualRateMode}"
                                         Margin="4,0"/>
                                <Grid Grid.Column="5" Margin="4,0">
                                    <ToggleButton x:Name="SetupToggle"
                                                  Style="{StaticResource SourceToggleButtonStyle}"
                                                  ToolTip="Open wastage setup">
                                        <TextBlock Text="SETUP"
                                                   FontSize="{StaticResource TextBody}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=SetupToggle}"
                                           StaysOpen="False"
                                           PlacementTarget="{Binding ElementName=SetupToggle}"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                Background="{DynamicResource ElevatedSurfaceBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="{DynamicResource CardCornerRadius}"
                                                Padding="14"
                                                Width="520"
                                                MaxHeight="420">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel>
                                                    <TextBlock Text="WASTAGE SETUP"
                                                               Style="{StaticResource PiSectionLabelStyle}"
                                                               Margin="0,0,0,10"/>
                                                    <TextBlock Text="{Binding SourceSummaryText}"
                                                               FontSize="{StaticResource TextBody}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,10"/>

                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="COLOR"
                                                                       Style="{StaticResource PiFieldLabelStyle}"
                                                                       Margin="0,0,0,2"/>
                                                            <TextBox Text="{Binding ColorName, Mode=OneWay}"
                                                                     Style="{StaticResource RowInputStyle}"
                                                                     IsReadOnly="True"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="OPTIMIZATION FORMULA"
                                                                       Style="{StaticResource PiFieldLabelStyle}"
                                                                       Margin="0,0,0,2"/>
                                                            <ToggleButton Style="{StaticResource PiToggleSwitch}"
                                                                          IsChecked="{Binding UseOptimizationFormula}"
                                                                          HorizontalAlignment="Left"
                                                                          VerticalAlignment="Center"
                                                                          AutomationProperties.Name="Optimization wastage formula"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="SHEET WIDTH"
                                                                       Style="{StaticResource PiFieldLabelStyle}"
                                                                       Margin="0,0,0,2"/>
                                                            <TextBox Text="{Binding SelectedSheetWidthText, Mode=OneWay}"
                                                                     Style="{StaticResource RowInputStyle}"
                                                                     IsReadOnly="True"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="SHEET HEIGHT"
                                                                       Style="{StaticResource PiFieldLabelStyle}"
                                                                       Margin="0,0,0,2"/>
                                                            <TextBox Text="{Binding SelectedSheetHeightText, Mode=OneWay}"
                                                                     Style="{StaticResource RowInputStyle}"
                                                                     IsReadOnly="True"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <TextBlock Text="SHEET QTY"
                                                                       Style="{StaticResource PiFieldLabelStyle}"
                                                                       Margin="0,0,0,2"/>
                                                            <TextBox Text="{Binding SheetQuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource RowInputStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="6">
                                                            <TextBlock Text="SHEET / SQM PRICE"
                                                                       Style="{StaticResource PiFieldLabelStyle}"
                                                                       Margin="0,0,0,2"/>
                                                            <TextBox Text="{Binding FormulaPricePerSqmText, Mode=OneWay}"
                                                                     Style="{StaticResource RowInputStyle}"
                                                                     IsReadOnly="True"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOptimizationFormulaMode}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="OPT %"
                                                                       Style="{StaticResource PiFieldLabelStyle}"
                                                                       Margin="0,0,0,2"/>
                                                            <TextBox Text="{Binding OptimizationPercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource RowInputStyle}"
                                                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="UTILIZED SQM"
                                                                       Style="{StaticResource PiFieldLabelStyle}"
                                                                       Margin="0,0,0,2"/>
                                                            <TextBox Text="{Binding UtilizedSqm, StringFormat={}{0:0.00}, Mode=OneWay}"
                                                                     Style="{StaticResource RowInputStyle}"
                                                                     IsReadOnly="True"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Text="{Binding OptimizationSummaryText}"
                                                               FontSize="{StaticResource TextBody}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,10,0,0"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <TextBlock Grid.Column="6"
                                           Text="{Binding FormulaDisplay}"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextWrapping="Wrap"/>
                                <Button Grid.Column="7"
                                        Command="{Binding DataContext.RemoveWastageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource PiIconButtonStyle}"
                                        ToolTip="Remove wastage row">
                                    <TextBlock Text="&#xE711;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                               Foreground="{DynamicResource DangerBrush}"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="No wastage rows. Add a colour-side scrap charge if needed."
                   FontSize="{StaticResource TextBody}"
                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                   Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WastageRows.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
