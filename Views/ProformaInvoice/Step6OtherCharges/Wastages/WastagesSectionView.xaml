<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step6OtherCharges.Wastages.WastagesSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="1200"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="RowInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RateInputStyle" TargetType="TextBox" BasedOn="{StaticResource RowInputStyle}">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SourceToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="&#xE70D;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,16,0,6">
            <TextBlock Text="WASTAGE CHARGES" Style="{StaticResource PiBandTitleStyle}" Margin="0"/>
            <Button HorizontalAlignment="Right"
                    Command="{Binding AddWastageCommand}"
                    Style="{StaticResource PiGhostChipButton}">
                <TextBlock Text="+ ADD ROW"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Button>
        </Grid>

        <Border Style="{StaticResource PiTableHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ON" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                <TextBlock Grid.Column="1" Text="COLOUR" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="2" Text="SOURCE" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="3" Text="SQM" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                <TextBlock Grid.Column="4" Text="RATE" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                <TextBlock Grid.Column="5" Text="AMOUNT" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding WastageRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="0"
                                          Style="{StaticResource PiToggleSwitch}"
                                          IsChecked="{Binding IsActive}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Wastage on"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding ColorName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource RowInputStyle}"
                                     Margin="0,0,8,0"/>
                            <Grid Grid.Column="2" Margin="0,0,8,0">
                                <ToggleButton x:Name="SourceToggle"
                                              Style="{StaticResource SourceToggleButtonStyle}"
                                              ToolTip="{Binding SourceSummaryText}">
                                    <TextBlock Text="{Binding SourceSummaryText}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=SourceToggle}"
                                       StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=SourceToggle}"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=Popup}}"
                                            Background="{DynamicResource ModuleBackgroundBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="12"
                                            MaxHeight="320"
                                            Width="380">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="CHOOSE SQM SOURCES"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding AvailableSources}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                      Margin="0,0,0,6"
                                                                      Cursor="Hand">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding DisplayLabel}"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                                    <TextBlock Text="{Binding SqmValue, StringFormat={}{0:0.000} sqm}"
                                                                               FontSize="11" FontWeight="Bold"
                                                                               Foreground="{DynamicResource AccentBrush}"
                                                                               Margin="10,0,0,0"/>
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding SourceSummaryText}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding TotalSqm, StringFormat={}{0:0.000}}"
                                       FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBox Grid.Column="4"
                                     Text="{Binding Rate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}"
                                     Style="{StaticResource RateInputStyle}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     Margin="4,0"/>
                            <TextBlock Grid.Column="5"
                                       Text="{Binding FormulaDisplay}"
                                       FontSize="11" FontWeight="Bold"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       TextWrapping="Wrap"/>
                            <Button Grid.Column="6"
                                    Command="{Binding DataContext.RemoveWastageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource PiIconButtonStyle}"
                                    ToolTip="Remove wastage row">
                                <TextBlock Text="&#xE711;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="No wastage rows. Add a colour-side scrap charge if needed."
                   FontSize="11"
                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                   Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WastageRows.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
