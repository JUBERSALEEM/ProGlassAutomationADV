<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Dashboard"
             xmlns:vmJo="clr-namespace:ProGlassAutomation.ViewModels.Dashboard.JobOrder.JoDashboard"
             xmlns:vmDn="clr-namespace:ProGlassAutomation.ViewModels.Dashboard.DeliveryNote.DnDashboard"
             xmlns:vmTi="clr-namespace:ProGlassAutomation.ViewModels.Dashboard.TaxInvoice.TiDashboard"
             xmlns:vmSt="clr-namespace:ProGlassAutomation.ViewModels.Dashboard.Statement"
             xmlns:ov="clr-namespace:ProGlassAutomation.Views.Dashboard.Overview"
             xmlns:ss="clr-namespace:ProGlassAutomation.Views.Dashboard.SheetStore"
             xmlns:pi="clr-namespace:ProGlassAutomation.Views.Dashboard.ProformaInvoice"
             xmlns:jo="clr-namespace:ProGlassAutomation.Views.Dashboard.JobOrder.JoDashboard"
             xmlns:dn="clr-namespace:ProGlassAutomation.Views.Dashboard.DeliveryNote.DnDashboard"
             xmlns:ti="clr-namespace:ProGlassAutomation.Views.Dashboard.TaxInvoice.TiDashboard"
             xmlns:st="clr-namespace:ProGlassAutomation.Views.Dashboard.Statement"
             FontFamily="Segoe UI" Background="{DynamicResource SurfaceWorkspaceBrush}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Loaded="OnLoaded" SizeChanged="OnDashboardSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
<!-- All seven original page mappings and the same navigation VM. -->
            <DataTemplate DataType="{x:Type vm:OverviewDashboardViewModel}"><ov:OverviewDashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SheetStoreDashboardViewModel}"><ss:SheetStoreDashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PiDashboardViewModel}"><pi:PiDashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vmJo:JoDashboardViewModel}"><jo:JoDashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vmDn:DnDashboardViewModel}"><dn:DnDashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vmTi:TiDashboardViewModel}"><ti:TiDashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vmSt:StDashboardViewModel}"><st:StDashboardView/></DataTemplate>
            <DataTemplate x:Key="ModuleSegmentTemplate">
                <Button Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" ToolTip="{Binding TabSubtitle}" AutomationProperties.Name="{Binding TabTitle}"
                        Style="{StaticResource Button.Ghost}" Background="Transparent" BorderThickness="0" Padding="16,11" Margin="0,0,5,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Pill" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                    BorderThickness="0,0,0,2" CornerRadius="0" Padding="{TemplateBinding Padding}">
                                <TextBlock x:Name="Label" Text="{Binding TabTitle}" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding TabTitle}" Value="Proforma Invoice">
                                    <Setter TargetName="Label" Property="Text" Value="Proformas"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}">
                                            <Binding Path="DataContext.ActivePage" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            <Binding Path="."/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter TargetName="Label" Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pill" Property="Opacity" Value="0.75"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Pill" Property="Opacity" Value="0.45"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource ThemeCardFaceBrush}" Padding="28,18" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="BrandIdentity" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="{DynamicResource AccentBrush}" CornerRadius="10" Margin="0,0,10,0">
                        <TextBlock Text="&#xE81E;" Style="{StaticResource Typography.Body}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    </Border>
                    <TextBlock Text="ProGlass Automation" Style="{StaticResource Typography.Title}" FontSize="21" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="PageSubtitle" Grid.Column="1" Text="{Binding ActivePage.TabSubtitle}" Style="{StaticResource Typography.Caption}"
                           VerticalAlignment="Center" Margin="22,0,16,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <Border x:Name="UserBadge" Grid.Column="2" Background="{DynamicResource ThemeCardHighlightBrush}" CornerRadius="10" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource Typography.Body}" Margin="0,0,8,0" FontSize="14"/>
                        <TextBlock Text="{Binding CurrentUserDisplay}" ToolTip="{Binding CurrentUserDisplay}"
                                   Style="{StaticResource Typography.Body}" FontWeight="SemiBold" MaxWidth="160" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="28,12,28,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Pages}" ItemTemplate="{StaticResource ModuleSegmentTemplate}" KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Column="1" Text="{Binding ActivePage.LastRefreshed}" ToolTip="{Binding ActivePage.LastRefreshed}"
                       Style="{StaticResource Typography.Caption}" MaxWidth="170" Margin="18,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource ThemeCardEdgeBrush}"/>
        <ContentPresenter Grid.Row="3" Content="{Binding ActivePage}"/>
    </Grid>
</UserControl>
