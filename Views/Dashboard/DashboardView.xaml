<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Dashboard"
             xmlns:ov="clr-namespace:ProGlassAutomation.Views.Dashboard.Overview"
             xmlns:ss="clr-namespace:ProGlassAutomation.Views.Dashboard.SheetStore"
             xmlns:pi="clr-namespace:ProGlassAutomation.Views.Dashboard.ProformaInvoice"
             FontFamily="Segoe UI"
             Loaded="OnLoaded">

    <UserControl.Resources>

        <!-- ── page → view wiring via DataTemplate ──────────────────── -->
        <DataTemplate DataType="{x:Type vm:OverviewDashboardViewModel}">
            <ov:OverviewDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SheetStoreDashboardViewModel}">
            <ss:SheetStoreDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PiDashboardViewModel}">
            <pi:PiDashboardView/>
        </DataTemplate>

        <!-- ── tab button style ─────────────────────────────────────── -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="20,14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           FontSize="13"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground"
                                        Value="{DynamicResource PrimaryForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- hamburger spacer -->
            <RowDefinition Height="Auto"/>
            <!-- tab strip -->
            <RowDefinition Height="1"/>
            <!-- divider -->
            <RowDefinition Height="*"/>
            <!-- page content -->
        </Grid.RowDefinitions>

        <!-- ── TAB STRIP ─────────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{DynamicResource ModuleBackgroundBrush}"
                Padding="16,0">
            <ItemsControl ItemsSource="{Binding Pages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="3"/>
                            </Grid.RowDefinitions>

                            <!-- tab button -->
                            <Button Grid.Row="0"
                                    Content="{Binding TabTitle}"
                                    Tag="{Binding TabIcon}"
                                    Command="{Binding DataContext.SelectTabCommand,
                                              RelativeSource={RelativeSource
                                                  AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource TabButtonStyle}">
                                        <Style.Triggers>
                                            <!-- active tab: accent foreground + bold -->
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding
                                                        Converter="{StaticResource ReferenceEqualityConverter}">
                                                        <Binding Path="DataContext.ActivePage"
                                                                 RelativeSource="{RelativeSource
                                                                     AncestorType=UserControl}"/>
                                                        <Binding Path="."/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight"
                                                        Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- underline indicator -->
                            <Border Grid.Row="1" CornerRadius="2,2,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding
                                                        Converter="{StaticResource ReferenceEqualityConverter}">
                                                        <Binding Path="DataContext.ActivePage"
                                                                 RelativeSource="{RelativeSource
                                                                     AncestorType=UserControl}"/>
                                                        <Binding Path="."/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ── divider ───────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{DynamicResource SecondaryForegroundBrush}"
                Opacity="0.12"/>

        <!-- ── active page content ───────────────────────────────────── -->
        <ContentPresenter Grid.Row="3"
                          Content="{Binding ActivePage}"/>
    </Grid>
</UserControl>