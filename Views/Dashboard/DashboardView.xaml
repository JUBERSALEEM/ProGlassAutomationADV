<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/DashboardView.xaml
     PROJECT: ProGlassAutomation

     DASHBOARD WORKSPACE — top module bar, full-width content.

     LAYOUT
     ──────
       row 0   command bar : module identity · segmented module picker ·
                             user + refresh time
       row 1   hairline divider
       row 2   the active module's dashboard, full window width

     WHY THIS SHAPE
     ──────────────
     The previous version put the modules in a 230px left rail. On a
     1366px screen that is 17% of the window spent permanently on seven
     labels, and the app ALREADY has a vertical sidebar one level up —
     so the workspace showed two stacked vertical navigations, which is
     what made it feel cramped and repetitive.

     Modules now sit in a single horizontal segmented control. Seven
     short labels fit comfortably on one line, the content pane gets the
     entire window width, and the workspace no longer competes with the
     app's own sidebar.

     A segmented control (one bordered track, selected pill inside)
     rather than free-floating tabs: it reads as "pick one of these
     seven", which is exactly the relationship, and it keeps the seven
     items visually bound together instead of scattered across the top.

     BEHAVIOUR IS UNCHANGED
     Same Pages collection, same SelectTabCommand, same ActivePage, same
     ReferenceEqualityConverter for selection. Clicking a module sets
     ActivePage; its setter calls LoadAsync() on that page; the
     ContentPresenter swaps to the matching DataTemplate. No ViewModel
     change was needed for this layout.

     ICONS  Segoe MDL2 Assets only, from each page's TabIcon.
     THEME  every brush is a DynamicResource, so this follows a runtime
            Light/Dark swap.
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DashboardView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Dashboard"
             xmlns:vmJo="clr-namespace:ProGlassAutomation.ViewModels.Dashboard.JobOrder.JoDashboard"
             xmlns:vmDn="clr-namespace:ProGlassAutomation.ViewModels.Dashboard.DeliveryNote.DnDashboard"
             xmlns:vmTi="clr-namespace:ProGlassAutomation.ViewModels.Dashboard.TaxInvoice.TiDashboard"
             xmlns:vmSt="clr-namespace:ProGlassAutomation.ViewModels.Dashboard.Statement"
             xmlns:ov="clr-namespace:ProGlassAutomation.Views.Dashboard.Overview"
             xmlns:ss="clr-namespace:ProGlassAutomation.Views.Dashboard.SheetStore"
             xmlns:pi="clr-namespace:ProGlassAutomation.Views.Dashboard.ProformaInvoice"
             xmlns:jo="clr-namespace:ProGlassAutomation.Views.Dashboard.JobOrder.JoDashboard"
             xmlns:dn="clr-namespace:ProGlassAutomation.Views.Dashboard.DeliveryNote.DnDashboard"
             xmlns:ti="clr-namespace:ProGlassAutomation.Views.Dashboard.TaxInvoice.TiDashboard"
             xmlns:st="clr-namespace:ProGlassAutomation.Views.Dashboard.Statement"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnLoaded">

    <UserControl.Resources>

        <!-- VM → View mapping. The ContentPresenter uses these to swap
             content when ActivePage changes; no code-behind navigation. -->
        <DataTemplate DataType="{x:Type vm:OverviewDashboardViewModel}">
            <ov:OverviewDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SheetStoreDashboardViewModel}">
            <ss:SheetStoreDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PiDashboardViewModel}">
            <pi:PiDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmJo:JoDashboardViewModel}">
            <jo:JoDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmDn:DnDashboardViewModel}">
            <dn:DnDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmTi:TiDashboardViewModel}">
            <ti:TiDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSt:StDashboardViewModel}">
            <st:StDashboardView/>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════
             MODULE SEGMENT

             One item in the segmented picker. Selection is decided by
             comparing this page with DashboardViewModel.ActivePage
             through ReferenceEquality — the same mechanism the previous
             layouts used, so there is still no IsSelected flag on the
             page classes to keep in sync.

             The selected segment is marked by a filled pill AND a
             bolder label AND a filled icon, not colour alone.
        ═══════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="ModuleSegmentTemplate">
            <Button Command="{Binding DataContext.SelectTabCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Margin="1,0"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}"
                    ToolTip="{Binding TabSubtitle}"
                    AutomationProperties.Name="{Binding TabTitle}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill"
                                Background="Transparent"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="10,7"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="Label"
                                       Text="{Binding TabTitle}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover, only when this is not the active module -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver,
                                               RelativeSource={RelativeSource Self}}"
                                               Value="True"/>
                                    <Condition Value="False">
                                        <Condition.Binding>
                                            <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}">
                                                <Binding Path="DataContext.ActivePage"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                <Binding Path="."/>
                                            </MultiBinding>
                                        </Condition.Binding>
                                    </Condition>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Pill" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                                <Setter TargetName="Label" Property="Foreground"
                                        Value="{DynamicResource PrimaryForegroundBrush}"/>
                            </MultiDataTrigger>

                            <!-- Active module -->
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}">
                                        <Binding Path="DataContext.ActivePage"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        <Binding Path="."/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="Pill" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Label" Property="Foreground"
                                        Value="{DynamicResource OnAccentForegroundBrush}"/>
                                <Setter TargetName="Label" Property="FontWeight"
                                        Value="Bold"/>
                            </DataTrigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- command bar -->
            <RowDefinition Height="1"/>
            <!-- divider -->
            <RowDefinition Height="*"/>
            <!-- active module -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             COMMAND BAR
        ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="16,12,16,11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- active module identity -->
                <ColumnDefinition Width="*"/>
                <!-- module picker -->
                <ColumnDefinition Width="Auto"/>
                <!-- user + refreshed -->
            </Grid.ColumnDefinitions>

            <!-- ── Active module subtitle ───────────────────────────
                 Only the DESCRIPTION lives here. The module NAME is
                 already shown, bold and filled, by the selected segment
                 immediately to the right, so repeating it wasted ~205px
                 and pushed the picker into a scrollbar at 1366px. -->
            <TextBlock Grid.Column="0"
                       Text="{Binding ActivePage.TabSubtitle}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="2,0,18,0"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="190"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>

            <!-- ── Segmented module picker ──────────────────────────────
                 Horizontally scrollable so a narrow window or a future
                 eighth module degrades into a scroll rather than
                 clipping the last segment. -->
            <Border Grid.Column="1"
                    Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Focusable="False"
                              FocusVisualStyle="{x:Null}">
                    <ItemsControl ItemsSource="{Binding Pages}"
                                  ItemTemplate="{StaticResource ModuleSegmentTemplate}"
                                  KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ── Signed-in user + last refresh ────────────────────── -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">

                <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="9,5"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        ToolTip="Last refresh of the active module">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                        <TextBlock Text="{Binding ActivePage.LastRefreshed}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="7,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="22"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,8,0">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding CurrentUserDisplay}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="150"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="1" Background="{DynamicResource BorderBrush}"/>

        <!-- ═══════════════════════════════════════════════════════════
             ACTIVE MODULE — full window width
        ═══════════════════════════════════════════════════════════ -->
        <ContentPresenter Grid.Row="2"
                          Content="{Binding ActivePage}"/>
    </Grid>
</UserControl>
