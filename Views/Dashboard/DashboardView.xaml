<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/DashboardView.xaml
     PROJECT: ProGlassAutomation

     CHANGES vs PREVIOUS VERSION (Chat 16):
       Added StDashboard namespace xmlns:st
       Added DataTemplate mapping StDashboardViewModel → StDashboardView
       All other markup UNCHANGED.
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Dashboard"
             xmlns:vmJo="clr-namespace:ProGlassAutomation.ViewModels.Dashboard.JobOrder.JoDashboard"
             xmlns:vmDn="clr-namespace:ProGlassAutomation.ViewModels.Dashboard.DeliveryNote.DnDashboard"
             xmlns:vmTi="clr-namespace:ProGlassAutomation.ViewModels.Dashboard.TaxInvoice.TiDashboard"
             xmlns:vmSt="clr-namespace:ProGlassAutomation.ViewModels.Dashboard.Statement"
             xmlns:ov="clr-namespace:ProGlassAutomation.Views.Dashboard.Overview"
             xmlns:ss="clr-namespace:ProGlassAutomation.Views.Dashboard.SheetStore"
             xmlns:pi="clr-namespace:ProGlassAutomation.Views.Dashboard.ProformaInvoice"
             xmlns:jo="clr-namespace:ProGlassAutomation.Views.Dashboard.JobOrder.JoDashboard"
             xmlns:dn="clr-namespace:ProGlassAutomation.Views.Dashboard.DeliveryNote.DnDashboard"
             xmlns:ti="clr-namespace:ProGlassAutomation.Views.Dashboard.TaxInvoice.TiDashboard"
             xmlns:st="clr-namespace:ProGlassAutomation.Views.Dashboard.Statement"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnLoaded">

    <UserControl.Resources>

        <!-- ═══════════════════════════════════════════════════════════════
             VM → View mappings for the 7 sub-dashboards
             Chat 15: Added TiDashboard mapping (6th tab)
             Chat 16: Added StDashboard mapping (7th tab)
        ═══════════════════════════════════════════════════════════════ -->
        <DataTemplate DataType="{x:Type vm:OverviewDashboardViewModel}">
            <ov:OverviewDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SheetStoreDashboardViewModel}">
            <ss:SheetStoreDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PiDashboardViewModel}">
            <pi:PiDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmJo:JoDashboardViewModel}">
            <jo:JoDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmDn:DnDashboardViewModel}">
            <dn:DnDashboardView/>
        </DataTemplate>

        <!-- Chat 15: Tax Invoice dashboard tab -->
        <DataTemplate DataType="{x:Type vmTi:TiDashboardViewModel}">
            <ti:TiDashboardView/>
        </DataTemplate>

        <!-- Chat 16 NEW: Statement dashboard tab -->
        <DataTemplate DataType="{x:Type vmSt:StDashboardViewModel}">
            <st:StDashboardView/>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════════
             TAB BUTTON — icon + label, hover + press + active states
             UNCHANGED from previous version
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="24,16"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           FontSize="14"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                                <Setter TargetName="Label" Property="Foreground"
                                        Value="{DynamicResource PrimaryForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tab strip -->
            <RowDefinition Height="1"/>
            <!-- Divider -->
            <RowDefinition Height="*"/>
            <!-- Active sub-view -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             TAB STRIP — auto-generates a tab button for every page in Pages
             The 7th tab (Statements 📊) appears automatically because
             StDashboardVM is added to DashboardViewModel.Pages.
        ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource ModuleBackgroundBrush}"
                Padding="16,0">
            <ItemsControl ItemsSource="{Binding Pages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="3"/>
                            </Grid.RowDefinitions>

                            <!-- Tab button -->
                            <Button Grid.Row="0"
                                    Content="{Binding TabTitle}"
                                    Tag="{Binding TabIcon}"
                                    Command="{Binding DataContext.SelectTabCommand,
                                              RelativeSource={RelativeSource
                                                  AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource TabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding
                                                        Converter="{StaticResource ReferenceEqualityConverter}">
                                                        <Binding Path="DataContext.ActivePage"
                                                                 RelativeSource="{RelativeSource
                                                                     AncestorType=UserControl}"/>
                                                        <Binding Path="."/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight"
                                                        Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Active indicator bar -->
                            <Border Grid.Row="1" CornerRadius="2,2,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"
                                                Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding
                                                        Converter="{StaticResource ReferenceEqualityConverter}">
                                                        <Binding Path="DataContext.ActivePage"
                                                                 RelativeSource="{RelativeSource
                                                                     AncestorType=UserControl}"/>
                                                        <Binding Path="."/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Divider under tabs -->
        <Border Grid.Row="1"
                Background="{DynamicResource BorderBrush}"/>

        <!-- Active sub-dashboard — ContentPresenter auto-selects
             the correct DataTemplate based on the VM type -->
        <ContentPresenter Grid.Row="2"
                          Content="{Binding ActivePage}"/>
    </Grid>
</UserControl>