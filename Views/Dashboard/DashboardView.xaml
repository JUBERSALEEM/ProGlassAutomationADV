<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.15" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="IconBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="10,10,10,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,90,30,30">

                <!-- Header -->
                <StackPanel Margin="10,0,10,20">
                    <TextBlock Text="{Binding WelcomeMessage}"
                               FontSize="30" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="Here's what's happening in your business today"
                               FontSize="14" Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <!-- Stat Cards Row -->
                <UniformGrid Rows="1" Columns="4">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource IconBadgeStyle}">
                                <TextBlock Text="&#128200;" FontSize="22"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Style="{StaticResource StatValueStyle}" Margin="0,14,0,0"
                                       Text="{Binding TotalSales, StringFormat='₹ {0:N0}'}"/>
                            <TextBlock Text="Total Sales" Style="{StaticResource StatLabelStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource IconBadgeStyle}" Background="#10B981">
                                <TextBlock Text="&#128221;" FontSize="22"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Style="{StaticResource StatValueStyle}" Margin="0,14,0,0"
                                       Text="{Binding InvoiceCount}"/>
                            <TextBlock Text="Invoices" Style="{StaticResource StatLabelStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource IconBadgeStyle}" Background="#F59E0B">
                                <TextBlock Text="&#128101;" FontSize="22"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Style="{StaticResource StatValueStyle}" Margin="0,14,0,0"
                                       Text="{Binding CustomerCount}"/>
                            <TextBlock Text="Customers" Style="{StaticResource StatLabelStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource IconBadgeStyle}" Background="#EF4444">
                                <TextBlock Text="&#9888;" FontSize="22"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Style="{StaticResource StatValueStyle}" Margin="0,14,0,0"
                                       Text="{Binding PendingCount}"/>
                            <TextBlock Text="Pending Invoices" Style="{StaticResource StatLabelStyle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Recent Invoices -->
                <TextBlock Text="Recent Invoices" Style="{StaticResource SectionTitleStyle}" Margin="10,25,10,6"/>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <!-- Invoice List (visible when invoices exist) -->
                        <ItemsControl ItemsSource="{Binding ProformaVM.Invoices}"
                                      Visibility="{Binding ProformaVM.HasInvoices, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,10">
                                        <DockPanel>
                                            <TextBlock Text="&#128221;" FontSize="18"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                    <Run Text="{Binding InvoiceNo}"/>
                                                    <Run Text=" — "/>
                                                    <Run Text="{Binding CustomerName}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Date}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       Text="{Binding Amount, StringFormat='₹ {0:N0}'}"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State (visible when no invoices) -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,30">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProformaVM.HasInvoices}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#128196;"
                                       FontSize="48"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Opacity="0.5"/>
                            <TextBlock Text="No invoices yet"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Head to Proforma Invoice module to create your first invoice"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>