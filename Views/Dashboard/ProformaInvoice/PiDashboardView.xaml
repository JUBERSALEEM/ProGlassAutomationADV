<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/ProformaInvoice/PiDashboardView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Proforma Invoice Dashboard (Chat 23 v2.4)
     VERSION: Chat 23 v2.4 — Ambient in cached Canvas (JoDashboard parity)

     CHANGES vs v2.3:
       ✓ Ambient LinearGradient moved from Grid.Background INTO the
         BitmapCached Canvas as base Rectangle → single cached bitmap
       ✓ Grid.Background = cheap solid color #F5F9FF (fallback)
       ✓ Same optimization as OverviewDashboardView v2.5

     PRESERVED (zero regression):
       • All bindings, VM unchanged
       • All v2.3 shadow removal
       • SmoothScrollBehavior settings
       • Visual output IDENTICAL
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Dashboard.ProformaInvoice.PiDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

    </UserControl.Resources>

    <!-- Grid solid fallback + ambient painted inside cached Canvas -->
    <Grid Background="{DynamicResource ModuleBackgroundBrush}">

        <Canvas Panel.ZIndex="0"
                IsHitTestVisible="False"
                CacheMode="BitmapCache">
            <Rectangle Fill="{DynamicResource DashAmbientBrush}"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
            <Rectangle Fill="{DynamicResource DashAmbientBlob1Brush}"
                       RenderOptions.EdgeMode="Aliased"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
            <Rectangle Fill="{DynamicResource DashAmbientBlob2Brush}"
                       RenderOptions.EdgeMode="Aliased"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
        </Canvas>

        <ScrollViewer Panel.ZIndex="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      IsDeferredScrollingEnabled="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="14,12,14,14">

                <StackPanel Margin="6,0,6,10">
                    <TextBlock Text="Proforma Invoice Analytics"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource DashAccentTextBrush}"/>
                    <TextBlock Text="Monitor invoice status, top customers, and revenue distribution."
                               FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <Border Visibility="{Binding IsLoading,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="12" Margin="6,0,6,8">
                    <TextBlock Text="Loading invoice data…"
                               FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource DashAccentTextBrush}"/>
                </Border>

                <Border Visibility="{Binding HasError,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{DynamicResource TintRedBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Padding="14,12" Margin="6,0,6,8">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12" TextWrapping="Wrap" FontWeight="Bold"/>
                </Border>

                <TextBlock Text="Invoice Overview" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Summary of your Proforma Invoice activity" Style="{StaticResource SectionSubtitle}"/>

                <ItemsControl ItemsSource="{Binding KpiCards}"
                              ItemTemplate="{StaticResource KpiTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="Status Distribution"
                           Style="{StaticResource SectionTitle}"
                           Margin="6,14,6,6"/>
                <TextBlock Text="How your invoices are distributed across statuses"
                           Style="{StaticResource SectionSubtitle}"/>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel Visibility="{Binding HasChartData,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <trend:TrendChartControl
                                Height="150"
                                Points="{Binding StatusBars}"
                                SeriesKind="Bar"
                                EmptyMessage="Invoice count by status — no data yet."
                                SeriesBrush="{DynamicResource AccentBrush}"
                                GridBrush="{DynamicResource DividerBrush}"
                                LabelBrush="{DynamicResource MutedForegroundBrush}"/>

                            <Border Height="1" Margin="0,4,0,0"
                                    Background="{DynamicResource TintIndigoBrush}"/>

                            <TextBlock Text="Invoice count by status"
                                       FontSize="11" HorizontalAlignment="Right"
                                       Margin="0,10,4,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="0,26"
                                    Visibility="{Binding HasChartData,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       HorizontalAlignment="Center" Opacity="0.4"/>
                            <TextBlock Text="No invoices yet"
                                       FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{DynamicResource DashAccentTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Top 5 Customers"
                           Style="{StaticResource SectionTitle}"
                           Margin="6,14,6,6"/>
                <TextBlock Text="Ranked by total invoice value"
                           Style="{StaticResource SectionSubtitle}"/>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel Visibility="{Binding HasChartData,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <trend:TrendChartControl
                                Height="150"
                                Points="{Binding TopCustomerBars}"
                                SeriesKind="Bar"
                                ValuePrefix="AED "
                                EmptyMessage="Revenue by customer — no data yet."
                                SeriesBrush="{DynamicResource AccentBrush}"
                                GridBrush="{DynamicResource DividerBrush}"
                                LabelBrush="{DynamicResource MutedForegroundBrush}"/>

                            <Border Height="1" Margin="0,4,0,0"
                                    Background="{DynamicResource TintIndigoBrush}"/>

                            <TextBlock Text="Total AED value · VAT inclusive"
                                       FontSize="11" HorizontalAlignment="Right"
                                       Margin="0,10,4,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="0,26"
                                    Visibility="{Binding HasChartData,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       HorizontalAlignment="Center" Opacity="0.4"/>
                            <TextBlock Text="No customer data yet"
                                       FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{DynamicResource DashAccentTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding LastRefreshed}"
                           FontSize="11" Opacity="0.6" Margin="12,16,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>