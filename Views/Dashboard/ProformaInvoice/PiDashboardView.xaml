<UserControl x:Class="ProGlassAutomation.Views.Dashboard.ProformaInvoice.PiDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"   Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding"      Value="22"/>
            <Setter Property="Margin"       Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0"
                                      Opacity="0.09" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="8,0,8,6"/>
        </Style>

        <!-- KPI card -->
        <DataTemplate x:Key="KpiTemplate">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="11"
                            HorizontalAlignment="Left"
                            Background="{Binding BadgeColor,
                                         Converter={StaticResource ColorStringConverter}}">
                        <TextBlock Text="{Binding Icon}" FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding DisplayValue}"
                               FontSize="26" FontWeight="Bold" Margin="0,10,0,0"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding Title}"
                               FontSize="12" FontWeight="Medium" Margin="0,3,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <TextBlock Text="{Binding SubLabel}"
                               FontSize="11" Margin="0,2,0,0" Opacity="0.65"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- bar DataTemplate — shared for status + customers -->
        <DataTemplate x:Key="BarTemplate">
            <Grid Margin="6,0" Width="80">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" VerticalAlignment="Bottom" Height="140">
                    <TextBlock Text="{Binding ValueDisplay}"
                               FontSize="9" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,0,0,4" Opacity="0.7"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <Border CornerRadius="5,5,0,0"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Background="{Binding BarColor,
                                         Converter={StaticResource ColorStringConverter}}"
                            Height="{Binding NormalizedHeight,
                                     Converter={StaticResource ScaleConverter},
                                     ConverterParameter=130}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighlight}" Value="True">
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="14"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.40"
                                                                  Color="#6366F1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding Label}"
                           FontSize="10" FontWeight="Medium"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="76"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,20,22,40">

            <!-- loading -->
            <Border Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="12" Margin="8,0,8,12">
                <TextBlock Text="⏳  Loading invoice data…" FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

            <!-- error -->
            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FEE2E2" CornerRadius="10"
                    Padding="14" Margin="8,0,8,12">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#991B1B" FontSize="13" TextWrapping="Wrap"/>
            </Border>

            <!-- ── KPI CARDS ──────────────────────────────────────────── -->
            <TextBlock Text="Proforma Invoice Overview"
                       Style="{StaticResource SectionTitle}"/>
            <ItemsControl ItemsSource="{Binding KpiCards}"
                          ItemTemplate="{StaticResource KpiTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ── STATUS DISTRIBUTION CHART ─────────────────────────── -->
            <TextBlock Text="Invoice Status Distribution"
                       Style="{StaticResource SectionTitle}"
                       Margin="8,28,8,6"/>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <StackPanel Visibility="{Binding HasChartData,
                                             Converter={StaticResource BoolToVisibilityConverter}}">

                        <ItemsControl ItemsSource="{Binding StatusBars}"
                                      ItemTemplate="{StaticResource BarTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Height="1" Margin="0,2,0,0"
                                Background="{DynamicResource SecondaryForegroundBrush}"
                                Opacity="0.15"/>

                        <TextBlock Text="Invoice count by status"
                                   FontSize="10" Opacity="0.5"
                                   HorizontalAlignment="Right"
                                   Margin="0,8,4,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                Margin="0,40"
                                Visibility="{Binding HasChartData,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="📄" FontSize="40"
                                   HorizontalAlignment="Center" Opacity="0.35"/>
                        <TextBlock Text="No invoices yet"
                                   FontSize="14" HorizontalAlignment="Center"
                                   Margin="0,10,0,4"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── TOP CUSTOMERS CHART ────────────────────────────────── -->
            <TextBlock Text="Top 5 Customers by Invoice Value"
                       Style="{StaticResource SectionTitle}"
                       Margin="8,28,8,6"/>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <StackPanel Visibility="{Binding HasChartData,
                                             Converter={StaticResource BoolToVisibilityConverter}}">

                        <ItemsControl ItemsSource="{Binding TopCustomerBars}"
                                      ItemTemplate="{StaticResource BarTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Height="1" Margin="0,2,0,0"
                                Background="{DynamicResource SecondaryForegroundBrush}"
                                Opacity="0.15"/>

                        <TextBlock Text="Total invoice value in AED · VAT inclusive"
                                   FontSize="10" Opacity="0.5"
                                   HorizontalAlignment="Right"
                                   Margin="0,8,4,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                Margin="0,40"
                                Visibility="{Binding HasChartData,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="👥" FontSize="40"
                                   HorizontalAlignment="Center" Opacity="0.35"/>
                        <TextBlock Text="No customer data yet"
                                   FontSize="14" HorizontalAlignment="Center"
                                   Margin="0,10,0,4"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- last refreshed -->
            <TextBlock Text="{Binding LastRefreshed}"
                       FontSize="11" Opacity="0.5" Margin="10,12,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>