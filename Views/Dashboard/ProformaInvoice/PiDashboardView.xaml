<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/ProformaInvoice/PiDashboardView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Proforma Invoice Dashboard (Chat 23 v2.4)
     VERSION: Chat 23 v2.4 — Ambient in cached Canvas (JoDashboard parity)

     CHANGES vs v2.3:
       ✓ Ambient LinearGradient moved from Grid.Background INTO the
         BitmapCached Canvas as base Rectangle → single cached bitmap
       ✓ Grid.Background = cheap solid color #F5F9FF (fallback)
       ✓ Same optimization as OverviewDashboardView v2.5

     PRESERVED (zero regression):
       • All bindings, VM unchanged
       • All v2.3 shadow removal
       • SmoothScrollBehavior settings
       • Visual output IDENTICAL
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Dashboard.ProformaInvoice.PiDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <LinearGradientBrush x:Key="AmbientBg"
                             StartPoint="0,0" EndPoint="1,1"
                             po:Freeze="True">
            <GradientStop Color="#E8F0FE" Offset="0.0"/>
            <GradientStop Color="#DBE7F9" Offset="0.5"/>
            <GradientStop Color="#C7D9F0" Offset="1.0"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="Blob1"
                             Center="0.85,0.10"
                             GradientOrigin="0.85,0.10"
                             RadiusX="0.4" RadiusY="0.4"
                             po:Freeze="True">
            <GradientStop Color="#3B82F640" Offset="0.0"/>
            <GradientStop Color="#3B82F600" Offset="1.0"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="Blob2"
                             Center="0.10,0.85"
                             GradientOrigin="0.10,0.85"
                             RadiusX="0.35" RadiusY="0.35"
                             po:Freeze="True">
            <GradientStop Color="#1E40AF30" Offset="0.0"/>
            <GradientStop Color="#1E40AF00" Offset="1.0"/>
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="CardBgGradient"
                             StartPoint="0,0" EndPoint="0,1"
                             po:Freeze="True">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#F4F8FE" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardBorderBrush"
                         Color="#C4D6ED"
                         po:Freeze="True"/>

        <SolidColorBrush x:Key="AccentTextDeep"
                         Color="#1E3A8A"
                         po:Freeze="True"/>
        <SolidColorBrush x:Key="AccentText"
                         Color="#1E40AF"
                         po:Freeze="True"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource CardBgGradient}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Padding"         Value="24"/>
            <Setter Property="Margin"          Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="TintedCardStyle" TargetType="Border">
            <Setter Property="Background"
                    Value="{Binding TintColor,
                            Converter={StaticResource BrushKeyConverter}}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="Padding"         Value="20"/>
            <Setter Property="Margin"          Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentTextDeep}"/>
            <Setter Property="Margin"     Value="8,0,8,6"/>
        </Style>

        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin"     Value="8,0,8,10"/>
        </Style>

        <DataTemplate x:Key="KpiTemplate">
            <Border Style="{StaticResource TintedCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="10"
                                SnapsToDevicePixels="True"
                                Background="{Binding BadgeColor,
                                             Converter={StaticResource BrushKeyConverter}}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Icon}" FontSize="20"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DisplayValue}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,14,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SubLabel}"
                               FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BarTemplate">
            <Grid Margin="8,0" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" VerticalAlignment="Bottom" Height="180">
                    <TextBlock Text="{Binding ValueDisplay}"
                               FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,0,0,4"
                               Foreground="{StaticResource AccentTextDeep}"/>
                    <Border Width="70"
                            CornerRadius="6,6,0,0"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            SnapsToDevicePixels="True"
                            Background="{Binding BarColor,
                                         Converter={StaticResource ColorStringConverter}}"
                            Height="{Binding NormalizedHeight,
                                     Converter={StaticResource ScaleConverter},
                                     ConverterParameter=160}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighlight}" Value="True">
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="BorderBrush" Value="#1D4ED8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding Label}"
                           FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="90"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <!-- Grid solid fallback + ambient painted inside cached Canvas -->
    <Grid Background="#F5F9FF">

        <Canvas Panel.ZIndex="0"
                IsHitTestVisible="False"
                CacheMode="BitmapCache">
            <Rectangle Fill="{StaticResource AmbientBg}"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
            <Rectangle Fill="{StaticResource Blob1}"
                       RenderOptions.EdgeMode="Aliased"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
            <Rectangle Fill="{StaticResource Blob2}"
                       RenderOptions.EdgeMode="Aliased"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
        </Canvas>

        <ScrollViewer Panel.ZIndex="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      IsDeferredScrollingEnabled="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="24,16,24,24">

                <StackPanel Margin="8,0,8,20">
                    <TextBlock Text="Proforma Invoice Analytics"
                               FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource AccentTextDeep}"/>
                    <TextBlock Text="Monitor invoice status, top customers, and revenue distribution."
                               FontSize="13" Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <Border Visibility="{Binding IsLoading,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="12" Margin="8,0,8,12">
                    <TextBlock Text="⏳  Loading invoice data…"
                               FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentText}"/>
                </Border>

                <Border Visibility="{Binding HasError,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{DynamicResource TintRedBrush}"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="14" Margin="8,0,8,12">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#991B1B"
                               FontSize="12" TextWrapping="Wrap" FontWeight="Bold"/>
                </Border>

                <TextBlock Text="Invoice Overview" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Summary of your Proforma Invoice activity" Style="{StaticResource SectionSubtitle}"/>

                <ItemsControl ItemsSource="{Binding KpiCards}"
                              ItemTemplate="{StaticResource KpiTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="Status Distribution"
                           Style="{StaticResource SectionTitle}"
                           Margin="8,24,8,6"/>
                <TextBlock Text="How your invoices are distributed across statuses"
                           Style="{StaticResource SectionSubtitle}"/>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel Visibility="{Binding HasChartData,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding StatusBars}"
                                          ItemTemplate="{StaticResource BarTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Border Height="1" Margin="0,4,0,0"
                                    Background="#DBE7F9"/>

                            <TextBlock Text="Invoice count by status"
                                       FontSize="11" HorizontalAlignment="Right"
                                       Margin="0,10,4,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="0,50"
                                    Visibility="{Binding HasChartData,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="📄" FontSize="48"
                                       HorizontalAlignment="Center" Opacity="0.4"/>
                            <TextBlock Text="No invoices yet"
                                       FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{StaticResource AccentTextDeep}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Top 5 Customers"
                           Style="{StaticResource SectionTitle}"
                           Margin="8,24,8,6"/>
                <TextBlock Text="Ranked by total invoice value"
                           Style="{StaticResource SectionSubtitle}"/>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel Visibility="{Binding HasChartData,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding TopCustomerBars}"
                                          ItemTemplate="{StaticResource BarTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Border Height="1" Margin="0,4,0,0"
                                    Background="#DBE7F9"/>

                            <TextBlock Text="Total AED value · VAT inclusive"
                                       FontSize="11" HorizontalAlignment="Right"
                                       Margin="0,10,4,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="0,50"
                                    Visibility="{Binding HasChartData,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="👥" FontSize="48"
                                       HorizontalAlignment="Center" Opacity="0.4"/>
                            <TextBlock Text="No customer data yet"
                                       FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{StaticResource AccentTextDeep}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding LastRefreshed}"
                           FontSize="11" Opacity="0.6" Margin="12,16,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>