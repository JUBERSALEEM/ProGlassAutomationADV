<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/Statement/StDashboardView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Account Statement / Sales Report (Chat 16)

     PURPOSE:
       Dashboard tab view for the Statement module.
       Mirrors TiDashboardView pattern (Chat 15).
       Layout:
         Row 0: KPI cards (4)
         Row 1: Quick actions bar
         Row 2: Recent statements list (virtualized)
         Row 3: Empty state (when no statements)

     PERFORMANCE:
       No DropShadowEffect on list items.
       Virtualized ItemsControl (not ListView) for recent items.
       SmoothScrollBehavior on scroll.
       TextOptions set on root.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl
    x:Class="ProGlassAutomation.Views.Dashboard.Statement.StDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextHintingMode="Fixed"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- KPI cards -->
            <RowDefinition Height="Auto"/>
            <!-- Quick actions -->
            <RowDefinition Height="Auto"/>
            <!-- Section heading -->
            <RowDefinition Height="*"/>
            <!-- Recent list / empty state -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             ROW 0 — KPI CARDS
        ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="24,20,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Statements -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    CornerRadius="12"
                    Padding="18,16">
                <StackPanel>
                    <TextBlock Text="📋  STATEMENTS"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalStatements}"
                               FontSize="32" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="Total saved"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Total Invoiced -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    CornerRadius="12"
                    Padding="18,16">
                <StackPanel>
                    <TextBlock Text="💰  TOTAL INVOICED"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalInvoicedDisplay}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TintIndigoBrush}"
                               Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Across all statements"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Outstanding -->
            <Border Grid.Column="4"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    CornerRadius="12"
                    Padding="18,16">
                <StackPanel>
                    <TextBlock Text="⏳  OUTSTANDING"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalOutstandingDisplay}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TintAmberBrush}"
                               Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Total balance due"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Overdue (red when active) -->
            <Border Grid.Column="6"
                    CornerRadius="12"
                    Padding="18,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"
                                Value="{DynamicResource SideMenuBackgroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOverdue}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource TintRedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="🔴  OVERDUE"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding OverdueAmountDisplay}"
                               FontSize="18" FontWeight="Bold"
                               Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource MutedForegroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOverdue}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="#B91C1C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Past due date"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             ROW 1 — QUICK ACTIONS
        ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Margin="24,16,24,0"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                CornerRadius="10"
                Padding="16,12">
            <StackPanel Orientation="Horizontal">

                <!-- New Statement -->
                <Button Content="+ New Statement"
                        Command="{Binding NewStatementCommand}"
                        Height="38" Padding="18,0"
                        FontSize="12" FontWeight="Bold"
                        Cursor="Hand"
                        Foreground="White"
                        BorderThickness="0"
                        Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"
                                    Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="9"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="bd"
                                                        Property="Opacity"
                                                        Value="0.88"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- View All Statements -->
                <Button Content="View All Statements →"
                        Command="{Binding GoToStatementsCommand}"
                        Height="38" Padding="18,0"
                        FontSize="12" FontWeight="SemiBold"
                        Cursor="Hand"
                        Foreground="{DynamicResource AccentBrush}"
                        Background="Transparent"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource AccentBrush}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             ROW 2 — SECTION HEADING
        ══════════════════════════════════════════════════════════ -->
        <TextBlock Grid.Row="2"
                   Text="RECENT STATEMENTS"
                   FontSize="10" FontWeight="Bold"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Margin="24,16,24,8"/>

        <!-- ══════════════════════════════════════════════════════════
             ROW 3 — RECENT LIST / EMPTY STATE / LOADING
        ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="24,0,24,16">

            <!-- Loading -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsLoading,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="⏳"
                           FontSize="32"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Loading…"
                           FontSize="13"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="📊"
                           FontSize="48"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="No Statements Yet"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,4"/>
                <TextBlock Text="Generate your first account statement from the Sales Report module."
                           FontSize="12"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="320"/>
                <Button Content="+ New Statement"
                        Command="{Binding NewStatementCommand}"
                        Height="38" Padding="20,0"
                        Margin="0,16,0,0"
                        FontSize="12" FontWeight="Bold"
                        Cursor="Hand"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Recent statements list (virtualized ItemsControl) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          behaviors:SmoothScrollBehavior.IsEnabled="True"
                          Visibility="{Binding HasStatements,
                              Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl
                    ItemsSource="{Binding RecentStatements}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SideMenuBackgroundBrush}"
                                    CornerRadius="10"
                                    Padding="14,12"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: info -->
                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center">

                                        <!-- Number + subtitle -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Text="{Binding StatementNumber}"
                                                FontSize="13" FontWeight="Bold"
                                                Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock
                                                Text=" — "
                                                FontSize="13"
                                                Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock
                                                Text="{Binding SubTitle}"
                                                FontSize="13" FontWeight="SemiBold"
                                                Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                MaxWidth="260"
                                                TextTrimming="CharacterEllipsis"/>
                                            <!-- Attachment badge -->
                                            <Border Margin="8,0,0,0"
                                                    Background="{DynamicResource TintIndigoBrush}"
                                                    CornerRadius="5"
                                                    Padding="5,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasAttachments,
                                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="📎"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Financials row -->
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,4,0,0">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource MutedForegroundBrush}">
                                                <Run Text="Invoiced: "/>
                                                <Run Text="{Binding TotalInvoicedDisplay}"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            </TextBlock>
                                            <TextBlock Text="  ·  " FontSize="11"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource MutedForegroundBrush}">
                                                <Run Text="Outstanding: "/>
                                                <Run Text="{Binding OutstandingDisplay}"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource TintAmberBrush}"/>
                                            </TextBlock>
                                            <!-- Overdue indicator -->
                                            <TextBlock Text="  ·  " FontSize="11"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       Visibility="{Binding HasOverdue,
                                                           Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock FontSize="11"
                                                       Visibility="{Binding HasOverdue,
                                                           Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Run Text="⚠ Overdue: "/>
                                                <Run Text="{Binding OverdueDisplay}"
                                                     FontWeight="Bold"
                                                     Foreground="#B91C1C"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Meta row -->
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   Margin="0,3,0,0">
                                            <Run Text="{Binding InvoiceCount}"/>
                                            <Run Text=" invoice(s)  ·  "/>
                                            <Run Text="{Binding CreatedAtDisplay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Right: Open PDF button -->
                                    <Button Grid.Column="1"
                                            Content="📄 PDF"
                                            Command="{Binding DataContext.OpenPdfCommand,
                                                RelativeSource={RelativeSource
                                                    AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Height="32" Padding="12,0"
                                            FontSize="11" FontWeight="SemiBold"
                                            Cursor="Hand"
                                            IsEnabled="{Binding HasPdf}"
                                            Foreground="{DynamicResource AccentBrush}"
                                            Background="{DynamicResource TintIndigoBrush}"
                                            BorderThickness="0"
                                            VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}"
                                                        Opacity="{TemplateBinding IsEnabled,
                                                            Converter={StaticResource ScaleConverter}}">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="bd"
                                                                Property="Opacity"
                                                                Value="0.8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>