<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/Statement/StDashboardView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Account Statement Dashboard

     SOFT-CARD REDESIGN — the reference dashboard markup supplied by the
     user, applied identically across all 7 dashboards. The look lives
     in Styles/DashboardStyles.xaml (Soft* keys).

     WHAT THIS REPLACES
     ──────────────────
     This file previously carried its own PrimaryButtonStyle,
     OutlineButtonStyle, PdfChipButtonStyle and three DropShadowEffects,
     plus a header comment asserting that "DynamicResource brush
     resolution is FAILING for this view". That claim was wrong: the
     brushes it blamed (DashAmbient*, DashGlass*) are declared in BOTH
     Themes/LightTheme.xaml and Themes/DarkTheme.xaml — verified, 51
     keys, identical key sets. The real cause of the original symptom
     was the ambient gradient sitting behind translucent glass cards.
     Nothing here needs an inline-hex workaround, so the private styles
     are gone and the shared Soft* keys are used.

     KPI CARDS ARE HAND-BUILT HERE ON PURPOSE
     ────────────────────────────────────────
     Unlike the other six dashboards, StDashboardViewModel exposes four
     SCALAR properties (TotalStatements, TotalInvoicedDisplay,
     TotalOutstandingDisplay, OverdueAmountDisplay) rather than an
     ObservableCollection of KpiCardModel. Introducing a collection
     would mean editing the ViewModel, which is out of scope for a
     styling pass, so the four cards are written out using the same
     Soft* primitives. They are pixel-identical to the templated ones.

     DEVIATIONS FROM THE PASTED REFERENCE, EACH FORCED
     ─────────────────────────────────────────────────
       1. DynamicResource colour, not hardcoded hex.
       2. TrendChartControl over LiveChartsCore (not referenced; NuGet
          unreachable from the sandbox). This page has no chart data.
       3. Segoe MDL2 glyphs, never emoji — the old "＋  New Statement"
          fullwidth plus and "→" arrows are now proper glyphs.

     BINDINGS — UNCHANGED. NO VIEWMODEL WAS EDITED.
       TotalStatements, TotalInvoicedDisplay, TotalOutstandingDisplay,
       OverdueAmountDisplay, HasOverdue, HasStatements, IsLoading,
       IsEmpty, RecentStatements, NewStatementCommand,
       GoToStatementsCommand, OpenPdfCommand
     Item bindings: Index, StatementNumber, SubTitle, HasAttachments,
       TotalInvoicedDisplay, OutstandingDisplay, OverdueDisplay,
       HasOverdue, InvoiceCount, CreatedAtDisplay, HasPdf
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Dashboard.Statement.StDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             STATEMENT ROW
        ═══════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="StStatementRowTemplate">
            <Border Margin="0,0,0,8"
                    Padding="12,10"
                    CornerRadius="12"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource TintGrayBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Serial disc -->
                    <Border Grid.Column="0"
                            Width="34" Height="34"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="{Binding Index, Mode=OneWay}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatementNumber, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       MaxWidth="150"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text=" · "
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="{Binding SubTitle, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       MaxWidth="260"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                            <Border Margin="10,0,0,0"
                                    CornerRadius="6"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True"
                                    Background="{DynamicResource InfoBrush}"
                                    ToolTip="Has attachments"
                                    Visibility="{Binding HasAttachments,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="&#xE723;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                <Run Text="Invoiced: "/>
                                <Run Text="{Binding TotalInvoicedDisplay, Mode=OneWay}"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </TextBlock>

                            <TextBlock Text=" · "
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>

                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                <Run Text="Outstanding: "/>
                                <Run Text="{Binding OutstandingDisplay, Mode=OneWay}"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource WarningBrush}"/>
                            </TextBlock>

                            <TextBlock Text=" · "
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Visibility="{Binding HasOverdue,
                                           Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock FontSize="11"
                                       Visibility="{Binding HasOverdue,
                                           Converter={StaticResource BoolToVisibilityConverter}}">
                                <Run Text="Overdue: "
                                     Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <Run Text="{Binding OverdueDisplay, Mode=OneWay}"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource DangerBrush}"/>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock FontSize="10"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}">
                            <Run Text="{Binding InvoiceCount, Mode=OneWay}"/>
                            <Run Text=" invoice(s) · "/>
                            <Run Text="{Binding CreatedAtDisplay, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="PDF"
                            Tag="&#xE8A5;"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SoftPillButtonStyle}"
                            ToolTip="Open the statement PDF"
                            Command="{Binding DataContext.OpenPdfCommand,
                                      RelativeSource={RelativeSource
                                          AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding HasPdf}"/>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <StackPanel Margin="24">

                <!-- HERO -->
                <Border Style="{StaticResource SoftHeroStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Statements"
                                       Style="{StaticResource SoftHeroTitleStyle}"/>
                            <TextBlock Text="Customer balances, outstanding value and collection risk"
                                       Style="{StaticResource SoftHeroSubtitleStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource SoftChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource SuccessBrush}"/>
                                    <TextBlock Text="Live"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding LastRefreshed}"
                                       Style="{StaticResource SoftMetaStyle}"
                                       HorizontalAlignment="Right"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ACTIONS -->
                <Border Style="{StaticResource SoftSectionStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Quick actions"
                                   Style="{StaticResource SoftSectionTitleStyle}"
                                   VerticalAlignment="Center"/>

                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                            <Button Content="New Statement"
                                    Tag="&#xE710;"
                                    Style="{StaticResource SoftPillAccentStyle}"
                                    ToolTip="Create a new account statement"
                                    Command="{Binding NewStatementCommand}"/>
                            <Button Content="View All Statements"
                                    Tag="&#xE8FD;"
                                    Margin="0"
                                    Style="{StaticResource SoftPillButtonStyle}"
                                    ToolTip="Open the statements list"
                                    Command="{Binding GoToStatementsCommand}"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════
                     KPI ROW — four scalar cards (see header note).
                ═══════════════════════════════════════════════════ -->
                <TextBlock Text="Statement Overview"
                           Style="{StaticResource SoftGroupHeadingStyle}"/>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total statements -->
                    <Border Grid.Column="0"
                            Style="{StaticResource SoftCardStyle}"
                            Margin="0,0,10,0">
                        <Grid>
                            <StackPanel Margin="0,0,48,0">
                                <TextBlock Text="Total Statements"
                                           Style="{StaticResource SoftKpiLabelStyle}"/>
                                <Viewbox HorizontalAlignment="Left"
                                         Stretch="Uniform"
                                         StretchDirection="DownOnly"
                                         Margin="0,8,0,4">
                                    <TextBlock Text="{Binding TotalStatements}"
                                               Style="{StaticResource SoftKpiValueStyle}"
                                               Margin="0"/>
                                </Viewbox>
                                <TextBlock Text="Generated to date"
                                           Style="{StaticResource SoftKpiFootStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource SoftBadgeStyle}"
                                    Background="{DynamicResource AccentBrush}">
                                <TextBlock Text="&#xE9D9;"
                                           Style="{StaticResource SoftBadgeGlyphStyle}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Total invoiced -->
                    <Border Grid.Column="1"
                            Style="{StaticResource SoftCardStyle}"
                            Margin="10,0,10,0">
                        <Grid>
                            <StackPanel Margin="0,0,48,0">
                                <TextBlock Text="Total Invoiced"
                                           Style="{StaticResource SoftKpiLabelStyle}"/>
                                <Viewbox HorizontalAlignment="Left"
                                         Stretch="Uniform"
                                         StretchDirection="DownOnly"
                                         Margin="0,8,0,4">
                                    <TextBlock Text="{Binding TotalInvoicedDisplay}"
                                               Style="{StaticResource SoftKpiValueStyle}"
                                               Margin="0"/>
                                </Viewbox>
                                <TextBlock Text="Across all statements"
                                           Style="{StaticResource SoftKpiFootStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource SoftBadgeStyle}"
                                    Background="{DynamicResource InfoBrush}">
                                <TextBlock Text="&#xE8EF;"
                                           Style="{StaticResource SoftBadgeGlyphStyle}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Outstanding -->
                    <Border Grid.Column="2"
                            Style="{StaticResource SoftCardStyle}"
                            Margin="10,0,10,0">
                        <Grid>
                            <StackPanel Margin="0,0,48,0">
                                <TextBlock Text="Outstanding"
                                           Style="{StaticResource SoftKpiLabelStyle}"/>
                                <Viewbox HorizontalAlignment="Left"
                                         Stretch="Uniform"
                                         StretchDirection="DownOnly"
                                         Margin="0,8,0,4">
                                    <TextBlock Text="{Binding TotalOutstandingDisplay}"
                                               Style="{StaticResource SoftKpiValueStyle}"
                                               Margin="0"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                </Viewbox>
                                <TextBlock Text="Awaiting payment"
                                           Style="{StaticResource SoftKpiFootStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource SoftBadgeStyle}"
                                    Background="{DynamicResource WarningBrush}">
                                <TextBlock Text="&#xE823;"
                                           Style="{StaticResource SoftBadgeGlyphStyle}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Overdue — cap and badge turn red only when there IS
                         overdue value, so the colour carries meaning. -->
                    <Border Grid.Column="3"
                            Style="{StaticResource SoftCardStyle}"
                            Margin="10,0,0,0">
                        <Grid>
                            <StackPanel Margin="0,0,48,0">
                                <TextBlock Text="Overdue"
                                           Style="{StaticResource SoftKpiLabelStyle}"/>
                                <Viewbox HorizontalAlignment="Left"
                                         Stretch="Uniform"
                                         StretchDirection="DownOnly"
                                         Margin="0,8,0,4">
                                    <TextBlock Text="{Binding OverdueAmountDisplay}"
                                               Margin="0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource SoftKpiValueStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Viewbox>
                                <TextBlock Text="Past payment terms"
                                           Style="{StaticResource SoftKpiFootStyle}"/>
                            </StackPanel>

                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border"
                                           BasedOn="{StaticResource SoftBadgeStyle}">
                                        <Setter Property="Background"
                                                Value="{DynamicResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="&#xE7BA;"
                                           Style="{StaticResource SoftBadgeGlyphStyle}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════
                     RECENT STATEMENTS
                ═══════════════════════════════════════════════════ -->
                <Border Style="{StaticResource SoftSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="Recent Statements"
                                   Style="{StaticResource SoftSectionTitleStyle}"/>
                        <TextBlock Text="Most recently generated statements"
                                   Style="{StaticResource SoftSectionSubtitleStyle}"/>

                        <!-- LOADING -->
                        <Border Padding="0,40"
                                Visibility="{Binding IsLoading,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE895;"
                                           Style="{StaticResource DashEmptyStateGlyphStyle}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Loading statements…"
                                           Style="{StaticResource DashEmptyStateTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- EMPTY -->
                        <Border Padding="0,40"
                                Visibility="{Binding IsEmpty,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE9D9;"
                                           Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                <TextBlock Text="No statements yet"
                                           Style="{StaticResource DashEmptyStateTextStyle}"/>
                                <TextBlock Text="Generate a statement to see customer balances here."
                                           Style="{StaticResource SoftMetaStyle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,14"/>
                                <Button Content="New Statement"
                                        Tag="&#xE710;"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource SoftPillAccentStyle}"
                                        ToolTip="Create a new account statement"
                                        Command="{Binding NewStatementCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- LIST -->
                        <ItemsControl ItemsSource="{Binding RecentStatements}"
                                      ItemTemplate="{StaticResource StStatementRowTemplate}"
                                      Visibility="{Binding HasStatements,
                                          Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
