<!-- Indigo Studio: production dashboard; original data and navigation contracts retained. -->
<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    xmlns:layout="clr-namespace:ProGlassAutomation.Views.Dashboard"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="ProGlassAutomation.Views.Dashboard.Statement.StDashboardView"
    TextOptions.TextHintingMode="Fixed"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    Foreground="{DynamicResource Ov.Ink}"
    Background="{DynamicResource Ov.Canvas}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../IndigoDashboardResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="StStatementRowTemplate">
                <Border
                    Background="Transparent"
                    BorderBrush="{DynamicResource Ov.Line}"
                    BorderThickness="0,1,0,0"
                    Padding="{DynamicResource Ds.RowPadding}"
                    SnapsToDevicePixels="True">
                    <layout:IndigoDashboardPanel MaxColumns="2" MinimumColumnWidth="140" FirstColumnWeight="4" Gap="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="34"
                                Height="34"
                                CornerRadius="{DynamicResource Ds.TileRadius}"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"
                                Background="{DynamicResource Ov.Soft}"
                                BorderBrush="{DynamicResource Ov.Line}"
                                BorderThickness="1">
                                <TextBlock
                                    Text="{Binding Index, Mode=OneWay}"
                                    FontSize="{DynamicResource Ds.FontCardSub}"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Ov.Accent}"
                                    TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <WrapPanel>
                                    <TextBlock
                                        Text="{Binding StatementNumber, Mode=OneWay}"
                                        FontSize="{DynamicResource Ds.FontCardSub}"
                                        FontWeight="SemiBold"
                                        MaxWidth="150"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource Ov.Ink}"
                                        ToolTip="{Binding StatementNumber, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text=" · "
                                        FontSize="{DynamicResource Ds.FontCardSub}"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource Ov.Muted}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{Binding SubTitle, Mode=OneWay}"
                                        FontSize="{DynamicResource Ds.FontCardSub}"
                                        FontWeight="SemiBold"
                                        MaxWidth="260"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource Ov.Ink}"
                                        ToolTip="{Binding SubTitle, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Border
                                        Margin="10,0,0,0"
                                        CornerRadius="{StaticResource Ds.ChipRadius}"
                                        Padding="7,3"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True"
                                        Background="{DynamicResource Ov.Soft}"
                                        ToolTip="{DynamicResource Dashboard.Attachments}"
                                        Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock
                                            Text="&#xE723;"
                                            FontFamily="{DynamicResource FontFamily.Icon}"
                                            FontSize="{DynamicResource Ds.FontBodySm}"
                                            Foreground="{DynamicResource Ov.Accent}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </WrapPanel>
                                <WrapPanel Margin="0,6,0,0">
                                    <TextBlock
                                        FontSize="{DynamicResource Ds.FontBodySm}"
                                        Foreground="{DynamicResource Ov.Muted}"
                                        TextWrapping="Wrap">
                                        <Run Text="{DynamicResource Common.Invoiced}" />
                                        <Run
                                            Text="{Binding TotalInvoicedDisplay, Mode=OneWay}"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Ov.Ink}" />
                                    </TextBlock>
                                    <TextBlock
                                        Text=" · "
                                        FontSize="{DynamicResource Ds.FontBodySm}"
                                        Foreground="{DynamicResource Ov.Muted}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="{DynamicResource Ds.FontBodySm}"
                                        Foreground="{DynamicResource Ov.Muted}"
                                        TextWrapping="Wrap">
                                        <Run Text="{DynamicResource Common.Outstanding}" />
                                        <Run
                                            Text="{Binding OutstandingDisplay, Mode=OneWay}"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Ov.Warning}" />
                                    </TextBlock>
                                    <TextBlock
                                        Text=" · "
                                        FontSize="{DynamicResource Ds.FontBodySm}"
                                        Foreground="{DynamicResource Ov.Muted}"
                                        Visibility="{Binding HasOverdue, Converter={StaticResource BoolToVisibilityConverter}}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="{DynamicResource Ds.FontBodySm}"
                                        Foreground="{DynamicResource Ov.Muted}"
                                        Visibility="{Binding HasOverdue, Converter={StaticResource BoolToVisibilityConverter}}"
                                        TextWrapping="Wrap">
                                        <Run Text="{DynamicResource Common.Overdue}" />
                                        <Run
                                            Text="{Binding OverdueDisplay, Mode=OneWay}"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Ov.Danger}" />
                                    </TextBlock>
                                </WrapPanel>
                                <TextBlock
                                    FontSize="{DynamicResource Ds.FontBodySm}"
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource Ov.Muted}"
                                    TextWrapping="Wrap">
                                    <Run Text="{Binding InvoiceCount, Mode=OneWay}" />
                                    <Run Text="{DynamicResource Dashboard.InvoiceS}" />
                                    <Run Text="{Binding CreatedAtDisplay, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <WrapPanel VerticalAlignment="Center">
                            <Button
                                Content="PDF"
                                Tag="&#xE8A5;"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Ds.BtnGhostStyle}"
                                ToolTip="{DynamicResource Dashboard.OpenStatementPDF}"
                                Command="{Binding DataContext.OpenPdfCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding HasPdf}" />
                            <Button
                                Content="&#xE72D;"
                                FontFamily="{DynamicResource FontFamily.Icon}"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Ds.BtnGhostStyle}"
                                ToolTip="{DynamicResource Sharing.Share}"
                                Command="{Binding DataContext.ShareCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding HasPdf}" />
                        </WrapPanel>
                    </layout:IndigoDashboardPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            CanContentScroll="False"
            PanningMode="VerticalOnly"
            Focusable="False"
            FocusVisualStyle="{x:Null}"
            Background="Transparent"
            behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="{DynamicResource Ds.PageMargin}">
                <layout:IndigoDashboardPanel Margin="0,0,0,8" MaxColumns="2" MinimumColumnWidth="390" FirstColumnWeight="1" Gap="20">
                    <StackPanel>
                        <TextBlock
                            Text="{DynamicResource Dashboard.Statements}"
                            Style="{StaticResource Ds.HeroTitleStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{DynamicResource Dashboard.CustomerBalancesOutstandingValueCollection}"
                            Style="{StaticResource Ds.HeroSubStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <Border Style="{StaticResource Ds.LiveChipStyle}" Margin="0,0,10,0">
                            <TextBlock Text="Snapshot" Style="{StaticResource Ds.LiveTextStyle}" />
                        </Border>
                        <TextBlock
                            Text="{Binding LastRefreshed}"
                            Style="{StaticResource Ds.MetaStyle}"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0"
                            TextWrapping="Wrap" />
                        <Button
                            Content="{DynamicResource Dashboard.NewStatement}"
                            Tag="&#xE710;"
                            Style="{StaticResource Ds.BtnPrimaryStyle}"
                            Command="{Binding NewStatementCommand}"
                            ToolTip="{DynamicResource Dashboard.GenerateNewCustomerStatement}" />
                        <Button
                            Content="{DynamicResource Dashboard.View}"
                            Tag="&#xE8FD;"
                            Margin="0"
                            Style="{StaticResource Ds.BtnGhostStyle}"
                            Command="{Binding GoToStatementsCommand}"
                            ToolTip="{DynamicResource Dashboard.ViewGeneratedStatements}" />
                    </WrapPanel>
                </layout:IndigoDashboardPanel>
                <StackPanel>
                    <Border
                        Style="{StaticResource Ds.StateBandStyle}"
                        Background="{DynamicResource Ov.Soft}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Ds.SkeletonCircleStyle}" Width="20" Height="20" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource Ds.SkeletonBlockStyle}" Height="12" Width="180" HorizontalAlignment="Left" />
                                <Border
                                    Style="{StaticResource Ds.SkeletonBlockStyle}"
                                    Height="8"
                                    Width="260"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Left"
                                    Opacity="0.5" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border
                        Style="{StaticResource Ds.StateBandStyle}"
                        Background="{DynamicResource Ov.DangerSoft}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Ds.ErrorTextStyle}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource Ds.SkeletonBandStyle}">
                        <StackPanel>
                            <Border
                                Style="{StaticResource Ds.SkeletonBlockStyle}"
                                Height="16"
                                Width="120"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,4" />
                            <Border
                                Style="{StaticResource Ds.SkeletonBlockStyle}"
                                Height="10"
                                Width="200"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12"
                                Opacity="0.5" />
                            <ItemsControl
                                Style="{StaticResource Ds.SkeletonKpiBandStyle}"
                                ItemsPanel="{StaticResource Ds.SkeletonKpiBandPanel}">
                                <ContentControl ContentTemplate="{StaticResource Ds.SkeletonKpiTileTemplate}" />
                                <ContentControl ContentTemplate="{StaticResource Ds.SkeletonKpiTileTemplate}" />
                                <ContentControl ContentTemplate="{StaticResource Ds.SkeletonKpiTileTemplate}" />
                                <ContentControl ContentTemplate="{StaticResource Ds.SkeletonKpiTileTemplate}" />
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <layout:IndigoDashboardPanel Margin="0,0,0,16" MaxColumns="2" MinimumColumnWidth="340" FirstColumnWeight="1.45">
                        <Border Style="{StaticResource Ds.SkeletonCardStyle}">
                            <ContentControl ContentTemplate="{StaticResource Ds.SkeletonChartTemplate}" />
                        </Border>
                        <Border Style="{StaticResource Ds.SkeletonCardStyle}">
                            <StackPanel>
                                <Border
                                    Style="{StaticResource Ds.SkeletonBlockStyle}"
                                    Height="14"
                                    Width="90"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,6" />
                                <Border
                                    Style="{StaticResource Ds.SkeletonBlockStyle}"
                                    Height="10"
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,16"
                                    Opacity="0.5" />
                                <Grid Height="158">
                                    <Border
                                        Style="{StaticResource Ds.SkeletonCircleStyle}"
                                        Width="110"
                                        Height="110"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </layout:IndigoDashboardPanel>
                    <layout:IndigoDashboardPanel MaxColumns="2" MinimumColumnWidth="340" FirstColumnWeight="1">
                        <Border Style="{StaticResource Ds.SkeletonCardStyle}">
                            <ContentControl ContentTemplate="{StaticResource Ds.SkeletonChartTemplate}" />
                        </Border>
                        <Border Style="{StaticResource Ds.SkeletonCardStyle}">
                            <StackPanel>
                                <Border
                                    Style="{StaticResource Ds.SkeletonBlockStyle}"
                                    Height="14"
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12" />
                                <ContentControl ContentTemplate="{StaticResource Ds.SkeletonFeedRowTemplate}" />
                                <ContentControl ContentTemplate="{StaticResource Ds.SkeletonFeedRowTemplate}" />
                                <ContentControl ContentTemplate="{StaticResource Ds.SkeletonFeedRowTemplate}" />
                            </StackPanel>
                        </Border>
                    </layout:IndigoDashboardPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource Ds.Content}">
                    <StackPanel Margin="0,0,0,10" Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Border Margin="0,0,0,10" Background="Transparent" BorderThickness="0" Padding="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock
                                        Text="{DynamicResource Dashboard.StatementPulse}"
                                        Style="{StaticResource Ds.CardTitleStyle}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{DynamicResource Dashboard.StatementsInvoicedOutstandingOverdue}"
                                        Style="{StaticResource Ds.CardSubStyle}"
                                        Margin="0,1,0,0"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ItemsControl
                                    Style="{StaticResource Ds.KpiBandStyle}"
                                    ItemsSource="{Binding KpiCards}"
                                    ItemTemplate="{StaticResource Ds.KpiTileTemplate}"
                                    ItemsPanel="{StaticResource Ds.KpiBandPanel}" />
                            </DockPanel>
                        </Border>
                        <layout:IndigoDashboardPanel MaxColumns="2" MinimumColumnWidth="360">
                            <Border Style="{StaticResource Ds.CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Balance snapshot" Style="{StaticResource Ds.CardTitleStyle}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="Amounts shown independently · overdue is included in outstanding"
                                        Style="{StaticResource Ds.CardSubStyle}"
                                        Margin="0,1,0,6"
                                        TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding BalanceMixSlices}" ItemTemplate="{StaticResource Ds.BalanceTemplate}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Ds.CardStyle}" Padding="16,12">
                                <Grid>
                                    <Border
                                        Style="{StaticResource Ds.AlertBarStyle}"
                                        Background="{DynamicResource Ov.Danger}"
                                        Visibility="{Binding HasOverdue, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock
                                            Text="{DynamicResource Common.Overdue}"
                                            Style="{StaticResource Ds.StatLabelStyle}"
                                            TextWrapping="Wrap" />
                                        <Viewbox HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,8,0,4">
                                            <TextBlock Text="{Binding OverdueAmountDisplay}" Margin="0" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Ds.StatValueStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Ov.Danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Viewbox>
                                        <TextBlock
                                            Text="{DynamicResource Dashboard.PastPaymentTerms}"
                                            Style="{StaticResource Ds.StatFootStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </layout:IndigoDashboardPanel>
                    </StackPanel>
                    <Border
                        Style="{StaticResource Ds.CardStyle}"
                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                        Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Top"
                                Text="{DynamicResource Dashboard.RecentStatements}"
                                Style="{StaticResource Ds.CardTitleStyle}"
                                Margin="0,0,0,8"
                                TextWrapping="Wrap" />
                            <Border
                                Padding="0,40"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Ds.EmptyGlyphStyle}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{DynamicResource Dashboard.NoStatementsYet}"
                                        Style="{StaticResource Ds.EmptyTextStyle}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{DynamicResource Dashboard.GenerateStatementSeeCustomerBalancesHere}"
                                        Style="{StaticResource Ds.MetaStyle}"
                                        HorizontalAlignment="Center"
                                        Margin="0,6,0,14"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Content="{DynamicResource Dashboard.NewStatement}"
                                        Tag="&#xE710;"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource Ds.BtnPrimaryStyle}"
                                        Command="{Binding NewStatementCommand}"
                                        ToolTip="{DynamicResource Dashboard.GenerateNewCustomerStatement}" />
                                </StackPanel>
                            </Border>
                            <ScrollViewer
                                VerticalScrollBarVisibility="Auto"
                                MaxHeight="400"
                                behaviors:SmartScrollBubblingBehavior.IsEnabled="True"
                                HorizontalScrollBarVisibility="Disabled"
                                Visibility="{Binding HasStatements, Converter={StaticResource BoolToVisibilityConverter}}"
                                behaviors:SmoothScrollBehavior.IsEnabled="True">
                                <ItemsControl
                                    Style="{StaticResource Ds.FeedItemsStyle}"
                                    ItemsSource="{Binding RecentStatements}"
                                    ItemTemplate="{StaticResource StStatementRowTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <TextBlock
                        Text="Saved statement snapshots, not a cash ledger. Overdue is included in outstanding; collected is inferred from snapshot totals."
                        Style="{StaticResource Ov.Meta}"
                        Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
