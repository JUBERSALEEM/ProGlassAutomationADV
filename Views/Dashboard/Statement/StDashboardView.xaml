<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/Statement/StDashboardView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Account Statement Dashboard

     LAYOUT-03 BENTO MOSAIC — Statements. Scalar KPI bindings and row template unchanged. The look lives
     in Styles/DashboardStyles.xaml (Soft* keys).

     WHAT THIS REPLACES
     ──────────────────
     This file previously carried its own PrimaryButtonStyle,
     OutlineButtonStyle, PdfChipButtonStyle and three DropShadowEffects,
     plus a header comment asserting that "DynamicResource brush
     resolution is FAILING for this view". That claim was wrong: the
     brushes it blamed (DashAmbient*, DashLiquid*) are declared in BOTH
     Themes/LightTheme.xaml and Themes/DarkTheme.xaml — verified, 51
     keys, identical key sets. The real cause of the original symptom
     was the ambient gradient sitting behind translucent glass cards.
     Nothing here needs an inline-hex workaround, so the private styles
     are gone and the shared Soft* keys are used.

     KPI CARDS USE THE SHARED TEMPLATE (Aug 2026)
     ────────────────────────────────────────────
     StDashboardViewModel now exposes a KpiCards ObservableCollection of
     KpiCardModel, built from the four scalar KPIs, so this page renders
     through the SAME SoftKpiCardTemplate as every other module dashboard
     — no more hand-written scalar cards. The scalar display properties
     (TotalInvoicedDisplay etc.) are retained for the summary text/rows.

     DEVIATIONS FROM THE PASTED REFERENCE, EACH FORCED
     ─────────────────────────────────────────────────
       1. DynamicResource colour, not hardcoded hex.
       2. TrendChartControl over LiveChartsCore (not referenced; NuGet
          unreachable from the sandbox). This page has no chart data.
       3. Segoe MDL2 glyphs, never emoji — the old "＋  New Statement"
          fullwidth plus and "→" arrows are now proper glyphs.

     BINDINGS — UNCHANGED. NO VIEWMODEL WAS EDITED.
       TotalStatements, TotalInvoicedDisplay, TotalOutstandingDisplay,
       OverdueAmountDisplay, HasOverdue, HasStatements, IsLoading,
       IsEmpty, RecentStatements, NewStatementCommand,
       GoToStatementsCommand, OpenPdfCommand
     Item bindings: Index, StatementNumber, SubTitle, HasAttachments,
       TotalInvoicedDisplay, OutstandingDisplay, OverdueDisplay,
       HasOverdue, InvoiceCount, CreatedAtDisplay, HasPdf
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Dashboard.Statement.StDashboardView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:donut="clr-namespace:ProGlassAutomation.Controls.DonutChart"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             STATEMENT ROW
        ═══════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="StStatementRowTemplate">
            <Border Style="{StaticResource DbRowCardStyle}"
                    Margin="0,0,0,8"
                    Padding="12,10"
                    CornerRadius="{DynamicResource Surface.Primary.CornerRadius}"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource Surface.Primary.BackgroundBrush}"
                    BorderBrush="{DynamicResource Surface.Primary.BorderBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Serial disc -->
                    <Border Grid.Column="0"
                            Width="34" Height="34"
                            CornerRadius="{DynamicResource Surface.Primary.CornerRadius}"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True"
                            Background="{DynamicResource AccentBrush}" Style="{StaticResource SurfacePrimaryStyle}">
                        <TextBlock Text="{Binding Index, Mode=OneWay}"
                                   FontSize="{DynamicResource FontSize.Title}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatementNumber, Mode=OneWay}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       MaxWidth="150"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text=" · "
                                       FontSize="{DynamicResource FontSize.Body}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="{Binding SubTitle, Mode=OneWay}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                       MaxWidth="260"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <Border Margin="10,0,0,0"
                                    CornerRadius="{DynamicResource Surface.Primary.CornerRadius}"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True"
                                    Background="{DynamicResource InfoBrush}"
                                    ToolTip="{DynamicResource Dashboard.Attachments}"
                                    Visibility="{Binding HasAttachments,
                                        Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
                                <TextBlock Text="&#xE723;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                <Run Text="{DynamicResource Common.Invoiced}"/>
                                <Run Text="{Binding TotalInvoicedDisplay, Mode=OneWay}"
                                     FontWeight="{DynamicResource Weight.Bold}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </TextBlock>

                            <TextBlock Text=" · "
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>

                            <TextBlock FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                <Run Text="{DynamicResource Common.Outstanding}"/>
                                <Run Text="{Binding OutstandingDisplay, Mode=OneWay}"
                                     FontWeight="{DynamicResource Weight.Bold}"
                                     Foreground="{DynamicResource WarningBrush}"/>
                            </TextBlock>

                            <TextBlock Text=" · "
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Visibility="{Binding HasOverdue,
                                           Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock FontSize="{DynamicResource FontSize.Body}"
                                       Visibility="{Binding HasOverdue,
                                           Converter={StaticResource BoolToVisibilityConverter}}">
                                <Run Text="{DynamicResource Common.Overdue}"
                                     Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <Run Text="{Binding OverdueDisplay, Mode=OneWay}"
                                     FontWeight="{DynamicResource Weight.Bold}"
                                     Foreground="{DynamicResource DangerBrush}"/>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock FontSize="{DynamicResource FontSize.BodySmall}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}">
                            <Run Text="{Binding InvoiceCount, Mode=OneWay}"/>
                            <Run Text="{DynamicResource Dashboard.InvoiceS}"/>
                            <Run Text="{Binding CreatedAtDisplay, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                  Orientation="Horizontal"
                                  VerticalAlignment="Center">
                        <Button Content="PDF"
                                Tag="&#xE8A5;"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DbActionButtonStyle}"
                                ToolTip="{DynamicResource Dashboard.OpenStatementPDF}"
                                Command="{Binding DataContext.OpenPdfCommand,
                                          RelativeSource={RelativeSource
                                              AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding HasPdf}"/>
                        <Button Content="&#xE72D;"
                                FontFamily="{DynamicResource FontFamily.Icon}"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DbActionButtonStyle}"
                                ToolTip="{DynamicResource Sharing.Share}"
                                Command="{Binding DataContext.ShareCommand,
                                          RelativeSource={RelativeSource
                                              AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding HasPdf}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="{DynamicResource DbPageMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="260"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard.Statements}"
                                   Style="{StaticResource DbTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Dashboard.CustomerBalancesOutstandingValueCollection}"
                                   Style="{StaticResource DbSubtitleStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource DbChipStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{DynamicResource Common.Live}"
                                           FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LastRefreshed}"
                                   Style="{StaticResource DbMetaStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Button Content="{DynamicResource Dashboard.NewStatement}" Tag="&#xE710;"
                                Style="{StaticResource DbActionButtonAccentStyle}"
                                Command="{Binding NewStatementCommand}" ToolTip="{DynamicResource Dashboard.GenerateNewCustomerStatement}"/>
                        <Button Content="{DynamicResource Dashboard.View}" Tag="&#xE8FD;" Margin="0"
                                Style="{StaticResource DbActionButtonStyle}"
                                Command="{Binding GoToStatementsCommand}" ToolTip="{DynamicResource Dashboard.ViewGeneratedStatements}"/>
                    </StackPanel>
                </Grid>

                                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource DbStateBandStyle}"
                            Background="{DynamicResource TintBlueBrush}"
                            BorderBrush="{DynamicResource InfoBrush}"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource DbSkeletonCircleStyle}" Width="20" Height="20" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="12" Width="180" HorizontalAlignment="Left"/>
                                <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="8" Width="260" Margin="0,6,0,0" HorizontalAlignment="Left" Opacity="0.5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource DbStateBandStyle}"
                            Background="{DynamicResource TintRedBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            Visibility="{Binding HasError,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource DbErrorTextStyle}"/>
                    </Border>
                </StackPanel>


                <!-- ── SKELETON (visible when loading) ─────────────── -->
                <StackPanel Grid.Row="2" Grid.RowSpan="3"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">

                    <Border Style="{StaticResource DbSkeletonBandStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="16" Width="120" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                            <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12" Opacity="0.5"/>
                            <ItemsControl Style="{StaticResource DbSkeletonKpiBandStyle}" ItemsPanel="{StaticResource DbSkeletonKpiBandPanel}">
                                <Border Style="{StaticResource DbTileStyle}" Opacity="0.95"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="12" Width="72" HorizontalAlignment="Left"/><Border Grid.Column="1" Style="{StaticResource DbSkeletonCircleStyle}" Width="28" Height="28"/></Grid><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="22" Width="88" Margin="0,14,0,0" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="120" Margin="0,10,0,0" HorizontalAlignment="Left" Opacity="0.4"/></StackPanel></Border>
                                <Border Style="{StaticResource DbTileStyle}"><StackPanel><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="12" Width="72" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="22" Width="88" Margin="0,14,0,0" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="120" Margin="0,10,0,0" HorizontalAlignment="Left" Opacity="0.4"/></StackPanel></Border>
                                <Border Style="{StaticResource DbTileStyle}"><StackPanel><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="12" Width="72" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="22" Width="88" Margin="0,14,0,0" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="120" Margin="0,10,0,0" HorizontalAlignment="Left" Opacity="0.4"/></StackPanel></Border>
                                <Border Style="{StaticResource DbTileStyle}"><StackPanel><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="12" Width="72" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="22" Width="88" Margin="0,14,0,0" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="120" Margin="0,10,0,0" HorizontalAlignment="Left" Opacity="0.4"/></StackPanel></Border>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource DbCardStyle}" Margin="0,0,7,0">
                            <ContentControl ContentTemplate="{StaticResource DbSkeletonChartTemplate}"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource DbCardStyle}" Margin="7,0,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="14" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="120" HorizontalAlignment="Left" Margin="0,0,0,16" Opacity="0.5"/>
                                <Grid Height="158"><Border Style="{StaticResource DbSkeletonCircleStyle}" Width="110" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource DbCardStyle}" Margin="0,0,7,0">
                            <ContentControl ContentTemplate="{StaticResource DbSkeletonChartTemplate}"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource DbCardStyle}" Margin="7,0,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="14" Width="120" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource DbRowCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource DbSkeletonCircleStyle}" Margin="0,0,11,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="13" Width="140" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="180" Margin="0,6,0,0" HorizontalAlignment="Left" Opacity="0.5"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="13" Width="56" HorizontalAlignment="Right"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="16" Width="48" Margin="0,6,0,0" HorizontalAlignment="Right" CornerRadius="{DynamicResource Surface.Primary.CornerRadius}"/></StackPanel></Grid></Border>
                                <Border Style="{StaticResource DbRowCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource DbSkeletonCircleStyle}" Margin="0,0,11,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="13" Width="140" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="180" Margin="0,6,0,0" HorizontalAlignment="Left" Opacity="0.5"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="13" Width="56" HorizontalAlignment="Right"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="16" Width="48" Margin="0,6,0,0" HorizontalAlignment="Right" CornerRadius="{DynamicResource Surface.Primary.CornerRadius}"/></StackPanel></Grid></Border>
                                <Border Style="{StaticResource DbRowCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource DbSkeletonCircleStyle}" Margin="0,0,11,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="13" Width="140" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="180" Margin="0,6,0,0" HorizontalAlignment="Left" Opacity="0.5"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="13" Width="56" HorizontalAlignment="Right"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="16" Width="48" Margin="0,6,0,0" HorizontalAlignment="Right" CornerRadius="{DynamicResource Surface.Primary.CornerRadius}"/></StackPanel></Grid></Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>

                <Grid Grid.Row="2" Margin="0,0,0,20" Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI stat cards — same shared template as every other
                         module dashboard (SoftKpiCardTemplate), built from the
                         KpiCards collection so the Statement page matches the
                         rest of the suite. -->
                    <Border Grid.Column="0" Style="{StaticResource DbCardStyle}"
                            Margin="0,0,18,0" >
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Dashboard.StatementPulse}"
                                           Style="{StaticResource DbSectionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.StatementsInvoicedOutstandingOverdue}"
                                           Style="{StaticResource DbSectionSubStyle}"/>
                            </StackPanel>
                            <ItemsControl Style="{StaticResource DbKpiBandStyle}"
                                          ItemsSource="{Binding KpiCards}"
                                          ItemTemplate="{StaticResource DbKpiTileTemplate}"
                                          ItemsPanel="{StaticResource DbKpiBandPanel}"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DbCardStyle}"
                            Margin="0,0,18,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dashboard.CollectionMix}"
                                       Style="{StaticResource DbSectionTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Dashboard.CollectedVsOutstandingVsOverdue}"
                                       Style="{StaticResource DbSectionSubStyle}"/>
                            <donut:DonutChartControl Height="150"
                                                     Slices="{Binding BalanceMixSlices}"
                                                     HoleLabel="AED"
                                                     EmptyMessage="No statement balances yet."
                                                     Thickness="16"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DbCardStyle}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Common.Overdue}"
                                       Style="{StaticResource DbKpiLabelStyle}"/>
                            <Viewbox HorizontalAlignment="Left" Stretch="Uniform"
                                     StretchDirection="DownOnly" Margin="0,8,0,4">
                                <TextBlock Text="{Binding OverdueAmountDisplay}" Margin="0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource DbKpiValueStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Viewbox>
                            <TextBlock Text="{DynamicResource Dashboard.PastPaymentTerms}"
                                       Style="{StaticResource DbKpiFootStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource DbCardStyle}" Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Dashboard.RecentStatements}"
                                   Style="{StaticResource DbSectionTitleStyle}"
                                   Margin="0,0,0,8"/>

                        <Border Padding="0,40"
                                Visibility="{Binding IsEmpty,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE9D9;"
                                           Style="{StaticResource DbEmptyGlyphStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.NoStatementsYet}"
                                           Style="{StaticResource DbEmptyTextStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.GenerateStatementSeeCustomerBalancesHere}"
                                           Style="{StaticResource DbMetaStyle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,14"/>
                                <Button Content="{DynamicResource Dashboard.NewStatement}"
                                        Tag="&#xE710;"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource DbActionButtonAccentStyle}"
                                        Command="{Binding NewStatementCommand}" ToolTip="{DynamicResource Dashboard.GenerateNewCustomerStatement}"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                            MaxHeight="400"
                            behaviors:SmartScrollBubblingBehavior.IsEnabled="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasStatements,
                                          Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl Style="{StaticResource DbFeedItemsStyle}"
                                          ItemsSource="{Binding RecentStatements}"
                                          ItemTemplate="{StaticResource StStatementRowTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
