<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/Statement/StDashboardView.xaml
     SYSTEM: MERIDIAN — Phase 6 full rewrite (2026-09-18)

     Bindings preserved (NO VIEWMODEL EDITED):
       TotalStatements, TotalInvoicedDisplay, TotalOutstandingDisplay,
       OverdueAmountDisplay, HasOverdue, HasStatements, IsLoading,
       IsEmpty, RecentStatements, KpiCards, BalanceMixSlices,
       LastRefreshed, HasError, ErrorMessage,
       NewStatementCommand, GoToStatementsCommand, OpenPdfCommand,
       ShareCommand (row buttons, via AncestorType=ItemsControl).
     Row item bindings: Index, StatementNumber, SubTitle,
       HasAttachments, TotalInvoicedDisplay, OutstandingDisplay,
       OverdueDisplay, HasOverdue, InvoiceCount, CreatedAtDisplay,
       HasPdf.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Dashboard.Statement.StDashboardView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:donut="clr-namespace:ProGlassAutomation.Controls.DonutChart"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             STATEMENT ROW (Meridian docrow)
        ═══════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="StStatementRowTemplate">
            <Border Background="Transparent"
                    BorderBrush="{DynamicResource PgHairlineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="{DynamicResource PgRowPadding}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Serial disc -->
                    <Border Grid.Column="0"
                            Width="34" Height="34"
                            CornerRadius="{DynamicResource PgTileRadius}"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True"
                            Background="{DynamicResource PgSurface2Brush}"
                            BorderBrush="{DynamicResource PgHairlineBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding Index, Mode=OneWay}"
                                   FontSize="{DynamicResource PgFontCardSub}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PgAccentBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatementNumber, Mode=OneWay}"
                                       FontSize="{DynamicResource PgFontCardSub}"
                                       FontWeight="SemiBold"
                                       MaxWidth="150"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PgText1Brush}"/>
                            <TextBlock Text=" · "
                                       FontSize="{DynamicResource PgFontCardSub}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PgText3Brush}"/>
                            <TextBlock Text="{Binding SubTitle, Mode=OneWay}"
                                       FontSize="{DynamicResource PgFontCardSub}"
                                       FontWeight="SemiBold"
                                       MaxWidth="260"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PgText1Brush}"/>

                            <Border Margin="10,0,0,0"
                                    CornerRadius="{StaticResource PgChipRadius}"
                                    Padding="7,3"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True"
                                    Background="{DynamicResource PgAccentSoftBrush}"
                                    ToolTip="{DynamicResource Dashboard.Attachments}"
                                    Visibility="{Binding HasAttachments,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="&#xE723;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{DynamicResource PgFontBodySm}"
                                           Foreground="{DynamicResource PgAccentBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock FontSize="{DynamicResource PgFontBodySm}"
                                       Foreground="{DynamicResource PgText3Brush}">
                                <Run Text="{DynamicResource Common.Invoiced}"/>
                                <Run Text="{Binding TotalInvoicedDisplay, Mode=OneWay}"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource PgText1Brush}"/>
                            </TextBlock>

                            <TextBlock Text=" · "
                                       FontSize="{DynamicResource PgFontBodySm}"
                                       Foreground="{DynamicResource PgText3Brush}"/>

                            <TextBlock FontSize="{DynamicResource PgFontBodySm}"
                                       Foreground="{DynamicResource PgText3Brush}">
                                <Run Text="{DynamicResource Common.Outstanding}"/>
                                <Run Text="{Binding OutstandingDisplay, Mode=OneWay}"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource PgWarnBrush}"/>
                            </TextBlock>

                            <TextBlock Text=" · "
                                       FontSize="{DynamicResource PgFontBodySm}"
                                       Foreground="{DynamicResource PgText3Brush}"
                                       Visibility="{Binding HasOverdue,
                                           Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock FontSize="{DynamicResource PgFontBodySm}"
                                       Foreground="{DynamicResource PgText3Brush}"
                                       Visibility="{Binding HasOverdue,
                                           Converter={StaticResource BoolToVisibilityConverter}}">
                                <Run Text="{DynamicResource Common.Overdue}"/>
                                <Run Text="{Binding OverdueDisplay, Mode=OneWay}"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource PgDangerBrush}"/>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock FontSize="{DynamicResource PgFontBodySm}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource PgText3Brush}">
                            <Run Text="{Binding InvoiceCount, Mode=OneWay}"/>
                            <Run Text="{DynamicResource Dashboard.InvoiceS}"/>
                            <Run Text="{Binding CreatedAtDisplay, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="PDF"
                                Tag="&#xE8A5;"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource PgBtnGhostStyle}"
                                ToolTip="{DynamicResource Dashboard.OpenStatementPDF}"
                                Command="{Binding DataContext.OpenPdfCommand,
                                          RelativeSource={RelativeSource
                                              AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding HasPdf}"/>
                        <Button Content="&#xE72D;"
                                FontFamily="Segoe MDL2 Assets"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource PgBtnGhostStyle}"
                                ToolTip="{DynamicResource Sharing.Share}"
                                Command="{Binding DataContext.ShareCommand,
                                          RelativeSource={RelativeSource
                                              AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding HasPdf}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="{DynamicResource PgPageMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- hero -->
                    <RowDefinition Height="Auto"/>  <!-- state bands -->
                    <RowDefinition Height="Auto"/>  <!-- KPI + mix + overdue / skeleton -->
                    <RowDefinition Height="*" MinHeight="260"/>  <!-- recent statements -->
                </Grid.RowDefinitions>

                <!-- ══ HERO ═══════════════════════════════════════ -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard.Statements}"
                                   Style="{StaticResource PgHeroTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Dashboard.CustomerBalancesOutstandingValueCollection}"
                                   Style="{StaticResource PgHeroSubStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource PgLiveChipStyle}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource PgOkBrush}"/>
                                <TextBlock Text="{DynamicResource Common.Live}"
                                           Style="{StaticResource PgLiveTextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LastRefreshed}"
                                   Style="{StaticResource PgMetaStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"/>
                        <Button Content="{DynamicResource Dashboard.NewStatement}" Tag="&#xE710;"
                                Style="{StaticResource PgBtnPrimaryStyle}"
                                Command="{Binding NewStatementCommand}"
                                ToolTip="{DynamicResource Dashboard.GenerateNewCustomerStatement}"/>
                        <Button Content="{DynamicResource Dashboard.View}" Tag="&#xE8FD;" Margin="0"
                                Style="{StaticResource PgBtnGhostStyle}"
                                Command="{Binding GoToStatementsCommand}"
                                ToolTip="{DynamicResource Dashboard.ViewGeneratedStatements}"/>
                    </StackPanel>
                </Grid>

                <!-- ══ STATE BANDS ═══════════════════════════════════ -->
                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource PgStateBandStyle}"
                            Background="{DynamicResource PgAccentSoftBrush}"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PgSkeletonCircleStyle}" Width="20" Height="20" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="12" Width="180" HorizontalAlignment="Left"/>
                                <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="8" Width="260" Margin="0,6,0,0" HorizontalAlignment="Left" Opacity="0.5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource PgStateBandStyle}"
                            Background="{DynamicResource PgDangerSoftBrush}"
                            Visibility="{Binding HasError,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource PgErrorTextStyle}"/>
                    </Border>
                </StackPanel>

                <!-- ══ SKELETON (visible while loading) ══════════════ -->
                <StackPanel Grid.Row="2" Grid.RowSpan="2"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource PgSkeletonBandStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="16" Width="120" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                            <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="10" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12" Opacity="0.5"/>
                            <ItemsControl Style="{StaticResource PgSkeletonKpiBandStyle}" ItemsPanel="{StaticResource PgSkeletonKpiBandPanel}">
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonKpiTileTemplate}"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonKpiTileTemplate}"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonKpiTileTemplate}"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonKpiTileTemplate}"/>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PgSkeletonCardStyle}" Margin="0,0,16,0">
                            <ContentControl ContentTemplate="{StaticResource PgSkeletonChartTemplate}"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PgSkeletonCardStyle}" Margin="16,0,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="14" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="10" Width="120" HorizontalAlignment="Left" Margin="0,0,0,16" Opacity="0.5"/>
                                <Grid Height="158"><Border Style="{StaticResource PgSkeletonCircleStyle}" Width="110" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PgSkeletonCardStyle}" Margin="0,0,16,0">
                            <ContentControl ContentTemplate="{StaticResource PgSkeletonChartTemplate}"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PgSkeletonCardStyle}" Margin="16,0,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="14" Width="120" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonFeedRowTemplate}"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonFeedRowTemplate}"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonFeedRowTemplate}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ══ KPI CARDS + COLLECTION MIX + OVERDUE ══════════ -->
                <Grid Grid.Row="2" Margin="0,0,0,16"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PgCardStyle}" Margin="0,0,16,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Dashboard.StatementPulse}"
                                           Style="{StaticResource PgCardTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.StatementsInvoicedOutstandingOverdue}"
                                           Style="{StaticResource PgCardSubStyle}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <ItemsControl Style="{StaticResource PgKpiBandStyle}"
                                          ItemsSource="{Binding KpiCards}"
                                          ItemTemplate="{StaticResource PgKpiTileTemplate}"
                                          ItemsPanel="{StaticResource PgKpiBandPanel}"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PgCardStyle}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dashboard.CollectionMix}"
                                       Style="{StaticResource PgCardTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Dashboard.CollectedVsOutstandingVsOverdue}"
                                       Style="{StaticResource PgCardSubStyle}"
                                       Margin="0,2,0,10"/>
                            <donut:DonutChartControl Height="150"
                                                     Slices="{Binding BalanceMixSlices}"
                                                     HoleLabel="AED"
                                                     EmptyMessage="No statement balances yet."
                                                     Thickness="16"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PgCardStyle}" Padding="16,12">
                        <Grid>
                            <Border Style="{StaticResource PgAlertBarStyle}"
                                    Background="{DynamicResource PgDangerBrush}"
                                    Visibility="{Binding HasOverdue,
                                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="{DynamicResource Common.Overdue}"
                                           Style="{StaticResource PgStatLabelStyle}"/>
                                <Viewbox HorizontalAlignment="Left" Stretch="Uniform"
                                         StretchDirection="DownOnly" Margin="0,8,0,4">
                                    <TextBlock Text="{Binding OverdueAmountDisplay}" Margin="0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource PgStatValueStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource PgDangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Viewbox>
                                <TextBlock Text="{DynamicResource Dashboard.PastPaymentTerms}"
                                           Style="{StaticResource PgStatFootStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══ RECENT STATEMENTS ═════════════════════════════ -->
                <Border Grid.Row="3" Style="{StaticResource PgCardStyle}"
                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Dashboard.RecentStatements}"
                                   Style="{StaticResource PgCardTitleStyle}"
                                   Margin="0,0,0,8"/>

                        <Border Padding="0,40"
                                Visibility="{Binding IsEmpty,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE9D9;"
                                           Style="{StaticResource PgEmptyGlyphStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.NoStatementsYet}"
                                           Style="{StaticResource PgEmptyTextStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.GenerateStatementSeeCustomerBalancesHere}"
                                           Style="{StaticResource PgMetaStyle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,14"/>
                                <Button Content="{DynamicResource Dashboard.NewStatement}"
                                        Tag="&#xE710;"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource PgBtnPrimaryStyle}"
                                        Command="{Binding NewStatementCommand}"
                                        ToolTip="{DynamicResource Dashboard.GenerateNewCustomerStatement}"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      MaxHeight="400"
                                      behaviors:SmartScrollBubblingBehavior.IsEnabled="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasStatements,
                                          Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl Style="{StaticResource PgFeedItemsStyle}"
                                          ItemsSource="{Binding RecentStatements}"
                                          ItemTemplate="{StaticResource StStatementRowTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
