<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/Statement/StDashboardView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Account Statement Dashboard

     LAYOUT-03 BENTO MOSAIC — Statements. Scalar KPI bindings and row template unchanged. The look lives
     in Styles/DashboardStyles.xaml (Soft* keys).

     WHAT THIS REPLACES
     ──────────────────
     This file previously carried its own PrimaryButtonStyle,
     OutlineButtonStyle, PdfChipButtonStyle and three DropShadowEffects,
     plus a header comment asserting that "DynamicResource brush
     resolution is FAILING for this view". That claim was wrong: the
     brushes it blamed (DashAmbient*, DashLiquid*) are declared in BOTH
     Themes/LightTheme.xaml and Themes/DarkTheme.xaml — verified, 51
     keys, identical key sets. The real cause of the original symptom
     was the ambient gradient sitting behind translucent glass cards.
     Nothing here needs an inline-hex workaround, so the private styles
     are gone and the shared Soft* keys are used.

     KPI CARDS USE THE SHARED TEMPLATE (Aug 2026)
     ────────────────────────────────────────────
     StDashboardViewModel now exposes a KpiCards ObservableCollection of
     KpiCardModel, built from the four scalar KPIs, so this page renders
     through the SAME SoftKpiCardTemplate as every other module dashboard
     — no more hand-written scalar cards. The scalar display properties
     (TotalInvoicedDisplay etc.) are retained for the summary text/rows.

     DEVIATIONS FROM THE PASTED REFERENCE, EACH FORCED
     ─────────────────────────────────────────────────
       1. DynamicResource colour, not hardcoded hex.
       2. TrendChartControl over LiveChartsCore (not referenced; NuGet
          unreachable from the sandbox). This page has no chart data.
       3. Segoe MDL2 glyphs, never emoji — the old "＋  New Statement"
          fullwidth plus and "→" arrows are now proper glyphs.

     BINDINGS — UNCHANGED. NO VIEWMODEL WAS EDITED.
       TotalStatements, TotalInvoicedDisplay, TotalOutstandingDisplay,
       OverdueAmountDisplay, HasOverdue, HasStatements, IsLoading,
       IsEmpty, RecentStatements, NewStatementCommand,
       GoToStatementsCommand, OpenPdfCommand
     Item bindings: Index, StatementNumber, SubTitle, HasAttachments,
       TotalInvoicedDisplay, OutstandingDisplay, OverdueDisplay,
       HasOverdue, InvoiceCount, CreatedAtDisplay, HasPdf
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Dashboard.Statement.StDashboardView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:donut="clr-namespace:ProGlassAutomation.Controls.DonutChart"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             STATEMENT ROW
        ═══════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="StStatementRowTemplate">
            <Border Margin="0,0,0,8"
                    Padding="12,10"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource TintGrayBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Serial disc -->
                    <Border Grid.Column="0"
                            Width="34" Height="34"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="{Binding Index, Mode=OneWay}"
                                   FontSize="{StaticResource TextBodyLarge}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatementNumber, Mode=OneWay}"
                                       FontSize="{StaticResource TextBody}"
                                       FontWeight="Bold"
                                       MaxWidth="150"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text=" · "
                                       FontSize="{StaticResource TextBody}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="{Binding SubTitle, Mode=OneWay}"
                                       FontSize="{StaticResource TextBody}"
                                       FontWeight="SemiBold"
                                       MaxWidth="260"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                            <Border Margin="10,0,0,0"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True"
                                    Background="{DynamicResource InfoBrush}"
                                    ToolTip="Has attachments"
                                    Visibility="{Binding HasAttachments,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="&#xE723;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                <Run Text="Invoiced: "/>
                                <Run Text="{Binding TotalInvoicedDisplay, Mode=OneWay}"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </TextBlock>

                            <TextBlock Text=" · "
                                       FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>

                            <TextBlock FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                <Run Text="Outstanding: "/>
                                <Run Text="{Binding OutstandingDisplay, Mode=OneWay}"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource WarningBrush}"/>
                            </TextBlock>

                            <TextBlock Text=" · "
                                       FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Visibility="{Binding HasOverdue,
                                           Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock FontSize="{StaticResource TextBody}"
                                       Visibility="{Binding HasOverdue,
                                           Converter={StaticResource BoolToVisibilityConverter}}">
                                <Run Text="Overdue: "
                                     Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <Run Text="{Binding OverdueDisplay, Mode=OneWay}"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource DangerBrush}"/>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock FontSize="{StaticResource TextCaption}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}">
                            <Run Text="{Binding InvoiceCount, Mode=OneWay}"/>
                            <Run Text=" invoice(s) · "/>
                            <Run Text="{Binding CreatedAtDisplay, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="PDF"
                            Tag="&#xE8A5;"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SoftPillButtonStyle}"
                            ToolTip="Open the statement PDF"
                            Command="{Binding DataContext.OpenPdfCommand,
                                      RelativeSource={RelativeSource
                                          AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding HasPdf}"/>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="20,16,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="300" MinHeight="240"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Statements"
                                   Style="{StaticResource SoftHeroTitleStyle}"/>
                        <TextBlock Text="Customer balances, outstanding value and collection risk"
                                   Style="{StaticResource SoftHeroSubtitleStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource SoftChipStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="Live" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                        <Button Content="New Statement" Tag="&#xE710;"
                                Style="{StaticResource SoftPillAccentStyle}"
                                Command="{Binding NewStatementCommand}"/>
                        <Button Content="View All" Tag="&#xE8FD;" Margin="0"
                                Style="{StaticResource SoftPillButtonStyle}"
                                Command="{Binding GoToStatementsCommand}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource SoftSectionStyle}"
                            Padding="16,12"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Loading statements…"
                                   Style="{StaticResource SoftKpiFootStyle}"/>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI stat cards — same shared template as every other
                         module dashboard (SoftKpiCardTemplate), built from the
                         KpiCards collection so the Statement page matches the
                         rest of the suite. -->
                    <Border Grid.Column="0" Style="{StaticResource SoftCardStyle}"
                            Margin="0,0,18,0" MinHeight="168">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Statement pulse"
                                           Style="{StaticResource SoftSectionTitleStyle}"/>
                                <TextBlock Text="Statements, invoiced, outstanding and overdue"
                                           Style="{StaticResource SoftSectionSubtitleStyle}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding KpiCards}"
                                          ItemTemplate="{StaticResource SoftKpiCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SoftCardStyle}"
                            Margin="0,0,18,0">
                        <StackPanel>
                            <TextBlock Text="Collection mix"
                                       Style="{StaticResource SoftSectionTitleStyle}"/>
                            <TextBlock Text="Collected vs outstanding vs overdue"
                                       Style="{StaticResource SoftSectionSubtitleStyle}"/>
                            <donut:DonutChartControl Height="150"
                                                     Slices="{Binding BalanceMixSlices}"
                                                     HoleLabel="AED"
                                                     EmptyMessage="No statement balances yet."
                                                     Thickness="16"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SoftCardStyle}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="OVERDUE"
                                       Style="{StaticResource SoftKpiLabelStyle}"/>
                            <Viewbox HorizontalAlignment="Left" Stretch="Uniform"
                                     StretchDirection="DownOnly" Margin="0,8,0,4">
                                <TextBlock Text="{Binding OverdueAmountDisplay}" Margin="0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource SoftKpiValueStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Viewbox>
                            <TextBlock Text="Past payment terms"
                                       Style="{StaticResource SoftKpiFootStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource SoftCardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Recent statements"
                                   Style="{StaticResource SoftSectionTitleStyle}"
                                   Margin="0,0,0,8"/>

                        <Border Padding="0,40"
                                Visibility="{Binding IsEmpty,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE9D9;"
                                           Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                <TextBlock Text="No statements yet"
                                           Style="{StaticResource DashEmptyStateTextStyle}"/>
                                <TextBlock Text="Generate a statement to see customer balances here."
                                           Style="{StaticResource SoftMetaStyle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,14"/>
                                <Button Content="New Statement"
                                        Tag="&#xE710;"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource SoftPillAccentStyle}"
                                        Command="{Binding NewStatementCommand}"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasStatements,
                                          Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding RecentStatements}"
                                          ItemTemplate="{StaticResource StStatementRowTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
