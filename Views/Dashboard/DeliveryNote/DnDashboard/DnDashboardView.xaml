<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/DeliveryNote/DnDashboard/DnDashboardView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Delivery Note Dashboard (Chat 23 v2.5)
     VERSION: Chat 23 v2.5 — Industrial Blue + smooth ambient parity

     CHANGES vs previous:
       ✓ Wrapped ScrollViewer in Grid + cached ambient Canvas (v2.5 pattern)
       ✓ CardStyle rebuilt as glass gradient with blue border (no shadow)
       ✓ TintedCardStyle border shifted to industrial blue
       ✓ SectionTitle color: #4338CA → AccentTextDeep (#1E3A8A)
       ✓ Page title 28→30px (design system)
       ✓ PanningMode "None" → "VerticalOnly", Focusable "True" → "False"
       ✓ Preserved the enhanced FeedRowTemplate design (left accent bar,
         tinted circle avatar, qty pill, prominent status pill) —
         this is already better than JoDashboard's feed row, keep it.
       ✓ RenderOptions.EdgeMode="Aliased" on ambient blobs
       ✓ SnapsToDevicePixels on all inner card borders

     PRESERVED (zero regression):
       • ALL bindings (KpiCards, StatusBars, TypeBars, RecentFeed,
         HasStatusData, HasRecentFeed, LastRefreshed, IsLoading, HasError)
       • BrushKeyConverter usage
       • ColorStringConverter + ScaleConverter usage
       • Enhanced feed row structure (5-column grid: accent/icon/info/qty/status)
       • All 3 empty state panels
       • SmoothScrollBehavior
       • Error state (hardcoded text — VM doesn't expose ErrorMessage)
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DeliveryNote.DnDashboard.DnDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══ Glass blue palette (frozen inline) ═══ -->

        <!-- ═══ Card styles (no shadow) ═══ -->

        <!-- ═══ Typography ═══ -->

        <!-- ═══ KPI card template ═══ -->

        <!-- ═══ Bar chart template ═══ -->

        <DataTemplate x:Key="BarTemplate">
            <Grid Margin="8,0" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" VerticalAlignment="Bottom" Height="180">
                    <TextBlock Text="{Binding ValueDisplay}"
                               FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,0,0,4"
                               Foreground="{DynamicResource DashAccentTextBrush}"/>
                    <Border Width="70"
                            CornerRadius="6,6,0,0"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            SnapsToDevicePixels="True"
                            Background="{Binding BarColor,
                                         Converter={StaticResource ColorStringConverter}}"
                            Height="{Binding NormalizedHeight,
                                     Converter={StaticResource ScaleConverter},
                                     ConverterParameter=160}"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding Label}"
                           FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="90"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Grid>
        </DataTemplate>

        <!-- ═══ Feed row template — PRESERVED enhanced design ═══ -->
        <DataTemplate x:Key="FeedRowTemplate">
            <Border Margin="0,0,0,10"
                    CornerRadius="10"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource DashGlassBorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{Binding TintColor,
                                         Converter={StaticResource BrushKeyConverter}}"
                            CornerRadius="10,0,0,10"/>

                    <Border Grid.Column="1"
                            Width="40" Height="40"
                            CornerRadius="10"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="12,12,4,12"
                            SnapsToDevicePixels="True"
                            Background="{Binding TintColor,
                                         Converter={StaticResource BrushKeyConverter}}">
                        <TextBlock Text="{Binding Icon}"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="12,12,12,12">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{Binding SubTitle}"
                                   FontSize="11"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Column="3"
                            CornerRadius="8"
                            Padding="12,6"
                            VerticalAlignment="Center"
                            Margin="0,12,10,12"
                            SnapsToDevicePixels="True"
                            Background="{DynamicResource MenuHoverBrush}">
                        <TextBlock Text="{Binding ValueDisplay}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Border>

                    <Border Grid.Column="4"
                            CornerRadius="8"
                            Padding="14,6"
                            VerticalAlignment="Center"
                            Margin="0,12,16,12"
                            MinWidth="110"
                            SnapsToDevicePixels="True"
                            Background="{Binding StatusColor,
                                         Converter={StaticResource BrushKeyConverter}}">
                        <TextBlock Text="{Binding StatusLabel}"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ═══ Root: v2.5 smooth pattern ═══ -->
    <Grid Background="{DynamicResource ModuleBackgroundBrush}">

        <Canvas Panel.ZIndex="0"
                IsHitTestVisible="False"
                CacheMode="BitmapCache">
            <Rectangle Fill="{DynamicResource DashAmbientBrush}"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
            <Rectangle Fill="{DynamicResource DashAmbientBlob1Brush}"
                       RenderOptions.EdgeMode="Aliased"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
            <Rectangle Fill="{DynamicResource DashAmbientBlob2Brush}"
                       RenderOptions.EdgeMode="Aliased"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
        </Canvas>

        <ScrollViewer Panel.ZIndex="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      IsDeferredScrollingEnabled="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="14,12,14,14">

                <!-- Page header -->
                <StackPanel Margin="6,0,6,10">
                    <TextBlock Text="Delivery Note Analytics"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource DashAccentTextBrush}"/>
                    <TextBlock Text="Monitor deliveries, dispatches, rework, and pending balance."
                               FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <!-- Loading -->
                <Border Visibility="{Binding IsLoading,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="12" Margin="6,0,6,8">
                    <TextBlock Text="Loading delivery note data…"
                               FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource DashAccentTextBrush}"/>
                </Border>

                <!-- Error (hardcoded text — VM doesn't expose ErrorMessage) -->
                <Border Visibility="{Binding HasError,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{DynamicResource TintRedBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Padding="14,12" Margin="6,0,6,8">
                    <TextBlock Text="Failed to load delivery note data."
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12" TextWrapping="Wrap" FontWeight="Bold"/>
                </Border>

                <!-- KPI cards -->
                <TextBlock Text="Delivery Overview"
                           Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Summary of all delivery notes by status and volume"
                           Style="{StaticResource SectionSubtitle}"/>

                <ItemsControl ItemsSource="{Binding KpiCards}"
                              ItemTemplate="{StaticResource KpiTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Status distribution -->
                <TextBlock Text="Status Distribution"
                           Style="{StaticResource SectionTitle}"
                           Margin="6,14,6,6"/>
                <TextBlock Text="How your delivery notes are distributed across dispatch stages"
                           Style="{StaticResource SectionSubtitle}"/>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel Visibility="{Binding HasStatusData,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding StatusBars}"
                                          ItemTemplate="{StaticResource BarTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Border Height="1" Margin="0,4,0,0"
                                    Background="{DynamicResource TintIndigoBrush}"/>

                            <TextBlock Text="Delivery note count by status"
                                       FontSize="11" HorizontalAlignment="Right"
                                       Margin="0,10,4,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="0,26"
                                    Visibility="{Binding HasStatusData,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="&#xE806;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       HorizontalAlignment="Center" Opacity="0.4"/>
                            <TextBlock Text="No delivery notes yet"
                                       FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{DynamicResource DashAccentTextBrush}"/>
                            <TextBlock Text="Create a delivery note from a Job Order to get started."
                                       FontSize="12" HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Type distribution -->
                <TextBlock Text="Type Distribution"
                           Style="{StaticResource SectionTitle}"
                           Margin="6,14,6,6"/>
                <TextBlock Text="Breakdown of delivery notes by type (Original, Dummy, Rework, Return)"
                           Style="{StaticResource SectionSubtitle}"/>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel Visibility="{Binding HasStatusData,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding TypeBars}"
                                          ItemTemplate="{StaticResource BarTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Border Height="1" Margin="0,4,0,0"
                                    Background="{DynamicResource TintIndigoBrush}"/>

                            <TextBlock Text="Delivery note count by type"
                                       FontSize="11" HorizontalAlignment="Right"
                                       Margin="0,10,4,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="0,26"
                                    Visibility="{Binding HasStatusData,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       HorizontalAlignment="Center" Opacity="0.4"/>
                            <TextBlock Text="No type data yet"
                                       FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{DynamicResource DashAccentTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Recent feed -->
                <TextBlock Text="Recent Delivery Notes"
                           Style="{StaticResource SectionTitle}"
                           Margin="6,14,6,6"/>
                <TextBlock Text="Last 10 delivery notes ordered by most recently updated"
                           Style="{StaticResource SectionSubtitle}"/>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel Visibility="{Binding HasRecentFeed,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding RecentFeed}"
                                          ItemTemplate="{StaticResource FeedRowTemplate}"/>

                            <Border Height="1" Margin="0,8,0,0"
                                    Background="{DynamicResource TintIndigoBrush}"/>

                            <TextBlock Text="Showing last 10 · ordered by last updated"
                                       FontSize="11" HorizontalAlignment="Right"
                                       Margin="0,10,4,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="0,26"
                                    Visibility="{Binding HasRecentFeed,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       HorizontalAlignment="Center" Opacity="0.4"/>
                            <TextBlock Text="No delivery notes yet"
                                       FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{DynamicResource DashAccentTextBrush}"/>
                            <TextBlock Text="Create a delivery note from a Job Order to get started."
                                       FontSize="12" HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding LastRefreshed}"
                           FontSize="11" Opacity="0.6" Margin="12,16,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>