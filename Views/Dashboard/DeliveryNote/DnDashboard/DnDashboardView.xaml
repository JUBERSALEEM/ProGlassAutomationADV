<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DeliveryNote.DnDashboard.DnDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ── Card styles ── -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="24"/>
            <Setter Property="Margin"          Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="TintedCardStyle" TargetType="Border">
            <Setter Property="Background"
                    Value="{Binding TintColor,
                            Converter={StaticResource BrushKeyConverter}}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="20"/>
            <Setter Property="Margin"          Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ── Typography ── -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4338CA"/>
            <Setter Property="Margin"     Value="8,0,8,6"/>
        </Style>

        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="8,0,8,10"/>
        </Style>

        <!-- ── KPI card DataTemplate ─────────────────────────────── -->
        <DataTemplate x:Key="KpiTemplate">
            <Border Style="{StaticResource TintedCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{Binding BadgeColor,
                                             Converter={StaticResource BrushKeyConverter}}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Icon}" FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DisplayValue}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,14,0,0"/>
                    <TextBlock Text="{Binding SubLabel}"
                               FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ── Bar chart DataTemplate ─────────────────────────────── -->
        <DataTemplate x:Key="BarTemplate">
            <Grid Margin="8,0" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" VerticalAlignment="Bottom" Height="180">
                    <TextBlock Text="{Binding ValueDisplay}"
                               FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,0,0,4"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <Border Width="70"
                            CornerRadius="6,6,0,0"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Background="{Binding BarColor,
                                         Converter={StaticResource ColorStringConverter}}"
                            Height="{Binding NormalizedHeight,
                                     Converter={StaticResource ScaleConverter},
                                     ConverterParameter=160}"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding Label}"
                           FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="90"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Grid>
        </DataTemplate>

        <!-- ══ FEED ROW DataTemplate — UPGRADED FOR READABILITY ══════ -->
        <!-- Changes: solid card bg + colored left accent bar
             + darker text + larger status pill                          -->
        <DataTemplate x:Key="FeedRowTemplate">
            <Border Margin="0,0,0,10"
                    CornerRadius="10"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Left accent bar (type color) -->
                        <ColumnDefinition Width="6"/>
                        <!-- Icon -->
                        <ColumnDefinition Width="52"/>
                        <!-- DN ID + subtitle -->
                        <ColumnDefinition Width="*"/>
                        <!-- Qty pill -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Status pill -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left accent bar — colored by type tint -->
                    <Border Grid.Column="0"
                            Background="{Binding TintColor,
                                         Converter={StaticResource BrushKeyConverter}}"
                            CornerRadius="10,0,0,10"/>

                    <!-- Type icon in soft tinted circle -->
                    <Border Grid.Column="1"
                            Width="40" Height="40"
                            CornerRadius="20"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="12,12,4,12"
                            Background="{Binding TintColor,
                                         Converter={StaticResource BrushKeyConverter}}">
                        <TextBlock Text="{Binding Icon}"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- DN ID + subtitle (crisp, high-contrast) -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="12,12,12,12">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{Binding SubTitle}"
                                   FontSize="11"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Qty pill — clear numeric context -->
                    <Border Grid.Column="3"
                            CornerRadius="8"
                            Padding="12,6"
                            VerticalAlignment="Center"
                            Margin="0,12,10,12"
                            Background="{DynamicResource MenuHoverBrush}">
                        <TextBlock Text="{Binding ValueDisplay}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Border>

                    <!-- Status pill — solid color, white text, prominent -->
                    <Border Grid.Column="4"
                            CornerRadius="8"
                            Padding="14,6"
                            VerticalAlignment="Center"
                            Margin="0,12,16,12"
                            MinWidth="110"
                            Background="{Binding StatusColor,
                                         Converter={StaticResource BrushKeyConverter}}">
                        <TextBlock Text="{Binding StatusLabel}"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ══ ROOT SCROLL — SmoothScrollBehavior 60fps ═══════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  IsDeferredScrollingEnabled="False"
                  PanningMode="None"
                  Focusable="True"
                  FocusVisualStyle="{x:Null}"
                  Background="Transparent"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="24,16,24,24">

            <!-- ── Page header ───────────────────────────────────── -->
            <StackPanel Margin="8,0,8,20">
                <TextBlock Text="Delivery Note Analytics"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <TextBlock Text="Monitor deliveries, dispatches, rework, and pending balance."
                           FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>

            <!-- ── Loading state ─────────────────────────────────── -->
            <Border Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="12" Margin="8,0,8,12">
                <TextBlock Text="⏳  Loading delivery note data…" FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

            <!-- ── Error state ───────────────────────────────────── -->
            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16" Margin="8,0,8,12">
                <TextBlock Text="Failed to load delivery note data."
                           Foreground="#B91C1C"
                           FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- ══ KPI CARDS ══════════════════════════════════════ -->
            <TextBlock Text="Delivery Overview"
                       Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Summary of all delivery notes by status and volume"
                       Style="{StaticResource SectionSubtitle}"/>

            <ItemsControl ItemsSource="{Binding KpiCards}"
                          ItemTemplate="{StaticResource KpiTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ══ STATUS DISTRIBUTION ════════════════════════════ -->
            <TextBlock Text="Status Distribution"
                       Style="{StaticResource SectionTitle}"
                       Margin="8,24,8,6"/>
            <TextBlock Text="How your delivery notes are distributed across dispatch stages"
                       Style="{StaticResource SectionSubtitle}"/>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <StackPanel Visibility="{Binding HasStatusData,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding StatusBars}"
                                      ItemTemplate="{StaticResource BarTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Height="1" Margin="0,4,0,0"
                                Background="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="Delivery note count by status"
                                   FontSize="11" HorizontalAlignment="Right"
                                   Margin="0,10,4,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Margin="0,50"
                                Visibility="{Binding HasStatusData,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="🚚" FontSize="48"
                                   HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="No delivery notes yet"
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Create a delivery note from a Job Order to get started."
                                   FontSize="12" HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ TYPE DISTRIBUTION ══════════════════════════════ -->
            <TextBlock Text="Type Distribution"
                       Style="{StaticResource SectionTitle}"
                       Margin="8,24,8,6"/>
            <TextBlock Text="Breakdown of delivery notes by type (Original, Dummy, Rework, Return)"
                       Style="{StaticResource SectionSubtitle}"/>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <StackPanel Visibility="{Binding HasStatusData,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding TypeBars}"
                                      ItemTemplate="{StaticResource BarTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Height="1" Margin="0,4,0,0"
                                Background="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="Delivery note count by type"
                                   FontSize="11" HorizontalAlignment="Right"
                                   Margin="0,10,4,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Margin="0,50"
                                Visibility="{Binding HasStatusData,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="📊" FontSize="48"
                                   HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="No type data yet"
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ RECENT DELIVERY NOTES FEED ═════════════════════ -->
            <TextBlock Text="Recent Delivery Notes"
                       Style="{StaticResource SectionTitle}"
                       Margin="8,24,8,6"/>
            <TextBlock Text="Last 10 delivery notes ordered by most recently updated"
                       Style="{StaticResource SectionSubtitle}"/>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <StackPanel Visibility="{Binding HasRecentFeed,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding RecentFeed}"
                                      ItemTemplate="{StaticResource FeedRowTemplate}"/>

                        <Border Height="1" Margin="0,8,0,0"
                                Background="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="Showing last 10 · ordered by last updated"
                                   FontSize="11" HorizontalAlignment="Right"
                                   Margin="0,10,4,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Margin="0,50"
                                Visibility="{Binding HasRecentFeed,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="📦" FontSize="48"
                                   HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="No delivery notes yet"
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Create a delivery note from a Job Order to get started."
                                   FontSize="12" HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Footer timestamp ──────────────────────────────── -->
            <TextBlock Text="{Binding LastRefreshed}"
                       FontSize="11" Opacity="0.5" Margin="12,16,0,0"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>