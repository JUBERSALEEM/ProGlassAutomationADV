<!-- Indigo Studio: production dashboard; original data and navigation contracts retained. -->
<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    xmlns:donut="clr-namespace:ProGlassAutomation.Controls.DonutChart"
    xmlns:layout="clr-namespace:ProGlassAutomation.Views.Dashboard"
    xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="ProGlassAutomation.Views.Dashboard.DeliveryNote.DnDashboard.DnDashboardView"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextHintingMode="Fixed"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    Foreground="{DynamicResource Ov.Ink}"
    Background="{DynamicResource Ov.Canvas}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../IndigoDashboardResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            CanContentScroll="False"
            PanningMode="VerticalOnly"
            Focusable="False"
            FocusVisualStyle="{x:Null}"
            Background="Transparent"
            behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="{DynamicResource Ds.PageMargin}">
                <layout:IndigoDashboardPanel Margin="0,0,0,18" MaxColumns="2" MinimumColumnWidth="390" FirstColumnWeight="1" Gap="20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Text="{DynamicResource Dashboard.Deliveries}"
                            Style="{StaticResource Ds.HeroTitleStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{DynamicResource Dashboard.DispatchFlowDeliveryBalanceRecentMovements}"
                            Style="{StaticResource Ds.HeroSubStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <Border Style="{StaticResource Ds.LiveChipStyle}" Margin="0,0,10,0">
                            <TextBlock Text="Snapshot" Style="{StaticResource Ds.LiveTextStyle}" />
                        </Border>
                        <TextBlock Text="{Binding LastRefreshed}" Style="{StaticResource Ds.MetaStyle}" TextWrapping="Wrap" />
                    </WrapPanel>
                </layout:IndigoDashboardPanel>
                <StackPanel>
                    <Border
                        Style="{StaticResource Ds.StateBandStyle}"
                        Background="{DynamicResource Ov.Soft}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Ds.SkeletonCircleStyle}" Width="20" Height="20" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource Ds.SkeletonBlockStyle}" Height="12" Width="180" HorizontalAlignment="Left" />
                                <Border
                                    Style="{StaticResource Ds.SkeletonBlockStyle}"
                                    Height="8"
                                    Width="260"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Left"
                                    Opacity="0.5" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border
                        Style="{StaticResource Ds.StateBandStyle}"
                        Background="{DynamicResource Ov.DangerSoft}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Ds.ErrorTextStyle}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource Ds.SkeletonBandStyle}">
                        <StackPanel>
                            <Border
                                Style="{StaticResource Ds.SkeletonBlockStyle}"
                                Height="16"
                                Width="120"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,4" />
                            <Border
                                Style="{StaticResource Ds.SkeletonBlockStyle}"
                                Height="10"
                                Width="200"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12"
                                Opacity="0.5" />
                            <ItemsControl
                                Style="{StaticResource Ds.SkeletonKpiBandStyle}"
                                ItemsPanel="{StaticResource Ds.SkeletonKpiBandPanel}">
                                <ContentControl ContentTemplate="{StaticResource Ds.SkeletonKpiTileTemplate}" />
                                <ContentControl ContentTemplate="{StaticResource Ds.SkeletonKpiTileTemplate}" />
                                <ContentControl ContentTemplate="{StaticResource Ds.SkeletonKpiTileTemplate}" />
                                <ContentControl ContentTemplate="{StaticResource Ds.SkeletonKpiTileTemplate}" />
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <layout:IndigoDashboardPanel Margin="0,0,0,16" MaxColumns="2" MinimumColumnWidth="340" FirstColumnWeight="1.45">
                        <Border Style="{StaticResource Ds.SkeletonCardStyle}">
                            <ContentControl ContentTemplate="{StaticResource Ds.SkeletonChartTemplate}" />
                        </Border>
                        <Border Style="{StaticResource Ds.SkeletonCardStyle}">
                            <StackPanel>
                                <Border
                                    Style="{StaticResource Ds.SkeletonBlockStyle}"
                                    Height="14"
                                    Width="90"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,6" />
                                <Border
                                    Style="{StaticResource Ds.SkeletonBlockStyle}"
                                    Height="10"
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,16"
                                    Opacity="0.5" />
                                <Grid Height="158">
                                    <Border
                                        Style="{StaticResource Ds.SkeletonCircleStyle}"
                                        Width="110"
                                        Height="110"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </layout:IndigoDashboardPanel>
                    <layout:IndigoDashboardPanel MaxColumns="2" MinimumColumnWidth="340" FirstColumnWeight="1">
                        <Border Style="{StaticResource Ds.SkeletonCardStyle}">
                            <ContentControl ContentTemplate="{StaticResource Ds.SkeletonChartTemplate}" />
                        </Border>
                        <Border Style="{StaticResource Ds.SkeletonCardStyle}">
                            <StackPanel>
                                <Border
                                    Style="{StaticResource Ds.SkeletonBlockStyle}"
                                    Height="14"
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12" />
                                <ContentControl ContentTemplate="{StaticResource Ds.SkeletonFeedRowTemplate}" />
                                <ContentControl ContentTemplate="{StaticResource Ds.SkeletonFeedRowTemplate}" />
                                <ContentControl ContentTemplate="{StaticResource Ds.SkeletonFeedRowTemplate}" />
                            </StackPanel>
                        </Border>
                    </layout:IndigoDashboardPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource Ds.Content}">
                    <Border
                        Margin="0,0,0,18"
                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0">
                        <StackPanel>
                            <TextBlock
                                Text="{DynamicResource Dashboard.DispatchPulse}"
                                Style="{StaticResource Ds.CardTitleStyle}"
                                Margin="0,0,0,2"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{DynamicResource Dashboard.NotesPendingPcsReturns}"
                                Style="{StaticResource Ds.CardSubStyle}"
                                Margin="0,2,0,12"
                                TextWrapping="Wrap" />
                            <ItemsControl
                                Style="{StaticResource Ds.KpiBandStyle}"
                                ItemsSource="{Binding KpiCards}"
                                ItemsPanel="{StaticResource Ds.KpiBandPanel}"
                                ItemTemplate="{StaticResource Ds.KpiTileTemplate}" />
                        </StackPanel>
                    </Border>
                    <layout:IndigoDashboardPanel
                        Margin="0,0,0,18"
                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                        MaxColumns="2"
                        MinimumColumnWidth="340"
                        FirstColumnWeight="1.45">
                        <Border Style="{StaticResource Ds.CardStyle}">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock
                                        Text="{DynamicResource Dashboard.StatusDistribution}"
                                        Style="{StaticResource Ds.CardTitleStyle}"
                                        TextWrapping="Wrap"
                                        Margin="0,0,16,8" />
                                    <TextBlock
                                        Text="{DynamicResource Dashboard.NotesGroupedCurrentStatus}"
                                        Style="{StaticResource Ds.MetaStyle}"
                                        HorizontalAlignment="Right"
                                        TextWrapping="Wrap"
                                        Margin="0,0,16,8" />
                                </WrapPanel>
                                <Grid>
                                    <Border
                                        Style="{StaticResource Ds.ChartWellStyle}"
                                        Visibility="{Binding HasStatusData, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <trend:TrendChartControl
                                            Points="{Binding StatusBars}"
                                            SeriesKind="Bar"
                                            SeriesBrush="{DynamicResource Ov.Accent}"
                                            SeriesEndBrush="{DynamicResource Ov.AreaEnd}"
                                            GridBrush="{DynamicResource Ov.Line}"
                                            LabelBrush="{DynamicResource Ov.Muted}"
                                            EmptyMessage="" />
                                    </Border>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Margin="0,32"
                                        Visibility="{Binding HasStatusData, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="&#xE806;" Style="{StaticResource Ds.EmptyGlyphStyle}" TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{DynamicResource Dashboard.NoDeliveryNotesYet}"
                                            Style="{StaticResource Ds.EmptyTextStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Ds.CardStyle}">
                            <StackPanel>
                                <TextBlock
                                    Text="{DynamicResource Dashboard.DeliveryMix}"
                                    Style="{StaticResource Ds.CardTitleStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{DynamicResource Dashboard.DeliveryNoteCount}"
                                    Style="{StaticResource Ds.CardSubStyle}"
                                    Margin="0,2,0,10"
                                    TextWrapping="Wrap" />
                                <donut:DonutChartControl
                                    Height="158"
                                    Slices="{Binding StatusMixSlices}"
                                    HoleLabel="{DynamicResource Common.Delivered}"
                                    EmptyMessage="No deliveries yet."
                                    Thickness="16" />
                            </StackPanel>
                        </Border>
                    </layout:IndigoDashboardPanel>
                    <layout:IndigoDashboardPanel
                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                        MaxColumns="2"
                        MinimumColumnWidth="340"
                        FirstColumnWeight="1"
                        Margin="0,0,0,18">
                        <Border Style="{StaticResource Ds.CardStyle}">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock
                                        Text="{DynamicResource Dashboard.Type}"
                                        Style="{StaticResource Ds.CardTitleStyle}"
                                        TextWrapping="Wrap"
                                        Margin="0,0,16,8" />
                                    <TextBlock
                                        Text="{DynamicResource Dashboard.DummySplitMaster}"
                                        Style="{StaticResource Ds.MetaStyle}"
                                        HorizontalAlignment="Right"
                                        TextWrapping="Wrap"
                                        Margin="0,0,16,8" />
                                </WrapPanel>
                                <Grid>
                                    <Border
                                        Style="{StaticResource Ds.ChartWellStyle}"
                                        Visibility="{Binding HasStatusData, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <trend:TrendChartControl
                                            Points="{Binding TypeBars}"
                                            SeriesKind="Bar"
                                            SeriesBrush="{DynamicResource Ov.AreaEnd}"
                                            SeriesEndBrush="{DynamicResource Ov.Accent}"
                                            GridBrush="{DynamicResource Ov.Line}"
                                            LabelBrush="{DynamicResource Ov.Muted}"
                                            EmptyMessage="" />
                                    </Border>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Margin="0,32"
                                        Visibility="{Binding HasStatusData, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="&#xE7B8;" Style="{StaticResource Ds.EmptyGlyphStyle}" TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{DynamicResource Dashboard.NoDeliveryNotesYet}"
                                            Style="{StaticResource Ds.EmptyTextStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Ds.CardStyle}">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock
                                        Text="{DynamicResource Dashboard.RecentDeliveries}"
                                        Style="{StaticResource Ds.CardTitleStyle}"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        Margin="0,0,16,8" />
                                    <TextBlock
                                        Text="{DynamicResource Dashboard.LatestActivity}"
                                        Style="{StaticResource Ds.MetaStyle}"
                                        Margin="0,0,16,8"
                                        TextWrapping="Wrap" />
                                </WrapPanel>
                                <Grid>
                                    <ScrollViewer
                                        MaxHeight="420"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled"
                                        CanContentScroll="False"
                                        PanningMode="VerticalOnly"
                                        behaviors:SmoothScrollBehavior.IsEnabled="True"
                                        behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                                        <ItemsControl
                                            Style="{StaticResource Ds.FeedItemsStyle}"
                                            ItemsSource="{Binding RecentFeed}"
                                            ItemTemplate="{StaticResource Ov.FeedTemplate}"
                                            Visibility="{Binding HasRecentFeed, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </ScrollViewer>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Margin="0,32"
                                        Visibility="{Binding HasRecentFeed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="&#xE823;" Style="{StaticResource Ds.EmptyGlyphStyle}" TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{DynamicResource Dashboard.NoDeliveryNotesYet}"
                                            Style="{StaticResource Ds.EmptyTextStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </layout:IndigoDashboardPanel>
                    <TextBlock
                        Text="Delivery-note counts and piece quantities are different units. Status and type charts count notes."
                        Style="{StaticResource Ov.Meta}"
                        Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
