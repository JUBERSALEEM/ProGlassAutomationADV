<!-- LAYOUT-03 BENTO MOSAIC — Deliveries. Bindings unchanged. -->
<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DeliveryNote.DnDashboard.DnDashboardView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             xmlns:donut="clr-namespace:ProGlassAutomation.Controls.DonutChart"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="20,16,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220" MinHeight="180"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Deliveries"
                                   Style="{StaticResource SoftHeroTitleStyle}"/>
                        <TextBlock Text="Dispatch flow, delivery balance and recent movements"
                                   Style="{StaticResource SoftHeroSubtitleStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource SoftChipStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="Live" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LastRefreshed}"
                                   Style="{StaticResource SoftMetaStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource SoftSectionStyle}"
                            Padding="16,12"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Loading delivery note data…"
                                   Style="{StaticResource SoftKpiFootStyle}"/>
                    </Border>
                    <Border Style="{StaticResource SoftSectionStyle}"
                            Padding="16,12"
                            Background="{DynamicResource TintRedBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            Visibility="{Binding HasError,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}"/>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SoftCardStyle}"
                            Margin="0,0,10,0" MinHeight="168">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Dispatch pulse"
                                           Style="{StaticResource SoftSectionTitleStyle}"/>
                                <TextBlock Text="Notes, pending pcs and returns"
                                           Style="{StaticResource SoftSectionSubtitleStyle}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding KpiCards}"
                                          ItemTemplate="{StaticResource SoftKpiCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SoftCardStyle}"
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Delivery mix"
                                       Style="{StaticResource SoftSectionTitleStyle}"/>
                            <TextBlock Text="Notes grouped by current status"
                                       Style="{StaticResource SoftSectionSubtitleStyle}"/>
                            <donut:DonutChartControl Height="150"
                                                     Slices="{Binding StatusMixSlices}"
                                                     HoleLabel="DNs"
                                                     EmptyMessage="No delivery mix yet."
                                                     Thickness="16"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SoftCardStyle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="By type"
                                           Style="{StaticResource SoftSectionTitleStyle}"/>
                                <TextBlock Text="Dummy / split / master"
                                           Style="{StaticResource SoftSectionSubtitleStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource SoftChartWellStyle}">
                                <trend:TrendChartControl
                                    Points="{Binding TypeBars}"
                                    SeriesKind="Bar"
                                    EmptyMessage="No type data yet."
                                    SeriesBrush="{DynamicResource AccentBrush}"
                                    SeriesEndBrush="{DynamicResource AccentDarkBrush}"
                                    GridBrush="{DynamicResource DividerBrush}"
                                    LabelBrush="{DynamicResource MutedForegroundBrush}"/>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SoftCardStyle}" Margin="0,0,10,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Status distribution"
                                           Style="{StaticResource SoftSectionTitleStyle}"/>
                                <TextBlock Text="Delivery note count"
                                           Style="{StaticResource SoftMetaStyle}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Border Style="{StaticResource SoftChartWellStyle}"
                                        Visibility="{Binding HasStatusData,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                    <trend:TrendChartControl
                                        Points="{Binding StatusBars}"
                                        SeriesKind="Bar"
                                        EmptyMessage="Delivery note count by status — no data yet."
                                        SeriesBrush="{DynamicResource AccentBrush}"
                                        SeriesEndBrush="{DynamicResource AccentDarkBrush}"
                                        GridBrush="{DynamicResource DividerBrush}"
                                        LabelBrush="{DynamicResource MutedForegroundBrush}"/>
                                </Border>
                                <Border Padding="0,40"
                                        Visibility="{Binding HasStatusData,
                                            Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE806;"
                                                   Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                        <TextBlock Text="No delivery notes yet"
                                                   Style="{StaticResource DashEmptyStateTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SoftCardStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Recent deliveries"
                                       Style="{StaticResource SoftSectionTitleStyle}"
                                       Margin="0,0,0,8"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasRecentFeed,
                                              Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding RecentFeed}"
                                              ItemTemplate="{StaticResource SoftFeedRowTemplate}"/>
                            </ScrollViewer>
                            <Border Padding="0,40"
                                    Visibility="{Binding HasRecentFeed,
                                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE806;"
                                               Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                    <TextBlock Text="No delivery notes yet"
                                               Style="{StaticResource DashEmptyStateTextStyle}"/>
                                    <TextBlock Text="Create a delivery note from a Job Order."
                                               Style="{StaticResource SoftMetaStyle}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
