<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/Overview/OverviewDashboardView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Overview Dashboard (Chat 23 v2.5)
     VERSION: Chat 23 v2.5 — Match JoDashboard smoothness

     ROOT CAUSE (why v2.4 was still less smooth than JoDashboard):
       The ambient LinearGradientBrush was on Grid.Background — WPF
       re-rasterizes gradient brushes on the root Grid every frame,
       even when content is BitmapCached.
       Additionally, having a full-viewport transparent ScrollViewer
       over a gradient-painted Grid required 3-layer composition
       per frame (gradient + cached blobs + scrolled content).

       JoDashboard is smoother because it has ZERO ambient overhead
       (transparent bg, no blobs, no gradient).

     FIX in v2.5:
       Move the ambient gradient from Grid.Background INTO the
       BitmapCached Canvas as a base Rectangle. Now the entire
       ambient layer (gradient + 2 blobs) is ONE cached GPU bitmap.
       Compositor just moves the bitmap = near-zero cost per frame.

       Grid.Background becomes a cheap solid color (#F5F9FF) — used
       only as a fallback during initial cache creation or window
       resize (temporary, then Canvas takes over).

     CHANGES vs v2.4:
       ✓ Grid.Background: LinearGradientBrush → solid #F5F9FF (cheap)
       ✓ Added Rectangle inside Canvas with AmbientBg gradient
         (now part of the cached bitmap)
       ✓ Same visual output — pure composition-layer optimization
       ✓ All v2.4 wins preserved (no shadows, no BitmapCache on tiles)

     PRESERVED (zero regression):
       • ALL bindings / commands / layout
       • VM unchanged
       • All frozen brushes
       • SmoothScrollBehavior on outer ScrollViewer
       • Inner Activity ScrollViewer removed (v2.3)
       • PanningMode/Focusable settings from v2.3
       • Shadow removal from v2.4
       • Visual appearance IDENTICAL to v2.4
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Dashboard.Overview.OverviewDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Ambient gradient — now painted INSIDE cached Canvas -->
        <LinearGradientBrush x:Key="AmbientBg"
                             StartPoint="0,0" EndPoint="1,1"
                             po:Freeze="True">
            <GradientStop Color="#E8F0FE" Offset="0.0"/>
            <GradientStop Color="#DBE7F9" Offset="0.5"/>
            <GradientStop Color="#C7D9F0" Offset="1.0"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="Blob1"
                             Center="0.85,0.10"
                             GradientOrigin="0.85,0.10"
                             RadiusX="0.4" RadiusY="0.4"
                             po:Freeze="True">
            <GradientStop Color="#3B82F640" Offset="0.0"/>
            <GradientStop Color="#3B82F600" Offset="1.0"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="Blob2"
                             Center="0.10,0.85"
                             GradientOrigin="0.10,0.85"
                             RadiusX="0.35" RadiusY="0.35"
                             po:Freeze="True">
            <GradientStop Color="#1E40AF30" Offset="0.0"/>
            <GradientStop Color="#1E40AF00" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- Card bg gradient (shadow substitute) -->
        <LinearGradientBrush x:Key="CardBgGradient"
                             StartPoint="0,0" EndPoint="0,1"
                             po:Freeze="True">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#F4F8FE" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardBorderBrush"
                         Color="#C4D6ED"
                         po:Freeze="True"/>

        <SolidColorBrush x:Key="AccentTextDeep"
                         Color="#1E3A8A"
                         po:Freeze="True"/>
        <SolidColorBrush x:Key="AccentText"
                         Color="#1E40AF"
                         po:Freeze="True"/>
        <SolidColorBrush x:Key="AccentTextRoyal"
                         Color="#1D4ED8"
                         po:Freeze="True"/>

        <SolidColorBrush x:Key="SalesHeaderBrush"
                         Color="#1E40AF"
                         po:Freeze="True"/>
        <SolidColorBrush x:Key="ProductionHeaderBrush"
                         Color="#1D4ED8"
                         po:Freeze="True"/>
        <SolidColorBrush x:Key="DeliveryHeaderBrush"
                         Color="#B45309"
                         po:Freeze="True"/>
        <SolidColorBrush x:Key="ActivityHeaderBrush"
                         Color="#1E3A8A"
                         po:Freeze="True"/>
        <SolidColorBrush x:Key="InventoryHeaderBrush"
                         Color="#0369A1"
                         po:Freeze="True"/>
        <SolidColorBrush x:Key="ChartHeaderBrush"
                         Color="#1D4ED8"
                         po:Freeze="True"/>

        <!-- Parent card style (no shadow, no cache) -->
        <Style x:Key="ParentCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource CardBgGradient}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Padding"         Value="22,18"/>
            <Setter Property="Margin"          Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ParentCardHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin"      Value="0,0,0,18"/>
        </Style>

        <Style x:Key="ParentCardIcon" TargetType="Border">
            <Setter Property="Width"        Value="38"/>
            <Setter Property="Height"       Value="38"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ParentCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="16"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="12,0,0,0"/>
        </Style>

        <!-- Tile template -->
        <DataTemplate x:Key="TileTemplate">
            <Border CornerRadius="10" Padding="14,12" Margin="5"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#EEF4FF"/>
                        <Setter Property="BorderBrush" Value="#93B4E8"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Accent}" Value="Blue">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="BorderBrush" Value="#7FA6D9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Accent}" Value="Amber">
                                <Setter Property="Background" Value="#FFF8E6"/>
                                <Setter Property="BorderBrush" Value="#E8C77B"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Accent}" Value="Red">
                                <Setter Property="Background" Value="#FFF0F0"/>
                                <Setter Property="BorderBrush" Value="#F5B0B0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                <Setter Property="BorderBrush" Value="#DC2626"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Label}"
                                   FontSize="11" FontWeight="Bold"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1E40AF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Accent}" Value="Blue">
                                            <Setter Property="Foreground" Value="#1E3A8A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Accent}" Value="Amber">
                                            <Setter Property="Foreground" Value="#92400E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Accent}" Value="Red">
                                            <Setter Property="Foreground" Value="#991B1B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding DisplayValue}"
                               FontSize="20" FontWeight="Bold"
                               Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1E3A8A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Accent}" Value="Blue">
                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Accent}" Value="Amber">
                                        <Setter Property="Foreground" Value="#B45309"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Accent}" Value="Red">
                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Activity chat template -->
        <DataTemplate x:Key="ActivityChatTemplate">
            <Border Padding="12,10" Margin="0,0,0,7"
                    CornerRadius="10"
                    SnapsToDevicePixels="True"
                    Background="{Binding TintColor,
                                 Converter={StaticResource BrushKeyConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="34" Height="34" CornerRadius="17"
                            Background="{Binding StatusColor,
                                         Converter={StaticResource BrushKeyConverter}}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <TextBlock Text="{Binding Icon}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubTitle}"
                                   FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ValueDisplay}"
                                   FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <Border CornerRadius="8" Padding="8,3" Margin="0,4,0,0"
                                HorizontalAlignment="Right"
                                Background="{Binding StatusColor,
                                             Converter={StaticResource BrushKeyConverter}}">
                            <TextBlock Text="{Binding StatusLabel}"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Quick action buttons -->
        <Style x:Key="QuickActionPrimary" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="20"
                                SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush Color="#1D4ED8"/>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="14" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#2563EB"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#1E3A8A"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickActionSecondary" TargetType="Button">
            <Setter Property="Foreground"      Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                BorderThickness="1.5"
                                CornerRadius="20"
                                SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush Color="#FFFFFF" Opacity="0.6"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#1D4ED8"/>
                            </Border.BorderBrush>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="14" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#DBEAFE"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#BFDBFE"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT — Solid fallback bg, cached ambient inside Canvas
    ═══════════════════════════════════════════════════════════════ -->
    <!-- Grid.Background = solid color (cheap fallback during cache warm-up).
         The REAL ambient (gradient + blobs) is painted inside the
         BitmapCached Canvas below → single cached bitmap, near-zero
         per-frame cost. -->
    <Grid Background="#F5F9FF">

        <!-- ALL ambient painting happens here, inside the cache.
             One bitmap covers gradient + both blobs.
             Compositor moves it during scroll = free. -->
        <Canvas Panel.ZIndex="0"
                IsHitTestVisible="False"
                CacheMode="BitmapCache">
            <!-- Base gradient (moved from Grid.Background into cache) -->
            <Rectangle Fill="{StaticResource AmbientBg}"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
            <Rectangle Fill="{StaticResource Blob1}"
                       RenderOptions.EdgeMode="Aliased"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
            <Rectangle Fill="{StaticResource Blob2}"
                       RenderOptions.EdgeMode="Aliased"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
        </Canvas>

        <ScrollViewer Panel.ZIndex="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      IsDeferredScrollingEnabled="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="24,16,24,24">

                <!-- Page header -->
                <Grid Margin="8,0,8,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Dashboard"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource AccentTextDeep}"/>
                        <TextBlock Text="Business at a glance — sales, production, delivery, inventory."
                                   FontSize="13" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource QuickActionPrimary}"
                                Content="New Invoice" Tag="➕"
                                Command="{Binding NewInvoiceCommand}"/>
                        <Button Style="{StaticResource QuickActionSecondary}"
                                Content="Invoices" Tag="📋"
                                Command="{Binding SavedInvoicesCommand}"/>
                        <Button Style="{StaticResource QuickActionSecondary}"
                                Content="Jobs" Tag="🏭"
                                Command="{Binding ViewJobsCommand}"/>
                        <Button Style="{StaticResource QuickActionSecondary}"
                                Content="Deliveries" Tag="🚚"
                                Command="{Binding ViewDeliveriesCommand}"/>
                        <Button Style="{StaticResource QuickActionSecondary}"
                                Content="Stock" Tag="📦"
                                Command="{Binding ViewStockCommand}"/>
                    </StackPanel>
                </Grid>

                <Border Visibility="{Binding IsLoading,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="12" Margin="8,0,8,12">
                    <TextBlock Text="⏳  Loading overview…"
                               FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentText}"/>
                </Border>

                <Border Visibility="{Binding HasError,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#FEE2E2"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="14" Margin="8,0,8,12">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#991B1B"
                               FontSize="12" TextWrapping="Wrap" FontWeight="Bold"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- SALES -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource ParentCardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource ParentCardHeader}">
                                <Border Style="{StaticResource ParentCardIcon}"
                                        Background="{StaticResource SalesHeaderBrush}">
                                    <TextBlock Text="💰" FontSize="18"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="SALES"
                                           Style="{StaticResource ParentCardTitle}"
                                           Foreground="{StaticResource SalesHeaderBrush}"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding SalesTiles}"
                                          ItemTemplate="{StaticResource TileTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- PRODUCTION -->
                    <Border Grid.Row="0" Grid.Column="1"
                            Style="{StaticResource ParentCardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource ParentCardHeader}">
                                <Border Style="{StaticResource ParentCardIcon}"
                                        Background="{StaticResource ProductionHeaderBrush}">
                                    <TextBlock Text="🏭" FontSize="18"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="PRODUCTION"
                                           Style="{StaticResource ParentCardTitle}"
                                           Foreground="{StaticResource ProductionHeaderBrush}"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding ProductionTiles}"
                                          ItemTemplate="{StaticResource TileTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- DELIVERY -->
                    <Border Grid.Row="1" Grid.Column="0"
                            Style="{StaticResource ParentCardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource ParentCardHeader}">
                                <Border Style="{StaticResource ParentCardIcon}"
                                        Background="{StaticResource DeliveryHeaderBrush}">
                                    <TextBlock Text="🚚" FontSize="18"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="DELIVERY"
                                           Style="{StaticResource ParentCardTitle}"
                                           Foreground="{StaticResource DeliveryHeaderBrush}"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding DeliveryTiles}"
                                          ItemTemplate="{StaticResource TileTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="3" Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ACTIVITY -->
                    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
                            Style="{StaticResource ParentCardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource ParentCardHeader}">
                                <Border Style="{StaticResource ParentCardIcon}"
                                        Background="{StaticResource ActivityHeaderBrush}">
                                    <TextBlock Text="💬" FontSize="18"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="RECENT ACTIVITY"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource ActivityHeaderBrush}"/>
                                    <TextBlock Text="Latest across all modules"
                                               FontSize="10"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Border CornerRadius="12"
                                    Padding="10"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Border.Background>
                                    <SolidColorBrush Color="#F5F9FF"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#DBE7F9"/>
                                </Border.BorderBrush>
                                <Grid>
                                    <ItemsControl
                                        ItemsSource="{Binding RecentActivity}"
                                        ItemTemplate="{StaticResource ActivityChatTemplate}"
                                        Visibility="{Binding HasRecentActivity,
                                                     Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <StackPanel HorizontalAlignment="Center"
                                                Margin="0,40"
                                                Visibility="{Binding HasRecentActivity,
                                                             Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="📭" FontSize="36"
                                                   HorizontalAlignment="Center" Opacity="0.4"/>
                                        <TextBlock Text="No activity yet"
                                                   FontSize="14" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,10,0,4"
                                                   Foreground="{StaticResource AccentTextDeep}"/>
                                        <TextBlock Text="Activity from all modules will appear here."
                                                   FontSize="11" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- INVENTORY -->
                    <Border Grid.Row="2" Grid.Column="0"
                            Style="{StaticResource ParentCardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource ParentCardHeader}">
                                <Border Style="{StaticResource ParentCardIcon}"
                                        Background="{StaticResource InventoryHeaderBrush}">
                                    <TextBlock Text="📦" FontSize="18"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="INVENTORY"
                                           Style="{StaticResource ParentCardTitle}"
                                           Foreground="{StaticResource InventoryHeaderBrush}"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding InventoryTiles}"
                                          ItemTemplate="{StaticResource TileTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- Chart -->
                <Border Style="{StaticResource ParentCardStyle}"
                        Margin="8,12,8,8">
                    <StackPanel>
                        <StackPanel Style="{StaticResource ParentCardHeader}">
                            <Border Style="{StaticResource ParentCardIcon}"
                                    Background="{StaticResource ChartHeaderBrush}">
                                <TextBlock Text="📈" FontSize="18"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center"
                                        Margin="12,0,0,0">
                                <TextBlock Text="SALES ANALYTICS"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource ChartHeaderBrush}"/>
                                <TextBlock Text="{Binding ChartTitle}"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <StackPanel Visibility="{Binding HasChartData,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding MonthlySalesBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" HorizontalAlignment="Stretch"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,0" HorizontalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0"
                                                      VerticalAlignment="Bottom"
                                                      Height="160">
                                                    <TextBlock Text="{Binding ValueDisplay}"
                                                               FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Top"
                                                               Margin="0,0,0,4"
                                                               Foreground="#1E3A8A"/>
                                                    <Border Width="46"
                                                            CornerRadius="6,6,0,0"
                                                            VerticalAlignment="Bottom"
                                                            HorizontalAlignment="Center"
                                                            SnapsToDevicePixels="True"
                                                            Background="{Binding BarColor,
                                                                         Converter={StaticResource ColorStringConverter}}"
                                                            Height="{Binding NormalizedHeight,
                                                                     Converter={StaticResource ScaleConverter},
                                                                     ConverterParameter=140}"/>
                                                </Grid>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Label}"
                                                           FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Values in AED · VAT inclusive"
                                           FontSize="10" HorizontalAlignment="Right"
                                           Margin="0,10,4,0"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center" Margin="0,40"
                                        Visibility="{Binding HasChartData,
                                                     Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="📊" FontSize="36"
                                           HorizontalAlignment="Center" Opacity="0.4"/>
                                <TextBlock Text="No sales data yet"
                                           FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,4"
                                           Foreground="{StaticResource AccentTextDeep}"/>
                                <TextBlock Text="Create your first Proforma Invoice to see data."
                                           FontSize="11" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding LastRefreshed}"
                           FontSize="10" Opacity="0.6" Margin="12,12,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>