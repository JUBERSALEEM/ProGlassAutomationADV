<!-- LAYOUT-03 BENTO MOSAIC — Overview. Bindings unchanged. -->
<UserControl x:Class="ProGlassAutomation.Views.Dashboard.Overview.OverviewDashboardView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             xmlns:donut="clr-namespace:ProGlassAutomation.Controls.DonutChart"
             xmlns:mini="clr-namespace:ProGlassAutomation.Controls.MiniBarChart"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="{StaticResource DbPageMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- 2026-09-08: the order-to-cash pipeline rail. -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- 2026-08-25: revenue trend + recent documents row
                         expanded 220 -> 320 so both cards breathe. -->
                    <RowDefinition Height="*" MinHeight="280"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HERO STRIP -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard.FactoryPulse}"
                                   Style="{StaticResource DbTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Dashboard.OperationalAnalyticsInvoicesJobsDelivery}"
                                   Style="{StaticResource DbSubtitleStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource DbChipStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{DynamicResource Common.Live}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LastRefreshed}"
                                   Style="{StaticResource DbMetaStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Button Content="{DynamicResource Dashboard.NewInvoice}" Tag="&#xE710;"
                                Style="{StaticResource DbActionButtonAccentStyle}"
                                Command="{Binding NewInvoiceCommand}" ToolTip="{DynamicResource Dashboard.CreateNewTaxInvoice}"/>
                        <Button Content="{DynamicResource Dashboard.Jobs}" Tag="&#xE9F9;"
                                Style="{StaticResource DbActionButtonStyle}"
                                Command="{Binding ViewJobsCommand}" ToolTip="{DynamicResource Dashboard.ViewJobOrders}"/>
                        <Button Content="{DynamicResource Dashboard.Deliveries}" Tag="&#xE806;" Margin="0"
                                Style="{StaticResource DbActionButtonStyle}"
                                Command="{Binding ViewDeliveriesCommand}" ToolTip="{DynamicResource Dashboard.ViewDeliveryNotes}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource DbStateBandStyle}"
                        Padding="16,12"
                        Visibility="{Binding IsLoading,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource Dashboard.LoadingLiveBusinessData}"
                               Style="{StaticResource DbKpiFootStyle}"/>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource DbStateBandStyle}"
                        Padding="16,12"
                        Background="{DynamicResource TintRedBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        Visibility="{Binding HasError,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="{StaticResource TextBody}" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"/>
                </Border>


                <!-- ═════════════════════════════════════════════════════
                     ROW 2 · ORDER-TO-CASH PIPELINE

                     Quote → Production → Delivery → Invoice → Payment.

                     This is the one visual on the dashboard that crosses
                     module boundaries. The four KPI bands below answer
                     "how is each department doing"; this rail answers
                     "where is the work stuck", which is the question an
                     operator asks first. Each stage counts live work in
                     that handoff and the chip colour escalates only when
                     the stage is carrying something overdue.

                     Only the Overview carries this rail — it is the whole
                     book of work, so it belongs where the whole book is
                     summarised, not repeated on seven tabs.
                ═════════════════════════════════════════════════════ -->
                <Border Grid.Row="2" Style="{StaticResource DbCardStyle}" Margin="0,0,0,20">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource Dashboard.PipelineVolumeConfirmation}"
                                   Style="{StaticResource DbSectionTitleStyle}"
                                   Margin="0,0,0,12"/>
                        <ItemsControl Style="{StaticResource DbPipelineItemsStyle}"
                                      ItemsSource="{Binding WorkflowStages}"
                                      ItemsPanel="{StaticResource DbPipelinePanel}"
                                      ItemTemplate="{StaticResource DbPipelineStageTemplate}"/>
                    </DockPanel>
                </Border>

                <!-- ROW: pulse | mix | in-prod / overdue / pending -->
                <Grid Grid.Row="3" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FACTORY PULSE — modern blue-gradient hero card (the
                         "latest app" look). Brand-blue gradient background,
                         white text, subtle glass circle deco, and a light
                         sparkline. Reads as the page's hero number. -->
                    <!-- Background MUST be the attribute form. As a property
                         ELEMENT (<DynamicResource ResourceKey=.../>) WPF does
                         not treat this as a deferred reference: it assigns the
                         DynamicResourceExtension OBJECT to Background instead
                         of resolving it, so the card rendered fully
                         TRANSPARENT. This was the only such site in the app. -->
                    <Border Grid.Column="0"
                            Margin="0,0,18,0"
                            Background="{DynamicResource DashHeroBlueBrush}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            ClipToBounds="True"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Glass specular highlight -->
                            <Border Height="1" VerticalAlignment="Top"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    Opacity="0.6" IsHitTestVisible="False"/>
                            <!-- Decorative glass circles -->
                            <Ellipse Width="200" Height="200"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-70,-60,0"
                                     Fill="{DynamicResource Surface.Primary.BorderBrush}" Opacity="0.06"
                                     IsHitTestVisible="False"/>
                            <Ellipse Width="140" Height="140"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,-30,-50"
                                     Fill="{DynamicResource Surface.Primary.BorderBrush}" Opacity="0.04"
                                     IsHitTestVisible="False"/>
                            <Grid Margin="18,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Dashboard.FactoryPulse}"
                                               FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                               Foreground="{DynamicResource OnAccentSecondaryForegroundBrush}"
                                               IsHitTestVisible="False"/>
                                    <Viewbox HorizontalAlignment="Left" Stretch="Uniform"
                                             StretchDirection="DownOnly" Margin="0,8,12,4">
                                        <TextBlock Text="{Binding PulseDisplay}"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   FontSize="{StaticResource TextDisplay}" FontWeight="Bold"
                                                   Margin="0"/>
                                    </Viewbox>
                                    <TextBlock Text="{Binding PulseHint}"
                                               FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                </StackPanel>
                                <mini:MiniBarChartControl Grid.Column="1"
                                                          Height="72"
                                                          VerticalAlignment="Bottom"
                                                          Margin="0,24,0,0"
                                                          Values="{Binding PulseSpark}"
                                                          BarBrush="White"
                                                          HighlightBrush="{DynamicResource OnAccentSecondaryForegroundBrush}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DbCardStyle}"
                            Margin="0,0,18,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dashboard.DeliveryMix}"
                                       Style="{StaticResource DbSectionTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Dashboard.NotesRemainingPcs}"
                                       Style="{StaticResource DbSectionSubStyle}"/>
                            <donut:DonutChartControl Height="150"
                                                     Slices="{Binding DeliveryMixSlices}"
                                                     HoleLabel="MIX"
                                                     EmptyMessage="No delivery movement yet."
                                                     Thickness="16"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource DbCardStyle}" Margin="0,0,0,18" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dashboard.Production}"
                                           Style="{StaticResource DbKpiLabelStyle}"/>
                                <TextBlock Text="{Binding InProductionDisplay}"
                                           Style="{StaticResource DbKpiValueStyle}"
                                           Foreground="{DynamicResource InfoBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DbCardStyle}" Margin="0,0,0,18" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Common.Overdue}"
                                           Style="{StaticResource DbKpiLabelStyle}"/>
                                <TextBlock Text="{Binding OverdueDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DbKpiValueStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOverdueJobs}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DbCardStyle}" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dashboard.PendingPCS}"
                                           Style="{StaticResource DbKpiLabelStyle}"/>
                                <TextBlock Text="{Binding PendingPcsDisplay}"
                                           Style="{StaticResource DbKpiValueStyle}"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ROW: trend + activity (2026-08-25 rev 2: activity
                     column widened 1* -> 1.2* so feed rows breathe) -->
                <Grid Grid.Row="4" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DbCardStyle}" Margin="0,0,18,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Dashboard.RevenueTrend}"
                                           Style="{StaticResource DbSectionTitleStyle}"/>
                                <TextBlock Text="{Binding ChartTitle}"
                                           Style="{StaticResource DbMetaStyle}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Style="{StaticResource DbChartWellStyle}">
                                <trend:TrendChartControl
                                    Points="{Binding MonthlySalesBars}"
                                    SeriesKind="Bar"
                                    ValuePrefix="AED "
                                    EmptyMessage="No revenue recorded yet."
                                    SeriesBrush="{DynamicResource AccentBrush}"
                                    SeriesEndBrush="{DynamicResource AccentDarkBrush}"
                                    GridBrush="{DynamicResource DividerBrush}"
                                    LabelBrush="{DynamicResource TextTertiaryBrush}"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DbCardStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Dashboard.RecentDocuments}"
                                       Style="{StaticResource DbSectionTitleStyle}"
                                       Margin="0,0,0,8"/>
                            <!-- Mouse-wheel scroller. The page ScrollViewer above
                                 owns vertical scrolling, so this inner list is
                                 bounded (so it doesn't grow forever) and uses
                                 SmartScrollBubblingBehavior to grab the wheel
                                 when the pointer is over it and hand the event
                                 back to the outer scroller at the boundary —
                                 no more "stuck" / no-scroll Recent documents. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True"
                                          PanningMode="VerticalOnly"
                                          MaxHeight="480"
                                          behaviors:SmoothScrollBehavior.IsEnabled="True"
                                          behaviors:SmartScrollBubblingBehavior.IsEnabled="True"
                                          Focusable="False"
                                          FocusVisualStyle="{x:Null}">
                                <ItemsControl Style="{StaticResource DbFeedItemsStyle}"
                                          ItemsSource="{Binding RecentActivity}"
                                              ItemTemplate="{StaticResource DbFeedRowTemplate}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ROW: sales / production / inventory strips -->
                <Grid Grid.Row="5">
                    <!-- 4 columns since 2026-09-02: the view model computes
                         SalesTiles, ProductionTiles, InventoryTiles AND
                         DeliveryTiles, but only three were ever rendered, so
                         the delivery KPIs were calculated on every refresh and
                         silently thrown away. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource DbCardStyle}" Margin="0,0,18,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Nav.GroupSales}" Style="{StaticResource DbSectionTitleStyle}" Margin="0,0,0,8"/>
                            <ItemsControl Style="{StaticResource DbKpiBandStyle}"
                                          ItemsSource="{Binding SalesTiles}"
                                          ItemTemplate="{StaticResource DbKpiTileTemplate}"
                                          ItemsPanel="{StaticResource DbKpiBandPanel}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource DbCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Module.Production}" Style="{StaticResource DbSectionTitleStyle}" Margin="0,0,0,8"/>
                            <ItemsControl Style="{StaticResource DbKpiBandStyle}"
                                          ItemsSource="{Binding ProductionTiles}"
                                          ItemTemplate="{StaticResource DbKpiTileTemplate}"
                                          ItemsPanel="{StaticResource DbKpiBandPanel}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource DbCardStyle}" Margin="18,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Module.SheetStore}" Style="{StaticResource DbSectionTitleStyle}" Margin="0,0,0,8"/>
                            <ItemsControl Style="{StaticResource DbKpiBandStyle}"
                                          ItemsSource="{Binding InventoryTiles}"
                                          ItemTemplate="{StaticResource DbKpiTileTemplate}"
                                          ItemsPanel="{StaticResource DbKpiBandPanel}"/>
                        </StackPanel>
                    </Border>
                    <!-- Delivery KPIs — same shared template and panel as the
                         other three, so this adds a card without adding any
                         new hardcoded tile markup. -->
                    <Border Grid.Column="3" Style="{StaticResource DbCardStyle}" Margin="18,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Nav.Delivery}" Style="{StaticResource DbSectionTitleStyle}" Margin="0,0,0,8"/>
                            <ItemsControl Style="{StaticResource DbKpiBandStyle}"
                                          ItemsSource="{Binding DeliveryTiles}"
                                          ItemTemplate="{StaticResource DbKpiTileTemplate}"
                                          ItemsPanel="{StaticResource DbKpiBandPanel}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
