<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/Overview/OverviewDashboardView.xaml
     PROJECT: ProGlassAutomation

     2026 COMMAND-CENTRE REDESIGN
     ════════════════════════════
     Reference: the smart-park monitoring console supplied by the user —
     a dense dark control room where every panel is visible at once,
     numbers are the focal point, and chrome is reduced to hairlines.

     WHAT CHANGED AND WHY
     ────────────────────
     1. THEME CORRECTNESS (the "few boxes dynamic, few not" bug).
        This view used to declare 11 local brushes with hardcoded hex:
        CardBgGradient (#FFFFFF → #F4F8FE), CardBorderBrush (#C4D6ED),
        AccentText (#1E40AF) and six *HeaderBrush colours. Those are
        light-theme values compiled into markup, so in Dark theme the
        cards stayed white with near-invisible headings, while the
        neighbouring DynamicResource elements went dark — the exact
        inconsistency reported. ALL of them are gone. Every colour now
        comes from Styles/DashboardStyles.xaml, which resolves through
        DynamicResource against keys defined in BOTH themes.

     2. DENSITY. The old layout was four big cards stacked vertically
        with 22,18 padding and a 160px chart, so the page always
        scrolled and you could never see sales next to production.
        The new grid is a fixed 3-column command board: KPI strip on
        top, then three panels side by side. Compact, one screen.

     3. ICONS. Segoe MDL2 only — the old header used an emoji Tag.

     BINDING CONTRACT — UNCHANGED
     ────────────────────────────
     Every property this view binds already exists on
     OverviewDashboardViewModel and is used with its original name:
       SalesTiles, ProductionTiles, DeliveryTiles, InventoryTiles
       (ObservableCollection<KpiTileModel>: Icon, Label, DisplayValue,
        Accent, IsAlert)
       RecentActivity / HasRecentActivity (ActivityFeedItem)
       MonthlySalesBars / ChartTitle / HasChartData (ChartBarModel)
       IsLoading, HasError, ErrorMessage, LastRefreshed
       NewInvoiceCommand, SavedInvoicesCommand, ViewStockCommand,
       ViewJobsCommand, ViewDeliveriesCommand
     No ViewModel edit was required for this redesign.
     ExportReportCommand is intentionally NOT surfaced: it is wired as
     RelayCommand(_ => { }, _ => false) — a permanently disabled no-op,
     so showing it would be a dead button.
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Dashboard.Overview.OverviewDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             ACTIVITY ROW
             Uses the model's own StatusColor / TintColor brush KEYS
             (resolved by BrushKeyConverter), which is already the
             theme-aware path — those keys point at theme brushes.
        ═══════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="DashActivityRowTemplate">
            <Border Background="{Binding TintColor,
                                 Converter={StaticResource BrushKeyConverter}}"
                    CornerRadius="7"
                    Padding="9,7"
                    Margin="0,0,0,5"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="24" Height="24"
                            CornerRadius="6"
                            VerticalAlignment="Top"
                            Margin="0,0,9,0"
                            Background="{Binding StatusColor,
                                         Converter={StaticResource BrushKeyConverter}}">
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{Binding SubTitle}"
                                   FontSize="10"
                                   Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <TextBlock Text="{Binding ValueDisplay}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <Border CornerRadius="4"
                                Padding="5,1"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Right"
                                Background="{Binding StatusColor,
                                             Converter={StaticResource BrushKeyConverter}}">
                            <TextBlock Text="{Binding StatusLabel}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT — ambient wash stays inside a BitmapCached Canvas so
         scrolling costs nothing (kept from the previous version; it
         was a genuine performance win and both brushes are themed).
    ═══════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource ModuleBackgroundBrush}">

        <Canvas Panel.ZIndex="0"
                IsHitTestVisible="False"
                CacheMode="BitmapCache">
            <Rectangle Fill="{DynamicResource DashAmbientBrush}"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource AncestorType=Canvas}}"/>
        </Canvas>

        <ScrollViewer Panel.ZIndex="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="14,12,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- command bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- status strip -->
                    <RowDefinition Height="Auto"/>
                    <!-- KPI board -->
                    <RowDefinition Height="Auto"/>
                    <!-- analysis row -->
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════════════════════
                     QUICK ACTIONS

                     The title, module icon and last-refreshed timestamp
                     used to be repeated here. The workspace shell now
                     renders all three for whichever module is active, so
                     showing them again would be the same information
                     twice on one screen. Only the actions remain.
                ═══════════════════════════════════════════════════ -->
                <Grid Grid.Row="0" Margin="2,0,2,10">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource DashActionButtonPrimaryStyle}"
                                Content="NEW INVOICE"
                                Tag="&#xE710;"
                                Margin="0,0,7,0"
                                Cursor="Hand"
                                ToolTip="Start a new proforma invoice"
                                Command="{Binding NewInvoiceCommand}"/>
                        <Button Style="{StaticResource DashActionButtonStyle}"
                                Content="INVOICES"
                                Tag="&#xE8C8;"
                                Margin="0,0,7,0"
                                Cursor="Hand"
                                ToolTip="Open saved invoices"
                                Command="{Binding SavedInvoicesCommand}"/>
                        <Button Style="{StaticResource DashActionButtonStyle}"
                                Content="STOCK"
                                Tag="&#xE7B8;"
                                Margin="0,0,7,0"
                                Cursor="Hand"
                                ToolTip="Open sheet store"
                                Command="{Binding ViewStockCommand}"/>
                        <Button Style="{StaticResource DashActionButtonStyle}"
                                Content="JOBS"
                                Tag="&#xE9F9;"
                                Margin="0,0,7,0"
                                Cursor="Hand"
                                ToolTip="Open job orders"
                                Command="{Binding ViewJobsCommand}"/>
                        <Button Style="{StaticResource DashActionButtonStyle}"
                                Content="DELIVERIES"
                                Tag="&#xE806;"
                                Cursor="Hand"
                                ToolTip="Open delivery notes"
                                Command="{Binding ViewDeliveriesCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════════
                     STATUS STRIP — loading / error. Collapsed when idle
                     so it never steals vertical space.
                ═══════════════════════════════════════════════════ -->
                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource DashCardStyle}"
                            Margin="2,0,2,8"
                            Padding="12,8"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Loading live business data…"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="2,0,2,8"
                            Padding="12,8"
                            CornerRadius="{StaticResource DashCardRadius}"
                            Background="{DynamicResource TintRedBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            Visibility="{Binding HasError,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE783;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════
                     KPI BOARD — 4 domains across one row.
                     UniformGrid keeps the columns equal at any width;
                     tiles inside each panel wrap so nothing clips.
                ═══════════════════════════════════════════════════ -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">

                    <!-- SALES -->
                    <Border Style="{StaticResource DashCardStyle}" Margin="0,0,8,8" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                <Border Width="20" Height="20"
                                        CornerRadius="5"
                                        Background="{DynamicResource AccentBrush}"
                                        Margin="0,0,7,0">
                                    <TextBlock Text="&#xE8EF;"
                                               Style="{StaticResource DashGlyphStyle}"
                                               FontSize="11"/>
                                </Border>
                                <TextBlock Text="SALES"
                                           Style="{StaticResource DashSectionLabelStyle}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding SalesTiles}"
                                          ItemTemplate="{StaticResource DashKpiTileTemplate}"
                                          ItemsPanel="{StaticResource DashTileWrapPanel}"/>
                        </StackPanel>
                    </Border>

                    <!-- PRODUCTION -->
                    <Border Style="{StaticResource DashCardStyle}" Margin="0,0,8,8" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                <Border Width="20" Height="20"
                                        CornerRadius="5"
                                        Background="{DynamicResource TintPurpleBrush}"
                                        Margin="0,0,7,0">
                                    <TextBlock Text="&#xE9F9;"
                                               Style="{StaticResource DashGlyphStyle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </Border>
                                <TextBlock Text="PRODUCTION"
                                           Style="{StaticResource DashSectionLabelStyle}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ProductionTiles}"
                                          ItemTemplate="{StaticResource DashKpiTileTemplate}"
                                          ItemsPanel="{StaticResource DashTileWrapPanel}"/>
                        </StackPanel>
                    </Border>

                    <!-- DELIVERY -->
                    <Border Style="{StaticResource DashCardStyle}" Margin="0,0,8,8" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                <Border Width="20" Height="20"
                                        CornerRadius="5"
                                        Background="{DynamicResource WarningBrush}"
                                        Margin="0,0,7,0">
                                    <TextBlock Text="&#xE806;"
                                               Style="{StaticResource DashGlyphStyle}"
                                               FontSize="11"/>
                                </Border>
                                <TextBlock Text="DELIVERY"
                                           Style="{StaticResource DashSectionLabelStyle}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding DeliveryTiles}"
                                          ItemTemplate="{StaticResource DashKpiTileTemplate}"
                                          ItemsPanel="{StaticResource DashTileWrapPanel}"/>
                        </StackPanel>
                    </Border>

                    <!-- INVENTORY -->
                    <Border Style="{StaticResource DashCardStyle}" Margin="0,0,8,8" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                <Border Width="20" Height="20"
                                        CornerRadius="5"
                                        Background="{DynamicResource InfoBrush}"
                                        Margin="0,0,7,0">
                                    <TextBlock Text="&#xE7B8;"
                                               Style="{StaticResource DashGlyphStyle}"
                                               FontSize="11"/>
                                </Border>
                                <TextBlock Text="INVENTORY"
                                           Style="{StaticResource DashSectionLabelStyle}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding InventoryTiles}"
                                          ItemTemplate="{StaticResource DashKpiTileTemplate}"
                                          ItemsPanel="{StaticResource DashTileWrapPanel}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- ═══════════════════════════════════════════════════
                     ANALYSIS ROW — revenue chart (2/3) + activity (1/3),
                     side by side like the reference console.
                ═══════════════════════════════════════════════════ -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- REVENUE TREND -->
                    <Border Grid.Column="0"
                            Style="{StaticResource DashCardStyle}"
                            Margin="2,0,4,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20"
                                            CornerRadius="5"
                                            Background="{DynamicResource AccentBrush}"
                                            Margin="0,0,7,0">
                                        <TextBlock Text="&#xE9D9;"
                                                   Style="{StaticResource DashGlyphStyle}"
                                                   FontSize="11"/>
                                    </Border>
                                    <TextBlock Text="REVENUE TREND"
                                               Style="{StaticResource DashSectionLabelStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ChartTitle}"
                                           Style="{StaticResource DashCaptionStyle}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Revenue trend.

                                 This was an ItemsControl of bare Borders
                                 whose Height came from a ScaleConverter:
                                 no value axis, no gridlines, no hover, no
                                 tooltip, and the tallest bar was always
                                 full height regardless of its value, so
                                 the chart could not be read quantitatively.

                                 TrendChartControl draws a real plot and
                                 owns its own empty state, so the separate
                                 empty-state Border below is gone. -->
                            <trend:TrendChartControl
                                Height="150"
                                Points="{Binding MonthlySalesBars}"
                                SeriesKind="Bar"
                                ValuePrefix="AED "
                                EmptyMessage="No revenue recorded yet."
                                SeriesBrush="{DynamicResource AccentBrush}"
                                GridBrush="{DynamicResource DividerBrush}"
                                LabelBrush="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- RECENT ACTIVITY -->
                    <Border Grid.Column="1"
                            Style="{StaticResource DashCardStyle}"
                            Margin="4,0,2,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="20" Height="20"
                                        CornerRadius="5"
                                        Background="{DynamicResource TintPurpleBrush}"
                                        Margin="0,0,7,0">
                                    <TextBlock Text="&#xE81C;"
                                               Style="{StaticResource DashGlyphStyle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </Border>
                                <TextBlock Text="RECENT ACTIVITY"
                                           Style="{StaticResource DashSectionLabelStyle}"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding RecentActivity}"
                                          ItemTemplate="{StaticResource DashActivityRowTemplate}"
                                          Visibility="{Binding HasRecentActivity,
                                              Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Border Padding="0,26"
                                    Visibility="{Binding HasRecentActivity,
                                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE81C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="No activity yet"
                                               FontSize="11"
                                               Margin="0,7,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
