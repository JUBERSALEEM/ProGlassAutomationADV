<UserControl x:Class="ProGlassAutomation.Views.Dashboard.Overview.OverviewDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProGlassAutomation.Views.Dashboard.Overview"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             xmlns:mini="clr-namespace:ProGlassAutomation.Controls.MiniBarChart"
             FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"
             Background="{DynamicResource ApplicationBackground}" UseLayoutRounding="True"
             SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType" SizeChanged="OnOverviewSizeChanged" Loaded="OnOverviewLoaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False" PanningMode="VerticalOnly" Focusable="False"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="28,14,28,30">
            <!-- Header: actual commands/data, never the illustration's sample figures. -->
            <Grid x:Name="HeroHeader" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="HeroIdentity" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Dashboard.FactoryPulse}" Style="{StaticResource Ov.Title}"/>
                    <TextBlock Text="{DynamicResource Dashboard.OperationalAnalyticsInvoicesJobsDelivery}"
                               Style="{StaticResource Ov.Meta}" Margin="0,7,16,0"/>
                </StackPanel>
                <StackPanel x:Name="HeroActions" Grid.Column="1" VerticalAlignment="Center">
                    <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Border x:Name="SnapshotBadge" Background="{DynamicResource SurfaceSecondary}" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Snapshot" Style="{StaticResource Ov.Meta}"/>
                        </Border>
                        <TextBlock Text="{Binding LastRefreshed}" Style="{StaticResource Ov.Meta}" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <WrapPanel>
                        <!-- Existing NewInvoiceCommand opens PROFORMA, not TaxInvoice. -->
                        <Button Content="+ New proforma" Command="{Binding NewInvoiceCommand}"
                                Style="{StaticResource Ov.PrimaryButton}" Margin="0,0,8,4"
                                ToolTip="Create a new proforma invoice"/>
                        <Button Content="{DynamicResource Dashboard.Jobs}" Command="{Binding ViewJobsCommand}"
                                Style="{StaticResource Ov.Button}" Margin="0,0,8,4"/>
                        <Button Content="{DynamicResource Dashboard.Deliveries}" Command="{Binding ViewDeliveriesCommand}"
                                Style="{StaticResource Ov.Button}" Margin="0,0,0,4"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <!-- Explicit failure: never paint a failed load as a healthy zero dashboard. -->
            <Border Style="{StaticResource Ov.Card}" Background="{DynamicResource StatusErrorSurface}" Margin="0,0,0,18"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                    AutomationProperties.LiveSetting="Assertive">
                <StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Ov.Text}" Foreground="{DynamicResource StatusError}"/>
                    <TextBlock Text="Switch to another dashboard tab and return to Overview to retry."
                               Style="{StaticResource Ov.Meta}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <!-- Static skeleton deliberately avoids an endless animation/reduced-motion conflict. -->
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Loading overview">
                <Border Style="{StaticResource Ov.Card}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Loading overview…" Style="{StaticResource Ov.CardTitle}" Margin="0,0,0,22"/>
                        <Border Style="{StaticResource Ov.Skeleton}" Width="180" HorizontalAlignment="Left"/>
                        <Border Style="{StaticResource Ov.Skeleton}" Height="44" MaxWidth="430" HorizontalAlignment="Stretch"/>
                        <Border Style="{StaticResource Ov.Skeleton}" Height="100"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Ov.Card}" Margin="0,0,0,18">
                    <StackPanel><Border Style="{StaticResource Ov.Skeleton}" Width="210" HorizontalAlignment="Left"/>
                        <Border Style="{StaticResource Ov.Skeleton}" Height="230"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- 1. Purple financial bento + four independent delivery counters. -->
                <Grid x:Name="PrimaryGrid" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="PulseCard" Style="{StaticResource Ov.Card}" Background="{DynamicResource HeroBackground}" BorderThickness="0" MinHeight="218">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Total proforma value" Style="{StaticResource Ov.CardTitle}" Foreground="{DynamicResource TextOnAccent}"/>
                            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,18,0,14">
                                <TextBlock Text="{Binding PulseDisplay}" Style="{StaticResource Ov.Value}" FontSize="38" Foreground="{DynamicResource TextOnAccent}"/>
                            </Viewbox>
                            <TextBlock Grid.Row="2" Text="{Binding PulseHint}" Style="{StaticResource Ov.Text}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccent}"/>
                            <Grid Grid.Row="3" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Proforma values · VAT included" Style="{StaticResource Ov.Meta}" Foreground="{DynamicResource TextOnAccent}" VerticalAlignment="Bottom" Margin="0,0,10,0"/>
                                <mini:MiniBarChartControl Grid.Column="1" Height="46" Values="{Binding PulseSpark}"
                                                          BarBrush="{DynamicResource TextOnAccent}" HighlightBrush="{DynamicResource TextOnAccent}"
                                                          AutomationProperties.Name="Six-month proforma sparkline"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="DeliveryCard" Grid.Column="1" Style="{StaticResource Ov.Card}" Margin="18,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Delivery snapshot" Style="{StaticResource Ov.CardTitle}"/>
                            <TextBlock Text="Notes and pieces are separate units" Style="{StaticResource Ov.Meta}" Margin="0,5,0,14"/>
                            <ItemsControl ItemsSource="{Binding DeliveryMixSlices}" ItemTemplate="{StaticResource Ov.DeliveryTemplate}" Margin="-5,0,-5,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding DeliveryColumns, RelativeSource={RelativeSource AncestorType={x:Type local:OverviewDashboardView}}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="No delivery movement yet." Margin="0,10,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Ov.Meta}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DeliveryMixSlices, Converter={StaticResource Ov.EmptyDelivery}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- 2–3. Stats above the area chart; the document feed spans both on the right. -->
                <Grid x:Name="AnalyticsGrid" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <!-- 2. Three operational stats, not extra invented KPIs. -->
                    <UniformGrid x:Name="StatsBand" Grid.Row="0" Columns="{Binding StatColumns, RelativeSource={RelativeSource AncestorType={x:Type local:OverviewDashboardView}}}" Margin="-7,0,-7,11">
                        <Border Style="{StaticResource Ov.Card}" Margin="7,0,7,7">
                            <StackPanel><TextBlock Text="{DynamicResource Dashboard.Production}" Style="{StaticResource Ov.Meta}"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding InProductionDisplay}" Style="{StaticResource Ov.Value}" Foreground="{DynamicResource AccentPrimary}"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Ov.Card}" Margin="7,0,7,7">
                            <StackPanel><TextBlock Text="{DynamicResource Common.Overdue}" Style="{StaticResource Ov.Meta}"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,12,0,0">
                                <TextBlock Text="{Binding OverdueDisplay}">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Ov.Value}">
                                        <Style.Triggers><DataTrigger Binding="{Binding HasOverdueJobs}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StatusError}"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Ov.Card}" Margin="7,0,7,7">
                            <StackPanel><TextBlock Text="{DynamicResource Dashboard.PendingPCS}" Style="{StaticResource Ov.Meta}"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding PendingPcsDisplay}" Style="{StaticResource Ov.Value}" Foreground="{DynamicResource StatusWarning}"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border x:Name="TrendCard" Grid.Row="1" Style="{StaticResource Ov.Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Proforma value trend" Style="{StaticResource Ov.CardTitle}"/>
                            <TextBlock Grid.Row="1" Text="{Binding ChartTitle}" Style="{StaticResource Ov.Meta}" Margin="0,6,0,18"/>
                            <trend:TrendChartControl Grid.Row="2" Height="260" Points="{Binding MonthlySalesBars}" SeriesKind="Area"
                                                     ValuePrefix="AED " EmptyMessage="No proforma value recorded yet."
                                                     SeriesBrush="{DynamicResource AccentPrimary}" SeriesEndBrush="{DynamicResource AccentSoft}"
                                                     GridBrush="{DynamicResource BorderSubtle}" LabelBrush="{DynamicResource TextMuted}"
                                                     AutomationProperties.Name="Monthly proforma value, in AED"/>
                        </Grid>
                    </Border>
                    <Border x:Name="ActivityCard" Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Ov.Card}" Margin="18,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Dashboard.RecentDocuments}" Style="{StaticResource Ov.CardTitle}"/>
                            <TextBlock Grid.Row="1" Text="Latest cross-module activity" Style="{StaticResource Ov.Meta}" Margin="0,6,0,14"/>
                            <!-- Recent documents: retain the complete 20-item feed and wheel bubbling. -->
                            <ScrollViewer Grid.Row="2" MaxHeight="440" MinHeight="220" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" PanningMode="VerticalOnly"
                                          behaviors:SmoothScrollBehavior.IsEnabled="True" behaviors:SmartScrollBubblingBehavior.IsEnabled="True"
                                          Visibility="{Binding HasRecentActivity, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding RecentActivity}" ItemTemplate="{StaticResource Ov.FeedTemplate}"/>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="12,40"
                                        Visibility="{Binding HasRecentActivity, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource Ov.Glyph}" FontSize="28"/>
                                <TextBlock Text="No recent documents yet." Style="{StaticResource Ov.Text}" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                                <TextBlock Text="New documents and stock activity will appear here." Style="{StaticResource Ov.Meta}" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <!-- 4. Full five-stage rail. Unknown tax figures remain em dashes from the VM. -->
                <Border Style="{StaticResource Ov.Card}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Order-to-cash" Style="{StaticResource Ov.CardTitle}"/>
                        <TextBlock Text="Stage counters · quote totals, work in progress and payment status" Style="{StaticResource Ov.Meta}" Margin="0,6,0,14"/>
                        <ItemsControl ItemsSource="{Binding WorkflowStages}" ItemTemplate="{StaticResource Ov.StageTemplate}" Margin="-5,0,-5,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding PipelineColumns, RelativeSource={RelativeSource AncestorType={x:Type local:OverviewDashboardView}}}"/>
                            </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- 5. Every original collection: 4 sales + 4 production + 4 inventory + 5 delivery. -->
                <UniformGrid Columns="{Binding KpiColumns, RelativeSource={RelativeSource AncestorType={x:Type local:OverviewDashboardView}}}" Margin="-7,0,-7,0">
                    <Border Style="{StaticResource Ov.Card}" Margin="7,0,7,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Nav.GroupSales}" Style="{StaticResource Ov.CardTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="Proforma values · VAT included" Style="{StaticResource Ov.Meta}" Margin="0,0,0,18"/>
                            <ItemsControl Style="{StaticResource Ov.KpiHost}" ItemsSource="{Binding SalesTiles}" ItemTemplate="{StaticResource Ov.KpiTemplate}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Ov.Card}" Margin="7,0,7,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Module.Production}" Style="{StaticResource Ov.CardTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="Job order snapshot" Style="{StaticResource Ov.Meta}" Margin="0,0,0,18"/>
                            <ItemsControl Style="{StaticResource Ov.KpiHost}" ItemsSource="{Binding ProductionTiles}" ItemTemplate="{StaticResource Ov.KpiTemplate}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Ov.Card}" Margin="7,0,7,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Nav.GroupInventory}" Style="{StaticResource Ov.CardTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="Stock valued at selling price" Style="{StaticResource Ov.Meta}" Margin="0,0,0,18"/>
                            <ItemsControl Style="{StaticResource Ov.KpiHost}" ItemsSource="{Binding InventoryTiles}" ItemTemplate="{StaticResource Ov.KpiTemplate}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Ov.Card}" Margin="7,0,7,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Nav.Delivery}" Style="{StaticResource Ov.CardTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="Notes and pieces, separately" Style="{StaticResource Ov.Meta}" Margin="0,0,0,18"/>
                            <ItemsControl Style="{StaticResource Ov.KpiHost}" ItemsSource="{Binding DeliveryTiles}" ItemTemplate="{StaticResource Ov.KpiTemplate}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="Proforma value is not collected revenue. Inventory uses selling-price valuation." Style="{StaticResource Ov.Meta}"/>
                        <TextBlock Text="Payment count includes paid / partly paid tax invoices issued this month." Style="{StaticResource Ov.Meta}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
