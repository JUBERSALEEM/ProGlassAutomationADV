<UserControl x:Class="ProGlassAutomation.Views.Dashboard.Overview.OverviewDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:ProGlassAutomation.Controls.GradientHeroCard"
             xmlns:spark="clr-namespace:ProGlassAutomation.Controls.Sparkline"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══════════ CARDS ═══════════ -->

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Padding"         Value="24"/>
            <Setter Property="Margin"          Value="8"/>
        </Style>

        <!-- tinted KPI card — TintColor is a theme brush key -->
        <!-- Phase 9.4b: added visible border for definition -->
        <Style x:Key="TintedCardStyle" TargetType="Border">
            <Setter Property="Background"
                    Value="{Binding TintColor,
                            Converter={StaticResource BrushKeyConverter}}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Padding"         Value="22"/>
            <Setter Property="Margin"          Value="8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                    <Setter Property="BorderBrush"     Value="{DynamicResource DangerBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="8,0,8,4"/>
        </Style>

        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="8,0,8,10"/>
        </Style>

        <!-- ═══════════ QUICK ACTION BUTTONS ═══════════ -->

        <Style x:Key="QuickActionPrimary" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="24,14"/>
            <Setter Property="Margin"          Value="0,0,10,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="24"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="16" VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickActionSecondary" TargetType="Button" BasedOn="{StaticResource QuickActionPrimary}">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="24"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="16" VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ KPI DATA TEMPLATE (shared by KpiCards + ProductionCards) ═══════════ -->
        <DataTemplate x:Key="KpiTemplate">
            <Border Style="{StaticResource TintedCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="11"
                                Background="{Binding BadgeColor,
                                             Converter={StaticResource BrushKeyConverter}}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Icon}"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DisplayValue}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,14,0,0"/>
                    <TextBlock Text="{Binding SubLabel}"
                               FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap"/>

                    <!-- Optional sparkline -->
                    <spark:SparklineControl Height="34"
                                            Margin="0,12,0,0"
                                            Values="{Binding SparklineValues}"
                                            LineBrush="{Binding BadgeColor,
                                                        Converter={StaticResource BrushKeyConverter}}"
                                            AreaBrush="{Binding BadgeColor,
                                                        Converter={StaticResource BrushKeyConverter}}"
                                            LineThickness="2"
                                            ShowArea="True">
                        <spark:SparklineControl.Style>
                            <Style TargetType="spark:SparklineControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SparklineValues}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </spark:SparklineControl.Style>
                    </spark:SparklineControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══════════ ACTIVITY FEED ROW ═══════════ -->
        <DataTemplate x:Key="ActivityTemplate">
            <Border Padding="14,12" Margin="0,0,0,8"
                    Background="{Binding TintColor,
                                 Converter={StaticResource BrushKeyConverter}}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{Binding StatusColor,
                                                Converter={StaticResource BrushKeyConverter}}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="40" Height="40" CornerRadius="10"
                            Background="{Binding StatusColor,
                                         Converter={StaticResource BrushKeyConverter}}"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Icon}" FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubTitle}"
                                   FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Margin="12,0,0,0">
                        <TextBlock Text="{Binding ValueDisplay}"
                                   FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <Border CornerRadius="10" Margin="0,6,0,0"
                                Padding="10,4" HorizontalAlignment="Right"
                                Background="{Binding StatusColor,
                                             Converter={StaticResource BrushKeyConverter}}">
                            <TextBlock Text="{Binding StatusLabel}"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,40">

            <StackPanel Margin="8,0,8,20">
                <TextBlock Text="Dashboard"
                           FontSize="30" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <TextBlock Text="Plan, prioritize, and accomplish your business tasks with ease."
                           FontSize="13" Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>

            <Border Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="12" Margin="8,0,8,12">
                <TextBlock Text="⏳  Loading overview…" FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource TintRedBrush}"
                    CornerRadius="12"
                    Padding="16" Margin="8,0,8,12">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="13" TextWrapping="Wrap"/>
            </Border>

            <!-- ── QUICK ACTIONS ──────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="8,0,8,20">
                <Button Style="{StaticResource QuickActionPrimary}"
                        Content="New Invoice" Tag="➕"
                        Command="{Binding NewInvoiceCommand}"/>
                <Button Style="{StaticResource QuickActionSecondary}"
                        Content="Saved Invoices" Tag="📋"
                        Command="{Binding SavedInvoicesCommand}"/>
                <Button Style="{StaticResource QuickActionSecondary}"
                        Content="View Stock" Tag="📦"
                        Command="{Binding ViewStockCommand}"/>
                <Button Style="{StaticResource QuickActionSecondary}"
                        Content="Export Report" Tag="📊"
                        Command="{Binding ExportReportCommand}"
                        IsEnabled="False"/>
            </StackPanel>

            <!-- ── HERO + KPI CARDS ─────────────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- HERO CARD — reusable GradientHeroCard control (Phase 8.3) -->
                <hero:GradientHeroCard Grid.Column="0"
                                       Icon="💰"
                                       Value="{Binding TotalSalesDisplay}"
                                       Label="Total Sales"
                                       TrendArrow="↗"
                                       TrendText="{Binding HeroTrendText}"
                                       TrendVisibility="{Binding HeroTrendVisibility}"
                                       GradientStartColor="#0F4C3A"
                                       GradientEndColor="#22C55E"
                                       Margin="8"
                                       MinHeight="180"/>

                <!-- 3 secondary cards -->
                <ItemsControl Grid.Column="1" Grid.ColumnSpan="3"
                              ItemsSource="{Binding KpiCards}"
                              ItemTemplate="{StaticResource KpiTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <!-- ══ PRODUCTION SNAPSHOT (Phase 9.4a) ══════════════════════ -->
            <TextBlock Text="Production Snapshot"
                       Style="{StaticResource SectionTitle}"
                       Margin="8,28,8,4"/>
            <TextBlock Text="Job Order activity across the factory floor"
                       Style="{StaticResource SectionSubtitle}"/>

            <Grid>
                <!-- Has Job Orders -->
                <ItemsControl ItemsSource="{Binding ProductionCards}"
                              ItemTemplate="{StaticResource KpiTemplate}"
                              Visibility="{Binding HasJobOrders,
                                           Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Empty state -->
                <Border Style="{StaticResource CardStyle}"
                        Visibility="{Binding HasJobOrders,
                                     Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" Margin="0,20">
                        <TextBlock Text="🏭" FontSize="42"
                                   HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="No job orders yet"
                                   FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Convert a Proforma Invoice to a Job Order to see production stats here."
                                   FontSize="12" HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── MONTHLY SALES CHART ────────────────────────────────── -->
            <TextBlock Text="Sales Analytics"
                       Style="{StaticResource SectionTitle}"
                       Margin="8,28,8,4"/>
            <TextBlock Text="{Binding ChartTitle}"
                       Style="{StaticResource SectionSubtitle}"/>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <StackPanel Visibility="{Binding HasChartData,
                                             Converter={StaticResource BoolToVisibilityConverter}}">

                        <ItemsControl ItemsSource="{Binding MonthlySalesBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" HorizontalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,0" HorizontalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" VerticalAlignment="Bottom" Height="200">
                                            <TextBlock Text="{Binding ValueDisplay}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       Margin="0,0,0,4"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <Border Width="60"
                                                    CornerRadius="8,8,4,4"
                                                    VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Center"
                                                    Background="{Binding BarColor,
                                                                 Converter={StaticResource ColorStringConverter}}"
                                                    Height="{Binding NormalizedHeight,
                                                             Converter={StaticResource ScaleConverter},
                                                             ConverterParameter=180}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHighlight}" Value="True">
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="20"
                                                                                          ShadowDepth="0"
                                                                                          Opacity="0.4"
                                                                                          Color="#22C55E"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Label}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,10,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Margin="0,4,0,0"
                                Background="{DynamicResource DividerBrush}"/>

                        <TextBlock Text="Values in AED · VAT inclusive"
                                   FontSize="11" HorizontalAlignment="Right"
                                   Margin="0,10,4,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Margin="0,50"
                                Visibility="{Binding HasChartData,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="📊" FontSize="48"
                                   HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="No sales data yet"
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Create your first Proforma Invoice to see sales data."
                                   FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── RECENT ACTIVITY ────────────────────────────────────── -->
            <TextBlock Text="Recent Activity"
                       Style="{StaticResource SectionTitle}"
                       Margin="8,28,8,4"/>
            <TextBlock Text="Latest actions across invoices, sheet store, and job orders"
                       Style="{StaticResource SectionSubtitle}"/>

            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <ItemsControl
                        ItemsSource="{Binding RecentActivity}"
                        ItemTemplate="{StaticResource ActivityTemplate}"
                        Visibility="{Binding HasRecentActivity,
                                     Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <StackPanel HorizontalAlignment="Center" Margin="0,40"
                                Visibility="{Binding HasRecentActivity,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="📭" FontSize="48"
                                   HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="No recent activity"
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Activity from invoices, sheet store, and job orders will appear here."
                                   FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding LastRefreshed}"
                       FontSize="11" Opacity="0.5" Margin="10,14,0,0"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>