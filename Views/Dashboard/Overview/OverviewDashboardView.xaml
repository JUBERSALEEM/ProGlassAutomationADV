<!-- LAYOUT-03 BENTO MOSAIC — Overview. Bindings unchanged. -->
<UserControl x:Class="ProGlassAutomation.Views.Dashboard.Overview.OverviewDashboardView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             xmlns:donut="clr-namespace:ProGlassAutomation.Controls.DonutChart"
             xmlns:mini="clr-namespace:ProGlassAutomation.Controls.MiniBarChart"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="20,16,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- 2026-08-25: revenue trend + recent documents row
                         expanded 220 -> 320 so both cards breathe. -->
                    <RowDefinition Height="*" MinHeight="280"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HERO STRIP -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Factory pulse"
                                   Style="{StaticResource SoftHeroTitleStyle}"/>
                        <TextBlock Text="Operational analytics — invoices, jobs, delivery, stock"
                                   Style="{StaticResource SoftHeroSubtitleStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource SoftChipStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="Live" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LastRefreshed}"
                                   Style="{StaticResource SoftMetaStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Button Content="New Invoice" Tag="&#xE710;"
                                Style="{StaticResource SoftPillAccentStyle}"
                                Command="{Binding NewInvoiceCommand}" ToolTip="Create new tax invoice"/>
                        <Button Content="Jobs" Tag="&#xE9F9;"
                                Style="{StaticResource SoftPillButtonStyle}"
                                Command="{Binding ViewJobsCommand}" ToolTip="View all job orders"/>
                        <Button Content="Deliveries" Tag="&#xE806;" Margin="0"
                                Style="{StaticResource SoftPillButtonStyle}"
                                Command="{Binding ViewDeliveriesCommand}" ToolTip="View all delivery notes"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource SoftSectionStyle}"
                        Padding="16,12"
                        Visibility="{Binding IsLoading,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Loading live business data…"
                               Style="{StaticResource SoftKpiFootStyle}"/>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource SoftSectionStyle}"
                        Padding="16,12"
                        Background="{DynamicResource TintRedBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        Visibility="{Binding HasError,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="{StaticResource TextBody}" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"/>
                </Border>


                <!-- ROW: pulse | mix | in-prod / overdue / pending -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FACTORY PULSE — modern blue-gradient hero card (the
                         "latest app" look). Brand-blue gradient background,
                         white text, subtle glass circle deco, and a light
                         sparkline. Reads as the page's hero number. -->
                    <Border Grid.Column="0"
                            Margin="0,0,18,0"
                            
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            ClipToBounds="True"
                            BorderBrush="{DynamicResource GlassBorderGradientCrystal}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <DynamicResource ResourceKey="DashHeroBlueBrush"/>
                        </Border.Background>
                        <Grid>
                            <!-- Glass specular highlight -->
                            <Border Height="1" VerticalAlignment="Top"
                                    Background="{DynamicResource GlassSpecularHighlight}"
                                    Opacity="0.6" IsHitTestVisible="False"/>
                            <!-- Decorative glass circles -->
                            <Ellipse Width="200" Height="200"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-70,-60,0"
                                     Fill="White" Opacity="0.06"
                                     IsHitTestVisible="False"/>
                            <Ellipse Width="140" Height="140"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,-30,-50"
                                     Fill="White" Opacity="0.04"
                                     IsHitTestVisible="False"/>
                            <Grid Margin="18,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="FACTORY PULSE"
                                               FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                               Foreground="{DynamicResource OnAccentSecondaryForegroundBrush}"
                                               IsHitTestVisible="False"/>
                                    <Viewbox HorizontalAlignment="Left" Stretch="Uniform"
                                             StretchDirection="DownOnly" Margin="0,8,12,4">
                                        <TextBlock Text="{Binding PulseDisplay}"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   FontSize="30" FontWeight="Bold"
                                                   Margin="0"/>
                                    </Viewbox>
                                    <TextBlock Text="{Binding PulseHint}"
                                               FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                </StackPanel>
                                <mini:MiniBarChartControl Grid.Column="1"
                                                          Height="72"
                                                          VerticalAlignment="Bottom"
                                                          Margin="0,24,0,0"
                                                          Values="{Binding PulseSpark}"
                                                          BarBrush="White"
                                                          HighlightBrush="{DynamicResource OnAccentSecondaryForegroundBrush}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SoftCardStyle}"
                            Margin="0,0,18,0">
                        <StackPanel>
                            <TextBlock Text="Delivery mix"
                                       Style="{StaticResource SoftSectionTitleStyle}"/>
                            <TextBlock Text="Notes and remaining pcs"
                                       Style="{StaticResource SoftSectionSubtitleStyle}"/>
                            <donut:DonutChartControl Height="150"
                                                     Slices="{Binding DeliveryMixSlices}"
                                                     HoleLabel="MIX"
                                                     EmptyMessage="No delivery movement yet."
                                                     Thickness="16"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource SoftCardStyle}" Margin="0,0,0,18" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="IN PRODUCTION"
                                           Style="{StaticResource SoftKpiLabelStyle}"/>
                                <TextBlock Text="{Binding InProductionDisplay}"
                                           Style="{StaticResource SoftKpiValueStyle}"
                                           Foreground="{DynamicResource InfoBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SoftCardStyle}" Margin="0,0,0,18" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="OVERDUE"
                                           Style="{StaticResource SoftKpiLabelStyle}"/>
                                <TextBlock Text="{Binding OverdueDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SoftKpiValueStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOverdueJobs}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SoftCardStyle}" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="PENDING PCS"
                                           Style="{StaticResource SoftKpiLabelStyle}"/>
                                <TextBlock Text="{Binding PendingPcsDisplay}"
                                           Style="{StaticResource SoftKpiValueStyle}"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ROW: trend + activity (2026-08-25 rev 2: activity
                     column widened 1* -> 1.2* so feed rows breathe) -->
                <Grid Grid.Row="3" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SoftCardStyle}" Margin="0,0,18,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Revenue trend"
                                           Style="{StaticResource SoftSectionTitleStyle}"/>
                                <TextBlock Text="{Binding ChartTitle}"
                                           Style="{StaticResource SoftMetaStyle}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Style="{StaticResource SoftChartWellStyle}">
                                <trend:TrendChartControl
                                    Points="{Binding MonthlySalesBars}"
                                    SeriesKind="Bar"
                                    ValuePrefix="AED "
                                    EmptyMessage="No revenue recorded yet."
                                    SeriesBrush="{DynamicResource AccentBrush}"
                                    SeriesEndBrush="{DynamicResource AccentDarkBrush}"
                                    GridBrush="{DynamicResource DividerBrush}"
                                    LabelBrush="{DynamicResource MutedForegroundBrush}"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SoftCardStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Recent documents"
                                       Style="{StaticResource SoftSectionTitleStyle}"
                                       Margin="0,0,0,8"/>
                            <!-- Mouse-wheel scroller. The page ScrollViewer above
                                 owns vertical scrolling, so this inner list is
                                 bounded (so it doesn't grow forever) and uses
                                 SmartScrollBubblingBehavior to grab the wheel
                                 when the pointer is over it and hand the event
                                 back to the outer scroller at the boundary —
                                 no more "stuck" / no-scroll Recent documents. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True"
                                          PanningMode="VerticalOnly"
                                          MaxHeight="480"
                                          behaviors:SmoothScrollBehavior.IsEnabled="True"
                                          behaviors:SmartScrollBubblingBehavior.IsEnabled="True"
                                          Focusable="False"
                                          FocusVisualStyle="{x:Null}">
                                <ItemsControl ItemsSource="{Binding RecentActivity}"
                                              ItemTemplate="{StaticResource SoftFeedRowTemplate}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ROW: sales / production / inventory strips -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SoftCardStyle}" Margin="0,0,18,0">
                        <StackPanel>
                            <TextBlock Text="Sales" Style="{StaticResource SoftSectionTitleStyle}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding SalesTiles}"
                                          ItemTemplate="{StaticResource SoftKpiTileTemplate}"
                                          ItemsPanel="{StaticResource SoftKpiRowPanel}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SoftCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Production" Style="{StaticResource SoftSectionTitleStyle}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding ProductionTiles}"
                                          ItemTemplate="{StaticResource SoftKpiTileTemplate}"
                                          ItemsPanel="{StaticResource SoftKpiRowPanel}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SoftCardStyle}" Margin="18,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Sheet store" Style="{StaticResource SoftSectionTitleStyle}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding InventoryTiles}"
                                          ItemTemplate="{StaticResource SoftKpiTileTemplate}"
                                          ItemsPanel="{StaticResource SoftKpiRowPanel}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
