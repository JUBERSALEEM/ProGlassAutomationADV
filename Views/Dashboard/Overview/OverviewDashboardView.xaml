<UserControl x:Class="ProGlassAutomation.Views.Dashboard.Overview.OverviewDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══════════ PARENT CARD ═══════════ -->
        <Style x:Key="ParentCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Padding"         Value="18,16"/>
            <Setter Property="Margin"          Value="6"/>
        </Style>

        <!-- Parent card header stripe -->
        <Style x:Key="ParentCardHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin"      Value="0,0,0,14"/>
        </Style>

        <Style x:Key="ParentCardIcon" TargetType="Border">
            <Setter Property="Width"        Value="34"/>
            <Setter Property="Height"       Value="34"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ParentCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="10,0,0,0"/>
        </Style>

        <!-- ═══════════ NESTED TILE — accent-driven ═══════════ -->
        <DataTemplate x:Key="TileTemplate">
            <Border CornerRadius="10" Padding="12,10" Margin="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Default: green -->
                        <Setter Property="Background" Value="#ECFDF5"/>
                        <Setter Property="BorderBrush" Value="#A7F3D0"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Accent}" Value="Blue">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="BorderBrush" Value="#BFDBFE"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Accent}" Value="Amber">
                                <Setter Property="Background" Value="#FFFBEB"/>
                                <Setter Property="BorderBrush" Value="#FDE68A"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Accent}" Value="Red">
                                <Setter Property="Background" Value="#FEF2F2"/>
                                <Setter Property="BorderBrush" Value="#FECACA"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                <Setter Property="BorderBrush" Value="#DC2626"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Label}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#065F46"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Accent}" Value="Blue">
                                            <Setter Property="Foreground" Value="#1E40AF"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Accent}" Value="Amber">
                                            <Setter Property="Foreground" Value="#92400E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Accent}" Value="Red">
                                            <Setter Property="Foreground" Value="#991B1B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding DisplayValue}"
                               FontSize="18" FontWeight="Bold"
                               Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#065F46"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Accent}" Value="Blue">
                                        <Setter Property="Foreground" Value="#1E3A8A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Accent}" Value="Amber">
                                        <Setter Property="Foreground" Value="#78350F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Accent}" Value="Red">
                                        <Setter Property="Foreground" Value="#7F1D1D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══════════ CHAT-STYLE ACTIVITY ROW ═══════════ -->
        <DataTemplate x:Key="ActivityChatTemplate">
            <Border Padding="10,8" Margin="0,0,0,6"
                    CornerRadius="10"
                    Background="{Binding TintColor,
                                 Converter={StaticResource BrushKeyConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Border Grid.Column="0"
                            Width="32" Height="32" CornerRadius="16"
                            Background="{Binding StatusColor,
                                         Converter={StaticResource BrushKeyConverter}}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding Icon}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Message content -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubTitle}"
                                   FontSize="10" Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Right meta -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ValueDisplay}"
                                   FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <Border CornerRadius="8" Padding="6,2" Margin="0,3,0,0"
                                HorizontalAlignment="Right"
                                Background="{Binding StatusColor,
                                             Converter={StaticResource BrushKeyConverter}}">
                            <TextBlock Text="{Binding StatusLabel}"
                                       FontSize="8" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ═══════════ QUICK ACTION BUTTONS ═══════════ -->
        <Style x:Key="QuickActionPrimary" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="14" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickActionSecondary" TargetType="Button"
               BasedOn="{StaticResource QuickActionPrimary}">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="14" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         SMOOTH SCROLLING: pixel-based + panning enabled
    ═══════════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="18,14,18,24">

            <!-- ── PAGE HEADER ────────────────────────────────────────── -->
            <Grid Margin="6,0,6,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Dashboard"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="Business at a glance — sales, production, delivery, inventory."
                               FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <!-- Quick actions inline -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource QuickActionPrimary}"
                            Content="New Invoice" Tag="➕"
                            Command="{Binding NewInvoiceCommand}"/>
                    <Button Style="{StaticResource QuickActionSecondary}"
                            Content="Invoices" Tag="📋"
                            Command="{Binding SavedInvoicesCommand}"/>
                    <Button Style="{StaticResource QuickActionSecondary}"
                            Content="Jobs" Tag="🏭"
                            Command="{Binding ViewJobsCommand}"/>
                    <Button Style="{StaticResource QuickActionSecondary}"
                            Content="Deliveries" Tag="🚚"
                            Command="{Binding ViewDeliveriesCommand}"/>
                    <Button Style="{StaticResource QuickActionSecondary}"
                            Content="Stock" Tag="📦"
                            Command="{Binding ViewStockCommand}"/>
                </StackPanel>
            </Grid>

            <!-- ── LOADING ────────────────────────────────────────────── -->
            <Border Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="12" Margin="6,0,6,10">
                <TextBlock Text="⏳  Loading overview…" FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

            <!-- ── ERROR ──────────────────────────────────────────────── -->
            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14" Margin="6,0,6,10">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#991B1B"
                           FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 MAIN GRID — 2 columns × 3 rows of parent cards
                 Recent Activity spans 2 rows on the right side
            ═══════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══ 💰 SALES (0,0) ═══ -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource ParentCardStyle}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource ParentCardHeader}">
                            <Border Style="{StaticResource ParentCardIcon}"
                                    Background="#059669">
                                <TextBlock Text="💰" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="SALES"
                                       Style="{StaticResource ParentCardTitle}"
                                       Foreground="#065F46"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding SalesTiles}"
                                      ItemTemplate="{StaticResource TileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══ 🏭 PRODUCTION (0,1) ═══ -->
                <Border Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource ParentCardStyle}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource ParentCardHeader}">
                            <Border Style="{StaticResource ParentCardIcon}"
                                    Background="#1E40AF">
                                <TextBlock Text="🏭" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="PRODUCTION"
                                       Style="{StaticResource ParentCardTitle}"
                                       Foreground="#1E3A8A"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ProductionTiles}"
                                      ItemTemplate="{StaticResource TileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══ 🚚 DELIVERY (1,0) ═══ -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource ParentCardStyle}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource ParentCardHeader}">
                            <Border Style="{StaticResource ParentCardIcon}"
                                    Background="#B45309">
                                <TextBlock Text="🚚" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="DELIVERY"
                                       Style="{StaticResource ParentCardTitle}"
                                       Foreground="#78350F"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding DeliveryTiles}"
                                      ItemTemplate="{StaticResource TileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══ 💬 RECENT ACTIVITY (1,1) — spans 2 rows ═══ -->
                <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
                        Style="{StaticResource ParentCardStyle}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource ParentCardHeader}">
                            <Border Style="{StaticResource ParentCardIcon}"
                                    Background="#4338CA">
                                <TextBlock Text="💬" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                <TextBlock Text="RECENT ACTIVITY"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#3730A3"/>
                                <TextBlock Text="Latest across all modules"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Scrollable chat feed inside the card -->
                        <Border MaxHeight="480"
                                Background="{DynamicResource MenuHoverBrush}"
                                CornerRadius="10"
                                Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="False"
                                          PanningMode="VerticalOnly">
                                <Grid>
                                    <ItemsControl
                                        ItemsSource="{Binding RecentActivity}"
                                        ItemTemplate="{StaticResource ActivityChatTemplate}"
                                        Visibility="{Binding HasRecentActivity,
                                                     Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <StackPanel HorizontalAlignment="Center"
                                                Margin="0,40"
                                                Visibility="{Binding HasRecentActivity,
                                                             Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="📭" FontSize="36"
                                                   HorizontalAlignment="Center" Opacity="0.4"/>
                                        <TextBlock Text="No activity yet"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,10,0,4"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="Activity from all modules will appear here."
                                                   FontSize="11" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══ 📦 INVENTORY (2,0) ═══ -->
                <Border Grid.Row="2" Grid.Column="0"
                        Style="{StaticResource ParentCardStyle}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource ParentCardHeader}">
                            <Border Style="{StaticResource ParentCardIcon}"
                                    Background="#B91C1C">
                                <TextBlock Text="📦" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="INVENTORY"
                                       Style="{StaticResource ParentCardTitle}"
                                       Foreground="#7F1D1D"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding InventoryTiles}"
                                      ItemTemplate="{StaticResource TileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ═══ 📈 SALES CHART — full width below grid ═══ -->
            <Border Style="{StaticResource ParentCardStyle}"
                    Margin="6,10,6,6">
                <StackPanel>
                    <StackPanel Style="{StaticResource ParentCardHeader}">
                        <Border Style="{StaticResource ParentCardIcon}"
                                Background="#0F766E">
                            <TextBlock Text="📈" FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                            <TextBlock Text="SALES ANALYTICS"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#134E4A"/>
                            <TextBlock Text="{Binding ChartTitle}"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <StackPanel Visibility="{Binding HasChartData,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding MonthlySalesBars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" HorizontalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,0" HorizontalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0"
                                                  VerticalAlignment="Bottom"
                                                  Height="160">
                                                <TextBlock Text="{Binding ValueDisplay}"
                                                           FontSize="9" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Top"
                                                           Margin="0,0,0,4"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                <Border Width="46"
                                                        CornerRadius="6,6,3,3"
                                                        VerticalAlignment="Bottom"
                                                        HorizontalAlignment="Center"
                                                        Background="{Binding BarColor,
                                                                     Converter={StaticResource ColorStringConverter}}"
                                                        Height="{Binding NormalizedHeight,
                                                                 Converter={StaticResource ScaleConverter},
                                                                 ConverterParameter=140}"/>
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Label}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Values in AED · VAT inclusive"
                                       FontSize="10" HorizontalAlignment="Right"
                                       Margin="0,10,4,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="0,40"
                                    Visibility="{Binding HasChartData,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="📊" FontSize="36"
                                       HorizontalAlignment="Center" Opacity="0.4"/>
                            <TextBlock Text="No sales data yet"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,4"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Create your first Proforma Invoice to see data."
                                       FontSize="11" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding LastRefreshed}"
                       FontSize="10" Opacity="0.5" Margin="10,10,0,0"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>