<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:layout="clr-namespace:ProGlassAutomation.Views.Dashboard">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Overview/IndigoStudioResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Page-scoped aliases for the existing chart controls. These are NOT
         merged into App.xaml and do not change any other module's theme.
         Bind to the approved palette rather than duplicating its hex values. -->
    <SolidColorBrush x:Key="AccentBrush" Color="{Binding Color, Source={StaticResource Ov.Accent}}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{Binding Color, Source={StaticResource Ov.Accent}}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{Binding Color, Source={StaticResource Ov.Success}}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{Binding Color, Source={StaticResource Ov.Warning}}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{Binding Color, Source={StaticResource Ov.Danger}}"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{Binding Color, Source={StaticResource Ov.Ink}}"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{Binding Color, Source={StaticResource Ov.Muted}}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{Binding Color, Source={StaticResource Ov.Ink}}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{Binding Color, Source={StaticResource Ov.Muted}}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{Binding Color, Source={StaticResource Ov.Muted}}"/>
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="{Binding Color, Source={StaticResource Ov.Surface}}"/>

    <Thickness x:Key="Ds.PageMargin">28,26,28,30</Thickness>
    <Thickness x:Key="Ds.RowPadding">0,16</Thickness>
    <CornerRadius x:Key="Ds.ChipRadius">6</CornerRadius>
    <CornerRadius x:Key="Ds.TileRadius">12</CornerRadius>
    <CornerRadius x:Key="Ds.IconSmRadius">8</CornerRadius>
    <sys:Double x:Key="Ds.FontBodySm">12</sys:Double>
    <sys:Double x:Key="Ds.FontCardSub">14</sys:Double>
    <sys:Double x:Key="Ds.FontGlyph">18</sys:Double>
    <sys:Double x:Key="Ds.FontStatValue">30</sys:Double>

    <Style x:Key="Ds.Content" TargetType="StackPanel">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Ds.CardStyle" TargetType="Border" BasedOn="{StaticResource Ov.Card}"/>
    <Style x:Key="Ds.HeroTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Title}"/>
    <Style x:Key="Ds.HeroSubStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Meta}">
        <Setter Property="Margin" Value="0,7,16,0"/>
    </Style>
    <Style x:Key="Ds.CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.CardTitle}"/>
    <Style x:Key="Ds.CardSubStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Meta}"/>
    <Style x:Key="Ds.MetaStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Meta}"/>
    <Style x:Key="Ds.GlyphStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Glyph}"/>
    <Style x:Key="Ds.LiveChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ov.Soft}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,4"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Ds.LiveTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Meta}"/>
    <Style x:Key="Ds.StateBandStyle" TargetType="Border" BasedOn="{StaticResource Ov.Card}">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
    <Style x:Key="Ds.ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Text}">
        <Setter Property="Foreground" Value="{DynamicResource Ov.Danger}"/>
    </Style>
    <Style x:Key="Ds.AlertBandStyle" TargetType="Border" BasedOn="{StaticResource Ds.StateBandStyle}">
        <Setter Property="Background" Value="{DynamicResource Ov.DangerSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Danger}"/>
    </Style>
    <Style x:Key="Ds.AlertBandTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Ds.ErrorTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Ds.AlertBarStyle" TargetType="Border">
        <Setter Property="Width" Value="3"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="Ds.StatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Meta}"/>
    <Style x:Key="Ds.StatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Value}">
        <Setter Property="Margin" Value="0,12,0,6"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Ds.StatFootStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Meta}"/>
    <Style x:Key="Ds.RowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Text}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Ds.RowSubStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Meta}">
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <Style x:Key="Ds.RowValueStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Text}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Ds.PillTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Meta}">
        <Setter Property="Foreground" Value="{DynamicResource Ov.OnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Ds.BtnGhostStyle" TargetType="Button" BasedOn="{StaticResource Ov.Button}">
        <Setter Property="Margin" Value="0,0,8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Margin="0,0,8,0" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="Tag" Value=""><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ds.BtnPrimaryStyle" TargetType="Button" BasedOn="{StaticResource Ds.BtnGhostStyle}">
        <Setter Property="Background" Value="{DynamicResource Ov.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.OnAccent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Ov.AccentHover}"/></Trigger>
        </Style.Triggers>
    </Style>

    <ItemsPanelTemplate x:Key="Ds.KpiBandPanel">
        <layout:IndigoDashboardPanel MaxColumns="4" MinimumColumnWidth="210" Gap="16"/>
    </ItemsPanelTemplate>
    <Style x:Key="Ds.KpiBandStyle" TargetType="ItemsControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="AlternationCount" Value="1000"/>
    </Style>
    <!-- Both KpiCardModel and KpiTileModel implement this same contract.
         Never bind Accent/TintColor here: they are not on both model types. -->
    <DataTemplate x:Key="Ds.KpiTileTemplate">
        <Border x:Name="Card" Style="{StaticResource Ov.Card}" Padding="20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="Title" Text="{Binding Title}" Style="{StaticResource Ov.Meta}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Icon" Grid.Column="1" Text="{Binding Icon}" Style="{StaticResource Ov.Glyph}"
                               Foreground="{Binding BadgeColor, Converter={StaticResource Ov.StatusBrush}}"/>
                </Grid>
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,18,0,12">
                    <TextBlock x:Name="Value" Text="{Binding DisplayValue}" Style="{StaticResource Ov.Value}"/>
                </Viewbox>
                <TextBlock x:Name="SubLabel" Text="{Binding SubLabel}" Style="{StaticResource Ov.Meta}"/>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Ov.Hero}"/>
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Ov.OnAccentMuted}"/>
                <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Ov.OnAccent}"/>
                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Ov.OnAccent}"/>
                <Setter TargetName="SubLabel" Property="Foreground" Value="{DynamicResource Ov.OnAccentMuted}"/>
            </DataTrigger>
            <!-- Keep the original Title binding, but name these issue-month
                 cohorts accurately; no cash-receipt or VAT recalculation. -->
            <DataTrigger Binding="{Binding Title}" Value="UAE VAT Collected (5%)">
                <Setter TargetName="Title" Property="Text" Value="VAT on invoices · this month"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Title}" Value="Paid this Month">
                <Setter TargetName="Title" Property="Text" Value="Paid / part-paid · issued this month"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAlert}" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Ov.Danger}"/>
                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Title" Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="Ds.FeedItemsStyle" TargetType="ItemsControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="Ds.ChartWellStyle" TargetType="Border">
        <Setter Property="Height" Value="260"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="Ds.EmptyGlyphStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Glyph}">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.Muted}"/>
    </Style>
    <Style x:Key="Ds.EmptyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Meta}">
        <Setter Property="Margin" Value="0,12,0,0"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Ds.SkeletonBlockStyle" TargetType="Border" BasedOn="{StaticResource Ov.Skeleton}"/>
    <Style x:Key="Ds.SkeletonCircleStyle" TargetType="Border" BasedOn="{StaticResource Ov.Skeleton}">
        <Setter Property="CornerRadius" Value="100"/>
    </Style>
    <Style x:Key="Ds.SkeletonBandStyle" TargetType="Border" BasedOn="{StaticResource Ds.StateBandStyle}"/>
    <Style x:Key="Ds.SkeletonCardStyle" TargetType="Border" BasedOn="{StaticResource Ov.Card}"/>
    <Style x:Key="Ds.SkeletonKpiBandStyle" TargetType="ItemsControl" BasedOn="{StaticResource Ds.KpiBandStyle}"/>
    <ItemsPanelTemplate x:Key="Ds.SkeletonKpiBandPanel">
        <layout:IndigoDashboardPanel MaxColumns="4" MinimumColumnWidth="210" Gap="16"/>
    </ItemsPanelTemplate>
    <DataTemplate x:Key="Ds.SkeletonKpiTileTemplate">
        <Border Style="{StaticResource Ov.Card}" Padding="18">
            <StackPanel>
                <Border Style="{StaticResource Ov.Skeleton}" Height="12"/>
                <Border Style="{StaticResource Ov.Skeleton}" Height="32"/>
                <Border Style="{StaticResource Ov.Skeleton}" Height="10"/>
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="Ds.SkeletonChartTemplate">
        <StackPanel>
            <Border Style="{StaticResource Ov.Skeleton}" Width="160" HorizontalAlignment="Left"/>
            <Border Style="{StaticResource Ov.Skeleton}" Height="220" Margin="0"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="Ds.SkeletonFeedRowTemplate">
        <Grid Margin="0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Ds.SkeletonCircleStyle}" Width="30" Height="30" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Ov.Skeleton}" Height="12"/>
                <Border Style="{StaticResource Ov.Skeleton}" Height="10" Opacity="0.6"/>
            </StackPanel>
        </Grid>
    </DataTemplate>
    <!-- Saved-statement balances can overlap. Display their original values
         independently instead of implying they form a percentage partition. -->
    <DataTemplate x:Key="Ds.BalanceTemplate">
        <Border BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="0,14">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Ov.Meta}"/>
                <Viewbox HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,6,0,0">
                    <TextBlock Text="{Binding ValueDisplay}" Style="{StaticResource Ov.Value}" FontSize="24"/>
                </Viewbox>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
