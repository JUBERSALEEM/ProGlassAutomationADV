<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/TaxInvoice/TiDashboard/TiDashboardView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Tax Invoice Dashboard

     SOFT-CARD REDESIGN — the reference dashboard markup supplied by the
     user, applied identically across all 7 dashboards. The look lives
     in Styles/DashboardStyles.xaml (Soft* keys). This file previously
     carried ~200 lines of private card/button/tile styles that had
     drifted from every other dashboard; those are gone and the shared
     keys are used instead.

     DEVIATIONS FROM THE PASTED REFERENCE, EACH FORCED
     ─────────────────────────────────────────────────
       1. DynamicResource colour, not hardcoded hex — ThemeManager
          swaps dictionaries at runtime.
       2. TrendChartControl, not lvc:CartesianChart — LiveChartsCore is
          not referenced and NuGet is unreachable from the sandbox.
       3. Segoe MDL2 glyphs, never emoji.

     EMOJI REMOVAL WITHOUT TOUCHING THE MODELS
     ─────────────────────────────────────────
     RecentInvoiceItem.StatusIcon returns ✅ 📤 ⚠️ 📝 ❌ 🚫 and
     TopCustomerItem.MedalIcon returns 🥇 🥈 🥉. Both are model
     properties, and models are ERP code that must not be edited for a
     styling pass. So this view simply does NOT bind them: the status
     glyph is derived from the already-bound Status string via
     DataTriggers, and the medal is replaced by the numeric Rank in a
     tinted disc. Nothing in C# changed; the emoji properties are left
     in place, merely unused here.

     BINDINGS — UNCHANGED. NO VIEWMODEL WAS EDITED.
       KpiTiles (KpiTileModel), RecentInvoices, AgingBrackets,
       TopCustomers, RevenueBars, RevenueChartTitle,
       HasRecentInvoices, HasAgingData, HasTopCustomers,
       HasRevenueData, HasOverdueInvoices, OverdueCount,
       OverdueAmountDisplay, IsLoading, HasError, ErrorMessage,
       LastRefreshed, CreateTaxInvoiceCommand, ViewAllInvoicesCommand,
       ViewOverdueCommand, OpenInvoiceCommand
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Dashboard.TaxInvoice.TiDashboard.TiDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             RECENT INVOICE ROW
             Status glyph comes from DataTriggers on Status, so the
             model's emoji StatusIcon is never rendered.
        ═══════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="TiRecentInvoiceTemplate">
            <Border Margin="0,0,0,8"
                    CornerRadius="12"
                    Padding="12,10"
                    Cursor="Hand"
                    SnapsToDevicePixels="True"
                    Background="{Binding TintColor,
                                 Converter={StaticResource BrushKeyConverter}}"
                    ToolTip="Open this invoice">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenInvoiceCommand,
                                            RelativeSource={RelativeSource
                                                AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="34" Height="34"
                            CornerRadius="10"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            SnapsToDevicePixels="True"
                            Background="{Binding StatusColor,
                                         Converter={StaticResource BrushKeyConverter}}">
                        <TextBlock FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource SoftBadgeGlyphStyle}">
                                    <!-- default: generic document -->
                                    <Setter Property="Text" Value="&#xE8A5;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Paid">
                                            <Setter Property="Text" Value="&#xE73E;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Issued">
                                            <Setter Property="Text" Value="&#xE725;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                            <Setter Property="Text" Value="&#xE7BA;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Draft">
                                            <Setter Property="Text" Value="&#xE8E5;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                            <Setter Property="Text" Value="&#xE711;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Void">
                                            <Setter Property="Text" Value="&#xE7BA;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding InvoiceNumber}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock FontSize="11"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding IssueDateDisplay, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <TextBlock Text="{Binding AmountDisplay}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <Border CornerRadius="6"
                                Padding="7,2"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Right"
                                SnapsToDevicePixels="True"
                                Background="{Binding StatusColor,
                                             Converter={StaticResource BrushKeyConverter}}">
                            <TextBlock Text="{Binding Status}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════
             AGING BRACKET ROW — label, count, amount, severity bar.
             The bar uses a 2-column Grid with star widths rather than
             the old PercentToWidthConverter with a hardcoded 260px
             parameter, which mis-sized the fill whenever the card was
             not exactly 260px wide.
        ═══════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="TiAgingRowTemplate">
            <Border Margin="0,0,0,10"
                    Padding="12,10"
                    CornerRadius="12"
                    SnapsToDevicePixels="True"
                    Background="{Binding TintColor,
                                 Converter={StaticResource BrushKeyConverter}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Label}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding CountDisplay}"
                                   FontSize="10"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding AmountDisplay}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="{Binding SeverityColor,
                                                Converter={StaticResource BrushKeyConverter}}"/>
                    </Grid>

                    <Border Height="8"
                            CornerRadius="4"
                            Margin="0,8,0,0"
                            SnapsToDevicePixels="True"
                            Background="{DynamicResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="{Binding NormalizedWidth,
                                            Converter={StaticResource FractionToStarConverter}}"/>
                                <ColumnDefinition
                                    Width="{Binding NormalizedWidth,
                                            Converter={StaticResource FractionToStarConverter},
                                            ConverterParameter=invert}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True"
                                    Background="{Binding SeverityColor,
                                                 Converter={StaticResource BrushKeyConverter}}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════
             TOP CUSTOMER ROW — numeric rank disc instead of the
             model's medal emoji.
        ═══════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="TiTopCustomerTemplate">
            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Margin="0,0,0,10"
                    Padding="12,10"
                    CornerRadius="12"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource TintGrayBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="26" Height="26"
                                CornerRadius="13"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"
                                Background="{Binding BarColor,
                                             Converter={StaticResource ColorStringConverter}}">
                            <TextBlock Text="{Binding Rank}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <TextBlock Text="{Binding CustomerName}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="{Binding InvoiceCountDisplay}"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding AmountDisplay}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>

                    <Border Height="5"
                            CornerRadius="3"
                            Margin="0,8,0,0"
                            SnapsToDevicePixels="True"
                            Background="{DynamicResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="{Binding NormalizedWidth,
                                            Converter={StaticResource FractionToStarConverter}}"/>
                                <ColumnDefinition
                                    Width="{Binding NormalizedWidth,
                                            Converter={StaticResource FractionToStarConverter},
                                            ConverterParameter=invert}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True"
                                    Background="{Binding BarColor,
                                                 Converter={StaticResource ColorStringConverter}}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <StackPanel Margin="24">

                <!-- HERO -->
                <Border Style="{StaticResource SoftHeroStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tax Invoices"
                                       Style="{StaticResource SoftHeroTitleStyle}"/>
                            <TextBlock Text="Revenue, ageing and collection health"
                                       Style="{StaticResource SoftHeroSubtitleStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource SoftChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource SuccessBrush}"/>
                                    <TextBlock Text="Live"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding LastRefreshed}"
                                       Style="{StaticResource SoftMetaStyle}"
                                       HorizontalAlignment="Right"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ACTIONS -->
                <Border Style="{StaticResource SoftSectionStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Quick actions"
                                   Style="{StaticResource SoftSectionTitleStyle}"
                                   VerticalAlignment="Center"/>

                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                            <Button Content="New Tax Invoice"
                                    Tag="&#xE710;"
                                    Style="{StaticResource SoftPillAccentStyle}"
                                    ToolTip="Create a new tax invoice"
                                    Command="{Binding CreateTaxInvoiceCommand}"/>
                            <Button Content="View All"
                                    Tag="&#xE8FD;"
                                    Margin="0"
                                    Style="{StaticResource SoftPillButtonStyle}"
                                    ToolTip="Open the tax invoice list"
                                    Command="{Binding ViewAllInvoicesCommand}"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- LOADING -->
                <Border Style="{StaticResource SoftSectionStyle}"
                        Padding="16,14"
                        Visibility="{Binding IsLoading,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Loading tax invoice data…"
                                   Style="{StaticResource SoftKpiFootStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ERROR -->
                <Border Style="{StaticResource SoftSectionStyle}"
                        Padding="16,14"
                        Background="{DynamicResource TintRedBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        Visibility="{Binding HasError,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DangerBrush}"/>
                    </StackPanel>
                </Border>

                <!-- OVERDUE ALERT -->
                <Border Style="{StaticResource SoftSectionStyle}"
                        Padding="16,14"
                        Background="{DynamicResource TintRedBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        Visibility="{Binding HasOverdueInvoices,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE7BA;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Foreground="{DynamicResource DangerBrush}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}">
                                    <Run Text="{Binding OverdueCount, Mode=OneWay}"/>
                                    <Run Text=" invoice(s) overdue — total "/>
                                    <Run Text="{Binding OverdueAmountDisplay, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="Action required: follow up with customers on outstanding payments."
                                           FontSize="11"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="View Overdue"
                                Tag="&#xE7BA;"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SoftPillButtonStyle}"
                                Background="{DynamicResource DangerBrush}"
                                Foreground="{DynamicResource OnAccentForegroundBrush}"
                                ToolTip="Show only overdue invoices"
                                Command="{Binding ViewOverdueCommand}"/>
                    </Grid>
                </Border>

                <!-- KPI ROW -->
                <TextBlock Text="Revenue Overview"
                           Style="{StaticResource SoftGroupHeadingStyle}"/>
                <ItemsControl ItemsSource="{Binding KpiTiles}"
                              ItemTemplate="{StaticResource SoftKpiTileTemplate}"
                              ItemsPanel="{StaticResource SoftKpiRowPanel}"
                              Margin="-5,0,-5,18"/>

                <!-- ROW: RECENT INVOICES + AGEING -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource SoftSectionStyle}"
                            Margin="0,0,10,20">
                        <StackPanel>
                            <TextBlock Text="Recent Invoices"
                                       Style="{StaticResource SoftSectionTitleStyle}"/>
                            <TextBlock Text="Last 5 invoices · click a row to open it"
                                       Style="{StaticResource SoftSectionSubtitleStyle}"/>

                            <ItemsControl ItemsSource="{Binding RecentInvoices}"
                                          ItemTemplate="{StaticResource TiRecentInvoiceTemplate}"
                                          Visibility="{Binding HasRecentInvoices,
                                              Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Border Padding="0,40"
                                    Visibility="{Binding HasRecentInvoices,
                                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8EF;"
                                               Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                    <TextBlock Text="No invoices yet"
                                               Style="{StaticResource DashEmptyStateTextStyle}"/>
                                    <TextBlock Text="Create your first Tax Invoice to see data."
                                               Style="{StaticResource SoftMetaStyle}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource SoftSectionStyle}"
                            Margin="10,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Invoice Ageing"
                                       Style="{StaticResource SoftSectionTitleStyle}"/>
                            <TextBlock Text="Overdue amounts grouped by bracket"
                                       Style="{StaticResource SoftSectionSubtitleStyle}"/>

                            <ItemsControl ItemsSource="{Binding AgingBrackets}"
                                          ItemTemplate="{StaticResource TiAgingRowTemplate}"
                                          Visibility="{Binding HasAgingData,
                                              Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Border Padding="0,40"
                                    Visibility="{Binding HasAgingData,
                                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE73E;"
                                               Style="{StaticResource DashEmptyStateGlyphStyle}"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                    <TextBlock Text="No overdue invoices"
                                               Style="{StaticResource DashEmptyStateTextStyle}"/>
                                    <TextBlock Text="All invoices are within payment terms."
                                               Style="{StaticResource SoftMetaStyle}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ROW: TOP CUSTOMERS + REVENUE -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource SoftSectionStyle}"
                            Margin="0,0,10,20">
                        <StackPanel>
                            <TextBlock Text="Top Customers"
                                       Style="{StaticResource SoftSectionTitleStyle}"/>
                            <TextBlock Text="By invoiced amount, last 12 months"
                                       Style="{StaticResource SoftSectionSubtitleStyle}"/>

                            <ItemsControl ItemsSource="{Binding TopCustomers}"
                                          ItemTemplate="{StaticResource TiTopCustomerTemplate}"
                                          Visibility="{Binding HasTopCustomers,
                                              Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Border Padding="0,40"
                                    Visibility="{Binding HasTopCustomers,
                                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE735;"
                                               Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                    <TextBlock Text="No customer data"
                                               Style="{StaticResource DashEmptyStateTextStyle}"/>
                                    <TextBlock Text="Issue invoices to see top customers."
                                               Style="{StaticResource SoftMetaStyle}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource SoftSectionStyle}"
                            Margin="10,0,0,20">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Revenue Trend"
                                               Style="{StaticResource SoftSectionTitleStyle}"/>
                                    <TextBlock Text="Amounts in AED · excludes Draft, Cancelled and Void"
                                               Style="{StaticResource SoftSectionSubtitleStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding RevenueChartTitle}"
                                           Style="{StaticResource SoftMetaStyle}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"/>
                            </Grid>

                            <Grid>
                                <Border Style="{StaticResource SoftChartWellStyle}"
                                        Visibility="{Binding HasRevenueData,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                    <trend:TrendChartControl
                                        Height="260"
                                        Points="{Binding RevenueBars}"
                                        SeriesKind="Bar"
                                        ValuePrefix="AED "
                                        EmptyMessage="No revenue recorded yet."
                                        SeriesBrush="{DynamicResource AccentBrush}"
                                        GridBrush="{DynamicResource DividerBrush}"
                                        LabelBrush="{DynamicResource MutedForegroundBrush}"/>
                                </Border>

                                <Border Padding="0,60"
                                        Visibility="{Binding HasRevenueData,
                                            Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE9D9;"
                                                   Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                        <TextBlock Text="No revenue data yet"
                                                   Style="{StaticResource DashEmptyStateTextStyle}"/>
                                        <TextBlock Text="Issue Tax Invoices to see the revenue trend."
                                                   Style="{StaticResource SoftMetaStyle}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
