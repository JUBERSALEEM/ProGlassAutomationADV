<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/TaxInvoice/TiDashboard/TiDashboardView.xaml
     SYSTEM: MERIDIAN — Phase 6 full rewrite (2026-09-18)

     Bindings preserved (NO VIEWMODEL EDITED):
       KpiTiles, RecentInvoices, AgingBrackets, TopCustomers,
       RevenueBars, RevenueChartTitle, HasRecentInvoices,
       HasAgingData, HasTopCustomers, HasRevenueData,
       HasOverdueInvoices, OverdueCount, OverdueAmountDisplay,
       IsLoading, HasError, ErrorMessage,
       CreateTaxInvoiceCommand, ViewAllInvoicesCommand,
       OpenInvoiceCommand (row MouseBinding, parameter = item).

     Local templates rebuilt in the Meridian language but with the
     SAME contract:
       • TiRecentInvoiceTemplate — status glyph derived from the
         Status string via DataTriggers (the model's emoji StatusIcon
         stays unbound, by design), TintColor/StatusColor resolved by
         BrushKeyConverter, whole-row MouseBinding → OpenInvoiceCommand.
       • TiAgingRowTemplate — FractionToStarConverter + "invert"
         star-width severity bar, SeverityColor via BrushKeyConverter.
       • TiTopCustomerTemplate — numeric Rank disc (BarColor via
         ColorStringConverter; the model's medal emoji stays unbound).
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Dashboard.TaxInvoice.TiDashboard.TiDashboardView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             xmlns:donut="clr-namespace:ProGlassAutomation.Controls.DonutChart"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             RECENT INVOICE ROW (Meridian docrow)
             Status glyph from DataTriggers on Status; TintColor/
             StatusColor brush keys resolve per theme.
        ═══════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="TiRecentInvoiceTemplate">
            <Border Background="Transparent"
                    BorderBrush="{DynamicResource PgHairlineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="{StaticResource PgRowPadding}"
                    Cursor="Hand"
                    SnapsToDevicePixels="True"
                    ToolTip="{DynamicResource Dashboard.OpenInvoice}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenInvoiceCommand,
                                            RelativeSource={RelativeSource
                                                AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="34" Height="34"
                            CornerRadius="{StaticResource PgTileRadius}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            SnapsToDevicePixels="True"
                            Background="{Binding TintColor,
                                         Converter={StaticResource BrushKeyConverter}}"
                            BorderBrush="{DynamicResource PgHairlineBrush}"
                            BorderThickness="1">
                        <TextBlock FontSize="{StaticResource PgFontGlyph}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource PgGlyphStyle}">
                                    <Setter Property="Foreground"
                                            Value="{Binding StatusColor,
                                                     Converter={StaticResource BrushKeyConverter}}"/>
                                    <!-- default: generic document -->
                                    <Setter Property="Text" Value="&#xE8A5;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Paid">
                                            <Setter Property="Text" Value="&#xE73E;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Issued">
                                            <Setter Property="Text" Value="&#xE725;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                            <Setter Property="Text" Value="&#xE7BA;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Draft">
                                            <Setter Property="Text" Value="&#xE8E5;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                            <Setter Property="Text" Value="&#xE711;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Void">
                                            <Setter Property="Text" Value="&#xE7BA;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding InvoiceNumber}"
                                   Style="{StaticResource PgRowTitleStyle}"/>
                        <TextBlock Style="{StaticResource PgRowSubStyle}">
                            <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding IssueDateDisplay, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <TextBlock Text="{Binding AmountDisplay}"
                                   Style="{StaticResource PgRowValueStyle}"/>
                        <Border CornerRadius="{StaticResource PgChipRadius}"
                                Padding="8,3"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Right"
                                SnapsToDevicePixels="True"
                                Background="{Binding StatusColor,
                                             Converter={StaticResource BrushKeyConverter}}">
                            <TextBlock Text="{Binding Status}"
                                       Style="{StaticResource PgPillTextStyle}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════
             AGING BRACKET ROW — label, count, amount, severity bar
             (FractionToStarConverter star widths, "invert" remainder).
        ═══════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="TiAgingRowTemplate">
            <Border Background="{Binding TintColor,
                                 Converter={StaticResource BrushKeyConverter}}"
                    BorderBrush="{DynamicResource PgHairlineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,10,0,12"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Label}"
                                   FontSize="{StaticResource PgFontCardSub}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PgText1Brush}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding CountDisplay}"
                                   FontSize="{StaticResource PgFontBodySm}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PgText3Brush}"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding AmountDisplay}"
                                   FontSize="{StaticResource PgFontCardSub}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="{Binding SeverityColor,
                                                Converter={StaticResource BrushKeyConverter}}"/>
                    </Grid>

                    <Border Height="8"
                            CornerRadius="4"
                            Margin="0,8,0,0"
                            SnapsToDevicePixels="True"
                            Background="{DynamicResource PgHairlineBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="{Binding NormalizedWidth,
                                            Converter={StaticResource FractionToStarConverter}}"/>
                                <ColumnDefinition
                                    Width="{Binding NormalizedWidth,
                                            Converter={StaticResource FractionToStarConverter},
                                            ConverterParameter=invert}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True"
                                    Background="{Binding SeverityColor,
                                                 Converter={StaticResource BrushKeyConverter}}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════
             TOP CUSTOMER ROW — numeric rank disc (BarColor via
             ColorStringConverter), name, amount, 5px share bar.
        ═══════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="TiTopCustomerTemplate">
            <Border Background="Transparent"
                    BorderBrush="{DynamicResource PgHairlineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,10,0,12"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="26" Height="26"
                                CornerRadius="{StaticResource PgIconSmRadius}"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"
                                Background="{Binding BarColor,
                                             Converter={StaticResource ColorStringConverter}}">
                            <TextBlock Text="{Binding Rank}"
                                       FontSize="{StaticResource PgFontCardSub}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PgAccentInkBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <TextBlock Text="{Binding CustomerName}"
                                       Style="{StaticResource PgRowTitleStyle}"/>
                            <TextBlock Text="{Binding InvoiceCountDisplay}"
                                       Style="{StaticResource PgRowSubStyle}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding AmountDisplay}"
                                   FontSize="{StaticResource PgFontCardSub}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource PgText1Brush}"/>
                    </Grid>

                    <Border Height="5"
                            CornerRadius="2.5"
                            Margin="0,8,0,0"
                            SnapsToDevicePixels="True"
                            Background="{DynamicResource PgHairlineBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="{Binding NormalizedWidth,
                                            Converter={StaticResource FractionToStarConverter}}"/>
                                <ColumnDefinition
                                    Width="{Binding NormalizedWidth,
                                            Converter={StaticResource FractionToStarConverter},
                                            ConverterParameter=invert}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    CornerRadius="2.5"
                                    SnapsToDevicePixels="True"
                                    Background="{Binding BarColor,
                                                 Converter={StaticResource ColorStringConverter}}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="{DynamicResource PgPageMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- hero -->
                    <RowDefinition Height="Auto"/>  <!-- state bands -->
                    <RowDefinition Height="Auto"/>  <!-- KPI + aging + stats / skeleton -->
                    <RowDefinition Height="*" MinHeight="260"/>  <!-- revenue + recent -->
                    <RowDefinition Height="Auto"/>  <!-- customers + brackets -->
                </Grid.RowDefinitions>

                <!-- ══ HERO ═══════════════════════════════════════ -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard.TaxInvoices}"
                                   Style="{StaticResource PgHeroTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Dashboard.RevenueAgeingCollectionHealth}"
                                   Style="{StaticResource PgHeroSubStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource PgLiveChipStyle}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource PgOkBrush}"/>
                                <TextBlock Text="{DynamicResource Common.Live}"
                                           Style="{StaticResource PgLiveTextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Content="{DynamicResource Dashboard.NewInvoice}" Tag="&#xE710;"
                                Style="{StaticResource PgBtnPrimaryStyle}"
                                Command="{Binding CreateTaxInvoiceCommand}"
                                ToolTip="{DynamicResource Dashboard.NewInvoice}"/>
                        <Button Content="{DynamicResource Dashboard.View}" Tag="&#xE8FD;" Margin="0"
                                Style="{StaticResource PgBtnGhostStyle}"
                                Command="{Binding ViewAllInvoicesCommand}"
                                ToolTip="{DynamicResource Dashboard.View}"/>
                    </StackPanel>
                </Grid>

                <!-- ══ STATE BANDS ═══════════════════════════════════ -->
                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource PgStateBandStyle}"
                            Background="{DynamicResource PgAccentSoftBrush}"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PgSkeletonCircleStyle}" Width="20" Height="20" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="12" Width="180" HorizontalAlignment="Left"/>
                                <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="8" Width="260" Margin="0,6,0,0" HorizontalAlignment="Left" Opacity="0.5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource PgStateBandStyle}"
                            Background="{DynamicResource PgDangerSoftBrush}"
                            Visibility="{Binding HasError,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource PgErrorTextStyle}"/>
                    </Border>
                    <Border Style="{StaticResource PgAlertBandStyle}"
                            Visibility="{Binding HasOverdueInvoices,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE7BA;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource PgFontGlyph}"
                                       Foreground="{DynamicResource PgDangerBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource PgAlertBandTextStyle}"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding OverdueCount, Mode=OneWay}"/>
                                <Run Text=" overdue invoices — "/>
                                <Run Text="{Binding OverdueAmountDisplay, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ══ SKELETON (visible while loading) ══════════════ -->
                <StackPanel Grid.Row="2" Grid.RowSpan="3"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource PgSkeletonBandStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="16" Width="120" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                            <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="10" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12" Opacity="0.5"/>
                            <ItemsControl Style="{StaticResource PgSkeletonKpiBandStyle}" ItemsPanel="{StaticResource PgSkeletonKpiBandPanel}">
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonKpiTileTemplate}"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonKpiTileTemplate}"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonKpiTileTemplate}"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonKpiTileTemplate}"/>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PgSkeletonCardStyle}" Margin="0,0,16,0">
                            <ContentControl ContentTemplate="{StaticResource PgSkeletonChartTemplate}"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PgSkeletonCardStyle}" Margin="16,0,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="14" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="10" Width="120" HorizontalAlignment="Left" Margin="0,0,0,16" Opacity="0.5"/>
                                <Grid Height="158"><Border Style="{StaticResource PgSkeletonCircleStyle}" Width="110" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PgSkeletonCardStyle}" Margin="0,0,16,0">
                            <ContentControl ContentTemplate="{StaticResource PgSkeletonChartTemplate}"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PgSkeletonCardStyle}" Margin="16,0,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="14" Width="120" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonFeedRowTemplate}"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonFeedRowTemplate}"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonFeedRowTemplate}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ══ KPI TILES + AGING MIX + STATS ═════════════════ -->
                <Grid Grid.Row="2" Margin="0,0,0,16"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PgCardStyle}" Margin="0,0,16,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Dashboard.CollectionsPulse}"
                                           Style="{StaticResource PgCardTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.InvoicedVATPaidPending}"
                                           Style="{StaticResource PgCardSubStyle}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <ItemsControl Style="{StaticResource PgKpiBandStyle}"
                                          ItemsSource="{Binding KpiTiles}"
                                          ItemTemplate="{StaticResource PgKpiTileTemplate}"
                                          ItemsPanel="{StaticResource PgKpiBandPanel}"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PgCardStyle}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dashboard.AgeingMix}"
                                       Style="{StaticResource PgCardTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Dashboard.OverdueAmountsBracket}"
                                       Style="{StaticResource PgCardSubStyle}"
                                       Margin="0,2,0,10"/>
                            <donut:DonutChartControl Height="150"
                                                     Slices="{Binding AgingMixSlices}"
                                                     HoleLabel="AGE"
                                                     EmptyMessage="No ageing mix."
                                                     Thickness="16"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource PgCardStyle}" Margin="0,0,16,0" Padding="16,12">
                            <Grid>
                                <Border Style="{StaticResource PgAlertBarStyle}"
                                        Background="{DynamicResource PgDangerBrush}"
                                        Visibility="{Binding HasOverdueInvoices,
                                                    Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="{DynamicResource Common.Overdue}"
                                               Style="{StaticResource PgStatLabelStyle}"/>
                                    <TextBlock Text="{Binding OverdueCount}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PgStatValueStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasOverdueInvoices}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource PgDangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource Dashboard.InvoicesPastTerms}"
                                               Style="{StaticResource PgStatFootStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource PgCardStyle}" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dashboard.OverdueAED}"
                                           Style="{StaticResource PgStatLabelStyle}"/>
                                <Viewbox HorizontalAlignment="Left" Stretch="Uniform"
                                         StretchDirection="DownOnly" Margin="0,8,0,4">
                                    <TextBlock Text="{Binding OverdueAmountDisplay}"
                                               FontSize="{StaticResource PgFontStatValue}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PgWarnBrush}"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ══ REVENUE + RECENT INVOICES ═════════════════════ -->
                <Grid Grid.Row="3"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PgCardStyle}" Margin="0,0,16,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Dashboard.RevenueTrend}"
                                           Style="{StaticResource PgCardTitleStyle}"/>
                                <TextBlock Text="{Binding RevenueChartTitle}"
                                           Style="{StaticResource PgMetaStyle}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Border Style="{StaticResource PgChartWellStyle}"
                                        Visibility="{Binding HasRevenueData,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                    <trend:TrendChartControl
                                        Points="{Binding RevenueBars}"
                                        SeriesKind="Bar"
                                        ValuePrefix="AED "
                                        EmptyMessage="No revenue recorded yet."
                                        SeriesBrush="{DynamicResource PgAccentBrush}"
                                        SeriesEndBrush="{DynamicResource PgAccentHoverBrush}"
                                        GridBrush="{DynamicResource PgHairlineBrush}"
                                        LabelBrush="{DynamicResource PgText3Brush}"/>
                                </Border>
                                <Border Padding="0,40"
                                        Visibility="{Binding HasRevenueData,
                                            Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE9D9;"
                                                   Style="{StaticResource PgEmptyGlyphStyle}"/>
                                        <TextBlock Text="{DynamicResource Dashboard.NoRevenueDataYet}"
                                                   Style="{StaticResource PgEmptyTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PgCardStyle}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Dashboard.RecentInvoices}"
                                           Style="{StaticResource PgCardTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.LatestActivity}"
                                           Style="{StaticResource PgMetaStyle}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          MaxHeight="400"
                                          HorizontalScrollBarVisibility="Disabled"
                                          behaviors:SmartScrollBubblingBehavior.IsEnabled="True"
                                          Visibility="{Binding HasRecentInvoices,
                                              Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl Style="{StaticResource PgFeedItemsStyle}"
                                              ItemsSource="{Binding RecentInvoices}"
                                              ItemTemplate="{StaticResource TiRecentInvoiceTemplate}"/>
                            </ScrollViewer>
                            <Border Padding="0,40"
                                    Visibility="{Binding HasRecentInvoices,
                                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8EF;"
                                               Style="{StaticResource PgEmptyGlyphStyle}"/>
                                    <TextBlock Text="{DynamicResource Dashboard.NoInvoicesYet}"
                                               Style="{StaticResource PgEmptyTextStyle}"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ══ TOP CUSTOMERS + AGING BRACKETS ════════════════ -->
                <Grid Grid.Row="4" Margin="0,16,0,0"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PgCardStyle}" Margin="0,0,16,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Dashboard.TopCustomers}"
                                           Style="{StaticResource PgCardTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.InvoicedAmountLast12Months}"
                                           Style="{StaticResource PgCardSubStyle}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          MaxHeight="400"
                                          behaviors:SmartScrollBubblingBehavior.IsEnabled="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasTopCustomers,
                                              Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl Style="{StaticResource PgFeedItemsStyle}"
                                              ItemsSource="{Binding TopCustomers}"
                                              ItemTemplate="{StaticResource TiTopCustomerTemplate}"/>
                            </ScrollViewer>
                            <Border Padding="0,30"
                                    Visibility="{Binding HasTopCustomers,
                                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE735;"
                                               Style="{StaticResource PgEmptyGlyphStyle}"/>
                                    <TextBlock Text="{DynamicResource Dashboard.NoCustomerData}"
                                               Style="{StaticResource PgEmptyTextStyle}"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PgCardStyle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Dashboard.AgeingBrackets}"
                                           Style="{StaticResource PgCardTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.OverdueAmountsGroupedAge}"
                                           Style="{StaticResource PgCardSubStyle}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          MaxHeight="400"
                                          behaviors:SmartScrollBubblingBehavior.IsEnabled="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasAgingData,
                                              Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl Style="{StaticResource PgFeedItemsStyle}"
                                              ItemsSource="{Binding AgingBrackets}"
                                              ItemTemplate="{StaticResource TiAgingRowTemplate}"/>
                            </ScrollViewer>
                            <Border Padding="0,30"
                                    Visibility="{Binding HasAgingData,
                                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE73E;"
                                               Style="{StaticResource PgEmptyGlyphStyle}"
                                               Foreground="{DynamicResource PgOkBrush}"/>
                                    <TextBlock Text="{DynamicResource Dashboard.NoOverdueInvoices}"
                                               Style="{StaticResource PgEmptyTextStyle}"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
