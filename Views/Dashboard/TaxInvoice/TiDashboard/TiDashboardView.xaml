<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/TaxInvoice/TiDashboard/TiDashboardView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Tax Invoice Dashboard

     LAYOUT-03 BENTO MOSAIC — Tax Invoices. Bindings and local row templates unchanged. The look lives
     in Styles/DashboardStyles.xaml (Soft* keys). This file previously
     carried ~200 lines of private card/button/tile styles that had
     drifted from every other dashboard; those are gone and the shared
     keys are used instead.

     DEVIATIONS FROM THE PASTED REFERENCE, EACH FORCED
     ─────────────────────────────────────────────────
       1. DynamicResource colour, not hardcoded hex — ThemeManager
          swaps dictionaries at runtime.
       2. TrendChartControl, not lvc:CartesianChart — LiveChartsCore is
          not referenced and NuGet is unreachable from the sandbox.
       3. Segoe MDL2 glyphs, never emoji.

     EMOJI REMOVAL WITHOUT TOUCHING THE MODELS
     ─────────────────────────────────────────
     RecentInvoiceItem.StatusIcon returns ✅ 📤 ⚠️ 📝 ❌ 🚫 and
     TopCustomerItem.MedalIcon returns 🥇 🥈 🥉. Both are model
     properties, and models are ERP code that must not be edited for a
     styling pass. So this view simply does NOT bind them: the status
     glyph is derived from the already-bound Status string via
     DataTriggers, and the medal is replaced by the numeric Rank in a
     tinted disc. Nothing in C# changed; the emoji properties are left
     in place, merely unused here.

     BINDINGS — UNCHANGED. NO VIEWMODEL WAS EDITED.
       KpiTiles (KpiTileModel), RecentInvoices, AgingBrackets,
       TopCustomers, RevenueBars, RevenueChartTitle,
       HasRecentInvoices, HasAgingData, HasTopCustomers,
       HasRevenueData, HasOverdueInvoices, OverdueCount,
       OverdueAmountDisplay, IsLoading, HasError, ErrorMessage,
       LastRefreshed, CreateTaxInvoiceCommand, ViewAllInvoicesCommand,
       ViewOverdueCommand, OpenInvoiceCommand
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Dashboard.TaxInvoice.TiDashboard.TiDashboardView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             xmlns:donut="clr-namespace:ProGlassAutomation.Controls.DonutChart"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             RECENT INVOICE ROW
             Status glyph comes from DataTriggers on Status, so the
             model's emoji StatusIcon is never rendered.
        ═══════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="TiRecentInvoiceTemplate">
            <Border Margin="0,0,0,8"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="12,10"
                    Cursor="Hand"
                    SnapsToDevicePixels="True"
                    Background="{Binding TintColor,
                                 Converter={StaticResource BrushKeyConverter}}"
                    ToolTip="{DynamicResource Dashboard.OpenInvoice}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenInvoiceCommand,
                                            RelativeSource={RelativeSource
                                                AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="34" Height="34"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            SnapsToDevicePixels="True"
                            Background="{Binding StatusColor,
                                         Converter={StaticResource BrushKeyConverter}}">
                        <TextBlock FontSize="{StaticResource TextSection}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource SoftBadgeGlyphStyle}">
                                    <!-- default: generic document -->
                                    <Setter Property="Text" Value="&#xE8A5;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Paid">
                                            <Setter Property="Text" Value="&#xE73E;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Issued">
                                            <Setter Property="Text" Value="&#xE725;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                            <Setter Property="Text" Value="&#xE7BA;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Draft">
                                            <Setter Property="Text" Value="&#xE8E5;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                            <Setter Property="Text" Value="&#xE711;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Void">
                                            <Setter Property="Text" Value="&#xE7BA;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding InvoiceNumber}"
                                   FontSize="{StaticResource TextBody}"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock FontSize="{StaticResource TextBody}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding IssueDateDisplay, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <TextBlock Text="{Binding AmountDisplay}"
                                   FontSize="{StaticResource TextBody}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="7,2"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Right"
                                SnapsToDevicePixels="True"
                                Background="{Binding StatusColor,
                                             Converter={StaticResource BrushKeyConverter}}">
                            <TextBlock Text="{Binding Status}"
                                       FontSize="{StaticResource TextCaption}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════
             AGING BRACKET ROW — label, count, amount, severity bar.
             The bar uses a 2-column Grid with star widths rather than
             the old PercentToWidthConverter with a hardcoded 260px
             parameter, which mis-sized the fill whenever the card was
             not exactly 260px wide.
        ═══════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="TiAgingRowTemplate">
            <Border Margin="0,0,0,10"
                    Padding="12,10"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    SnapsToDevicePixels="True"
                    Background="{Binding TintColor,
                                 Converter={StaticResource BrushKeyConverter}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Label}"
                                   FontSize="{StaticResource TextBody}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding CountDisplay}"
                                   FontSize="{StaticResource TextCaption}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding AmountDisplay}"
                                   FontSize="{StaticResource TextBody}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="{Binding SeverityColor,
                                                Converter={StaticResource BrushKeyConverter}}"/>
                    </Grid>

                    <Border Height="8"
                            CornerRadius="{DynamicResource Radius.XSmall}"
                            Margin="0,8,0,0"
                            SnapsToDevicePixels="True"
                            Background="{DynamicResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="{Binding NormalizedWidth,
                                            Converter={StaticResource FractionToStarConverter}}"/>
                                <ColumnDefinition
                                    Width="{Binding NormalizedWidth,
                                            Converter={StaticResource FractionToStarConverter},
                                            ConverterParameter=invert}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    CornerRadius="{DynamicResource Radius.XSmall}"
                                    SnapsToDevicePixels="True"
                                    Background="{Binding SeverityColor,
                                                 Converter={StaticResource BrushKeyConverter}}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════
             TOP CUSTOMER ROW — numeric rank disc instead of the
             model's medal emoji.
        ═══════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="TiTopCustomerTemplate">
            <Border BorderBrush="{DynamicResource GlassBorderGradientSoft}" BorderThickness="{DynamicResource Border.HairlineThickness}" Margin="0,0,0,10"
                    Padding="12,10"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource GlassUltraClearBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="26" Height="26"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"
                                Background="{Binding BarColor,
                                             Converter={StaticResource ColorStringConverter}}">
                            <TextBlock Text="{Binding Rank}"
                                       FontSize="{StaticResource TextBody}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <TextBlock Text="{Binding CustomerName}"
                                       FontSize="{StaticResource TextBody}"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="{Binding InvoiceCountDisplay}"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding AmountDisplay}"
                                   FontSize="{StaticResource TextBody}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>

                    <Border Height="5"
                            CornerRadius="{DynamicResource Radius.XSmall}"
                            Margin="0,8,0,0"
                            SnapsToDevicePixels="True"
                            Background="{DynamicResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="{Binding NormalizedWidth,
                                            Converter={StaticResource FractionToStarConverter}}"/>
                                <ColumnDefinition
                                    Width="{Binding NormalizedWidth,
                                            Converter={StaticResource FractionToStarConverter},
                                            ConverterParameter=invert}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    CornerRadius="{DynamicResource Radius.XSmall}"
                                    SnapsToDevicePixels="True"
                                    Background="{Binding BarColor,
                                                 Converter={StaticResource ColorStringConverter}}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="20,16,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- 2026-08-25 rev 2: balanced bento restored — revenue
                         chart keeps the wide slot, recent invoices list
                         column widened (1* -> 1.2*); top customers and
                         ageing brackets stay an even pair below. -->
                    <RowDefinition Height="*" MinHeight="260"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard.TaxInvoices}"
                                   Style="{StaticResource SoftHeroTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Dashboard.RevenueAgeingCollectionHealth}"
                                   Style="{StaticResource SoftHeroSubtitleStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource SoftChipStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{DynamicResource Common.Live}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                        <Button Content="{DynamicResource Dashboard.NewInvoice}" Tag="&#xE710;"
                                Style="{StaticResource SoftPillAccentStyle}"
                                Command="{Binding CreateTaxInvoiceCommand}" ToolTip="{DynamicResource Dashboard.NewInvoice}"/>
                        <Button Content="{DynamicResource Dashboard.View}" Tag="&#xE8FD;" Margin="0"
                                Style="{StaticResource SoftPillButtonStyle}"
                                Command="{Binding ViewAllInvoicesCommand}" ToolTip="{DynamicResource Dashboard.View}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource SoftSectionStyle}"
                            Padding="16,12"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Dashboard.LoadingTaxInvoiceData}"
                                   Style="{StaticResource SoftKpiFootStyle}"/>
                    </Border>
                    <Border Style="{StaticResource SoftSectionStyle}"
                            Padding="16,12"
                            Background="{DynamicResource TintRedBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            Visibility="{Binding HasError,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="{StaticResource TextBody}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}"/>
                    </Border>
                    <Border Style="{StaticResource SoftSectionStyle}"
                            Padding="16,12"
                            Background="{DynamicResource TintRedBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            Visibility="{Binding HasOverdueInvoices,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DangerBrush}">
                                <Run Text="{Binding OverdueCount, Mode=OneWay}"/>
                                <Run Text="{DynamicResource Dashboard.InvoiceSOverdue}"/>
                                <Run Text="{Binding OverdueAmountDisplay, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Grid.Column="1"
                                    Content="{DynamicResource Dashboard.ViewOverdue}"
                                    Tag="&#xE7BA;"
                                    Style="{StaticResource SoftPillButtonStyle}"
                                    Background="{DynamicResource DangerBrush}"
                                    Foreground="{DynamicResource OnAccentForegroundBrush}"
                                    Command="{Binding ViewOverdueCommand}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SoftCardStyle}"
                            Margin="0,0,18,0" >
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Dashboard.CollectionsPulse}"
                                           Style="{StaticResource SoftSectionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.InvoicedVATPaidPending}"
                                           Style="{StaticResource SoftSectionSubtitleStyle}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding KpiTiles}"
                                          ItemTemplate="{StaticResource SoftKpiTileTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SoftCardStyle}"
                            Margin="0,0,18,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dashboard.AgeingMix}"
                                       Style="{StaticResource SoftSectionTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Dashboard.OverdueAmountsBracket}"
                                       Style="{StaticResource SoftSectionSubtitleStyle}"/>
                            <donut:DonutChartControl Height="150"
                                                     Slices="{Binding AgingMixSlices}"
                                                     HoleLabel="AGE"
                                                     EmptyMessage="No ageing mix."
                                                     Thickness="16"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource SoftCardStyle}" Margin="0,0,0,18" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Common.Overdue}"
                                           Style="{StaticResource SoftKpiLabelStyle}"/>
                                <TextBlock Text="{Binding OverdueCount}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SoftKpiValueStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOverdueInvoices}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource Dashboard.InvoicesPastTerms}"
                                           Style="{StaticResource SoftKpiFootStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SoftCardStyle}" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Dashboard.OverdueAED}"
                                           Style="{StaticResource SoftKpiLabelStyle}"/>
                                <Viewbox HorizontalAlignment="Left" Stretch="Uniform"
                                         StretchDirection="DownOnly" Margin="0,8,0,4">
                                    <TextBlock Text="{Binding OverdueAmountDisplay}"
                                               Style="{StaticResource SoftKpiValueStyle}"
                                               Margin="0"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ROW: revenue chart (wide) + recent invoices (widened
                     list column — 1.2* instead of 1*) -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SoftCardStyle}" Margin="0,0,18,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Dashboard.RevenueTrend}"
                                           Style="{StaticResource SoftSectionTitleStyle}"/>
                                <TextBlock Text="{Binding RevenueChartTitle}"
                                           Style="{StaticResource SoftMetaStyle}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Border Style="{StaticResource SoftChartWellStyle}"
                                        Visibility="{Binding HasRevenueData,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                    <trend:TrendChartControl
                                        Points="{Binding RevenueBars}"
                                        SeriesKind="Bar"
                                        ValuePrefix="AED "
                                        EmptyMessage="No revenue recorded yet."
                                        SeriesBrush="{DynamicResource AccentBrush}"
                                        SeriesEndBrush="{DynamicResource AccentDarkBrush}"
                                        GridBrush="{DynamicResource DividerBrush}"
                                        LabelBrush="{DynamicResource MutedForegroundBrush}"/>
                                </Border>
                                <Border Padding="0,40"
                                        Visibility="{Binding HasRevenueData,
                                            Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE9D9;"
                                                   Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                        <TextBlock Text="{DynamicResource Dashboard.NoRevenueDataYet}"
                                                   Style="{StaticResource DashEmptyStateTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SoftCardStyle}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Dashboard.RecentInvoices}"
                                           Style="{StaticResource SoftSectionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.LatestActivity}"
                                           Style="{StaticResource SoftMetaStyle}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                MaxHeight="400"
                                          HorizontalScrollBarVisibility="Disabled"
                                          behaviors:SmartScrollBubblingBehavior.IsEnabled="True"
                                          Visibility="{Binding HasRecentInvoices,
                                              Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding RecentInvoices}"
                                              ItemTemplate="{StaticResource TiRecentInvoiceTemplate}"/>
                            </ScrollViewer>
                            <Border Padding="0,40"
                                    Visibility="{Binding HasRecentInvoices,
                                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8EF;"
                                               Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                    <TextBlock Text="{DynamicResource Dashboard.NoInvoicesYet}"
                                               Style="{StaticResource DashEmptyStateTextStyle}"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ROW: top customers + ageing brackets — even split -->
                <Grid Grid.Row="4" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SoftCardStyle}" Margin="0,0,18,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Dashboard.TopCustomers}"
                                           Style="{StaticResource SoftSectionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.InvoicedAmountLast12Months}"
                                           Style="{StaticResource SoftSectionSubtitleStyle}"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                MaxHeight="400"
                                behaviors:SmartScrollBubblingBehavior.IsEnabled="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasTopCustomers,
                                              Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding TopCustomers}"
                                              ItemTemplate="{StaticResource TiTopCustomerTemplate}"/>
                            </ScrollViewer>
                            <Border Padding="0,30"
                                    Visibility="{Binding HasTopCustomers,
                                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE735;"
                                               Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                    <TextBlock Text="{DynamicResource Dashboard.NoCustomerData}"
                                               Style="{StaticResource DashEmptyStateTextStyle}"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SoftCardStyle}" Margin="18,0,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Dashboard.AgeingBrackets}"
                                           Style="{StaticResource SoftSectionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.OverdueAmountsGroupedAge}"
                                           Style="{StaticResource SoftSectionSubtitleStyle}"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                MaxHeight="400"
                                behaviors:SmartScrollBubblingBehavior.IsEnabled="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasAgingData,
                                              Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding AgingBrackets}"
                                              ItemTemplate="{StaticResource TiAgingRowTemplate}"/>
                            </ScrollViewer>
                            <Border Padding="0,30"
                                    Visibility="{Binding HasAgingData,
                                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE73E;"
                                               Style="{StaticResource DashEmptyStateGlyphStyle}"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                    <TextBlock Text="{DynamicResource Dashboard.NoOverdueInvoices}"
                                               Style="{StaticResource DashEmptyStateTextStyle}"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
