<UserControl
    x:Class="ProGlassAutomation.Views.Dashboard.TaxInvoice.TiDashboard.TiDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextHintingMode="Fixed"
    RenderOptions.BitmapScalingMode="HighQuality"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══ Glass blue palette (frozen inline) ═══ -->

        <LinearGradientBrush x:Key="CardBgGradient"
                             StartPoint="0,0" EndPoint="0,1"
                             po:Freeze="True">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#F4F8FE" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardBorderBrush"
                         Color="#C4D6ED"
                         po:Freeze="True"/>

        <SolidColorBrush x:Key="AccentTextDeep"
                         Color="#1E3A8A"
                         po:Freeze="True"/>

        <SolidColorBrush x:Key="AccentText"
                         Color="#1E40AF"
                         po:Freeze="True"/>

        <!-- Header brand tones -->
        <SolidColorBrush x:Key="KpiHeaderBrush"       Color="#1E40AF" po:Freeze="True"/>
        <SolidColorBrush x:Key="RecentHeaderBrush"    Color="#1E3A8A" po:Freeze="True"/>
        <SolidColorBrush x:Key="AgingHeaderBrush"     Color="#B91C1C" po:Freeze="True"/>
        <SolidColorBrush x:Key="CustomersHeaderBrush" Color="#0369A1" po:Freeze="True"/>
        <SolidColorBrush x:Key="RevenueHeaderBrush"   Color="#1D4ED8" po:Freeze="True"/>

        <!-- ═══ Parent card (no shadow, glass gradient) ═══ -->
        <Style x:Key="TiParentCardStyle" TargetType="Border">
            <Setter Property="Background"          Value="{StaticResource CardBgGradient}"/>
            <Setter Property="BorderBrush"         Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="CornerRadius"        Value="16"/>
            <Setter Property="Padding"             Value="22,18"/>
            <Setter Property="Margin"              Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="TiCardHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin"      Value="0,0,0,18"/>
        </Style>

        <!-- Icon badge — no shadow -->
        <Style x:Key="TiCardIcon" TargetType="Border">
            <Setter Property="Width"             Value="38"/>
            <Setter Property="Height"            Value="38"/>
            <Setter Property="CornerRadius"      Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ═══ KPI TILE — sapphire blue default (v2.4 palette) ═══ -->
        <DataTemplate x:Key="TiTileTemplate">
            <Border CornerRadius="10" Padding="14,12" Margin="5"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Default (Green from VM) reinterpreted as SAPPHIRE BLUE -->
                        <Setter Property="Background"      Value="{DynamicResource TintIndigoBrush}"/>
                        <Setter Property="BorderBrush"     Value="{DynamicResource AccentLightBrush}"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Accent}" Value="Blue">
                                <Setter Property="Background"  Value="{DynamicResource TintBlueBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Accent}" Value="Amber">
                                <Setter Property="Background"  Value="{DynamicResource TintAmberBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Accent}" Value="Red">
                                <Setter Property="Background"  Value="{DynamicResource TintRedBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                <Setter Property="BorderBrush"     Value="{DynamicResource DangerBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Label}"
                                   FontSize="11" FontWeight="Bold"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Accent}" Value="Blue">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Accent}" Value="Amber">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Accent}" Value="Red">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding DisplayValue}"
                               FontSize="20" FontWeight="Bold"
                               Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Accent}" Value="Blue">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Accent}" Value="Amber">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Accent}" Value="Red">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══ Quick Action Primary (industrial blue) ═══ -->
        <Style x:Key="TiQuickActionStyle" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="20"
                                SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush Color="#1D4ED8"/>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#2563EB"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#1E3A8A"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Quick Action Secondary (outline blue) ═══ -->
        <Style x:Key="TiSecondaryActionStyle" TargetType="Button">
            <Setter Property="Foreground"      Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1.5"
                                CornerRadius="16"
                                SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush Color="#FFFFFF" Opacity="0.6"/>
                            </Border.Background>
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#DBEAFE"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ═══ Root: v2.5 smooth pattern ═══ -->
    <Grid Background="{DynamicResource ModuleBackgroundBrush}">

        <Canvas Panel.ZIndex="0"
                IsHitTestVisible="False"
                CacheMode="BitmapCache">
            <Rectangle Fill="{DynamicResource DashAmbientBrush}"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
            <Rectangle Fill="{DynamicResource DashAmbientBlob1Brush}"
                       RenderOptions.EdgeMode="Aliased"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
            <Rectangle Fill="{DynamicResource DashAmbientBlob2Brush}"
                       RenderOptions.EdgeMode="Aliased"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
        </Canvas>

        <ScrollViewer Panel.ZIndex="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      IsDeferredScrollingEnabled="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <StackPanel Margin="24,16,24,24">

                <!-- Page header -->
                <Grid Margin="8,0,8,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧾" FontSize="28"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="Tax Invoices"
                                       FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource AccentTextDeep}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Revenue, VAT, aging and customer analysis — UAE 5% VAT."
                                   FontSize="13" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource TiQuickActionStyle}"
                            Content="Create Tax Invoice"
                            Tag="🧾"
                            Command="{Binding CreateTaxInvoiceCommand}"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Loading -->
                <Border Visibility="{Binding IsLoading,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="12" Margin="8,0,8,12">
                    <TextBlock Text="⏳  Loading tax invoice data…"
                               FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentText}"/>
                </Border>

                <!-- Error (semantic red) -->
                <Border Visibility="{Binding HasError,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{DynamicResource TintRedBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="14"
                        Margin="8,0,8,12">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               FontWeight="Bold"/>
                </Border>

                <!-- Overdue Alert Banner (semantic red — critical) -->
                <Border Visibility="{Binding HasOverdueInvoices,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{DynamicResource TintRedBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="16,12"
                        Margin="8,0,8,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="18"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}">
                                    <Run Text="{Binding OverdueCount, Mode=OneWay}"/>
                                    <Run Text=" invoice(s) overdue — total "/>
                                    <Run Text="{Binding OverdueAmountDisplay, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock
                                    Text="Action required: follow up with customers on outstanding payments."
                                    FontSize="11"
                                    Foreground="{DynamicResource DangerBrush}"
                                    Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="View Overdue →"
                                Command="{Binding ViewOverdueCommand}"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource DangerBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="16"
                                            SnapsToDevicePixels="True"
                                            Padding="14,7">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root"
                                                    Property="Background"
                                                    Value="{DynamicResource TintRedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- KPI HERO TILES -->
                <Border Style="{StaticResource TiParentCardStyle}"
                        Margin="8,0,8,4">
                    <StackPanel>
                        <StackPanel Style="{StaticResource TiCardHeader}">
                            <Border Style="{StaticResource TiCardIcon}"
                                    Background="{StaticResource KpiHeaderBrush}">
                                <TextBlock Text="💰" FontSize="18"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="TAX INVOICE KPIs"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource KpiHeaderBrush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>
                            <TextBlock Text="— Month to Date"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,2,0,0"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding KpiTiles}"
                                      ItemTemplate="{StaticResource TiTileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ROW 2: Recent Invoices + Aging Report -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recent Invoices -->
                    <Border Grid.Column="0"
                            Style="{StaticResource TiParentCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Style="{StaticResource TiCardIcon}"
                                            Background="{StaticResource RecentHeaderBrush}">
                                        <TextBlock Text="📋" FontSize="18"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="RECENT TAX INVOICES"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource RecentHeaderBrush}"/>
                                        <TextBlock Text="Last 5 invoices"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Style="{StaticResource TiSecondaryActionStyle}"
                                        Content="View All →"
                                        Command="{Binding ViewAllInvoicesCommand}"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <ItemsControl
                                ItemsSource="{Binding RecentInvoices}"
                                Visibility="{Binding HasRecentInvoices,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                CornerRadius="10"
                                                Padding="12,10"
                                                Cursor="Hand"
                                                SnapsToDevicePixels="True"
                                                Background="{Binding TintColor,
                                                             Converter={StaticResource BrushKeyConverter}}">
                                            <Border.InputBindings>
                                                <MouseBinding
                                                    MouseAction="LeftClick"
                                                    Command="{Binding DataContext.OpenInvoiceCommand,
                                                              RelativeSource={RelativeSource
                                                                  AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            </Border.InputBindings>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="34" Height="34"
                                                        CornerRadius="17"
                                                        SnapsToDevicePixels="True"
                                                        Background="{Binding StatusColor,
                                                                     Converter={StaticResource BrushKeyConverter}}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding StatusIcon}"
                                                               FontSize="15"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding InvoiceNumber}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="11"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding IssueDateDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding AmountDisplay}"
                                                               FontSize="12" FontWeight="Bold"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <Border CornerRadius="8"
                                                            Padding="8,3"
                                                            Margin="0,4,0,0"
                                                            HorizontalAlignment="Right"
                                                            SnapsToDevicePixels="True"
                                                            Background="{Binding StatusColor,
                                                                         Converter={StaticResource BrushKeyConverter}}">
                                                        <TextBlock Text="{Binding Status}"
                                                                   FontSize="9" FontWeight="Bold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel HorizontalAlignment="Center"
                                        Margin="0,30"
                                        Visibility="{Binding HasRecentInvoices,
                                                     Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="🧾" FontSize="32"
                                           HorizontalAlignment="Center" Opacity="0.35"/>
                                <TextBlock Text="No invoices yet"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,4"
                                           Foreground="{StaticResource AccentTextDeep}"/>
                                <TextBlock Text="Create your first Tax Invoice to see data."
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Invoice Aging (semantic red header — overdue meaning) -->
                    <Border Grid.Column="1"
                            Style="{StaticResource TiParentCardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource TiCardHeader}">
                                <Border Style="{StaticResource TiCardIcon}"
                                        Background="{StaticResource AgingHeaderBrush}">
                                    <TextBlock Text="⏰" FontSize="18"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="INVOICE AGING"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource AgingHeaderBrush}"/>
                                    <TextBlock Text="Overdue by bracket"
                                               FontSize="10"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <ItemsControl
                                ItemsSource="{Binding AgingBrackets}"
                                Visibility="{Binding HasAgingData,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10"
                                                Padding="12,10"
                                                CornerRadius="10"
                                                SnapsToDevicePixels="True"
                                                Background="{Binding TintColor,
                                                             Converter={StaticResource BrushKeyConverter}}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Label}"
                                                               FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding CountDisplay}"
                                                               FontSize="10"
                                                               Margin="10,0,0,0"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding AmountDisplay}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="{Binding SeverityColor,
                                                                            Converter={StaticResource BrushKeyConverter}}"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Border Grid.Row="1"
                                                        Height="8"
                                                        CornerRadius="4"
                                                        Background="{DynamicResource TintIndigoBrush}"
                                                        Margin="0,8,0,0">
                                                    <Border CornerRadius="4"
                                                            HorizontalAlignment="Left"
                                                            SnapsToDevicePixels="True"
                                                            Background="{Binding SeverityColor,
                                                                         Converter={StaticResource BrushKeyConverter}}"
                                                            Width="{Binding NormalizedWidth,
                                                                    Converter={StaticResource PercentToWidthConverter},
                                                                    ConverterParameter=260}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel HorizontalAlignment="Center"
                                        Margin="0,30"
                                        Visibility="{Binding HasAgingData,
                                                     Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="✅" FontSize="32"
                                           HorizontalAlignment="Center" Opacity="0.6"/>
                                <TextBlock Text="No overdue invoices"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,4"
                                           Foreground="{StaticResource AccentTextDeep}"/>
                                <TextBlock Text="All invoices are within payment terms."
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ROW 3: Top Customers + Revenue Chart -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top Customers -->
                    <Border Grid.Column="0"
                            Style="{StaticResource TiParentCardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource TiCardHeader}">
                                <Border Style="{StaticResource TiCardIcon}"
                                        Background="{StaticResource CustomersHeaderBrush}">
                                    <TextBlock Text="🏆" FontSize="18"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="TOP 5 CUSTOMERS"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource CustomersHeaderBrush}"/>
                                    <TextBlock Text="By invoiced amount (last 12 months)"
                                               FontSize="10"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <ItemsControl
                                ItemsSource="{Binding TopCustomers}"
                                Visibility="{Binding HasTopCustomers,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10"
                                                Padding="12,10"
                                                CornerRadius="10"
                                                SnapsToDevicePixels="True"
                                                Background="{DynamicResource MenuHoverBrush}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               FontSize="16"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text"
                                                                        Value="{Binding MedalIcon}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger
                                                                        Binding="{Binding MedalIcon}"
                                                                        Value="">
                                                                        <Setter Property="Text"
                                                                                Value="{Binding Rank}"/>
                                                                        <Setter Property="FontSize"
                                                                                Value="13"/>
                                                                        <Setter Property="FontWeight"
                                                                                Value="Bold"/>
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource MutedForegroundBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding CustomerName}"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding InvoiceCountDisplay}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding AmountDisplay}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                </Grid>

                                                <Border Grid.Row="1"
                                                        Height="5"
                                                        CornerRadius="3"
                                                        Margin="0,8,0,0"
                                                        Background="{DynamicResource TintIndigoBrush}">
                                                    <Border CornerRadius="3"
                                                            HorizontalAlignment="Left"
                                                            SnapsToDevicePixels="True"
                                                            Background="{Binding BarColor,
                                                                         Converter={StaticResource ColorStringConverter}}"
                                                            Width="{Binding NormalizedWidth,
                                                                    Converter={StaticResource PercentToWidthConverter},
                                                                    ConverterParameter=250}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel HorizontalAlignment="Center"
                                        Margin="0,30"
                                        Visibility="{Binding HasTopCustomers,
                                                     Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="🏆" FontSize="32"
                                           HorizontalAlignment="Center" Opacity="0.3"/>
                                <TextBlock Text="No customer data"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,4"
                                           Foreground="{StaticResource AccentTextDeep}"/>
                                <TextBlock Text="Issue invoices to see top customers."
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Revenue Chart -->
                    <Border Grid.Column="1"
                            Style="{StaticResource TiParentCardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource TiCardHeader}">
                                <Border Style="{StaticResource TiCardIcon}"
                                        Background="{StaticResource RevenueHeaderBrush}">
                                    <TextBlock Text="📈" FontSize="18"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="REVENUE TREND"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource RevenueHeaderBrush}"/>
                                    <TextBlock Text="{Binding RevenueChartTitle}"
                                               FontSize="10"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Visibility="{Binding HasRevenueData,
                                               Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding RevenueBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"
                                                         HorizontalAlignment="Stretch"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,0"
                                                  HorizontalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0"
                                                      VerticalAlignment="Bottom"
                                                      Height="160">
                                                    <TextBlock Text="{Binding ValueDisplay}"
                                                               FontSize="9" FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Top"
                                                               Margin="0,0,0,4"
                                                               TextWrapping="NoWrap"
                                                               Foreground="{StaticResource AccentTextDeep}"/>
                                                    <Border Width="46"
                                                            CornerRadius="6,6,0,0"
                                                            VerticalAlignment="Bottom"
                                                            HorizontalAlignment="Center"
                                                            SnapsToDevicePixels="True"
                                                            Background="{Binding BarColor,
                                                                         Converter={StaticResource ColorStringConverter}}"
                                                            Height="{Binding NormalizedHeight,
                                                                     Converter={StaticResource ScaleConverter},
                                                                     ConverterParameter=140}"
                                                            ToolTip="{Binding TooltipText}"/>
                                                </Grid>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Label}"
                                                           FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Amounts in AED · excl. Draft/Cancelled/Void"
                                           FontSize="9"
                                           HorizontalAlignment="Right"
                                           Margin="0,8,4,0"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </Grid>

                            <StackPanel HorizontalAlignment="Center"
                                        Margin="0,40"
                                        Visibility="{Binding HasRevenueData,
                                                     Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="📊" FontSize="36"
                                           HorizontalAlignment="Center" Opacity="0.4"/>
                                <TextBlock Text="No revenue data yet"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,4"
                                           Foreground="{StaticResource AccentTextDeep}"/>
                                <TextBlock Text="Issue Tax Invoices to see the revenue trend."
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Footer -->
                <TextBlock Text="{Binding LastRefreshed}"
                           FontSize="10" Opacity="0.6"
                           Margin="12,12,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>