<!--
═══════════════════════════════════════════════════════════════════════
FILE: Views/Dashboard/TaxInvoice/TiDashboard/TiDashboardView.xaml
CLASS: ProGlassAutomation.Views.Dashboard.TaxInvoice.TiDashboard.TiDashboardView

IMPORTANT — FOLDER MUST MATCH NAMESPACE:
  The file MUST be physically located at:
  Views\Dashboard\TaxInvoice\TiDashboard\TiDashboardView.xaml

  The x:Class attribute declares:
  ProGlassAutomation.Views.Dashboard.TaxInvoice.TiDashboard.TiDashboardView

  The code-behind (TiDashboardView.xaml.cs) must declare the same
  namespace: ProGlassAutomation.Views.Dashboard.TaxInvoice.TiDashboard
═══════════════════════════════════════════════════════════════════════
-->
<UserControl
    x:Class="ProGlassAutomation.Views.Dashboard.TaxInvoice.TiDashboard.TiDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             PARENT CARD
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="TiParentCardStyle" TargetType="Border">
            <Setter Property="Background"          Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"         Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="CornerRadius"        Value="14"/>
            <Setter Property="Padding"             Value="22,18"/>
            <Setter Property="Margin"              Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0"
                                      Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TiCardHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin"      Value="0,0,0,18"/>
        </Style>

        <Style x:Key="TiCardIcon" TargetType="Border">
            <Setter Property="Width"             Value="36"/>
            <Setter Property="Height"            Value="36"/>
            <Setter Property="CornerRadius"      Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0"
                                      Opacity="0.20" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             KPI TILE TEMPLATE — Green | Blue | Amber | Red accents
        ═══════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="TiTileTemplate">
            <Border CornerRadius="10" Padding="14,12" Margin="5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"      Value="#D1FAE5"/>
                        <Setter Property="BorderBrush"     Value="#6EE7B7"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Accent}" Value="Blue">
                                <Setter Property="Background"  Value="#DBEAFE"/>
                                <Setter Property="BorderBrush" Value="#93C5FD"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Accent}" Value="Amber">
                                <Setter Property="Background"  Value="#FEF3C7"/>
                                <Setter Property="BorderBrush" Value="#FCD34D"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Accent}" Value="Red">
                                <Setter Property="Background"  Value="#FEE2E2"/>
                                <Setter Property="BorderBrush" Value="#FCA5A5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                <Setter Property="BorderBrush"     Value="#DC2626"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Label}"
                                   FontSize="11" FontWeight="Bold"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#065F46"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Accent}" Value="Blue">
                                            <Setter Property="Foreground" Value="#1E3A8A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Accent}" Value="Amber">
                                            <Setter Property="Foreground" Value="#92400E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Accent}" Value="Red">
                                            <Setter Property="Foreground" Value="#991B1B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding DisplayValue}"
                               FontSize="20" FontWeight="Bold"
                               Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#047857"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Accent}" Value="Blue">
                                        <Setter Property="Foreground" Value="#1E40AF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Accent}" Value="Amber">
                                        <Setter Property="Foreground" Value="#B45309"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Accent}" Value="Red">
                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════
             QUICK ACTION — PRIMARY (filled accent)
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="TiQuickActionStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3730A3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             QUICK ACTION — SECONDARY (outline)
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="TiSecondaryActionStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1.5"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#6366F1"/>
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT: Smooth 60fps scroll
    ═══════════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  IsDeferredScrollingEnabled="False"
                  PanningMode="None"
                  Focusable="True"
                  FocusVisualStyle="{x:Null}"
                  Background="Transparent"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">

        <StackPanel Margin="24,16,24,24">

            <!-- ══ PAGE HEADER ══ -->
            <Grid Margin="8,0,8,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧾" FontSize="26"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="Tax Invoices"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Revenue, VAT, aging and customer analysis — UAE 5% VAT."
                               FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource TiQuickActionStyle}"
                        Content="Create Tax Invoice"
                        Tag="🧾"
                        Command="{Binding CreateTaxInvoiceCommand}"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- ══ LOADING ══ -->
            <Border Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="12" Margin="8,0,8,12">
                <TextBlock Text="⏳  Loading tax invoice data…"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

            <!-- ══ ERROR ══ -->
            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FEE2E2"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="14"
                    Margin="8,0,8,12">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#991B1B"
                           FontSize="12"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"/>
            </Border>

            <!-- ══ ⚠️ OVERDUE ALERT BANNER ══ -->
            <Border Visibility="{Binding HasOverdueInvoices,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FEE2E2"
                    BorderBrush="#EF4444"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="16,12"
                    Margin="8,0,8,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="Bold"
                                       Foreground="#991B1B">
                                <Run Text="{Binding OverdueCount, Mode=OneWay}"/>
                                <Run Text=" invoice(s) overdue — total "/>
                                <Run Text="{Binding OverdueAmountDisplay, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock
                                Text="Action required: follow up with customers on outstanding payments."
                                FontSize="11"
                                Foreground="#B91C1C"
                                Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="View Overdue →"
                            Command="{Binding ViewOverdueCommand}"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root"
                                        Background="Transparent"
                                        BorderBrush="#EF4444"
                                        BorderThickness="1.5"
                                        CornerRadius="16"
                                        Padding="14,7">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#B91C1C"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root"
                                                Property="Background"
                                                Value="#FEE2E2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ══ 💰 KPI HERO TILES — 5 in a single row ══ -->
            <Border Style="{StaticResource TiParentCardStyle}"
                    Margin="8,0,8,4">
                <StackPanel>
                    <StackPanel Style="{StaticResource TiCardHeader}">
                        <Border Style="{StaticResource TiCardIcon}"
                                Background="#047857">
                            <TextBlock Text="💰" FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="TAX INVOICE KPIs"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#047857"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                        <TextBlock Text="— Month to Date"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,2,0,0"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding KpiTiles}"
                                  ItemTemplate="{StaticResource TiTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ══ ROW 2: Recent Invoices (left) + Aging Report (right) ══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── 📋 RECENT TAX INVOICES ── -->
                <Border Grid.Column="0"
                        Style="{StaticResource TiParentCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Style="{StaticResource TiCardIcon}"
                                        Background="#4338CA">
                                    <TextBlock Text="📋" FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="RECENT TAX INVOICES"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#4338CA"/>
                                    <TextBlock Text="Last 5 invoices"
                                               FontSize="10"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource TiSecondaryActionStyle}"
                                    Content="View All →"
                                    Command="{Binding ViewAllInvoicesCommand}"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Invoice rows -->
                        <ItemsControl
                            ItemsSource="{Binding RecentInvoices}"
                            Visibility="{Binding HasRecentInvoices,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            CornerRadius="10"
                                            Padding="12,10"
                                            Cursor="Hand"
                                            Background="{Binding TintColor,
                                                         Converter={StaticResource BrushKeyConverter}}">
                                        <Border.InputBindings>
                                            <MouseBinding
                                                MouseAction="LeftClick"
                                                Command="{Binding DataContext.OpenInvoiceCommand,
                                                          RelativeSource={RelativeSource
                                                              AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        </Border.InputBindings>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="34" Height="34"
                                                    CornerRadius="17"
                                                    Background="{Binding StatusColor,
                                                                 Converter={StaticResource BrushKeyConverter}}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0">
                                                <TextBlock Text="{Binding StatusIcon}"
                                                           FontSize="15"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding InvoiceNumber}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11"
                                                           Margin="0,2,0,0"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding IssueDateDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding AmountDisplay}"
                                                           FontSize="12" FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                <Border CornerRadius="8"
                                                        Padding="8,3"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Right"
                                                        Background="{Binding StatusColor,
                                                                     Converter={StaticResource BrushKeyConverter}}">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="9" FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center"
                                    Margin="0,30"
                                    Visibility="{Binding HasRecentInvoices,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="🧾" FontSize="32"
                                       HorizontalAlignment="Center" Opacity="0.35"/>
                            <TextBlock Text="No invoices yet"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,4"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Create your first Tax Invoice to see data."
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── ⏰ INVOICE AGING REPORT ── -->
                <Border Grid.Column="1"
                        Style="{StaticResource TiParentCardStyle}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource TiCardHeader}">
                            <Border Style="{StaticResource TiCardIcon}"
                                    Background="#B91C1C">
                                <TextBlock Text="⏰" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center"
                                        Margin="12,0,0,0">
                                <TextBlock Text="INVOICE AGING"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#B91C1C"/>
                                <TextBlock Text="Overdue by bracket"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Aging rows -->
                        <ItemsControl
                            ItemsSource="{Binding AgingBrackets}"
                            Visibility="{Binding HasAgingData,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="12,10"
                                            CornerRadius="10"
                                            Background="{Binding TintColor,
                                                         Converter={StaticResource BrushKeyConverter}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding CountDisplay}"
                                                           FontSize="10"
                                                           Margin="10,0,0,0"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding AmountDisplay}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{Binding SeverityColor,
                                                                        Converter={StaticResource BrushKeyConverter}}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Progress bar -->
                                            <Border Grid.Row="1"
                                                    Height="8"
                                                    CornerRadius="4"
                                                    Background="{DynamicResource BorderBrush}"
                                                    Margin="0,8,0,0">
                                                <Border CornerRadius="4"
                                                        HorizontalAlignment="Left"
                                                        Background="{Binding SeverityColor,
                                                                     Converter={StaticResource BrushKeyConverter}}"
                                                        Width="{Binding NormalizedWidth,
                                                                Converter={StaticResource PercentToWidthConverter},
                                                                ConverterParameter=260}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state — no overdue (good news) -->
                        <StackPanel HorizontalAlignment="Center"
                                    Margin="0,30"
                                    Visibility="{Binding HasAgingData,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="✅" FontSize="32"
                                       HorizontalAlignment="Center" Opacity="0.6"/>
                            <TextBlock Text="No overdue invoices"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,4"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="All invoices are within payment terms."
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ ROW 3: Top Customers (left) + Revenue Chart (right) ══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── 🏆 TOP 5 CUSTOMERS ── -->
                <Border Grid.Column="0"
                        Style="{StaticResource TiParentCardStyle}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource TiCardHeader}">
                            <Border Style="{StaticResource TiCardIcon}"
                                    Background="#B45309">
                                <TextBlock Text="🏆" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center"
                                        Margin="12,0,0,0">
                                <TextBlock Text="TOP 5 CUSTOMERS"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#B45309"/>
                                <TextBlock Text="By invoiced amount (last 12 months)"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <ItemsControl
                            ItemsSource="{Binding TopCustomers}"
                            Visibility="{Binding HasTopCustomers,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="12,10"
                                            CornerRadius="10"
                                            Background="{DynamicResource MenuHoverBrush}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Rank / medal -->
                                                <TextBlock Grid.Column="0"
                                                           FontSize="16"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text"
                                                                    Value="{Binding MedalIcon}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding MedalIcon}"
                                                                    Value="">
                                                                    <Setter Property="Text"
                                                                            Value="{Binding Rank}"/>
                                                                    <Setter Property="FontSize"
                                                                            Value="13"/>
                                                                    <Setter Property="FontWeight"
                                                                            Value="Bold"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Name + invoice count -->
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding CustomerName}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding InvoiceCountDisplay}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                </StackPanel>

                                                <!-- Amount -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding AmountDisplay}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Proportional bar -->
                                            <Border Grid.Row="1"
                                                    Height="5"
                                                    CornerRadius="3"
                                                    Margin="0,8,0,0"
                                                    Background="{DynamicResource BorderBrush}">
                                                <Border CornerRadius="3"
                                                        HorizontalAlignment="Left"
                                                        Background="{Binding BarColor,
                                                                     Converter={StaticResource ColorStringConverter}}"
                                                        Width="{Binding NormalizedWidth,
                                                                Converter={StaticResource PercentToWidthConverter},
                                                                ConverterParameter=250}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center"
                                    Margin="0,30"
                                    Visibility="{Binding HasTopCustomers,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="🏆" FontSize="32"
                                       HorizontalAlignment="Center" Opacity="0.3"/>
                            <TextBlock Text="No customer data"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,4"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Issue invoices to see top customers."
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── 📈 6-MONTH REVENUE TREND CHART ── -->
                <Border Grid.Column="1"
                        Style="{StaticResource TiParentCardStyle}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource TiCardHeader}">
                            <Border Style="{StaticResource TiCardIcon}"
                                    Background="#4338CA">
                                <TextBlock Text="📈" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center"
                                        Margin="12,0,0,0">
                                <TextBlock Text="REVENUE TREND"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#4338CA"/>
                                <TextBlock Text="{Binding RevenueChartTitle}"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Chart bars -->
                        <Grid Visibility="{Binding HasRevenueData,
                                           Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding RevenueBars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"
                                                     HorizontalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,0"
                                              HorizontalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0"
                                                  VerticalAlignment="Bottom"
                                                  Height="160">
                                                <TextBlock Text="{Binding ValueDisplay}"
                                                           FontSize="9" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Top"
                                                           Margin="0,0,0,4"
                                                           TextWrapping="NoWrap"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                <Border Width="46"
                                                        CornerRadius="6,6,0,0"
                                                        VerticalAlignment="Bottom"
                                                        HorizontalAlignment="Center"
                                                        Background="{Binding BarColor,
                                                                     Converter={StaticResource ColorStringConverter}}"
                                                        Height="{Binding NormalizedHeight,
                                                                 Converter={StaticResource ScaleConverter},
                                                                 ConverterParameter=140}"
                                                        ToolTip="{Binding TooltipText}"/>
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Label}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Amounts in AED · excl. Draft/Cancelled/Void"
                                       FontSize="9"
                                       HorizontalAlignment="Right"
                                       Margin="0,8,4,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </Grid>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center"
                                    Margin="0,40"
                                    Visibility="{Binding HasRevenueData,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="📊" FontSize="36"
                                       HorizontalAlignment="Center" Opacity="0.4"/>
                            <TextBlock Text="No revenue data yet"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,4"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Issue Tax Invoices to see the revenue trend."
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ FOOTER ══ -->
            <TextBlock Text="{Binding LastRefreshed}"
                       FontSize="10" Opacity="0.5"
                       Margin="12,12,0,0"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>