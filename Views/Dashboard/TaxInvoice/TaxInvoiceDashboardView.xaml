<UserControl x:Class="ProGlassAutomation.Views.Dashboard.TaxInvoice.TaxInvoiceDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ── Card styles ── -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="24"/>
            <Setter Property="Margin"          Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="TintedCardStyle" TargetType="Border">
            <Setter Property="Background"
                    Value="{Binding TintColor,
                            Converter={StaticResource BrushKeyConverter}}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="20"/>
            <Setter Property="Margin"          Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ── Typography ── -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4338CA"/>
            <Setter Property="Margin"     Value="8,0,8,6"/>
        </Style>

        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="8,0,8,10"/>
        </Style>

        <!-- ── KPI card DataTemplate ─────────────────────────────── -->
        <DataTemplate x:Key="KpiTemplate">
            <Border Style="{StaticResource TintedCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{Binding BadgeColor,
                                             Converter={StaticResource BrushKeyConverter}}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Icon}" FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DisplayValue}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ── Bar chart DataTemplate ─────────────────────────────── -->
        <DataTemplate x:Key="BarTemplate">
            <Grid Margin="8,0" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" VerticalAlignment="Bottom" Height="180">
                    <TextBlock Text="{Binding ValueDisplay}"
                               FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,0,0,4"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <Border Width="70"
                            CornerRadius="6,6,0,0"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Background="{Binding BarColor,
                                         Converter={StaticResource ColorStringConverter}}"
                            Height="{Binding NormalizedHeight,
                                     Converter={StaticResource ScaleConverter},
                                     ConverterParameter=160}"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding Label}"
                           FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="90"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Grid>
        </DataTemplate>

        <!-- ── FEED ROW DataTemplate ─────────────────────────────── -->
        <DataTemplate x:Key="FeedRowTemplate">
            <Border Margin="0,0,0,10"
                    CornerRadius="10"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Left accent bar -->
                        <ColumnDefinition Width="6"/>
                        <!-- Icon -->
                        <ColumnDefinition Width="52"/>
                        <!-- Invoice ID + subtitle -->
                        <ColumnDefinition Width="*"/>
                        <!-- Amount -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Payment Status -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{Binding TintColor,
                                         Converter={StaticResource BrushKeyConverter}}"
                            CornerRadius="10,0,0,10"/>

                    <Border Grid.Column="1"
                            Width="40" Height="40"
                            CornerRadius="20"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="12,12,4,12"
                            Background="{Binding TintColor,
                                         Converter={StaticResource BrushKeyConverter}}">
                        <TextBlock Text="{Binding Icon}"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="12,12,12,12">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{Binding SubTitle}"
                                   FontSize="11"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Column="3"
                            CornerRadius="8"
                            Padding="12,6"
                            VerticalAlignment="Center"
                            Margin="0,12,10,12"
                            Background="{DynamicResource MenuHoverBrush}">
                        <TextBlock Text="{Binding ValueDisplay}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>

                    <Border Grid.Column="4"
                            CornerRadius="8"
                            Padding="14,6"
                            VerticalAlignment="Center"
                            Margin="0,12,16,12"
                            MinWidth="110"
                            Background="{Binding StatusColor,
                                         Converter={StaticResource BrushKeyConverter}}">
                        <TextBlock Text="{Binding StatusLabel}"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="24,16,24,24">

            <!-- Page header -->
            <StackPanel Margin="8,0,8,20">
                <TextBlock Text="Tax Invoice Analytics"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <TextBlock Text="Monitor invoiced amounts, vat compliance, and payments."
                           FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>

            <!-- Loading state -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="12" Margin="8,0,8,12">
                <TextBlock Text="⏳  Loading invoice analytics…" FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

            <!-- KPI CARDS -->
            <TextBlock Text="Financial Overview" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Summary of all generated tax invoices" Style="{StaticResource SectionSubtitle}"/>

            <ItemsControl ItemsSource="{Binding KpiCards}"
                          ItemTemplate="{StaticResource KpiTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- MONTHLY CHART -->
            <TextBlock Text="Monthly Invoiced Trend" Style="{StaticResource SectionTitle}" Margin="8,24,8,6"/>
            <TextBlock Text="Invoice amounts billed in the last 6 months (AED)" Style="{StaticResource SectionSubtitle}"/>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <StackPanel Visibility="{Binding HasChartData, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding MonthlySalesBars}"
                                      ItemTemplate="{StaticResource BarTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border Height="1" Margin="0,4,0,0" Background="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="Billed amount by month" FontSize="11" HorizontalAlignment="Right" Margin="0,10,4,0" Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Margin="0,50"
                                Visibility="{Binding HasChartData, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="No invoices billed yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Go to Delivery Notes and generate an invoice to start tracking charts." FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RECENT FEED -->
            <TextBlock Text="Recent Tax Invoices" Style="{StaticResource SectionTitle}" Margin="8,24,8,6"/>
            <TextBlock Text="Last 10 generated tax invoices" Style="{StaticResource SectionSubtitle}"/>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <StackPanel Visibility="{Binding HasRecentFeed, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding RecentFeed}"
                                      ItemTemplate="{StaticResource FeedRowTemplate}"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Margin="0,50"
                                Visibility="{Binding HasRecentFeed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="🧾" FontSize="48" HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="No tax invoices generated yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer timestamp -->
            <TextBlock Text="{Binding LastRefreshed}" FontSize="11" Opacity="0.5" Margin="12,16,0,0" Foreground="{DynamicResource MutedForegroundBrush}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>