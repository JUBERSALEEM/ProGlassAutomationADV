<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/SheetStore/SheetStoreDashboardView.xaml
     SYSTEM: MERIDIAN — Phase 4 full rewrite (2026-09-18)

     Bindings preserved: KpiCards, CategoryBars, CategoryMixSlices,
     HasChartData, plus IsLoading / HasError / ErrorMessage /
     LastRefreshed from DashboardPageBase. All i18n keys unchanged.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl Style="{StaticResource ErpPageRootStyle}" x:Class="ProGlassAutomation.Views.Dashboard.SheetStore.SheetStoreDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             xmlns:donut="clr-namespace:ProGlassAutomation.Controls.DonutChart"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="{DynamicResource PgPageMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- hero -->
                    <RowDefinition Height="Auto"/>  <!-- state bands -->
                    <RowDefinition Height="Auto"/>  <!-- KPI band / skeleton -->
                    <RowDefinition Height="Auto"/>  <!-- bars + mix -->
                </Grid.RowDefinitions>

                <!-- ══ HERO ═════════════════════════════════════════ -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Module.SheetStore}"
                                   Style="{StaticResource PgHeroTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Dashboard.LiveSnapshotGlassSheetStockValueCoverage}"
                                   Style="{StaticResource PgHeroSubStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border Style="{StaticResource PgLiveChipStyle}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource PgOkBrush}"/>
                                <TextBlock Text="{DynamicResource Common.Live}"
                                           Style="{StaticResource PgLiveTextStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LastRefreshed}"
                                   Style="{StaticResource PgMetaStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- ══ STATE BANDS ═══════════════════════════════════ -->
                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource PgStateBandStyle}"
                            Background="{DynamicResource PgAccentSoftBrush}"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PgSkeletonCircleStyle}" Width="20" Height="20" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="12" Width="180" HorizontalAlignment="Left"/>
                                <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="8" Width="260" Margin="0,6,0,0" HorizontalAlignment="Left" Opacity="0.5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource PgStateBandStyle}"
                            Background="{DynamicResource PgDangerSoftBrush}"
                            Visibility="{Binding HasError,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource PgErrorTextStyle}"/>
                    </Border>
                </StackPanel>

                <!-- ══ SKELETON (visible while loading) ══════════════ -->
                <StackPanel Grid.Row="2" Grid.RowSpan="2"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource PgSkeletonBandStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="16" Width="120" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                            <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="10" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12" Opacity="0.5"/>
                            <ItemsControl Style="{StaticResource PgSkeletonKpiBandStyle}" ItemsPanel="{StaticResource PgSkeletonKpiBandPanel}">
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonKpiTileTemplate}"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonKpiTileTemplate}"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonKpiTileTemplate}"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonKpiTileTemplate}"/>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PgSkeletonCardStyle}" Margin="0,0,16,0">
                            <ContentControl ContentTemplate="{StaticResource PgSkeletonChartTemplate}"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PgSkeletonCardStyle}" Margin="16,0,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="14" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="10" Width="120" HorizontalAlignment="Left" Margin="0,0,0,16" Opacity="0.5"/>
                                <Grid Height="158"><Border Style="{StaticResource PgSkeletonCircleStyle}" Width="110" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PgSkeletonCardStyle}" Margin="0,0,16,0">
                            <ContentControl ContentTemplate="{StaticResource PgSkeletonChartTemplate}"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PgSkeletonCardStyle}" Margin="16,0,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource PgSkeletonBlockStyle}" Height="14" Width="120" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonFeedRowTemplate}"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonFeedRowTemplate}"/>
                                <ContentControl ContentTemplate="{StaticResource PgSkeletonFeedRowTemplate}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ══ KPI BAND ══════════════════════════════════════ -->
                <Border Grid.Row="2" Style="{StaticResource PgCardStyle}" Margin="0,0,0,16"
                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard.StockPulse}"
                                   Style="{StaticResource PgCardTitleStyle}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="{DynamicResource Dashboard.TypesValueCoverageAlerts}"
                                   Style="{StaticResource PgCardSubStyle}"
                                   Margin="0,2,0,12"/>
                        <ItemsControl Style="{StaticResource PgKpiBandStyle}"
                                      ItemsSource="{Binding KpiCards}"
                                      ItemsPanel="{StaticResource PgKpiBandPanel}"
                                      ItemTemplate="{StaticResource PgKpiTileTemplate}"/>
                    </StackPanel>
                </Border>

                <!-- ══ CATEGORY BARS + MIX ═══════════════════════════ -->
                <Grid Grid.Row="3"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PgCardStyle}" Margin="0,0,16,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Dashboard.AvailableSQMCategory}"
                                           Style="{StaticResource PgCardTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.BalanceSheets}"
                                           Style="{StaticResource PgMetaStyle}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Border Style="{StaticResource PgChartWellStyle}"
                                        Visibility="{Binding HasChartData,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                    <trend:TrendChartControl
                                        Points="{Binding CategoryBars}"
                                        SeriesKind="Bar"
                                        SeriesBrush="{DynamicResource PgAccentBrush}"
                                        SeriesEndBrush="{DynamicResource PgAccentHoverBrush}"
                                        GridBrush="{DynamicResource PgHairlineBrush}"
                                        LabelBrush="{DynamicResource PgText3Brush}"
                                        EmptyMessage=""/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,32"
                                            Visibility="{Binding HasChartData,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="&#xE7B8;"
                                               Style="{StaticResource PgEmptyGlyphStyle}"/>
                                    <TextBlock Text="{DynamicResource Dashboard.NoSheetStoreDataYet}"
                                               Style="{StaticResource PgEmptyTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PgCardStyle}" Margin="16,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dashboard.CategoryMix}"
                                       Style="{StaticResource PgCardTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Dashboard.AvailableSQMGlassCategory}"
                                       Style="{StaticResource PgCardSubStyle}"
                                       Margin="0,2,0,10"/>
                            <donut:DonutChartControl Height="158"
                                                     Slices="{Binding CategoryMixSlices}"
                                                     HoleLabel="SQM"
                                                     EmptyMessage="No stock mix yet."
                                                     Thickness="16"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
