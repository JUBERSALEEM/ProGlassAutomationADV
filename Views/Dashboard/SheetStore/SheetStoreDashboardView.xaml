<!-- ═══════════════════════════════════════════════════════════════════
     SHEET STORE DASHBOARD — on the shared dashboard grammar.

     Grammar: Styles/DashboardKit.xaml (Db* keys only).
     Cards use Surface.Primary.CornerRadius (Appearance slider).
     Contract: hero → states → KPI band → primary visual → detail.
     All four states present: loading, error, empty, data.

     Bindings unchanged: KpiCards, CategoryBars, CategoryMixSlices,
     HasChartData, plus IsLoading / HasError / ErrorMessage /
     LastRefreshed from DashboardPageBase.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Dashboard.SheetStore.SheetStoreDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             xmlns:donut="clr-namespace:ProGlassAutomation.Controls.DonutChart"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="{DynamicResource DbPageMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── hero ────────────────────────────────────────── -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Module.SheetStore}"
                                   Style="{StaticResource DbTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Dashboard.LiveSnapshotGlassSheetStockValueCoverage}"
                                   Style="{StaticResource DbSubtitleStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border Style="{StaticResource DbChipStyle}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{DynamicResource Common.Live}"
                                           FontSize="{StaticResource TextCaption}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LastRefreshed}"
                                   Style="{StaticResource DbMetaStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- ── loading + error ─────────────────────────────── -->
                                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource DbStateBandStyle}"
                            Background="{DynamicResource TintBlueBrush}"
                            BorderBrush="{DynamicResource InfoBrush}"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource DbSkeletonCircleStyle}" Width="20" Height="20" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="12" Width="180" HorizontalAlignment="Left"/>
                                <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="8" Width="260" Margin="0,6,0,0" HorizontalAlignment="Left" Opacity="0.5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource DbStateBandStyle}"
                            Background="{DynamicResource TintRedBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            Visibility="{Binding HasError,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource DbErrorTextStyle}"/>
                    </Border>
                </StackPanel>

                <!-- ── KPI band ────────────────────────────────────── -->

                <!-- ── SKELETON (visible when loading) ─────────────── -->
                <StackPanel Grid.Row="2" Grid.RowSpan="3"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">

                    <Border Style="{StaticResource DbSkeletonBandStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="16" Width="120" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                            <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12" Opacity="0.5"/>
                            <ItemsControl Style="{StaticResource DbSkeletonKpiBandStyle}" ItemsPanel="{StaticResource DbSkeletonKpiBandPanel}">
                                <Border Style="{StaticResource DbTileStyle}" Opacity="0.95"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="12" Width="72" HorizontalAlignment="Left"/><Border Grid.Column="1" Style="{StaticResource DbSkeletonCircleStyle}" Width="28" Height="28"/></Grid><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="22" Width="88" Margin="0,14,0,0" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="120" Margin="0,10,0,0" HorizontalAlignment="Left" Opacity="0.4"/></StackPanel></Border>
                                <Border Style="{StaticResource DbTileStyle}"><StackPanel><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="12" Width="72" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="22" Width="88" Margin="0,14,0,0" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="120" Margin="0,10,0,0" HorizontalAlignment="Left" Opacity="0.4"/></StackPanel></Border>
                                <Border Style="{StaticResource DbTileStyle}"><StackPanel><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="12" Width="72" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="22" Width="88" Margin="0,14,0,0" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="120" Margin="0,10,0,0" HorizontalAlignment="Left" Opacity="0.4"/></StackPanel></Border>
                                <Border Style="{StaticResource DbTileStyle}"><StackPanel><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="12" Width="72" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="22" Width="88" Margin="0,14,0,0" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="120" Margin="0,10,0,0" HorizontalAlignment="Left" Opacity="0.4"/></StackPanel></Border>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource DbCardStyle}" Margin="0,0,7,0">
                            <ContentControl ContentTemplate="{StaticResource DbSkeletonChartTemplate}"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource DbCardStyle}" Margin="7,0,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="14" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="120" HorizontalAlignment="Left" Margin="0,0,0,16" Opacity="0.5"/>
                                <Grid Height="158"><Border Style="{StaticResource DbSkeletonCircleStyle}" Width="110" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource DbCardStyle}" Margin="0,0,7,0">
                            <ContentControl ContentTemplate="{StaticResource DbSkeletonChartTemplate}"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource DbCardStyle}" Margin="7,0,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="14" Width="120" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource DbRowCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource DbSkeletonCircleStyle}" Margin="0,0,11,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="13" Width="140" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="180" Margin="0,6,0,0" HorizontalAlignment="Left" Opacity="0.5"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="13" Width="56" HorizontalAlignment="Right"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="16" Width="48" Margin="0,6,0,0" HorizontalAlignment="Right" CornerRadius="{DynamicResource Surface.Primary.CornerRadius}"/></StackPanel></Grid></Border>
                                <Border Style="{StaticResource DbRowCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource DbSkeletonCircleStyle}" Margin="0,0,11,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="13" Width="140" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="180" Margin="0,6,0,0" HorizontalAlignment="Left" Opacity="0.5"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="13" Width="56" HorizontalAlignment="Right"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="16" Width="48" Margin="0,6,0,0" HorizontalAlignment="Right" CornerRadius="{DynamicResource Surface.Primary.CornerRadius}"/></StackPanel></Grid></Border>
                                <Border Style="{StaticResource DbRowCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource DbSkeletonCircleStyle}" Margin="0,0,11,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="13" Width="140" HorizontalAlignment="Left"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="180" Margin="0,6,0,0" HorizontalAlignment="Left" Opacity="0.5"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="13" Width="56" HorizontalAlignment="Right"/><Border Style="{StaticResource DbSkeletonBlockStyle}" Height="16" Width="48" Margin="0,6,0,0" HorizontalAlignment="Right" CornerRadius="{DynamicResource Surface.Primary.CornerRadius}"/></StackPanel></Grid></Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource DbCardStyle}" Margin="0,0,0,14" Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource DbSectionHeadStyle}">
                            <TextBlock Text="{DynamicResource Dashboard.StockPulse}"
                                       Style="{StaticResource DbSectionTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Dashboard.TypesValueCoverageAlerts}"
                                       Style="{StaticResource DbSectionSubStyle}"/>
                        </StackPanel>
                        <ItemsControl Style="{StaticResource DbKpiBandStyle}"
                                      ItemsSource="{Binding KpiCards}"
                                      ItemsPanel="{StaticResource DbKpiBandPanel}"
                                      ItemTemplate="{StaticResource DbKpiTileTemplate}"/>
                    </StackPanel>
                </Border>

                <!-- ── primary visual + mix ────────────────────────── -->
                <Grid Grid.Row="3" Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DbCardStyle}"
                            Margin="0,0,7,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Dashboard.AvailableSQMCategory}"
                                           Style="{StaticResource DbSectionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.BalanceSheets}"
                                           Style="{StaticResource DbMetaStyle}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid>
                                <Border Style="{StaticResource DbChartWellStyle}"
                                        Visibility="{Binding HasChartData,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                    <trend:TrendChartControl
                                        Points="{Binding CategoryBars}"
                                        SeriesKind="Bar"
                                        SeriesBrush="{DynamicResource AccentBrush}"
                                        SeriesEndBrush="{DynamicResource AccentDarkBrush}"
                                        GridBrush="{DynamicResource DividerBrush}"
                                        LabelBrush="{DynamicResource TextTertiaryBrush}"
                                        EmptyMessage=""/>
                                </Border>

                                <StackPanel VerticalAlignment="Center" Margin="0,32"
                                            Visibility="{Binding HasChartData,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="&#xE7B8;"
                                               Style="{StaticResource DbEmptyGlyphStyle}"/>
                                    <TextBlock Text="{DynamicResource Dashboard.NoSheetStoreDataYet}"
                                               Style="{StaticResource DbEmptyTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DbCardStyle}"
                            Margin="7,0,0,0">
                        <StackPanel>
                            <StackPanel Style="{StaticResource DbSectionHeadStyle}">
                                <TextBlock Text="{DynamicResource Dashboard.CategoryMix}"
                                           Style="{StaticResource DbSectionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.AvailableSQMGlassCategory}"
                                           Style="{StaticResource DbSectionSubStyle}"/>
                            </StackPanel>
                            <donut:DonutChartControl Height="158"
                                                     Slices="{Binding CategoryMixSlices}"
                                                     HoleLabel="SQM"
                                                     EmptyMessage="No stock mix yet."
                                                     Thickness="16"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
