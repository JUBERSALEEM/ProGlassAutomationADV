<UserControl x:Class="ProGlassAutomation.Views.Dashboard.SheetStore.SheetStoreDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Padding"         Value="24"/>
            <Setter Property="Margin"          Value="8"/>
        </Style>

        <!-- tinted KPI card -->
        <Style x:Key="TintedCardStyle" TargetType="Border">
            <Setter Property="Background"
                    Value="{Binding TintColor,
                            Converter={StaticResource ColorStringConverter}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Padding"         Value="22"/>
            <Setter Property="Margin"          Value="8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                    <Setter Property="BorderBrush"     Value="#EF4444"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin"     Value="8,0,8,4"/>
        </Style>

        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin"     Value="8,0,8,10"/>
        </Style>

        <DataTemplate x:Key="KpiTemplate">
            <Border Style="{StaticResource TintedCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="11"
                                Background="{Binding BadgeColor,
                                             Converter={StaticResource ColorStringConverter}}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Icon}" FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#374151"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DisplayValue}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="#0F172A" Margin="0,14,0,0"/>
                    <TextBlock Text="{Binding SubLabel}"
                               FontSize="11" Margin="0,6,0,0"
                               Foreground="#6B7280"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CategoryBarTemplate">
            <Grid Margin="10,0" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" VerticalAlignment="Bottom" Height="200">
                    <TextBlock Text="{Binding ValueDisplay}"
                               FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,0,0,4"
                               Foreground="#0F172A"/>
                    <Border Width="70"
                            CornerRadius="8,8,4,4"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Background="{Binding BarColor,
                                         Converter={StaticResource ColorStringConverter}}"
                            Height="{Binding NormalizedHeight,
                                     Converter={StaticResource ScaleConverter},
                                     ConverterParameter=180}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighlight}" Value="True">
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="20"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.4"
                                                                  Color="#6366F1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding Label}"
                           FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="90"
                           Margin="0,10,0,0"
                           Foreground="#6B7280"/>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,40">

            <StackPanel Margin="8,0,8,20">
                <TextBlock Text="Sheet Store"
                           FontSize="30" FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="Track inventory, monitor stock levels, and manage glass sheet types."
                           FontSize="13" Margin="0,4,0,0"
                           Foreground="#6B7280"/>
            </StackPanel>

            <Border Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="12" Margin="8,0,8,12">
                <TextBlock Text="⏳  Loading sheet store data…" FontSize="13"
                           HorizontalAlignment="Center" Foreground="#6B7280"/>
            </Border>

            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FEE2E2" CornerRadius="12"
                    Padding="16" Margin="8,0,8,12">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#991B1B" FontSize="13" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="Inventory Overview" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Live snapshot of your glass sheet stock" Style="{StaticResource SectionSubtitle}"/>

            <ItemsControl ItemsSource="{Binding KpiCards}"
                          ItemTemplate="{StaticResource KpiTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock Text="Available SQM by Category"
                       Style="{StaticResource SectionTitle}"
                       Margin="8,28,8,4"/>
            <TextBlock Text="Balance sheets grouped by glass category"
                       Style="{StaticResource SectionSubtitle}"/>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <StackPanel Visibility="{Binding HasChartData,
                                             Converter={StaticResource BoolToVisibilityConverter}}">

                        <ItemsControl ItemsSource="{Binding CategoryBars}"
                                      ItemTemplate="{StaticResource CategoryBarTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Height="1" Margin="0,4,0,0" Background="#E5E7EB"/>

                        <TextBlock Text="Values in m² · balance sheets only"
                                   FontSize="11" HorizontalAlignment="Right"
                                   Margin="0,10,4,0" Foreground="#9CA3AF"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Margin="0,50"
                                Visibility="{Binding HasChartData,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="📦" FontSize="48"
                                   HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="No sheet store data yet"
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4" Foreground="#0F172A"/>
                        <TextBlock Text="Add glass sheets in the Sheet Store module."
                                   FontSize="12" HorizontalAlignment="Center"
                                   Foreground="#6B7280"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding LastRefreshed}"
                       FontSize="11" Opacity="0.5" Margin="10,14,0,0"
                       Foreground="#6B7280"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>