<!-- LAYOUT-03 BENTO MOSAIC — Sheet Store. Bindings unchanged. -->
<UserControl x:Class="ProGlassAutomation.Views.Dashboard.SheetStore.SheetStoreDashboardView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             xmlns:donut="clr-namespace:ProGlassAutomation.Controls.DonutChart"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="{StaticResource IndustrialDashboardPageMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="260"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Module.SheetStore}"
                                   Style="{StaticResource SoftHeroTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Dashboard.LiveSnapshotGlassSheetStockValueCoverage}"
                                   Style="{StaticResource SoftHeroSubtitleStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource SoftChipStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{DynamicResource Common.Live}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LastRefreshed}"
                                   Style="{StaticResource SoftMetaStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource SoftSectionStyle}"
                            Padding="16,12"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Dashboard.LoadingSheetStoreData}"
                                   Style="{StaticResource SoftKpiFootStyle}"/>
                    </Border>
                    <Border Style="{StaticResource SoftSectionStyle}"
                            Padding="16,12"
                            Background="{DynamicResource TintRedBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            Visibility="{Binding HasError,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="{StaticResource TextBody}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}"/>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IndustrialDashboardCardStyle}"
                            Margin="0,0,18,0" >
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Dashboard.StockPulse}"
                                           Style="{StaticResource SoftSectionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.TypesValueCoverageAlerts}"
                                           Style="{StaticResource SoftSectionSubtitleStyle}"/>
                            </StackPanel>
                            <ItemsControl Style="{StaticResource IndustrialDashboardFeedItemsStyle}"
                                          ItemsSource="{Binding KpiCards}"
                                          ItemTemplate="{StaticResource SoftKpiCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource IndustrialDashboardCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dashboard.CategoryMix}"
                                       Style="{StaticResource SoftSectionTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Dashboard.AvailableSQMGlassCategory}"
                                       Style="{StaticResource SoftSectionSubtitleStyle}"/>
                            <donut:DonutChartControl Height="150"
                                                     Slices="{Binding CategoryMixSlices}"
                                                     HoleLabel="SQM"
                                                     EmptyMessage="No stock mix yet."
                                                     Thickness="16"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource IndustrialDashboardCardStyle}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Dashboard.AvailableSQMCategory}"
                                       Style="{StaticResource SoftSectionTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Dashboard.BalanceSheets}"
                                       Style="{StaticResource SoftMetaStyle}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Border Style="{StaticResource IndustrialDashboardChartWellStyle}"
                                    Visibility="{Binding HasChartData,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <trend:TrendChartControl
                                    Points="{Binding CategoryBars}"
                                    SeriesKind="Bar"
                                    EmptyMessage="Stock by category — no data yet."
                                    SeriesBrush="{DynamicResource AccentBrush}"
                                    SeriesEndBrush="{DynamicResource AccentDarkBrush}"
                                    GridBrush="{DynamicResource DividerBrush}"
                                    LabelBrush="{DynamicResource MutedForegroundBrush}"/>
                            </Border>
                            <Border Padding="0,40"
                                    Visibility="{Binding HasChartData,
                                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE7B8;"
                                               Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                    <TextBlock Text="{DynamicResource Dashboard.NoSheetStoreDataYet}"
                                               Style="{StaticResource DashEmptyStateTextStyle}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
