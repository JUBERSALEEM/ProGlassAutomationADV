<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/SheetStore/SheetStoreDashboardView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Sheet Store Dashboard (Chat 23 v2.1)
     VERSION: Chat 23 v2.1 — Industrial Blue Glassmorphism

     DESIGN LANGUAGE:
       Matches Overview + Statement dashboards v2.0/v1.7.
       Glass blue ambient background, white glass cards with blue
       border sheen, industrial typography, frozen shadows.

     CRITICAL ARCHITECTURE:
       Ambient/glass/shadow colors declared INLINE as frozen local
       resources (proven pattern from Chat 23 v1.7 — DynamicResource
       ambient keys were not resolving reliably in this build).
       Semantic channels (Badge/Tint via BrushKeyConverter) preserved
       as DynamicResource — those channels resolve correctly.

     CHANGES vs previous:
       • Wrapped ScrollViewer in Grid with inline glass blue ambient
       • Added ambient blob overlays with BitmapCache
       • CardStyle rebuilt as glass surface with blue border sheen
       • TintedCardStyle border changed from theme BorderBrush to
         inline glass blue (visible on tinted bg, no more washed-out look)
       • SectionTitle: #4338CA indigo → #1E3A8A industrial blue
       • CategoryBar highlight glow: #6366F1 → #1D4ED8 (frozen shared)
       • Page title enlarged 28→30px (design system standard)
       • Loading text uses accent blue
       • Empty state icon color tone updated
       • Chart card uses glass surface style

     PRESERVED (zero regression):
       • ALL bindings (KpiCards, CategoryBars, HasChartData,
         IsLoading, HasError, ErrorMessage, LastRefreshed)
       • KpiCardModel structure (Icon, Title, DisplayValue,
         BadgeColor, TintColor, SubLabel, IsAlert)
       • ChartBarModel structure
       • BrushKeyConverter usage on badge + tint
       • ColorStringConverter on BarColor
       • ScaleConverter on NormalizedHeight
       • IsAlert DataTrigger — red border override
       • IsHighlight DataTrigger — bar glow
       • SmoothScrollBehavior
       • Empty state layout
       • Error state (semantic red)

     REGRESSION RISK: LOW
       Inline colors proven to render. Bindings unchanged.
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Dashboard.SheetStore.SheetStoreDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══════════════════════════════════════════════════════════════
             GLASS BLUE PALETTE (frozen inline — guaranteed render)
        ═══════════════════════════════════════════════════════════════ -->

        <!-- Ambient background gradient -->
        <LinearGradientBrush x:Key="AmbientBg"
                             StartPoint="0,0" EndPoint="1,1"
                             po:Freeze="True">
            <GradientStop Color="#E8F0FE" Offset="0.0"/>
            <GradientStop Color="#DBE7F9" Offset="0.5"/>
            <GradientStop Color="#C7D9F0" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Ambient blobs -->
        <RadialGradientBrush x:Key="Blob1"
                             Center="0.85,0.10"
                             GradientOrigin="0.85,0.10"
                             RadiusX="0.4" RadiusY="0.4"
                             po:Freeze="True">
            <GradientStop Color="#3B82F640" Offset="0.0"/>
            <GradientStop Color="#3B82F600" Offset="1.0"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="Blob2"
                             Center="0.10,0.85"
                             GradientOrigin="0.10,0.85"
                             RadiusX="0.35" RadiusY="0.35"
                             po:Freeze="True">
            <GradientStop Color="#1E40AF30" Offset="0.0"/>
            <GradientStop Color="#1E40AF00" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- Glass surface + border -->
        <SolidColorBrush x:Key="GlassSurface"
                         Color="#FFFFFF"
                         Opacity="0.92"
                         po:Freeze="True"/>

        <SolidColorBrush x:Key="GlassBorder"
                         Color="#B8CDE8"
                         po:Freeze="True"/>

        <!-- Accent tones -->
        <SolidColorBrush x:Key="AccentTextDeep"
                         Color="#1E3A8A"
                         po:Freeze="True"/>

        <SolidColorBrush x:Key="AccentText"
                         Color="#1E40AF"
                         po:Freeze="True"/>

        <!-- Shadows -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="20"
                          ShadowDepth="4"
                          Opacity="0.14"
                          Color="#1E3A8A"
                          Direction="270"
                          po:Freeze="True"/>

        <!-- Bar highlight glow (was inline #6366F1, now frozen royal blue) -->
        <DropShadowEffect x:Key="BarHighlightGlow"
                          BlurRadius="20"
                          ShadowDepth="0"
                          Opacity="0.45"
                          Color="#1D4ED8"
                          po:Freeze="True"/>

        <!-- ═══════════════════════════════════════════════════════════════
             CARD STYLES
        ═══════════════════════════════════════════════════════════════ -->

        <!-- Plain glass card (chart container) -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource GlassSurface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Padding"         Value="24"/>
            <Setter Property="Margin"          Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect"          Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- Tinted KPI card (uses VM TintColor via BrushKeyConverter) -->
        <Style x:Key="TintedCardStyle" TargetType="Border">
            <Setter Property="Background"
                    Value="{Binding TintColor,
                            Converter={StaticResource BrushKeyConverter}}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="Padding"         Value="20"/>
            <Setter Property="Margin"          Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect"          Value="{StaticResource CardShadow}"/>
            <Style.Triggers>
                <!-- Alert override — semantic red border (preserved) -->
                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                    <Setter Property="BorderBrush"     Value="{DynamicResource DangerBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             TYPOGRAPHY
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentTextDeep}"/>
            <Setter Property="Margin"     Value="8,0,8,6"/>
        </Style>

        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin"     Value="8,0,8,10"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             KPI CARD TEMPLATE
        ═══════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="KpiTemplate">
            <Border Style="{StaticResource TintedCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="10"
                                Background="{Binding BadgeColor,
                                             Converter={StaticResource BrushKeyConverter}}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Icon}" FontSize="20"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DisplayValue}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,14,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SubLabel}"
                               FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════════
             CATEGORY BAR TEMPLATE
        ═══════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="CategoryBarTemplate">
            <Grid Margin="8,0" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" VerticalAlignment="Bottom" Height="200">
                    <TextBlock Text="{Binding ValueDisplay}"
                               FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,0,0,4"
                               Foreground="{StaticResource AccentTextDeep}"/>
                    <Border Width="70"
                            CornerRadius="6,6,0,0"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Background="{Binding BarColor,
                                         Converter={StaticResource ColorStringConverter}}"
                            Height="{Binding NormalizedHeight,
                                     Converter={StaticResource ScaleConverter},
                                     ConverterParameter=180}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighlight}" Value="True">
                                        <!-- Frozen shared glow (was inline #6366F1) -->
                                        <Setter Property="Effect"
                                                Value="{StaticResource BarHighlightGlow}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding Label}"
                           FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="90"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT — GLASS BLUE AMBIENT
    ═══════════════════════════════════════════════════════════════ -->
    <Grid Background="{StaticResource AmbientBg}">

        <!-- Ambient blob overlays (BitmapCached) -->
        <Canvas Panel.ZIndex="0"
                IsHitTestVisible="False"
                CacheMode="BitmapCache">
            <Rectangle Fill="{StaticResource Blob1}"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
            <Rectangle Fill="{StaticResource Blob2}"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
        </Canvas>

        <!-- Main scroll surface -->
        <ScrollViewer Panel.ZIndex="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      IsDeferredScrollingEnabled="False"
                      PanningMode="VerticalOnly"
                      Focusable="True"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="24,16,24,24">

                <!-- Page header -->
                <StackPanel Margin="8,0,8,20">
                    <TextBlock Text="Sheet Store"
                               FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource AccentTextDeep}"/>
                    <TextBlock Text="Track inventory, monitor stock levels, and manage glass sheet types."
                               FontSize="13" Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <!-- Loading -->
                <Border Visibility="{Binding IsLoading,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="12" Margin="8,0,8,12">
                    <TextBlock Text="⏳  Loading sheet store data…"
                               FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentText}"/>
                </Border>

                <!-- Error (semantic red — preserved) -->
                <Border Visibility="{Binding HasError,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{DynamicResource TintRedBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="14" Margin="8,0,8,12">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12" TextWrapping="Wrap" FontWeight="Bold"/>
                </Border>

                <!-- Inventory Overview section -->
                <TextBlock Text="Inventory Overview" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Live snapshot of your glass sheet stock" Style="{StaticResource SectionSubtitle}"/>

                <ItemsControl ItemsSource="{Binding KpiCards}"
                              ItemTemplate="{StaticResource KpiTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Chart section -->
                <TextBlock Text="Available SQM by Category"
                           Style="{StaticResource SectionTitle}"
                           Margin="8,24,8,6"/>
                <TextBlock Text="Balance sheets grouped by glass category"
                           Style="{StaticResource SectionSubtitle}"/>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel Visibility="{Binding HasChartData,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">

                            <ItemsControl ItemsSource="{Binding CategoryBars}"
                                          ItemTemplate="{StaticResource CategoryBarTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Border Height="1" Margin="0,4,0,0"
                                    Background="{DynamicResource TintIndigoBrush}"/>

                            <TextBlock Text="Values in m² · balance sheets only"
                                       FontSize="11" HorizontalAlignment="Right"
                                       Margin="0,10,4,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="0,50"
                                    Visibility="{Binding HasChartData,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="📦" FontSize="48"
                                       HorizontalAlignment="Center" Opacity="0.4"/>
                            <TextBlock Text="No sheet store data yet"
                                       FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{StaticResource AccentTextDeep}"/>
                            <TextBlock Text="Add glass sheets in the Sheet Store module."
                                       FontSize="12" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding LastRefreshed}"
                           FontSize="11" Opacity="0.6" Margin="12,16,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>