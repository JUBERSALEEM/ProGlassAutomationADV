<!-- ════════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/JobOrder/JoDashboard/JoDashboardView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Job Order Dashboard

     SOFT-CARD REDESIGN — the reference dashboard markup supplied by
     the user, applied identically across all 7 dashboards. The look is
     defined ONCE in Styles/DashboardStyles.xaml (the Soft* keys) so the
     seven pages cannot drift apart the way the old per-file CardStyle
     copies did.

     Reference traits reproduced: hero band radius 22 with a 30px Bold
     title, cards radius 18 / padding 20 / margin 0,0,0,20, hairline
     border + DropShadow(10, 2, .08), a 4px full-bleed colour cap on
     each KPI card, 11px label + 28px Bold value + 12px status line, a
     40x40 radius-10 badge top-right, radius-10 pill buttons and a
     recessed radius-12 chart well.

     DEVIATIONS, EACH FORCED (see DashboardStyles.xaml for detail):
       1. Colour resolves via DynamicResource, not hardcoded hex, or
          every card would stay white in Dark theme.
       2. Charts use TrendChartControl: LiveChartsCore is not a
          PackageReference in this project and NuGet is unreachable
          from the build sandbox.
       3. Segoe MDL2 glyphs, never emoji.

     BINDINGS — UNCHANGED. NO VIEWMODEL WAS EDITED.
       KpiCards, StatusBars, PriorityBars, RecentFeed,
       HasStatusData, HasRecentFeed, IsLoading, HasError,
       ErrorMessage, LastRefreshed
══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Dashboard.JobOrder.JoDashboard.JoDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <StackPanel Margin="24">

                <!-- HERO -->
                <Border Style="{StaticResource SoftHeroStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Job Orders"
                                       Style="{StaticResource SoftHeroTitleStyle}"/>
                            <TextBlock Text="Production workload, priority mix and recent job activity"
                                       Style="{StaticResource SoftHeroSubtitleStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource SoftChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource SuccessBrush}"/>
                                    <TextBlock Text="Live"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding LastRefreshed}"
                                       Style="{StaticResource SoftMetaStyle}"
                                       HorizontalAlignment="Right"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- LOADING -->
                <Border Style="{StaticResource SoftSectionStyle}"
                        Padding="16,14"
                        Visibility="{Binding IsLoading,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Loading job order data…"
                                   Style="{StaticResource SoftKpiFootStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ERROR -->
                <Border Style="{StaticResource SoftSectionStyle}"
                        Padding="16,14"
                        Background="{DynamicResource TintRedBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        Visibility="{Binding HasError,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DangerBrush}"/>
                    </StackPanel>
                </Border>

                <!-- KPI ROW -->
                <TextBlock Text="Production Overview"
                           Style="{StaticResource SoftGroupHeadingStyle}"/>
                <ItemsControl ItemsSource="{Binding KpiCards}"
                              ItemTemplate="{StaticResource SoftKpiCardTemplate}"
                              ItemsPanel="{StaticResource SoftKpiRowPanel}"
                              Margin="-5,0,-5,18"/>

                <!-- CHART ROW -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource SoftSectionStyle}"
                            Margin="0,0,10,20">
                        <StackPanel>
                            <TextBlock Text="Status Distribution"
                                       Style="{StaticResource SoftSectionTitleStyle}"/>
                            <TextBlock Text="Job orders grouped by current status"
                                       Style="{StaticResource SoftSectionSubtitleStyle}"/>

                            <Grid>
                                <Border Style="{StaticResource SoftChartWellStyle}"
                                        Visibility="{Binding HasStatusData,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                    <trend:TrendChartControl
                                        Height="260"
                                        Points="{Binding StatusBars}"
                                        SeriesKind="Bar"
                                        EmptyMessage="Job order count by status — no data yet."
                                        SeriesBrush="{DynamicResource AccentBrush}"
                                        GridBrush="{DynamicResource DividerBrush}"
                                        LabelBrush="{DynamicResource MutedForegroundBrush}"/>
                                </Border>

                                <Border Padding="0,60"
                                        Visibility="{Binding HasStatusData,
                                            Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE9F9;"
                                                   Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                        <TextBlock Text="No job orders yet"
                                                   Style="{StaticResource DashEmptyStateTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="Job order count by status"
                                       Style="{StaticResource SoftMetaStyle}"
                                       HorizontalAlignment="Right"
                                       Margin="0,12,2,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource SoftSectionStyle}"
                            Margin="10,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Priority Breakdown"
                                       Style="{StaticResource SoftSectionTitleStyle}"/>
                            <TextBlock Text="Job orders grouped by assigned priority"
                                       Style="{StaticResource SoftSectionSubtitleStyle}"/>

                            <Grid>
                                <Border Style="{StaticResource SoftChartWellStyle}"
                                        Visibility="{Binding HasStatusData,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                    <trend:TrendChartControl
                                        Height="260"
                                        Points="{Binding PriorityBars}"
                                        SeriesKind="Bar"
                                        EmptyMessage="Job order count by priority — no data yet."
                                        SeriesBrush="{DynamicResource AccentBrush}"
                                        GridBrush="{DynamicResource DividerBrush}"
                                        LabelBrush="{DynamicResource MutedForegroundBrush}"/>
                                </Border>

                                <Border Padding="0,60"
                                        Visibility="{Binding HasStatusData,
                                            Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8FD;"
                                                   Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                        <TextBlock Text="No priority data yet"
                                                   Style="{StaticResource DashEmptyStateTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="Job order count by priority"
                                       Style="{StaticResource SoftMetaStyle}"
                                       HorizontalAlignment="Right"
                                       Margin="0,12,2,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- FEED -->
                <Border Style="{StaticResource SoftSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="Recent Job Orders"
                                   Style="{StaticResource SoftSectionTitleStyle}"/>
                        <TextBlock Text="Last 10 job orders, most recently updated first"
                                   Style="{StaticResource SoftSectionSubtitleStyle}"/>

                        <ItemsControl ItemsSource="{Binding RecentFeed}"
                                      ItemTemplate="{StaticResource SoftFeedRowTemplate}"
                                      Visibility="{Binding HasRecentFeed,
                                          Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <Border Padding="0,40"
                                Visibility="{Binding HasRecentFeed,
                                    Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE9F9;"
                                           Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                <TextBlock Text="No job orders yet"
                                           Style="{StaticResource DashEmptyStateTextStyle}"/>
                                <TextBlock Text="Convert an approved proforma invoice into a job order."
                                           Style="{StaticResource SoftMetaStyle}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
