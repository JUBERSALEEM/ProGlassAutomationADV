<!-- ═══════════════════════════════════════════════════════════════════
     JOB ORDER DASHBOARD — on the shared dashboard grammar.

     Grammar: Styles/DashboardKit.xaml (Db* keys only).
     Contract: hero → states → KPI band → primary visual → detail.

     Bindings unchanged: KpiCards, StatusBars, PriorityBars,
     StatusMixSlices, RecentFeed, HasStatusData, HasRecentFeed, plus the
     DashboardPageBase states.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Dashboard.JobOrder.JoDashboard.JoDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             xmlns:donut="clr-namespace:ProGlassAutomation.Controls.DonutChart"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="{StaticResource DbPageMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── hero ────────────────────────────────────────── -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard.JobOrders}"
                                   Style="{StaticResource DbTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Dashboard.ProductionWorkloadPriorityMixRecentJob}"
                                   Style="{StaticResource DbSubtitleStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border Style="{StaticResource DbChipStyle}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{DynamicResource Common.Live}"
                                           FontSize="{StaticResource TextCaption}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LastRefreshed}"
                                   Style="{StaticResource DbMetaStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- ── loading + error ─────────────────────────────── -->
                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource DbStateBandStyle}"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Dashboard.LoadingJobOrderData}"
                                   Style="{StaticResource DbStateTextStyle}"/>
                    </Border>
                    <Border Style="{StaticResource DbStateBandStyle}"
                            Background="{DynamicResource TintRedBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            Visibility="{Binding HasError,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource DbErrorTextStyle}"/>
                    </Border>
                </StackPanel>

                <!-- ── KPI band ────────────────────────────────────── -->
                <Border Grid.Row="2" Style="{StaticResource DbCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Style="{StaticResource DbSectionHeadStyle}">
                            <TextBlock Text="{DynamicResource Dashboard.ProductionPulse}"
                                       Style="{StaticResource DbSectionTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Dashboard.LiveJobCountsFloor}"
                                       Style="{StaticResource DbSectionSubStyle}"/>
                        </StackPanel>
                        <ItemsControl Style="{StaticResource DbKpiBandStyle}"
                                      ItemsSource="{Binding KpiCards}"
                                      ItemsPanel="{StaticResource DbKpiBandPanel}"
                                      ItemTemplate="{StaticResource DbKpiTileTemplate}"/>
                    </StackPanel>
                </Border>

                <!-- ── workload status + mix ───────────────────────── -->
                <Grid Grid.Row="3" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DbCardStyle}"
                            Margin="0,0,7,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Dashboard.WorkloadStatus}"
                                           Style="{StaticResource DbSectionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.JobsGroupedCurrentStatus}"
                                           Style="{StaticResource DbMetaStyle}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Border Style="{StaticResource DbChartWellStyle}"
                                        Visibility="{Binding HasStatusData,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                    <trend:TrendChartControl
                                        Points="{Binding StatusBars}"
                                        SeriesKind="Bar"
                                        SeriesBrush="{DynamicResource AccentBrush}"
                                        SeriesEndBrush="{DynamicResource AccentDarkBrush}"
                                        GridBrush="{DynamicResource DividerBrush}"
                                        LabelBrush="{DynamicResource TextTertiaryBrush}"
                                        EmptyMessage=""/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,32"
                                            Visibility="{Binding HasStatusData,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="&#xE9F9;"
                                               Style="{StaticResource DbEmptyGlyphStyle}"/>
                                    <TextBlock Text="{DynamicResource Dashboard.NoJobOrdersYet}"
                                               Style="{StaticResource DbEmptyTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DbCardStyle}"
                            Margin="7,0,0,0">
                        <StackPanel>
                            <StackPanel Style="{StaticResource DbSectionHeadStyle}">
                                <TextBlock Text="{DynamicResource Dashboard.StatusMix}"
                                           Style="{StaticResource DbSectionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.JobOrderCount}"
                                           Style="{StaticResource DbSectionSubStyle}"/>
                            </StackPanel>
                            <donut:DonutChartControl Height="158"
                                                     Slices="{Binding StatusMixSlices}"
                                                     HoleLabel="{DynamicResource Dashboard.Jobs}"
                                                     EmptyMessage="No jobs yet."
                                                     Thickness="16"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── priority mix + recent jobs ──────────────────── -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DbCardStyle}"
                            Margin="0,0,7,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Common.Priority}"
                                           Style="{StaticResource DbSectionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.HighMediumLow}"
                                           Style="{StaticResource DbMetaStyle}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Border Style="{StaticResource DbChartWellStyle}"
                                        Visibility="{Binding HasStatusData,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                    <trend:TrendChartControl
                                        Points="{Binding PriorityBars}"
                                        SeriesKind="Bar"
                                        SeriesBrush="{DynamicResource WarningBrush}"
                                        SeriesEndBrush="{DynamicResource AccentDarkBrush}"
                                        GridBrush="{DynamicResource DividerBrush}"
                                        LabelBrush="{DynamicResource TextTertiaryBrush}"
                                        EmptyMessage=""/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,32"
                                            Visibility="{Binding HasStatusData,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="&#xE730;"
                                               Style="{StaticResource DbEmptyGlyphStyle}"/>
                                    <TextBlock Text="{DynamicResource Dashboard.NoJobOrdersYet}"
                                               Style="{StaticResource DbEmptyTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DbCardStyle}"
                            Margin="7,0,0,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Dashboard.RecentJobOrders}"
                                           Style="{StaticResource DbSectionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Dashboard.LatestActivity}"
                                           Style="{StaticResource DbMetaStyle}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <ItemsControl Style="{StaticResource DbFeedItemsStyle}"
                                              ItemsSource="{Binding RecentFeed}"
                                              ItemTemplate="{StaticResource DbFeedRowTemplate}"
                                              Visibility="{Binding HasRecentFeed,
                                                  Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,32"
                                            Visibility="{Binding HasRecentFeed,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="&#xE823;"
                                               Style="{StaticResource DbEmptyGlyphStyle}"/>
                                    <TextBlock Text="{DynamicResource Dashboard.NoJobOrdersYet}"
                                               Style="{StaticResource DbEmptyTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
