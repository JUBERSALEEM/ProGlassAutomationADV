<!-- LAYOUT-03 BENTO MOSAIC — Job Orders. Bindings unchanged. -->
<UserControl x:Class="ProGlassAutomation.Views.Dashboard.JobOrder.JoDashboard.JoDashboardView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             xmlns:donut="clr-namespace:ProGlassAutomation.Controls.DonutChart"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="20,16,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- 2026-08-25: workload chart gets its own full-width
                         row; recent job orders moved below, full width. -->
                    <RowDefinition Height="280" MinHeight="220"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HERO STRIP -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Job Orders"
                                   Style="{StaticResource SoftHeroTitleStyle}"/>
                        <TextBlock Text="Production workload, priority mix and recent job activity"
                                   Style="{StaticResource SoftHeroSubtitleStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource SoftChipStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="Live" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LastRefreshed}"
                                   Style="{StaticResource SoftMetaStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource SoftSectionStyle}"
                            Padding="16,12"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Loading job order data…"
                                   Style="{StaticResource SoftKpiFootStyle}"/>
                    </Border>
                    <Border Style="{StaticResource SoftSectionStyle}"
                            Padding="16,12"
                            Background="{DynamicResource TintRedBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            Visibility="{Binding HasError,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}"/>
                    </Border>
                </StackPanel>

                <!-- ROW: pulse tiles | status mix | priority -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SoftCardStyle}"
                            Margin="0,0,14,0" MinHeight="168">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Production pulse"
                                           Style="{StaticResource SoftSectionTitleStyle}"/>
                                <TextBlock Text="Live job counts across the floor"
                                           Style="{StaticResource SoftSectionSubtitleStyle}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding KpiCards}"
                                          ItemTemplate="{StaticResource SoftKpiCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SoftCardStyle}"
                            Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="Status mix"
                                       Style="{StaticResource SoftSectionTitleStyle}"/>
                            <TextBlock Text="Jobs grouped by current status"
                                       Style="{StaticResource SoftSectionSubtitleStyle}"/>
                            <donut:DonutChartControl Height="150"
                                                     Slices="{Binding StatusMixSlices}"
                                                     HoleLabel="JOBS"
                                                     EmptyMessage="No job mix yet."
                                                     Thickness="16"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SoftCardStyle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Priority"
                                           Style="{StaticResource SoftSectionTitleStyle}"/>
                                <TextBlock Text="High / medium / low"
                                           Style="{StaticResource SoftSectionSubtitleStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource SoftChartWellStyle}">
                                <trend:TrendChartControl
                                    Points="{Binding PriorityBars}"
                                    SeriesKind="Bar"
                                    EmptyMessage="No priority data yet."
                                    SeriesBrush="{DynamicResource AccentBrush}"
                                    SeriesEndBrush="{DynamicResource AccentDarkBrush}"
                                    GridBrush="{DynamicResource DividerBrush}"
                                    LabelBrush="{DynamicResource MutedForegroundBrush}"/>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ROW: workload by status — full width -->
                <Border Grid.Row="3" Style="{StaticResource SoftCardStyle}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Workload by status"
                                       Style="{StaticResource SoftSectionTitleStyle}"/>
                            <TextBlock Text="Job order count"
                                       Style="{StaticResource SoftMetaStyle}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Border Style="{StaticResource SoftChartWellStyle}"
                                    Visibility="{Binding HasStatusData,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <trend:TrendChartControl
                                    Points="{Binding StatusBars}"
                                    SeriesKind="Bar"
                                    EmptyMessage="Job order count by status — no data yet."
                                    SeriesBrush="{DynamicResource AccentBrush}"
                                    SeriesEndBrush="{DynamicResource AccentDarkBrush}"
                                    GridBrush="{DynamicResource DividerBrush}"
                                    LabelBrush="{DynamicResource MutedForegroundBrush}"/>
                            </Border>
                            <Border Padding="0,40"
                                    Visibility="{Binding HasStatusData,
                                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE9F9;"
                                               Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                    <TextBlock Text="No job orders yet"
                                               Style="{StaticResource DashEmptyStateTextStyle}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- ROW: recent job orders — FULL WIDTH (2026-08-25: was
                     squeezed into a 1/3 column and read as left-aligned) -->
                <Border Grid.Row="4" Style="{StaticResource SoftCardStyle}" Margin="0,16,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Recent job orders"
                                   Style="{StaticResource SoftSectionTitleStyle}"
                                   Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="380"
                                      behaviors:SmartScrollBubblingBehavior.IsEnabled="True"
                                      Visibility="{Binding HasRecentFeed,
                                          Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding RecentFeed}"
                                          ItemTemplate="{StaticResource SoftFeedRowTemplate}"/>
                        </ScrollViewer>
                        <Border Padding="0,40"
                                Visibility="{Binding HasRecentFeed,
                                    Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE9F9;"
                                           Style="{StaticResource DashEmptyStateGlyphStyle}"/>
                                <TextBlock Text="No job orders yet"
                                           Style="{StaticResource DashEmptyStateTextStyle}"/>
                                <TextBlock Text="Convert an approved proforma into a job order."
                                           Style="{StaticResource SoftMetaStyle}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
