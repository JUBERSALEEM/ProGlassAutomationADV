<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Dashboard/JobOrder/JoDashboard/JoDashboardView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Job Order Dashboard (Chat 23 v2.5)
     VERSION: Chat 23 v2.5 — Industrial Blue + smooth ambient parity

     DESIGN LANGUAGE:
       Matches Overview + PiDashboard + Statement + SheetStore.
       Glass blue ambient (cached Canvas pattern from v2.5),
       shadow-free cards with gradient depth,
       industrial blue typography,
       semantic status/priority colors preserved (green/amber/red).

     CHANGES vs previous:
       ✓ Wrapped ScrollViewer in Grid + cached ambient Canvas
         (Ambient gradient painted INSIDE cached Canvas = one bitmap,
          near-zero per-frame cost — the v2.5 smoothness pattern)
       ✓ Grid.Background = solid #F5F9FF (cheap fallback)
       ✓ CardStyle: DynamicResource ModuleBackgroundBrush → CardBgGradient
         (subtle top-to-bottom gradient simulates depth without shadow)
       ✓ TintedCardStyle: DynamicResource BorderBrush → CardBorderBrush
         (industrial blue-tinted border, visible on tint bgs)
       ✓ SectionTitle color: #4338CA indigo → AccentTextDeep #1E3A8A
       ✓ PanningMode "None" → "VerticalOnly"
       ✓ Focusable "True" → "False"
       ✓ Page title 28→30px (design system standard)
       ✓ RenderOptions.EdgeMode="Aliased" on ambient blobs
       ✓ SnapsToDevicePixels on all inner card borders

     PRESERVED (zero regression):
       • ALL bindings (KpiCards, StatusBars, PriorityBars, RecentFeed,
         HasStatusData, HasRecentFeed, LastRefreshed, IsLoading, HasError)
       • BrushKeyConverter usage on badge/tint/status
       • ColorStringConverter on BarColor
       • ScaleConverter on NormalizedHeight
       • Feed row 4-column Grid layout (40 / * / Auto / 120)
       • Status pill design
       • All 3 empty state panels (status, priority, feed)
       • SmoothScrollBehavior
       • Error state hardcoded text (VM doesn't expose ErrorMessage)

     REGRESSION RISK: LOW
       Same visual optimization pattern as Overview v2.5 (proven smooth).
       VM brush key fixes are a bug fix (badges were rendering broken).
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Dashboard.JobOrder.JoDashboard.JoDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══════════════════════════════════════════════════════════════
             GLASS BLUE PALETTE (frozen inline — v2.5 pattern)
        ═══════════════════════════════════════════════════════════════ -->

        <LinearGradientBrush x:Key="AmbientBg"
                             StartPoint="0,0" EndPoint="1,1"
                             po:Freeze="True">
            <GradientStop Color="#E8F0FE" Offset="0.0"/>
            <GradientStop Color="#DBE7F9" Offset="0.5"/>
            <GradientStop Color="#C7D9F0" Offset="1.0"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="Blob1"
                             Center="0.85,0.10"
                             GradientOrigin="0.85,0.10"
                             RadiusX="0.4" RadiusY="0.4"
                             po:Freeze="True">
            <GradientStop Color="#3B82F640" Offset="0.0"/>
            <GradientStop Color="#3B82F600" Offset="1.0"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="Blob2"
                             Center="0.10,0.85"
                             GradientOrigin="0.10,0.85"
                             RadiusX="0.35" RadiusY="0.35"
                             po:Freeze="True">
            <GradientStop Color="#1E40AF30" Offset="0.0"/>
            <GradientStop Color="#1E40AF00" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- Card bg gradient (shadow substitute) -->
        <LinearGradientBrush x:Key="CardBgGradient"
                             StartPoint="0,0" EndPoint="0,1"
                             po:Freeze="True">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#F4F8FE" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardBorderBrush"
                         Color="#C4D6ED"
                         po:Freeze="True"/>

        <!-- Accent tones -->
        <SolidColorBrush x:Key="AccentTextDeep"
                         Color="#1E3A8A"
                         po:Freeze="True"/>

        <SolidColorBrush x:Key="AccentText"
                         Color="#1E40AF"
                         po:Freeze="True"/>

        <!-- ═══════════════════════════════════════════════════════════════
             CARD STYLES — no DropShadowEffect (v2.4 pattern)
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource CardBgGradient}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Padding"         Value="24"/>
            <Setter Property="Margin"          Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="TintedCardStyle" TargetType="Border">
            <Setter Property="Background"
                    Value="{Binding TintColor,
                            Converter={StaticResource BrushKeyConverter}}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="Padding"         Value="20"/>
            <Setter Property="Margin"          Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             TYPOGRAPHY
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentTextDeep}"/>
            <Setter Property="Margin"     Value="8,0,8,6"/>
        </Style>

        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin"     Value="8,0,8,10"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             KPI CARD TEMPLATE
        ═══════════════════════════════════════════════════════════════ -->

        <DataTemplate x:Key="KpiTemplate">
            <Border Style="{StaticResource TintedCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="10"
                                SnapsToDevicePixels="True"
                                Background="{Binding BadgeColor,
                                             Converter={StaticResource BrushKeyConverter}}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Icon}" FontSize="20"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DisplayValue}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,14,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SubLabel}"
                               FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════════
             BAR CHART TEMPLATE
        ═══════════════════════════════════════════════════════════════ -->

        <DataTemplate x:Key="BarTemplate">
            <Grid Margin="8,0" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" VerticalAlignment="Bottom" Height="180">
                    <TextBlock Text="{Binding ValueDisplay}"
                               FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,0,0,4"
                               Foreground="{StaticResource AccentTextDeep}"/>
                    <Border Width="70"
                            CornerRadius="6,6,0,0"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            SnapsToDevicePixels="True"
                            Background="{Binding BarColor,
                                         Converter={StaticResource ColorStringConverter}}"
                            Height="{Binding NormalizedHeight,
                                     Converter={StaticResource ScaleConverter},
                                     ConverterParameter=160}"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding Label}"
                           FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="90"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Grid>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════════
             FEED ROW TEMPLATE
        ═══════════════════════════════════════════════════════════════ -->

        <DataTemplate x:Key="FeedRowTemplate">
            <Border Margin="0,0,0,8"
                    CornerRadius="10"
                    Padding="16,12"
                    SnapsToDevicePixels="True"
                    Background="{Binding TintColor,
                                 Converter={StaticResource BrushKeyConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <!-- Priority icon -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding Icon}"
                               FontSize="20"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <!-- Job ID + subtitle -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="8,0,12,0">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubTitle}"
                                   FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- AED value -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding ValueDisplay}"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,0,12,0"/>

                    <!-- Status pill -->
                    <Border Grid.Column="3"
                            CornerRadius="12"
                            Padding="10,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True"
                            Background="{Binding StatusColor,
                                         Converter={StaticResource BrushKeyConverter}}">
                        <TextBlock Text="{Binding StatusLabel}"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT — v2.5 smooth pattern: solid Grid bg + cached ambient
    ═══════════════════════════════════════════════════════════════ -->
    <Grid Background="#F5F9FF">

        <!-- Cached ambient (gradient + blobs = ONE bitmap) -->
        <Canvas Panel.ZIndex="0"
                IsHitTestVisible="False"
                CacheMode="BitmapCache">
            <Rectangle Fill="{StaticResource AmbientBg}"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
            <Rectangle Fill="{StaticResource Blob1}"
                       RenderOptions.EdgeMode="Aliased"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
            <Rectangle Fill="{StaticResource Blob2}"
                       RenderOptions.EdgeMode="Aliased"
                       Width="{Binding ActualWidth,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"
                       Height="{Binding ActualHeight,
                           RelativeSource={RelativeSource
                               AncestorType=Canvas}}"/>
        </Canvas>

        <ScrollViewer Panel.ZIndex="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      IsDeferredScrollingEnabled="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="24,16,24,24">

                <!-- Page header -->
                <StackPanel Margin="8,0,8,20">
                    <TextBlock Text="Job Order Analytics"
                               FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource AccentTextDeep}"/>
                    <TextBlock Text="Monitor production status, priorities, and delivery timelines."
                               FontSize="13" Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <!-- Loading -->
                <Border Visibility="{Binding IsLoading,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="12" Margin="8,0,8,12">
                    <TextBlock Text="⏳  Loading job order data…"
                               FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentText}"/>
                </Border>

                <!-- Error (hardcoded text preserved — VM does not expose ErrorMessage) -->
                <Border Visibility="{Binding HasError,
                                     Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{DynamicResource TintRedBrush}"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="14" Margin="8,0,8,12">
                    <TextBlock Text="Failed to load job order data."
                               Foreground="#991B1B"
                               FontSize="12" TextWrapping="Wrap" FontWeight="Bold"/>
                </Border>

                <!-- ═══ KPI CARDS ═══ -->
                <TextBlock Text="Production Overview"
                           Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Summary of all job orders by status and priority"
                           Style="{StaticResource SectionSubtitle}"/>

                <ItemsControl ItemsSource="{Binding KpiCards}"
                              ItemTemplate="{StaticResource KpiTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- ═══ STATUS DISTRIBUTION ═══ -->
                <TextBlock Text="Status Distribution"
                           Style="{StaticResource SectionTitle}"
                           Margin="8,24,8,6"/>
                <TextBlock Text="How your job orders are distributed across production stages"
                           Style="{StaticResource SectionSubtitle}"/>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel Visibility="{Binding HasStatusData,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding StatusBars}"
                                          ItemTemplate="{StaticResource BarTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Border Height="1" Margin="0,4,0,0"
                                    Background="#DBE7F9"/>

                            <TextBlock Text="Job order count by status"
                                       FontSize="11" HorizontalAlignment="Right"
                                       Margin="0,10,4,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="0,50"
                                    Visibility="{Binding HasStatusData,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="🏭" FontSize="48"
                                       HorizontalAlignment="Center" Opacity="0.4"/>
                            <TextBlock Text="No job orders yet"
                                       FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{StaticResource AccentTextDeep}"/>
                            <TextBlock Text="Convert a Proforma Invoice to create your first job order."
                                       FontSize="12" HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ PRIORITY BREAKDOWN ═══ -->
                <TextBlock Text="Priority Breakdown"
                           Style="{StaticResource SectionTitle}"
                           Margin="8,24,8,6"/>
                <TextBlock Text="Distribution of job orders by production priority"
                           Style="{StaticResource SectionSubtitle}"/>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel Visibility="{Binding HasStatusData,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding PriorityBars}"
                                          ItemTemplate="{StaticResource BarTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Border Height="1" Margin="0,4,0,0"
                                    Background="#DBE7F9"/>

                            <TextBlock Text="Job order count by priority"
                                       FontSize="11" HorizontalAlignment="Right"
                                       Margin="0,10,4,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="0,50"
                                    Visibility="{Binding HasStatusData,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="📋" FontSize="48"
                                       HorizontalAlignment="Center" Opacity="0.4"/>
                            <TextBlock Text="No priority data yet"
                                       FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{StaticResource AccentTextDeep}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ RECENT JOB ORDERS FEED ═══ -->
                <TextBlock Text="Recent Job Orders"
                           Style="{StaticResource SectionTitle}"
                           Margin="8,24,8,6"/>
                <TextBlock Text="Last 10 job orders ordered by most recently updated"
                           Style="{StaticResource SectionSubtitle}"/>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel Visibility="{Binding HasRecentFeed,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding RecentFeed}"
                                          ItemTemplate="{StaticResource FeedRowTemplate}"/>

                            <Border Height="1" Margin="0,8,0,0"
                                    Background="#DBE7F9"/>

                            <TextBlock Text="Showing last 10 · ordered by last updated"
                                       FontSize="11" HorizontalAlignment="Right"
                                       Margin="0,10,4,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="0,50"
                                    Visibility="{Binding HasRecentFeed,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="📦" FontSize="48"
                                       HorizontalAlignment="Center" Opacity="0.4"/>
                            <TextBlock Text="No job orders yet"
                                       FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{StaticResource AccentTextDeep}"/>
                            <TextBlock Text="Convert a Proforma Invoice to get started."
                                       FontSize="12" HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Footer timestamp -->
                <TextBlock Text="{Binding LastRefreshed}"
                           FontSize="11" Opacity="0.6" Margin="12,16,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>