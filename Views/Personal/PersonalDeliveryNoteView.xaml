<UserControl x:Class="ProGlassAutomation.Views.Personal.PersonalDeliveryNoteView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:detail="clr-namespace:ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail"
             xmlns:detailVm="clr-namespace:ProGlassAutomation.ViewModels.DeliveryNote.DeliveryNoteDetail"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════
         GB-P9 — GLASS BLUSH DELIVERY NOTE (glass-06 reference)

         References the SAME DeliveryNoteViewModel (module VM):
         ListVM (DeliveryNoteListViewModel: AllItems flat rows,
         SelectRowCommand, SelectedRow/IsSelected per row, DisplayStatus,
         StatusLabel, StatusBrushKey, DeliveryTime, CustomerName,
         ProjectName, DeliveryNoteId) and DetailVM (DeliveryNoteDetailViewModel:
         DeliveryNoteId, DriverName, VehicleNumber, Status,
         DeliveryProgressPercent, VisibleItemRows).

         Layout = the reference: left glass list card + right glass detail
         card (driver / plate / progress / items table). The full editable
         Professional detail is hosted inside a glass inset below the
         reference header block (documented hybrid, GB-P6 pattern) so the
         delivery workflow stays fully available in Personal mode.
    ═══════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <!-- Host the Professional detail view inside the glass card -->
        <DataTemplate DataType="{x:Type detailVm:DeliveryNoteDetailViewModel}">
            <detail:DeliveryNoteDetailView/>
        </DataTemplate>

        <!-- List row: glass tile + selected glow -->
        <Style x:Key="GbDnRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassBlush.SurfaceFaint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBlush.BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GlassBlush.SurfaceStrong}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource GlassBlush.AccentGlow}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT — DELIVERIES LIST ════════════════════════════════ -->
        <ContentControl Grid.Column="0" Style="{StaticResource GlassBlush.GlassCard}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Deliveries"
                           FontSize="{DynamicResource GlassBlush.FontTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GlassBlush.Text}"
                           Margin="0,0,0,14"/>

                <!-- empty state -->
                <ContentControl Style="{StaticResource GlassBlush.EmptyState}"
                                Tag="&#xE7F4;"
                                Content="No deliveries"
                                Visibility="{Binding ListVM.AllItems,
                                          Converter={StaticResource CountToVisibilityConverter}}"/>

                <ListBox ItemsSource="{Binding ListVM.AllItems}"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         VirtualizingStackPanel.CacheLength="200,400"
                         VirtualizingStackPanel.CacheLengthUnit="Pixel"
                         Visibility="{Binding ListVM.AllItems,
                                   Converter={StaticResource CountToVisibilityConverter},
                                   ConverterParameter=Inverted}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GbDnRow}" Cursor="Hand"
                                    behaviors:ClickToCommandBehavior.Command="{Binding DataContext.SelectRowCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    behaviors:ClickToCommandBehavior.CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- truck chip -->
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="11"
                                            Background="{DynamicResource GlassBlush.SurfaceFaint}"
                                            BorderBrush="{DynamicResource GlassBlush.BorderSoft}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource GlassBlush.TextMuted}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- id + customer -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding DeliveryNoteId}"
                                                   FontSize="{DynamicResource GlassBlush.FontBody}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GlassBlush.Text}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Margin="0,2,0,0">
                                            <Run Text="{Binding CustomerName, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- time pill -->
                                    <ContentControl Grid.Column="2"
                                                    Style="{StaticResource GlassBlush.Pill}"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Content="{Binding DeliveryTime}"/>

                                    <!-- status pill (dot + label: readable
                                         over both theme tint families) -->
                                    <Border Grid.Column="3"
                                            Background="{DynamicResource GlassBlush.SurfaceFaint}"
                                            BorderBrush="{DynamicResource GlassBlush.BorderSoft}"
                                            BorderThickness="1"
                                            CornerRadius="999"
                                            Padding="12,6"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,7,0"
                                                     Fill="{Binding StatusBrushKey,
                                                           Converter={StaticResource BrushKeyConverter}}"/>
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       FontSize="{DynamicResource GlassBlush.FontMeta}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource GlassBlush.Text}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </ContentControl>

        <!-- ══ RIGHT — DELIVERY DETAIL (glass-06) ═══════════════════ -->
        <ContentControl Grid.Column="2" Style="{StaticResource GlassBlush.GlassCard}">
            <Grid>
                <!-- empty state (nothing selected) -->
                <ContentControl Style="{StaticResource GlassBlush.EmptyState}"
                                Tag="&#xE7F4;"
                                Content="Select a delivery">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl" BasedOn="{StaticResource GlassBlush.EmptyState}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DetailVM}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <!-- detail -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DetailVM}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel DataContext="{Binding DetailVM}">
                        <TextBlock FontSize="{DynamicResource GlassBlush.FontTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlassBlush.Text}"
                                   Margin="0,0,0,14">
                            <Run Text="Delivery "/><Run Text="{Binding DeliveryNoteId, Mode=OneWay}"/>
                        </TextBlock>

                        <!-- driver card -->
                        <ContentControl Style="{StaticResource GlassBlush.GlassCard}"
                                        Background="{DynamicResource GlassBlush.SurfaceFaint}"
                                        Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                        Background="{DynamicResource GlassBlush.AccentSoft}"
                                        BorderBrush="{DynamicResource GlassBlush.Border}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Margin="0,0,14,0">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="20"
                                               Foreground="{DynamicResource GlassBlush.AccentGlow}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Driver"
                                               FontSize="{DynamicResource GlassBlush.FontMeta}"
                                               Foreground="{DynamicResource GlassBlush.TextMuted}"/>
                                    <TextBlock Text="{Binding DriverName}"
                                               FontSize="{DynamicResource GlassBlush.FontHeading}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource GlassBlush.Text}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <!-- phone affordance (informational chip —
                                     the module VM exposes no call command) -->
                                <Border Grid.Column="2" Width="40" Height="40" CornerRadius="13"
                                        Background="{DynamicResource GlassBlush.SurfaceFaint}"
                                        BorderBrush="{DynamicResource GlassBlush.BorderSoft}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource GlassBlush.TextMuted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </ContentControl>

                        <!-- plate + progress row -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl Grid.Column="0"
                                            Style="{StaticResource GlassBlush.Pill}"
                                            VerticalAlignment="Center"
                                            Content="{Binding VehicleNumber}"/>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Delivery progress"
                                               FontSize="{DynamicResource GlassBlush.FontMeta}"
                                               Foreground="{DynamicResource GlassBlush.TextMuted}"/>
                                    <TextBlock HorizontalAlignment="Right"
                                               Text="{Binding DeliveryProgressPercent, StringFormat={}{0:0}%}"
                                               FontSize="{DynamicResource GlassBlush.FontMeta}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource GlassBlush.TextMuted}"/>
                                </Grid>
                                <ProgressBar Style="{StaticResource GlassBlush.Progress}"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding DeliveryProgressPercent}"
                                             IsEnabled="False"/>
                            </StackPanel>
                        </Grid>

                        <!-- items table (reference: Glass Type | Qty | Status) -->
                        <ContentControl Style="{StaticResource GlassBlush.GlassCard}"
                                        Background="{DynamicResource GlassBlush.SurfaceFaint}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Glass Type"
                                               Style="{StaticResource GlassBlush.SectionTitle}"
                                               FontSize="{DynamicResource GlassBlush.FontMeta}"/>
                                    <TextBlock Grid.Column="1" Text="Qty"
                                               Style="{StaticResource GlassBlush.SectionTitle}"
                                               FontSize="{DynamicResource GlassBlush.FontMeta}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="Status"
                                               Style="{StaticResource GlassBlush.SectionTitle}"
                                               FontSize="{DynamicResource GlassBlush.FontMeta}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding VisibleItemRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GlassRef}"
                                                               FontSize="{DynamicResource GlassBlush.FontBody}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource GlassBlush.Text}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DimensionDisplay}"
                                                               FontSize="{DynamicResource GlassBlush.FontMeta}"
                                                               Foreground="{DynamicResource GlassBlush.TextMuted}"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding OrderedQty}"
                                                           FontSize="{DynamicResource GlassBlush.FontBody}"
                                                           Foreground="{DynamicResource GlassBlush.Text}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource GlassBlush.Success}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE91A;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource GlassBlush.TextFaint}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFullyDeliveredLine}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE73E;"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource GlassBlush.Success}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ContentControl>

                        <!-- full Professional detail (hybrid — keeps the
                             delivery workflow complete in Personal mode) -->
                        <ContentControl Content="{Binding}"
                                        Margin="0,16,0,8"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>
