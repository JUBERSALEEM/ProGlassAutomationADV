<UserControl x:Class="ProGlassAutomation.Views.Personal.PersonalProductionControlCenterView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════
         GB-P7 — GLASS BLUSH PRODUCTION CONTROL (glass-04 reference)

         The NIGHT-palette control room. Local night styles (GbNight*)
         are view-scoped BasedOn overrides of the shared glass components
         using the measured GlassBlushNight.* token set — no shared token
         changes, Professional untouched. References the SAME
         ProductionControlCenterViewModel: every binding, command,
         column and filter preserved from
         Views/Production/ProductionControlCenterView.xaml (contract).
    ═══════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="GbBoolToVis"/>

        <!-- night card (measured tile #152B50 @25% + cyan-tinted border) -->
        <Style x:Key="GbNightCard" TargetType="ContentControl"
               BasedOn="{StaticResource GlassBlush.GlassCard}">
            <Setter Property="Background" Value="{DynamicResource GlassBlushNight.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBlushNight.Border}"/>
        </Style>

        <Style x:Key="GbNightButton" TargetType="Button"
               BasedOn="{StaticResource GlassBlush.GlassButton}">
            <Setter Property="Background" Value="{DynamicResource GlassBlushNight.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBlushNight.AccentGlow}"/>
        </Style>

        <Style x:Key="GbNightButtonSoft" TargetType="Button"
               BasedOn="{StaticResource GlassBlush.GlassButtonSoft}">
            <Setter Property="Background" Value="{DynamicResource GlassBlushNight.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBlushNight.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassBlushNight.Text}"/>
        </Style>

        <!-- night stage tab (RadioButton, glass pill) -->
        <Style x:Key="GbNightTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg"
                                Background="{DynamicResource GlassBlushNight.Surface}"
                                BorderBrush="{DynamicResource GlassBlushNight.Border}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="18,10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassBlushNight.SurfaceStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassBlushNight.SurfaceStrong}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GlassBlushNight.AccentGlow}"/>
                                <Setter TargetName="Bg" Property="Effect" Value="{StaticResource GlassBlush.GlowAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- night text field / combo (glass on night) -->
        <Style x:Key="GbNightTextBox" TargetType="TextBox"
               BasedOn="{StaticResource GlassBlush.TextBox}">
            <Setter Property="Background" Value="{DynamicResource GlassBlushNight.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBlushNight.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassBlushNight.Text}"/>
        </Style>

        <Style x:Key="GbNightComboBox" TargetType="ComboBox"
               BasedOn="{StaticResource GlassBlush.ComboBox}">
            <Setter Property="Background" Value="{DynamicResource GlassBlushNight.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBlushNight.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassBlushNight.Text}"/>
        </Style>

        <!-- night data grid (same virtualization, night text) -->
        <Style x:Key="GbNightDataGrid" TargetType="DataGrid"
               BasedOn="{StaticResource GlassBlush.DataGrid}">
            <Setter Property="Foreground" Value="{DynamicResource GlassBlushNight.Text}"/>
        </Style>

        <Style x:Key="GbNightGridRow" TargetType="DataGridRow"
               BasedOn="{StaticResource GlassBlush.GridRow}">
            <Setter Property="Foreground" Value="{DynamicResource GlassBlushNight.Text}"/>
        </Style>

        <Style x:Key="GbNightGridCell" TargetType="DataGridCell"
               BasedOn="{StaticResource GlassBlush.GridCell}">
            <Setter Property="Foreground" Value="{DynamicResource GlassBlushNight.Text}"/>
        </Style>

        <Style x:Key="GbNightGridHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource GlassBlush.GridHeader}">
            <Setter Property="Background" Value="{DynamicResource GlassBlushNight.SurfaceStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassBlushNight.TextMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBlushNight.Border}"/>
        </Style>

        <!-- night analytics tab pill -->
        <Style x:Key="GbNightTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource GlassBlushNight.TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="14,6"
                                Margin="0,0,8,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassBlushNight.Surface}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassBlushNight.SurfaceStrong}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GlassBlushNight.AccentGlow}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GlassBlushNight.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- NIGHT ATMOSPHERE (measured midnight gradient) -->
    <Grid>
        <Rectangle Fill="{DynamicResource GlassBlushNight.Background}" IsHitTestVisible="False"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="24,20,24,16">

                <!-- ══ HEADER ══════════════════════════════════════ -->
                <ContentControl Style="{StaticResource GbNightCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="{DynamicResource GlassBlush.FontTitle}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource GlassBlushNight.Text}"/>
                                <Border Background="{DynamicResource GlassBlushNight.SurfaceStrong}"
                                        BorderBrush="{DynamicResource GlassBlushNight.AccentGlow}"
                                        BorderThickness="1"
                                        CornerRadius="8" Padding="10,4"
                                        Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="HIGH-CAPACITY PRODUCTION PIPELINE"
                                               FontSize="{DynamicResource GlassBlush.FontMeta}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource GlassBlushNight.AccentGlow}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="{DynamicResource GlassBlush.FontCaption}"
                                       Foreground="{DynamicResource GlassBlushNight.TextMuted}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Load / Refresh" Command="{Binding LoadCommand}"
                                    Style="{StaticResource GbNightButton}"
                                    Height="40" Padding="20,0" Margin="0,0,10,0"/>
                            <Button Content="Cancel" Command="{Binding CancelCommand}"
                                    Style="{StaticResource GbNightButtonSoft}"
                                    Height="40" Padding="18,0"/>
                        </StackPanel>
                    </Grid>
                </ContentControl>

                <!-- ══ STAGE RIBBON (Cutting | Tempering | DGU) ══════ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" GroupName="ProductionStagesPersonal"
                                 Margin="0,0,8,0"
                                 IsChecked="{Binding IsCuttingTab, Mode=OneWay}"
                                 Command="{Binding SelectCuttingTabCommand}"
                                 Style="{StaticResource GbNightTab}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource GlassBlushNight.AccentGlow}"/>
                            <TextBlock Text="1. CUTTING &amp; NESTING" FontWeight="Bold"
                                       Foreground="{DynamicResource GlassBlushNight.Text}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Column="1" GroupName="ProductionStagesPersonal"
                                 Margin="4,0"
                                 IsChecked="{Binding IsTemperingTab, Mode=OneWay}"
                                 Command="{Binding SelectTemperingTabCommand}"
                                 Style="{StaticResource GbNightTab}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9CA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource GlassBlushNight.AccentGlow}"/>
                            <TextBlock Text="2. TEMPERING &amp; FURNACE" FontWeight="Bold"
                                       Foreground="{DynamicResource GlassBlushNight.Text}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Column="2" GroupName="ProductionStagesPersonal"
                                 Margin="8,0,0,0"
                                 IsChecked="{Binding IsDguTab, Mode=OneWay}"
                                 Command="{Binding SelectDguTabCommand}"
                                 Style="{StaticResource GbNightTab}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource GlassBlushNight.AccentGlow}"/>
                            <TextBlock Text="3. DGU &amp; ASSEMBLY" FontWeight="Bold"
                                       Foreground="{DynamicResource GlassBlushNight.Text}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </Grid>

                <!-- ══ GLOWING READOUTS (measured 3 big readouts) ═════ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <ContentControl Grid.Column="0" Style="{StaticResource GbNightCard}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL SCHEDULED"
                                       FontSize="{DynamicResource GlassBlush.FontLabel}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource GlassBlushNight.TextMuted}"/>
                            <TextBlock Text="{Binding TotalScheduledPcs, StringFormat={}{0:N0} Pcs}"
                                       FontSize="{DynamicResource GlassBlush.FontKpiSmall}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource GlassBlushNight.AccentGlow}"
                                       Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding TotalScheduledSqm, StringFormat={}{0:N1} m²}"
                                       FontSize="{DynamicResource GlassBlush.FontCaption}"
                                       Foreground="{DynamicResource GlassBlushNight.TextMuted}"/>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Grid.Column="1" Style="{StaticResource GbNightCard}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="COMPLETED / DONE"
                                       FontSize="{DynamicResource GlassBlush.FontLabel}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource GlassBlushNight.TextMuted}"/>
                            <TextBlock Text="{Binding CompletedDonePcs, StringFormat={}{0:N0} Pcs}"
                                       FontSize="{DynamicResource GlassBlush.FontKpiSmall}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource GlassBlush.Success}"
                                       Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding CompletedDoneSqm, StringFormat={}{0:N1} m²}"
                                       FontSize="{DynamicResource GlassBlush.FontCaption}"
                                       Foreground="{DynamicResource GlassBlushNight.TextMuted}"/>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Grid.Column="2" Style="{StaticResource GbNightCard}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="BALANCE PENDING"
                                       FontSize="{DynamicResource GlassBlush.FontLabel}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource GlassBlushNight.TextMuted}"/>
                            <TextBlock Text="{Binding BalancePendingPcs, StringFormat={}{0:N0} Pcs}"
                                       FontSize="{DynamicResource GlassBlush.FontKpiSmall}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource GlassBlush.Warning}"
                                       Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding BalancePendingSqm, StringFormat={}{0:N1} m²}"
                                       FontSize="{DynamicResource GlassBlush.FontCaption}"
                                       Foreground="{DynamicResource GlassBlushNight.TextMuted}"/>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Grid.Column="3" Style="{StaticResource GbNightCard}">
                        <StackPanel>
                            <TextBlock Text="STAGE COMPLETION"
                                       FontSize="{DynamicResource GlassBlush.FontLabel}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource GlassBlushNight.TextMuted}"/>
                            <TextBlock Text="{Binding StageCompletionPct, StringFormat={}{0:F1}%}"
                                       FontSize="{DynamicResource GlassBlush.FontKpi}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource GlassBlush.Success}"
                                       Margin="0,8,0,10"/>
                            <ProgressBar Style="{StaticResource GlassBlush.Progress}"
                                         Height="8" Minimum="0" Maximum="100"
                                         Value="{Binding StageCompletionPct, Mode=OneWay}"/>
                        </StackPanel>
                    </ContentControl>
                </Grid>

                <!-- ══ FILTER + COMMAND TOOLBAR ═══════════════════════ -->
                <ContentControl Style="{StaticResource GbNightCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="SEARCH (Job / PO / Customer)"
                                           FontSize="{DynamicResource GlassBlush.FontLabel}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource GlassBlushNight.TextMuted}"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GbNightTextBox}"
                                         Height="40"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="READINESS STATUS"
                                           FontSize="{DynamicResource GlassBlush.FontLabel}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource GlassBlushNight.TextMuted}"
                                           Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding ReadinessOptions}"
                                          SelectedItem="{Binding ReadinessFilter}"
                                          Style="{StaticResource GbNightComboBox}"
                                          Height="40"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="PRIORITY"
                                           FontSize="{DynamicResource GlassBlush.FontLabel}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource GlassBlushNight.TextMuted}"
                                           Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding PriorityOptions}"
                                          SelectedItem="{Binding PriorityFilter}"
                                          Style="{StaticResource GbNightComboBox}"
                                          Height="40"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="DUE RISK"
                                           FontSize="{DynamicResource GlassBlush.FontLabel}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource GlassBlushNight.TextMuted}"
                                           Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding DueRiskOptions}"
                                          SelectedItem="{Binding DueRiskFilter}"
                                          Style="{StaticResource GbNightComboBox}"
                                          Height="40"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Start Stage" Command="{Binding StartCommand}"
                                        Style="{StaticResource GbNightButton}"
                                        Height="38" Padding="18,0" Margin="0,0,8,0"/>
                                <Button Content="Complete Stage" Command="{Binding CompleteCommand}"
                                        Style="{StaticResource GbNightButton}"
                                        Height="38" Padding="18,0" Margin="0,0,8,0"/>
                                <Button Content="Pause" Command="{Binding PauseCommand}"
                                        Style="{StaticResource GbNightButtonSoft}"
                                        Height="38" Padding="14,0" Margin="0,0,8,0"/>
                                <Button Content="Resume" Command="{Binding ResumeCommand}"
                                        Style="{StaticResource GbNightButtonSoft}"
                                        Height="38" Padding="14,0" Margin="0,0,8,0"/>
                                <Button Content="Hold" Command="{Binding HoldCommand}"
                                        Style="{StaticResource GbNightButtonSoft}"
                                        Height="38" Padding="14,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Release Hold" Command="{Binding ReleaseHoldCommand}"
                                        Style="{StaticResource GbNightButtonSoft}"
                                        Height="38" Padding="12,0" Margin="0,0,8,0"/>
                                <Button Content="Assign Workstation" Command="{Binding AssignCommand}"
                                        Style="{StaticResource GbNightButtonSoft}"
                                        Height="38" Padding="14,0" Margin="0,0,8,0"/>
                                <Button Content="Set Priority" Command="{Binding SetPriorityCommand}"
                                        Style="{StaticResource GbNightButtonSoft}"
                                        Height="38" Padding="12,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ContentControl>

                <!-- ══ PRODUCTION QUEUE (master table, virtualized) ═══ -->
                <ContentControl Style="{StaticResource GbNightCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="340"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Production Queue"
                                   Style="{StaticResource GlassBlush.SectionTitle}"
                                   Foreground="{DynamicResource GlassBlushNight.Text}"
                                   Margin="0,0,0,12"/>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Queue}"
                                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                                  Style="{StaticResource GbNightDataGrid}"
                                  ColumnHeaderStyle="{StaticResource GbNightGridHeader}"
                                  CellStyle="{StaticResource GbNightGridCell}"
                                  RowStyle="{StaticResource GbNightGridRow}"
                                  VerticalScrollBarVisibility="Auto"
                                  behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Job Ref" Binding="{Binding JobRef}" Width="*"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="Spec" Binding="{Binding SpecName}" Width="*"/>
                                <DataGridTextColumn Header="Process" Binding="{Binding StageLabel}" Width="*"/>
                                <DataGridTextColumn Header="Readiness" Binding="{Binding Readiness}" Width="*"/>
                                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="*"/>
                                <DataGridTextColumn Header="Due Risk" Binding="{Binding DueRisk}" Width="*"/>
                                <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}" Width="*"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="*"/>
                                <DataGridTextColumn Header="Done" Binding="{Binding QtyDone}" Width="*"/>
                                <DataGridTextColumn Header="Rem" Binding="{Binding Remaining}" Width="*"/>
                                <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="*"/>
                                <DataGridTextColumn Header="QC" Binding="{Binding QcResult}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </ContentControl>

                <!-- ══ READY / BLOCKED / QC MINI QUEUES ═══════════════ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0" Style="{StaticResource GbNightCard}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="150"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Ready to run"
                                       FontSize="{DynamicResource GlassBlush.FontBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlassBlushNight.Text}"
                                       Margin="0,0,0,10"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ExecutableQueue}"
                                      Style="{StaticResource GbNightDataGrid}"
                                      ColumnHeaderStyle="{StaticResource GbNightGridHeader}"
                                      CellStyle="{StaticResource GbNightGridCell}"
                                      RowStyle="{StaticResource GbNightGridRow}"
                                      behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Job" Binding="{Binding JobRef}" Width="*"/>
                                    <DataGridTextColumn Header="Process" Binding="{Binding StageLabel}" Width="*"/>
                                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="*"/>
                                    <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=MM-dd}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </ContentControl>
                    <ContentControl Grid.Column="1" Style="{StaticResource GbNightCard}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="150"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Blocked"
                                       FontSize="{DynamicResource GlassBlush.FontBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlassBlushNight.Text}"
                                       Margin="0,0,0,10"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding BlockedQueue}"
                                      Style="{StaticResource GbNightDataGrid}"
                                      ColumnHeaderStyle="{StaticResource GbNightGridHeader}"
                                      CellStyle="{StaticResource GbNightGridCell}"
                                      RowStyle="{StaticResource GbNightGridRow}"
                                      behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Job" Binding="{Binding JobRef}" Width="*"/>
                                    <DataGridTextColumn Header="Reason" Binding="{Binding BlockReason}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </ContentControl>
                    <ContentControl Grid.Column="2" Style="{StaticResource GbNightCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="150"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="QC pending / failed"
                                       FontSize="{DynamicResource GlassBlush.FontBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlassBlushNight.Text}"
                                       Margin="0,0,0,10"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding QcQueue}"
                                      Style="{StaticResource GbNightDataGrid}"
                                      ColumnHeaderStyle="{StaticResource GbNightGridHeader}"
                                      CellStyle="{StaticResource GbNightGridCell}"
                                      RowStyle="{StaticResource GbNightGridRow}"
                                      behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Job" Binding="{Binding JobRef}" Width="*"/>
                                    <DataGridTextColumn Header="Stage" Binding="{Binding StageLabel}" Width="*"/>
                                    <DataGridTextColumn Header="QC" Binding="{Binding QcResult}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </ContentControl>
                </Grid>

                <!-- ══ SELECTED ITEM DETAIL ═══════════════════════════ -->
                <ContentControl Style="{StaticResource GbNightCard}" Margin="0,0,0,16">
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,24,10">
                            <TextBlock Text="Selected work item"
                                       FontSize="{DynamicResource GlassBlush.FontBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlassBlushNight.Text}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding DetailLabel}" TextWrapping="Wrap"
                                       FontSize="{DynamicResource GlassBlush.FontCaption}"
                                       Foreground="{DynamicResource GlassBlushNight.TextMuted}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Traceability"
                                       FontSize="{DynamicResource GlassBlush.FontBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlassBlushNight.Text}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TraceabilityLabel}" TextWrapping="Wrap"
                                       FontSize="{DynamicResource GlassBlush.FontCaption}"
                                       Foreground="{DynamicResource GlassBlushNight.AccentGlow}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Material"
                                       FontSize="{DynamicResource GlassBlush.FontBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlassBlushNight.Text}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding MaterialLabel}" TextWrapping="Wrap"
                                       FontSize="{DynamicResource GlassBlush.FontCaption}"
                                       Foreground="{DynamicResource GlassBlush.Warning}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="QC"
                                       FontSize="{DynamicResource GlassBlush.FontBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlassBlushNight.Text}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding QcLabel}" TextWrapping="Wrap"
                                       FontSize="{DynamicResource GlassBlush.FontCaption}"
                                       Foreground="{DynamicResource GlassBlushNight.TextMuted}"/>
                        </StackPanel>
                    </UniformGrid>
                </ContentControl>

                <!-- ══ ANALYTICS (6 glass tabs) ═══════════════════════ -->
                <ContentControl Style="{StaticResource GbNightCard}">
                    <TabControl Background="Transparent" BorderThickness="0" Padding="0"
                                ItemContainerStyle="{StaticResource GbNightTabItem}">
                        <TabItem Header="Job progress">
                            <DataGrid ItemsSource="{Binding JobProgress}"
                                      Style="{StaticResource GbNightDataGrid}"
                                      ColumnHeaderStyle="{StaticResource GbNightGridHeader}"
                                      CellStyle="{StaticResource GbNightGridCell}"
                                      RowStyle="{StaticResource GbNightGridRow}"
                                      Height="220" Margin="0,12,0,0"
                                      behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Job Ref" Binding="{Binding JobRef}" Width="*"/>
                                    <DataGridTextColumn Header="Req" Binding="{Binding Required}" Width="*"/>
                                    <DataGridTextColumn Header="Done" Binding="{Binding Completed}" Width="*"/>
                                    <DataGridTextColumn Header="Rem" Binding="{Binding Remaining}" Width="*"/>
                                    <DataGridTextColumn Header="Prog %" Binding="{Binding ProgressPct}" Width="*"/>
                                    <DataGridTextColumn Header="Blocked" Binding="{Binding Blocked}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Process progress">
                            <DataGrid ItemsSource="{Binding ProcessProgress}"
                                      Style="{StaticResource GbNightDataGrid}"
                                      ColumnHeaderStyle="{StaticResource GbNightGridHeader}"
                                      CellStyle="{StaticResource GbNightGridCell}"
                                      RowStyle="{StaticResource GbNightGridRow}"
                                      Height="220" Margin="0,12,0,0"
                                      behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding SpecName}" Width="*"/>
                                    <DataGridTextColumn Header="Req" Binding="{Binding Required}" Width="*"/>
                                    <DataGridTextColumn Header="Done" Binding="{Binding Completed}" Width="*"/>
                                    <DataGridTextColumn Header="Prog %" Binding="{Binding ProgressPct}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Queue pressure">
                            <DataGrid ItemsSource="{Binding QueuePressure}"
                                      Style="{StaticResource GbNightDataGrid}"
                                      ColumnHeaderStyle="{StaticResource GbNightGridHeader}"
                                      CellStyle="{StaticResource GbNightGridCell}"
                                      RowStyle="{StaticResource GbNightGridRow}"
                                      Height="220" Margin="0,12,0,0"
                                      behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="*"/>
                                    <DataGridTextColumn Header="Ready" Binding="{Binding ReadyQueue}" Width="*"/>
                                    <DataGridTextColumn Header="Blocked" Binding="{Binding BlockedQueue}" Width="*"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/>
                                    <DataGridTextColumn Header="Pressure" Binding="{Binding PressureLabel}" Width="*"/>
                                    <DataGridTextColumn Header="Avg wait h" Binding="{Binding AvgWaitHours}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Workstation load">
                            <DataGrid ItemsSource="{Binding WorkstationLoad}"
                                      Style="{StaticResource GbNightDataGrid}"
                                      ColumnHeaderStyle="{StaticResource GbNightGridHeader}"
                                      CellStyle="{StaticResource GbNightGridCell}"
                                      RowStyle="{StaticResource GbNightGridRow}"
                                      Height="220" Margin="0,12,0,0"
                                      behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="*"/>
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="*"/>
                                    <DataGridTextColumn Header="Assigned" Binding="{Binding AssignedCount}" Width="*"/>
                                    <DataGridTextColumn Header="Ready" Binding="{Binding ReadyCount}" Width="*"/>
                                    <DataGridTextColumn Header="In prog" Binding="{Binding InProgressCount}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Workstations">
                            <DataGrid ItemsSource="{Binding Workstations}"
                                      Style="{StaticResource GbNightDataGrid}"
                                      ColumnHeaderStyle="{StaticResource GbNightGridHeader}"
                                      CellStyle="{StaticResource GbNightGridCell}"
                                      RowStyle="{StaticResource GbNightGridRow}"
                                      Height="220" Margin="0,12,0,0"
                                      behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Id" Binding="{Binding WorkstationId}" Width="*"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="*"/>
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Rework">
                            <DataGrid ItemsSource="{Binding ReworkQueue}"
                                      Style="{StaticResource GbNightDataGrid}"
                                      ColumnHeaderStyle="{StaticResource GbNightGridHeader}"
                                      CellStyle="{StaticResource GbNightGridCell}"
                                      RowStyle="{StaticResource GbNightGridRow}"
                                      Height="220" Margin="0,12,0,0"
                                      behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Job" Binding="{Binding JobRef}" Width="*"/>
                                    <DataGridTextColumn Header="Piece" Binding="{Binding Position}" Width="*"/>
                                    <DataGridTextColumn Header="Stage" Binding="{Binding StageLabel}" Width="*"/>
                                    <DataGridTextColumn Header="Block" Binding="{Binding BlockReason}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </ContentControl>

                <!-- ══ PROGRESS ═══════════════════════════════════════ -->
                <ContentControl Style="{StaticResource GbNightCard}" Margin="0,0,0,12"
                                Visibility="{Binding HasProgress, Converter={StaticResource GbBoolToVis}}">
                    <TextBlock Text="{Binding ProgressLabel}" TextWrapping="Wrap"
                               FontSize="{DynamicResource GlassBlush.FontCaption}"
                               Foreground="{DynamicResource GlassBlushNight.TextMuted}"/>
                </ContentControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
