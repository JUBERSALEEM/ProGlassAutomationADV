<UserControl x:Class="ProGlassAutomation.Views.Personal.PersonalDashboardOverviewView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:trend="clr-namespace:ProGlassAutomation.Controls.TrendChart"
             xmlns:donut="clr-namespace:ProGlassAutomation.Controls.DonutChart"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════
         GB-P4 (2026-09-18, split out 2026-09-19 for GB-P10) —
         GLASS BLUSH DASHBOARD OVERVIEW PAGE (glass-01 reference).

         Personal page for the Dashboard module's Overview tab. Rendered by
         PersonalDashboardView (the Personal dashboard shell) whose content
         host hands it an OverviewDashboardViewModel (DataContext inherited
         from the host — no re-pointing needed).
         Every binding, command, chart property and i18n key preserved from
         Views/Dashboard/Overview/OverviewDashboardView.xaml (contract).
         Four-state contract (loading / error / empty / data) preserved.
    ═══════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <!-- skeleton block (loading state, glass) -->
        <Style x:Key="GbSkeletonBlock" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassBlush.SurfaceFaint}"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- skeleton card shell (Border — mirrors GlassCard glass skin) -->
        <Style x:Key="GbSkeletonCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassBlush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBlush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource GlassBlush.CardRadius}"/>
            <Setter Property="Effect" Value="{StaticResource GlassBlush.CardShadowFx}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- pipeline stage (WorkflowStageModel → glass inset card) -->
        <DataTemplate x:Key="GbPipelineStageTemplate">
            <!-- 2026-09-19 overlap fix: the name row was a horizontal
                 StackPanel — a StackPanel measures its children at infinite
                 width, so the Name trim could never engage and a long stage
                 name spilled out of the glass card onto the next stage's
                 icon chip. Now a Grid (Auto | *) constrains the name. The
                 host panel is a UniformGrid (5 finite cells), which makes
                 every TextTrimming in this template real. -->
            <ContentControl Style="{StaticResource GlassBlush.InsetCard}"
                            Margin="0,0,14,0"
                            HorizontalContentAlignment="Stretch">
                <ContentControl.Template>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource GlassBlush.SmallRadius}"
                                Padding="16,12"
                                SnapsToDevicePixels="True">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="10"
                                            Background="{DynamicResource GlassBlush.Surface}"
                                            BorderBrush="{DynamicResource GlassBlush.BorderSoft}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Glyph}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource GlassBlush.TextMuted}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="{DynamicResource GlassBlush.FontCaption}"
                                               Foreground="{DynamicResource GlassBlush.TextMuted}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <!-- GB-B7: trim the 22px value so a wide
                                     currency number can never spill over
                                     the neighbouring glass card. -->
                                <Viewbox MaxHeight="28" HorizontalAlignment="Left" Margin="0,10,0,2">
                                    <TextBlock Text="{Binding ValueDisplay}"
                                               FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource GlassBlush.Text}"
                                               Typography.NumeralAlignment="Tabular"
                                               TextTrimming="CharacterEllipsis"/>
                                </Viewbox>
                                <TextBlock Text="{Binding Foot}"
                                           FontSize="{DynamicResource GlassBlush.FontMeta}"
                                           Foreground="{DynamicResource GlassBlush.TextFaint}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </ContentControl.Template>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  Focusable="False"
                  FocusVisualStyle="{x:Null}"
                  Background="Transparent">
        <StackPanel Margin="0,0,0,8">

            <!-- ══ ACTION ROW (live status + module actions) ═════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="14" Height="14" Margin="0,0,8,0">
                        <Ellipse Fill="{DynamicResource GlassBlush.Success}" Opacity="0.4">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="GbLivePulseScale"
                                                ScaleX="1" ScaleY="1"
                                                CenterX="7" CenterY="7"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="GbLivePulseScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="1" To="2.1" Duration="0:0:2"/>
                                            <DoubleAnimation Storyboard.TargetName="GbLivePulseScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="1" To="2.1" Duration="0:0:2"/>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.5" To="0" Duration="0:0:2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource GlassBlush.Success}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource Common.Live}"
                               FontSize="{DynamicResource GlassBlush.FontCaption}"
                               Foreground="{DynamicResource GlassBlush.TextMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding LastRefreshed}"
                               FontSize="{DynamicResource GlassBlush.FontMeta}"
                               Foreground="{DynamicResource GlassBlush.TextFaint}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Dashboard.NewInvoice}"
                            Style="{StaticResource GlassBlush.GlassButton}"
                            Command="{Binding NewInvoiceCommand}"
                            ToolTip="{DynamicResource Dashboard.CreateNewTaxInvoice}"
                            Margin="0,0,12,0"/>
                    <Button Content="{DynamicResource Dashboard.Jobs}"
                            Style="{StaticResource GlassBlush.GlassButtonSoft}"
                            Command="{Binding ViewJobsCommand}"
                            ToolTip="{DynamicResource Dashboard.ViewJobOrders}"
                            Margin="0,0,12,0"/>
                    <Button Content="{DynamicResource Dashboard.Deliveries}"
                            Style="{StaticResource GlassBlush.GlassButtonSoft}"
                            Command="{Binding ViewDeliveriesCommand}"
                            ToolTip="{DynamicResource Dashboard.ViewDeliveryNotes}"/>
                </StackPanel>
            </Grid>

            <!-- ══ LOADING SKELETON ══════════════════════════════════ -->
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource GbSkeletonCard}" Margin="0,0,24,0" Height="110">
                        <StackPanel Margin="20,20">
                            <Border Style="{StaticResource GbSkeletonBlock}" Width="40" Height="40"/>
                            <Border Style="{StaticResource GbSkeletonBlock}" Height="10" Width="90" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource GbSkeletonBlock}" Height="24" Width="130" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource GbSkeletonCard}" Margin="0,0,24,0" Height="110">
                        <StackPanel Margin="20,20">
                            <Border Style="{StaticResource GbSkeletonBlock}" Width="40" Height="40"/>
                            <Border Style="{StaticResource GbSkeletonBlock}" Height="10" Width="90" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource GbSkeletonBlock}" Height="24" Width="130" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource GbSkeletonCard}" Margin="0,0,24,0" Height="110">
                        <StackPanel Margin="20,20">
                            <Border Style="{StaticResource GbSkeletonBlock}" Width="40" Height="40"/>
                            <Border Style="{StaticResource GbSkeletonBlock}" Height="10" Width="90" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource GbSkeletonBlock}" Height="24" Width="130" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource GbSkeletonCard}" Height="110">
                        <StackPanel Margin="20,20">
                            <Border Style="{StaticResource GbSkeletonBlock}" Width="40" Height="40"/>
                            <Border Style="{StaticResource GbSkeletonBlock}" Height="10" Width="90" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource GbSkeletonBlock}" Height="24" Width="130" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource GbSkeletonCard}" Margin="0,0,24,0" Height="320">
                        <StackPanel Margin="20,20">
                            <Border Style="{StaticResource GbSkeletonBlock}" Height="14" Width="140" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource GbSkeletonBlock}" Height="200" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource GbSkeletonCard}" Height="320">
                        <StackPanel Margin="20,20">
                            <Border Style="{StaticResource GbSkeletonBlock}" Height="14" Width="110" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource GbSkeletonBlock}" Height="150" Margin="0,16,0,0"
                                    CornerRadius="75"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource GbSkeletonCard}" Height="120">
                    <Border Style="{StaticResource GbSkeletonBlock}" Height="60" Margin="20,20"/>
                </Border>
            </StackPanel>

            <!-- ══ ERROR STATE ═══════════════════════════════════════ -->
            <Border Style="{StaticResource GbSkeletonCard}"
                    Background="{DynamicResource GlassBlush.DangerSoft}"
                    BorderBrush="{DynamicResource GlassBlush.Danger}"
                    Margin="0,0,0,24"
                    Padding="20,16"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="{DynamicResource GlassBlush.FontBody}"
                           Foreground="{DynamicResource GlassBlush.Text}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- ══ DATA (visible when not loading) ═══════════════════ -->
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                <!-- KPI ROW — 4 floating glass cards (measured 270×110) -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0"
                                    Content="{Binding SalesTiles[0]}"
                                    ContentTemplate="{StaticResource GlassBlush.KpiTileTemplate}"
                                    Margin="0,0,24,0"/>
                    <ContentControl Grid.Column="1"
                                    Content="{Binding ProductionTiles[0]}"
                                    ContentTemplate="{StaticResource GlassBlush.KpiTileTemplate}"
                                    Margin="0,0,24,0"/>
                    <ContentControl Grid.Column="2"
                                    Content="{Binding DeliveryTiles[1]}"
                                    ContentTemplate="{StaticResource GlassBlush.KpiTileTemplate}"
                                    Margin="0,0,24,0"/>
                    <ContentControl Grid.Column="3"
                                    Content="{Binding InventoryTiles[0]}"
                                    ContentTemplate="{StaticResource GlassBlush.KpiTileTemplate}"/>
                </Grid>

                <!-- CHART ROW — revenue trend + delivery mix donut -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <ContentControl Grid.Column="0"
                                    Style="{StaticResource GlassBlush.ChartCard}"
                                    Margin="0,0,24,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Dashboard.RevenueTrend}"
                                           Style="{StaticResource GlassBlush.SectionTitle}"/>
                                <TextBlock Text="{Binding ChartTitle}"
                                           FontSize="{DynamicResource GlassBlush.FontMeta}"
                                           Foreground="{DynamicResource GlassBlush.TextFaint}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <trend:TrendChartControl
                                Points="{Binding MonthlySalesBars}"
                                SeriesKind="Bar"
                                ValuePrefix="AED "
                                EmptyMessage="No revenue recorded yet."
                                SeriesBrush="{DynamicResource GlassBlush.Accent}"
                                SeriesEndBrush="{DynamicResource GlassBlush.AccentGlow}"
                                GridBrush="{DynamicResource GlassBlush.BorderSoft}"
                                LabelBrush="{DynamicResource GlassBlush.TextMuted}"/>
                        </DockPanel>
                    </ContentControl>

                    <ContentControl Grid.Column="1"
                                    Style="{StaticResource GlassBlush.ChartCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dashboard.DeliveryMix}"
                                       Style="{StaticResource GlassBlush.SectionTitle}"/>
                            <TextBlock Text="{DynamicResource Dashboard.NotesRemainingPcs}"
                                       Style="{StaticResource GlassBlush.SectionSubtitle}"/>
                            <donut:DonutChartControl Height="170"
                                                     Margin="0,12,0,0"
                                                     Slices="{Binding DeliveryMixSlices}"
                                                     HoleLabel="MIX"
                                                     EmptyMessage="No delivery movement yet."
                                                     Thickness="16"/>
                        </StackPanel>
                    </ContentControl>
                </Grid>

                <!-- PIPELINE — glowing stage cards (order-to-cash) -->
                <ContentControl Style="{StaticResource GlassBlush.GlassCard}"
                                Margin="0,0,0,24">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource Dashboard.PipelineVolumeConfirmation}"
                                   Style="{StaticResource GlassBlush.SectionTitle}"
                                   Margin="0,0,0,14"/>
                        <ItemsControl ItemsSource="{Binding WorkflowStages}"
                                      ItemTemplate="{StaticResource GbPipelineStageTemplate}">
                            <!-- 2026-09-19 overlap fix (same class as the
                                 Professional overview): finite 5-cell row so
                                 the trims inside GbPipelineStageTemplate work. -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DockPanel>
                </ContentControl>

                <!-- RECENT DOCUMENTS — rounded glass table -->
                <ContentControl Style="{StaticResource GlassBlush.GlassCard}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource Dashboard.RecentDocuments}"
                                   Style="{StaticResource GlassBlush.SectionTitle}"
                                   Margin="0,0,0,14"/>
                        <DataGrid ItemsSource="{Binding RecentActivity}"
                                  Style="{StaticResource GlassBlush.DataGrid}"
                                  MaxHeight="420"
                                  Visibility="{Binding HasRecentActivity,
                                              Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Dashboard.View}"
                                                    Binding="{Binding Title}" Width="*"
                                                    IsReadOnly="True"/>
                                <DataGridTextColumn Header="{DynamicResource Dashboard.Type}"
                                                    Binding="{Binding SubTitle}" Width="220"
                                                    IsReadOnly="True"/>
                                <DataGridTextColumn Header="{DynamicResource Common.Amount}"
                                                    Binding="{Binding ValueDisplay}" Width="140"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="{DynamicResource Dashboard.Status}"
                                                        Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Style="{StaticResource GlassBlush.Pill}"
                                                            HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7"
                                                             Fill="{Binding StatusColor,
                                                                   Converter={StaticResource BrushKeyConverter}}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,7,0"/>
                                                    <TextBlock Text="{Binding StatusLabel}"
                                                               FontSize="{DynamicResource GlassBlush.FontCaption}"
                                                               Foreground="{DynamicResource GlassBlush.Text}"/>
                                                </StackPanel>
                                            </ContentControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource Nav.GroupMain}"
                                                    Binding="{Binding ModuleTag}" Width="140"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource GlassBlush.TextMuted}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ContentControl Style="{StaticResource GlassBlush.EmptyState}"
                                        Tag="&#xE8F1;"
                                        Content="{DynamicResource Common.Empty}"
                                        Margin="0,20,0,20"
                                        Visibility="{Binding HasRecentActivity,
                                                  Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </DockPanel>
                </ContentControl>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
