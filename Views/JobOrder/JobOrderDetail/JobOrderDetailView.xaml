<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/JobOrder/JobOrderDetail/JobOrderDetailView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Job Order — DETAIL (tab layout Aug 2026)

     LAYOUT
       The user wants a separate button tab switch (Overview / Production)
       — NOT a single merged page. The detail view is now:
         • Header action bar carries ALL document actions (BACK, CREATE DN,
           MASTER DN, PDF, EXCEL, CSV, SAVE) + invoice value.
         • A tab strip (OVERVIEW / PRODUCTION buttons) switches the content.
         • Overview tab = source-invoice identity + GLASS PANELS grid.
         • Production tab = the editable auto-compact production form.

       Tabs use the two-button pattern (active button shows filled, inactive
       shows outlined) via IsOverviewTab / IsProductionTab bindings. The
       Demo Hub calls SwitchDetailTabCommand("Production") and still works.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.JobOrder.JobOrderDetail.JobOrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="clr-namespace:ProGlassAutomation.Views.JobOrder.JobOrderDetail.Sections"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Sections/JoSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource DensityPageMargin}"
          Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ HEADER ACTION BAR (all document actions) ══════════ -->
        <Border Grid.Row="0"
                Style="{StaticResource ModuleDetailActionBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back — always first -->
                <Button Grid.Column="0"
                        Content="BACK"
                        Tag="&#xE72B;"
                        Style="{StaticResource OutlinedPillButton}"
                        Command="{Binding BackToListCommand}"
                        Margin="0,0,12,0"
                        ToolTip="Return to the saved job orders list"/>

                <!-- Title / source / converted -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding JobOrderId}"
                               Style="{StaticResource ModuleDetailTitleStyle}"/>
                    <TextBlock VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Style="{StaticResource ModulePageSubtitleStyle}">
                        <Run Text="From "/><Run Text="{Binding SourceProformaId, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding ConvertedDisplay}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>

                <!-- All document actions + invoice value -->
                <WrapPanel Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    <Button Style="{StaticResource SuccessPillButton}"
                            Tag="&#xE7F4;" Content="CREATE DN"
                            ToolTip="Create a new Delivery Note for this Job Order"
                            Command="{Binding CreateDeliveryNoteCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="MASTER DN"
                            Tag="&#xE718;"
                            Style="{StaticResource OutlinedPillButton}"
                            Command="{Binding OpenMasterDnCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Open the Master DN created from this Job Order"/>
                    <Button Style="{StaticResource SuccessPillButton}"
                            Tag="&#xE8A5;" Content="PDF"
                            ToolTip="Export PDF"
                            Command="{Binding ExportPdfCommand}"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SuccessPillButton}"
                            Tag="&#xE9F9;" Content="EXCEL"
                            ToolTip="Export Excel"
                            Command="{Binding ExportExcelCommand}"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SuccessPillButton}"
                            Tag="&#xE72D;" Content="CSV"
                            ToolTip="Export CSV"
                            Command="{Binding ExportCsvCommand}"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE74E;" Content="SAVE"
                            ToolTip="Save the job order"
                            Command="{Binding SaveCommand}"
                            Margin="0,0,12,0"/>
                    <TextBlock Text="INVOICE VALUE"
                               Style="{StaticResource ModuleListKpiLabelStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding GrandTotalDisplay}"
                               Style="{StaticResource ModuleListKpiValueStyle}"
                               VerticalAlignment="Center"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ══════════ LOADING + ERROR ══════════ -->
        <StackPanel Grid.Row="1">
            <loading:LoadingStateControl
                    Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Message="Loading job order…"
                    Margin="0,0,0,8"/>

            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource ModuleErrorBannerStyle}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- ══════════ TAB STRIP (separate button tab switch) ══════════ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,10">
            <Button Content="OVERVIEW" Tag="&#xE8A5;"
                    Margin="0,0,8,0"
                    ToolTip="Source invoice snapshot"
                    Command="{Binding SwitchDetailTabCommand}" CommandParameter="Overview">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverviewTab}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="PRODUCTION" Tag="&#xE713;"
                    ToolTip="Editable production panel"
                    Command="{Binding SwitchDetailTabCommand}" CommandParameter="Production">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProductionTab}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- ══════════ TAB CONTENT ══════════ -->
        <Grid Grid.Row="3">
            <sections:JoOverviewSection
                Visibility="{Binding IsOverviewTab,
                    Converter={StaticResource BoolToVisibilityConverter}}"/>
            <sections:JoProductionSection
                Visibility="{Binding IsProductionTab,
                    Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
