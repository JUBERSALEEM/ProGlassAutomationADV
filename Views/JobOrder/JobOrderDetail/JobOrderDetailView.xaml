<UserControl x:Class="ProGlassAutomation.Views.JobOrder.JobOrderDetail.JobOrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:ProGlassAutomation.Controls.GradientHeroCard"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Padding"     Value="10,8"/>
            <Setter Property="Margin"      Value="0,0,0,14"/>
            <Setter Property="Background"  Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"  Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="MultiLineInputStyle" TargetType="TextBox"
               BasedOn="{StaticResource FieldInputStyle}">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
            <Setter Property="MinHeight"     Value="70"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="ReadOnlyFieldStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,1,0,0"/>
        </Style>

        <Style x:Key="ReadOnlyLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        </Style>

        <Style x:Key="SpecHeaderCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="Padding"    Value="6,5"/>
        </Style>

        <Style x:Key="SpecDataCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="9"/>
            <Setter Property="Foreground"        Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Padding"           Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{DynamicResource MenuHoverBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Phase 10.5: Create Delivery Note button — indigo accent -->
        <Style x:Key="CreateDnButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="10"
                                Padding="18,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4338CA" Offset="0"/>
                                    <GradientStop Color="#6366F1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                  Opacity="0.25" Color="#4338CA"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚚"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Create Delivery Note"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,30">

            <!-- ── LOADING / ERROR ────────────────────────────────── -->
            <Border Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="12" Margin="8,0,8,12">
                <TextBlock Text="⏳  Loading job order…" FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource TintRedBrush}"
                    CornerRadius="12" Padding="16" Margin="8,0,8,12">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="13" TextWrapping="Wrap"/>
            </Border>

            <!-- ── HERO HEADER ────────────────────────────────────── -->
            <hero:GradientHeroCard Icon="📋"
                                   Value="{Binding JobOrderId}"
                                   Label="{Binding GrandTotalDisplay}"
                                   TrendArrow="📄"
                                   TrendText="{Binding SourceProformaId}"
                                   TrendVisibility="Visible"
                                   GradientStartColor="#6D28D9"
                                   GradientEndColor="#8B5CF6"
                                   Margin="8,0,8,24"
                                   MinHeight="160"/>

            <!-- ── TWO-COLUMN LAYOUT ──────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ════════════════════════════════════════════════════
                     LEFT COLUMN — Read-only PI snapshot
                ════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="0">

                    <TextBlock Text="SOURCE INVOICE SNAPSHOT"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="8,0,0,4"/>
                    <TextBlock Text="{Binding ConvertedDisplay}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="8,0,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource ModuleBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="14"
                                Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="COMPANY" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding InvoiceSnapshot.Company.CompanyName, FallbackValue=—}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="TRN: " Style="{StaticResource ReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding InvoiceSnapshot.Company.CompanyTrn, FallbackValue=—}"
                                               Style="{StaticResource ReadOnlyFieldStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding InvoiceSnapshot.Company.CompanyLocation, FallbackValue=—}"
                                           Style="{StaticResource ReadOnlyFieldStyle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{DynamicResource ModuleBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="14"
                                Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="CLIENT" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding InvoiceSnapshot.Client.CustomerName, FallbackValue=—}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="TRN: " Style="{StaticResource ReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding InvoiceSnapshot.Client.CustomerTrn, FallbackValue=—}"
                                               Style="{StaticResource ReadOnlyFieldStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding InvoiceSnapshot.Client.BillingAddress, FallbackValue=—}"
                                           Style="{StaticResource ReadOnlyFieldStyle}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{DynamicResource ModuleBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14"
                            Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="PROJECT" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Project Name" Style="{StaticResource ReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding InvoiceSnapshot.Project.ProjectIdentifierName, FallbackValue=—}"
                                               Style="{StaticResource ReadOnlyFieldStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Contract No" Style="{StaticResource ReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding InvoiceSnapshot.Project.ProjectContractNo, FallbackValue=—}"
                                               Style="{StaticResource ReadOnlyFieldStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="GLASS SPECIFICATIONS"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,10,0,12"/>

                    <ItemsControl ItemsSource="{Binding InvoiceSnapshot.SpecGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">

                                    <Border Background="{DynamicResource AccentBrush}"
                                            Padding="10,7"
                                            CornerRadius="8,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="SPEC "
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                            <TextBlock Text="{Binding GroupNumber}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                            <TextBlock Text=": "
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                            <TextBlock Text="{Binding SelectedSpecName, FallbackValue=—}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource MenuHoverBrush}"
                                            Padding="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="1.8*"/>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="0.8*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="#"
                                                       Style="{StaticResource SpecHeaderCellStyle}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="GLASS REF"
                                                       Style="{StaticResource SpecHeaderCellStyle}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            <TextBlock Grid.Column="2" Text="W1"
                                                       Style="{StaticResource SpecHeaderCellStyle}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="H1"
                                                       Style="{StaticResource SpecHeaderCellStyle}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="W2"
                                                       Style="{StaticResource SpecHeaderCellStyle}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="5" Text="H2"
                                                       Style="{StaticResource SpecHeaderCellStyle}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="6" Text="QTY"
                                                       Style="{StaticResource SpecHeaderCellStyle}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="7" Text="RATE"
                                                       Style="{StaticResource SpecHeaderCellStyle}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding ItemRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="0,0,0,1"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        Padding="0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="1.8*"/>
                                                            <ColumnDefinition Width="45"/>
                                                            <ColumnDefinition Width="45"/>
                                                            <ColumnDefinition Width="45"/>
                                                            <ColumnDefinition Width="45"/>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding SerialNumber}"
                                                                   Style="{StaticResource SpecDataCellStyle}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding GlassRef}"
                                                                   Style="{StaticResource SpecDataCellStyle}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding W1}"
                                                                   Style="{StaticResource SpecDataCellStyle}"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding H1}"
                                                                   Style="{StaticResource SpecDataCellStyle}"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding W2}"
                                                                   Style="{StaticResource SpecDataCellStyle}"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="5"
                                                                   Text="{Binding H2}"
                                                                   Style="{StaticResource SpecDataCellStyle}"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="6"
                                                                   Text="{Binding Qty}"
                                                                   Style="{StaticResource SpecDataCellStyle}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="7"
                                                                   Text="{Binding Rate, StringFormat={}{0:N2}}"
                                                                   Style="{StaticResource SpecDataCellStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   FontWeight="SemiBold"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Background="{DynamicResource TintGrayBrush}"
                                            Padding="10,7"
                                            CornerRadius="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Glass Type: "
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            <TextBlock Text="{Binding SelectedGlassType, FallbackValue=SGU}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="  ·  Base Rate: AED "
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Margin="14,0,0,0"/>
                                            <TextBlock Text="{Binding BaseRate, StringFormat={}{0:N2}}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <TextBlock Text="  ·  Surcharge: "
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Margin="14,0,0,0"/>
                                            <TextBlock Text="{Binding SurchargePercent, StringFormat={}{0:0.##}%}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{DynamicResource TintGreenBrush}"
                            CornerRadius="14" Padding="18,16"
                            Margin="0,14,0,12">
                        <StackPanel>
                            <TextBlock Text="INVOICE VALUE" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding GrandTotalDisplay}"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="VAT inclusive · immutable from source PI"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ════════════════════════════════════════════════════
                     RIGHT COLUMN — Editable production panel
                ════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="2">

                    <TextBlock Text="PRODUCTION DETAILS"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding SelectedStatus}"
                                      FontSize="13" Padding="8,6"
                                      VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Priority" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding PriorityOptions}"
                                      SelectedItem="{Binding SelectedPriority}"
                                      FontSize="13" Padding="8,6"
                                      VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Delivery Date" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding DeliveryDate}"
                                FontSize="13" Padding="6,4"
                                Margin="0,0,0,14"/>

                    <TextBlock Text="── Site Delivery ──" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Contact Name" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding SiteDeliveryContact, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInputStyle}"/>

                    <TextBlock Text="Contact Phone" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding SiteDeliveryPhone, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInputStyle}"/>

                    <TextBlock Text="Delivery Address" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding SiteDeliveryAddress, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MultiLineInputStyle}"/>

                    <TextBlock Text="── Assignment ──" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,6,0,10"/>

                    <TextBlock Text="Assigned To" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding AssignedTo, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInputStyle}"/>

                    <TextBlock Text="── Factory Floor ──" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,6,0,10"/>

                    <TextBlock Text="Cutting Instructions" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding CuttingInstructions, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MultiLineInputStyle}"/>

                    <TextBlock Text="Drawing Reference" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding DrawingReference, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInputStyle}"/>

                    <TextBlock Text="Internal Notes" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding InternalNotes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MultiLineInputStyle}"/>

                    <TextBlock Text="{Binding LastEditedDisplay}"
                               FontSize="10" FontStyle="Italic"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,10,0,16"/>

                    <!-- ══════════════════════════════════════════════════
                         PHASE 10.5: Create DN button — full width, prominent
                    ══════════════════════════════════════════════════ -->
                    <Button Command="{Binding CreateDeliveryNoteCommand}"
                            Style="{StaticResource CreateDnButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,16"
                            ToolTip="Create a new Delivery Note for this Job Order"/>

                    <!-- ════════════════════════════════════════════════
                         ACTION BUTTONS ROW
                         [Back]  [PDF] [Excel] [CSV]  [Save]
                    ════════════════════════════════════════════════ -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding BackToListCommand}"
                                Cursor="Hand" BorderThickness="0" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg"
                                            Background="{DynamicResource MenuHoverBrush}"
                                            CornerRadius="10" Padding="14,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="←" FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,7,0"/>
                                            <TextBlock Text="Back"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource ExportButtonStyle}"
                                Command="{Binding ExportPdfCommand}"
                                Content="PDF" Tag="📄"
                                ToolTip="Export production sheet as PDF"/>
                        <Button Grid.Column="3"
                                Style="{StaticResource ExportButtonStyle}"
                                Command="{Binding ExportExcelCommand}"
                                Content="Excel" Tag="📊"
                                ToolTip="Export as Excel workbook (multi-sheet)"/>
                        <Button Grid.Column="4"
                                Style="{StaticResource ExportButtonStyle}"
                                Command="{Binding ExportCsvCommand}"
                                Content="CSV" Tag="📋"
                                ToolTip="Export cut list as CSV"/>

                        <Button Grid.Column="6"
                                Command="{Binding SaveCommand}"
                                Cursor="Hand" BorderThickness="0" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="10" Padding="20,10">
                                        <TextBlock Text="💾  Save"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background"
                                                    Value="{DynamicResource AccentHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>