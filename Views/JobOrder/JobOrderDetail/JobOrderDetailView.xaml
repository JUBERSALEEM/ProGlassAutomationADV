<UserControl x:Class="ProGlassAutomation.Views.JobOrder.JobOrderDetail.JobOrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:sections="clr-namespace:ProGlassAutomation.Views.JobOrder.JobOrderDetail.Sections"
             xmlns:hero="clr-namespace:ProGlassAutomation.Controls.GradientHeroCard"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Sections/JoSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>








        <!-- Section title style (page-level section) -->

        <!-- Card label style (small label inside a card) -->

        <!-- Sub-section separator (── Site Delivery ── etc.) -->


        <!-- Phase 10.5: Create Delivery Note button — indigo accent -->
    
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  IsDeferredScrollingEnabled="False"
                  PanningMode="None"
                  Focusable="True"
                  FocusVisualStyle="{x:Null}"
                  Background="Transparent"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="24,16,24,24">

            <!-- ── BACK TO LIST ────────────────────────────────────── -->
            <Button Content="Back to List"
                    Tag="&#xE72B;"
                    Margin="8,0,8,12"
                    HorizontalAlignment="Left"
                    Style="{StaticResource RowOutlinedButton}"
                    Command="{Binding BackToListCommand}"
                    ToolTip="Return to the saved job orders list"/>

            <!-- ── LOADING / ERROR ────────────────────────────────── -->
            <Border Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="12" Margin="8,0,8,12">
                <TextBlock Text="⏳  Loading job order…" FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="8,0,8,12">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- ── HERO HEADER — Indigo brand gradient ─────────────── -->
            <hero:GradientHeroCard Icon="&#xE8C8;"
                                   Value="{Binding JobOrderId}"
                                   Label="{Binding GrandTotalDisplay}"
                                   TrendArrow="&#xE8A5;"
                                   TrendText="{Binding SourceProformaId}"
                                   TrendVisibility="Visible"
                                   GradientStartColor="{DynamicResource AccentColor}"
                                   GradientEndColor="{DynamicResource AccentHoverColor}"
                                   Margin="8,0,8,24"
                                   MinHeight="160"/>

            <!-- ── TWO-COLUMN LAYOUT ──────────────────────────────── -->
            <!-- ══ DETAIL TABS — Overview / Production ═══════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="OVERVIEW" Tag="&#xE8A5;" Margin="0,0,8,0"
                        ToolTip="Source invoice snapshot"
                        Command="{Binding SwitchDetailTabCommand}" CommandParameter="Overview">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverviewTab}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="PRODUCTION" Tag="&#xE713;"
                        ToolTip="Editable production panel"
                        Command="{Binding SwitchDetailTabCommand}" CommandParameter="Production">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProductionTab}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <Grid>
                <sections:JoOverviewSection
                    Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <sections:JoProductionSection
                    Visibility="{Binding IsProductionTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>