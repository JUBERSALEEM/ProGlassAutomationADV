<UserControl x:Class="ProGlassAutomation.Views.JobOrder.JobOrderDetail.JobOrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:sections="clr-namespace:ProGlassAutomation.Views.JobOrder.JobOrderDetail.Sections"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Sections/JoSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>








        <!-- Section title style (page-level section) -->

        <!-- Card label style (small label inside a card) -->

        <!-- Sub-section separator (── Site Delivery ── etc.) -->


        <!-- Phase 10.5: Create Delivery Note button — indigo accent -->
    
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  IsDeferredScrollingEnabled="False"
                  PanningMode="None"
                  Focusable="True"
                  FocusVisualStyle="{x:Null}"
                  Background="Transparent"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="{DynamicResource DensityPageMargin}">

            <!-- ── BACK TO LIST ────────────────────────────────────── -->
            <Button Content="Back to List"
                    Tag="&#xE72B;"
                    Margin="8,0,8,12"
                    HorizontalAlignment="Left"
                    Style="{StaticResource RowOutlinedButton}"
                    Command="{Binding BackToListCommand}"
                    ToolTip="Return to the saved job orders list"/>

            <!-- ── LOADING / ERROR ────────────────────────────────── -->
            <loading:LoadingStateControl
                    Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Message="Loading job order…"
                    Margin="8,0,8,12"/>

            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource ModuleErrorBannerStyle}"
                    Margin="8,0,8,12">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <Border Style="{StaticResource ModuleListShellStyle}"
                    Margin="8,0,8,16" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding JobOrderId}"
                                   Style="{StaticResource ModulePageTitleStyle}"/>
                        <TextBlock Style="{StaticResource ModulePageSubtitleStyle}">
                            <Run Text="From "/><Run Text="{Binding SourceProformaId, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Source invoice"
                                   Style="{StaticResource ModuleListKpiLabelStyle}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding GrandTotalDisplay}"
                                   Style="{StaticResource ModuleListKpiValueStyle}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── TWO-COLUMN LAYOUT ──────────────────────────────── -->
            <!-- ══ DETAIL TABS — Overview / Production ═══════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="OVERVIEW" Tag="&#xE8A5;" Margin="0,0,8,0"
                        ToolTip="Source invoice snapshot"
                        Command="{Binding SwitchDetailTabCommand}" CommandParameter="Overview">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverviewTab}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="PRODUCTION" Tag="&#xE713;"
                        ToolTip="Editable production panel"
                        Command="{Binding SwitchDetailTabCommand}" CommandParameter="Production">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProductionTab}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <Grid>
                <sections:JoOverviewSection
                    Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <sections:JoProductionSection
                    Visibility="{Binding IsProductionTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>