<!-- Job Order detail — document workspace shell.
     Bindings, commands, JoOverviewSection, MergedDictionaries unchanged.
     Tab strip stays unrendered (IsOverviewTab / SwitchDetailTabCommand remain on the VM). -->
<UserControl Style="{StaticResource ErpPageRootStyle}"
             x:Class="ProGlassAutomation.Views.JobOrder.JobOrderDetail.JobOrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="clr-namespace:ProGlassAutomation.Views.JobOrder.JobOrderDetail.Sections"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             Background="{DynamicResource Ov.Canvas}"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Sections/JoSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource ModuleDetailActionBarStyle}"
                Margin="16,16,16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="{DynamicResource Action.Back}"
                        Tag="&#xE72B;"
                        Style="{StaticResource OutlinedPillButton}"
                        Command="{Binding BackToListCommand}"
                        Margin="0,0,12,0"
                        ToolTip="{DynamicResource JobOrder.ReturnSavedJobOrdersList}"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding JobOrderId}"
                               Style="{StaticResource ModuleDetailTitleStyle}"/>
                    <TextBlock VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Style="{StaticResource ModulePageSubtitleStyle}">
                        <Run Text="{DynamicResource Common.From}"/><Run Text="{Binding SourceProformaId, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding ConvertedDisplay}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="{DynamicResource FontSize.Body}"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>

                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource SuccessPillButton}"
                                Tag="&#xE7F4;"
                                Content="{DynamicResource JobOrder.CreateDN}"
                                ToolTip="{DynamicResource JobOrder.OpenDispatchingDNRemainingBalanceDispatched}"
                                Command="{Binding CreateDeliveryNoteCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource JobOrder.MasterDN}"
                                Tag="&#xE718;"
                                Style="{StaticResource OutlinedPillButton}"
                                Command="{Binding OpenMasterDnCommand}"
                                Margin="0,0,8,0"
                                ToolTip="{DynamicResource JobOrder.OpenMasterDNCreatedJobOrder}"/>
                        <Button Style="{StaticResource SuccessPillButton}"
                                Tag="&#xE8A5;"
                                Content="PDF"
                                ToolTip="{DynamicResource DeliveryNote.ExportPDF}"
                                Command="{Binding ExportPdfCommand}"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SuccessPillButton}"
                                Tag="&#xE9F9;"
                                Content="{DynamicResource JobOrder.Excel}"
                                ToolTip="{DynamicResource DeliveryNote.ExportExcel}"
                                Command="{Binding ExportExcelCommand}"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SuccessPillButton}"
                                Tag="&#xE72D;"
                                Content="CSV"
                                ToolTip="{DynamicResource DeliveryNote.ExportCSV}"
                                Command="{Binding ExportCsvCommand}"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource OutlinedPillButton}"
                                Tag="&#xE72D;"
                                Content="{DynamicResource Sharing.Share}"
                                ToolTip="{DynamicResource Sharing.Share}"
                                Command="{Binding ShareCommand}"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryPillButton}"
                                Tag="&#xE74E;"
                                Content="{DynamicResource Action.Save}"
                                ToolTip="{DynamicResource JobOrder.SaveJobOrder}"
                                Command="{Binding SaveCommand}"
                                Margin="0,0,12,0"/>
                        <TextBlock Text="{DynamicResource JobOrder.InvoiceValue}"
                                   Style="{StaticResource ModuleListKpiLabelStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding GrandTotalDisplay}"
                                   Style="{StaticResource ModuleListKpiValueStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="16,0,16,8">
            <loading:LoadingStateControl
                    Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Message="Loading job order…"/>
            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource ModuleErrorBannerStyle}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="{DynamicResource FontSize.Body}"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="16,0,16,16">
            <sections:JoOverviewSection/>
        </Grid>
    </Grid>
</UserControl>
