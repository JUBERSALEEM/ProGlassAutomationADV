<UserControl x:Class="ProGlassAutomation.Views.JobOrder.JobOrderDetail.Sections.JoOverviewSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="JoSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Grid.Column="0">

                        <TextBlock Text="SOURCE INVOICE SNAPSHOT"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="8,0,0,4"/>
                        <TextBlock Text="{Binding ConvertedDisplay}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="8,0,0,16"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{DynamicResource ModuleBackgroundBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource CardCornerRadius}"
                                    Padding="16,14"
                                    SnapsToDevicePixels="True">
                                <StackPanel>
                                    <TextBlock Text="COMPANY"
                                               Style="{StaticResource CardLabelStyle}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding InvoiceSnapshot.Company.CompanyName, FallbackValue=—}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="TRN: " Style="{StaticResource ReadOnlyLabelStyle}"/>
                                        <TextBlock Text="{Binding InvoiceSnapshot.Company.CompanyTrn, FallbackValue=—}"
                                                   Style="{StaticResource ReadOnlyFieldStyle}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding InvoiceSnapshot.Company.CompanyLocation, FallbackValue=—}"
                                               Style="{StaticResource ReadOnlyFieldStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="{DynamicResource ModuleBackgroundBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource CardCornerRadius}"
                                    Padding="16,14"
                                    SnapsToDevicePixels="True">
                                <StackPanel>
                                    <TextBlock Text="CLIENT"
                                               Style="{StaticResource CardLabelStyle}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding InvoiceSnapshot.Client.CustomerName, FallbackValue=—}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="TRN: " Style="{StaticResource ReadOnlyLabelStyle}"/>
                                        <TextBlock Text="{Binding InvoiceSnapshot.Client.CustomerTrn, FallbackValue=—}"
                                                   Style="{StaticResource ReadOnlyFieldStyle}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding InvoiceSnapshot.Client.BillingAddress, FallbackValue=—}"
                                               Style="{StaticResource ReadOnlyFieldStyle}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource CardCornerRadius}"
            Padding="16,14" Margin="0,0,0,14"
            SnapsToDevicePixels="True">
                            <StackPanel>
                                <TextBlock Text="PROJECT"
                       Style="{StaticResource CardLabelStyle}"
                       Margin="0,0,0,8"/>

                                <!-- Row 1: Project Identifier Name | Project Name / No -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Project Identifier Name"
                               Style="{StaticResource ReadOnlyLabelStyle}"/>
                                        <TextBlock Text="{Binding InvoiceSnapshot.Project.ProjectIdentifierName,
                                    FallbackValue=—}"
                               Style="{StaticResource ReadOnlyFieldStyle}"
                               TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Project Name / No"
                               Style="{StaticResource ReadOnlyLabelStyle}"/>
                                        <TextBlock Text="{Binding InvoiceSnapshot.Project.ProjectContractNo,
                                    FallbackValue=—}"
                               Style="{StaticResource ReadOnlyFieldStyle}"
                               TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Project Reference (full width) -->
                                <StackPanel>
                                    <TextBlock Text="Project Reference"
                           Style="{StaticResource ReadOnlyLabelStyle}"/>
                                    <TextBlock Text="{Binding InvoiceSnapshot.Project.ProjectReference,
                                FallbackValue=—}"
                           Style="{StaticResource ReadOnlyFieldStyle}"
                           TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="GLASS SPECIFICATIONS"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Margin="0,10,0,12"/>

                        <ItemsControl ItemsSource="{Binding InvoiceSnapshot.SpecGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">

                                        <Border Background="{DynamicResource MenuHoverBrush}"
                                                Padding="12,8"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="22" Height="22"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding GroupNumber}"
                                                               FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding SelectedSpecName, FallbackValue=—}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource LineItemsHeaderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="48"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="1" Text="GLASS REF"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"
                                                           HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="2" Text="W1"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="3" Text="H1"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="4" Text="W2"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="5" Text="H2"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="6" Text="QTY"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding ItemRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="{DynamicResource CardCornerRadius}" BorderThickness="0,0,0,1"
                                                            BorderBrush="{DynamicResource OutlineBrush}"
                                                            Padding="0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30"/>
                                                                <ColumnDefinition Width="1.8*"/>
                                                                <ColumnDefinition Width="56"/>
                                                                <ColumnDefinition Width="56"/>
                                                                <ColumnDefinition Width="56"/>
                                                                <ColumnDefinition Width="56"/>
                                                                <ColumnDefinition Width="48"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding SerialNumber}"
                                                                       Style="{StaticResource LineItemsSerialStyle}"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding GlassRef}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"
                                                                       HorizontalAlignment="Left"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding W1}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding H1}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                            <TextBlock Grid.Column="4"
                                                                       Text="{Binding W2}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                            <TextBlock Grid.Column="5"
                                                                       Text="{Binding H2}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                            <TextBlock Grid.Column="6"
                                                                       Text="{Binding Qty}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Style="{StaticResource LineItemsFooterStyle}">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                <Run Text="Glass type  " FontWeight="SemiBold"/>
                                                <Run Text="{Binding SelectedGlassType, FallbackValue=SGU, Mode=OneWay}"
                                                     FontWeight="Bold"
                                                     Foreground="{DynamicResource AccentBrush}"/>
                                            </TextBlock>
                                        </Border>

                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource TintGreenBrush}"
                                CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,16"
                                Margin="0,14,0,12"
                                SnapsToDevicePixels="True">
                            <StackPanel>
                                <TextBlock Text="INVOICE VALUE"
                                           Style="{StaticResource CardLabelStyle}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding GrandTotalDisplay}"
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock Text="VAT inclusive · immutable from source PI"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
</UserControl>
