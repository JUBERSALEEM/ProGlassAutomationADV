<UserControl x:Class="ProGlassAutomation.Views.JobOrder.JobOrderDetail.Sections.JoOverviewSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="JoSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
        </Grid.RowDefinitions>

        <!-- Compact identity strip — one row, not three stacked cards -->
        <Border Grid.Row="0"
                Style="{StaticResource ModuleListKpiStripStyle}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="COMPANY" Style="{StaticResource CardLabelStyle}"/>
                    <TextBlock Text="{Binding InvoiceSnapshot.Company.CompanyName, FallbackValue=—}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="TRN "/><Run Text="{Binding InvoiceSnapshot.Company.CompanyTrn, Mode=OneWay, FallbackValue=—}"/>
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="CLIENT" Style="{StaticResource CardLabelStyle}"/>
                    <TextBlock Text="{Binding InvoiceSnapshot.Client.CustomerName, FallbackValue=—}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="TRN "/><Run Text="{Binding InvoiceSnapshot.Client.CustomerTrn, Mode=OneWay, FallbackValue=—}"/>
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="PROJECT" Style="{StaticResource CardLabelStyle}"/>
                    <TextBlock Text="{Binding InvoiceSnapshot.Project.ProjectIdentifierName, FallbackValue=—}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding InvoiceSnapshot.Project.ProjectContractNo, FallbackValue=—}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                <StackPanel Grid.Column="6" VerticalAlignment="Center" MinWidth="120">
                    <TextBlock Text="INVOICE VALUE" Style="{StaticResource CardLabelStyle}"/>
                    <TextBlock Text="{Binding GrandTotalDisplay}"
                               FontSize="{DynamicResource DensityKpiValueFontSize}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Glass table fills leftover height and scrolls internally -->
        <Border Grid.Row="1"
                Style="{StaticResource LineItemsTableStyle}"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,8,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GLASS PANELS"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="Production ticket — qty and sizes only"
                               FontSize="10"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly"
                              Focusable="True"
                              FocusVisualStyle="{x:Null}"
                              behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ItemsControl ItemsSource="{Binding InvoiceSnapshot.SpecGroups}"
                                  Margin="8,0,8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SpecGroupCardStyle}">
                                    <StackPanel>

                                        <Border Background="{DynamicResource MenuHoverBrush}"
                                                Padding="12,6"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="22" Height="22"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding GroupNumber}"
                                                               FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding SelectedSpecName, FallbackValue=—}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource LineItemsHeaderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="1" Text="GLASS REF"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"
                                                           HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="2" Text="W1"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="3" Text="H1"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="4" Text="W2"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="5" Text="H2"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="6" Text="QTY"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding ItemRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ModuleListRowStyle}"
                                                            Padding="0,2">
                                                        <Grid MinHeight="{DynamicResource DensityRowHeight}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36"/>
                                                                <ColumnDefinition Width="1.8*"/>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="56"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding SerialNumber}"
                                                                       Style="{StaticResource LineItemsSerialStyle}"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding GlassRef}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"
                                                                       HorizontalAlignment="Left"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding W1}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding H1}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                            <TextBlock Grid.Column="4"
                                                                       Text="{Binding W2}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                            <TextBlock Grid.Column="5"
                                                                       Text="{Binding H2}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                            <TextBlock Grid.Column="6"
                                                                       Text="{Binding Qty}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Style="{StaticResource LineItemsFooterStyle}">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                <Run Text="Glass type  " FontWeight="SemiBold"/>
                                                <Run Text="{Binding SelectedGlassType, FallbackValue=SGU, Mode=OneWay}"
                                                     FontWeight="Bold"
                                                     Foreground="{DynamicResource AccentBrush}"/>
                                            </TextBlock>
                                        </Border>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
