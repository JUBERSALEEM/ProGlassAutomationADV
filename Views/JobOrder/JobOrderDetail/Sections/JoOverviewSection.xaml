<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/JobOrder/JobOrderDetail/Sections/JoOverviewSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Job Order — OVERVIEW panel (unified Aug 2026)

     UNIFIED LAYOUT
       Was: the detail view had two tabs (Overview / Production). The
       user wanted the production form moved UP so it appears on the
       overview page ABOVE the glass-panels data grid, and the action
       buttons gathered into the header action bar.

       Now: this section hosts, top to bottom,
         1. JoProductionSection   — compact editable production tile-grid
         2. identity strip        — company / client / project / value
         3. GLASS PANELS table    — the production ticket grid
       Because the detail view now shows one continuous page, the whole
       thing scrolls vertically here instead of the glass table doing its
       own internal scroll (a nested scroll inside a page scroll was the
       original cause of clipped line items).

       All bindings preserved:
         InvoiceSnapshot.Company.CompanyName / CompanyTrn,
         InvoiceSnapshot.Client.CustomerName / CustomerTrn,
         InvoiceSnapshot.Project.ProjectIdentifierName /
         ProjectReference, GrandTotalDisplay,
         InvoiceSnapshot.SpecGroups (and every nested row binding).
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.JobOrder.JobOrderDetail.Sections.JoOverviewSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:sections="clr-namespace:ProGlassAutomation.Views.JobOrder.JobOrderDetail.Sections"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="JoSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  Focusable="True"
                  FocusVisualStyle="{x:Null}"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <!-- Full-width wrapper: no MaxWidth / left-align cap so the whole
             production + identity + glass-panel sheet spans edge to edge. -->
        <StackPanel>

            <!-- ══════════ 1. PRODUCTION FORM (compact tiles) ══════════ -->
            <sections:JoProductionSection/>

            <Border Style="{StaticResource SurfacePrimaryStyle}"
                    Margin="0,4,0,14"
                    Padding="0,0,0,0">
                <StackPanel>

                    <!-- ══════════ 2. IDENTITY STRIP ══════════ -->
                    <TextBlock Text="{DynamicResource JobOrder.SourceInvoice}"
                               Style="{StaticResource Typography.Label}"
                               Margin="0,0,0,8"/>
                    <Border Style="{StaticResource ModuleListKpiStripStyle}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Common.Company}" Style="{StaticResource Typography.Label}"/>
                                <TextBlock Text="{Binding InvoiceSnapshot.Company.CompanyName, FallbackValue=—}"
                                           FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.SemiBold}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="{DynamicResource FontSize.Body}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="TRN "/><Run Text="{Binding InvoiceSnapshot.Company.CompanyTrn, Mode=OneWay, FallbackValue=—}"/>
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource JobOrder.Client}" Style="{StaticResource Typography.Label}"/>
                                <TextBlock Text="{Binding InvoiceSnapshot.Client.CustomerName, FallbackValue=—}"
                                           FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.SemiBold}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="{DynamicResource FontSize.Body}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="TRN "/><Run Text="{Binding InvoiceSnapshot.Client.CustomerTrn, Mode=OneWay, FallbackValue=—}"/>
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Common.Project}" Style="{StaticResource Typography.Label}"/>
                                <TextBlock Text="{Binding InvoiceSnapshot.Project.ProjectIdentifierName, FallbackValue=—}"
                                           FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.SemiBold}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding InvoiceSnapshot.Project.ProjectReference, FallbackValue=—}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                            <StackPanel Grid.Column="6" VerticalAlignment="Center" MinWidth="120">
                                <TextBlock Text="{DynamicResource JobOrder.InvoiceValue}" Style="{StaticResource Typography.Label}"/>
                                <TextBlock Text="{Binding GrandTotalDisplay}"
                                           FontSize="{DynamicResource FontSize.Kpi}"
                                           FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ══════════ 3. GLASS PANELS TABLE ══════════ -->
                    <TextBlock Text="{DynamicResource JobOrder.GlassPanels}"
                               Style="{StaticResource Typography.Label}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource JobOrder.ProductionTicketSizesQtySQMTotalSQM}"
                               FontSize="{DynamicResource FontSize.BodySmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding InvoiceSnapshot.SpecGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SpecGroupCardStyle}">
                                    <StackPanel>

                                        <Border Background="{DynamicResource SurfaceTertiaryBrush}"
                                                Padding="12,6"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="{DynamicResource Border.BottomHairlineThickness}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="22" Height="22"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Margin="0,0,8,0" Style="{StaticResource SurfacePrimaryStyle}">
                                                    <TextBlock Text="{Binding GroupNumber}"
                                                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding SelectedSpecName, FallbackValue=—}"
                                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource LineItemsHeaderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="1" Text="{DynamicResource DeliveryNote.GlassRef}"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"
                                                           HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="2" Text="W1"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="3" Text="H1"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="4" Text="W2"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="5" Text="H2"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="6" Text="QTY"
                                                           Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding ItemRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ModuleListRowStyle}"
                                                            Padding="0,2">
                                                        <Grid MinHeight="{DynamicResource DensityRowHeight}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36"/>
                                                                <ColumnDefinition Width="1.8*"/>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="56"/>
                                                                <ColumnDefinition Width="72"/>
                                                                <ColumnDefinition Width="88"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding SerialNumber}"
                                                                       Style="{StaticResource LineItemsSerialStyle}"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding GlassRef}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"
                                                                       HorizontalAlignment="Left"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding W1}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding H1}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                            <TextBlock Grid.Column="4"
                                                                       Text="{Binding W2}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                            <TextBlock Grid.Column="5"
                                                                       Text="{Binding H2}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                            <TextBlock Grid.Column="6"
                                                                       Text="{Binding Qty}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                            <TextBlock Grid.Column="7"
                                                                       Text="{Binding Sqm1, StringFormat={}{0:0.000}}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                            <TextBlock Grid.Column="8"
                                                                       Text="{Binding TotalSqm, StringFormat={}{0:0.000}}"
                                                                       Style="{StaticResource LineItemsReadonlyStyle}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Style="{StaticResource LineItemsFooterStyle}">
                                            <TextBlock FontSize="{DynamicResource FontSize.Body}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                <Run Text="{DynamicResource JobOrder.GlassType}" FontWeight="{DynamicResource Weight.SemiBold}"/>
                                                <Run Text="{Binding SelectedGlassType, FallbackValue=SGU, Mode=OneWay}"
                                                     FontWeight="{DynamicResource Weight.Bold}"
                                                     Foreground="{DynamicResource AccentBrush}"/>
                                            </TextBlock>
                                        </Border>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
