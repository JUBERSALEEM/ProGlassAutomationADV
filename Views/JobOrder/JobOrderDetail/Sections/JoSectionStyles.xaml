<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <!-- Job Order styles use live nine-family theme resources -->
    <!-- Bento Card Styles for Job Order -->
    <Style x:Key="SurfaceDetailStyle" TargetType="Border" BasedOn="{StaticResource ProGlassRewriteInsetStyle}">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <Style x:Key="SpecGroupCardStyle" TargetType="Border" BasedOn="{StaticResource ProGlassRewriteCardStyle}">
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style x:Key="ModuleListKpiStripStyle" TargetType="Border" BasedOn="{StaticResource ProGlassRewriteCardStyle}">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="CornerRadius" Value="18"/>
    </Style>

    <Style x:Key="ModuleListKpiDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ThemeControlEdgeBrush}"/>
        <Setter Property="Margin" Value="16,4"/>
    </Style>

    <!-- Compact Form Field Controls -->
    <Style x:Key="JoCompactLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ProGlassRewriteCaptionStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="JoCompactInputStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ThemeControlFaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="JoCompactComboStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource ThemeControlFaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlEdgeBrush}"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>

    <Style x:Key="JoCompactDateStyle" TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource ThemeControlFaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlEdgeBrush}"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>

    <Style x:Key="JoCompactMultiInputStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ThemeControlFaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style x:Key="LineItemsHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeCardHighlightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <Style x:Key="LineItemsHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ProGlassRewriteCaptionStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="LineItemsFooterStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeCardHighlightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="CornerRadius" Value="0,0,18,18"/>
    </Style>

</ResourceDictionary>