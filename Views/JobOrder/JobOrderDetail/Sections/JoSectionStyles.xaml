<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <!-- Shared styles for Job Order detail sections (also merged by the
         detail view itself - single source, no duplication). -->
        <Style x:Key="CardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Padding"     Value="10,8"/>
            <Setter Property="Margin"      Value="0,0,0,14"/>
            <Setter Property="Background"  Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"  Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="MultiLineInputStyle" TargetType="TextBox"
               BasedOn="{StaticResource FieldInputStyle}">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="False"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
            <Setter Property="MinHeight"     Value="70"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="ReadOnlyFieldStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,1,0,0"/>
        </Style>
        <Style x:Key="ReadOnlyLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style x:Key="SpecDataCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="9"/>
            <Setter Property="Foreground"        Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Padding"           Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SpecHeaderCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="Padding"    Value="6,5"/>
        </Style>
        <Style x:Key="SubSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style x:Key="SpecGroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Production form card — a light surface that groups related
             fields (Status & Delivery / Site Delivery / Assignment /
             Factory Floor) so the production panel reads as labelled
             sections instead of one endless column of full-width inputs.
             Sits on the page background (ModuleBackgroundBrush inherited)
             with a subtle outline and the app's rounded corner. -->
        <Style x:Key="JoFormCardStyle" TargetType="Border" BasedOn="{StaticResource SpecGroupCardStyle}">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Action-bar chip for the compact export / save action row.
             The row is docked right, so these stay small and tight. -->
        <Style x:Key="JoActionBarStyle" TargetType="Border" BasedOn="{StaticResource SpecGroupCardStyle}">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             COMPACT FORM TILES (Job Order production — Aug 2026)

             Originally these tiles lived in a WrapPanel with a hard
             MinWidth/MaxWidth, so on a wide window they clustered on the
             left and left a big empty gap on the right. Each field is now
             placed in a responsive star-column Grid and the tiles are
             stretched to FILL the full available width, so the whole form
             spans edge to edge and the column widths grow/shrink with the
             window. The MinWidth below is only a floor so the inputs never
             collapse on a very narrow window.

             JoFieldTileStyle  - the rounded surface around one field.
             JoFieldTitleStyle - a big tile label (used for the section).
             JoCompactLabelStyle - the small field label above the input.
             JoCompactInputStyle - TextBox with tight, even spacing.
             JoCompactMultiInputStyle - multiline variant for notes.
             JoCompactComboStyle - ComboBox matching the compact input.
             JoCompactDateStyle - DatePicker matching the compact input.
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="JoFieldTileStyle" TargetType="Border">
            <Setter Property="Background"          Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"         Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness"     Value="{DynamicResource CardBorderThickness}"/>
            <Setter Property="CornerRadius"        Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Padding"             Value="12,10"/>
            <Setter Property="Margin"              Value="0,0,12,12"/>
            <!-- No fixed width: the host Grid's star columns drive this.
                 The floor keeps inputs readable on narrow windows. -->
            <Setter Property="MinWidth"            Value="150"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
        </Style>

        <Style x:Key="JoFieldTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible"  Value="False"/>
        </Style>

        <Style x:Key="JoCompactLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="JoCompactInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="FontSize"    Value="12.5"/>
            <Setter Property="Padding"     Value="8,6"/>
            <Setter Property="Margin"      Value="0,0,0,0"/>
            <Setter Property="Background"  Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="Foreground"  Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="JoCompactMultiInputStyle" TargetType="TextBox"
               BasedOn="{StaticResource JoCompactInputStyle}">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="False"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
            <Setter Property="MinHeight"     Value="52"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="JoCompactComboStyle" TargetType="ComboBox">
            <Setter Property="FontSize"    Value="12.5"/>
            <Setter Property="Padding"     Value="6,4"/>
            <Setter Property="Margin"      Value="0,0,0,0"/>
            <Setter Property="Height"      Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background"  Value="{DynamicResource MenuHoverBrush}"/>
        </Style>

        <Style x:Key="JoCompactDateStyle" TargetType="DatePicker">
            <Setter Property="FontSize"    Value="12.5"/>
            <Setter Property="Padding"     Value="6,4"/>
            <Setter Property="Margin"      Value="0,0,0,0"/>
            <Setter Property="Height"      Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background"  Value="{DynamicResource MenuHoverBrush}"/>
        </Style>

</ResourceDictionary>
