<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/JobOrder/JobOrderDetail/Sections/JoProductionSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Job Order — PRODUCTION panel (compact tile-grid redesign Aug 2026)

     REDESIGN
       Was: one full-width column of stacked controls with a big action
       row at the bottom. The user asked to tighten it like the Settings
       pages and to move the action buttons (Create DN / PDF / Excel /
       CSV / Save) up into the detail header, and to lift the production
       form ABOVE the glass-panels data grid.

       Now: each production field lives in its own small JoFieldTileStyle
       tile and the tiles reflow in a WrapPanel, so two or three fields
       sit side by side on a wide window. The action buttons are gone
       from here — they now live in the JobOrderDetailView action bar.
       All 19 ViewModel bindings / commands preserved.

         StatusOptions, SelectedStatus, PriorityOptions, SelectedPriority,
         DeliveryDate, SiteDeliveryContact, SiteDeliveryPhone,
         SiteDeliveryAddress, AssignedTo, CuttingInstructions,
         DrawingReference, InternalNotes, LastEditedDisplay.

     Layout contract:
       • Compact, even 12px gutters so the grid reads calm, not dense.
       • No hard-coded widths — the WrapPanel + the tile MinWidth /
         MaxWidth do all reflow.
       • Multi-line notes keep a reasonable min height so they do not
         inflate the whole form.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.JobOrder.JobOrderDetail.Sections.JoProductionSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="JoSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel MaxWidth="1180" HorizontalAlignment="Left">

        <!-- Section header -->
        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
            <TextBlock Text="PRODUCTION DETAILS"
                       Style="{StaticResource SectionTitleStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBlock Text="Status, priority, delivery and shop-floor instructions. Saving goes through the top bar."
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <WrapPanel>

            <!-- Status -->
            <Border Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="STATUS" Style="{StaticResource JoCompactLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding SelectedStatus}"
                              Style="{StaticResource JoCompactComboStyle}"/>
                </StackPanel>
            </Border>

            <!-- Priority -->
            <Border Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="PRIORITY" Style="{StaticResource JoCompactLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding PriorityOptions}"
                              SelectedItem="{Binding SelectedPriority}"
                              Style="{StaticResource JoCompactComboStyle}"/>
                </StackPanel>
            </Border>

            <!-- Delivery date -->
            <Border Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="DELIVERY DATE" Style="{StaticResource JoCompactLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding DeliveryDate}"
                                Style="{StaticResource JoCompactDateStyle}"/>
                </StackPanel>
            </Border>

            <!-- Assigned to -->
            <Border Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="ASSIGNED TO" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding AssignedTo, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Site delivery contact -->
            <Border Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="SITE DELIVERY · CONTACT" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding SiteDeliveryContact, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Site delivery phone -->
            <Border Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="SITE DELIVERY · PHONE" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding SiteDeliveryPhone, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Drawing reference -->
            <Border Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="DRAWING REFERENCE" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding DrawingReference, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Site delivery address (wide) -->
            <Border Style="{StaticResource JoFieldTileStyle}"
                    MinWidth="360" MaxWidth="480">
                <StackPanel>
                    <TextBlock Text="SITE DELIVERY ADDRESS" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding SiteDeliveryAddress, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Cutting instructions (wide) -->
            <Border Style="{StaticResource JoFieldTileStyle}"
                    MinWidth="360" MaxWidth="480">
                <StackPanel>
                    <TextBlock Text="CUTTING INSTRUCTIONS" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding CuttingInstructions, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactMultiInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Internal notes (wide) -->
            <Border Style="{StaticResource JoFieldTileStyle}"
                    MinWidth="360" MaxWidth="480">
                <StackPanel>
                    <TextBlock Text="INTERNAL NOTES" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding InternalNotes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactMultiInputStyle}"/>
                </StackPanel>
            </Border>

        </WrapPanel>

        <!-- Last edited / audit hint -->
        <TextBlock Text="{Binding LastEditedDisplay}"
                   FontSize="10" FontStyle="Italic"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Margin="2,0,0,0"
                   IsHitTestVisible="False"/>

    </StackPanel>
</UserControl>
