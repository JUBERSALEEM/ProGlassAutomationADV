<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/JobOrder/JobOrderDetail/Sections/JoProductionSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Job Order — PRODUCTION panel (auto-compact redesign Aug 2026)

     REDESIGN
       The production form now auto-compacts against Settings ► Features
       ► Job Order. Each optional field tile binds Visibility to
       JobOrderFieldVisibility.Instance. When the operator turns a field
       OFF in Settings, the tile COLLAPSES and the WrapPanel re-flows the
       remaining tiles so the row tightens with no blank spacer — exactly
       like the Settings pages. Required workflow controls (Status,
       Priority, Delivery Date) are always visible and cannot be hidden.

       Layout: a WrapPanel of JoFieldTileStyle tiles that wrap into rows
       and fill the full available width. Hidden tiles vanish and the
       rest re-flow. Action buttons remain in JobOrderDetailView header.

       All production bindings preserved:
         StatusOptions, SelectedStatus, PriorityOptions, SelectedPriority,
         DeliveryDate, SiteDeliveryContact, SiteDeliveryPhone,
         SiteDeliveryAddress, AssignedTo, CuttingInstructions,
         DrawingReference, InternalNotes, LastEditedDisplay.

       Optional-field visibility bindings:
         ShowAssignedTo, ShowSiteDeliveryContact, ShowSiteDeliveryPhone,
         ShowSiteDeliveryAddress, ShowDrawingReference,
         ShowCuttingInstructions, ShowInternalNotes.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.JobOrder.JobOrderDetail.Sections.JoProductionSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:features="clr-namespace:ProGlassAutomation.Services.Features"
             xmlns:shared="clr-namespace:ProGlassAutomation.Views.Shared"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="JoSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!-- Section header -->
        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
            <TextBlock Text="{DynamicResource JobOrder.ProductionDetails}"
                       Style="{StaticResource Typography.H2}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBlock Text="{DynamicResource JobOrder.StatusPriorityDeliveryShopFloorInstructions}"
                       FontSize="{DynamicResource FontSize.Body}"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ERP hardening (Phase 2): posted job orders (Delivered/Rejected)
             freeze their production body. The status control below stays
             enabled so a legitimate transition is still possible. -->
        <Border Style="{StaticResource ModuleWarningBannerStyle}"
                Visibility="{Binding BodyLockBannerVisibility}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource FontFamily.Icon}"
                           FontSize="{DynamicResource FontSize.Title}"
                           Foreground="{DynamicResource WarningBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource Lock.PostedBodyLocked}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 2026-09-14: was a WrapPanel of 300-460px content-sized
             tiles — tiles never stretch in a WrapPanel, so rows rendered
             left-aligned with uneven widths and a dead right side.
             Now an equal-width 3-column grid (professional form layout);
             hidden optional fields collapse their cell. -->
        <UniformGrid Columns="3">

            <!-- Status (workflow control — always visible) -->
            <Border Style="{StaticResource SurfaceDetailStyle}" Margin="0,0,12,12">
                <StackPanel Style="{StaticResource Field.Panel}">
                    <TextBlock Text="{DynamicResource Common.Status}" Style="{StaticResource JoCompactLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding SelectedStatus}"
                              Style="{StaticResource JoCompactComboStyle}"/>
                </StackPanel>
            </Border>

            <!-- Priority -->
            <Border Style="{StaticResource SurfaceDetailStyle}" Margin="0,0,12,12"
                    IsEnabled="{Binding IsBodyEditable}">
                <StackPanel Style="{StaticResource Field.Panel}">
                    <TextBlock Text="{DynamicResource Common.Priority}" Style="{StaticResource JoCompactLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding PriorityOptions}"
                              SelectedItem="{Binding SelectedPriority}"
                              Style="{StaticResource JoCompactComboStyle}"/>
                </StackPanel>
            </Border>

            <!-- Delivery date -->
            <Border Style="{StaticResource SurfaceDetailStyle}" Margin="0,0,12,12"
                    IsEnabled="{Binding IsBodyEditable}">
                <StackPanel Style="{StaticResource Field.Panel}">
                    <TextBlock Text="{DynamicResource JobOrder.DeliveryDATE}" Style="{StaticResource JoCompactLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding DeliveryDate}"
                                Style="{StaticResource JoCompactDateStyle}"/>
                </StackPanel>
            </Border>

            <!-- Assigned to (optional) -->
            <Border Style="{StaticResource SurfaceDetailStyle}" Margin="0,0,12,12"
                    IsEnabled="{Binding IsBodyEditable}"
                    Visibility="{Binding Path=ShowAssignedTo,
                        Source={x:Static features:JobOrderFieldVisibility.Instance},
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Style="{StaticResource Field.Panel}">
                    <TextBlock Text="{DynamicResource JobOrder.Assigned}" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding AssignedTo, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Site delivery contact (optional) -->
            <Border Style="{StaticResource SurfaceDetailStyle}" Margin="0,0,12,12"
                    IsEnabled="{Binding IsBodyEditable}"
                    Visibility="{Binding Path=ShowSiteDeliveryContact,
                        Source={x:Static features:JobOrderFieldVisibility.Instance},
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Style="{StaticResource Field.Panel}">
                    <TextBlock Text="{DynamicResource JobOrder.SITEDeliveryContact}" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding SiteDeliveryContact, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Site delivery phone (optional) -->
            <Border Style="{StaticResource SurfaceDetailStyle}" Margin="0,0,12,12"
                    IsEnabled="{Binding IsBodyEditable}"
                    Visibility="{Binding Path=ShowSiteDeliveryPhone,
                        Source={x:Static features:JobOrderFieldVisibility.Instance},
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Style="{StaticResource Field.Panel}">
                    <TextBlock Text="{DynamicResource JobOrder.SITEDeliveryPhone}" Style="{StaticResource JoCompactLabelStyle}"/>
                    <shared:CountryPhoneControl
                             PhoneText="{Binding SiteDeliveryPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="JobOrder.SiteDeliveryPhone"
                             AutomationProperties.Name="Site delivery phone"/>
                </StackPanel>
            </Border>

            <!-- Drawing reference (optional) -->
            <Border Style="{StaticResource SurfaceDetailStyle}" Margin="0,0,12,12"
                    IsEnabled="{Binding IsBodyEditable}"
                    Visibility="{Binding Path=ShowDrawingReference,
                        Source={x:Static features:JobOrderFieldVisibility.Instance},
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Style="{StaticResource Field.Panel}">
                    <TextBlock Text="{DynamicResource JobOrder.DrawingReference}" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding DrawingReference, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Site delivery address (optional, wide) -->
            <Border Style="{StaticResource SurfaceDetailStyle}" Margin="0,0,12,12"
                   
                    IsEnabled="{Binding IsBodyEditable}"
                    Visibility="{Binding Path=ShowSiteDeliveryAddress,
                        Source={x:Static features:JobOrderFieldVisibility.Instance},
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Style="{StaticResource Field.Panel}">
                    <TextBlock Text="{DynamicResource JobOrder.SITEDeliveryAddress}" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding SiteDeliveryAddress, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Cutting instructions (optional, wide) -->
            <Border Style="{StaticResource SurfaceDetailStyle}" Margin="0,0,12,12"
                   
                    IsEnabled="{Binding IsBodyEditable}"
                    Visibility="{Binding Path=ShowCuttingInstructions,
                        Source={x:Static features:JobOrderFieldVisibility.Instance},
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Style="{StaticResource Field.Panel}">
                    <TextBlock Text="{DynamicResource JobOrder.CuttingInstructions}" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding CuttingInstructions, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactMultiInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Internal notes (optional, wide) -->
            <Border Style="{StaticResource SurfaceDetailStyle}" Margin="0,0,12,12"
                   
                    IsEnabled="{Binding IsBodyEditable}"
                    Visibility="{Binding Path=ShowInternalNotes,
                        Source={x:Static features:JobOrderFieldVisibility.Instance},
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Style="{StaticResource Field.Panel}">
                    <TextBlock Text="{DynamicResource JobOrder.InternalNotes}" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding InternalNotes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactMultiInputStyle}"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- Last edited / audit hint -->
        <TextBlock Text="{Binding LastEditedDisplay}"
                   FontSize="{DynamicResource FontSize.BodySmall}" FontStyle="Italic"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Margin="2,0,0,0"
                   IsHitTestVisible="False"/>

    </StackPanel>
</UserControl>
