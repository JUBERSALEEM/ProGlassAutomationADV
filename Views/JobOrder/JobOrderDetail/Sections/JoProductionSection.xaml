<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/JobOrder/JobOrderDetail/Sections/JoProductionSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Job Order — PRODUCTION panel (full-width grid redesign Aug 2026)

     REDESIGN
       Was: one full-width column, then a WrapPanel of fixed-width tiles
       that clustered on the LEFT and left a big empty gap on the right
       of a wide window. The user asked to "fill width accordingly, don't
       keep left align — make it full width."

       Now: every production field is a JoFieldTileStyle tile that
       STRETCHES to fill a responsive star-column Grid. Four equal
       columns span the entire available width and grow/shrink with the
       window, so the form is always full-width with no dead space on the
       right. Action buttons remain in the JobOrderDetailView header.

       All 13 ViewModel bindings preserved:
         StatusOptions, SelectedStatus, PriorityOptions, SelectedPriority,
         DeliveryDate, SiteDeliveryContact, SiteDeliveryPhone,
         SiteDeliveryAddress, AssignedTo, CuttingInstructions,
         DrawingReference, InternalNotes, LastEditedDisplay.

     Layout (full-width, 4 columns):
       Row 0: Status | Priority | Delivery Date | Assigned To
       Row 1: Site Contact | Site Phone | Drawing Ref | Site Address
       Row 2: Cutting Instructions (half) | Internal Notes (half)
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.JobOrder.JobOrderDetail.Sections.JoProductionSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="JoSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!-- Section header -->
        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
            <TextBlock Text="PRODUCTION DETAILS"
                       Style="{StaticResource SectionTitleStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBlock Text="Status, priority, delivery and shop-floor instructions. Saving goes through the top bar."
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Full-width responsive grid: four star columns that fill the
             available width. Row spans let the wide fields use extra space. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status -->
            <Border Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="STATUS" Style="{StaticResource JoCompactLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding SelectedStatus}"
                              Style="{StaticResource JoCompactComboStyle}"/>
                </StackPanel>
            </Border>

            <!-- Priority -->
            <Border Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="PRIORITY" Style="{StaticResource JoCompactLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding PriorityOptions}"
                              SelectedItem="{Binding SelectedPriority}"
                              Style="{StaticResource JoCompactComboStyle}"/>
                </StackPanel>
            </Border>

            <!-- Delivery date -->
            <Border Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="DELIVERY DATE" Style="{StaticResource JoCompactLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding DeliveryDate}"
                                Style="{StaticResource JoCompactDateStyle}"/>
                </StackPanel>
            </Border>

            <!-- Assigned to -->
            <Border Grid.Row="0" Grid.Column="3"
                    Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="ASSIGNED TO" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding AssignedTo, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Site delivery contact -->
            <Border Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="SITE DELIVERY · CONTACT" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding SiteDeliveryContact, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Site delivery phone -->
            <Border Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="SITE DELIVERY · PHONE" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding SiteDeliveryPhone, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Drawing reference -->
            <Border Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="DRAWING REFERENCE" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding DrawingReference, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Site delivery address -->
            <Border Grid.Row="1" Grid.Column="3"
                    Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="SITE DELIVERY ADDRESS" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding SiteDeliveryAddress, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Cutting instructions (half width) -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="CUTTING INSTRUCTIONS" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding CuttingInstructions, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactMultiInputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Internal notes (half width) -->
            <Border Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                    Style="{StaticResource JoFieldTileStyle}">
                <StackPanel>
                    <TextBlock Text="INTERNAL NOTES" Style="{StaticResource JoCompactLabelStyle}"/>
                    <TextBox Text="{Binding InternalNotes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JoCompactMultiInputStyle}"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- Last edited / audit hint -->
        <TextBlock Text="{Binding LastEditedDisplay}"
                   FontSize="10" FontStyle="Italic"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Margin="2,0,0,0"
                   IsHitTestVisible="False"/>

    </StackPanel>
</UserControl>
