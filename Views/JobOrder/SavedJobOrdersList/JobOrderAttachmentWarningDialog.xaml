<Window x:Class="ProGlassAutomation.Views.JobOrder.SavedJobOrdersList.JobOrderAttachmentWarningDialog"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource JobOrder.JobOrderRelatedAttachments}"
        Width="560"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        Shown when the user deletes a Job Order whose source Proforma
        Invoice still has Step 8 attachments. Exactly TWO options, per
        requirement:
          • DELETE ATTACHMENTS  → attachments are removed after the JO delete.
          • KEEP ATTACHMENTS    → attachments survive; the PI is cancelled
                                   but its files/manifest are untouched.
        The job order is deleted either way (that was confirmed in the
        previous dialog). Esc / X = KEEP (safe default — never destroy
        documents by accident).

        FIXED window height (no SizeToContent): the dialog can never
        re-measure or jump. Margin >= blur radius so the drop shadow
        renders fully.
    -->
    <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}"
            Margin="24,20,24,28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4"
                              Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Message -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <StackPanel Grid.Row="0" Margin="28,24,28,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource WarningColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource DangerColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextTitleLarge}"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource JobOrder.JobOrderRelatedAttachments}"
                                   FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource JobOrder.SourceProformaInvoiceStillStep8Attachments}"
                                   FontSize="{StaticResource TextBody}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- ═══ MESSAGE ═══ -->
            <TextBlock x:Name="MessageText" Grid.Row="1"
                       Margin="24,16,24,0"
                       FontSize="{StaticResource TextBodyLarge}"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>

            <!-- ═══ FOOTER ═══ -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="0,0,16,16"
                    Padding="24,16"
                    Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE8E5;" Content="{DynamicResource JobOrder.KEEPAttachments}"
                            Margin="0,0,10,0"
                            ToolTip="{DynamicResource JobOrder.DeleteJobOrderKeepInvoiceSAttachments}"
                            Click="OnKeepClick"
                            IsCancel="True"/>
                    <Button Style="{StaticResource DangerButton}"
                            Tag="&#xE74D;" Content="{DynamicResource JobOrder.DeleteAttachments}"
                            ToolTip="{DynamicResource JobOrder.DeleteJobOrderInvoiceSAttachments}"
                            Click="OnDeleteClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
