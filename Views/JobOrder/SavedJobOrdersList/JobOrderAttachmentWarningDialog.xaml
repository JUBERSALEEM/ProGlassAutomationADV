<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/JobOrder/SavedJobOrdersList/JobOrderAttachmentWarningDialog.xaml
     PROJECT: ProGlassAutomation
     MODULE: Job Order — delete flow

     Shown when the user deletes a Job Order whose source Proforma
     Invoice still has Step 8 attachments. Exactly TWO options, per
     requirement:
       • DELETE ATTACHMENTS  → attachments are removed after the JO delete.
       • KEEP ATTACHMENTS    → attachments survive; the PI is cancelled
                                but its files/manifest are untouched.
     The job order is deleted either way. Esc / X = KEEP (safe default —
     never destroy documents by accident).

     2026-09 dialog audit: rebuilt on the shared ThemedDialogWindow chrome
     (previously a fixed 560×380 NoResize window whose inner card was
     MaxWidth=400 — narrower than its own window, the misalignment report).
     Now content-driven sizing: long localized strings wrap and the window
     grows; work-area clamped with body scroll as the last resort.
     ═══════════════════════════════════════════════════════════════════ -->

<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.JobOrder.SavedJobOrdersList.JobOrderAttachmentWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
        Title="{DynamicResource JobOrder.JobOrderRelatedAttachments}"
        Width="560"
        DialogIcon="&#xE7BA;"
        DialogIconBrush="{DynamicResource WarningBrush}"
        DialogSubtitle="{DynamicResource JobOrder.SourceProformaInvoiceStillStep8Attachments}"
             FontFamily="{DynamicResource AppFontFamily}">

    <TextBlock x:Name="MessageText"
               FontSize="{DynamicResource FontSize.Title}"
               LineHeight="20"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextPrimaryBrush}"/>

    <dialogs:ThemedDialogWindow.FooterContent>
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource OutlinedPillButton}"
                    Tag="&#xE8E5;" Content="{DynamicResource JobOrder.KEEPAttachments}"
                    Margin="0,0,10,0"
                    ToolTip="{DynamicResource JobOrder.DeleteJobOrderKeepInvoiceSAttachments}"
                    Click="OnKeepClick"
                    IsCancel="True"/>
            <Button Style="{StaticResource DangerButton}"
                    Tag="&#xE74D;" Content="{DynamicResource JobOrder.DeleteAttachments}"
                    ToolTip="{DynamicResource JobOrder.DeleteJobOrderInvoiceSAttachments}"
                    Click="OnDeleteClick"/>
        </StackPanel>
    </dialogs:ThemedDialogWindow.FooterContent>
</dialogs:ThemedDialogWindow>
