<!-- Job Order list — industrial table chrome. Bindings / commands / OnLoaded / OnRowRightClick unchanged. -->
<UserControl x:Class="ProGlassAutomation.Views.JobOrder.SavedJobOrdersList.SavedJobOrdersListView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnLoaded">

    <UserControl.Resources>
        
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource JobOrder.PastDeliveryDate}"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource ModuleListFilterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 Style="{StaticResource ModuleListFilterInputStyle}"
                                 Margin="0,0,8,0"
                                 ToolTip="{DynamicResource JobOrder.SearchJobCustomerProjectPI}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"
                                  Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding PriorityFilterOptions}"
                                  SelectedItem="{Binding SelectedPriorityFilter}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"
                                  Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSort}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"
                                  Margin="0,0,8,0"/>
                        <CheckBox Grid.Column="4"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  IsChecked="{Binding ShowVoided}"
                                  Content="{DynamicResource Void.ShowVoided}"
                                  ToolTip="{DynamicResource Void.ShowVoidedTip}"/>
                        <Button Grid.Column="5" Style="{StaticResource OutlinedPillButton}"
                                Tag="&#xE711;" Content="{DynamicResource Action.Clear}"
                                Margin="0,0,8,0"
                                ToolTip="{DynamicResource Action.ClearFilters}"
                                Command="{Binding ClearFiltersCommand}"/>
                        <Button Grid.Column="6" Style="{StaticResource PrimaryPillButton}"
                                Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                                ToolTip="{DynamicResource JobOrder.RefreshList}"
                                Command="{Binding RefreshCommand}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource ModuleListTableHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Common.JobOrder}" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Common.Customer}" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="3" Text="{DynamicResource Nav.Delivery}" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="4" Text="{DynamicResource Common.Project}" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="5" Text="{DynamicResource JobOrder.ValueAED}" Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="6" Text="{DynamicResource Common.Status}" Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="{DynamicResource Common.Priority}" Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <ListBox ItemsSource="{Binding DisplayedJobs}"
                             ItemContainerStyle="{StaticResource SurfacePrimaryStyle}"
                             BorderThickness="{DynamicResource Border.NoneThickness}"
                             Background="Transparent"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.IsDeferredScrollingEnabled="False"
                             ScrollViewer.PanningMode="None"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             VirtualizingStackPanel.ScrollUnit="Pixel"
                             VirtualizingStackPanel.CacheLength="200,400"
                             VirtualizingStackPanel.CacheLengthUnit="Pixel"
                             behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModuleListRowStyle}"
                                        MouseRightButtonUp="OnRowRightClick"
                                        MinHeight="56">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="{Binding PriorityBrushKey,
                                                             Converter={StaticResource BrushKeyConverter}}"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,8,8,8">
                                            <TextBlock Text="{Binding JobOrderId}"
                                                       FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="{DynamicResource TintGrayBrush}"
                                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                        BorderThickness="{DynamicResource Border.HairlineThickness}"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Padding="8,2"
                                                        Margin="0,0,6,0" Style="{StaticResource SurfacePrimaryStyle}">
                                                    <TextBlock Text="{Binding ProjectName}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="140"/>
                                                </Border>
                                                <Border Background="{DynamicResource TintBlueBrush}"
                                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                        BorderThickness="{DynamicResource Border.HairlineThickness}"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Padding="8,2"
                                                        Margin="0,0,6,0" Style="{StaticResource SurfacePrimaryStyle}">
                                                    <TextBlock FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                               Foreground="{DynamicResource AccentBrush}">
                                                        <Run Text="{DynamicResource Common.From}"/><Run Text="{Binding SourceProformaId, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Padding="8,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Background" Value="{DynamicResource TintRedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding OverdueDisplay}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding CustomerName}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0"
                                                   ToolTip="{Binding CustomerName}"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding DeliveryDisplay}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding ProjectName}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0"
                                                   ToolTip="{Binding ProjectName}"/>

                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding GrandTotalDisplay}"
                                                   FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,12,0"/>

                                        <!-- Column 6: STATUS — production status chip (e.g.
                                             "Released to factory") above the delivery-status chip. -->
                                        <StackPanel Grid.Column="6"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <Border CornerRadius="{DynamicResource Radius.Small}"
                                                    Padding="8,2"
                                                    HorizontalAlignment="Center"
                                                    Background="{Binding StatusBrushKey,
                                                                 Converter={StaticResource BrushKeyConverter}}"
                                                    ToolTip="{DynamicResource JobOrder.ProductionStatus}" Style="{StaticResource SurfacePrimaryStyle}">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                            </Border>
                                            <Border Margin="0,2,0,0"
                                                    CornerRadius="{DynamicResource Radius.Small}"
                                                    Padding="8,2"
                                                    HorizontalAlignment="Center"
                                                    Background="{Binding DisplayStatusBrushKey,
                                                                 Converter={StaticResource BrushKeyConverter}}"
                                                    ToolTip="{DynamicResource JobOrder.DeliveryStatus}" Style="{StaticResource SurfacePrimaryStyle}">
                                                <TextBlock Text="{Binding DisplayStatus}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <Border Grid.Column="7"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="10,4"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Background="{Binding PriorityBrushKey,
                                                             Converter={StaticResource BrushKeyConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
                                            <TextBlock Text="{Binding PriorityLabel}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                        </Border>

                                        <StackPanel Grid.Column="8"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource RowPrimaryButton}"
                                                    Tag="&#xE8E5;" Content="{DynamicResource Action.Open}"
                                                    ToolTip="{DynamicResource JobOrder.OpenJobOrder}"
                                                    Command="{Binding DataContext.OpenJobOrderCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource RowOutlinedButton}"
                                                    Tag="&#xE81C;" Content="{DynamicResource DeliveryNote.History}"
                                                    Margin="6,0,0,0"
                                                    ToolTip="{DynamicResource Common.VersionHistory}"
                                                    Command="{Binding DataContext.ShowVersionsCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DisplayedJobs.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsLoading}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <emptyState:EmptyStateControl
                            Icon="&#xE8C8;"
                            Title="{DynamicResource Dashboard.NoJobOrdersYet}"
                            Message="Job orders track production for approved invoices. Convert a Proforma Invoice into a Job Order and it will appear here with its status, priority and delivery schedule."/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
