<UserControl x:Class="ProGlassAutomation.Views.JobOrder.SavedJobOrdersList.SavedJobOrdersListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:hero="clr-namespace:ProGlassAutomation.Controls.GradientHeroCard"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnLoaded">

    <UserControl.Resources>

        <!-- Row card — priority colored left accent bar via brush key -->
        <Style x:Key="JobRowCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{Binding PriorityBrushKey,
                            Converter={StaticResource BrushKeyConverter}}"/>
            <Setter Property="BorderThickness" Value="4,1,1,1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="16,14"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Open button accent pill -->
        <Style x:Key="OpenButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="OPEN"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3730A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem container style — removes default selection padding/highlight,
             lets our JobRowCardStyle be the full row.  -->
        <Style x:Key="JobListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT LAYOUT — Sticky header on top, virtualized list below
    ═══════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Sticky header (KPIs + filter bar) -->
            <RowDefinition Height="*"/>
            <!-- Virtualized list fills rest -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             STICKY HEADER — page title, KPIs, loading/error, filter bar
        ═══════════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,16,24,0">

            <!-- ── PAGE HEADER ────────────────────────────────────────── -->
            <StackPanel Margin="8,0,8,20">
                <TextBlock Text="Job Orders"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <TextBlock Text="Track production status of approved invoices"
                           FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>

            <!-- ── LOADING / ERROR ────────────────────────────────────── -->
            <Border Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="12" Margin="8,0,8,12">
                <TextBlock Text="⏳  Loading job orders…" FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16" Margin="8,0,8,12">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#B91C1C"
                           FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- ── KPI CARDS (2 hero + 2 tinted) ──────────────────────── -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Job Orders — Indigo hero (brand-aligned) -->
                <hero:GradientHeroCard Grid.Column="0"
                                       Icon="📋"
                                       Value="{Binding TotalCount}"
                                       Label="Total Job Orders"
                                       GradientStartColor="#4338CA"
                                       GradientEndColor="#6366F1"
                                       Margin="8"
                                       MinHeight="130"/>

                <!-- In Production — Blue hero -->
                <hero:GradientHeroCard Grid.Column="1"
                                       Icon="🔨"
                                       Value="{Binding InProductionCount}"
                                       Label="In Production"
                                       GradientStartColor="#1E40AF"
                                       GradientEndColor="#3B82F6"
                                       Margin="8"
                                       MinHeight="130"/>

                <!-- Completed — Green tinted -->
                <Border Grid.Column="2"
                        Background="{DynamicResource TintGreenBrush}"
                        CornerRadius="12" Padding="20" Margin="8"
                        SnapsToDevicePixels="True">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="#047857"
                                HorizontalAlignment="Left">
                            <TextBlock Text="✅" FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding CompletedCount}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="Completed"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Overdue — Red tinted (alert) -->
                <Border Grid.Column="3"
                        CornerRadius="12" Padding="20" Margin="8"
                        SnapsToDevicePixels="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource TintRedBrush}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OverdueCount}" Value="0">
                                    <Setter Property="Background" Value="{DynamicResource TintGrayBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10"
                                HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#B91C1C"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverdueCount}" Value="0">
                                            <Setter Property="Background" Value="{DynamicResource NeutralBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="⚠️" FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding OverdueCount}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="Overdue"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── FILTER BAR ─────────────────────────────────────────── -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,12"
                    Margin="8,0,8,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12"
                             Padding="10,8"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center"/>

                    <!-- Status filter -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              FontSize="12"
                              Margin="0,0,8,0"
                              VerticalContentAlignment="Center"/>

                    <!-- Priority filter -->
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding PriorityFilterOptions}"
                              SelectedItem="{Binding SelectedPriorityFilter}"
                              FontSize="12"
                              Margin="0,0,8,0"
                              VerticalContentAlignment="Center"/>

                    <!-- Sort -->
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}"
                              FontSize="12"
                              Margin="0,0,8,0"
                              VerticalContentAlignment="Center"/>

                    <!-- Clear -->
                    <Button Grid.Column="4"
                            Content="Clear"
                            Command="{Binding ClearFiltersCommand}"
                            FontSize="11" FontWeight="SemiBold"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            Background="{DynamicResource MenuHoverBrush}"
                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                            BorderThickness="0"/>

                    <!-- Refresh -->
                    <Button Grid.Column="5"
                            Content="🔄"
                            Command="{Binding RefreshCommand}"
                            FontSize="14"
                            Padding="10,6"
                            Cursor="Hand"
                            Background="{DynamicResource MenuHoverBrush}"
                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                            BorderThickness="0"
                            ToolTip="Refresh list"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════
             VIRTUALIZED JOB ORDER LIST — Grid.Row=1, fills remaining
             Handles 10,000+ rows smoothly via UI virtualization
        ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="32,0,32,16">

            <!-- Virtualized ListBox — item recycling, smooth scroll -->
            <ListBox ItemsSource="{Binding DisplayedJobs}"
                     ItemContainerStyle="{StaticResource JobListBoxItemStyle}"
                     BorderThickness="0"
                     Background="Transparent"
                     Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.IsDeferredScrollingEnabled="False"
                     ScrollViewer.PanningMode="None"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingStackPanel.ScrollUnit="Item"
                     VirtualizingStackPanel.CacheLength="1,2"
                     VirtualizingStackPanel.CacheLengthUnit="Page"
                     behaviors:SmoothScrollBehavior.IsEnabled="True">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource JobRowCardStyle}"
                                MouseRightButtonUp="OnRowRightClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Job info -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding JobOrderId}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="🏢" FontSize="11" Margin="0,0,4,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CustomerName}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  ·  📅 " FontSize="11" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DeliveryDisplay}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <!-- Project tag -->
                                        <Border Background="{DynamicResource TintGrayBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10,3"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="{Binding ProjectName}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </Border>

                                        <!-- Source PI tag -->
                                        <Border Background="{DynamicResource TintBlueBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10,3"
                                                Margin="0,0,6,0">
                                            <TextBlock FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                <Run Text="From: "/>
                                                <Run Text="{Binding SourceProformaId, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>

                                        <!-- Overdue warning (only visible when overdue) -->
                                        <Border CornerRadius="12"
                                                Padding="10,3"
                                                Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Background" Value="#B91C1C"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding OverdueDisplay}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Grand total -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding GrandTotalDisplay}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="16,0,16,0"/>

                                <!-- Status pill -->
                                <Border Grid.Column="2"
                                        CornerRadius="10"
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        Background="{Binding StatusBrushKey,
                                                     Converter={StaticResource BrushKeyConverter}}">
                                    <TextBlock Text="{Binding StatusLabel}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>

                                <!-- Priority pill -->
                                <Border Grid.Column="3"
                                        CornerRadius="10"
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"
                                        Background="{Binding PriorityBrushKey,
                                                     Converter={StaticResource BrushKeyConverter}}">
                                    <TextBlock Text="{Binding PriorityLabel}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>

                                <!-- Open button -->
                                <Button Grid.Column="4"
                                        Style="{StaticResource OpenButtonStyle}"
                                        Command="{Binding DataContext.OpenJobOrderCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ── EMPTY STATE (overlaid on top when list is empty) ───── -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,50"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DisplayedJobs.Count}" Value="0"/>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <emptyState:EmptyStateControl
                    Icon="📋"
                    Title="No job orders yet"
                    Message="Job orders track production for approved invoices. Convert a Proforma Invoice into a Job Order and it will appear here with its status, priority and delivery schedule."/>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>