<!-- Job Order list — industrial table chrome. Bindings / commands / OnLoaded / OnRowRightClick unchanged. -->
<UserControl x:Class="ProGlassAutomation.Views.JobOrder.SavedJobOrdersList.SavedJobOrdersListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <Style x:Key="JobListBoxItemStyle" TargetType="ListBoxItem"
               BasedOn="{StaticResource ModuleListBoxItemStyle}"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,4,4,12">
            <Grid Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Job Orders"
                               Style="{StaticResource ModulePageTitleStyle}"/>
                    <TextBlock Text="Track production of approved invoices on the shop floor"
                               Style="{StaticResource ModulePageSubtitleStyle}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryPillButton}"
                        Command="{Binding CreateJobOrderCommand}"
                        Tag="&#xE710;"
                        Content="CREATE JOB ORDER"
                        MinWidth="190"
                        VerticalAlignment="Center"
                        ToolTip="Raise a job order from an approved Proforma Invoice"/>
            </Grid>

            <loading:LoadingStateControl
                    Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Message="Loading job orders…"
                    Margin="4,0,4,12"/>

            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource ModuleErrorBannerStyle}"
                    Margin="4,0,4,12">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ModuleListShellStyle}" Margin="4,0,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintBlueBrush}">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Total" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding TotalCount}"
                                           Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="All job orders"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintIndigoBrush}">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="In production" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding InProductionCount}"
                                           Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="On the shop floor"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintGreenBrush}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Completed" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding CompletedCount}"
                                           Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="Finished jobs"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintRedBrush}">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{DynamicResource DangerBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Overdue" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding OverdueCount}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ModuleListKpiValueStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OverdueCount}" Value="0">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource MutedForegroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Past delivery date"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource ModuleListFilterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModuleListFilterInputStyle}"
                                 Margin="0,0,8,0"
                                 ToolTip="Search job, customer, project, PI"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"
                                  Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding PriorityFilterOptions}"
                                  SelectedItem="{Binding SelectedPriorityFilter}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"
                                  Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSort}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"
                                  Margin="0,0,8,0"/>
                        <Button Grid.Column="4" Style="{StaticResource OutlinedPillButton}"
                                Tag="&#xE711;" Content="CLEAR"
                                Margin="0,0,8,0"
                                ToolTip="Clear filters"
                                Command="{Binding ClearFiltersCommand}"/>
                        <Button Grid.Column="5" Style="{StaticResource PrimaryPillButton}"
                                Tag="&#xE72C;" Content="REFRESH"
                                ToolTip="Refresh list"
                                Command="{Binding RefreshCommand}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource ModuleListTableHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="JOB ORDER" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="2" Text="CUSTOMER" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="3" Text="DELIVERY" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="4" Text="PROJECT" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="5" Text="VALUE (AED)" Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="6" Text="STATUS" Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="PRIORITY" Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <ListBox ItemsSource="{Binding DisplayedJobs}"
                             ItemContainerStyle="{StaticResource JobListBoxItemStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.IsDeferredScrollingEnabled="False"
                             ScrollViewer.PanningMode="None"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             VirtualizingStackPanel.ScrollUnit="Pixel"
                             VirtualizingStackPanel.CacheLength="200,400"
                             VirtualizingStackPanel.CacheLengthUnit="Pixel"
                             behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModuleListRowStyle}"
                                        MouseRightButtonUp="OnRowRightClick"
                                        MinHeight="56">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="{Binding PriorityBrushKey,
                                                             Converter={StaticResource BrushKeyConverter}}"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,8,8,8">
                                            <TextBlock Text="{Binding JobOrderId}"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="{DynamicResource TintGrayBrush}"
                                                        BorderBrush="{DynamicResource OutlineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Padding="8,2"
                                                        Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding ProjectName}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="140"/>
                                                </Border>
                                                <Border Background="{DynamicResource TintBlueBrush}"
                                                        BorderBrush="{DynamicResource OutlineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Padding="8,2"
                                                        Margin="0,0,6,0">
                                                    <TextBlock FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}">
                                                        <Run Text="From "/><Run Text="{Binding SourceProformaId, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Padding="8,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Background" Value="{DynamicResource TintRedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding OverdueDisplay}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding CustomerName}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0"
                                                   ToolTip="{Binding CustomerName}"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding DeliveryDisplay}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding ProjectName}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0"
                                                   ToolTip="{Binding ProjectName}"/>

                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding GrandTotalDisplay}"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,12,0"/>

                                        <!-- Column 6: STATUS — production status chip (e.g.
                                             "Released to factory") above the delivery-status chip. -->
                                        <StackPanel Grid.Column="6"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <Border CornerRadius="6"
                                                    Padding="8,2"
                                                    HorizontalAlignment="Center"
                                                    Background="{Binding StatusBrushKey,
                                                                 Converter={StaticResource BrushKeyConverter}}"
                                                    ToolTip="Production status">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           FontSize="9" FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>
                                            <Border Margin="0,2,0,0"
                                                    CornerRadius="6"
                                                    Padding="8,2"
                                                    HorizontalAlignment="Center"
                                                    Background="{Binding DisplayStatusBrushKey,
                                                                 Converter={StaticResource BrushKeyConverter}}"
                                                    ToolTip="Delivery status">
                                                <TextBlock Text="{Binding DisplayStatus}"
                                                           FontSize="9" FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>
                                        </StackPanel>

                                        <Border Grid.Column="7"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="10,4"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Background="{Binding PriorityBrushKey,
                                                             Converter={StaticResource BrushKeyConverter}}">
                                            <TextBlock Text="{Binding PriorityLabel}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>

                                        <StackPanel Grid.Column="8"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource RowPrimaryButton}"
                                                    Tag="&#xE8E5;" Content="OPEN"
                                                    ToolTip="Open this job order"
                                                    Command="{Binding DataContext.OpenJobOrderCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource RowOutlinedButton}"
                                                    Tag="&#xE81C;" Content="HISTORY"
                                                    Margin="6,0,0,0"
                                                    ToolTip="Version history"
                                                    Command="{Binding DataContext.ShowVersionsCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DisplayedJobs.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsLoading}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <emptyState:EmptyStateControl
                            Icon="&#xE8C8;"
                            Title="No job orders yet"
                            Message="Job orders track production for approved invoices. Convert a Proforma Invoice into a Job Order and it will appear here with its status, priority and delivery schedule."/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
