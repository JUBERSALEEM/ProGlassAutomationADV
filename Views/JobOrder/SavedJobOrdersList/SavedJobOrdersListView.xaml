<!-- MIGRATION LOG — Button Standardization batch 4b (2026-08-15)
     • Grey oval ModuleTabStripStyle container removed from shells —
       pills now sit directly on the page (reference look)
     • JO saved list: CLEAR/REFRESH -> Row pills; row OPEN/HISTORY ->
       RowPrimary/RowOutlined; OpenButtonStyle/HistoryButtonStyle removed
     • God Views: header Refresh -> PrimaryPillButton; row Open ->
       RowPrimaryButton; hero/empty icon slots -> MDL2 glyphs
     Commands/bindings/code-behind preserved; no VM changes.
═══════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.JobOrder.SavedJobOrdersList.SavedJobOrdersListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnLoaded">

    <UserControl.Resources>

        <!-- Row card — priority colored left accent bar via brush key -->
        <Style x:Key="JobRowCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{Binding PriorityBrushKey,
                            Converter={StaticResource BrushKeyConverter}}"/>
            <Setter Property="BorderThickness" Value="4,1,1,1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="16,14"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Open button accent pill -->

        <!-- v2 §24: version history button -->

        <!-- ListBoxItem container style — removes default selection padding/highlight,
             lets our JobRowCardStyle be the full row.  -->
        <Style x:Key="JobListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT LAYOUT — Sticky header on top, virtualized list below
    ═══════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Sticky header (KPIs + filter bar) -->
            <RowDefinition Height="*"/>
            <!-- Virtualized list fills rest -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             STICKY HEADER — page title, KPIs, loading/error, filter bar
        ═══════════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,16,24,0">

            <!-- ── PAGE HEADER ────────────────────────────────────────── -->
            <StackPanel Margin="8,0,8,20">
                <TextBlock Text="Job Orders"
                           Style="{StaticResource ModulePageTitleStyle}"/>
                <TextBlock Text="Track production status of approved invoices"
                           Style="{StaticResource ModulePageSubtitleStyle}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ── LOADING / ERROR ────────────────────────────────────── -->
            <Border Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="12" Margin="8,0,8,12">
                <TextBlock Text="⏳  Loading job orders…" FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16" Margin="8,0,8,12">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- ── ACTION BAR + COMPACT STATS ─────────────────────────
                 Was four cards at MinHeight 130 plus 8px margins - about
                 150px of vertical space, above the fold, to show four
                 numbers. On a 768px-tall laptop that pushed the actual job
                 list almost entirely off screen.

                 Same four numbers now sit in a single 1-line strip beside
                 the primary action, which is also where CREATE JOB ORDER
                 lives - the module previously had no way to create one at
                 all. Roughly 60px instead of 150px.
            -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="16,12"
                    Margin="8,0,8,12"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- primary action -->
                    <Button Grid.Column="0"
                            Style="{StaticResource PrimaryPillButton}"
                            Command="{Binding CreateJobOrderCommand}"
                            Tag="&#xE710;"
                            Content="CREATE JOB ORDER"
                            MinWidth="190"
                            ToolTip="Raise a job order from an approved Proforma Invoice"/>

                    <!-- compact stat strip -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">

                        <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                            <TextBlock Text="{Binding TotalCount}"
                                       FontSize="20" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Total"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="7,2,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                            <TextBlock Text="{Binding InProductionCount}"
                                       FontSize="20" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="In production"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="7,2,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                            <TextBlock Text="{Binding CompletedCount}"
                                       FontSize="20" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text="Completed"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="7,2,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>

                        <!-- Overdue greys out at zero: a red 0 reads as an
                             alert that is not actually firing. -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding OverdueCount}"
                                       FontSize="20" FontWeight="Bold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverdueCount}" Value="0">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource MutedForegroundBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Overdue"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="7,2,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── FILTER BAR ─────────────────────────────────────────── -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="16,12"
                    Margin="8,0,8,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12"
                             Padding="10,8"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center"/>

                    <!-- Status filter -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              FontSize="12"
                              Margin="0,0,8,0"
                              VerticalContentAlignment="Center"/>

                    <!-- Priority filter -->
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding PriorityFilterOptions}"
                              SelectedItem="{Binding SelectedPriorityFilter}"
                              FontSize="12"
                              Margin="0,0,8,0"
                              VerticalContentAlignment="Center"/>

                    <!-- Sort -->
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}"
                              FontSize="12"
                              Margin="0,0,8,0"
                              VerticalContentAlignment="Center"/>

                    <!-- Clear -->
                    <Button Grid.Column="4" Style="{StaticResource RowOutlinedButton}"
                            Tag="&#xE711;" Content="CLEAR"
                            Margin="0,0,8,0"
                            ToolTip="Clear filters"
                            Command="{Binding ClearFiltersCommand}"/>

                    <!-- Refresh -->
                    <Button Grid.Column="5" Style="{StaticResource RowPrimaryButton}"
                            Tag="&#xE72C;" Content="REFRESH"
                            ToolTip="Refresh list"
                            Command="{Binding RefreshCommand}"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════
             VIRTUALIZED JOB ORDER LIST — Grid.Row=1, fills remaining
             Handles 10,000+ rows smoothly via UI virtualization
        ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="32,0,32,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── COLUMN HEADERS (v2 — always visible, even when the
                 list is empty, so users know what each column means) ── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource MenuHoverBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="10,10,0,0"
                    Padding="18,9"
                    Margin="0,0,0,0"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="JOB ORDER  •  CUSTOMER  •  DELIVERY  •  PROJECT"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="VALUE (AED)"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,18,0"/>
                    <TextBlock Grid.Column="2" Text="STATUS"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="PRIORITY"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="ACTION"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Virtualized ListBox — item recycling, smooth scroll -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding DisplayedJobs}"
                     ItemContainerStyle="{StaticResource JobListBoxItemStyle}"
                     BorderThickness="0"
                     Background="Transparent"
                     Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.IsDeferredScrollingEnabled="False"
                     ScrollViewer.PanningMode="None"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingStackPanel.ScrollUnit="Item"
                     VirtualizingStackPanel.CacheLength="1,2"
                     VirtualizingStackPanel.CacheLengthUnit="Page"
                     behaviors:SmoothScrollBehavior.IsEnabled="True">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource JobRowCardStyle}"
                                MouseRightButtonUp="OnRowRightClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Job info -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding JobOrderId}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="&#xE822;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CustomerName}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock FontSize="11" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   VerticalAlignment="Center"><Run Text="  ·  "/><Run Text="&#xE787;" FontFamily="Segoe MDL2 Assets"/><Run Text=" "/></TextBlock>
                                        <TextBlock Text="{Binding DeliveryDisplay}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <!-- Project tag -->
                                        <Border Background="{DynamicResource TintGrayBrush}"
                                                BorderBrush="{DynamicResource OutlineBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="12"
                                                Padding="10,3"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="{Binding ProjectName}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </Border>

                                        <!-- Source PI tag -->
                                        <Border Background="{DynamicResource TintBlueBrush}"
                                                BorderBrush="{DynamicResource OutlineBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="12"
                                                Padding="10,3"
                                                Margin="0,0,6,0">
                                            <TextBlock FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                <Run Text="From: "/>
                                                <Run Text="{Binding SourceProformaId, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>

                                        <!-- Overdue warning (only visible when overdue) -->
                                        <Border CornerRadius="12"
                                                Padding="10,3"
                                                Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Background" Value="#B91C1C"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding OverdueDisplay}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Grand total -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding GrandTotalDisplay}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="16,0,16,0"/>

                                <!-- Status pill -->
                                <Border Grid.Column="2"
                                        CornerRadius="10"
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        Background="{Binding DisplayStatusBrushKey,
                                                     Converter={StaticResource BrushKeyConverter}}">
                                    <TextBlock Text="{Binding DisplayStatus}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>

                                <!-- Priority pill -->
                                <Border Grid.Column="3"
                                        CornerRadius="10"
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"
                                        Background="{Binding PriorityBrushKey,
                                                     Converter={StaticResource BrushKeyConverter}}">
                                    <TextBlock Text="{Binding PriorityLabel}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>

                                <!-- Open + version history -->
                                <StackPanel Grid.Column="4"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource RowPrimaryButton}"
                                            Tag="&#xE8E5;" Content="OPEN"
                                            ToolTip="Open this job order"
                                            Command="{Binding DataContext.OpenJobOrderCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource RowOutlinedButton}"
                                            Tag="&#xE81C;" Content="HISTORY"
                                            Margin="6,0,0,0"
                                            ToolTip="Version history"
                                            Command="{Binding DataContext.ShowVersionsCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ── EMPTY STATE (overlaid on top when list is empty) ───── -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,50"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DisplayedJobs.Count}" Value="0"/>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <emptyState:EmptyStateControl
                    Icon="&#xE8C8;"
                    Title="No job orders yet"
                    Message="Job orders track production for approved invoices. Convert a Proforma Invoice into a Job Order and it will appear here with its status, priority and delivery schedule."/>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>