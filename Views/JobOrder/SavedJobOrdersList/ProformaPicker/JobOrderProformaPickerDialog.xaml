<Window x:Class="ProGlassAutomation.Views.JobOrder.SavedJobOrdersList.ProformaPicker.JobOrderProformaPickerDialog"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource JobOrder.CreateJOBOrder}"
        Width="820" Height="660"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Background="{DynamicResource DialogSurfaceBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}"
            Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0"
                              Opacity="0.22" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── HEADER ──────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="16,16,0,0"
                    Padding="28,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource JobOrder.CreateJOBOrder}"
                                   FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource JobOrder.ApprovedProformaInvoicesGoProduction}"
                                   FontSize="{StaticResource TextBody}" Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   Opacity="0.85" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource RowOutlinedButton}"
                            Tag="&#xE711;" MinWidth="40"
                            IsCancel="True"
                            ToolTip="{DynamicResource DeliveryNote.CloseEsc}"/>
                </Grid>
            </Border>

            <!-- ── SEARCH ──────────────────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="28,20,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Height="38"
                         VerticalContentAlignment="Center"
                         Padding="12,0"
                         FontSize="{StaticResource TextBodyLarge}"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         Background="{DynamicResource ModuleBackgroundBrush}"
                         Foreground="{DynamicResource PrimaryForegroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         ToolTip="{DynamicResource JobOrder.SearchPINumberCustomerProject}"/>

                <!-- Off by default: production should normally only start
                     from an approved quote. The toggle exists because the
                     status vocabulary (Draft/Sent/Approved/Rejected/Expired)
                     is set by hand, so a real approval can lag the paperwork. -->
                <CheckBox Grid.Column="1"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center"
                          Content="{DynamicResource JobOrder.ShowStatuses}"
                          FontSize="{StaticResource TextBody}"
                          Foreground="{DynamicResource SecondaryForegroundBrush}"
                          IsChecked="{Binding ShowAll, Mode=TwoWay}"
                          ToolTip="{DynamicResource JobOrder.IncludeDraftSentRejectedExpiredQuotes}"/>
            </Grid>

            <!-- ── COUNT LINE ──────────────────────────────────────────── -->
            <TextBlock Grid.Row="2"
                       Margin="28,12,28,0"
                       FontSize="{StaticResource TextBody}"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       Text="{Binding CountText}"/>

            <!-- ── LIST ────────────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="3"
                          Margin="28,12,28,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PiList"/>
            </ScrollViewer>

            <!-- ── APPROVAL WARNING ────────────────────────────────────── -->
            <Border Grid.Row="4"
                    Margin="28,16,28,0"
                    Padding="14,12"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Visibility="{Binding WarningVisibility}"
                    Background="{DynamicResource TintAmberBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextTitle}"
                               VerticalAlignment="Top"
                               Margin="0,1,10,0"
                               Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock FontSize="{StaticResource TextBody}"
                               Text="{Binding WarningText}"
                               TextWrapping="Wrap"
                               MaxWidth="580"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </StackPanel>
            </Border>

            <!-- ── FOOTER ──────────────────────────────────────────────── -->
            <Border Grid.Row="5"
                    Margin="0,16,0,0"
                    Padding="28,16"
                    CornerRadius="0,0,16,16"
                    Background="{DynamicResource DialogInsetBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding SelectedLabelText}"
                               FontSize="{StaticResource TextBody}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource RowOutlinedButton}"
                                Content="{DynamicResource Action.Cancel}"
                                MinWidth="96"
                                Margin="0,0,10,0"
                                IsCancel="True"/>
                        <Button Style="{StaticResource PrimaryPillButton}"
                                Tag="&#xE7B8;"
                                Content="{DynamicResource JobOrder.CreateJOBOrder}"
                                MinWidth="180"
                                IsEnabled="{Binding IsConfirmEnabled}"
                                Command="{Binding ConfirmCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
