<Window x:Class="ProGlassAutomation.Views.JobOrder.SavedJobOrdersList.ProformaPicker.JobOrderProformaPickerDialog"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Job Order"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border CornerRadius="{DynamicResource CardCornerRadius}"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0"
                              Opacity="0.22" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── HEADER ──────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="12,12,0,0"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Create Job Order"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Text="Only approved Proforma Invoices can go to production"
                                   FontSize="11" Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   Opacity="0.85" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource RowOutlinedButton}"
                            Tag="&#xE711;" MinWidth="40"
                            Click="OnCancelClick"
                            ToolTip="Close (Esc)"/>
                </Grid>
            </Border>

            <!-- ── SEARCH ──────────────────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="24,18,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Height="38"
                         VerticalContentAlignment="Center"
                         Padding="12,0"
                         FontSize="13"
                         TextChanged="OnSearchChanged"
                         Background="{DynamicResource ModuleBackgroundBrush}"
                         Foreground="{DynamicResource PrimaryForegroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         ToolTip="Search by PI number, customer or project"/>

                <!-- Off by default: production should normally only start
                     from an approved quote. The toggle exists because the
                     status vocabulary (Draft/Sent/Approved/Rejected/Expired)
                     is set by hand, so a real approval can lag the paperwork. -->
                <CheckBox x:Name="ShowAllCheck"
                          Grid.Column="1"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center"
                          Content="Show all statuses"
                          FontSize="12"
                          Foreground="{DynamicResource SecondaryForegroundBrush}"
                          Checked="OnShowAllChanged"
                          Unchecked="OnShowAllChanged"
                          ToolTip="Include Draft, Sent, Rejected and Expired quotes"/>
            </Grid>

            <!-- ── COUNT LINE ──────────────────────────────────────────── -->
            <TextBlock x:Name="CountLabel"
                       Grid.Row="2"
                       Margin="24,10,24,0"
                       FontSize="11"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       Text=""/>

            <!-- ── LIST ────────────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="3"
                          Margin="24,10,24,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PiList"/>
            </ScrollViewer>

            <!-- ── APPROVAL WARNING ────────────────────────────────────── -->
            <Border x:Name="ApprovalWarning"
                    Grid.Row="4"
                    Margin="24,14,24,0"
                    Padding="14,12"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Visibility="Collapsed"
                    Background="{DynamicResource TintAmberBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               VerticalAlignment="Top"
                               Margin="0,1,10,0"
                               Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock x:Name="ApprovalWarningText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               MaxWidth="580"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </StackPanel>
            </Border>

            <!-- ── FOOTER ──────────────────────────────────────────────── -->
            <Border Grid.Row="5"
                    Margin="0,16,0,0"
                    Padding="24,14"
                    CornerRadius="0,0,12,12"
                    Background="{DynamicResource MenuHoverBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SelectedLabel"
                               Grid.Column="0"
                               Text="No selection"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource RowOutlinedButton}"
                                Content="CANCEL"
                                MinWidth="96"
                                Margin="0,0,10,0"
                                Click="OnCancelClick"/>
                        <Button x:Name="ConfirmButton"
                                Style="{StaticResource PrimaryPillButton}"
                                Tag="&#xE7B8;"
                                Content="CREATE JOB ORDER"
                                MinWidth="180"
                                IsEnabled="False"
                                Click="OnConfirmClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
