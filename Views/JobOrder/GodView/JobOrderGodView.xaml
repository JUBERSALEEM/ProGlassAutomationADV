<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/JobOrder/GodView/JobOrderGodView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Job Order — God View (Studio Bento Edition)

     Full-system overview: Studio Bento KPI tiles + searchable DataGrid
     of every job order. Double-click or Open button hands off to detail view.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.JobOrder.GodView.JobOrderGodView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource Ov.Canvas}"
             Foreground="{DynamicResource Ov.Ink}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Shared/Lists/StudioListResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16,10,16,16">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1"
                                         Duration="{DynamicResource MotionDurationNorm}"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER (Action Bar) ═════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <Border Grid.Column="0"
                    Style="{StaticResource Sl.Card}"
                    Padding="12,0"
                    MaxWidth="420"
                    HorizontalAlignment="Left"
                    MinHeight="36"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource Ov.Muted}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource Ov.Ink}"
                             CaretBrush="{DynamicResource Ov.Accent}"
                             FontSize="{DynamicResource FontSize.Body}"
                             VerticalAlignment="Center"
                             ToolTip="{DynamicResource God.JoSearch}"/>
                </Grid>
            </Border>

            <!-- Refresh Button -->
            <Button Grid.Column="1"
                    Style="{StaticResource Sl.PrimaryButton}"
                    Tag="&#xE72C;" Content="{DynamicResource God.Refresh}"
                    ToolTip="{DynamicResource God.RefreshOverview}"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <!-- ══ KPI BENTO TILES ════════════════════════════════════════ -->
        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Kpis}"
                      Margin="0,0,0,14">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Sl.Card}"
                            MinWidth="195"
                            Padding="16,14"
                            Margin="0,0,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="40" Height="40"
                                    CornerRadius="10"
                                    Background="{DynamicResource Ov.Soft}"
                                    BorderBrush="{DynamicResource Ov.Line}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Icon}"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Value}"
                                           FontSize="22" FontWeight="Bold"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{Binding ValueBrushKey, Converter={StaticResource Sl.StatusBrush}, ConverterParameter=ink}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Label}"
                                           Style="{StaticResource Sl.Subtitle}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ══ FULL TABLE ═════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Style="{StaticResource Sl.Shell}"
                CornerRadius="14"
                Padding="0"
                ClipToBounds="True">
            <Grid>
                <DataGrid Style="{StaticResource Sl.DataGrid}"
                          ColumnHeaderStyle="{StaticResource Sl.DataGridHeader}"
                          ItemsSource="{Binding Rows}"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.CacheLength="400,800"
                          VirtualizingPanel.CacheLengthUnit="Pixel"
                          ScrollViewer.CanContentScroll="False">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding OpenCommand}"
                                      CommandParameter="{Binding SelectedItem,
                                          RelativeSource={RelativeSource
                                              AncestorType=DataGrid}}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource God.JoNumber}"
                                            Binding="{Binding JobOrderId}"
                                            Width="140"
                                            ElementStyle="{StaticResource Sl.CellText}"/>
                        <DataGridTextColumn Header="{DynamicResource God.SourcePi}"
                                            Binding="{Binding SourceProformaId}"
                                            Width="130"
                                            ElementStyle="{StaticResource Sl.CellText}"/>
                        <DataGridTextColumn Header="{DynamicResource God.Customer}"
                                            Binding="{Binding CustomerName}"
                                            Width="480"
                                            ElementStyle="{StaticResource Sl.CellText}"/>
                        <DataGridTextColumn Header="{DynamicResource God.Project}"
                                            Binding="{Binding ProjectName}"
                                            Width="480"
                                            ElementStyle="{StaticResource Sl.CellText}"/>
                        <DataGridTextColumn Header="{DynamicResource God.Status}"
                                            Binding="{Binding Status}"
                                            Width="110"
                                            HeaderStyle="{StaticResource Sl.DataGridHeaderCenter}"
                                            ElementStyle="{StaticResource Sl.CellTextCenter}"/>
                        <DataGridTextColumn Header="{DynamicResource God.Priority}"
                                            Binding="{Binding Priority}"
                                            Width="85"
                                            HeaderStyle="{StaticResource Sl.DataGridHeaderCenter}"
                                            ElementStyle="{StaticResource Sl.CellTextCenter}"/>
                        <DataGridTextColumn Header="{DynamicResource God.ValueAed}"
                                            Binding="{Binding GrandTotalVatInclusive,
                                                StringFormat='N2'}"
                                            Width="120"
                                            HeaderStyle="{StaticResource Sl.DataGridHeaderRight}"
                                            ElementStyle="{StaticResource Sl.CellTextRight}"/>
                        <DataGridTextColumn Header="{DynamicResource Nav.Delivery}"
                                            Binding="{Binding DeliveryDate,
                                                StringFormat='dd MMM yyyy'}"
                                            Width="120"
                                            ElementStyle="{StaticResource Sl.CellText}"/>

                        <DataGridTemplateColumn Header="" Width="84">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{DynamicResource God.Open}"
                                            Style="{StaticResource Sl.PrimaryButton}"
                                            FontSize="12"
                                            Padding="10,3"
                                            MinHeight="28"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.OpenCommand,
                                                        RelativeSource={RelativeSource
                                                            AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty / no-search-result state -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Rows.Count}" Value="0"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="&#xE8C8;"
                        Title="{DynamicResource God.JoEmpty}"
                        Message="Every job order in the system appears in this God View — search by JO, PI, customer, project, status or priority. Job orders created from proforma invoices show up here instantly. If nothing matches, try a different search or press Refresh."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>