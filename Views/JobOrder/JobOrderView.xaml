<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/JobOrder/JobOrderView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Job Order shell

     TAB STRIP UPGRADE:
       [ Workspace ]   [ God View ]   [ Activity ]
       • Workspace — the original list ↔ detail flow (preserved 1:1)
       • God View  — all-records overview (JobOrderGodView)
       • Activity  — live per-section audit feed
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.JobOrder.JobOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:list="clr-namespace:ProGlassAutomation.Views.JobOrder.SavedJobOrdersList"
             xmlns:detail="clr-namespace:ProGlassAutomation.Views.JobOrder.JobOrderDetail"
             xmlns:godview="clr-namespace:ProGlassAutomation.Views.JobOrder.GodView"
             xmlns:sharedViews="clr-namespace:ProGlassAutomation.Views.Shared"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ TAB STRIP ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Style="{StaticResource ModuleTabStripStyle}"
                Margin="20,14,20,0">
            <StackPanel Orientation="Horizontal">

                <Button Style="{StaticResource ModuleTabButtonStyle}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Workspace">
                    <TextBlock Text="🗂  Workspace">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorkspaceTab}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <Button Style="{StaticResource ModuleTabButtonStyle}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="GodView">
                    <TextBlock Text="🌐  God View">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGodViewTab}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <Button Style="{StaticResource ModuleTabButtonStyle}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Activity">
                    <TextBlock Text="📜  Activity">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActivityTab}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══ TAB CONTENT ════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- ═══ WORKSPACE (original list ↔ detail, preserved) ═══ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWorkspaceTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- LIST VIEW — shown when IsListView = True -->
                <ContentControl Content="{Binding ListVM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <list:SavedJobOrdersListView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- DETAIL VIEW — shown when IsDetailView = True -->
                <ContentControl Content="{Binding DetailVM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDetailView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <detail:JobOrderDetailView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>

            <!-- ═══ GOD VIEW TAB ═══ -->
            <godview:JobOrderGodView DataContext="{Binding GodViewVM}">
                <godview:JobOrderGodView.Style>
                    <Style TargetType="godview:JobOrderGodView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsGodViewTab,
                                                     RelativeSource={RelativeSource
                                                         AncestorType=UserControl}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </godview:JobOrderGodView.Style>
            </godview:JobOrderGodView>

            <!-- ═══ ACTIVITY TAB (live per-section audit feed) ═══ -->
            <sharedViews:SectionActivityView DataContext="{Binding ActivityVM}">
                <sharedViews:SectionActivityView.Style>
                    <Style TargetType="sharedViews:SectionActivityView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsActivityTab,
                                                     RelativeSource={RelativeSource
                                                         AncestorType=UserControl}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </sharedViews:SectionActivityView.Style>
            </sharedViews:SectionActivityView>
        </Grid>
    </Grid>
</UserControl>
