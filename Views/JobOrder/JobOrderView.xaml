<UserControl x:Class="ProGlassAutomation.Views.JobOrder.JobOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:list="clr-namespace:ProGlassAutomation.Views.JobOrder.SavedJobOrdersList"
             xmlns:detail="clr-namespace:ProGlassAutomation.Views.JobOrder.JobOrderDetail"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">

        <!-- ═══════════════════════════════════════════════════════════
             LIST VIEW — shown when IsListView = True
        ═══════════════════════════════════════════════════════════ -->
        <ContentControl Content="{Binding ListVM}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <list:SavedJobOrdersListView/>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- ═══════════════════════════════════════════════════════════
             DETAIL VIEW — shown when IsDetailView = True
        ═══════════════════════════════════════════════════════════ -->
        <ContentControl Content="{Binding DetailVM}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetailView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <detail:JobOrderDetailView/>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

    </Grid>
</UserControl>