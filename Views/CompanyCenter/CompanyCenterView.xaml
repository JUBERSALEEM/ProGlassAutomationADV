<!-- Company Center — Studio Bento fresh UI, same visual contract as the
     Proforma Invoice list (SavedInvoicesListView): Sl.* hero band,
     cards, inputs and buttons. All company list, editor, logo-studio
     and save bindings retained. No private card styles. -->
<UserControl x:Class="ProGlassAutomation.Views.CompanyCenter.CompanyCenterView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ProGlassAutomation.Views.Shared"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource Ov.Canvas}"
             Foreground="{DynamicResource Ov.Ink}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Shared/Lists/StudioListResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Background="Transparent"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="20,16,20,24">

            <!-- ═══ HERO BAND ═══ -->
            <Border Style="{StaticResource Sl.Hero}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Module.CompanyCenter}"
                                   Style="{StaticResource Sl.Label}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Ov.OnAccent}"/>
                        <TextBlock Text="{DynamicResource CompanyCenter.CompaniesIdentityTRNBankingLogoDefault}"
                                   Style="{StaticResource Sl.Subtitle}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Ov.OnAccentMuted}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Sl.Button}"
                                Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                                Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                                Background="{DynamicResource Ov.Surface}"/>
                        <Button Style="{StaticResource Sl.Button}"
                                Background="{DynamicResource Ov.Surface}"
                                Foreground="{DynamicResource Ov.Accent}"
                                BorderBrush="{DynamicResource Ov.Surface}"
                                Tag="&#xE710;" Content="{DynamicResource CompanyCenter.NEWCompany}"
                                Command="{Binding NewCompanyCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ TWO-COLUMN STAGE ═══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── LEFT: SAVED COMPANY PROFILES ── -->
                <Border Grid.Column="0" Style="{StaticResource Sl.Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="{DynamicResource Radius.Medium}"
                                    Background="{DynamicResource Ov.Soft}" Margin="0,0,10,0">
                                <TextBlock Text="&#xE821;" FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Ov.Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Module.CompanyCenter}" Style="{StaticResource Sl.Label}"/>
                                <TextBlock Text="{DynamicResource CompanyCenter.ClickToLoadCompany}"
                                           Style="{StaticResource Sl.Subtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource Ov.Soft}"
                                    CornerRadius="{DynamicResource Radius.Small}" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Companies.Count, StringFormat='{}{0} Total'}"
                                           FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource Ov.Accent}"
                                           Typography.NumeralAlignment="Tabular"/>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Companies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="14,12"
                                            CornerRadius="{DynamicResource Radius.Medium}" Cursor="Hand"
                                            BorderBrush="{DynamicResource Ov.Line}"
                                            BorderThickness="1"
                                            Background="{DynamicResource Ov.Surface}"
                                            ToolTip="{DynamicResource CompanyCenter.ClickToLoadCompany}"
                                            Focusable="True"
                                            AutomationProperties.Name="{Binding CompanyName}"
                                            AutomationProperties.HelpText="Load saved company into editor"
                                            SnapsToDevicePixels="True">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectCompanyCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                            <KeyBinding Key="Return"
                                                        Command="{Binding DataContext.SelectCompanyCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Ov.Line}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
                                                        <Setter Property="Background" Value="{DynamicResource Ov.Soft}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CompanyName}"
                                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource Ov.Ink}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CompanyName}"/>
                                                <TextBlock FontSize="{DynamicResource FontSize.BodySmall}" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource Ov.Muted}">
                                                    <Run Text="TRN: "/>
                                                    <Run Text="{Binding CompanyTrn, Mode=OneWay}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Quick actions -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Sl.Button}" MinHeight="30" Padding="10,4"
                                                        Tag="&#xE8E5;" Content="{DynamicResource Action.Edit}"
                                                        Command="{Binding DataContext.SelectCompanyCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Margin="0,0,6,0"/>
                                                <Button Style="{StaticResource Sl.DangerButton}" MinHeight="30" Width="32" Padding="0"
                                                        Tag="&#xE74D;" Content=""
                                                        Command="{Binding DataContext.DeleteCompanyCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>

                                            <!-- Chips strip -->
                                            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="8,5"
                                                    Background="{DynamicResource Ov.Soft}"
                                                    CornerRadius="{DynamicResource Radius.Small}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource Ov.SuccessSoft}" CornerRadius="{DynamicResource Radius.Small}" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="Verified TRN" FontSize="{DynamicResource FontSize.Caption}" FontWeight="Bold" Foreground="{DynamicResource Ov.Success}"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource Ov.Surface}" CornerRadius="{DynamicResource Radius.Small}" Padding="6,2">
                                                            <TextBlock FontSize="{DynamicResource FontSize.Caption}" FontWeight="Bold" Foreground="{DynamicResource Ov.Accent}">
                                                                <Run Text="{Binding UsageCount, Mode=OneWay}"/><Run Text=" Invoices"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="{DynamicResource FontSize.Caption}"
                                                               FontWeight="{DynamicResource Weight.SemiBold}"
                                                               Foreground="{DynamicResource Ov.Muted}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── RIGHT: PROFILE EDITOR STACK ── -->
                <StackPanel Grid.Column="2">

                    <!-- Live letterhead masthead preview -->
                    <Border Style="{StaticResource Sl.Card}" Background="{DynamicResource Ov.Soft}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="64" Height="64"
                                    Background="{DynamicResource Ov.Surface}"
                                    BorderBrush="{DynamicResource Ov.Line}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Medium}"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding LogoPath}" Stretch="Uniform" Margin="6"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CompanyName}"
                                           FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource Ov.Ink}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Margin="0,3,0,0" FontSize="{DynamicResource FontSize.Body}"
                                           Foreground="{DynamicResource Ov.Muted}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding CompanyTrn, Mode=OneWay}"/>
                                    <Run Text="  ·  "/>
                                    <Run Text="{Binding CompanyLocation, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSize.BodySmall}"
                                           FontWeight="{DynamicResource Weight.SemiBold}"
                                           Foreground="{DynamicResource Ov.Accent}">
                                    <Run Text="LETTERHEAD  ·  "/>
                                    <Run Text="{Binding EditorTitle, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="2" Background="{DynamicResource Ov.Surface}"
                                    CornerRadius="{DynamicResource Radius.Small}" Padding="10,6"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding LogoLayoutLabel}"
                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                           FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource Ov.Accent}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Corporate identity & tax registration -->
                    <Border Style="{StaticResource Sl.Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="{DynamicResource Radius.Medium}"
                                        Background="{DynamicResource Ov.Soft}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE821;" FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Ov.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource CompanyCenter.CompanyNAME}" Style="{StaticResource Sl.Label}"/>
                                    <TextBlock Text="{DynamicResource CompanyCenter.CompaniesIdentityTRNBankingLogoDefault}"
                                               Style="{StaticResource Sl.Subtitle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="{DynamicResource CompanyCenter.CompanyNAME}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>

                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource CompanyCenter.TRN}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding CompanyTrn, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource CompanyCenter.Location}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding CompanyLocation, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>

                                <CheckBox Grid.Row="4" Grid.ColumnSpan="3"
                                          IsChecked="{Binding IsDefaultCompany, Mode=TwoWay}"
                                          Content="{DynamicResource CompanyCenter.DefaultCompanyPreFillsNewInvoices}"
                                          FontWeight="{DynamicResource Weight.SemiBold}"
                                          Foreground="{DynamicResource Ov.Ink}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Representative & settlement banking -->
                    <Border Style="{StaticResource Sl.Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="{DynamicResource Radius.Medium}"
                                        Background="{DynamicResource Ov.Soft}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Ov.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource CompanyCenter.Representative}" Style="{StaticResource Sl.Label}"/>
                                    <TextBlock Text="{DynamicResource CompanyCenter.BANKNAME}"
                                               Style="{StaticResource Sl.Subtitle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource CompanyCenter.Representative}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding Representative, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Phone.Label}" Style="{StaticResource Field.Label}"
                                               TextOptions.TextFormattingMode="Display"/>
                                    <shared:CountryPhoneControl
                                             PhoneText="{Binding RepresentativeMobile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="CompanyCenter.RepresentativeMobile"
                                             AutomationProperties.Name="Representative mobile"/>
                                </StackPanel>

                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource CompanyCenter.CompanyEMAIL}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource CompanyCenter.BANKNAME}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>

                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="4" Grid.ColumnSpan="3">
                                    <TextBlock Text="{DynamicResource CompanyCenter.AccountNumberIBAN}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Logo studio & letterhead formatting -->
                    <Border Style="{StaticResource Sl.Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="{DynamicResource Radius.Medium}"
                                        Background="{DynamicResource Ov.Soft}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE8F1;" FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Ov.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource CompanyCenter.ChooseLOGO}" Style="{StaticResource Sl.Label}"/>
                                    <TextBlock Text="LETTERHEAD COMPOSITION"
                                               Style="{StaticResource Sl.Subtitle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Preview tile -->
                                <Border Grid.Column="0" Width="150" Height="110"
                                        Background="{DynamicResource Ov.Soft}"
                                        BorderBrush="{DynamicResource Ov.Line}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Medium}"
                                        VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock Text="&#xE8F1;" FontFamily="{DynamicResource FontFamily.Icon}"
                                                   FontSize="{DynamicResource FontSize.H2}"
                                                   Foreground="{DynamicResource Ov.Muted}" Opacity="0.6"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding LogoPath}" Stretch="Uniform" Margin="10">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <!-- Action buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Style="{StaticResource Sl.PrimaryButton}"
                                                Tag="&#xE8B9;" Content="{DynamicResource CompanyCenter.ChooseLOGO}"
                                                Command="{Binding PickLogoCommand}"/>
                                        <Button Style="{StaticResource Sl.Button}"
                                                Tag="&#xE711;" Content="{DynamicResource Action.Clear}"
                                                Command="{Binding ClearLogoCommand}"
                                                Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <!-- Width × Height (mm) -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="WIDTH (MM)" Style="{StaticResource Field.Label}"
                                                   VerticalAlignment="Center" Margin="0"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding LogoWidthMm, Converter={StaticResource DoubleTypingConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource Input.TextBox}"
                                                 TextAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="HEIGHT (MM)" Style="{StaticResource Field.Label}"
                                                   VerticalAlignment="Center" Margin="0"/>
                                        <TextBox Grid.Column="6"
                                                 Text="{Binding LogoHeightMm, Converter={StaticResource DoubleTypingConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource Input.TextBox}"
                                                 TextAlignment="Center"/>
                                    </Grid>
                                    <TextBlock FontSize="{DynamicResource FontSize.Caption}"
                                               Foreground="{DynamicResource Ov.Muted}" Margin="0,0,0,12">
                                        <Run Text="{Binding LogoWidthDisplay, Mode=OneWay}"/>
                                        <Run Text=" × "/>
                                        <Run Text="{Binding LogoHeightDisplay, Mode=OneWay}"/>
                                    </TextBlock>

                                    <!-- Letterhead layout options -->
                                    <TextBlock Text="LETTERHEAD COMPOSITION" Style="{StaticResource Field.Label}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Text only"
                                                     GroupName="CompanyLogoLayout"
                                                     IsChecked="{Binding IsNoLogoLayout}"
                                                     Foreground="{DynamicResource Ov.Ink}"
                                                     VerticalAlignment="Center"/>
                                        <RadioButton Content="Left portrait"
                                                     GroupName="CompanyLogoLayout"
                                                     IsChecked="{Binding IsLeftPortraitLayout}"
                                                     Foreground="{DynamicResource Ov.Ink}"
                                                     Margin="16,0,0,0"
                                                     VerticalAlignment="Center"/>
                                        <RadioButton Content="Top panel"
                                                     GroupName="CompanyLogoLayout"
                                                     IsChecked="{Binding IsTopPanelLayout}"
                                                     Foreground="{DynamicResource Ov.Ink}"
                                                     Margin="16,0,0,0"
                                                     VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding LogoPath}"
                                               FontSize="{DynamicResource FontSize.Caption}" Margin="0,8,0,0"
                                               Foreground="{DynamicResource Ov.Muted}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="420"
                                               ToolTip="{Binding LogoPath}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Audit note & save action -->
                    <Border Style="{StaticResource Sl.Card}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource Field.Panel}" Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource CompanyCenter.WHYNOTEOptionalRecordedAuditTrail}"
                                           Style="{StaticResource Field.Label}"/>
                                <TextBox Text="{Binding ReasonNote, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input.TextBox}"
                                         ToolTip="{DynamicResource CompanyCenter.ReasonChangeEGTRNCorrectedAfterTradeLicence}"/>
                            </StackPanel>

                            <Button Style="{StaticResource Sl.SuccessButton}"
                                    Tag="&#xE74E;" Content="{Binding SaveButtonText}"
                                    Command="{Binding SaveCompanyCommand}"
                                    MinHeight="38" Padding="22,8"/>

                            <!-- Dynamic status -->
                            <Border CornerRadius="{DynamicResource Radius.Medium}" Background="{DynamicResource Ov.Soft}"
                                    BorderBrush="{DynamicResource Ov.Accent}" BorderThickness="1"
                                    Padding="14,10" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}"
                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                           Foreground="{DynamicResource Ov.Accent}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
