<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/CompanyCenter/CompanyCenterView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Company Center — Full Studio Bento Redesign (2026-09-23)
     Adopts Overview Dashboard aesthetic: compact bento cards, clean shapes,
     smart multi-column placement, zero oversized monolithic containers.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl Style="{StaticResource ErpPageRootStyle}"
             x:Class="ProGlassAutomation.Views.CompanyCenter.CompanyCenterView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ProGlassAutomation.Views.Shared"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource Ov.Canvas}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- Bento card container style matching Overview Dashboard aesthetic -->
        <Style x:Key="CompanyCenterCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource Border.HairlineThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Bento header icon tile style -->
        <Style x:Key="CompanyCenterIconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Background="Transparent"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="28,24,28,32">

            <!-- ═══ BENTO HERO HEADER STRIP ═══ -->
            <Border Style="{StaticResource CompanyCenterCardStyle}" Padding="16,8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource TintIndigoBrush}" VerticalAlignment="Center" Margin="0,0,16,0"
                            Visibility="Collapsed">
                        <TextBlock Text="&#xE821;" FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.H2}" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Module.CompanyCenter}"
                                   FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource CompanyCenter.CompaniesIdentityTRNBankingLogoDefault}"
                                   FontSize="{DynamicResource FontSize.Body}" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryPillButton}"
                                Tag="&#xE710;" Content="{DynamicResource CompanyCenter.NEWCompany}"
                                Command="{Binding NewCompanyCommand}" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource OutlinedPillButton}"
                                Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                                Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ TWO-COLUMN BENTO STAGE ═══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════════════════════════════════════
                     LEFT COLUMN: SAVED COMPANY PROFILES
                     ═══════════════════════════════════════════════════ -->
                <Border Grid.Column="0" Style="{StaticResource CompanyCenterCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CompanyCenterIconTileStyle}" Margin="0,0,10,0">
                                <TextBlock Text="&#xE821;" FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Saved Companies" FontSize="{DynamicResource FontSize.Title}"
                                           FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Click card to edit profile" FontSize="{DynamicResource FontSize.Caption}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource TintBlueBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Companies.Count, StringFormat='{}{0} Total'}"
                                           FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Companies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="14,12"
                                            CornerRadius="{DynamicResource Radius.Medium}" Cursor="Hand"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                                            Background="{DynamicResource SurfaceSecondaryBrush}"
                                            ToolTip="{DynamicResource CompanyCenter.ClickToLoadCompany}"
                                            Focusable="True"
                                            AutomationProperties.Name="{Binding CompanyName}"
                                            AutomationProperties.HelpText="Load saved company into editor"
                                            SnapsToDevicePixels="True">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectCompanyCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                            <KeyBinding Key="Return"
                                                            Command="{Binding DataContext.SelectCompanyCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                            <KeyBinding Key="Space"
                                                            Command="{Binding DataContext.SelectCompanyCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Executive Avatar Badge -->
                                            <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Width="40" Height="40"
                                                    CornerRadius="20" VerticalAlignment="Center" Background="{DynamicResource SurfacePrimaryBrush}">
                                                <TextBlock Text="&#xE822;" FontFamily="{DynamicResource FontFamily.Icon}"
                                                           FontSize="{DynamicResource FontSize.Title}" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Company Details -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CompanyName}" FontSize="{DynamicResource FontSize.Body}"
                                                           FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="{DynamicResource FontSize.Caption}" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextTertiaryBrush}">
                                                    <Run Text="{DynamicResource CompanyCenter.TRN}"/>
                                                    <Run Text="{Binding CompanyTrn, Mode=OneWay}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Quick Action Buttons -->
                                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource RowOutlinedButton}" Height="28" Padding="10,0"
                                                        Tag="&#xE8E5;" Content="{DynamicResource Action.Edit}"
                                                        Command="{Binding DataContext.SelectCompanyCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Margin="0,0,6,0"/>
                                                <Button Style="{StaticResource RowDangerButton}" Height="28" Width="28" Padding="0"
                                                        Tag="&#xE74D;" Content=""
                                                        Command="{Binding DataContext.DeleteCompanyCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>

                                            <!-- Status Chips Strip -->
                                            <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Padding="8,4"
                                                    Background="{DynamicResource SurfacePrimaryBrush}"
                                                    CornerRadius="{DynamicResource Radius.Small}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource TintGreenBrush}" CornerRadius="{DynamicResource Radius.Small}" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="Verified TRN" FontSize="{DynamicResource FontSize.Badge}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource TintBlueBrush}" CornerRadius="{DynamicResource Radius.Small}" Padding="6,2">
                                                            <TextBlock FontSize="{DynamicResource FontSize.Badge}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}">
                                                                <Run Text="{Binding UsageCount, Mode=OneWay}"/><Run Text=" Invoices"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="{DynamicResource FontSize.Label}" FontWeight="Medium"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════
                     RIGHT COLUMN: MODULAR BENTO PROFILE EDITOR
                     ═══════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="2">

                    <!-- ── BENTO CARD 1: LIVE LETTERHEAD MASTHEAD PREVIEW ── -->
                    <Border Style="{StaticResource CompanyCenterCardStyle}" Background="{DynamicResource TintIndigoBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Logo slot -->
                            <Border Grid.Column="0" Width="64" Height="64"
                                    Background="{DynamicResource SurfacePrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                                    CornerRadius="{DynamicResource Radius.Small}"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding LogoPath}" Stretch="Uniform" Margin="6"/>
                            </Border>

                            <!-- Header texts -->
                            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CompanyName}"
                                           FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Margin="0,3,0,0" FontSize="{DynamicResource FontSize.Body}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding CompanyTrn, Mode=OneWay}"/>
                                    <Run Text="  ·  "/>
                                    <Run Text="{Binding CompanyLocation, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource FontSize.BodySmall}"
                                           FontWeight="{DynamicResource Weight.SemiBold}"
                                           Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="LETTERHEAD  ·  "/>
                                    <Run Text="{Binding EditorTitle, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Layout pill -->
                            <Border Grid.Column="2" Background="{DynamicResource SurfacePrimaryBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10,6"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding LogoLayoutLabel}"
                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                           FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ── BENTO CARD 2: CORPORATE IDENTITY & LOCATION ── -->
                    <Border Style="{StaticResource CompanyCenterCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource CompanyCenterIconTileStyle}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE821;" FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Corporate Identity &amp; Tax Registration"
                                               FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Official trade license entity, FTA VAT tax registration, and physical address"
                                               FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Company Name -->
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="{DynamicResource CompanyCenter.CompanyNAME}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>

                                <!-- TRN & Location -->
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="TRN (Tax Registration Number)" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding CompanyTrn, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource CompanyCenter.Location}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding CompanyLocation, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>

                                <!-- Default Company Checkbox -->
                                <CheckBox Grid.Row="4" Grid.ColumnSpan="3"
                                          IsChecked="{Binding IsDefaultCompany, Mode=TwoWay}"
                                          Content="Use as default company in new proforma invoices"
                                          FontWeight="{DynamicResource Weight.SemiBold}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── BENTO CARD 3: REPRESENTATIVE & SETTLEMENT BANKING ── -->
                    <Border Style="{StaticResource CompanyCenterCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource CompanyCenterIconTileStyle}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Representative &amp; Settlement Banking"
                                               FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Signatory contact details and bank account remittance coordinates"
                                               FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Representative & Mobile -->
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource CompanyCenter.Representative}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding Representative, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Phone.Label}" Style="{StaticResource Field.Label}"
                                               TextOptions.TextFormattingMode="Display"/>
                                    <shared:CountryPhoneControl
                                             PhoneText="{Binding RepresentativeMobile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="CompanyCenter.RepresentativeMobile"
                                             AutomationProperties.Name="Representative mobile"/>
                                </StackPanel>

                                <!-- Email & Bank Name -->
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource CompanyCenter.CompanyEMAIL}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource CompanyCenter.BANKNAME}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>

                                <!-- Account Number / IBAN -->
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="4" Grid.ColumnSpan="3">
                                    <TextBlock Text="{DynamicResource CompanyCenter.AccountNumberIBAN}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── BENTO CARD 4: LOGO STUDIO & LETTERHEAD FORMATTING ── -->
                    <Border Style="{StaticResource CompanyCenterCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource CompanyCenterIconTileStyle}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE8B9;" FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Logo Studio &amp; Letterhead Formatting"
                                               FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Document branding layout, printed dimensions (mm), and high-resolution logo"
                                               FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Portrait preview box -->
                                <Border Grid.Column="0" Width="104" Height="112"
                                        Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="{DynamicResource Border.HairlineThickness}"
                                        CornerRadius="{DynamicResource Radius.Small}"
                                        VerticalAlignment="Top">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="&#xE8B9;" FontFamily="{DynamicResource FontFamily.Icon}"
                                                       FontSize="{DynamicResource FontSize.H1}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="NO LOGO" FontSize="{DynamicResource FontSize.Caption}"
                                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Image Source="{Binding LogoPath}" Stretch="Uniform" Margin="8">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <!-- Action buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Style="{StaticResource PrimaryPillButton}"
                                                Tag="&#xE8B9;" Content="{DynamicResource CompanyCenter.ChooseLOGO}"
                                                Command="{Binding PickLogoCommand}"/>
                                        <Button Style="{StaticResource RowOutlinedButton}"
                                                Tag="&#xE711;" Content="{DynamicResource Action.Clear}"
                                                Command="{Binding ClearLogoCommand}"
                                                Margin="10,0,0,0"/>
                                    </StackPanel>

                                    <!-- Width × Height (mm) -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="WIDTH (MM)" Style="{StaticResource Field.Label}"
                                                   VerticalAlignment="Center" Margin="0"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding LogoWidthMm, Converter={StaticResource DoubleTypingConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource Input.TextBox}"
                                                 TextAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="HEIGHT (MM)" Style="{StaticResource Field.Label}"
                                                   VerticalAlignment="Center" Margin="0"/>
                                        <TextBox Grid.Column="6"
                                                 Text="{Binding LogoHeightMm, Converter={StaticResource DoubleTypingConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource Input.TextBox}"
                                                 TextAlignment="Center"/>
                                    </Grid>
                                    <TextBlock FontSize="{DynamicResource FontSize.Caption}"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,12">
                                        <Run Text="Printed dimensions · "/>
                                        <Run Text="{Binding LogoWidthDisplay, Mode=OneWay}"/>
                                        <Run Text=" × "/>
                                        <Run Text="{Binding LogoHeightDisplay, Mode=OneWay}"/>
                                        <Run Text=" · (range: 8–60 mm)"/>
                                    </TextBlock>

                                    <!-- Letterhead layout options -->
                                    <TextBlock Text="LETTERHEAD COMPOSITION" Style="{StaticResource Field.Label}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Text only"
                                                     GroupName="CompanyLogoLayout"
                                                     IsChecked="{Binding IsNoLogoLayout}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     VerticalAlignment="Center"/>
                                        <RadioButton Content="Left portrait"
                                                     GroupName="CompanyLogoLayout"
                                                     IsChecked="{Binding IsLeftPortraitLayout}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     Margin="16,0,0,0"
                                                     VerticalAlignment="Center"/>
                                        <RadioButton Content="Top panel"
                                                     GroupName="CompanyLogoLayout"
                                                     IsChecked="{Binding IsTopPanelLayout}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     Margin="16,0,0,0"
                                                     VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding LogoPath}"
                                               FontSize="{DynamicResource FontSize.Caption}" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="420"
                                               ToolTip="{Binding LogoPath}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── BENTO CARD 5: AUDIT LOG NOTE & SAVE ACTION ── -->
                    <Border Style="{StaticResource CompanyCenterCardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource Field.Panel}" Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource CompanyCenter.WHYNOTEOptionalRecordedAuditTrail}"
                                           Style="{StaticResource Field.Label}"/>
                                <TextBox Text="{Binding ReasonNote, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input.TextBox}"
                                         ToolTip="{DynamicResource CompanyCenter.ReasonChangeEGTRNCorrectedAfterTradeLicence}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SuccessPillButton}"
                                        Tag="&#xE74E;" Content="{Binding SaveButtonText}"
                                        Command="{Binding SaveCompanyCommand}"
                                        Height="36" Padding="20,0"/>
                            </StackPanel>

                            <!-- Dynamic Status -->
                            <Border CornerRadius="{DynamicResource Radius.Small}" Background="{DynamicResource TintIndigoBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                                    Padding="14,10" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}"
                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                           Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
