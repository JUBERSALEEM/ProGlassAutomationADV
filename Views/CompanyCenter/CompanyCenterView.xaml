<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/CompanyCenter/CompanyCenterView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Company Center (Phase 1)

     Left: company cards (logo / initials, TRN, default badge).
     Right: full profile editor (identity, representative, banking).
     The DEFAULT company pre-fills Proforma Invoice Step 1.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.CompanyCenter.CompanyCenterView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ProGlassAutomation.Views.Shared"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        
        
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Background="Transparent">
        <StackPanel Margin="32,26,32,32">

            <!-- HEADER -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Module.CompanyCenter}"
                               FontSize="{DynamicResource FontSize.Kpi}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource CompanyCenter.CompaniesIdentityTRNBankingLogoDefault}"
                               FontSize="{DynamicResource FontSize.Body}" Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE710;" Content="{DynamicResource CompanyCenter.NEWCompany}"
                            Command="{Binding NewCompanyCommand}"/>
                    <Button Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                            Command="{Binding RefreshCommand}"
                            Margin="10,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── COMPANY CARDS ── -->
                <ItemsControl Grid.Column="0"
                              ItemsSource="{Binding Companies}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="16,14"
                                    CornerRadius="{DynamicResource CardCornerRadius}" Cursor="Hand"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                                    Background="{DynamicResource SurfacePrimaryBrush}"
                                    ToolTip="{DynamicResource CompanyCenter.ClickToLoadCompany}"
                                    Focusable="True"
                                    AutomationProperties.Name="{Binding CompanyName}"
                                    AutomationProperties.HelpText="Load saved company into editor"
                                    SnapsToDevicePixels="True">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectCompanyCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                    <KeyBinding Key="Return"
                                                    Command="{Binding DataContext.SelectCompanyCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                    <KeyBinding Key="Space"
                                                    Command="{Binding DataContext.SelectCompanyCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource BorderDefaultBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background"
                                                        Value="{DynamicResource TintIndigoBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Executive Avatar Badge -->
                                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Width="44" Height="44"
                                            CornerRadius="22"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SurfaceSecondaryBrush}">
                                        <TextBlock Text="&#xE822;"
                                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                                   FontSize="{DynamicResource FontSize.H3}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Company Details -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,8,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CompanyName}"
                                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="{DynamicResource FontSize.Caption}" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}">
                                            <Run Text="{DynamicResource CompanyCenter.TRN}"/>
                                            <Run Text="{Binding CompanyTrn, Mode=OneWay}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Quick Action Buttons -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource RowOutlinedButton}" Height="28" Padding="10,0"
                                                Tag="&#xE8E5;" Content="{DynamicResource Action.Edit}"
                                                Command="{Binding DataContext.SelectCompanyCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource RowDangerButton}" Height="28" Width="28" Padding="0"
                                                Tag="&#xE74D;" Content=""
                                                Command="{Binding DataContext.DeleteCompanyCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>

                                    <!-- Status Chips Strip -->
                                    <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="8,4"
                                            Background="{DynamicResource SurfaceSecondaryBrush}"
                                            CornerRadius="{DynamicResource Radius.Small}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource TintGreenBrush}" CornerRadius="10" Padding="8,2" Margin="0,0,6,0">
                                                    <TextBlock Text="Verified TRN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                </Border>
                                                <Border Background="{DynamicResource TintBlueBrush}" CornerRadius="10" Padding="8,2">
                                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}">
                                                        <Run Text="{Binding UsageCount, Mode=OneWay}"/><Run Text=" Invoices"/>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ── EDITOR ── -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="24,20">
                    <StackPanel>
                        <!-- ══ TOP PANEL — professional industrial masthead ══
                             Live preview of the printed letterhead: the logo
                             (left, per the chosen layout) + company identity.
                             Mirrors the TopPanel PDF composition. -->
                        <Border Background="{DynamicResource TintIndigoBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="{DynamicResource Border.HairlineThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="16,14"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Logo slot (left). Portrait box honours the
                                     configured aspect; hidden when no logo. -->
                                <Border Grid.Column="0"
                                        Width="56" Height="64"
                                        Background="{DynamicResource Surface.Primary.BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="{DynamicResource Border.HairlineThickness}"
                                        CornerRadius="{DynamicResource Radius.Small}"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <!-- No BasedOn here: there is no global implicit
                                             Border style, so '{StaticResource {x:Type Border}}'
                                             threw 'Cannot find resource named
                                             System.Windows.Controls.Border' (ERR-C90647).
                                             This style only toggles Visibility; the slot's
                                             size/edge/paint are local values above. -->
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Source="{Binding LogoPath}"
                                           Stretch="Uniform"
                                           Margin="5"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CompanyName}"
                                               FontSize="{DynamicResource FontSize.H2}"
                                               FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="{DynamicResource FontSize.Body}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding CompanyTrn}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{Binding CompanyLocation}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                               FontWeight="{DynamicResource Weight.SemiBold}"
                                               Foreground="{DynamicResource AccentBrush}">
                                        <Run Text="LETTERHEAD  "/>
                                        <!-- ERR-21172E: Run.Text is TwoWay-by-default in WPF;
                                             EditorTitle is get-only, so an implicit TwoWay binding
                                             throws when the card is re-parented by the crystal
                                             water wrapper. Pin it OneWay. -->
                                        <Run Text="{Binding EditorTitle, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding LogoLayoutLabel}"
                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                               FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding EditorTitle, Mode=OneWay}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                                <TextBlock Text="{DynamicResource CompanyCenter.CompanyNAME}" Style="{StaticResource Typography.Label}"/>
                                <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="TRN" Style="{StaticResource Typography.Label}"/>
                                <TextBox Text="{Binding CompanyTrn, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="{DynamicResource CompanyCenter.Location}" Style="{StaticResource Typography.Label}"/>
                                <TextBox Text="{Binding CompanyLocation, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="{DynamicResource CompanyCenter.Representative}" Style="{StaticResource Typography.Label}"/>
                                <TextBox Text="{Binding Representative, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="{DynamicResource Phone.Label}" Style="{StaticResource Typography.Label}"
                                           TextOptions.TextFormattingMode="Display"/>
                                <shared:CountryPhoneControl
                                         PhoneText="{Binding RepresentativeMobile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="CompanyCenter.RepresentativeMobile"
                                         AutomationProperties.Name="Representative mobile"/>
                            </StackPanel>

                            <StackPanel Grid.Row="6" Grid.Column="0">
                                <TextBlock Text="{DynamicResource CompanyCenter.CompanyEMAIL}" Style="{StaticResource Typography.Label}"/>
                                <TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="6" Grid.Column="2">
                                <TextBlock Text="{DynamicResource CompanyCenter.BANKNAME}" Style="{StaticResource Typography.Label}"/>
                                <TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="8" Grid.ColumnSpan="3">
                                <TextBlock Text="{DynamicResource CompanyCenter.AccountNumberIBAN}" Style="{StaticResource Typography.Label}"/>
                                <TextBox Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Margin="0,14,0,0"
                                  IsChecked="{Binding IsDefaultCompany, Mode=TwoWay}"
                                  Content="Use as default company in new proforma invoices"
                                  FontWeight="{DynamicResource Weight.SemiBold}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <!-- ══ LOGO & LETTERHEAD — left portrait / top panel · width/height ══
                             Two industrial letterhead layouts are offered
                             (LeftPortrait / TopPanel) plus the text-only fallback. -->
                        <Border Margin="0,16,0,0"
                                Background="{DynamicResource SurfacePrimaryBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="{DynamicResource CardEdgeThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="16" Style="{StaticResource SurfacePrimaryStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="4" CornerRadius="{DynamicResource Radius.XSmall}"
                                            Background="{DynamicResource AccentBrush}"
                                            Margin="0,3,10,3" Style="{StaticResource SurfacePrimaryStyle}"/>
                                    <StackPanel>
                                        <TextBlock Text="LOGO &amp; LETTERHEAD"
                                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Brands every printed document — position, size and image."
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Portrait preview (left) — reflects the saved
                                         aspect; blank white chip until a logo is picked. -->
                                    <Border Grid.Column="0" Width="96" Height="104"
                                            Background="{DynamicResource Surface.Primary.BackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                                            CornerRadius="{DynamicResource Radius.Small}"
                                            VerticalAlignment="Top" Style="{StaticResource SurfacePrimaryStyle}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                                              Direction="270" Opacity="0.12" Color="{DynamicResource LiquidShadowColor}"/>
                                        </Border.Effect>
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="&#xE8B9;" FontFamily="{DynamicResource FontFamily.Icon}"
                                                           FontSize="{DynamicResource FontSize.H1}"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="LOGO" FontSize="{DynamicResource FontSize.BodySmall}"
                                                           FontWeight="{DynamicResource Weight.SemiBold}"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Image Source="{Binding LogoPath}" Stretch="Uniform" Margin="8">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource CompanyCenter.ChooseLOGO}"
                                                   Style="{StaticResource Typography.Label}" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource PrimaryPillButton}"
                                                    Tag="&#xE8B9;" Content="{DynamicResource CompanyCenter.ChooseLOGO}"
                                                    Command="{Binding PickLogoCommand}"/>
                                            <Button Style="{StaticResource RowOutlinedButton}"
                                                    Tag="&#xE711;" Content="{DynamicResource Action.Clear}"
                                                    Command="{Binding ClearLogoCommand}"
                                                    Margin="10,0,0,0"/>
                                        </StackPanel>

                                        <!-- Width × Height (mm) — printed logo size -->
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="72"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="WIDTH (MM)" Style="{StaticResource Typography.Label}"
                                                       VerticalAlignment="Center" Margin="0"/>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding LogoWidthMm, Converter={StaticResource DoubleTypingConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource Input.TextBox}" Height="34"
                                                     TextAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="HEIGHT (MM)" Style="{StaticResource Typography.Label}"
                                                       VerticalAlignment="Center" Margin="0"/>
                                            <TextBox Grid.Column="6"
                                                     Text="{Binding LogoHeightMm, Converter={StaticResource DoubleTypingConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource Input.TextBox}" Height="34"
                                                     TextAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}">
                                            <Run Text="Printed size in millimetres · "/>
                                            <Run Text="{Binding LogoWidthDisplay, Mode=OneWay}"/>
                                            <Run Text=" × "/>
                                            <Run Text="{Binding LogoHeightDisplay, Mode=OneWay}"/>
                                            <Run Text=" · clamped to 8–60 mm"/>
                                        </TextBlock>

                                        <!-- Layout selector — both industrial logo layouts -->
                                        <TextBlock Text="LETTERHEAD LAYOUT"
                                                   Style="{StaticResource Typography.Label}" Margin="0,14,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="Text only"
                                                         GroupName="CompanyLogoLayout"
                                                         IsChecked="{Binding IsNoLogoLayout}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         VerticalAlignment="Center"/>
                                            <RadioButton Content="Left portrait"
                                                         GroupName="CompanyLogoLayout"
                                                         IsChecked="{Binding IsLeftPortraitLayout}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         Margin="16,0,0,0"
                                                         VerticalAlignment="Center"/>
                                            <RadioButton Content="Top panel"
                                                         GroupName="CompanyLogoLayout"
                                                         IsChecked="{Binding IsTopPanelLayout}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         Margin="16,0,0,0"
                                                         VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding LogoPath}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}" Margin="0,10,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="360"
                                                   ToolTip="{Binding LogoPath}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- PHASE D — WHY note recorded with the audit entry -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{DynamicResource CompanyCenter.WHYNOTEOptionalRecordedAuditTrail}"
                                       Style="{StaticResource Typography.Label}"/>
                            <TextBox Text="{Binding ReasonNote, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input.TextBox}"
                                     ToolTip="{DynamicResource CompanyCenter.ReasonChangeEGTRNCorrectedAfterTradeLicence}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource SuccessPillButton}"
                                    Tag="&#xE74E;" Content="{Binding SaveButtonText}"
                                    Command="{Binding SaveCompanyCommand}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Status}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
