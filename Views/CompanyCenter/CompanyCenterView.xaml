<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/CompanyCenter/CompanyCenterView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Company Center (Phase 1)

     Left: company cards (logo / initials, TRN, default badge).
     Right: full profile editor (identity, representative, banking).
     The DEFAULT company pre-fills Proforma Invoice Step 1.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.CompanyCenter.CompanyCenterView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ProGlassAutomation.Views.Shared"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="CcFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="CcTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Background="Transparent">
        <StackPanel Margin="32,26,32,32">

            <!-- HEADER -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Module.CompanyCenter}"
                               FontSize="{StaticResource TextDisplay}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{DynamicResource CompanyCenter.CompaniesIdentityTRNBankingLogoDefault}"
                               FontSize="{StaticResource TextBody}" Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE710;" Content="{DynamicResource CompanyCenter.NEWCompany}"
                            Command="{Binding NewCompanyCommand}"/>
                    <Button Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                            Command="{Binding RefreshCommand}"
                            Margin="10,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── COMPANY CARDS ── -->
                <ItemsControl Grid.Column="0"
                              ItemsSource="{Binding Companies}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="14,12"
                                    CornerRadius="{DynamicResource CardCornerRadius}" Cursor="Hand"
                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                                    Background="{DynamicResource ModuleBackgroundBrush}"
                                    SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource OutlineBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Width="46" Height="46"
                                            CornerRadius="{DynamicResource CardCornerRadius}"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TintIndigoBrush}">
                                        <TextBlock Text="&#xE822;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{StaticResource TextTitle}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,8,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CompanyName}"
                                                   FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="{StaticResource TextCaption}" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <Run Text="{DynamicResource CompanyCenter.TRN}"/>
                                            <Run Text="{Binding CompanyTrn, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding UsageCount, Mode=OneWay}"/>
                                            <Run Text="{DynamicResource Common.Invoices}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">
                                        <!-- 2026-09-04: the DEFAULT mark was removed by design. A company is used in an
                                         invoice ONLY by being picked in Step 1 — the wizard is hard-connected to these
                                         module records, so the silent "mark to use in invoice" authority no longer
                                         exists (two-authority confusion on money documents eliminated). -->
                                        <Button Style="{StaticResource RowOutlinedButton}"
                                                Tag="&#xE8E5;" Content="{DynamicResource Action.Edit}"
                                                Command="{Binding DataContext.SelectCompanyCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,6,0,0"/>
                                        <Button Style="{StaticResource RowDangerButton}"
                                                Tag="&#xE74D;" Content=""
                                                Command="{Binding DataContext.DeleteCompanyCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ── EDITOR ── -->
                <Border Grid.Column="2"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="24,20">
                    <StackPanel>
                        <!-- ══ TOP PANEL — professional industrial masthead ══
                             Live preview of the printed letterhead: the logo
                             (left, per the chosen layout) + company identity.
                             Mirrors the TopPanel PDF composition. -->
                        <Border Background="{DynamicResource TintIndigoBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="16,14"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Logo slot (left). Portrait box honours the
                                     configured aspect; hidden when no logo. -->
                                <Border Grid.Column="0"
                                        Width="56" Height="64"
                                        Background="White"
                                        BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <!-- No BasedOn here: there is no global implicit
                                             Border style, so '{StaticResource {x:Type Border}}'
                                             threw 'Cannot find resource named
                                             System.Windows.Controls.Border' (ERR-C90647).
                                             This style only toggles Visibility; the slot's
                                             size/edge/paint are local values above. -->
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Source="{Binding LogoPath}"
                                           Stretch="Uniform"
                                           Margin="5"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CompanyName}"
                                               FontSize="{StaticResource TextTitle}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding CompanyTrn}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{Binding CompanyLocation}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="{StaticResource TextCaption}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}">
                                        <Run Text="LETTERHEAD  "/>
                                        <Run Text="{Binding EditorTitle}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding LogoLayoutLabel}"
                                               FontSize="{StaticResource TextCaption}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding EditorTitle}"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                                <TextBlock Text="{DynamicResource CompanyCenter.CompanyNAME}" Style="{StaticResource CcFieldLabel}"/>
                                <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CcTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="TRN" Style="{StaticResource CcFieldLabel}"/>
                                <TextBox Text="{Binding CompanyTrn, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CcTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="{DynamicResource CompanyCenter.Location}" Style="{StaticResource CcFieldLabel}"/>
                                <TextBox Text="{Binding CompanyLocation, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CcTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="{DynamicResource CompanyCenter.Representative}" Style="{StaticResource CcFieldLabel}"/>
                                <TextBox Text="{Binding Representative, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CcTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="{DynamicResource Phone.Label}" Style="{StaticResource CcFieldLabel}"
                                           TextOptions.TextFormattingMode="Display"/>
                                <shared:CountryPhoneControl
                                         PhoneText="{Binding RepresentativeMobile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="CompanyCenter.RepresentativeMobile"
                                         AutomationProperties.Name="Representative mobile"/>
                            </StackPanel>

                            <StackPanel Grid.Row="6" Grid.Column="0">
                                <TextBlock Text="{DynamicResource CompanyCenter.CompanyEMAIL}" Style="{StaticResource CcFieldLabel}"/>
                                <TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CcTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="6" Grid.Column="2">
                                <TextBlock Text="{DynamicResource CompanyCenter.BANKNAME}" Style="{StaticResource CcFieldLabel}"/>
                                <TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CcTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="8" Grid.ColumnSpan="3">
                                <TextBlock Text="{DynamicResource CompanyCenter.AccountNumberIBAN}" Style="{StaticResource CcFieldLabel}"/>
                                <TextBox Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CcTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ══ LOGO — left portrait upload · width/height · layout ══
                             Two industrial letterhead layouts are offered
                             (LeftPortrait / TopPanel) plus the text-only fallback. -->
                        <Border Margin="0,16,0,0"
                                Background="{DynamicResource ModuleBackgroundBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Portrait preview (left) — reflects the saved
                                     aspect; blank white chip until a logo is picked. -->
                                <Border Grid.Column="0"
                                        Width="88" Height="96"
                                        Background="White"
                                        BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock Text="LOGO"
                                                   FontSize="{StaticResource TextCaption}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding LogoPath}"
                                               Stretch="Uniform" Margin="6">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource CompanyCenter.ChooseLOGO}"
                                               Style="{StaticResource CcFieldLabel}" Margin="0,0,0,4"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource OutlinedPillButton}"
                                                Tag="&#xE8B9;" Content="{DynamicResource CompanyCenter.ChooseLOGO}"
                                                Command="{Binding PickLogoCommand}"/>
                                        <Button Style="{StaticResource RowOutlinedButton}"
                                                Tag="&#xE711;" Content="{DynamicResource Action.Clear}"
                                                Command="{Binding ClearLogoCommand}"
                                                Margin="10,0,0,0"/>
                                    </StackPanel>

                                    <!-- Width × Height (mm) — printed logo size -->
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="WIDTH" Style="{StaticResource CcFieldLabel}"
                                                   VerticalAlignment="Center" Margin="0"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding LogoWidthMm, Converter={StaticResource DoubleTypingConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CcTextBox}" Height="34"
                                                 TextAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="HEIGHT" Style="{StaticResource CcFieldLabel}"
                                                   VerticalAlignment="Center" Margin="0"/>
                                        <TextBox Grid.Column="6"
                                                 Text="{Binding LogoHeightMm, Converter={StaticResource DoubleTypingConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CcTextBox}" Height="34"
                                                 TextAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource MutedForegroundBrush}">
                                        <Run Text="Printed size in millimetres · "/>
                                        <Run Text="{Binding LogoWidthDisplay, Mode=OneWay}"/>
                                        <Run Text=" × "/>
                                        <Run Text="{Binding LogoHeightDisplay, Mode=OneWay}"/>
                                        <Run Text=" · clamped to 8–60 mm"/>
                                    </TextBlock>

                                    <!-- Layout selector — both industrial logo layouts -->
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <RadioButton Content="Text only"
                                                     GroupName="CompanyLogoLayout"
                                                     IsChecked="{Binding IsNoLogoLayout}"
                                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                     VerticalAlignment="Center"/>
                                        <RadioButton Content="Left portrait"
                                                     GroupName="CompanyLogoLayout"
                                                     IsChecked="{Binding IsLeftPortraitLayout}"
                                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                     Margin="16,0,0,0"
                                                     VerticalAlignment="Center"/>
                                        <RadioButton Content="Top panel"
                                                     GroupName="CompanyLogoLayout"
                                                     IsChecked="{Binding IsTopPanelLayout}"
                                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                     Margin="16,0,0,0"
                                                     VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding LogoPath}"
                                               FontSize="{StaticResource TextCaption}" Margin="0,10,0,0"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="360"
                                               ToolTip="{Binding LogoPath}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- PHASE D — WHY note recorded with the audit entry -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{DynamicResource CompanyCenter.WHYNOTEOptionalRecordedAuditTrail}"
                                       Style="{StaticResource CcFieldLabel}"/>
                            <TextBox Text="{Binding ReasonNote, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CcTextBox}"
                                     ToolTip="{DynamicResource CompanyCenter.ReasonChangeEGTRNCorrectedAfterTradeLicence}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource SuccessPillButton}"
                                    Tag="&#xE74E;" Content="{DynamicResource CompanyCenter.SAVECompany}"
                                    Command="{Binding SaveCompanyCommand}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Status}"
                                   FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
