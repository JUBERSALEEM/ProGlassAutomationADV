<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Self-contained light theme for the crash dialog.
      The main app uses dark / glass; the crash dialog
      must be readable when the app is in an unknown
      state, so it has its own minimal palette.
    -->

    

    

    <Style x:Key="CrashPrimaryButton" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"   Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Foreground"   Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"      Value="14,8"/>
        <Setter Property="FontWeight"   Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.XSmall}"
                            Padding="{TemplateBinding Padding}" Style="{StaticResource SurfacePrimaryStyle}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CrashOutlinedButton" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"     Value="White"/>
        <Setter Property="Foreground"     Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"        Value="14,8"/>
        <Setter Property="FontWeight"     Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Cursor"         Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.XSmall}"
                            Padding="{TemplateBinding Padding}" Style="{StaticResource SurfacePrimaryStyle}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    

</ResourceDictionary>
