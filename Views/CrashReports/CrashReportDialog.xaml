<!--
  CrashReportDialog — a small modal that appears after an
  unhandled crash. Gives the user three concrete actions
  (open the crash folder, copy the Error ID, restart the
  app) plus a Cancel. Self-contained WPF, no third-party
  deps, light theme by default.
-->
<Window x:Class="ProGlassAutomation.Views.CrashReports.CrashReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CrashReports.ProglassAutomationError}"
        Width="560" Height="380"
        MinWidth="480" MinHeight="320"
        Background="{DynamicResource GlassSurfaceElevated}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="true">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CrashReportDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────── -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource CrashReports.SomethingWentWrong}"
                       FontSize="{StaticResource TextTitleLarge}" FontWeight="SemiBold"
                       Foreground="{DynamicResource DangerBrush}"/>
            <TextBlock Text="{DynamicResource CrashReports.ProglassAutomationRecoveredUnexpectedError}"
                       FontSize="{StaticResource TextBody}" Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </StackPanel>

        <!-- ── Detail block ──────────────────────────────────── -->
        <Border Grid.Row="1" Margin="0,18,0,0" Padding="16,14"
                Background="{DynamicResource ElevatedSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource CrashReports.ErrorID}"
                               Style="{StaticResource CrashFieldLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding ErrorId}"
                               Style="{StaticResource CrashFieldValue}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Common.Type}"
                               Style="{StaticResource CrashFieldLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding ExceptionType}"
                               Style="{StaticResource CrashFieldValue}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource CrashReports.Message}"
                               Style="{StaticResource CrashFieldLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding ExceptionMessage}"
                               TextWrapping="Wrap"
                               Style="{StaticResource CrashFieldValue}"/>
                </Grid>

                <TextBlock Text="{DynamicResource CrashReports.CrashReportSaved}"
                           Style="{StaticResource CrashFieldLabel}"
                           Margin="0,4,0,4"/>
                <TextBlock Text="{Binding ReportPath}"
                           FontFamily="Consolas, Cascadia Mono, Courier New"
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ── Buttons ────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource CrashPrimaryButton}"
                    Content="{DynamicResource CrashReports.RestartAPP}"
                    Command="{Binding RestartCommand}"
                    Margin="0,0,8,0"/>
            <Button Style="{StaticResource CrashOutlinedButton}"
                    Content="{DynamicResource CrashReports.COPYErrorID}"
                    Command="{Binding CopyErrorIdCommand}"
                    Margin="0,0,8,0"/>
            <Button Style="{StaticResource CrashOutlinedButton}"
                    Content="{DynamicResource CrashReports.OPENCrashFolder}"
                    Command="{Binding OpenFolderCommand}"
                    Margin="0,0,8,0"/>
            <Button Style="{StaticResource CrashGhostButton}"
                    Content="{DynamicResource Action.Close}"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>
