<!--
  LicenseActivationView — the licensing page.

  Simple by design (2026 workflow simplification):
    • PASTE THE KEY: the vendor generates a license key and sends one
      text block (PGKEY1.…). Paste it, apply, done. The app verifies the
      vendor signature before activating.
    • TRIAL IS AUTOMATIC: a 30-day trial starts on first run and keeps
      working until the key arrives; if a key is ever removed or expires
      inside the trial window, the app falls back to the trial.
    • PC ID: shown read-only. Only needed when the vendor wants to bind
      the key to this machine.
    • The old activation-request round-trip still works but is tucked
      away under "Advanced" — it is no longer required for anything.
-->
<UserControl x:Class="ProGlassAutomation.Views.Licensing.LicenseActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource BackgroundBrush}"
            Padding="28,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch"
                        VerticalAlignment="Top">

                <TextBlock x:Name="HeadlineText"
                           Text="Activate ProGlass Automation"
                           FontSize="{StaticResource TextDisplayLarge}" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock x:Name="SubheadText"
                           TextWrapping="Wrap" FontSize="{StaticResource TextBodyLarge}"
                           Margin="0,4,0,24"
                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                    <Run Text="Paste the license key your vendor sent you. A 30-day trial is already running, so you can keep working while you get your key."/>
                </TextBlock>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="LICENSE KEY — PASTE TO ACTIVATE"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="{StaticResource TextBody}"
                                   Margin="0,6,0,12"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="Your vendor sends you a single text block starting with PGKEY1. Paste it here and click Apply. That is all."/>
                        </TextBlock>
                        <TextBox x:Name="KeyPasteTextBox"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap" MinHeight="110"
                                 MaxHeight="200"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="{StaticResource TextBody}"
                                 Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Content="APPLY LICENSE KEY"
                                    Click="KeyApplyButton_Click"
                                    HorizontalAlignment="Stretch"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Content="OPEN KEY FILE…"
                                    Click="KeyBrowseButton_Click"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="CURRENT LICENSE STATE"
                                   FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="StatusBadgeText"
                                   Text="Trial"
                                   FontSize="{StaticResource TextSection}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusDetailText"
                                   Text=""
                                   FontSize="{StaticResource TextBody}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap"/>
                        <Grid x:Name="LicenseDetailsGrid"
                              Margin="0,12,0,0"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Edition"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EditionValue"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CustomerValue"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Expires"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ExpiresValue"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="License ID"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LicenseIdValue"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Source"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SourceValue"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="YOUR PC ID"
                                   FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="{StaticResource TextBody}"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="Send this to your vendor ONLY if they ask for it (a machine-bound key). You normally do not need it."/>
                        </TextBlock>
                        <TextBox x:Name="FingerprintDisplayBox"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="{StaticResource TextBody}"
                                 TextWrapping="Wrap"/>
                        <TextBlock Text="Installation ID"
                                   FontSize="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,10,0,0"/>
                        <TextBox x:Name="InstallationIdBox" IsReadOnly="True"
                                 FontSize="{StaticResource TextBody}"
                                 Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Button x:Name="AdvancedToggleButton"
                        Style="{StaticResource OutlinedPillButton}"
                        Content="ADVANCED: ACTIVATION REQUEST (NOT REQUIRED) ▾"
                        Click="AdvancedToggleButton_Click"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0"/>

                <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="STEP 1 — GENERATE ACTIVATION REQUEST"
                                       FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="{StaticResource TextBody}"
                                       Margin="0,6,0,12"
                                       Foreground="{DynamicResource ForegroundBrush}">
                                <Run Text="For vendors who still use the request/response procedure: generate the request, send it to your vendor, then import the signed response they return."/>
                            </TextBlock>
                            <TextBlock Text="Activation request JSON"
                                       FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBox x:Name="RequestOutputBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="120"
                                     MaxHeight="220"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="{StaticResource TextBody}"
                                     Margin="0,4,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryPillButton}"
                                        Content="GENERATE REQUEST"
                                        Click="GenerateRequestButton_Click"
                                        HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource OutlinedPillButton}"
                                        Content="SAVE REQUEST FILE…"
                                        Click="SaveRequestButton_Click"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource OutlinedPillButton}"
                                        Content="COPY REQUEST"
                                        Click="CopyRequestButton_Click"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="STEP 2 — IMPORT SIGNED ACTIVATION RESPONSE"
                                       FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="{StaticResource TextBody}"
                                       Margin="0,6,0,12"
                                       Foreground="{DynamicResource ForegroundBrush}">
                                <Run Text="Paste the signed response JSON your vendor returned, or open the response file."/>
                            </TextBlock>
                            <TextBox x:Name="PasteTextBox"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="Wrap" MinHeight="120"
                                     MaxHeight="220"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="{StaticResource TextBody}"
                                     Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryPillButton}"
                                        Content="APPLY SIGNED RESPONSE"
                                        Click="PasteApplyButton_Click"
                                        HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource OutlinedPillButton}"
                                        Content="OPEN RESPONSE FILE…"
                                        Click="BrowseButton_Click"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="ErrorText"
                           Margin="0,8,0,0"
                           FontSize="{StaticResource TextBody}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="HintText"
                           Margin="0,8,0,0"
                           FontSize="{StaticResource TextCaption}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Style="{StaticResource OutlinedPillButton}"
                            Content="CLOSE"
                            Click="CloseButton_Click"
                            Visibility="{Binding IsClosable,
                                RelativeSource={RelativeSource AncestorType=UserControl},
                                Converter={StaticResource BoolToVisibilityConverter},
                                FallbackValue=Visible}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
