<!--
  LicenseActivationView — licensing page (2026 workflow simplification).

  THREE TRACKS, ALL SECURED:
    • LICENSE KEY (primary): the vendor generates a signed license key
      with the License Generator and sends ONE copy-paste text block
      (PGKEY1.…). The customer pastes it and the app verifies the
      vendor's RSA-2048-PSS signature, keyId, product, dates and any
      machine binding before activating. No request, no reference,
      no PC-ID round-trip.
    • ACTIVATION REQUEST (advanced): for machine-bound licenses when the
      vendor needs this PC's ID. The old "vendor license reference"
      requirement is gone — a request can be generated straight away.
    • AUTOMATIC TRIAL: a 30-day evaluation trial starts on first run
      (tamper-evident ledger, see AutoTrialManager). A signed license
      always wins; if a key is removed or expires while the trial
      window is open, the app falls back to the trial automatically.
-->
<UserControl x:Class="ProGlassAutomation.Views.Licensing.LicenseActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource BackgroundBrush}"
            Padding="28,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch"
                        VerticalAlignment="Top">

                <TextBlock x:Name="HeadlineText"
                           Text="Activate ProGlass Automation"
                           FontSize="{StaticResource TextDisplayLarge}" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock x:Name="SubheadText"
                           TextWrapping="Wrap" FontSize="{StaticResource TextBodyLarge}"
                           Margin="0,4,0,24"
                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                    <Run Text="Paste the license key your vendor sent you. A 30-day trial starts automatically on first run, so you can keep working while you get your key."/>
                </TextBlock>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="CURRENT LICENSE STATE"
                                   FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="StatusBadgeText"
                                   Text="Trial"
                                   FontSize="{StaticResource TextSection}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusDetailText"
                                   Text=""
                                   FontSize="{StaticResource TextBody}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap"/>
                        <Grid x:Name="LicenseDetailsGrid"
                              Margin="0,12,0,0"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Edition"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EditionValue"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CustomerValue"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Expires"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ExpiresValue"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="License ID"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LicenseIdValue"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Source"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SourceValue"
                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="LICENSE KEY — QUICKEST WAY TO ACTIVATE"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="{StaticResource TextBody}"
                                   Margin="0,6,0,12"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="Your vendor generates a key and sends it as a single text block starting with PGKEY1. Paste it here — the app verifies the vendor signature and activates instantly. Nothing else to configure."/>
                        </TextBlock>
                        <TextBox x:Name="KeyPasteTextBox"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap" MinHeight="110"
                                 MaxHeight="200"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="{StaticResource TextBody}"
                                 Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Content="APPLY LICENSE KEY"
                                    Click="KeyApplyButton_Click"
                                    HorizontalAlignment="Stretch"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Content="BROWSE FOR KEY FILE…"
                                    Click="KeyBrowseButton_Click"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ADVANCED — ACTIVATION REQUEST (WHEN YOUR VENDOR NEEDS THIS PC)"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="{StaticResource TextBody}"
                                   Margin="0,6,0,12"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="Only needed when your vendor issues machine-bound licenses. Generate the request, send it to your vendor, then import the signed response they return."/>
                        </TextBlock>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Installation ID"
                                           FontSize="{StaticResource TextBody}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBox x:Name="InstallationIdBox" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PC ID (machine fingerprint)"
                                           FontSize="{StaticResource TextBody}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBox x:Name="FingerprintDisplayBox"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Activation request JSON"
                                   FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBox x:Name="RequestOutputBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120"
                                 MaxHeight="220"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="{StaticResource TextBody}"
                                 Margin="0,4,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Content="GENERATE REQUEST"
                                    Click="GenerateRequestButton_Click"
                                    HorizontalAlignment="Stretch"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Content="SAVE REQUEST FILE…"
                                    Click="SaveRequestButton_Click"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Stretch"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Content="COPY REQUEST"
                                    Click="CopyRequestButton_Click"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="IMPORT SIGNED ACTIVATION RESPONSE"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="{StaticResource TextBody}"
                                   Margin="0,6,0,12"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="Your vendor returns a signed response file or raw signed JSON. Base64-wrapped whole-license strings are not accepted in this flow."/>
                        </TextBlock>
                        <TextBox x:Name="PasteTextBox"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap" MinHeight="120"
                                 MaxHeight="220"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="{StaticResource TextBody}"
                                 Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Content="APPLY SIGNED RESPONSE JSON"
                                    Click="PasteApplyButton_Click"
                                    HorizontalAlignment="Stretch"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Content="BROWSE FOR RESPONSE FILE…"
                                    Click="BrowseButton_Click"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText"
                           Margin="0,8,0,0"
                           FontSize="{StaticResource TextBody}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="HintText"
                           Margin="0,8,0,0"
                           FontSize="{StaticResource TextCaption}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Style="{StaticResource OutlinedPillButton}"
                            Content="CLOSE"
                            Click="CloseButton_Click"
                            Visibility="{Binding IsClosable,
                                RelativeSource={RelativeSource AncestorType=UserControl},
                                Converter={StaticResource BoolToVisibilityConverter},
                                FallbackValue=Visible}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
