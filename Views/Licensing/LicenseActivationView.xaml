<!--
  LicenseActivationView — secure offline activation page.

  Max-security redesign direction:
    • no client-side self-signed trial issuance
    • no whole-license base64 activation blobs
    • customer generates an activation request
    • vendor returns a signed offline activation response
    • app verifies product, keyId, signature, installation, nonce,
      machine fingerprint and dates before activating
-->
<UserControl x:Class="ProGlassAutomation.Views.Licensing.LicenseActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource BackgroundBrush}"
            Padding="28,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch"
                        VerticalAlignment="Top">

                <TextBlock x:Name="HeadlineText"
                           Text="Activate ProGlass Automation"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock x:Name="SubheadText"
                           TextWrapping="Wrap" FontSize="13"
                           Margin="0,4,0,24"
                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                    <Run Text="This build uses secure offline activation. Generate an activation request, send it to your vendor, and then import the signed activation response they return."/>
                </TextBlock>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="CURRENT LICENSE STATE"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="StatusBadgeText"
                                   Text="Not activated"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusDetailText"
                                   Text=""
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap"/>
                        <Grid x:Name="LicenseDetailsGrid"
                              Margin="0,12,0,0"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Edition"
                                       FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EditionValue"
                                       FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer"
                                       FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CustomerValue"
                                       FontSize="12" Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Expires"
                                       FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ExpiresValue"
                                       FontSize="12" Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="License ID"
                                       FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LicenseIdValue"
                                       FontSize="12" Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Source"
                                       FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SourceValue"
                                       FontSize="12" Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="STEP 1 — GENERATE ACTIVATION REQUEST"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Margin="0,6,0,12"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="Enter the vendor license reference you were given. The request binds this machine fingerprint and installation identity into a signed-response workflow."/>
                        </TextBlock>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Vendor license reference"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBox x:Name="LicenseReferenceBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Installation ID"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBox x:Name="InstallationIdBox" IsReadOnly="True"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Current machine fingerprint"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBox x:Name="FingerprintDisplayBox"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Margin="0,4,0,12"
                                 TextWrapping="Wrap"/>
                        <TextBlock Text="Activation request JSON"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBox x:Name="RequestOutputBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120"
                                 MaxHeight="220"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Margin="0,4,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Content="GENERATE REQUEST"
                                    Click="GenerateRequestButton_Click"
                                    HorizontalAlignment="Stretch"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Content="SAVE REQUEST FILE…"
                                    Click="SaveRequestButton_Click"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Stretch"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Content="COPY REQUEST"
                                    Click="CopyRequestButton_Click"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="STEP 2 — IMPORT SIGNED ACTIVATION RESPONSE"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Margin="0,6,0,12"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="Your vendor returns a signed response file or raw signed JSON. Base64-wrapped whole-license strings are no longer accepted in this secure flow."/>
                        </TextBlock>
                        <TextBox x:Name="PasteTextBox"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap" MinHeight="120"
                                 MaxHeight="220"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"
                                 Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Content="APPLY SIGNED RESPONSE JSON"
                                    Click="PasteApplyButton_Click"
                                    HorizontalAlignment="Stretch"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Content="BROWSE FOR RESPONSE FILE…"
                                    Click="BrowseButton_Click"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText"
                           Margin="0,8,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="HintText"
                           Margin="0,8,0,0"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Style="{StaticResource OutlinedPillButton}"
                            Content="CLOSE"
                            Click="CloseButton_Click"
                            Visibility="{Binding IsClosable,
                                RelativeSource={RelativeSource AncestorType=UserControl},
                                Converter={StaticResource BoolToVisibilityConverter},
                                FallbackValue=Visible}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
