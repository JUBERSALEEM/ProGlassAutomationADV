<!--
  LicenseActivationView — in-app license activation page.

  Commit 3 of the licensing refactor replaces the pre-login
  WelcomeView with this in-app activation page. The view
  is reused in two places by Commit 4:

    1) The first-launch modal window that the app shows
       when no usable license is present (replaces the
       old WelcomeView).
    2) The "License required" mode the main shell falls
       into when an auto-trial expires and the user
       tries to keep using the app. Same control, hosted
       as a page in MainWindow's content region.

  The view itself is just an in-app form: paste a
  license key, browse for a .lic file, or read the
  current license details. The OLD "Continue Read-Only"
  button is intentionally NOT present — the new model
  has no read-only escape hatch. The OLD "Start a 30-day
  trial" button is also gone because Commit 2's
  LicenseService.IssueAutoTrialIfEligible auto-issues a
  7-day trial on first launch without any user action.

  Visual: same SectionCardStyle / PrimaryPillButton /
  OutlinedPillButton / DangerButton chrome as
  WelcomeView. No new theme work.

  The view raises an Activated event when the user
  successfully installs a license, and a Cancelled
  event when the user closes the dialog without
  activating. The host window reads these to decide
  whether to advance the app to the main window
  (Commit 4) or stay put.
-->
<UserControl x:Class="ProGlassAutomation.Views.Licensing.LicenseActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--
              SectionCardStyle is local to Settings and not
              merged into the global dictionary. Re-merge it
              here so the cards look the same as every other
              Settings panel.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource BackgroundBrush}"
            Padding="36">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="680" HorizontalAlignment="Stretch"
                        VerticalAlignment="Top">

                <!-- Title + headline -->
                <TextBlock x:Name="HeadlineText"
                           Text="Activate ProGlass Automation"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock x:Name="SubheadText"
                           TextWrapping="Wrap" FontSize="13"
                           Margin="0,4,0,24"
                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                    <Run Text="Paste a license key from your vendor, or drop a "/>
                    <Run FontWeight="SemiBold" Text=".lic"/>
                    <Run Text=" file. The app verifies the signature before it runs."/>
                </TextBlock>

                <!-- Current license card (always shown so the user
                     can see what the app is currently configured
                     to use). -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="CURRENT LICENSE"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="StatusBadgeText"
                                   Text="Not activated"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusDetailText"
                                   Text=""
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap"/>
                        <Grid x:Name="LicenseDetailsGrid"
                              Margin="0,12,0,0"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Edition"
                                       FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EditionValue"
                                       FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer"
                                       FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CustomerValue"
                                       FontSize="12" Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Expires"
                                       FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ExpiresValue"
                                       FontSize="12" Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="License ID"
                                       FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LicenseIdValue"
                                       FontSize="12" Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Source"
                                       FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SourceValue"
                                       FontSize="12" Foreground="{DynamicResource ForegroundBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Option 1: Paste a license key (text) -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="PASTE A LICENSE KEY"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Margin="0,6,0,12"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="Paste the full license JSON your vendor sent you (it starts with an open brace and ends with a close brace), or paste a base64-encoded envelope."/>
                        </TextBlock>
                        <TextBox x:Name="PasteTextBox"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap" MinHeight="120"
                                 MaxHeight="200"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"
                                 Margin="0,0,0,12"/>
                        <Button Style="{StaticResource PrimaryPillButton}"
                                Content="APPLY PASTED LICENSE"
                                Click="PasteApplyButton_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Option 2: Drop / browse a .lic file -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="INSTALL A .LIC FILE"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Margin="0,6,0,12"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="If your vendor sent you a "/>
                            <Run FontWeight="SemiBold" Text=".lic"/>
                            <Run Text=" file (typically named after your company), browse to it here."/>
                        </TextBlock>
                        <Button Style="{StaticResource OutlinedPillButton}"
                                Content="BROWSE FOR .LIC FILE…"
                                Click="BrowseButton_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Footer: error label + close button -->
                <TextBlock x:Name="ErrorText"
                           Margin="0,8,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="HintText"
                           Margin="0,8,0,0"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Style="{StaticResource OutlinedPillButton}"
                            Content="CLOSE"
                            Click="CloseButton_Click"
                            Visibility="{Binding IsClosable,
                                RelativeSource={RelativeSource AncestorType=UserControl},
                                Converter={StaticResource BoolToVisibilityConverter},
                                FallbackValue=Visible}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
