<!--
  WelcomeView — first-run / no-license dialog.

  Shown by App.xaml.cs in a modal window when
  LicenseService.Current.Status == LicenseStatus.NotActivated.

  The user picks one of three paths:
    1. Activate a license file the vendor sent them.
    2. Start a 30-day trial (requires the developer's
       private key in %AppData%\ProGlassAutomation\
       license-keys.json — the first-run wizard's
       "Run LicenseGenerator once" prerequisite).
    3. Continue without a license. The app boots in
       read-only mode (no writes, no exports). The
       user can still poke around the UI to decide
       whether to buy.

  No ViewModel. The view is short enough to live in
  code-behind (matches the existing SplashView pattern).

  Visual: matches the existing dialog chrome — uses the
  app's standard SectionCardStyle, PrimaryPillButton,
  OutlinedPillButton and DangerButton styles from
  Styles/ButtonStyles.xaml. No custom theming.
-->
<UserControl x:Class="ProGlassAutomation.Views.Licensing.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--
              SectionCardStyle lives in
              Views/Settings/SettingsSectionStyles.xaml and is
              not merged into the global dictionary, so we
              merge it locally. This matches the pattern
              every Settings/Sections/*.xaml uses.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource BackgroundBrush}"
            Padding="36">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="640" HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Title -->
                <TextBlock Text="Welcome to ProGlass Automation"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Choose how you'd like to start."
                           FontSize="13" Margin="0,4,0,24"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                <!-- License status card -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="LICENSE STATUS"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Not activated"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusDetailText"
                                   Text=""
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Option 1: Activate a license -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ACTIVATE A LICENSE"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Margin="0,6,0,12"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="If your vendor sent you a "/>
                            <Run FontWeight="SemiBold" Text=".lic"/>
                            <Run Text=" file (typically named after your company), drop it in here."/>
                        </TextBlock>
                        <Button Style="{StaticResource PrimaryPillButton}"
                                Content="ACTIVATE LICENSE FILE…"
                                Click="ActivateButton_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Option 2: Trial -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="START A 30-DAY TRIAL"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Margin="0,6,0,12"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="Evaluate the full ERP for 30 days. No payment details required. The trial is local to this machine and expires automatically."/>
                        </TextBlock>
                        <Button Style="{StaticResource OutlinedPillButton}"
                                Content="START 30-DAY TRIAL"
                                Click="TrialButton_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Option 3: Continue without -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="CONTINUE WITHOUT A LICENSE"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Margin="0,6,0,12"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="Explore the UI in read-only mode. You will not be able to save data, print, or export. You can activate a license at any time from "/>
                            <Run FontWeight="SemiBold" Text="Settings → Data → Database Health"/>
                            <Run Text="."/>
                        </TextBlock>
                        <Button Style="{StaticResource OutlinedPillButton}"
                                Content="CONTINUE READ-ONLY"
                                Click="ContinueButton_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Footer with link to the manual path -->
                <TextBlock x:Name="HintText"
                           Margin="0,16,0,0"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
