<Window x:Class="ProGlassAutomation.Views.Printing.Stickers.StickerPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stickers="clr-namespace:ProGlassAutomation.Views.Printing.Stickers"
        Title="Sticker Printer Studio"
        Width="1240" Height="720" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <stickers:StickerPrinterView x:Name="Studio"/>
</Window>
