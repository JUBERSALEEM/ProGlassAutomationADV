<Window x:Class="ProGlassAutomation.Views.Printing.Stickers.StickerPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glass Sticker Printer"
        Width="1220" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="GLASS STICKER PRINTER" FontSize="19" FontWeight="Bold"
                           Foreground="#182230" Margin="0,0,0,4"/>
                <TextBlock Text="Set label stock, choose printed fields, then review the live preview before printing."
                           FontSize="12" Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="LABEL STOCK &amp; TYPE" FontSize="11" FontWeight="Bold" Foreground="#344054" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Width (mm)" FontSize="11" Foreground="#667085"/>
                                <TextBox Text="{Binding WidthMmText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Height (mm)" FontSize="11" Foreground="#667085"/>
                                <TextBox Text="{Binding HeightMmText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" Padding="8,6"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Inner margin (mm)" FontSize="11" Foreground="#667085"/>
                                <TextBox Text="{Binding MarginMmText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Base font (pt)" FontSize="11" Foreground="#667085"/>
                                <TextBox Text="{Binding FontSizePtText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" Padding="8,6"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Print one sticker per physical glass piece" IsChecked="{Binding OneLabelPerPiece}"
                                  FontSize="12" Foreground="#344054" Margin="0,2,0,4"/>
                        <TextBlock Text="When unchecked, one sticker is printed per source row and shows the row quantity."
                                   FontSize="10" Foreground="#667085" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="FIELDS ON LABEL" FontSize="11" FontWeight="Bold" Foreground="#344054" Margin="0,0,0,8"/>
                        <CheckBox Content="Company logo" IsChecked="{Binding ShowLogo}" FontSize="12" Margin="0,3"/>
                        <CheckBox Content="Company name" IsChecked="{Binding ShowCompanyName}" FontSize="12" Margin="0,3"/>
                        <CheckBox Content="Company address" IsChecked="{Binding ShowAddress}" FontSize="12" Margin="0,3"/>
                        <CheckBox Content="Company telephone" IsChecked="{Binding ShowTelephone}" FontSize="12" Margin="0,3"/>
                        <CheckBox Content="Representative mobile" IsChecked="{Binding ShowMobile}" FontSize="12" Margin="0,3"/>
                        <CheckBox Content="Website" IsChecked="{Binding ShowWebsite}" FontSize="12" Margin="0,3"/>
                        <CheckBox Content="Email" IsChecked="{Binding ShowEmail}" FontSize="12" Margin="0,3"/>
                        <Separator Margin="0,8"/>
                        <CheckBox Content="Order / Job / PI" IsChecked="{Binding ShowOrder}" FontSize="12" Margin="0,3"/>
                        <CheckBox Content="Customer company" IsChecked="{Binding ShowCustomer}" FontSize="12" Margin="0,3"/>
                        <CheckBox Content="Glass / colour name" IsChecked="{Binding ShowGlassName}" FontSize="12" Margin="0,3"/>
                        <CheckBox Content="Width × height" IsChecked="{Binding ShowSize}" FontSize="12" Margin="0,3"/>
                        <CheckBox Content="Quantity" IsChecked="{Binding ShowQuantity}" FontSize="12" Margin="0,3"/>
                        <CheckBox Content="Reference" IsChecked="{Binding ShowReference}" FontSize="12" Margin="0,3"/>
                        <CheckBox Content="Pane position" IsChecked="{Binding ShowPanePosition}" FontSize="12" Margin="0,3"/>
                    </StackPanel>
                </Border>

                <Border Background="#EEF4FF" BorderBrush="#B2CCFF" BorderThickness="1" CornerRadius="8" Padding="10">
                    <TextBlock Text="Company and customer values come from the source PI / Job Order snapshot. Edit telephone and website in Company Center or Step 1; this dialog does not silently replace invoice data."
                               FontSize="11" Foreground="#344054" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.15*"/>
                <RowDefinition Height="0.85*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="LIVE PREVIEW" FontSize="11" FontWeight="Bold" Foreground="#344054"/>
                        <TextBlock Text="{Binding EstimatedLabelCountText}" DockPanel.Dock="Right"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#175CD3"/>
                    </DockPanel>
                    <Border x:Name="PreviewSurface" Grid.Row="1" Background="#EAECF0" CornerRadius="8" Padding="18">
                        <ContentControl x:Name="PreviewHost"/>
                    </Border>
                    <TextBlock Grid.Row="2" Text="Preview displays the selected source row. The table below is the print source cross-check."
                               FontSize="10" Foreground="#667085" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="SOURCE LABELS — verify order, customer, glass, size, quantity and reference"
                               FontSize="11" FontWeight="Bold" Foreground="#344054" Margin="2,0,0,8"/>
                    <DataGrid x:Name="StickerItemsGrid" Grid.Row="1" ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedLabel, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Single" SelectionUnit="FullRow" FontSize="11"
                              RowHeaderWidth="0" Background="White" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ORDER / PI" Binding="{Binding OrderDisplay}" Width="1.1*"/>
                            <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerCompanyName}" Width="1.15*"/>
                            <DataGridTextColumn Header="GLASS" Binding="{Binding GlassName}" Width="1.4*"/>
                            <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="0.9*"/>
                            <DataGridTextColumn Header="SIDE" Binding="{Binding PanePosition}" Width="0.7*"/>
                            <DataGridTextColumn Header="SOURCE QTY" Binding="{Binding Quantity}" Width="78"/>
                            <DataGridTextColumn Header="REF" Binding="{Binding Reference}" Width="1*"/>
                            <DataGridTextColumn Header="GLASS REF" Binding="{Binding GlassReference}" Width="1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0" LastChildFill="True">
            <TextBlock Text="{Binding StatusMessage}" DockPanel.Dock="Left" VerticalAlignment="Center"
                       FontSize="11" Foreground="#475467" TextWrapping="Wrap" MaxWidth="620"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save Layout" Click="SaveSettings_Click" Padding="16,8" Margin="0,0,8,0"
                        Background="White" BorderBrush="#98A2B3" BorderThickness="1"/>
                <Button Content="Print" Click="Print_Click" Padding="20,8" Margin="0,0,8,0"
                        Background="#175CD3" Foreground="White" BorderBrush="#175CD3" BorderThickness="1" IsDefault="True"/>
                <Button Content="Close" Click="Close_Click" Padding="16,8" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
