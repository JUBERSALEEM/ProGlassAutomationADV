<Window x:Class="ProGlassAutomation.Views.Printing.Stickers.StickerPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Sticker Printer Studio"
        Width="1540" Height="1020" MinWidth="1240" MinHeight="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Ov.Canvas}"
        Foreground="{DynamicResource Ov.Ink}"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Shared/Lists/StudioListResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="StickerFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Sl.Label}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource Ov.Muted}"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="StickerSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Ov.CardTitle}">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{DynamicResource Ov.Ink}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="StickerInput" TargetType="TextBox" BasedOn="{StaticResource Sl.Input}">
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="StickerCombo" TargetType="ComboBox" BasedOn="{StaticResource Sl.Combo}">
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="StickerButton" TargetType="Button" BasedOn="{StaticResource Sl.Button}">
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="StickerPrimaryButton" TargetType="Button" BasedOn="{StaticResource Sl.PrimaryButton}">
                <Setter Property="MinHeight" Value="42"/>
                <Setter Property="Padding" Value="16,8"/>
            </Style>
            <Style x:Key="StickerCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Ov.Ink}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="2"/>
            </Style>
            <Style x:Key="StickerGridCellText" TargetType="TextBlock" BasedOn="{StaticResource Sl.CellText}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="Margin" Value="4,3"/>
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Style>
            <Style x:Key="StickerGridCellTextCenter" TargetType="TextBlock" BasedOn="{StaticResource StickerGridCellText}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="StickerResizeThumbStyle" TargetType="{x:Type primitives:Thumb}">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                            <Border Background="{DynamicResource Ov.Surface}"
                                    BorderBrush="{DynamicResource Ov.Accent}"
                                    BorderThickness="1.5"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="StickerTemplateChoiceTemplate">
                <Grid MinWidth="250" Margin="2,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TemplateName}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ov.Ink}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding KindDisplayName}"
                                   FontSize="10" Foreground="{DynamicResource Ov.Muted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Ov.Soft}"
                            BorderBrush="{DynamicResource Ov.Line}" BorderThickness="1"
                            CornerRadius="8" Padding="8,3" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceLabel}"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource Ov.Accent}"/>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Studio Bento hero: clear module identity, helper text, and selected layout name. -->
        <Border Grid.Row="0" Style="{StaticResource Sl.Hero}" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="14"
                        Background="#33FFFFFF" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                               Foreground="{DynamicResource Ov.OnAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="STICKER PRINTER STUDIO" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ov.OnAccent}"/>
                    <TextBlock Text="Build a reusable label layout, resize objects on-canvas, and keep the same template ready for Step 5 and Optimization."
                               FontSize="12" Foreground="{DynamicResource Ov.OnAccentMuted}"
                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#26FFFFFF"
                        CornerRadius="12" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="ACTIVE LAYOUT" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource Ov.OnAccentMuted}"/>
                        <TextBlock Text="{Binding TemplateNameText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ov.OnAccent}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: editable controls are grouped into spacious Bento cards. -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <StackPanel>
                    <Border Style="{StaticResource Sl.Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PRINTER STYLE TEMPLATE" Style="{StaticResource StickerSectionTitle}"/>
                                    <TextBlock Text="Choose a preset or a saved layout" FontSize="11"
                                               Foreground="{DynamicResource Ov.Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource Ov.SuccessSoft}"
                                        CornerRadius="8" Padding="9,5" VerticalAlignment="Center">
                                    <TextBlock FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Saved"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Ov.Success}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTemplateDirty}" Value="True">
                                                        <Setter Property="Text" Value="Unsaved edits"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Ov.Warning}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                            <ComboBox x:Name="TemplateCombo" ItemsSource="{Binding TemplateChoices}"
                                      SelectedItem="{Binding SelectedTemplateChoice, Mode=OneWay}"
                                      ItemTemplate="{StaticResource StickerTemplateChoiceTemplate}"
                                      SelectionChanged="TemplateCombo_SelectionChanged"
                                      Style="{StaticResource StickerCombo}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Content="New custom" Tag="&#xE710;" Click="NewTemplate_Click" Style="{StaticResource StickerButton}"/>
                                <Button Grid.Column="2" Content="Open .pgsticker" Tag="&#xE8E5;"
                                        Click="OpenTemplate_Click" Style="{StaticResource StickerButton}"/>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Content="Save to library" Tag="&#xE74E;" Click="SaveTemplate_Click"
                                        Style="{StaticResource StickerPrimaryButton}"/>
                                <Button Grid.Column="2" Content="Export file…" Tag="&#xE74D;"
                                        Click="ExportTemplate_Click" Style="{StaticResource StickerButton}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Template name" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding TemplateNameText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Style family" Style="{StaticResource StickerFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding TemplateKindOptions}"
                                              DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                              SelectedValue="{Binding TemplateKind, Mode=TwoWay}"
                                              Style="{StaticResource StickerCombo}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Label background" Style="{StaticResource StickerFieldLabel}"/>
                                <TextBox Text="{Binding TemplateBackgroundText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource StickerInput}"
                                         ToolTip="Enter a #RRGGBB or #AARRGGBB colour."/>
                            </StackPanel>
                            <TextBlock Text="SGU, DGU and Proforma/Job presets are starting points. Saved templates contain layout only—not invoice or customer data."
                                       FontSize="11" Foreground="{DynamicResource Ov.Muted}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Sl.Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="LABEL STOCK &amp; REPEAT MODE" Style="{StaticResource StickerSectionTitle}"
                                       Margin="0,0,0,14"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Label width (mm)" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding WidthMmText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Label height (mm)" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding HeightMmText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Default inset (mm)" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding MarginMmText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="New text size (pt)" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding FontSizePtText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Print one sticker per physical glass piece"
                                      IsChecked="{Binding OneLabelPerPiece}"
                                      Style="{StaticResource StickerCheckBox}" Margin="0,0,0,5"/>
                            <TextBlock Text="Turn off to print one label per source row and show its total quantity."
                                       FontSize="11" Foreground="{DynamicResource Ov.Muted}"
                                       TextWrapping="Wrap" Margin="24,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Sl.Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LAYOUT OBJECTS" Style="{StaticResource StickerSectionTitle}"/>
                                    <TextBlock Text="Add, duplicate, reorder or remove label content" FontSize="11"
                                               Foreground="{DynamicResource Ov.Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource Ov.Soft}"
                                        CornerRadius="8" Padding="9,5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TemplateElements.Count, StringFormat='{}{0} objects'}"
                                               FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Ov.Accent}"/>
                                </Border>
                            </Grid>
                            <ListBox x:Name="TemplateElementsList" ItemsSource="{Binding TemplateElements}"
                                     SelectedItem="{Binding SelectedElement, Mode=TwoWay}"
                                     DisplayMemberPath="DisplayName" Height="136"
                                     Background="{DynamicResource Ov.Surface}"
                                     Foreground="{DynamicResource Ov.Ink}"
                                     BorderBrush="{DynamicResource Ov.Line}"
                                     ItemContainerStyle="{StaticResource Sl.ListItem}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            <Grid Margin="0,10,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Content="+ Text" Tag="&#xE8D2;" Click="AddText_Click" Style="{StaticResource StickerButton}"/>
                                <Button Grid.Column="2" Content="+ Logo" Tag="&#xE8B9;" Click="AddLogo_Click" Style="{StaticResource StickerButton}"/>
                                <Button Grid.Column="4" Content="+ Box" Tag="&#xE8A5;" Click="AddBox_Click" Style="{StaticResource StickerButton}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="FieldPicker" ItemsSource="{Binding FieldChoices}"
                                          DisplayMemberPath="Label" SelectedValuePath="Key"
                                          SelectedValue="{Binding NewFieldKey, Mode=TwoWay}"
                                          Style="{StaticResource StickerCombo}"
                                          ToolTip="Select a source value to add"/>
                                <Button Grid.Column="2" Content="Add field" Tag="&#xE710;" Click="AddField_Click"
                                        Style="{StaticResource StickerButton}"/>
                                <Button Grid.Column="4" Content="+ Line" Tag="&#xE8A3;" Click="AddLine_Click"
                                        Style="{StaticResource StickerButton}"/>
                            </Grid>
                            <UniformGrid Columns="4">
                                <Button Content="Duplicate" Tag="&#xE8C8;" Click="DuplicateElement_Click"
                                        IsEnabled="{Binding HasSelectedElement}" Style="{StaticResource StickerButton}" Margin="0,0,6,0"/>
                                <Button Content="Delete" Tag="&#xE74D;" Click="DeleteElement_Click"
                                        IsEnabled="{Binding HasSelectedElement}" Style="{StaticResource StickerButton}" Margin="0,0,6,0"/>
                                <Button Content="Send back" Tag="&#xE74A;" ToolTip="Send selected object behind the previous layer"
                                        Click="SendBackward_Click" IsEnabled="{Binding HasSelectedElement}"
                                        Style="{StaticResource StickerButton}" Margin="0,0,6,0"/>
                                <Button Content="Bring front" Tag="&#xE74B;" ToolTip="Bring selected object in front of the next layer"
                                        Click="BringForward_Click" IsEnabled="{Binding HasSelectedElement}"
                                        Style="{StaticResource StickerButton}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Sl.Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel IsEnabled="{Binding HasSelectedElement}">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SELECTED OBJECT" Style="{StaticResource StickerSectionTitle}"/>
                                    <TextBlock Text="Edit content, size, position and typography" FontSize="11"
                                               Foreground="{DynamicResource Ov.Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource Ov.Soft}"
                                        CornerRadius="8" Padding="9,5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedElement.Kind}"
                                               FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Ov.Accent}"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Object name" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.Name, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Data field" Style="{StaticResource StickerFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding FieldChoices}" DisplayMemberPath="Label"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding SelectedElement.FieldKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource StickerCombo}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Text / content" Style="{StaticResource StickerFieldLabel}"/>
                            <TextBox Text="{Binding SelectedElement.Text, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="76" MaxHeight="130" VerticalContentAlignment="Top"
                                     Style="{StaticResource StickerInput}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Prefix" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.Prefix, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Suffix" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.Suffix, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                            </Grid>
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="X position (mm)" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.Xmm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding CanMoveSelectedElement}" Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Y position (mm)" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.Ymm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding CanMoveSelectedElement}" Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Width (mm)" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.WidthMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Height (mm)" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.HeightMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                            </UniformGrid>
                            <Border Background="{DynamicResource Ov.Soft}" BorderBrush="{DynamicResource Ov.Line}"
                                    BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="MOVE &amp; RESIZE" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource Ov.Accent}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Drag an object to move it. Use the 1 mm buttons for fine placement; drag the visible handles to expand or reduce width and height."
                                               FontSize="11" Foreground="{DynamicResource Ov.Muted}"
                                               TextWrapping="Wrap" Margin="0,0,0,9"/>
                                    <Grid IsEnabled="{Binding CanMoveSelectedElement}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Content="← 1 mm" Tag="&#xE76B;" Click="MoveLeft_Click" Style="{StaticResource StickerButton}"/>
                                        <Button Grid.Column="2" Content="↑ 1 mm" Tag="&#xE74A;" Click="MoveUp_Click" Style="{StaticResource StickerButton}"/>
                                        <Button Grid.Column="4" Content="↓ 1 mm" Tag="&#xE74B;" Click="MoveDown_Click" Style="{StaticResource StickerButton}"/>
                                        <Button Grid.Column="6" Content="→ 1 mm" Tag="&#xE76C;" Click="MoveRight_Click" Style="{StaticResource StickerButton}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Font family" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.FontFamily, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                                <StackPanel Margin="3,0,3,0">
                                    <TextBlock Text="Font size (pt)" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.FontSizePt, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Rotation (°)" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.RotationDegrees, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Text colour" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.Foreground, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                                <StackPanel Margin="3,0,3,0">
                                    <TextBlock Text="Fill colour" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.Background, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Border colour" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.BorderColor, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Border width (mm)" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.BorderWidthMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Padding (mm)" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.PaddingMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Horizontal alignment" Style="{StaticResource StickerFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding DataContext.TextAlignments, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding SelectedElement.TextAlignment, Mode=TwoWay}"
                                              Style="{StaticResource StickerCombo}"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Vertical alignment" Style="{StaticResource StickerFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding DataContext.ContentAlignments, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding SelectedElement.ContentAlignment, Mode=TwoWay}"
                                              Style="{StaticResource StickerCombo}"/>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Opacity (0–1)" Style="{StaticResource StickerFieldLabel}"/>
                                    <TextBox Text="{Binding SelectedElement.Opacity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource StickerInput}"/>
                                </StackPanel>
                                <TextBlock Text="1 = fully opaque · 0 = transparent"
                                           FontSize="11" Foreground="{DynamicResource Ov.Muted}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Margin="6,0,0,0"/>
                            </UniformGrid>
                            <WrapPanel Margin="0,2,0,0">
                                <CheckBox Content="Bold" IsChecked="{Binding SelectedElement.Bold}"
                                          Style="{StaticResource StickerCheckBox}" Margin="0,0,14,8"/>
                                <CheckBox Content="Italic" IsChecked="{Binding SelectedElement.Italic}"
                                          Style="{StaticResource StickerCheckBox}" Margin="0,0,14,8"/>
                                <CheckBox Content="Underline" IsChecked="{Binding SelectedElement.Underline}"
                                          Style="{StaticResource StickerCheckBox}" Margin="0,0,14,8"/>
                                <CheckBox Content="Visible" IsChecked="{Binding SelectedElement.IsVisible}"
                                          Style="{StaticResource StickerCheckBox}" Margin="0,0,14,8"/>
                                <CheckBox Content="Hide if blank" IsChecked="{Binding SelectedElement.HideWhenEmpty}"
                                          Style="{StaticResource StickerCheckBox}" Margin="0,0,14,8"/>
                                <CheckBox Content="Lock position" IsChecked="{Binding SelectedElement.IsLocked}"
                                          Style="{StaticResource StickerCheckBox}" Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: large preview and live source verification. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.35*"/>
                    <RowDefinition Height="0.85*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Sl.Card}" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <Border x:Name="DesignOnlyBanner" Visibility="Collapsed"
                                    Background="{DynamicResource Ov.WarningSoft}"
                                    BorderBrush="{DynamicResource Ov.Warning}" BorderThickness="1"
                                    CornerRadius="10" Padding="12,9" Margin="0,0,0,10">
                                <TextBlock Text="DESIGN-ONLY PREVIEW — sample values are placeholders. Printing is disabled here; Step 5 and Optimization use the saved layout."
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Ov.Warning}" TextWrapping="Wrap"/>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LIVE LABEL PREVIEW" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource Ov.Muted}"/>
                                    <TextBlock x:Name="PreviewTemplateName" Text="{Binding TemplateNameText}"
                                               Style="{StaticResource StickerSectionTitle}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource Ov.Soft}"
                                        BorderBrush="{DynamicResource Ov.Line}" BorderThickness="1"
                                        CornerRadius="10" Padding="11,7" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EstimatedLabelCountText}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Ov.Accent}"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <Border x:Name="PreviewSurface" Grid.Row="1"
                                Background="{DynamicResource Ov.Soft}"
                                BorderBrush="{DynamicResource Ov.Line}" BorderThickness="1"
                                CornerRadius="14" Padding="22">
                            <ContentControl x:Name="PreviewHost"/>
                        </Border>
                        <TextBlock x:Name="PreviewExplanation" Grid.Row="2"
                                   Text="Drag an object to move it. Select it to expose resize handles, then adjust exact values in millimetres in the inspector."
                                   FontSize="11" Foreground="{DynamicResource Ov.Muted}"
                                   Margin="2,10,2,0" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Sl.Card}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SOURCE LABELS" Style="{StaticResource StickerSectionTitle}"/>
                                <TextBlock Text="Verify order, customer, glass type, side, size, quantity and references."
                                           FontSize="11" Foreground="{DynamicResource Ov.Muted}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="SourceLabelsHeader" Grid.Column="1"
                                       Text="REAL SOURCE ROWS" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource Ov.Accent}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <DataGrid x:Name="StickerItemsGrid" Grid.Row="1" ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedLabel, Mode=TwoWay}"
                                  Style="{StaticResource Sl.DataGrid}"
                                  ColumnHeaderStyle="{StaticResource Sl.DataGridHeader}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  SelectionMode="Single" SelectionUnit="FullRow" FontSize="12"
                                  RowHeaderWidth="0" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ORDER / PI" Binding="{Binding OrderDisplay}" Width="1.1*" ElementStyle="{StaticResource StickerGridCellText}"/>
                                <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerCompanyName}" Width="1.1*" ElementStyle="{StaticResource StickerGridCellText}"/>
                                <DataGridTextColumn Header="TYPE" Binding="{Binding GlassType}" Width="0.6*" ElementStyle="{StaticResource StickerGridCellTextCenter}"/>
                                <DataGridTextColumn Header="GLASS" Binding="{Binding GlassName}" Width="1.3*" ElementStyle="{StaticResource StickerGridCellText}"/>
                                <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="0.9*" ElementStyle="{StaticResource StickerGridCellTextCenter}"/>
                                <DataGridTextColumn Header="SIDE" Binding="{Binding PanePosition}" Width="0.7*" ElementStyle="{StaticResource StickerGridCellText}"/>
                                <DataGridTextColumn Header="SOURCE QTY" Binding="{Binding Quantity}" Width="78" ElementStyle="{StaticResource StickerGridCellTextCenter}"/>
                                <DataGridTextColumn Header="REF" Binding="{Binding Reference}" Width="1*" ElementStyle="{StaticResource StickerGridCellText}"/>
                                <DataGridTextColumn Header="GLASS REF" Binding="{Binding GlassReference}" Width="1*" ElementStyle="{StaticResource StickerGridCellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Full-width bento action bar keeps status and actions aligned and touchable. -->
        <Border Grid.Row="2" Style="{StaticResource Sl.Card}" Padding="12,10" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="4,0,14,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="{DynamicResource Ov.Muted}" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxWidth="760"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save setup" Tag="&#xE74E;" Click="SaveSettings_Click"
                            Style="{StaticResource StickerButton}" Margin="0,0,8,0"/>
                    <Button x:Name="PrintButton" Content="Print stickers" Tag="&#xE749;"
                            Click="Print_Click" IsDefault="True"
                            Style="{StaticResource StickerPrimaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Close" Tag="&#xE8BB;" Click="Close_Click" IsCancel="True"
                            Style="{StaticResource StickerButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
