<Window x:Class="ProGlassAutomation.Views.Sharing.ShareComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Sharing.Title}"
        Width="640"
        Height="780"
        MinWidth="600"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Liquid glass card, theme-driven (InvoiceApprovalDialog pattern).
         FIXED window height; the middle column scrolls, so showing the
         manual-contact editor or the outcome panel never moves the card. -->
    <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}"
            Margin="24,20,24,28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4"
                              Opacity="0.28" Color="{DynamicResource LiquidShadowColor}"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <Grid Grid.Row="0" Margin="28,22,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource TintIndigoBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}">
                    <TextBlock Text="&#xE72D;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextTitle}"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,8,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Sharing.Title}"
                               FontSize="{StaticResource TextBodyLarge}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding DocumentTitle, Mode=OneWay}"
                               FontSize="{StaticResource TextBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CustomerLine, Mode=OneWay}"
                               FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="{StaticResource TextBody}"
                        Width="36" Height="36"
                        Cursor="Hand"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="{DynamicResource Border.NoneThickness}"
                        Foreground="{DynamicResource MutedForegroundBrush}"
                        Command="{Binding CloseCommand}"
                        ToolTip="{DynamicResource Sharing.Close}"/>
            </Grid>

            <!-- ═══ BODY (scrolls) ═══ -->
            <ScrollViewer Grid.Row="1"
                          Margin="28,16,20,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,8">

                    <!-- FROM -->
                    <TextBlock Text="{DynamicResource Sharing.From}"
                               FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="2,0,0,6"/>
                    <Border CornerRadius="{DynamicResource CardCornerRadius}"
                            Background="{DynamicResource ElevatedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                            Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{Binding SenderLine, Mode=OneWay}"
                                       FontSize="{StaticResource TextBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SenderContactLine, Mode=OneWay}"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- TO -->
                    <TextBlock Text="{DynamicResource Sharing.To}"
                               FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="2,14,0,6"/>
                    <Border CornerRadius="{DynamicResource CardCornerRadius}"
                            Background="{DynamicResource ElevatedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                            Padding="14,10">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding RecipientOptions}"
                                      SelectedItem="{Binding SelectedRecipient, Mode=TwoWay}"
                                      IsEnabled="{Binding IsNotBusy}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayLine}"
                                                       FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <TextBlock Text="{Binding ContactLine}"
                                                       FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Manual fallback editor -->
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding IsManualRecipient, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Sharing.ManualName}"
                                           FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           Margin="2,0,0,4"/>
                                <TextBox Text="{Binding ManualName, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="{StaticResource TextBody}"
                                         Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Sharing.ManualPhone}"
                                           FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           Margin="2,0,0,4"/>
                                <TextBox Text="{Binding ManualPhone, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="{StaticResource TextBody}"
                                         Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Sharing.ManualEmail}"
                                           FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           Margin="2,0,0,4"/>
                                <TextBox Text="{Binding ManualEmail, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="{StaticResource TextBody}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ATTACHMENTS -->
                    <TextBlock Text="{DynamicResource Sharing.Attachments}"
                               FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="2,14,0,6"/>
                    <Border CornerRadius="{DynamicResource CardCornerRadius}"
                            Background="{DynamicResource ElevatedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                            Padding="14,10">
                        <ItemsControl ItemsSource="{Binding Artifacts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="&#xE7B8;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="340"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- MESSAGE -->
                    <TextBlock Text="{DynamicResource Sharing.Message}"
                               FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="2,14,0,6"/>
                    <Border CornerRadius="{DynamicResource CardCornerRadius}"
                            Background="{DynamicResource ElevatedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                            Padding="14,10">
                        <StackPanel>
                            <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{StaticResource TextBody}"
                                     FontWeight="SemiBold"
                                     Margin="0,0,0,8"
                                     Visibility="{Binding SubjectVisible, Converter={StaticResource BoolToVis}}"/>
                            <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{StaticResource TextBody}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="110"
                                     MaxHeight="180"
                                     VerticalScrollBarVisibility="Auto"
                                     IsEnabled="{Binding AllowMessageEdit}"/>
                        </StackPanel>
                    </Border>

                    <!-- PROVIDERS -->
                    <TextBlock Text="{DynamicResource Sharing.ShareVia}"
                               FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="2,14,0,6"/>
                    <ItemsControl ItemsSource="{Binding ProviderOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectProviderCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsAvailable}"
                                        ToolTip="{Binding DisabledReason}"
                                        Margin="0,0,8,0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource OutlinedPillButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Provider.DisplayName}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Honesty note -->
                    <TextBlock Text="{DynamicResource Sharing.HonestyNote}"
                               FontSize="{StaticResource TextCaption}"
                               FontStyle="Italic"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="2,10,0,0"/>

                    <!-- OUTCOME -->
                    <Border Margin="0,12,0,0"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                            Padding="14,10"
                            Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="{DynamicResource ElevatedSurfaceBrush}"/>
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource BorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OutcomeIsSuccess}" Value="True">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OutcomeIsSuccess}" Value="False">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding LastOutcome.Message}"
                                       FontSize="{StaticResource TextBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding LastOutcome.FollowUp}"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Status line -->
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"
                               Margin="2,10,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ BUTTONS ═══ -->
            <Grid Grid.Row="2" Margin="28,12,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{DynamicResource Sharing.NothingSendsAutomatically}"
                           FontSize="{StaticResource TextCaption}"
                           FontStyle="Italic"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <Button Grid.Column="1"
                        Content="{DynamicResource Sharing.Share}"
                        Style="{StaticResource PrimaryPillButton}"
                        Command="{Binding ShareCommand}"
                        IsDefault="True"
                        MinWidth="130"
                        Cursor="Hand"/>
                <Button Grid.Column="3"
                        Content="{DynamicResource Sharing.Close}"
                        Style="{StaticResource OutlinedPillButton}"
                        Command="{Binding CloseCommand}"
                        IsCancel="True"
                        MinWidth="110"
                        Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>
