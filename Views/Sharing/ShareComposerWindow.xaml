<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.Sharing.ShareComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
        Title="{DynamicResource Sharing.Title}"
        Width="640" Height="700"
        MinWidth="600" MinHeight="440"
        ResizeMode="CanResize"
        DialogIcon="&#xE72D;"
        DialogSubtitle="{Binding DocumentTitle, Mode=OneWay}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- 2026-09 dialog audit: the glass card, header (icon badge + title +
         document subtitle) and footer strip now come from the shared
         ThemedDialogWindow chrome; this file keeps only the composer body.
         The window is resizable and clamped to the work area (the old fixed
         780px height clipped on 1366×768 laptops). -->
    <StackPanel>
        <TextBlock Text="{Binding CustomerLine, Mode=OneWay}"
                   FontSize="{StaticResource TextCaption}"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

                    <!-- FROM -->
                    <TextBlock Text="{DynamicResource Sharing.From}"
                               FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="2,0,0,6"/>
                    <Border CornerRadius="{DynamicResource CardCornerRadius}"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                            Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{Binding SenderLine, Mode=OneWay}"
                                       FontSize="{StaticResource TextBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SenderContactLine, Mode=OneWay}"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- TO -->
                    <TextBlock Text="{DynamicResource Sharing.To}"
                               FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="2,14,0,6"/>
                    <Border CornerRadius="{DynamicResource CardCornerRadius}"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                            Padding="14,10">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding RecipientOptions}"
                                      SelectedItem="{Binding SelectedRecipient, Mode=TwoWay}"
                                      IsEnabled="{Binding IsNotBusy}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayLine}"
                                                       FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding ContactLine}"
                                                       FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Manual fallback editor -->
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding IsManualRecipient, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Sharing.ManualName}"
                                           FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="2,0,0,4"/>
                                <TextBox Text="{Binding ManualName, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="{StaticResource TextBody}"
                                         Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Sharing.ManualPhone}"
                                           FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="2,0,0,4"/>
                                <TextBox Text="{Binding ManualPhone, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="{StaticResource TextBody}"
                                         Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Sharing.ManualEmail}"
                                           FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="2,0,0,4"/>
                                <TextBox Text="{Binding ManualEmail, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="{StaticResource TextBody}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ATTACHMENTS -->
                    <TextBlock Text="{DynamicResource Sharing.Attachments}"
                               FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="2,14,0,6"/>
                    <Border CornerRadius="{DynamicResource CardCornerRadius}"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                            Padding="14,10">
                        <ItemsControl ItemsSource="{Binding Artifacts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="&#xE7B8;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="340"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- MESSAGE -->
                    <TextBlock Text="{DynamicResource Sharing.Message}"
                               FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="2,14,0,6"/>
                    <Border CornerRadius="{DynamicResource CardCornerRadius}"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                            Padding="14,10">
                        <StackPanel>
                            <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{StaticResource TextBody}"
                                     FontWeight="SemiBold"
                                     Margin="0,0,0,8"
                                     Visibility="{Binding SubjectVisible, Converter={StaticResource BoolToVis}}"/>
                            <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{StaticResource TextBody}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="110"
                                     MaxHeight="180"
                                     VerticalScrollBarVisibility="Auto"
                                     IsEnabled="{Binding AllowMessageEdit}"/>
                        </StackPanel>
                    </Border>

                    <!-- PROVIDERS -->
                    <TextBlock Text="{DynamicResource Sharing.ShareVia}"
                               FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="2,14,0,6"/>
                    <ItemsControl ItemsSource="{Binding ProviderOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectProviderCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsAvailable}"
                                        ToolTip="{Binding DisabledReason}"
                                        Margin="0,0,8,0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource OutlinedPillButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Provider.DisplayName}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Honesty note -->
                    <TextBlock Text="{DynamicResource Sharing.HonestyNote}"
                               FontSize="{StaticResource TextCaption}"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextWrapping="Wrap"
                               Margin="2,10,0,0"/>

                    <!-- OUTCOME -->
                    <Border Margin="0,12,0,0"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                            Padding="14,10"
                            Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="{DynamicResource SurfaceSecondaryBrush}"/>
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource BorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OutcomeIsSuccess}" Value="True">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OutcomeIsSuccess}" Value="False">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding LastOutcome.Message}"
                                       FontSize="{StaticResource TextBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding LastOutcome.FollowUp}"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Status line -->
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"
                               Margin="2,10,0,0"/>

            <!-- ═══ BUTTONS ═══ -->
                </StackPanel>

    <dialogs:ThemedDialogWindow.FooterContent>
<Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{DynamicResource Sharing.NothingSendsAutomatically}"
                           FontSize="{StaticResource TextCaption}"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <Button Grid.Column="1"
                        Content="{DynamicResource Sharing.Share}"
                        Style="{StaticResource PrimaryPillButton}"
                        Command="{Binding ShareCommand}"
                        IsDefault="True"
                        MinWidth="130"
                        Cursor="Hand"/>
                <Button Grid.Column="3"
                        Content="{DynamicResource Sharing.Close}"
                        Style="{StaticResource OutlinedPillButton}"
                        Command="{Binding CloseCommand}"
                        IsCancel="True"
                        MinWidth="110"
                        Cursor="Hand"/>
            </Grid>
    </dialogs:ThemedDialogWindow.FooterContent>
</dialogs:ThemedDialogWindow>
