<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/AboutIos26Theme.xaml
     PROJECT: ProGlassAutomation
     MODULE: About — self-contained iOS-26 Liquid Glass palette

     2026-09-15 owner directive: "I want exactly liquid glass style and
     every card matching the mockups. Ignore the current theme if that's
     the problem." The About module is therefore rendered from THIS
     fixed palette — the approved mockup set (about-ios26-01..06) —
     instead of the app's Live theme tokens. Light / Dark / visual
     family switches in Settings no longer re-tint the About page
     (deliberate, approved).

     Every brush / radius / card style / progress-bar / button on the
     About module resolves to a key defined here. The view files stay
     token-only (no hex, no literal corner radii — the audit locks
     keep enforcing that); all the fixed values live in exactly this
     one dictionary.
═══════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ═══ CANVAS ═══ — pastel mesh the glass floats on -->
    <SolidColorBrush x:Key="Ios26CanvasBrush" Color="#F1F5FB" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26OrbTealBrush"   Color="#BFE8E3" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26OrbBlueBrush"   Color="#C5D8F6" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26OrbLavenderBrush" Color="#CFD4F5" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26OrbGreenBrush"  Color="#D2EBD6" po:Freeze="True"/>

    <!-- ═══ GLASS SURFACES ═══ -->
    <!-- Frosted card: 80 % white over the pastel mesh. -->
    <SolidColorBrush x:Key="Ios26CardBrush"      Color="#CCFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26CardBorderBrush" Color="#99FFFFFF" po:Freeze="True"/>
    <!-- Frosted rail: 60 % white. -->
    <SolidColorBrush x:Key="Ios26RailBrush"      Color="#99FFFFFF" po:Freeze="True"/>
    <!-- Solid white tiles inside cards. -->
    <SolidColorBrush x:Key="Ios26TileBrush"      Color="#FFFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26TileBorderBrush" Color="#E8EDF3" po:Freeze="True"/>
    <!-- Hairlines + tracks. -->
    <SolidColorBrush x:Key="Ios26HairlineBrush"  Color="#E2E8F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26TrackBrush"     Color="#E2E8F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26HoverBrush"     Color="#E6ECF3" po:Freeze="True"/>

    <!-- ═══ TEXT ═══ -->
    <SolidColorBrush x:Key="Ios26TextTitleBrush"    Color="#0F172A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26TextBodyBrush"     Color="#1E293B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26TextSecondaryBrush" Color="#475569" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26TextMutedBrush"    Color="#64748B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26TextFaintBrush"    Color="#94A3B8" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26OnAccentBrush"     Color="#FFFFFFFF" po:Freeze="True"/>
    <!-- 25 % white — the "ACTIVE" chip inside the selected rail pill. -->
    <SolidColorBrush x:Key="Ios26OnAccentChipBrush" Color="#40FFFFFF" po:Freeze="True"/>

    <!-- ═══ ACCENT / STATUS ═══ -->
    <SolidColorBrush x:Key="Ios26AccentBrush"        Color="#0369A1" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26AccentDeepBrush"    Color="#075985" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26AccentSoftBrush"    Color="#DBEAFE" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26AccentSoftTextBrush" Color="#1D4ED8" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26SuccessBrush"       Color="#16A34A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26SuccessSoftBrush"   Color="#DCFCE7" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26ValuePillBrush"     Color="#F1F5F9" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26SearchBrush"        Color="#EDF1F7" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26NumberBrush"        Color="#93C5FD" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ios26DangerDotBrush"     Color="#FB7185" po:Freeze="True"/>

    <!-- ═══ CORNER RADII (mockup: 26 px cards, 10 px icon tiles,
         12 px inner tiles, 999 = full pill) ═══ -->
    <CornerRadius x:Key="Ios26RadiusCard">26</CornerRadius>
    <CornerRadius x:Key="Ios26RadiusInner">12</CornerRadius>
    <CornerRadius x:Key="Ios26RadiusTile">10</CornerRadius>
    <CornerRadius x:Key="Ios26RadiusPill">999</CornerRadius>

    <!-- ═══ CARD SHADOW (one shared, frozen instance) ═══ -->
    <DropShadowEffect x:Key="Ios26CardShadow"
                      Color="#334155" Opacity="0.10"
                      BlurRadius="24" ShadowDepth="10" Direction="90"
                      po:Freeze="True"/>

    <!-- ═══ L1 CARD — the frosted 26 px slab ═══ -->
    <Style x:Key="Ios26CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ios26CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ios26CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusCard}"/>
        <Setter Property="Padding" Value="22,20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect" Value="{DynamicResource Ios26CardShadow}"/>
    </Style>

    <!-- ═══ INNER TILE — solid white panel inside a card.
         AboutInsetStyle is the same chrome kept under its historic
         key so existing sub-panel markup keeps working. ═══ -->
    <Style x:Key="Ios26InnerTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ios26TileBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ios26TileBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusInner}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="AboutInsetStyle" TargetType="Border"
           BasedOn="{StaticResource Ios26InnerTileStyle}"/>

    <!-- ═══ ICON TILE — soft-blue square with a glyph ═══ -->
    <Style x:Key="Ios26IconTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ios26AccentSoftBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusTile}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═══ SOFT CHIP — light-blue capsule ═══ -->
    <Style x:Key="Ios26ChipSoftStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ios26AccentSoftBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusPill}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═══ GREEN CHIP — "Active" pills ═══ -->
    <Style x:Key="Ios26ChipGreenStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ios26SuccessSoftBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusPill}"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═══ VALUE PILL — grey id / fingerprint capsules ═══ -->
    <Style x:Key="Ios26ValuePillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ios26ValuePillBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusTile}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═══ GHOST BUTTON — white pill with hairline border
         (mockup: Refresh / Open Folder / Clear All / OPEN / Open).
         Replaces the old accent-based pill button on this module. -->
    <Style x:Key="AboutPillButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextBodyBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PillBg"
                            Background="{DynamicResource Ios26TileBrush}"
                            BorderBrush="{DynamicResource Ios26HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Ios26RadiusPill}"
                            Padding="14,8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PillBg"
                                    Property="Background"
                                    Value="{DynamicResource Ios26HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PillBg"
                                    Property="Background"
                                    Value="{DynamicResource Ios26TrackBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ ROUNDED PROGRESS BAR (mockup countdown / engine bars).
         Value/Maximum must still be bound OneWay where the source is
         read-only (ERR-3C0789 — that was a binding-mode bug, not a
         template bug; the template does not change that contract). -->
    <Style x:Key="Ios26BarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Ios26TrackBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="999" SnapsToDevicePixels="True"/>
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="999"
                                HorizontalAlignment="Left"
                                SnapsToDevicePixels="True"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
