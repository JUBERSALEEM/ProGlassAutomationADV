<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/AboutIos26Theme.xaml
     PROJECT: ProGlassAutomation
     MODULE: About — STRUCTURE ONLY (radii, elevation, styles, templates)

     2026-09-15 owner directive: "convert all cards and fonts safely move
     to dynamic so this about module can adapt the theme style … Keeping
     the cards as it is design."

     WHAT CHANGED AND WHY
     ────────────────────
     This file used to declare the module's whole palette AND its type
     scale — 72 keys, none of which the theme layer could reach, because a
     dictionary merged locally by each About view SHADOWS
     Application.Resources. The module was therefore frozen: Light / Dark /
     density switched everything else in the app and nothing on About.

     Values now live where a theme switch and the density publisher can
     reach them:
       • 25 palette brushes  → Themes/LightTheme.xaml + DarkTheme.xaml
                               (light column = the approved mockup
                               literals, verbatim; dark column mapped)
       • 5 stage colours     → Themes/Styles/AppStage.xaml (invariant:
                               "Background page dont make it dynamic")
       • 15 type sizes       → Themes/Styles/AboutTypeScale.xaml
                               (rewritten in place per density profile)

     The key NAMES did not move. Every consumer still writes
     {DynamicResource Ios26CardBrush} / {DynamicResource Ios26FontSizeBody},
     so the approved design cannot drift through a rename.

     KEEP IT THIS WAY
     ────────────────
     A palette value or a font size must never be re-declared here again:
     that would silently re-freeze the module. The audit lock
     About_palette_and_type_scale_are_theme_owned_not_locally_frozen scans
     this file and fails on any Ios26* brush or size declaration outside
     the allow-list below (6 radii + the card shadow).
═══════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">



    <!-- ═══ CORNER RADII — the live scale lives in
         Themes/Styles/AboutSurface.xaml and is republished from the app's
         card-radius authority by Services/Theme/AboutSurfaceTokens.cs.
         A copy here would SHADOW that (a locally merged key wins the
         lookup), which is exactly why the About cards ignored both the
         Appearance corner slider and the visual family engines.
         Only the bar's full round stays: it is not a card. ═══
         (mockup card values: 26 cards / 10 icon tiles / 12 inner / 12 chips) ═══
         2026-09-15 owner correction: "Remove this nonsense 999
         rounded corner buttons." Chips and buttons now use 12 px
         (Ios26RadiusChip).
         2026-09-19 owner correction: remove CornerRadius=999 COMPLETELY —
         the one surviving 999 (the thin progress bar) is also now 12 px;
         no full-pill radius remains anywhere in the app. -->
    <!-- Bar radius — 12 px per the global 12 px / customer-dynamic rule. -->
    <CornerRadius x:Key="Ios26RadiusBar">12</CornerRadius>


    <!-- ═══ TYPE SCALE — lives in Themes/Styles/AboutTypeScale.xaml.
         Declared at APPLICATION level so the density publisher can
         rewrite it in place; a copy here would shadow it and re-freeze
         the module. Read the snapping / weight rules there. ═══ -->

    <!-- ═══ TYPE ROLE STYLES — the three text roles that repeat most
         often on this module. Colour comes from the live Ios26 palette
         (theme-owned, see the header), so a role style never re-introduces
         a magic value. ═══ -->

    <!-- Card / section title: 17 px Bold, title ink. -->
    <Style x:Key="Ios26CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeCardTitle}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextTitleBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Label/value row on the left: 13 px Regular, muted ink. -->
    <Style x:Key="Ios26FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Regular}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Label/value row on the right: 14 px SemiBold, body ink. -->
    <Style x:Key="Ios26FieldValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeValue}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextBodyBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>


    <!-- ═══ CARD SHADOW — lives in Themes/Styles/AboutSurface.xaml
         (app-level) so the Settings module can compose the same
         card. A DropShadowEffect declared here is invisible to
         every other module. ═══ -->

    <!-- ═══ L1 CARD — indigo bento slab. Soft indigo fill and a real
         indigo edge so About cards read as the studio bento, not white
         slabs on a pale canvas. ═══ -->
    <!-- Same face and edge the Settings plate publishes. A local accent
         fill is why an About card ignored the picked colour. Unspecified
         edges let the corner take that stroke. -->
    <Style x:Key="Ios26CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SettingsCardFaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardEdgeBrush}"/>
        <!-- Live brush for the corner ring. The native stroke is hidden
             while this is drawn, so a defined edge is one line, not two. -->
        <Setter Property="behaviors:RoundedEdgeStrokeBehavior.EdgeBrush" Value="{DynamicResource SettingsCardEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource CardEdgeThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusCard}"/>
        <Setter Property="Padding" Value="{DynamicResource AboutCardPadding}"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
        <Setter Property="RenderOptions.EdgeMode" Value="Unspecified"/>
        <Setter Property="behaviors:RoundedEdgeStrokeBehavior.IsEnabled" Value="True"/>
        <Setter Property="Effect" Value="{DynamicResource Ios26CardShadow}"/>
    </Style>

    <!-- Sidebar card. Same edge as the page cards, no inset and no shadow,
         so the rail does not eat the nav or paint over the content column. -->
    <Style x:Key="AboutRailSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SettingsCardFaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardEdgeBrush}"/>
        <Setter Property="behaviors:RoundedEdgeStrokeBehavior.EdgeBrush" Value="{DynamicResource SettingsCardEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource CardEdgeThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusCard}"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
        <Setter Property="RenderOptions.EdgeMode" Value="Unspecified"/>
        <Setter Property="behaviors:RoundedEdgeStrokeBehavior.IsEnabled" Value="True"/>
    </Style>

    <!-- ═══ INNER TILE — solid white panel inside a card.
         AboutInsetStyle is the same chrome kept under its historic
         key so existing sub-panel markup keeps working. ═══ -->
    <Style x:Key="Ios26InnerTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SettingsInnerFaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusInner}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
        <Setter Property="RenderOptions.EdgeMode" Value="Unspecified"/>
        <Setter Property="behaviors:RoundedEdgeStrokeBehavior.IsEnabled" Value="True"/>
    </Style>
    <Style x:Key="AboutInsetStyle" TargetType="Border"
           BasedOn="{StaticResource Ios26InnerTileStyle}"/>

    <!-- ═══ ICON TILE — soft-blue square with a glyph ═══ -->
    <Style x:Key="Ios26IconTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ios26AccentSoftBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusTile}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═══ SOFT CHIP — light-blue capsule ═══ -->
    <Style x:Key="Ios26ChipSoftStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ios26AccentSoftBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusChip}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═══ GREEN CHIP — "Active" pills ═══ -->
    <Style x:Key="Ios26ChipGreenStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ios26SuccessSoftBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusChip}"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═══ VALUE PILL — grey id / fingerprint capsules ═══ -->
    <Style x:Key="Ios26ValuePillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ios26ValuePillBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusTile}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═══ GHOST BUTTON — white pill with hairline border
         (mockup: Refresh / Open Folder / Clear All / OPEN / Open).
         Replaces the old accent-based pill button on this module. -->
    <Style x:Key="AboutPillButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextBodyBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PillBg"
                            Background="{DynamicResource Ios26TileBrush}"
                            BorderBrush="{DynamicResource Ios26HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Ios26RadiusChip}"
                            Padding="14,0"
                            Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PillBg"
                                    Property="Background"
                                    Value="{DynamicResource Ios26HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PillBg"
                                    Property="Background"
                                    Value="{DynamicResource Ios26TrackBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ ROUNDED PROGRESS BAR (mockup countdown / engine bars).
         Value/Maximum must still be bound OneWay where the source is
         read-only (ERR-3C0789 — that was a binding-mode bug, not a
         template bug; the template does not change that contract). -->
    <Style x:Key="Ios26BarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Ios26TrackBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Ios26RadiusBar}" SnapsToDevicePixels="True"/>
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{DynamicResource Ios26RadiusBar}"
                                HorizontalAlignment="Left"
                                SnapsToDevicePixels="True"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
