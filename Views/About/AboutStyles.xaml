<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/AboutStyles.xaml
     PROJECT: ProGlassAutomation
     MODULE: About — shared glass visual language (v6)

     ONE source of truth for the About page. Merged by:
       • AboutView.xaml                       (shell: glass stage + hero + tabs)
       • Sections/AboutOverviewSection.xaml
       • Sections/ModulesSection.xaml
       • Sections/DeveloperSection.xaml

     Glass identity (matches the Splash / Login glass stage):
       • deep-navy aurora backdrop + soft orbs
       • frosted glass cards (translucent white gradient, 1px light border,
         top sheen, soft shadow)
       • light glass text (Ice / Frost / Cerulean)
       • accent-aware glass highlights that follow the live theme family

     All corners are the canonical 12px (CardCornerRadius etc). No pill.
═══════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ═══ PALETTE — lives in the THEME dictionaries (2026-08-25) ═══
         LiquidIce / LiquidFrost / LiquidCerulean / LiquidSnow /
         LiquidAccent / LiquidAccentDeep / LiquidMuted / LiquidCard /
         LiquidSheen / LiquidOrbA / LiquidOrbB are defined in
         Themes/DarkTheme.xaml (light-frost values) and
         Themes/LightTheme.xaml (dark-ink values).

         They were moved out of this dictionary on purpose: a palette
         defined HERE (merged per-view) shadows the app-level theme
         keys, which is exactly why the About page used to stay fixed
         navy regardless of Settings → Appearance. Every reference
         below uses {DynamicResource Liquid...} so the whole page —
         all three sections — re-tints live on Light/Dark swap,
         visual-family change and wallpaper layering.

         (GlassPageBg was removed with the fixed stage; GlassShadow
         was removed — pixel-shader effects forced software rendering
         and froze the About tabs.) -->

    <!-- ═══ SHARED STYLES (glass) ═══ -->
    <!--
      2026-08-25 senior fix — the Modules/Developer tab freeze:
      every About card carried a DropShadowEffect (BlurRadius 28).
      Pixel-shader effects force WPF to software-render those
      subtrees, and a fresh tab realises ~15-20 shadowed cards in one
      layout pass — on GPUs without headroom that is a multi-second
      UI freeze on every tab click. The glass identity survives via
      the gradient fill + 1px light border; the shadow is removed.
    -->
    <Style x:Key="AboutCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
        <Setter Property="Background"          Value="{DynamicResource Surface.Primary.BackgroundBrush}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource Surface.Primary.BorderBrush}"/>
        <Setter Property="BorderThickness"     Value="{DynamicResource Surface.Primary.BorderThickness}"/>
        <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
        <Setter Property="CornerRadius"        Value="{DynamicResource Surface.Primary.CornerRadius}"/>
        <Setter Property="Padding"             Value="30,26"/>
        <Setter Property="Margin"              Value="0,0,0,20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
    </Style>

    <Style x:Key="HeroCardStyle" TargetType="Border"
           BasedOn="{StaticResource AboutCardStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource Surface.Primary.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Surface.Primary.BorderThickness}"/>
    </Style>

    <Style x:Key="AboutSectionPanelStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}">
        <Setter Property="Background" Value="{DynamicResource Surface.Secondary.BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Surface.Secondary.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Surface.Secondary.BorderThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Surface.Secondary.CornerRadius}"/>
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="AboutHeaderBadgeStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
        <Setter Property="Background" Value="{DynamicResource Surface.Detail.BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Surface.Detail.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Surface.Detail.BorderThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Surface.Detail.CornerRadius}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="AboutHeaderBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource LiquidAccent}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="AboutPanelKickerStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource LiquidAccent}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="AboutPanelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource LiquidIce}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="AboutCodeStripStyle" TargetType="Border" BasedOn="{StaticResource AboutSectionPanelStyle}">
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextTitleLarge}"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource LiquidSnow}"/>
        <Setter Property="Margin"            Value="0,0,0,4"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Foreground"        Value="{DynamicResource LiquidCerulean}"/>
        <Setter Property="Margin"            Value="0,0,0,18"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    

    

    <Style x:Key="WorkflowGroupLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource LiquidMuted}"/>
        <Setter Property="Margin"            Value="0,0,0,8"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextXSmall}"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource LiquidMuted}"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="InfoValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight"        Value="SemiBold"/>
        <Setter Property="Foreground"        Value="{DynamicResource LiquidSnow}"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="ChipStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
        <Setter Property="Background"        Value="{DynamicResource Surface.Secondary.BackgroundBrush}"/>
        <Setter Property="BorderBrush"       Value="{DynamicResource Surface.Secondary.BorderBrush}"/>
        <Setter Property="BorderThickness"   Value="{DynamicResource Surface.Secondary.BorderThickness}"/>
        <Setter Property="CornerRadius"      Value="{DynamicResource Surface.Secondary.CornerRadius}"/>
        <Setter Property="Padding"           Value="16,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="IconTileStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
        <Setter Property="Background"        Value="{DynamicResource Surface.Secondary.BackgroundBrush}"/>
        <Setter Property="CornerRadius"      Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="GlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="Segoe MDL2 Assets"/>
        <Setter Property="Foreground"        Value="{DynamicResource LiquidAccent}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <!-- ═══ TEMPLATES (glass) ═══ -->

    <DataTemplate x:Key="HeroPillarTemplate">
        <Border CornerRadius="{DynamicResource Surface.Secondary.CornerRadius}"
                Width="148"
                Height="94"
                Padding="16,14"
                Margin="6"
                BorderThickness="{DynamicResource Surface.Secondary.BorderThickness}"
                Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                BorderBrush="{DynamicResource Surface.Secondary.BorderBrush}"
                SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Icon}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="{StaticResource TextTitleLarge}"
                           Foreground="{DynamicResource LiquidAccent}"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>
                <TextBlock Text="{Binding Value}"
                           FontSize="{StaticResource TextSubhead}"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource LiquidSnow}"
                           IsHitTestVisible="False"/>
                <TextBlock Text="{Binding Label}"
                           FontSize="{StaticResource TextCaption}"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"
                           Foreground="{DynamicResource LiquidAccent}"
                           IsHitTestVisible="False"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ModuleChipTemplate">
        <!-- 2026-09-10 fluid upgrade: each module chip lifts and brightens
             its border smoothly on hover (animated RenderTransform + border
             brush swap). RenderTransformOrigin centres the lift so the card
             scales in place. Pure micro-interaction — no layout change. -->
        <Border x:Name="ModuleChipRoot"
                CornerRadius="{DynamicResource Surface.Secondary.CornerRadius}"
                MinHeight="140"
                Padding="18,16"
                Margin="7"
                HorizontalAlignment="Stretch"
                BorderThickness="{DynamicResource Surface.Secondary.BorderThickness}"
                Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                BorderBrush="{DynamicResource Surface.Secondary.BorderBrush}"
                SnapsToDevicePixels="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ModuleChipScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="ModuleChipLift" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource LiquidAccent}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ModuleChipScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.02" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ModuleChipScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.02" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ModuleChipLift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="-4" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ModuleChipScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ModuleChipScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ModuleChipLift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource About.LIVEModule}"
                               FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource LiquidMuted}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <Border Grid.Column="1"
                            Background="{DynamicResource Surface.Detail.BackgroundBrush}"
                            BorderBrush="{DynamicResource Surface.Primary.BorderBrush}"
                            BorderThickness="{DynamicResource Surface.Secondary.BorderThickness}"
                            CornerRadius="{DynamicResource Surface.Detail.CornerRadius}"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="{DynamicResource About.Active}"
                                   FontSize="{StaticResource TextCaption}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource LiquidAccent}"
                                   IsHitTestVisible="False"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource IconTileStyle}"
                            Width="48"
                            Height="48"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextTitleLarge}"
                                   Style="{StaticResource GlyphStyle}"/>
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="{StaticResource TextSection}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource LiquidSnow}"
                                   TextWrapping="Wrap"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource LiquidFrost}"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Margin="0,4,0,0"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="TechItemTemplate">
        <Border CornerRadius="{DynamicResource Surface.Detail.CornerRadius}"
                MinHeight="84"
                Padding="16,14"
                Margin="7"
                HorizontalAlignment="Stretch"
                BorderThickness="{DynamicResource Surface.Secondary.BorderThickness}"
                Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                BorderBrush="{DynamicResource Surface.Secondary.BorderBrush}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource IconTileStyle}"
                        Width="42"
                        Height="42"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextTitle}"
                               Style="{StaticResource GlyphStyle}"/>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}"
                               Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock Text="{Binding Value}"
                               Style="{StaticResource InfoValueStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="CapabilityCardTemplate">
        <Border CornerRadius="{DynamicResource Surface.Secondary.CornerRadius}"
                MinHeight="176"
                Padding="20,20"
                Margin="8"
                HorizontalAlignment="Stretch"
                BorderThickness="{DynamicResource Surface.Secondary.BorderThickness}"
                Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                BorderBrush="{DynamicResource Surface.Secondary.BorderBrush}"
                SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Style="{StaticResource IconTileStyle}"
                        Width="52"
                        Height="52"
                        HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextHeadline}"
                               Style="{StaticResource GlyphStyle}"/>
                </Border>
                <TextBlock Text="{Binding Title}"
                           FontSize="{StaticResource TextSection}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource LiquidSnow}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,12,0,6"
                           IsHitTestVisible="False"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource LiquidFrost}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           IsHitTestVisible="False"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="WorkflowCardTemplate">
        <Border CornerRadius="{DynamicResource Surface.Secondary.CornerRadius}"
                MinHeight="196"
                Padding="20,18"
                Margin="7"
                HorizontalAlignment="Stretch"
                BorderThickness="{DynamicResource Surface.Secondary.BorderThickness}"
                Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                BorderBrush="{DynamicResource Surface.Secondary.BorderBrush}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{DynamicResource About.WorkflowStage}"
                           FontSize="{StaticResource TextCaption}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource LiquidMuted}"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>

                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,12,0,0">
                    <Border Style="{StaticResource IconTileStyle}"
                            Width="50"
                            Height="50"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextHeadline}"
                                   Style="{StaticResource GlyphStyle}"/>
                    </Border>
                    <TextBlock Text="{Binding Name}"
                               FontSize="{StaticResource TextBodyLarge}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource LiquidSnow}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,12,0,6"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Description}"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource LiquidFrost}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               IsHitTestVisible="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!--
      ═══════════════════════════════════════════════════════
      LICENSE CARD STYLES (Phase 3 — AboutLicenseCard.xaml)

      FieldLabelStyle + FieldValueStyle would have
      collided with every other section that defines
      its own FieldLabelStyle with a different font /
      margin. We use License-prefixed names so the
      About license card is self-contained.
      ═══════════════════════════════════════════════════════
    -->
    <Style x:Key="LicenseFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight"   Value="Bold"/>
        <Setter Property="Foreground"   Value="{DynamicResource LiquidCerulean}"/>
        <Setter Property="Margin"       Value="0,0,0,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="LicenseFieldValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Foreground"   Value="{DynamicResource LiquidSnow}"/>
        <Setter Property="Margin"       Value="0,0,12,4"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!--
      Pill button used on the license card for the
      "COPY" action and any future call-to-action
      chips. Flat, semi-transparent, accent-coloured
      border, hand cursor, hover-lighten.
    -->
    <Style x:Key="AboutPillButtonStyle" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight"   Value="Bold"/>
        <Setter Property="Foreground"   Value="{DynamicResource LiquidAccent}"/>
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="BorderBrush"   Value="{DynamicResource Surface.Primary.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Surface.Secondary.BorderThickness}"/>
        <Setter Property="MinHeight"   Value="{DynamicResource DensityButtonHeight}"/>
        <Setter Property="MinWidth"    Value="{DynamicResource DensityButtonMinWidth}"/>
        <Setter Property="Padding"      Value="12,4"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Surface.Secondary.CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Surface.Secondary.BackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Surface.Detail.BackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource LiquidAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
