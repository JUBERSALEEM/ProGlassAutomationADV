<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/AboutStyles.xaml
     PROJECT: ProGlassAutomation
     MODULE: About — shared glass visual language (v6)

     ONE source of truth for the About page. Merged by:
       • AboutView.xaml                       (shell: glass stage + hero + tabs)
       • Sections/AboutOverviewSection.xaml
       • Sections/ModulesSection.xaml
       • Sections/DeveloperSection.xaml

     Glass identity (matches the Splash / Login glass stage):
       • deep-navy aurora backdrop + soft orbs
       • frosted glass cards (translucent white gradient, 1px light border,
         top sheen, soft shadow)
       • light glass text (Ice / Frost / Cerulean)
       • accent-aware glass highlights that follow the live theme family

     All corners are the canonical 12px (CardCornerRadius etc). No pill.
═══════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ═══ PALETTE — lives in the THEME dictionaries (2026-08-25) ═══
         LiquidIce / LiquidFrost / LiquidCerulean / LiquidSnow /
         LiquidAccent / LiquidAccentDeep / LiquidMuted / LiquidCard /
         LiquidSheen / LiquidOrbA / LiquidOrbB are defined in
         Themes/DarkTheme.xaml (light-frost values) and
         Themes/LightTheme.xaml (dark-ink values).

         They were moved out of this dictionary on purpose: a palette
         defined HERE (merged per-view) shadows the app-level theme
         keys, which is exactly why the About page used to stay fixed
         navy regardless of Settings → Appearance. Every reference
         below uses {DynamicResource Liquid...} so the whole page —
         all three sections — re-tints live on Light/Dark swap,
         visual-family change and wallpaper layering.

         (GlassPageBg was removed with the fixed stage; GlassShadow
         was removed — pixel-shader effects forced software rendering
         and froze the About tabs.) -->

    <!-- ═══ SHARED STYLES (glass) ═══ -->
    <!--
      2026-08-25 senior fix — the Modules/Developer tab freeze:
      every About card carried a DropShadowEffect (BlurRadius 28).
      Pixel-shader effects force WPF to software-render those
      subtrees, and a fresh tab realises ~15-20 shadowed cards in one
      layout pass — on GPUs without headroom that is a multi-second
      UI freeze on every tab click. The glass identity survives via
      the gradient fill + 1px light border; the shadow is removed.
    -->
    <!-- 2026-09-10 iOS-26 upgrade: cards are now FROSTED GLASS SLABS —
         translucent gradient fill over the pastel wallpaper, 1px rim light,
         rounded 20 (the mockup radius). One shared mechanism: every section
         that uses AboutCardStyle / AboutSectionPanelStyle inherits the glass
         look without per-file edits. No DropShadowEffect (software-render
         freeze guard from 2026-08-25 still applies). -->
    <Style x:Key="AboutCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
        <Setter Property="Background"          Value="{DynamicResource AboutGlassSlabBrush}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource AboutGlassSlabStroke}"/>
        <Setter Property="BorderThickness"     Value="1"/>
        <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
        <Setter Property="CornerRadius"        Value="{DynamicResource AboutCardCornerRadius}"/>
        <Setter Property="Effect"              Value="{DynamicResource AboutCardEffect}"/>
        <Setter Property="Padding"             Value="26,22"/>
        <Setter Property="Margin"              Value="0,0,0,16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
    </Style>

    <Style x:Key="HeroCardStyle" TargetType="Border"
           BasedOn="{StaticResource AboutCardStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource AboutGlassSlabStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="AboutSectionPanelStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}">
        <Setter Property="Background" Value="{DynamicResource AboutGlassPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AboutGlassHairlineStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AboutPanelCornerRadius}"/>
        <Setter Property="Effect" Value="{DynamicResource AboutCardEffect}"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="AboutHeaderBadgeStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
        <Setter Property="Background" Value="{DynamicResource Surface.Detail.BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Surface.Detail.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Surface.Detail.BorderThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Surface.Detail.CornerRadius}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="AboutHeaderBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource LiquidAccent}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="AboutPanelKickerStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource LiquidAccent}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="AboutPanelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource LiquidIce}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="AboutCodeStripStyle" TargetType="Border" BasedOn="{StaticResource AboutSectionPanelStyle}">
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextTitleLarge}"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource LiquidSnow}"/>
        <Setter Property="Margin"            Value="0,0,0,4"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Foreground"        Value="{DynamicResource LiquidCerulean}"/>
        <Setter Property="Margin"            Value="0,0,0,18"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    

    

    <Style x:Key="WorkflowGroupLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource LiquidMuted}"/>
        <Setter Property="Margin"            Value="0,0,0,8"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextXSmall}"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource LiquidMuted}"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="InfoValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight"        Value="SemiBold"/>
        <Setter Property="Foreground"        Value="{DynamicResource LiquidSnow}"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="ChipStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
        <Setter Property="Background"        Value="{DynamicResource AboutGlassPanelBrush}"/>
        <Setter Property="BorderBrush"       Value="{DynamicResource AboutGlassSlabStroke}"/>
        <Setter Property="BorderThickness"   Value="1"/>
        <Setter Property="CornerRadius"      Value="{DynamicResource AboutPanelCornerRadius}"/>
        <Setter Property="Padding"           Value="12,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═══ iOS-26 GLASS PRIMITIVES (2026-09-10) ═══
         Module icon squircle: 46px, rounded 14, per-module vivid gradient
         (AboutIcon.* keyed by module name — icons stay vivid in dark),
         white specular gloss strip across the top half. -->
    <Style x:Key="AboutModuleIconBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AboutGlassSlabStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource LiquidAccentGradient}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Name}" Value="Sheet Store">
                <Setter Property="Background" Value="{DynamicResource AboutIcon.SheetStore}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Name}" Value="Proforma Invoice">
                <Setter Property="Background" Value="{DynamicResource AboutIcon.Proforma}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Name}" Value="Job Order">
                <Setter Property="Background" Value="{DynamicResource AboutIcon.JobOrder}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Name}" Value="Delivery Note">
                <Setter Property="Background" Value="{DynamicResource AboutIcon.Delivery}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Name}" Value="Tax Invoice">
                <Setter Property="Background" Value="{DynamicResource AboutIcon.Tax}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Name}" Value="Statements &amp; Reports">
                <Setter Property="Background" Value="{DynamicResource AboutIcon.Statements}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Name}" Value="Settings">
                <Setter Property="Background" Value="{DynamicResource AboutIcon.Settings}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Name}" Value="Users · Audit · Activity">
                <Setter Property="Background" Value="{DynamicResource AboutIcon.Users}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Name}" Value="Multi-page Dashboard">
                <Setter Property="Background" Value="{DynamicResource AboutIcon.Dashboard}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Name}" Value="Shared Export Engine">
                <Setter Property="Background" Value="{DynamicResource AboutIcon.Export}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Name}" Value="AI Assistant">
                <Setter Property="Background" Value="{DynamicResource AboutIcon.Ai}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Name}" Value="Light + Dark Themes">
                <Setter Property="Background" Value="{DynamicResource AboutIcon.Themes}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Icon tile — glossy accent-gradient badge (mirrors the splash module
         tile badges) with a soft accent glow, so every About glyph reads as
         a raised brand badge instead of a flat panel. -->
    <Style x:Key="IconTileStyle" TargetType="Border">
        <Setter Property="Background"        Value="{DynamicResource LiquidAccentGradient}"/>
        <Setter Property="CornerRadius"      Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource AccentColor}"
                                  BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="Segoe MDL2 Assets"/>
        <Setter Property="Foreground"        Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <!-- ═══ TEMPLATES (glass) ═══ -->

    <DataTemplate x:Key="HeroPillarTemplate">
        <!-- 2026-09-10: compact glass chip (mockup "12 MODULES / 5 DATABASES
             / AI READY" pills) instead of the 148×118 stat box. -->
        <Border CornerRadius="12"
                Padding="12,7"
                Margin="0,0,8,8"
                BorderThickness="1"
                Background="{DynamicResource AboutGlassPanelBrush}"
                BorderBrush="{DynamicResource AboutGlassSlabStroke}"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="22" Height="22"
                        CornerRadius="7"
                        Background="{DynamicResource LiquidAccentGradient}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               Style="{StaticResource GlyphStyle}"/>
                </Border>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Value}"
                               FontSize="{StaticResource TextBody}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource LiquidSnow}"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Label}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AboutGlassCaptionBrush}"
                               IsHitTestVisible="False"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ModuleChipTemplate">
        <!-- 2026-09-10 iOS-26 REWRITE: full-width glass SLAB (mockup-exact).
             Horizontal: 46px vivid gradient squircle + 13px semibold name +
             10px gray caption over the wallpaper-lit frosted panel. The
             hover-lift micro-interaction and its named transforms
             (ModuleChipScale / ModuleChipLift) are preserved verbatim. -->
        <Border x:Name="ModuleChipRoot"
                CornerRadius="{DynamicResource AboutCardCornerRadius}"
                MinHeight="76"
                Padding="16,12"
                Margin="5"
                HorizontalAlignment="Stretch"
                BorderThickness="1"
                BorderBrush="{DynamicResource AboutGlassSlabStroke}"
                Background="{DynamicResource AboutGlassSlabBrush}"
                SnapsToDevicePixels="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ModuleChipScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="ModuleChipLift" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Style>
                <!-- Hover-lift micro-interaction. A Style trigger has no
                     NameScope, so Storyboard.TargetName is illegal here
                     (WPF MC4011). Instead the animations target the styled
                     Border ITSELF via a property path into its own
                     RenderTransform: Children[0] is the ScaleTransform,
                     Children[1] the TranslateTransform declared above. -->
                <Style TargetType="Border">
                    <Setter Property="Effect" Value="{DynamicResource AboutCardEffect}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource LiquidAccent}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.02" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.02" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="-3" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Vivid gradient squircle + white gloss strip -->
                <Border Grid.Column="0"
                        Style="{StaticResource AboutModuleIconBorderStyle}">
                    <Grid>
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextTitleLarge}"
                                   Style="{StaticResource GlyphStyle}"/>
                        <!-- specular gloss: top-half white fade -->
                        <Border Height="18" CornerRadius="14,14,0,0"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
                                    <GradientStop Color="#59FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="{StaticResource TextBodyLarge}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource LiquidSnow}"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Description}"
                               FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource AboutGlassCaptionBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"
                               IsHitTestVisible="False"/>
                </StackPanel>

                <!-- LG4 stat chip: small glass capsule right of the text
                     (LIVE SHEET COUNT for Sheet Store — INPC-backed). -->
                <Border Grid.Column="3"
                        Background="{DynamicResource AboutGlassPanelBrush}"
                        BorderBrush="{DynamicResource AboutGlassSlabStroke}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Visibility="{DynamicResource AboutGlassChromeVisibility}"
                        SnapsToDevicePixels="True">
                    <TextBlock Text="{Binding StatChip}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{DynamicResource LiquidAccent}"
                               IsHitTestVisible="False"/>
                </Border>

                <!-- iOS-chrome chevron (iOS 26 family only) -->
                <TextBlock Grid.Column="4" Text="&#xE76C;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource AboutGlassCaptionBrush}"
                           Visibility="{DynamicResource AboutGlassChromeVisibility}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="TechItemTemplate">
        <Border CornerRadius="{DynamicResource AboutPanelCornerRadius}"
                MinHeight="64"
                Padding="14,10"
                Margin="7"
                HorizontalAlignment="Stretch"
                BorderThickness="{DynamicResource Surface.Secondary.BorderThickness}"
                Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                BorderBrush="{DynamicResource Surface.Secondary.BorderBrush}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource IconTileStyle}"
                        Width="42"
                        Height="42"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextTitle}"
                               Style="{StaticResource GlyphStyle}"/>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}"
                               Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock Text="{Binding Value}"
                               Style="{StaticResource InfoValueStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="CapabilityCardTemplate">
        <Border CornerRadius="{DynamicResource AboutPanelCornerRadius}"
                MinHeight="132"
                Padding="16,14"
                Margin="8"
                HorizontalAlignment="Stretch"
                BorderThickness="{DynamicResource Surface.Secondary.BorderThickness}"
                Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                BorderBrush="{DynamicResource Surface.Secondary.BorderBrush}"
                SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Style="{StaticResource IconTileStyle}"
                        Width="52"
                        Height="52"
                        HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextHeadline}"
                               Style="{StaticResource GlyphStyle}"/>
                </Border>
                <TextBlock Text="{Binding Title}"
                           FontSize="{StaticResource TextSection}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource LiquidSnow}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,12,0,6"
                           IsHitTestVisible="False"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource LiquidFrost}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           IsHitTestVisible="False"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="WorkflowCardTemplate">
        <Border CornerRadius="{DynamicResource Surface.Secondary.CornerRadius}"
                MinHeight="196"
                Padding="20,18"
                Margin="7"
                HorizontalAlignment="Stretch"
                BorderThickness="{DynamicResource Surface.Secondary.BorderThickness}"
                Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                BorderBrush="{DynamicResource Surface.Secondary.BorderBrush}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{DynamicResource About.WorkflowStage}"
                           FontSize="{StaticResource TextCaption}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource LiquidMuted}"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>

                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,12,0,0">
                    <Border Style="{StaticResource IconTileStyle}"
                            Width="50"
                            Height="50"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextHeadline}"
                                   Style="{StaticResource GlyphStyle}"/>
                    </Border>
                    <TextBlock Text="{Binding Name}"
                               FontSize="{StaticResource TextBodyLarge}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource LiquidSnow}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,12,0,6"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Description}"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource LiquidFrost}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               IsHitTestVisible="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!--
      ═══════════════════════════════════════════════════════
      LICENSE CARD STYLES (Phase 3 — AboutLicenseCard.xaml)

      FieldLabelStyle + FieldValueStyle would have
      collided with every other section that defines
      its own FieldLabelStyle with a different font /
      margin. We use License-prefixed names so the
      About license card is self-contained.
      ═══════════════════════════════════════════════════════
    -->
    <Style x:Key="LicenseFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight"   Value="Bold"/>
        <Setter Property="Foreground"   Value="{DynamicResource LiquidCerulean}"/>
        <Setter Property="Margin"       Value="0,0,0,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="LicenseFieldValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Foreground"   Value="{DynamicResource LiquidSnow}"/>
        <Setter Property="Margin"       Value="0,0,12,4"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!--
      Pill button used on the license card for the
      "COPY" action and any future call-to-action
      chips. Flat, semi-transparent, accent-coloured
      border, hand cursor, hover-lighten.
    -->
    <Style x:Key="AboutPillButtonStyle" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight"   Value="Bold"/>
        <Setter Property="Foreground"   Value="{DynamicResource LiquidAccent}"/>
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="BorderBrush"   Value="{DynamicResource Surface.Primary.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Surface.Secondary.BorderThickness}"/>
        <Setter Property="MinHeight"   Value="{DynamicResource DensityButtonHeight}"/>
        <Setter Property="MinWidth"    Value="{DynamicResource DensityButtonMinWidth}"/>
        <Setter Property="Padding"      Value="12,4"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Surface.Secondary.CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Surface.Secondary.BackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Surface.Detail.BackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource LiquidAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
