<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/AboutStyles.xaml
     PROJECT: ProGlassAutomation
     MODULE: About — shared glass visual language (v6)

     ONE source of truth for the About page. Merged by:
       • AboutView.xaml                       (shell: glass stage + hero + tabs)
       • Sections/AboutOverviewSection.xaml
       • Sections/ModulesSection.xaml
       • Sections/DeveloperSection.xaml

     Glass identity (matches the Splash / Login glass stage):
       • deep-navy aurora backdrop + soft orbs
       • frosted glass cards (translucent white gradient, 1px light border,
         top sheen, soft shadow)
       • light glass text (Ice / Frost / Cerulean)
       • accent-aware glass highlights that follow the live theme family

     All corners are the canonical 12px (CardCornerRadius etc). No pill.
═══════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ═══ PALETTE — lives in the THEME dictionaries (2026-08-25) ═══
         LiquidIce / LiquidFrost / LiquidCerulean / LiquidSnow /
         LiquidAccent / LiquidAccentDeep / LiquidMuted / LiquidCard /
         LiquidSheen / LiquidOrbA / LiquidOrbB are defined in
         Themes/DarkTheme.xaml (light-frost values) and
         Themes/LightTheme.xaml (dark-ink values).

         They were moved out of this dictionary on purpose: a palette
         defined HERE (merged per-view) shadows the app-level theme
         keys, which is exactly why the About page used to stay fixed
         navy regardless of Settings → Appearance. Every reference
         below uses {DynamicResource Liquid...} so the whole page —
         all three sections — re-tints live on Light/Dark swap,
         visual-family change and wallpaper layering.

         (GlassPageBg was removed with the fixed stage; GlassShadow
         was removed — pixel-shader effects forced software rendering
         and froze the About tabs.) -->

    <!-- ═══ SHARED STYLES (glass) ═══ -->
    <!--
      2026-08-25 senior fix — the Modules/Developer tab freeze:
      every About card carried a DropShadowEffect (BlurRadius 28).
      Pixel-shader effects force WPF to software-render those
      subtrees, and a fresh tab realises ~15-20 shadowed cards in one
      layout pass — on GPUs without headroom that is a multi-second
      UI freeze on every tab click. The glass identity survives via
      the gradient fill + 1px light border; the shadow is removed.
    -->
    <!-- 2026-09-10 iOS-26 upgrade: cards are now FROSTED GLASS SLABS —
         translucent gradient fill over the pastel wallpaper, 1px rim light,
         rounded 20 (the mockup radius). One shared mechanism: every section
         that uses AboutCardStyle / AboutSectionPanelStyle inherits the glass
         look without per-file edits. No DropShadowEffect (software-render
         freeze guard from 2026-08-25 still applies). -->
    <!-- Migrated AboutCardStyle to global SurfacePrimaryStyle -->
    

    

    

    <!-- Migrated SectionTitleStyle to global SurfacePrimaryStyle / Typography -->

    <!-- Migrated SectionSubtitleStyle to global SurfacePrimaryStyle / Typography -->

    

    

    

    

    

    

    <!-- ═══ iOS-26 GLASS PRIMITIVES (2026-09-10) ═══
         Module icon squircle: 46px, rounded 14, per-module vivid gradient
         (AboutIcon.* keyed by module name — icons stay vivid in dark),
         white specular gloss strip across the top half. -->
    

    <!-- Icon tile — glossy accent-gradient badge (mirrors the splash module
         tile badges) with a soft accent glow, so every About glyph reads as
         a raised brand badge instead of a flat panel. -->
    

    

    <!-- ═══ TEMPLATES (glass) ═══ -->

    <DataTemplate x:Key="HeroPillarTemplate">
        <!-- 2026-09-10: compact glass chip (mockup "12 MODULES / 5 DATABASES
             / AI READY" pills) instead of the 148×118 stat box. -->
        <Border CornerRadius="{DynamicResource Radius.Card}"
                Padding="12,7"
                Margin="0,0,8,8"
                BorderThickness="1"
                Background="{DynamicResource AboutGlassPanelBrush}"
                BorderBrush="{DynamicResource AboutGlassSlabStroke}"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="22" Height="22"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Background="{DynamicResource LiquidAccentGradient}"
                        VerticalAlignment="Center">
                    <!-- 2026-09-14: glyph had no Foreground (inherited
                         near-black → invisible on the accent tile) and no
                         centering. -->
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="{DynamicResource FontSize.BodySmall}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource Typography.Icon}"/>
                </Border>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Value}"
                               FontSize="{DynamicResource FontSize.Body}"
                               FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource LiquidSnow}"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Label}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               FontWeight="{DynamicResource Weight.SemiBold}"
                               Foreground="{DynamicResource AboutGlassCaptionBrush}"
                               IsHitTestVisible="False"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ModuleChipTemplate">
        <!-- 2026-09-10 iOS-26 REWRITE: full-width glass SLAB (mockup-exact).
             Horizontal: 46px vivid gradient squircle + 13px semibold name +
             10px gray caption over the wallpaper-lit frosted panel. The
             hover-lift micro-interaction and its named transforms
             (ModuleChipScale / ModuleChipLift) are preserved verbatim. -->
        <Border x:Name="ModuleChipRoot"
                CornerRadius="{DynamicResource AboutCardCornerRadius}"
                Width="280"
                MinHeight="148"
                Padding="18,14"
                Margin="5"
                HorizontalAlignment="Left"
                BorderThickness="1"
                BorderBrush="{DynamicResource AboutGlassSlabStroke}"
                Background="{DynamicResource AboutGlassSlabBrush}"
                SnapsToDevicePixels="True"
                CacheMode="BitmapCache"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ModuleChipScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="ModuleChipLift" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Style>
                <!-- Hover-lift micro-interaction. A Style trigger has no
                     NameScope, so Storyboard.TargetName is illegal here
                     (WPF MC4011). Instead the animations target the styled
                     Border ITSELF via a property path into its own
                     RenderTransform: Children[0] is the ScaleTransform,
                     Children[1] the TranslateTransform declared above. -->
                <Style TargetType="Border">
                    <Setter Property="Effect" Value="{StaticResource AboutCardEffect}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource LiquidAccent}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.02" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.02" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="-3" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Vivid gradient squircle + white gloss strip -->
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                        Style="{StaticResource SurfacePrimaryStyle}">
                    <Grid>
                        <!-- 2026-09-14: glyph was invisible (no Foreground)
                             and top-left instead of centred. -->
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.H1}"
                                   Foreground="{DynamicResource LiquidAccent}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Typography.Icon}"/>
                        <!-- specular gloss: top-half white fade.
                             2026-09-14: hex stops → named White + Opacity
                             (audit lock: About files must contain no fixed
                             hex colours; the sheen is white by definition).
                             Corner token fixed Radius.Top.XLarge (undefined,
                             resolved to 0) → Radius.Top.Medium. -->
                        <Border Height="22" CornerRadius="{DynamicResource Radius.Top.Medium}"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
                                    <GradientStop Color="White" Opacity="0.35" Offset="0"/>
                                    <GradientStop Color="White" Opacity="0" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="{DynamicResource FontSize.Title}"
                               FontWeight="{DynamicResource Weight.SemiBold}"
                               Foreground="{DynamicResource LiquidSnow}"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Description}"
                               FontSize="{DynamicResource FontSize.BodySmall}"
                               Foreground="{DynamicResource AboutGlassCaptionBrush}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"
                               IsHitTestVisible="False"/>
                </StackPanel>

                <!-- LG4 stat chip: small glass capsule right of the text
                     (LIVE SHEET COUNT for Sheet Store — INPC-backed). -->
                <Border Grid.Row="1" Grid.Column="2"
                        Background="{DynamicResource AboutGlassPanelBrush}"
                        BorderBrush="{DynamicResource AboutGlassSlabStroke}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Medium}"
                        Padding="8,3"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,2"
                        VerticalAlignment="Center"
                        Visibility="{DynamicResource AboutGlassChromeVisibility}"
                        SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                    <TextBlock Text="{Binding StatChip}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource LiquidAccent}"
                               IsHitTestVisible="False"/>
                </Border>

                <!-- iOS-chrome chevron (iOS 26 family only), bottom-right -->
                <TextBlock Grid.Row="1" Grid.Column="3" Text="&#xE76C;"
                           FontFamily="{DynamicResource FontFamily.Icon}"
                           FontSize="{DynamicResource FontSize.Body}"
                           Foreground="{DynamicResource AboutGlassCaptionBrush}"
                           Visibility="{DynamicResource AboutGlassChromeVisibility}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="TechItemTemplate">
        <!-- 2026-09-14: fixed 300px width for the Developer tab's
             WrapPanel tech-stack row (reflows 2 → 1 as the window
             narrows; Stretch inside a WrapPanel = one full-width row). -->
        <Border CornerRadius="{DynamicResource AboutPanelCornerRadius}"
                Width="300"
                MinHeight="64"
                Padding="14,10"
                Margin="7"
                HorizontalAlignment="Left"
                BorderThickness="{DynamicResource Surface.Secondary.BorderThickness}"
                Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                BorderBrush="{DynamicResource Surface.Secondary.BorderBrush}"
                SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource SurfacePrimaryStyle}"
                        Width="42"
                        Height="42"
                        VerticalAlignment="Center">
                    <!-- 2026-09-14: glyph was invisible (no Foreground). -->
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="{DynamicResource FontSize.H2}"
                               Foreground="{DynamicResource LiquidAccent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource Typography.Icon}"/>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}"
                               Style="{StaticResource Typography.Label}"/>
                    <TextBlock Text="{Binding Value}"
                               Style="{StaticResource Typography.Body}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="CapabilityCardTemplate">
        <Border CornerRadius="{DynamicResource AboutPanelCornerRadius}"
                MinHeight="132"
                Padding="16,14"
                Margin="8"
                HorizontalAlignment="Stretch"
                BorderThickness="{DynamicResource Surface.Secondary.BorderThickness}"
                Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                BorderBrush="{DynamicResource Surface.Secondary.BorderBrush}"
                SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Style="{StaticResource SurfacePrimaryStyle}"
                        Width="52"
                        Height="52"
                        HorizontalAlignment="Center">
                    <!-- 2026-09-14: glyph was invisible (no Foreground) —
                         this is why Key Capabilities showed text only. -->
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="{DynamicResource FontSize.H1}"
                               Foreground="{DynamicResource LiquidAccent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource Typography.Icon}"/>
                </Border>
                <TextBlock Text="{Binding Title}"
                           FontSize="{DynamicResource FontSize.H3}"
                           FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{DynamicResource LiquidSnow}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,12,0,6"
                           IsHitTestVisible="False"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="{DynamicResource FontSize.Body}"
                           Foreground="{DynamicResource LiquidFrost}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           IsHitTestVisible="False"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="WorkflowCardTemplate">
        <Border CornerRadius="{DynamicResource Surface.Secondary.CornerRadius}"
                MinHeight="196"
                Padding="20,18"
                Margin="7"
                HorizontalAlignment="Stretch"
                BorderThickness="{DynamicResource Surface.Secondary.BorderThickness}"
                Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                BorderBrush="{DynamicResource Surface.Secondary.BorderBrush}"
                SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{DynamicResource About.WorkflowStage}"
                           FontSize="{DynamicResource FontSize.BodySmall}"
                           FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{DynamicResource LiquidMuted}"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>

                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,12,0,0">
                    <Border Style="{StaticResource SurfacePrimaryStyle}"
                            Width="50"
                            Height="50"
                            HorizontalAlignment="Center">
                        <!-- 2026-09-14: glyph was invisible (no Foreground). -->
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.H1}"
                                   Foreground="{DynamicResource LiquidAccent}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Typography.Icon}"/>
                    </Border>
                    <TextBlock Text="{Binding Name}"
                               FontSize="{DynamicResource FontSize.Title}"
                               FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource LiquidSnow}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,12,0,6"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Description}"
                               FontSize="{DynamicResource FontSize.Body}"
                               Foreground="{DynamicResource LiquidFrost}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               IsHitTestVisible="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!--
      ═══════════════════════════════════════════════════════
      LICENSE CARD STYLES (Phase 3 — AboutLicenseCard.xaml)

      FieldLabelStyle + FieldValueStyle would have
      collided with every other section that defines
      its own FieldLabelStyle with a different font /
      margin. We use License-prefixed names so the
      About license card is self-contained.
      ═══════════════════════════════════════════════════════
    -->
    

    

    <!--
      Pill button used on the license card for the
      "COPY" action and any future call-to-action
      chips. Flat, semi-transparent, accent-coloured
      border, hand cursor, hover-lighten.
    -->
    <Style x:Key="AboutPillButtonStyle" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="FontWeight"   Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="Foreground"   Value="{DynamicResource LiquidAccent}"/>
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="BorderBrush"   Value="{DynamicResource Surface.Primary.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Surface.Secondary.BorderThickness}"/>
        <Setter Property="MinHeight"   Value="{DynamicResource DensityButtonHeight}"/>
        <Setter Property="MinWidth"    Value="{DynamicResource DensityButtonMinWidth}"/>
        <Setter Property="Padding"      Value="12,4"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Surface.Secondary.CornerRadius}"
                            Padding="{TemplateBinding Padding}" Style="{StaticResource SurfacePrimaryStyle}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Surface.Secondary.BackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Surface.Detail.BackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource LiquidAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
