<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/AboutStyles.xaml
     PROJECT: ProGlassAutomation
     MODULE: About — shared card / typography / templates

     ONE source of truth for the About page. Merged by:
       • AboutView.xaml                       (shell: hero + tabs)
       • Sections/AboutOverviewSection.xaml
       • Sections/ModulesSection.xaml
       • Sections/DeveloperSection.xaml

     All corners are the canonical 12px cards (CardCornerRadius /
     CardCornerRadiusLarge / ControlCornerRadius). No pill radius.
═══════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ SHARED CARD / TYPOGRAPHY (theme-adaptive) ═══ -->
    <Style x:Key="AboutCardStyle" TargetType="Border">
        <Setter Property="Background"          Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource OutlineBrush}"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="CornerRadius"        Value="{DynamicResource CardCornerRadiusLarge}"/>
        <Setter Property="Padding"             Value="30,26"/>
        <Setter Property="Margin"              Value="0,0,0,20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
    </Style>

    <Style x:Key="HeroCardStyle" TargetType="Border"
           BasedOn="{StaticResource AboutCardStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadiusLarge}"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"          Value="19"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Margin"            Value="0,0,0,4"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"          Value="12"/>
        <Setter Property="Foreground"        Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="Margin"            Value="0,0,0,18"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="SubHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize"          Value="11"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Margin"            Value="0,16,0,8"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping"      Value="Wrap"/>
        <Setter Property="LineHeight"        Value="24"/>
        <Setter Property="FontSize"          Value="13.5"/>
        <Setter Property="Foreground"        Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="WorkflowGroupLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"          Value="10"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="Margin"            Value="0,0,0,8"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"          Value="9"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="InfoValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize"          Value="12"/>
        <Setter Property="FontWeight"        Value="SemiBold"/>
        <Setter Property="Foreground"        Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="ChipStyle" TargetType="Border">
        <Setter Property="Background"        Value="{DynamicResource TintIndigoBrush}"/>
        <Setter Property="BorderBrush"       Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness"   Value="1"/>
        <Setter Property="CornerRadius"      Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="Padding"           Value="16,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="IconTileStyle" TargetType="Border">
        <Setter Property="Background"        Value="{DynamicResource TintIndigoBrush}"/>
        <Setter Property="CornerRadius"      Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="GlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="Segoe MDL2 Assets"/>
        <Setter Property="Foreground"        Value="{DynamicResource AccentBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <!-- ═══ TEMPLATES ═══ -->

    <DataTemplate x:Key="HeroPillarTemplate">
        <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="14,12" Margin="0,0,0,10"
                MinWidth="120" BorderThickness="{DynamicResource CardBorderThickness}"
                Background="{DynamicResource TintIndigoBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding Icon}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="20"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>
                <TextBlock Text="{Binding Value}"
                           FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           IsHitTestVisible="False"/>
                <TextBlock Text="{Binding Label}"
                           FontSize="9" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource AccentBrush}"
                           IsHitTestVisible="False"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ModuleChipTemplate">
        <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,14" Margin="6"
                BorderThickness="{DynamicResource CardBorderThickness}"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource IconTileStyle}"
                        Width="44" Height="44"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Style="{StaticResource GlyphStyle}"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,10,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Description}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"
                               IsHitTestVisible="False"/>
                </StackPanel>

                <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Column="2"
                        Background="{DynamicResource TintIndigoBrush}"
                        CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,3"
                        VerticalAlignment="Center"
                        SnapsToDevicePixels="True">
                    <TextBlock Text="ACTIVE" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               IsHitTestVisible="False"/>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="TechItemTemplate">
        <Border CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,12" Margin="6"
                BorderThickness="{DynamicResource CardBorderThickness}"
                Background="{DynamicResource TintIndigoBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Icon}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="17"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           IsHitTestVisible="False"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}"
                               Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock Text="{Binding Value}"
                               Style="{StaticResource InfoValueStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="CapabilityCardTemplate">
        <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,20" Margin="8"
                MinWidth="230" MaxWidth="280" BorderThickness="{DynamicResource CardBorderThickness}"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center">
                <Border Style="{StaticResource IconTileStyle}"
                        Width="52" Height="52"
                        HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="22"
                               Style="{StaticResource GlyphStyle}"/>
                </Border>
                <TextBlock Text="{Binding Title}"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,12,0,6"
                           IsHitTestVisible="False"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="WorkflowCardTemplate">
        <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,20" Margin="8"
                MinWidth="200" MaxWidth="240" BorderThickness="{DynamicResource CardBorderThickness}"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center">
                <Border Style="{StaticResource IconTileStyle}"
                        Width="48" Height="48"
                        HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Style="{StaticResource GlyphStyle}"/>
                </Border>
                <TextBlock Text="{Binding Name}"
                           FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,10,0,4"
                           IsHitTestVisible="False"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False"/>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
