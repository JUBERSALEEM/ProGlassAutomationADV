<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/AboutStyles.xaml
     PROJECT: ProGlassAutomation
     MODULE: About — shared item templates (iOS-26 Liquid Glass)

     Merged by: AboutView.xaml + every About section UserControl
     (and by Themes/LightTheme.xaml + Themes/DarkTheme.xaml — see the
     2026-09-15 note in AboutIos26Theme.xaml: the About module is now
     rendered from its OWN fixed palette instead of the live app
     theme, per the owner's approved mockups).

     This file holds only the shared ITEM TEMPLATES. All brushes,
     radii, card / chip / button / bar styles live in
     AboutIos26Theme.xaml (merged first, below).

     Token discipline: no hex colours and no literal CornerRadius
     values in any About view file (audit lock) — everything resolves
     to an Ios26* key.
═══════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="AboutIos26Theme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══ HERO PILLAR — soft chip: icon tile + value + label
         (mockup hero stat row). Item = HeroPillar(Icon, Value, Label). -->
    <DataTemplate x:Key="HeroPillarTemplate">
        <Border Style="{StaticResource Ios26InnerTileStyle}"
                Padding="10,7"
                Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="22" Height="22"
                        Style="{StaticResource Ios26IconTileStyle}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="11"
                               Foreground="{DynamicResource Ios26AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Value}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Ios26TextTitleBrush}"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Label}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Ios26TextMutedBrush}"
                               IsHitTestVisible="False"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ═══ CAPABILITY ROW — icon-left tile (mockup 01 left card).
         Item = CapabilityInfo(Icon, Title, Description). -->
    <DataTemplate x:Key="CapabilityRowTemplate">
        <Border Style="{StaticResource Ios26InnerTileStyle}"
                Margin="0,0,10,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34"
                        Style="{StaticResource Ios26IconTileStyle}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="15"
                               Foreground="{DynamicResource Ios26AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Ios26TextTitleBrush}"
                               TextWrapping="Wrap"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Description}"
                               FontSize="11"
                               Foreground="{DynamicResource Ios26TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"
                               IsHitTestVisible="False"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ═══ CAPABILITY TILE — icon-top tile (mockup 01 right card).
         Item = CapabilityInfo(Icon, Title, Description). -->
    <DataTemplate x:Key="CapabilityTileTemplate">
        <Border Style="{StaticResource Ios26InnerTileStyle}"
                Margin="0,0,10,10">
            <StackPanel>
                <Border Width="34" Height="34"
                        Style="{StaticResource Ios26IconTileStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,10">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="15"
                               Foreground="{DynamicResource Ios26AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Title}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Ios26TextTitleBrush}"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ═══ TECH TILE — icon + kicker + value (mockup 04 Tech Stack).
         Item = TechItem(Icon, Label, Value). -->
    <DataTemplate x:Key="TechItemTemplate">
        <Border Style="{StaticResource Ios26InnerTileStyle}"
                Margin="0,0,10,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30"
                        Style="{StaticResource Ios26IconTileStyle}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="14"
                               Foreground="{DynamicResource Ios26AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Ios26TextMutedBrush}"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Value}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Ios26TextTitleBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ═══ WORKFLOW TILE — icon + title + description (Modules →
         end-to-end workflow card). Item = WorkflowStage(Icon, Title, Description). -->
    <DataTemplate x:Key="WorkflowCardTemplate">
        <Border Style="{StaticResource Ios26InnerTileStyle}"
                Margin="0,0,10,10">
            <StackPanel>
                <Border Width="30" Height="30"
                        Style="{StaticResource Ios26IconTileStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,10">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="14"
                               Foreground="{DynamicResource Ios26AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Title}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Ios26TextTitleBrush}"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="11"
                           Foreground="{DynamicResource Ios26TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"
                           IsHitTestVisible="False"/>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
