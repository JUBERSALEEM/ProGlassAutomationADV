<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/Sections/DeveloperSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: About → "Developer" tab

     Premium layout:
       • hero header with developer identity + product facts
       • consistent glass panels
       • balanced tech-stack header and footer
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.DeveloperSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewsAbout="clr-namespace:ProGlassAutomation.Views.About"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 2026-09-11 mockup rebuild templates (SINGLE Resources block —
                 WPF forbids setting UserControl.Resources twice, MC3024) -->
<!-- STACK pill -->
                <DataTemplate x:Key="DevStackPillTemplate">
                    <Border Margin="0,0,8,8"
                            Padding="12,5"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AboutGlassPanelBrush}"
                            BorderBrush="{DynamicResource AboutGlassSlabStroke}"
                            BorderThickness="1"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="{StaticResource TextCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   IsHitTestVisible="False"/>
                    </Border>
                </DataTemplate>
                <!-- CAPABILITIES check row -->
                <DataTemplate x:Key="DevCapabilityRowTemplate">
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="&#xE73E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="{StaticResource TextBody}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

        <!-- ════════════════════════════════════════════════════════════
             2026-09-11 MOCKUP-EXACT REBUILD (owner-approved board):
             centered page header → three floating cards in one row
             (Profile · Stack · Principles+Capabilities) → full-width
             facts strip. All data bindings preserved; the email pill
             keeps its code-behind handler.
             ════════════════════════════════════════════════════════════ -->
                <StackPanel>

            <!-- ── Centered page header (mockup) ── -->
            <StackPanel HorizontalAlignment="Center" Margin="0,2,0,16">
                <TextBlock Text="{DynamicResource About.Developer}"
                           FontSize="{StaticResource TextDisplay}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>
                <TextBlock Text="{DynamicResource About.CraftsmanshipWorkflowEngineeringProduct}"
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource AboutGlassCaptionBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           IsHitTestVisible="False"/>
            </StackPanel>

            <!-- ── Three floating cards in one row ── -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 1 · Profile -->
                <Border Grid.Column="0" Style="{StaticResource AboutCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- 92px vivid gradient squircle avatar + initials -->
                        <Border Width="92" Height="92" CornerRadius="24"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource LiquidAccentGradient}"
                                BorderBrush="{DynamicResource AboutGlassSlabStroke}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock Text="{Binding DeveloperInitials}"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <Border Height="30" CornerRadius="24,24,0,0"
                                        VerticalAlignment="Top"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#59FFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding DeveloperName}"
                                   FontSize="{StaticResource TextTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="{DynamicResource About.PrincipalDeveloperProductDesignWorkflow}"
                                   FontSize="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource AboutGlassCaptionBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   IsHitTestVisible="False"/>
                        <!-- email pill (handler preserved) -->
                        <Border Margin="0,16,0,4"
                                Padding="14,8"
                                HorizontalAlignment="Center"
                                Cursor="Hand"
                                Background="{DynamicResource AboutGlassPanelBrush}"
                                BorderBrush="{DynamicResource AboutGlassSlabStroke}"
                                BorderThickness="1"
                                CornerRadius="12"
                                MouseLeftButtonDown="Email_MouseLeftButtonDown">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE715;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextBody}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource LiquidAccent}"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Email}"
                                           FontSize="{StaticResource TextBody}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource LiquidAccent}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- CARD 2 · Stack -->
                <Border Grid.Column="2" Style="{StaticResource AboutCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About.TechnologyStack}"
                                   FontSize="{StaticResource TextCaption}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AboutGlassCaptionBrush}"
                                   Margin="0,0,0,10"
                                   IsHitTestVisible="False"/>
                        <ItemsControl ItemsSource="{Binding TechStack}"
                                      ItemTemplate="{StaticResource DevStackPillTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- CARD 3 · Principles + Capabilities -->
                <Border Grid.Column="4" Style="{StaticResource AboutCardStyle}">
                    <StackPanel>
                        <TextBlock Text="PRINCIPLES"
                                   FontSize="{StaticResource TextCaption}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AboutGlassCaptionBrush}"
                                   Margin="0,0,0,10"
                                   IsHitTestVisible="False"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="01" FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                                       Foreground="{DynamicResource AboutGlassCaptionBrush}" VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Clean Code" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock Text="Readable and maintainable" FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource AboutGlassCaptionBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="02" FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                                       Foreground="{DynamicResource AboutGlassCaptionBrush}" VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Test Driven" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock Text="Unit tests always" FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource AboutGlassCaptionBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="03" FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                                       Foreground="{DynamicResource AboutGlassCaptionBrush}" VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Continuous" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock Text="Deployment automated" FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource AboutGlassCaptionBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="CAPABILITIES"
                                   FontSize="{StaticResource TextCaption}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AboutGlassCaptionBrush}"
                                   Margin="0,0,0,6"
                                   IsHitTestVisible="False"/>
                        <ItemsControl ItemsSource="{Binding CapabilitiesTop}"
                                      ItemTemplate="{StaticResource DevCapabilityRowTemplate}"/>
                        <ItemsControl ItemsSource="{Binding CapabilitiesBottom}"
                                      ItemTemplate="{StaticResource DevCapabilityRowTemplate}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Full-width facts strip (mockup bottom bar) ── -->
            <Border Style="{StaticResource AboutCardStyle}" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource About.Version}"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource AboutGlassCaptionBrush}"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding Version}"
                                   FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Margin="0,2,0,0"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource About.Build}"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource AboutGlassCaptionBrush}"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding Build}"
                                   FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Margin="0,2,0,0"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource About.Edition}"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource AboutGlassCaptionBrush}"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding LicenseStatus.EditionDisplay}"
                                   FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Margin="0,2,0,0"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="{DynamicResource Common.Status}"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource AboutGlassCaptionBrush}"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding LicenseStatus.StatusBadge}"
                                   FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Margin="0,2,0,0"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- copyright line (binding preserved) -->
            <TextBlock Text="{Binding Copyright}"
                       FontSize="{StaticResource TextCaption}"
                       Foreground="{DynamicResource AboutGlassCaptionBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,14,0,0"
                       IsHitTestVisible="False"/>
        </StackPanel>
</UserControl>
