<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/Sections/DeveloperSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: About → "Developer" tab (identity + contact + tech stack +
             version/build + copyright)

     Glass identity. Edited independently of the other About sections;
     uses the shared glass styles/templates in ../AboutStyles.xaml.

     Owns the clickable email contact (Email_MouseLeftButtonDown).
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.DeveloperSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!-- ═══ DEVELOPER ═══ -->
        <Border Style="{StaticResource HeroCardStyle}">
            <StackPanel>
                <TextBlock Text="Developer"
                           Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Built and maintained by Juber Saleem"
                           Style="{StaticResource SectionSubtitleStyle}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,6,0,0">
                    <Border Width="72" Height="72"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True"
                            Background="#26FFFFFF"
                            BorderBrush="#66BFDBFE"
                            BorderThickness="1">
                        <Border Width="64" Height="64"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                ClipToBounds="True">
                            <Border.Background>
                                <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                            Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                        <TextBlock Text="{Binding DeveloperName}"
                                   FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource GlassSnow}"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding Country}"
                                   FontSize="12"
                                   Foreground="{StaticResource GlassCerulean}"
                                   Margin="0,2,0,0"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                </StackPanel>

                <!-- Clickable email contact -->
                <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="18,10"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        SnapsToDevicePixels="True"
                        Background="#14FFFFFF"
                        BorderBrush="#66BFDBFE"
                        BorderThickness="1"
                        MouseLeftButtonDown="Email_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE715;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource GlassAccent}"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Email}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource GlassAccent}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Version / build / edition -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">
                    <Border Background="{StaticResource GlassAccentDeep}"
                            CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,8"
                            Margin="0,0,8,0"
                            BorderBrush="#66BFDBFE" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="{Binding Version}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="White"
                                   IsHitTestVisible="False"/>
                    </Border>
                    <Border Style="{StaticResource ChipStyle}" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Build}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource GlassAccent}"
                                   IsHitTestVisible="False"/>
                    </Border>
                    <Border Style="{StaticResource ChipStyle}">
                        <TextBlock Text="Enterprise Edition"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource GlassAccent}"
                                   IsHitTestVisible="False"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ TECH STACK ═══ -->
        <Border Style="{StaticResource AboutCardStyle}">
            <StackPanel>
                <TextBlock Text="Technology Stack"
                           Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Built on battle-tested Microsoft + open-source technology"
                           Style="{StaticResource SectionSubtitleStyle}"/>
                <ItemsControl ItemsSource="{Binding TechStack}"
                              ItemTemplate="{StaticResource TechItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ═══ COPYRIGHT FOOTER ═══ -->
        <StackPanel HorizontalAlignment="Center" Margin="0,10,0,20">
            <Border Background="{StaticResource GlassCard}"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="28,18"
                    Margin="0,8,0,0"
                    Effect="{StaticResource GlassShadow}">
                <StackPanel>
                    <TextBlock Text="ProGlass Automation — Enterprise ERP for UAE glass manufacturing"
                               FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource GlassSnow}"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Copyright}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource GlassMuted}"
                               IsHitTestVisible="False"/>
                </StackPanel>
            </Border>
        </StackPanel>

    </StackPanel>
</UserControl>
