<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/Sections/DeveloperSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: About → "Developer" tab

     2026-09-15 iOS-26 full restyle (approved mockup 04), single
     card language, two rows:
       row 1: identity (avatar · name · role · Made in India ·
              email pill)   |   technology stack (2-up tiles)
       row 2: product facts (2×2 tiles: version · build · edition ·
              status)       |   principles (numbered rows)
     Capabilities live on the Overview tab (mockup 01); copyright
     lives in the Overview copyright card — so nothing is duplicated
     here. The email click handler and the shared license bindings
     are preserved. Self-contained Ios26 palette; no hex, no literal
     corner radii; responsive WrapPanel (audit lock) kept.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.DeveloperSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewsAbout="clr-namespace:ProGlassAutomation.Views.About"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Email pill (handler preserved from the original
                 section — Email_MouseLeftButtonDown). -->
            <Style x:Key="DevEmailPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Ios26TileBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Ios26TileBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusPill}"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!-- ═══ ROW 1 · IDENTITY | TECHNOLOGY STACK ═══ -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Ios26CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="72" Height="72"
                                Style="{StaticResource Ios26IconTileStyle}"
                                CornerRadius="{DynamicResource Ios26RadiusInner}"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <ImageBrush ImageSource="{x:Static viewsAbout:AppIconResource.Icon}"
                                            Stretch="UniformToFill"
                                            RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border.Background>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DeveloperName}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Ios26TextTitleBrush}"
                                       TextWrapping="Wrap"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="{DynamicResource About.PrincipalDeveloperProductDesignWorkflow}"
                                       FontSize="13"
                                       Foreground="{DynamicResource Ios26TextMutedBrush}"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"
                                       IsHitTestVisible="False"/>
                            <!-- Owner directive 2026-09-10: country branding run only -->
                            <TextBlock FontSize="13"
                                       Margin="0,5,0,0"
                                       IsHitTestVisible="False">
                                <Run Text="—" FontWeight="Bold" Foreground="{DynamicResource Ios26AccentBrush}"/>
                                <Run Text=" "/>
                                <Run Text="{DynamicResource About.MadeInIndia}" Foreground="{DynamicResource Ios26TextSecondaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource DevEmailPillStyle}"
                            HorizontalAlignment="Left"
                            Cursor="Hand"
                            MouseLeftButtonDown="Email_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE715;"
                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="13"
                                       Foreground="{DynamicResource Ios26AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Email}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Ios26TextBodyBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Ios26CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.TechnologyStack}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Ios26TextTitleBrush}"
                               Margin="0,0,0,14"/>
                    <ItemsControl ItemsSource="{Binding TechStack}"
                                  ItemTemplate="{StaticResource TechItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Responsive wrap layout (audit lock):
                                     fluid tiles flow and wrap on narrow
                                     windows. -->
                                <WrapPanel Orientation="Horizontal"
                                          HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ ROW 2 · PRODUCT FACTS | PRINCIPLES ═══ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Ios26CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.ProductFacts}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Ios26TextTitleBrush}"
                               Margin="0,0,0,14"/>
                    <UniformGrid Columns="2" Rows="2">
                        <Border Style="{StaticResource Ios26InnerTileStyle}" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" Style="{StaticResource Ios26IconTileStyle}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE946;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="14"
                                               Foreground="{DynamicResource Ios26AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource About.Version}" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource Ios26TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Version}" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource Ios26TextTitleBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Ios26InnerTileStyle}" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" Style="{StaticResource Ios26IconTileStyle}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE713;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="14"
                                               Foreground="{DynamicResource Ios26AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource About.Build}" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource Ios26TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Build}" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource Ios26TextTitleBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Ios26InnerTileStyle}" Margin="0,10,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" Style="{StaticResource Ios26IconTileStyle}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="14"
                                               Foreground="{DynamicResource Ios26AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource About.Edition}" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource Ios26TextMutedBrush}"/>
                                    <TextBlock Text="{Binding LicenseStatus.EditionDisplay}" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource Ios26TextTitleBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Ios26InnerTileStyle}" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" Style="{StaticResource Ios26IconTileStyle}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="14"
                                               Foreground="{DynamicResource Ios26SuccessBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Common.Status}" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource Ios26TextMutedBrush}"/>
                                    <TextBlock Text="{Binding LicenseStatus.StatusBadge}" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource Ios26TextTitleBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Ios26CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.EngineeringPrinciples}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Ios26TextTitleBrush}"
                               Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="01"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource Ios26NumberBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Clean Code" FontSize="14.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                            <TextBlock Text="— Readable and maintainable" FontSize="12.5"
                                       Foreground="{DynamicResource Ios26TextMutedBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="02"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource Ios26NumberBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Test Driven" FontSize="14.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                            <TextBlock Text="— Unit tests always" FontSize="12.5"
                                       Foreground="{DynamicResource Ios26TextMutedBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="03"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource Ios26NumberBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Continuous" FontSize="14.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                            <TextBlock Text="— Deployment automated" FontSize="12.5"
                                       Foreground="{DynamicResource Ios26TextMutedBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </StackPanel>
</UserControl>
