<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/Sections/DeveloperSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: About → "Developer" tab

     Premium layout:
       • hero header with developer identity + product facts
       • consistent glass panels
       • balanced tech-stack header and footer
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.DeveloperSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewsAbout="clr-namespace:ProGlassAutomation.Views.About"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <Border Style="{StaticResource HeroCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Developer"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Craftsmanship, workflow engineering, and product direction behind ProGlass Automation"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Margin="0,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource AboutHeaderBadgeStyle}">
                        <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}" Text="CRAFTED FOR GLASS ERP"/>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource AboutSectionPanelStyle}"
                            Margin="0,0,0,0"
                            Padding="24,22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="84"
                                        Height="84"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        Background="{DynamicResource AboutInteractiveHoverBrush}"
                                        BorderBrush="{DynamicResource AboutInteractiveBorderStrongBrush}"
                                        BorderThickness="{DynamicResource CardBorderThickness}"
                                        SnapsToDevicePixels="True">
                                    <Border Width="76"
                                            Height="76"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            ClipToBounds="True">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Static viewsAbout:AppIconResource.Icon}"
                                                        Stretch="UniformToFill"
                                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border.Background>
                                    </Border>
                                </Border>

                                <StackPanel Margin="18,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DeveloperName}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource GlassSnow}"
                                               TextWrapping="Wrap"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="Principal developer · product design · workflow engineering"
                                               FontSize="11"
                                               Foreground="{DynamicResource GlassMuted}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="Made in India · {Binding Country}"
                                               FontSize="12"
                                               Foreground="{DynamicResource GlassCerulean}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               IsHitTestVisible="False"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Margin="0,20,0,0"
                                    Padding="18,10"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand"
                                    Background="{DynamicResource AboutInteractiveBrush}"
                                    BorderBrush="{DynamicResource AboutInteractiveBorderStrongBrush}"
                                    BorderThickness="{DynamicResource CardBorderThickness}"
                                    CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                                    MouseLeftButtonDown="Email_MouseLeftButtonDown">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE715;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource GlassAccent}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Email}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource GlassAccent}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource AboutSectionPanelStyle}"
                            Margin="0,0,0,0"
                            Padding="24,22">
                        <StackPanel>
                            <TextBlock Text="PRODUCT FACTS"
                                       Style="{StaticResource AboutPanelKickerStyle}"/>

                            <UniformGrid Columns="2" Rows="2" Margin="-6,6,-6,0">
                                <Border Style="{StaticResource AboutCodeStripStyle}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="VERSION"
                                                   Style="{StaticResource InfoLabelStyle}"/>
                                        <TextBlock Text="{Binding Version}"
                                                   Style="{StaticResource InfoValueStyle}"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource AboutCodeStripStyle}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="BUILD"
                                                   Style="{StaticResource InfoLabelStyle}"/>
                                        <TextBlock Text="{Binding Build}"
                                                   Style="{StaticResource InfoValueStyle}"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource AboutCodeStripStyle}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="EDITION"
                                                   Style="{StaticResource InfoLabelStyle}"/>
                                        <TextBlock Text="{Binding LicenseStatus.EditionDisplay}"
                                                   Style="{StaticResource InfoValueStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource AboutCodeStripStyle}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="STATUS"
                                                   Style="{StaticResource InfoLabelStyle}"/>
                                        <TextBlock Text="{Binding LicenseStatus.StatusBadge}"
                                                   Style="{StaticResource InfoValueStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource AboutCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Technology Stack"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Battle-tested Microsoft and open-source foundation"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Margin="0,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource AboutHeaderBadgeStyle}">
                        <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}">
                            <Run Text="STACK ITEMS  "/>
                            <Run Text="{Binding TechStack.Count, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </Grid>

                <Border Style="{StaticResource AboutSectionPanelStyle}"
                        Margin="0,0,0,0"
                        Padding="14,14">
                    <ItemsControl ItemsSource="{Binding TechStack}"
                                  ItemTemplate="{StaticResource TechItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource AboutCardStyle}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="ProGlass Automation — Enterprise ERP for UAE glass manufacturing"
                           FontSize="13"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{DynamicResource GlassSnow}"
                           IsHitTestVisible="False"/>
                <TextBlock Text="{Binding Copyright}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource GlassMuted}"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
