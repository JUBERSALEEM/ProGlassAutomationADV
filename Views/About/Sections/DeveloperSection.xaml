<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/Sections/DeveloperSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: About → "Developer" tab

     Premium layout:
       • hero header with developer identity + product facts
       • consistent glass panels
       • balanced tech-stack header and footer
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.DeveloperSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewsAbout="clr-namespace:ProGlassAutomation.Views.About"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <Border Style="{StaticResource HeroCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Developer"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Made in India by Juber Saleem · Baraut, Uttar Pradesh"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Margin="0,0,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource AboutHeaderBadgeStyle}">
                        <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}" Text="CRAFTED FOR GLASS ERP"/>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AboutSectionPanelStyle}" Margin="0,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="76"
                                        Height="76"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        Background="{DynamicResource AboutInteractiveHoverBrush}"
                                        BorderBrush="{DynamicResource AboutInteractiveBorderStrongBrush}"
                                        BorderThickness="{DynamicResource CardBorderThickness}"
                                        SnapsToDevicePixels="True">
                                    <Border Width="68"
                                            Height="68"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            ClipToBounds="True">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Static viewsAbout:AppIconResource.Icon}"
                                                        Stretch="UniformToFill"
                                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                                    <TextBlock Text="{Binding DeveloperName}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource GlassSnow}"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="Principal developer · product design · workflow engineering"
                                               FontSize="11"
                                               Foreground="{DynamicResource GlassMuted}"
                                               Margin="0,4,0,0"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="{Binding Country}"
                                               FontSize="12"
                                               Foreground="{DynamicResource GlassCerulean}"
                                               Margin="0,4,0,0"
                                               IsHitTestVisible="False"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Margin="0,18,0,0"
                                    Padding="18,10"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand"
                                    Background="{DynamicResource AboutInteractiveBrush}"
                                    BorderBrush="{DynamicResource AboutInteractiveBorderStrongBrush}"
                                    BorderThickness="{DynamicResource CardBorderThickness}"
                                    CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                                    MouseLeftButtonDown="Email_MouseLeftButtonDown">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE715;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource GlassAccent}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Email}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource GlassAccent}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource AboutSectionPanelStyle}" Margin="0,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Style="{StaticResource LicenseFieldLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Version}" Style="{StaticResource LicenseFieldValueStyle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Build" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Build}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,10,12,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Edition" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseStatus.EditionDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,10,12,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Status" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LicenseStatus.StatusBadge}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,10,12,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource AboutCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Technology Stack"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Battle-tested Microsoft and open-source foundation"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Margin="0,0,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource AboutHeaderBadgeStyle}">
                        <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}">
                            <Run Text="STACK ITEMS  "/>
                            <Run Text="{Binding TechStack.Count, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </Grid>

                <ItemsControl ItemsSource="{Binding TechStack}"
                              ItemTemplate="{StaticResource TechItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource AboutCardStyle}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="ProGlass Automation — Enterprise ERP for UAE glass manufacturing"
                           FontSize="13"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource GlassSnow}"
                           IsHitTestVisible="False"/>
                <TextBlock Text="{Binding Copyright}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource GlassMuted}"
                           IsHitTestVisible="False"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
