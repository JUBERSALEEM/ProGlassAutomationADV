<!--
  AboutCrashReportsCard — premium crash-report summary for the About page.
  Shows the most recent crash files in a cleaner support-oriented layout.
-->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.AboutCrashReportsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource AboutCardStyle}">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Recent crash reports"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="The last 10 crash files on disk. Share the error ID with support."
                               Style="{StaticResource SectionSubtitleStyle}"
                               Margin="0,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Border Style="{StaticResource AboutHeaderBadgeStyle}" Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}">
                            <Run Text="REPORTS  "/>
                            <Run Text="{Binding Reports.Count, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource AboutPillButtonStyle}"
                                Content="REFRESH"
                                Margin="0,0,8,0"
                                Click="RefreshButton_Click"/>
                        <Button Style="{StaticResource AboutPillButtonStyle}"
                                Content="OPEN FOLDER"
                                Margin="0,0,8,0"
                                Click="OpenFolderButton_Click"/>
                        <Button x:Name="ClearAllButton"
                                Style="{StaticResource AboutPillButtonStyle}"
                                Content="CLEAR ALL"
                                Foreground="{DynamicResource GlassMuted}"
                                Click="ClearAllButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource AboutSectionPanelStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Reports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="14,12"
                                        Background="{DynamicResource AboutInteractiveHoverBrush}"
                                        BorderBrush="{DynamicResource AboutDividerBrush}"
                                        BorderThickness="{DynamicResource CardBorderThickness}"
                                        CornerRadius="{DynamicResource CardCornerRadius}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding TimestampDisplay}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GlassCerulean}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,12,0">
                                            <Run Text="{Binding ErrorId, Mode=OneWay, FallbackValue='(no id)'}"
                                                 FontWeight="Bold"
                                                 Foreground="{DynamicResource GlassSnow}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding TopExceptionType, Mode=OneWay, FallbackValue=''}"
                                                 Foreground="{DynamicResource GlassMuted}"/>
                                        </TextBlock>

                                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                                Style="{StaticResource AboutPillButtonStyle}"
                                                Content="OPEN"
                                                Click="OpenFileButton_Click"
                                                Tag="{Binding FilePath}"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{Binding SizeDisplay}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource GlassMuted}"
                                                   Margin="0,8,0,0"/>

                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding TopExceptionMessage, FallbackValue='(no message)'}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource GlassIce}"
                                                   Margin="0,8,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyStateText"
                               Text="No crash reports on disk."
                               FontSize="11"
                               FontStyle="Italic"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource GlassCerulean}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
