<!--
  AboutCrashReportsCard — final balanced crash-report summary for the About page.
  Layout goals:
    • full-width header with a cleaner action area
    • support-oriented summary strip
    • balanced crash rows with stable left/meta, center/detail, right/action zones
    • improved empty state without changing report logic
-->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.AboutCrashReportsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            

            

            

            
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SurfacePrimaryStyle}">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource About.Crash}"
                               Style="{StaticResource Typography.H2}"/>
                    <TextBlock Text="{DynamicResource About.Last10LocallyStoredCrashFilesShareErrorID}"
                               Style="{StaticResource Typography.BodySmall}"
                               Margin="0,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right">
                    <Border Style="{StaticResource Badge.Primary}"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Typography.Caption}">
                            <Run Text="{DynamicResource Module.Reports}"/>
                            <Run Text="{Binding Reports.Count, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Style="{StaticResource AboutPillButtonStyle}"
                                Content="{DynamicResource Action.Refresh}"
                                Margin="0,0,8,0"
                                Command="{Binding RefreshCommand}"/>
                        <Button Style="{StaticResource AboutPillButtonStyle}"
                                Content="{DynamicResource About.OPENFolder}"
                                Margin="0,0,8,0"
                                Command="{Binding OpenFolderCommand}"/>
                        <Button x:Name="ClearAllButton"
                                Style="{StaticResource AboutPillButtonStyle}"
                                Content="{DynamicResource About.Clear}"
                                Foreground="{DynamicResource LiquidMuted}"
                                Command="{Binding ClearAllCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource SurfaceSecondaryStyle}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource About.WHATCARDShows}"
                                   Style="{StaticResource AboutPanelKickerStyle}"/>
                        <TextBlock Text="{DynamicResource About.MostRecentCrashFilesSurfacedHereOpenReport}"
                                   Style="{StaticResource Typography.Body}"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Style="{StaticResource SurfaceDetailStyle}"
                            Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource About.SupportAction}"
                                       Style="{StaticResource Typography.Label}"/>
                            <TextBlock Text="{DynamicResource About.ShareErrorIDFirstThenSendReportFileWhen}"
                                       Style="{StaticResource Typography.Body}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource SurfaceSecondaryStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Reports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SurfaceDetailStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0">
                                            <TextBlock Text="{DynamicResource About.Recorded}"
                                                       Style="{StaticResource Typography.Label}"/>
                                            <TextBlock Text="{Binding TimestampDisplay}"
                                                       Style="{StaticResource Typography.Body}"/>
                                            <TextBlock Text="{DynamicResource About.FILESIZE}"
                                                       Style="{StaticResource Typography.Label}"
                                                       Margin="0,14,0,0"/>
                                            <TextBlock Text="{Binding SizeDisplay}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       Foreground="{DynamicResource LiquidFrost}"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Row="0" Grid.Column="2"
                                                Style="{StaticResource SurfaceDetailStyle}"
                                                Margin="0,0,0,10">
                                            <TextBlock Text="{Binding ErrorId, Mode=OneWay, FallbackValue='(no id)'}"
                                                       Style="{StaticResource Typography.Caption}"/>
                                        </Border>

                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock Text="{Binding TopExceptionType, Mode=OneWay, FallbackValue=''}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource LiquidMuted}"
                                                       TextWrapping="Wrap"
                                                       IsHitTestVisible="False"/>
                                            <TextBlock Text="{Binding TopExceptionMessage, FallbackValue='(no message)'}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       Foreground="{DynamicResource LiquidIce}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="38"
                                                       Margin="0,6,0,0"
                                                       IsHitTestVisible="False"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="4"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource AboutPillButtonStyle}"
                                                    Content="{DynamicResource Action.Open}"
                                                    Command="{Binding OpenFileCommand}"
                                                    CommandParameter="{Binding FilePath}"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource About.TEXTFILE}"
                                                       Style="{StaticResource Typography.Label}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource SurfaceDetailStyle}"
                            Margin="0,2,0,0"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource About.NOCrashReportsDISK}"
                                       Style="{StaticResource Typography.Label}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource About.SupportLogAreaCurrentlyCleanNewCrashFiles}"
                                       Style="{StaticResource Typography.Body}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
