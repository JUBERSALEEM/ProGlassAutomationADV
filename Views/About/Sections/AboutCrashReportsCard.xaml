<!--
  AboutCrashReportsCard — 2026-09-15 iOS-26 restyle (approved
  mockup 06).

  Exact mockup layout:
    • header: title + three ghost pill buttons (Refresh ·
      Open Folder · Clear All),
    • one row per report: rose dot · ERROR-ID + exception type ·
      message (with file size) · timestamp · OPEN button,
    • hairlines between rows, quiet centered empty state.
  All report logic (VM, commands, file opening via
  ProcessStartGuard) is untouched — chrome only. Self-contained
  Ios26 palette; no hex, no literal corner radii.
-->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.AboutCrashReportsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Same contract as AboutLicenseCard: the card owns its VM on this
         INNER element so it can never re-point a host's DataContext
         (2026-09-15 datacontext-hijack fix). -->
    <Border x:Name="CardRoot" Style="{StaticResource Ios26CardStyle}">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36"
                        Style="{StaticResource Ios26IconTileStyle}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="{DynamicResource Ios26FontSizeSubtitle}"
                               Foreground="{DynamicResource Ios26AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource About.Crash}"
                               FontSize="{DynamicResource Ios26FontSizeCardTitle}"
                               FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource Ios26TextTitleBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource About.Last10LocallyStoredCrashFilesShareErrorID}"
                               FontSize="{DynamicResource Ios26FontSizeSmall}"
                               Foreground="{DynamicResource Ios26TextMutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource AboutPillButtonStyle}"
                            Content="{DynamicResource Action.Refresh}"
                            Margin="0,0,10,0"
                            Command="{Binding RefreshCommand}"/>
                    <Button Style="{StaticResource AboutPillButtonStyle}"
                            Content="{DynamicResource About.OPENFolder}"
                            Margin="0,0,10,0"
                            Command="{Binding OpenFolderCommand}"/>
                    <Button Style="{StaticResource AboutPillButtonStyle}"
                            Content="{DynamicResource About.Clear}"
                            Command="{Binding ClearAllCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Report rows -->
            <ItemsControl ItemsSource="{Binding Reports}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="2,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status dot -->
                                    <Ellipse Grid.Column="0"
                                             Width="10" Height="10"
                                             Fill="{DynamicResource Ios26DangerDotBrush}"
                                             VerticalAlignment="Center"/>

                                    <!-- Error id + type + message -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock FontSize="{DynamicResource Ios26FontSizeValue}" IsHitTestVisible="False">
                                            <Run Text="{Binding ErrorId, Mode=OneWay, FallbackValue='(no id)'}"
                                                 FontWeight="{DynamicResource Weight.Bold}"
                                                 Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                                            <Run Text="&#x2009;"/>
                                            <Run Text="{Binding TopExceptionType, Mode=OneWay, FallbackValue=''}"
                                                 FontSize="{DynamicResource Ios26FontSizeSmall}"
                                                 Foreground="{DynamicResource Ios26TextMutedBrush}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="{DynamicResource Ios26FontSizeSmall}"
                                                   Foreground="{DynamicResource Ios26TextMutedBrush}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsHitTestVisible="False">
                                            <!-- Run.Text is TwoWay-by-default;
                                                 source props are read-only → OneWay. -->
                                            <Run Text="{Binding TopExceptionMessage, Mode=OneWay, FallbackValue='(no message)'}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding SizeDisplay, Mode=OneWay, FallbackValue=''}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding TimestampDisplay}"
                                               FontSize="{DynamicResource Ios26FontSizeSmall}"
                                               Foreground="{DynamicResource Ios26TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               IsHitTestVisible="False"/>

                                    <Button Grid.Column="4"
                                            Style="{StaticResource AboutPillButtonStyle}"
                                            Content="{DynamicResource Action.Open}"
                                            Command="{Binding OpenFileCommand}"
                                            CommandParameter="{Binding FilePath}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Height="1"
                                    Margin="12,0"
                                    Background="{DynamicResource Ios26HairlineBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <StackPanel Margin="0,6,0,2"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{DynamicResource About.NOCrashReportsDISK}"
                           FontSize="{DynamicResource Ios26FontSizeSmall}"
                           FontWeight="{DynamicResource Weight.SemiBold}"
                           Foreground="{DynamicResource Ios26TextMutedBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource About.SupportLogAreaCurrentlyCleanNewCrashFiles}"
                           FontSize="{DynamicResource Ios26FontSizeSmall}"
                           Foreground="{DynamicResource Ios26TextFaintBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
