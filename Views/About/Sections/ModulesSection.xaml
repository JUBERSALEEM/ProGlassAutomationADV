<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/Sections/ModulesSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: About → "Modules" tab (active modules + end-to-end workflow)
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.ModulesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- LG4 scope capsule (2026-09-10): All / Operations / Finance /
                 Platform, iOS segmented style — selected segment = accent pill. -->
            
            <Style x:Key="ScopePillItemStyle" TargetType="ListBoxItem">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{DynamicResource LiquidFrost}"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
                <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
                <Setter Property="Margin" Value="0,0,3,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="PillBg"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.XLarge}"
                                    Padding="13,5"
                                    SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PillBg" Property="Background" Value="{DynamicResource AboutGlassPanelBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="PillBg" Property="Background" Value="{DynamicResource LiquidAccentDeep}"/>
                                    <Setter TargetName="PillBg" Property="BorderBrush" Value="{DynamicResource LiquidAccent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!-- 2026-09-10 LG4 EXACT: large title over the wallpaper + floating
             scope capsule + 4×3 crystal mosaic directly on the wallpaper
             (cards float — no container slab). Workflow card stays below,
             restyled by the shared glass language. -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource About.ActiveModules}"
                           FontSize="{DynamicResource FontSize.Kpi}"
                           FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{DynamicResource LiquidIce}"/>
                <TextBlock Text="{DynamicResource About.OperationalSurfacesAlreadyDeployedBuild}"
                           FontSize="{DynamicResource FontSize.Body}"
                           Foreground="{DynamicResource LiquidFrost}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{DynamicResource AboutGlassCapsuleBrush}"
                    BorderBrush="{DynamicResource AboutGlassSlabStroke}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.2XLarge}"
                    Padding="6,4"
                    VerticalAlignment="Top"
                    Visibility="{DynamicResource AboutGlassChromeVisibility}"
                    SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                <!-- 2026-09-14: default vertical ItemsPanel stacked the four
                     scope chips vertically inside the capsule — now one row. -->
                <ListBox ItemsSource="{Binding ModuleScopes}"
                         SelectedItem="{Binding SelectedScopeItem, Mode=TwoWay}"
                         DisplayMemberPath="Label"
                         Style="{StaticResource SurfaceSecondaryListBoxStyle}"
                         ItemContainerStyle="{StaticResource ChipListItemStyle}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>
        </Grid>

        <!-- 2026-09-14: fixed 4-column UniformGrid → centered WrapPanel of
             equal 280px slabs (ModuleChipTemplate carries the width).
             12 modules render 4-up at normal widths exactly like the
             approved mosaic, but reflow 4 → 3 → 2 as the window narrows
             instead of every slab collapsing to one quarter of the
             available width. -->
        <ItemsControl ItemsSource="{Binding FilteredModules}"
                      ItemTemplate="{StaticResource ModuleChipTemplate}"
                      Margin="0,0,0,14">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Border Style="{StaticResource SurfacePrimaryStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource About.EndEndProductionWorkflow}"
                                   Style="{StaticResource Typography.H2}"/>
                        <TextBlock Text="{DynamicResource About.CommercialIntakeProductionPreparation}"
                                   Style="{StaticResource Typography.BodySmall}"
                                   Margin="0,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource Badge.Primary}">
                        <TextBlock Style="{StaticResource Typography.Caption}" Text="{DynamicResource About.14Stages}"/>
                    </Border>
                </Grid>

                <Border Style="{StaticResource SurfaceSecondaryStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource About.SalesCycle}"
                                           Style="{StaticResource Typography.Label}"/>
                                <TextBlock Text="{DynamicResource About.SheetAvailabilityReleasedProductionPaperwork}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Foreground="{DynamicResource LiquidFrost}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource Badge.Primary}">
                                <TextBlock Style="{StaticResource Typography.Caption}" Text="{DynamicResource About.3Stages}"/>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding SalesCycle}"
                                      ItemTemplate="{StaticResource WorkflowCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceSecondaryStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource About.ProductionStagesUpcoming}"
                                           Style="{StaticResource Typography.Label}"/>
                                <TextBlock Text="{DynamicResource About.PlannedFactoryExecutionStagesSlotControlled}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Foreground="{DynamicResource LiquidFrost}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource Badge.Primary}">
                                <TextBlock Style="{StaticResource Typography.Caption}" Text="{DynamicResource About.8Stages}"/>
                            </Border>
                        </Grid>

                        <!-- Proportional 4-up grid (kept on purpose,
                             2026-09-14): WorkflowCardTemplate is shared
                             with the 3-up rows above/below, so the slabs
                             stay fluid here; 4 × 196px cards remain
                             usable down to the shell's minimum width.
                             The 12-module mosaic above is the one that
                             needed fixed-width WrapPanel reflow. -->
                        <ItemsControl ItemsSource="{Binding ProductionStages}"
                                      ItemTemplate="{StaticResource WorkflowCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceSecondaryStyle}" Margin="0,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource About.DispatchBilling}"
                                           Style="{StaticResource Typography.Label}"/>
                                <TextBlock Text="{DynamicResource About.DeliveryEvidenceInvoicingReportingClosedOne}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Foreground="{DynamicResource LiquidFrost}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource Badge.Primary}">
                                <TextBlock Style="{StaticResource Typography.Caption}" Text="{DynamicResource About.3Stages}"/>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding DispatchBilling}"
                                      ItemTemplate="{StaticResource WorkflowCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
