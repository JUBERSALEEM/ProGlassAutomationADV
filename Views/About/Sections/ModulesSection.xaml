<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/Sections/ModulesSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: About → "Modules" tab (active modules + end-to-end workflow)
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.ModulesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <Border Style="{StaticResource AboutCardStyle}">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="Active Modules"
                               Style="{StaticResource SectionTitleStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="Operational surfaces already deployed in this build, aligned as one commercial-to-factory workspace"
                               Style="{StaticResource SectionSubtitleStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="760"
                               Margin="0,0,0,0"/>
                    <Border Style="{StaticResource AboutHeaderBadgeStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}">
                            <Run Text="MODULE COUNT  "/>
                            <Run Text="{Binding Modules.Count, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource AboutSectionPanelStyle}"
                        Margin="0,0,0,0"
                        Padding="16,16">
                    <ItemsControl ItemsSource="{Binding Modules}"
                                  ItemTemplate="{StaticResource ModuleChipTemplate}"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource AboutCardStyle}">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="End-to-End Production Workflow"
                               Style="{StaticResource SectionTitleStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="Commercial intake, production preparation, and final billing arranged in a clean stage-by-stage operating flow"
                               Style="{StaticResource SectionSubtitleStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="780"
                               Margin="0,0,0,0"/>
                </StackPanel>

                <Border Style="{StaticResource AboutSectionPanelStyle}">
                    <StackPanel>
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="SALES CYCLE"
                                       Style="{StaticResource WorkflowGroupLabelStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock Text="From sheet availability to released production paperwork"
                                       FontSize="12"
                                       Foreground="{DynamicResource GlassFrost}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="560"/>
                            <Border Style="{StaticResource AboutHeaderBadgeStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}" Text="3 STAGES"/>
                            </Border>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding SalesCycle}"
                                      ItemTemplate="{StaticResource WorkflowCardTemplate}"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AboutSectionPanelStyle}">
                    <StackPanel>
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="PRODUCTION STAGES (UPCOMING)"
                                       Style="{StaticResource WorkflowGroupLabelStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Planned factory execution stages that will slot into the same controlled workflow shell"
                                       FontSize="12"
                                       Foreground="{DynamicResource GlassFrost}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="600"/>
                            <Border Style="{StaticResource AboutHeaderBadgeStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}" Text="8 STAGES"/>
                            </Border>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ProductionStages}"
                                      ItemTemplate="{StaticResource WorkflowCardTemplate}"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AboutSectionPanelStyle}" Margin="0,0,0,0">
                    <StackPanel>
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="DISPATCH &amp; BILLING"
                                       Style="{StaticResource WorkflowGroupLabelStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Delivery evidence, invoicing, and reporting closed out under one financial trail"
                                       FontSize="12"
                                       Foreground="{DynamicResource GlassFrost}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="560"/>
                            <Border Style="{StaticResource AboutHeaderBadgeStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}" Text="3 STAGES"/>
                            </Border>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding DispatchBilling}"
                                      ItemTemplate="{StaticResource WorkflowCardTemplate}"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
