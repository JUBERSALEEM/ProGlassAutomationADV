<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/Sections/ModulesSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: About → "Modules" tab (active modules + end-to-end workflow)
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.ModulesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <Border Style="{StaticResource AboutCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource About.ActiveModules}"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="{DynamicResource About.OperationalSurfacesAlreadyDeployedBuild}"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Margin="0,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource AboutHeaderBadgeStyle}">
                        <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}">
                            <Run Text="{DynamicResource About.ModuleCount}"/>
                            <Run Text="{Binding Modules.Count, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </Grid>

                <Border Style="{StaticResource AboutSectionPanelStyle}"
                        Margin="0,0,0,0"
                        Padding="14,14">
                    <ItemsControl ItemsSource="{Binding Modules}"
                                  ItemTemplate="{StaticResource ModuleChipTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource AboutCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource About.EndEndProductionWorkflow}"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="{DynamicResource About.CommercialIntakeProductionPreparation}"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Margin="0,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource AboutHeaderBadgeStyle}">
                        <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}" Text="{DynamicResource About.14Stages}"/>
                    </Border>
                </Grid>

                <Border Style="{StaticResource AboutSectionPanelStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource About.SalesCycle}"
                                           Style="{StaticResource WorkflowGroupLabelStyle}"/>
                                <TextBlock Text="{DynamicResource About.SheetAvailabilityReleasedProductionPaperwork}"
                                           FontSize="{StaticResource TextBody}"
                                           Foreground="{DynamicResource LiquidFrost}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource AboutHeaderBadgeStyle}">
                                <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}" Text="{DynamicResource About.3Stages}"/>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding SalesCycle}"
                                      ItemTemplate="{StaticResource WorkflowCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AboutSectionPanelStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource About.ProductionStagesUpcoming}"
                                           Style="{StaticResource WorkflowGroupLabelStyle}"/>
                                <TextBlock Text="{DynamicResource About.PlannedFactoryExecutionStagesSlotControlled}"
                                           FontSize="{StaticResource TextBody}"
                                           Foreground="{DynamicResource LiquidFrost}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource AboutHeaderBadgeStyle}">
                                <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}" Text="{DynamicResource About.8Stages}"/>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ProductionStages}"
                                      ItemTemplate="{StaticResource WorkflowCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AboutSectionPanelStyle}" Margin="0,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource About.DispatchBilling}"
                                           Style="{StaticResource WorkflowGroupLabelStyle}"/>
                                <TextBlock Text="{DynamicResource About.DeliveryEvidenceInvoicingReportingClosedOne}"
                                           FontSize="{StaticResource TextBody}"
                                           Foreground="{DynamicResource LiquidFrost}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource AboutHeaderBadgeStyle}">
                                <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}" Text="{DynamicResource About.3Stages}"/>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding DispatchBilling}"
                                      ItemTemplate="{StaticResource WorkflowCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
