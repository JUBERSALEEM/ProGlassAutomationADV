<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/Sections/ModulesSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: About → "Modules" tab (active modules + end-to-end workflow)
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.ModulesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <Border Style="{StaticResource AboutCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Active Modules"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Live operational modules already running the commercial workflow"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Margin="0,0,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource AboutHeaderBadgeStyle}">
                        <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}">
                            <Run Text="MODULE COUNT  "/>
                            <Run Text="{Binding Modules.Count, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding Modules}"
                              ItemTemplate="{StaticResource ModuleChipTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource AboutCardStyle}">
            <StackPanel>
                <TextBlock Text="End-to-End Production Workflow"
                           Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="From raw glass sheets to tax invoice — every stage tracked in one shell"
                           Style="{StaticResource SectionSubtitleStyle}"/>

                <Border Style="{StaticResource AboutSectionPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="SALES CYCLE" Style="{StaticResource WorkflowGroupLabelStyle}"/>
                        <ItemsControl ItemsSource="{Binding SalesCycle}"
                                      ItemTemplate="{StaticResource WorkflowCardTemplate}"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AboutSectionPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="PRODUCTION STAGES (UPCOMING)" Style="{StaticResource WorkflowGroupLabelStyle}"/>
                        <ItemsControl ItemsSource="{Binding ProductionStages}"
                                      ItemTemplate="{StaticResource WorkflowCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AboutSectionPanelStyle}" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="DISPATCH &amp; BILLING" Style="{StaticResource WorkflowGroupLabelStyle}"/>
                        <ItemsControl ItemsSource="{Binding DispatchBilling}"
                                      ItemTemplate="{StaticResource WorkflowCardTemplate}"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
