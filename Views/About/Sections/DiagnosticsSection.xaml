<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/Sections/DiagnosticsSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: About → "Diagnostics" tab

     2026-09-15 iOS-26 full restyle (approved mockup 06): three
     cards — Crash Reports (self-contained card, moved here from
     Overview) · Recording Health (real [Rec*] log markers + the
     15/5 fps thresholds) · App Log (today's log + open folder).
     Self-contained Ios26 palette; no hex, no literal corner radii.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.DiagnosticsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aboutSections="clr-namespace:ProGlassAutomation.Views.About.Sections"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Marker chip (Recording Health). -->
            <Style x:Key="DxMarkerChipStyle" TargetType="Border"
                   BasedOn="{StaticResource Ios26ChipSoftStyle}">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
            </Style>

            <DataTemplate x:Key="DxMarkerChipTemplate">
                <Border Style="{StaticResource DxMarkerChipStyle}">
                    <TextBlock Text="{Binding}"
                               FontSize="{DynamicResource Ios26FontSizeSmall}"
                               FontWeight="{DynamicResource Weight.SemiBold}"
                               Foreground="{DynamicResource Ios26AccentSoftTextBrush}"/>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!-- ═══ HERO · DIAGNOSTICS & APPLICATION HEALTH (Screen 06) ═══ -->
        <Border Style="{StaticResource Ios26CardStyle}" Margin="0,0,0,14">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48"
                            Style="{StaticResource Ios26IconTileStyle}"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE9F9;"
                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource Ios26FontSizeCardTitle}"
                                   Foreground="{DynamicResource Ios26AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Diagnostics &amp; Application Health"
                                   FontSize="{DynamicResource Ios26FontSizeCardTitle}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                        <TextBlock Text="Real-time crash logging, recording diagnostic markers, and local trace files"
                                   FontSize="{DynamicResource Ios26FontSizeSmall}"
                                   Foreground="{DynamicResource Ios26TextMutedBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="3" Style="{StaticResource Ios26ChipGreenStyle}"
                            VerticalAlignment="Center">
                        <TextBlock Text="Monitoring Active"
                                   FontSize="{DynamicResource Ios26FontSizeSmall}"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource Ios26SuccessBrush}"/>
                    </Border>
                </Grid>

                <WrapPanel>
                    <Border Style="{StaticResource Ios26InnerTileStyle}" Padding="12,8" Margin="0,0,8,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource Ios26FontSizeBody}"
                                       Foreground="{DynamicResource Ios26SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Local Trace Vault" FontSize="{DynamicResource Ios26FontSizeSmall}"
                                       FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource Ios26TextTitleBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Ios26InnerTileStyle}" Padding="12,8" Margin="0,0,8,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE950;" FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource Ios26FontSizeBody}"
                                       Foreground="{DynamicResource Ios26AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Live Stream Audited" FontSize="{DynamicResource Ios26FontSizeSmall}"
                                       FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource Ios26TextTitleBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Ios26InnerTileStyle}" Padding="12,8" Margin="0,0,8,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource Ios26FontSizeBody}"
                                       Foreground="{DynamicResource Ios26AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Zero Cloud Leakage" FontSize="{DynamicResource Ios26FontSizeSmall}"
                                       FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource Ios26TextTitleBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═══ CRASH REPORTS (self-contained card) ═══ -->
        <aboutSections:AboutCrashReportsCard Margin="0,0,0,14"/>

        <!-- ═══ RECORDING HEALTH ═══ -->
        <Border Style="{StaticResource Ios26CardStyle}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource About.RecordingHealth}"
                           FontSize="{DynamicResource Ios26FontSizeCardTitle}"
                           FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{DynamicResource Ios26TextTitleBrush}"
                           Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding RecordingMarkers}"
                              ItemTemplate="{StaticResource DxMarkerChipTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="{DynamicResource About.RecordingHealthSub}"
                           FontSize="{DynamicResource Ios26FontSizeSmall}"
                           Foreground="{DynamicResource Ios26TextMutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══ APP LOG ═══ -->
        <Border Style="{StaticResource Ios26CardStyle}">
            <StackPanel>
                <TextBlock Text="{DynamicResource About.AppLog}"
                           FontSize="{DynamicResource Ios26FontSizeCardTitle}"
                           FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{DynamicResource Ios26TextTitleBrush}"
                           Margin="0,0,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE8B7;"
                               FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="{DynamicResource Ios26FontSizeCardTitleSm}"
                               Foreground="{DynamicResource Ios26TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               IsHitTestVisible="False"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding AppLogPath}"
                               FontSize="{DynamicResource Ios26FontSizeValue}"
                               FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource Ios26TextBodyBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding AppLogPath}"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource AboutPillButtonStyle}"
                            Content="{DynamicResource About.OPENFolder}"
                            Margin="14,0,0,0"
                            Click="OpenLogFolder_Click"/>
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
