<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/Sections/AboutOverviewSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: About → "Overview" tab

     2026-09-15 iOS-26 full restyle (approved mockup 01):
       • Identity card (edition pill + Company/Product/Tagline rows)
         beside the Copyright card,
       • two Key Capabilities cards (icon-left rows / icon-top tiles),
       • the product story card (overview · data ownership ·
         engineering · compliance · extensibility — all original
         content preserved),
       • the privacy card.
     Self-contained Ios26 palette; DynamicResource-only; no hex, no
     literal corner radii. Audit contracts kept: responsive WrapPanel
     header + {Binding Modules.Count, Mode=OneWay}.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.AboutOverviewSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Edition pill on the Identity card (mockup "Trial"). -->
            <Style x:Key="IdentityEditionPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Ios26AccentBrush}"/>
                <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusChip}"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!-- ═══ ROW 1 · IDENTITY + COPYRIGHT (mockup 01) ═══ -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Identity card -->
            <Border Grid.Column="0" Style="{StaticResource Ios26CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource About.Identity}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Ios26TextTitleBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Style="{StaticResource IdentityEditionPillStyle}">
                            <TextBlock Text="{Binding LicenseStatus.EditionDisplay}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Ios26OnAccentBrush}"/>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   FontSize="13.5"
                                   Foreground="{DynamicResource Ios26TextMutedBrush}"
                                   Margin="0,0,0,11" VerticalAlignment="Center">
                            <Run Text="{DynamicResource Common.Company}"/><Run Text=" →"/>
                        </TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding AppName}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ios26TextBodyBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,11" VerticalAlignment="Center"/>
                        <Border Grid.Row="0" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                                Background="{DynamicResource Ios26HairlineBrush}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   FontSize="13.5"
                                   Foreground="{DynamicResource Ios26TextMutedBrush}"
                                   Margin="0,11,0,11" VerticalAlignment="Center">
                            <Run Text="{DynamicResource About.Product}"/><Run Text=" →"/>
                        </TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding AppName}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ios26TextBodyBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,11,0,11" VerticalAlignment="Center"/>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                                Background="{DynamicResource Ios26HairlineBrush}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   FontSize="13.5"
                                   Foreground="{DynamicResource Ios26TextMutedBrush}"
                                   Margin="0,11,0,0" VerticalAlignment="Center">
                            <Run Text="{DynamicResource About.Tagline}"/><Run Text=" →"/>
                        </TextBlock>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding AppTagline}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ios26TextBodyBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,11,0,0" VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Copyright card -->
            <Border Grid.Column="2" Style="{StaticResource Ios26CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.CopyrightHeading}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Ios26TextTitleBrush}"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Copyright}"
                               FontSize="13.5"
                               Foreground="{DynamicResource Ios26TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ ROW 2 · KEY CAPABILITIES (mockup 01: two cards —
             icon-left rows | icon-top tiles) ═══ -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Ios26CardStyle}">
                <StackPanel>
                    <!-- WrapPanel header (audit lock: responsive wrap
                         layout in this file). -->
                    <WrapPanel Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource About.KeyCapabilities}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                        <TextBlock Text="{DynamicResource About.WhatSetsProglassAutomationApart}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Ios26TextMutedBrush}"
                                   Margin="12,2,0,0"
                                   VerticalAlignment="Center"/>
                    </WrapPanel>
                    <UniformGrid Columns="2">
                        <ItemsControl ItemsSource="{Binding CapabilitiesTop}"
                                      ItemTemplate="{StaticResource CapabilityRowTemplate}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Ios26CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.KeyCapabilities}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Ios26TextTitleBrush}"
                               Margin="0,0,0,14"/>
                    <UniformGrid Columns="2">
                        <ItemsControl ItemsSource="{Binding CapabilitiesBottom}"
                                      ItemTemplate="{StaticResource CapabilityTileTemplate}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ PRODUCT STORY (all original content, mockup card
             language: one card, three quiet inset blocks) ═══ -->
        <Border Style="{StaticResource Ios26CardStyle}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource ToolTip.About}"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Ios26TextTitleBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource About.PurposeBuiltERPUAEGlassManufacturing}"
                           FontSize="12.5"
                           Foreground="{DynamicResource Ios26TextMutedBrush}"
                           Margin="0,0,0,14"/>

                <Border Style="{StaticResource AboutInsetStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Nav.Overview}"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Ios26TextMutedBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock FontSize="13.5"
                                   Foreground="{DynamicResource Ios26TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20">
                            <Run Text="{DynamicResource About.ProglassAutomationPurposeBuiltWindowsDesktop}"/>
                            <Run Text="{DynamicResource About.UAEBasedGlassManufacturingCompanies}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                            <Run Text="{DynamicResource About.ReplacesSpreadsheetDrivenWorkflowsFully}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AboutInsetStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About.DATAOwnershipDeployment}"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Ios26TextMutedBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock FontSize="13.5"
                                   Foreground="{DynamicResource Ios26TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20">
                            <Run Text="{DynamicResource About.StandaloneWindowsDeploymentNoCloudDependency}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AboutInsetStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About.EngineeringPrinciples}"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Ios26TextMutedBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock FontSize="13.5"
                                   Foreground="{DynamicResource Ios26TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20">
                            <Run Text="{DynamicResource About.DeterministicCalculations}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                            <Run Text="{DynamicResource About.FormulaProducesResultTimeNoHiddenStateRace}"/>
                            <LineBreak/><LineBreak/>
                            <Run Text="{DynamicResource About.ModularIsolation}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                            <Run Text="{DynamicResource About.BusinessDomainDataBoundaryLimitingBlast}"/>
                            <LineBreak/><LineBreak/>
                            <Run Text="{DynamicResource About.AISafeArchitecture}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                            <Run Text="{DynamicResource About.StrictMVVMConventionsKeepCodebase}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AboutInsetStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About.FinancialCompliance}"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Ios26TextMutedBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock FontSize="13.5"
                                   Foreground="{DynamicResource Ios26TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20">
                            <Run Text="{DynamicResource About.MonetaryValuesStoredDisplayed}"/>
                            <Run Text="{DynamicResource About.CurrencyUAE}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                            <Run Text="{DynamicResource About.FullPrecisionUAE5VATZeroRatedExportSupport}"/>
                        </TextBlock>
                        <TextBlock FontSize="13.5"
                                   Foreground="{DynamicResource Ios26TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,10,0,0">
                            <Run Text="{DynamicResource About.ExtensibilityFuture}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                            <Run Text="{DynamicResource About.CurrentReleaseShips}"/>
                            <Run Text="{Binding Modules.Count, Mode=OneWay}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                            <Run Text="{DynamicResource About.ActiveModulesCommercialProductionLifecycle}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ PRIVACY ═══ -->
        <Border Style="{StaticResource Ios26CardStyle}">
            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="17"
                                   Foreground="{DynamicResource Ios26AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource About.Privacy}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Ios26TextTitleBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource About.LocalFirstDataHandlingOperatorControl}"
                               FontSize="13"
                               Foreground="{DynamicResource Ios26TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Style="{StaticResource AboutInsetStyle}">
                    <ItemsControl ItemsSource="{Binding PrivacyLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="13"
                                               Foreground="{DynamicResource Ios26SuccessBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,9,0"/>
                                    <TextBlock Text="{Binding}"
                                               FontSize="13.5"
                                               Foreground="{DynamicResource Ios26TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="20"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
