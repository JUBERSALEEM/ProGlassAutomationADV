<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/Sections/AboutOverviewSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: About → "About" tab (overview + principles + compliance +
             data ownership + capabilities + privacy)

     Glass identity. Edited independently of the other About sections;
     uses the shared glass styles/templates in ../AboutStyles.xaml.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.AboutOverviewSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aboutSections="clr-namespace:ProGlassAutomation.Views.About.Sections"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!--
          ═══ LICENSE (Phase 3 — slice 5b) ═══
          A self-contained card whose DataContext is the
          LicenseStatusViewModel singleton. Shows the
          current licence status, edition, customer,
          expiry, days remaining, features, and both the
          licence-bound fingerprint and the current
          machine's fingerprint (with a copy button).
        -->
        <aboutSections:AboutLicenseCard/>

        <!--
          ═══ RECENT CRASH REPORTS (Phase 2 — slice 2) ═══
          Self-contained card listing the last 10
          crash-*.txt files. Each row has a timestamp,
          error id, exception type, message, file size,
          and an OPEN button (gated by ProcessStartGuard).
          REFRESH / OPEN FOLDER / CLEAR ALL sit in the
          card header.
        -->
        <aboutSections:AboutCrashReportsCard/>

        <!-- ═══ ABOUT ═══ -->
        <!-- ═══ 2026-09-11 MOCKUP REBUILD: slim header + three floating
             cards in one row (Overview · Engineering · Compliance+Future).
             Every DynamicResource Run preserved verbatim from the previous
             two-column text wall. ═══ -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource ToolTip.About}"
                           Style="{StaticResource Typography.H2}"/>
                <TextBlock Text="{DynamicResource About.PurposeBuiltERPUAEGlassManufacturing}"
                           Style="{StaticResource Typography.BodySmall}"
                           Margin="0,0,0,0"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Style="{StaticResource Badge.Primary}">
                <TextBlock Style="{StaticResource Typography.Caption}">
                    <Run Text="{DynamicResource About.LIVEModules}"/>
                    <Run Text="{Binding Modules.Count, Mode=OneWay}"/>
                </TextBlock>
            </Border>
        </Grid>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CARD A · Overview + Data ownership -->
            <Border Grid.Column="0" Style="{StaticResource SurfacePrimaryStyle}">
                <StackPanel>
                    <Border Style="{StaticResource SurfaceSecondaryStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Nav.Overview}" Style="{StaticResource AboutPanelKickerStyle}"/>
                            <TextBlock Style="{StaticResource Typography.Body}">
                                <Run Text="{DynamicResource About.ProglassAutomationPurposeBuiltWindowsDesktop}"/>
                                <Run Text="{DynamicResource About.UAEBasedGlassManufacturingCompanies}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource LiquidSnow}"/>
                                <Run Text="{DynamicResource About.ReplacesSpreadsheetDrivenWorkflowsFully}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SurfaceSecondaryStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource About.DATAOwnershipDeployment}" Style="{StaticResource AboutPanelKickerStyle}"/>
                            <TextBlock Style="{StaticResource Typography.Body}"
                                       Text="{DynamicResource About.StandaloneWindowsDeploymentNoCloudDependency}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CARD B · Engineering principles -->
            <Border Grid.Column="2" Style="{StaticResource SurfacePrimaryStyle}">
                <Border Style="{StaticResource SurfaceSecondaryStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About.EngineeringPrinciples}" Style="{StaticResource AboutPanelKickerStyle}"/>
                        <TextBlock Style="{StaticResource Typography.Body}">
                            <Run Text="{DynamicResource About.DeterministicCalculations}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource LiquidSnow}"/>
                            <Run Text="{DynamicResource About.FormulaProducesResultTimeNoHiddenStateRace}"/>
                            <LineBreak/><LineBreak/>
                            <Run Text="{DynamicResource About.ModularIsolation}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource LiquidSnow}"/>
                            <Run Text="{DynamicResource About.BusinessDomainDataBoundaryLimitingBlast}"/>
                            <LineBreak/><LineBreak/>
                            <Run Text="{DynamicResource About.AISafeArchitecture}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource LiquidSnow}"/>
                            <Run Text="{DynamicResource About.StrictMVVMConventionsKeepCodebase}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Border>

            <!-- CARD C · Financial compliance + extensibility -->
            <Border Grid.Column="4" Style="{StaticResource SurfacePrimaryStyle}">
                <StackPanel>
                    <Border Style="{StaticResource SurfaceSecondaryStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource About.FinancialCompliance}" Style="{StaticResource AboutPanelKickerStyle}"/>
                            <TextBlock Style="{StaticResource Typography.Body}">
                                <Run Text="{DynamicResource About.MonetaryValuesStoredDisplayed}"/>
                                <Run Text="{DynamicResource About.CurrencyUAE}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource LiquidSnow}"/>
                                <Run Text="{DynamicResource About.FullPrecisionUAE5VATZeroRatedExportSupport}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SurfaceSecondaryStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource About.ExtensibilityFuture}" Style="{StaticResource AboutPanelKickerStyle}"/>
                            <TextBlock Style="{StaticResource Typography.Body}">
                                <Run Text="{DynamicResource About.CurrentReleaseShips}"/>
                                <Run Text="{Binding Modules.Count, Mode=OneWay}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource LiquidSnow}"/>
                                <Run Text="{DynamicResource About.ActiveModulesCommercialProductionLifecycle}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ CAPABILITIES ═══ -->
        <Border Style="{StaticResource SurfacePrimaryStyle}">
            <StackPanel>
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="{DynamicResource About.KeyCapabilities}"
                               Style="{StaticResource Typography.H2}"/>
                    <TextBlock Text="{DynamicResource About.WhatSetsProglassAutomationApart}"
                               Style="{StaticResource Typography.BodySmall}"
                               Margin="0,0,0,0"/>
                </StackPanel>

                <Border Style="{StaticResource SurfaceSecondaryStyle}"
                        Padding="14,14"
                        Margin="0,0,0,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding CapabilitiesTop}"
                                      ItemTemplate="{StaticResource CapabilityCardTemplate}"
                                      Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding CapabilitiesBottom}"
                                      ItemTemplate="{StaticResource CapabilityCardTemplate}"
                                      Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ PRIVACY ═══ -->
        <Border Style="{StaticResource SurfacePrimaryStyle}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.H3}"
                                   Foreground="{DynamicResource LiquidAccent}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource About.Privacy}"
                                   FontSize="{DynamicResource FontSize.H3}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource LiquidSnow}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource About.LocalFirstDataHandlingOperatorControl}"
                               FontSize="{DynamicResource FontSize.Body}"
                               Foreground="{DynamicResource LiquidCerulean}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Border Style="{StaticResource SurfaceSecondaryStyle}" Margin="0,0,0,0">
                    <ItemsControl ItemsSource="{Binding PrivacyLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                    <TextBlock Text="•"
                                               FontSize="{DynamicResource FontSize.Body}"
                                               FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource LiquidAccent}"
                                               Margin="0,0,9,0"/>
                                    <TextBlock Text="{Binding}"
                                               FontSize="{DynamicResource FontSize.Body}"
                                               TextWrapping="Wrap"
                                               LineHeight="20"
                                               Foreground="{DynamicResource LiquidFrost}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
