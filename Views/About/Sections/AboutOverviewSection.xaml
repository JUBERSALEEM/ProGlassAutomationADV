<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/Sections/AboutOverviewSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: About → "About" tab (overview + principles + compliance +
             data ownership + capabilities + privacy)

     Glass identity. Edited independently of the other About sections;
     uses the shared glass styles/templates in ../AboutStyles.xaml.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.AboutOverviewSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aboutSections="clr-namespace:ProGlassAutomation.Views.About.Sections"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!--
          ═══ LICENSE (Phase 3 — slice 5b) ═══
          A self-contained card whose DataContext is the
          LicenseStatusViewModel singleton. Shows the
          current licence status, edition, customer,
          expiry, days remaining, features, and both the
          licence-bound fingerprint and the current
          machine's fingerprint (with a copy button).
        -->
        <aboutSections:AboutLicenseCard/>

        <!--
          ═══ RECENT CRASH REPORTS (Phase 2 — slice 2) ═══
          Self-contained card listing the last 10
          crash-*.txt files. Each row has a timestamp,
          error id, exception type, message, file size,
          and an OPEN button (gated by ProcessStartGuard).
          REFRESH / OPEN FOLDER / CLEAR ALL sit in the
          card header.
        -->
        <aboutSections:AboutCrashReportsCard/>

        <!-- ═══ ABOUT ═══ -->
        <Border Style="{StaticResource AboutCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="About ProGlass Automation"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Purpose-built ERP for UAE glass manufacturing"
                                   Style="{StaticResource SectionSubtitleStyle}"
                                   Margin="0,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource AboutHeaderBadgeStyle}">
                        <TextBlock Style="{StaticResource AboutHeaderBadgeTextStyle}">
                            <Run Text="LIVE MODULES  "/>
                            <Run Text="{Binding Modules.Count, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource AboutSectionPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="OVERVIEW" Style="{StaticResource AboutPanelKickerStyle}"/>
                                <TextBlock Style="{StaticResource AboutPanelTextStyle}">
                                    <Run Text="ProGlass Automation is a purpose-built Windows desktop application designed specifically for "/>
                                    <Run Text="UAE-based glass manufacturing companies" FontWeight="Bold" Foreground="{DynamicResource GlassSnow}"/>
                                    <Run Text=". It replaces spreadsheet-driven workflows with a fully integrated system covering raw material inventory, quoting, production planning, delivery tracking, and financial reporting — all in one place."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource AboutSectionPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="ENGINEERING PRINCIPLES" Style="{StaticResource AboutPanelKickerStyle}"/>
                                <TextBlock Style="{StaticResource AboutPanelTextStyle}">
                                    <Run Text="• Deterministic calculations —" FontWeight="Bold" Foreground="{DynamicResource GlassSnow}"/>
                                    <Run Text=" every formula produces the same result every time, with no hidden state or race conditions."/>
                                    <LineBreak/><LineBreak/>
                                    <Run Text="• Modular isolation —" FontWeight="Bold" Foreground="{DynamicResource GlassSnow}"/>
                                    <Run Text=" each business domain has its own data boundary, limiting blast radius when defects occur."/>
                                    <LineBreak/><LineBreak/>
                                    <Run Text="• AI-safe architecture —" FontWeight="Bold" Foreground="{DynamicResource GlassSnow}"/>
                                    <Run Text=" strict MVVM conventions keep the codebase maintainable for long-term enterprise use."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource AboutSectionPanelStyle}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="DATA OWNERSHIP &amp; DEPLOYMENT" Style="{StaticResource AboutPanelKickerStyle}"/>
                                <TextBlock Style="{StaticResource AboutPanelTextStyle}"
                                           Text="Standalone Windows deployment — no cloud dependency required for daily operations. Customer records, invoices, delivery evidence and financial data remain on the local machine, with automatic rotating backups retained for offline factory environments."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource AboutSectionPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="FINANCIAL &amp; COMPLIANCE" Style="{StaticResource AboutPanelKickerStyle}"/>
                                <TextBlock Style="{StaticResource AboutPanelTextStyle}">
                                    <Run Text="All monetary values are stored and displayed in "/>
                                    <Run Text="AED (UAE Dirham)" FontWeight="Bold" Foreground="{DynamicResource GlassSnow}"/>
                                    <Run Text=" with full precision. UAE 5% VAT, zero-rated export support and invoice traceability are built into the workflow so finance and operations stay aligned."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource AboutSectionPanelStyle}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="EXTENSIBILITY &amp; FUTURE" Style="{StaticResource AboutPanelKickerStyle}"/>
                                <TextBlock Style="{StaticResource AboutPanelTextStyle}">
                                    <Run Text="The current release ships with "/>
                                    <Run Text="{Binding Modules.Count, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource GlassSnow}"/>
                                    <Run Text=" active modules across the commercial and production lifecycle. Upcoming production-stage modules will slot into the same shell without database rewrites, while AI assistance remains optional and fully operator-controlled."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ CAPABILITIES ═══ -->
        <Border Style="{StaticResource AboutCardStyle}">
            <StackPanel>
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Key Capabilities"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="What sets ProGlass Automation apart"
                               Style="{StaticResource SectionSubtitleStyle}"
                               Margin="0,0,0,0"/>
                </StackPanel>

                <Border Style="{StaticResource AboutSectionPanelStyle}"
                        Padding="14,14"
                        Margin="0,0,0,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding CapabilitiesTop}"
                                      ItemTemplate="{StaticResource CapabilityCardTemplate}"
                                      Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding CapabilitiesBottom}"
                                      ItemTemplate="{StaticResource CapabilityCardTemplate}"
                                      Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ PRIVACY ═══ -->
        <Border Style="{StaticResource AboutCardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource GlassAccent}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Privacy"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource GlassSnow}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Local-first data handling, operator control, and practical privacy boundaries"
                               FontSize="12"
                               Foreground="{DynamicResource GlassCerulean}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Border Style="{StaticResource AboutSectionPanelStyle}" Margin="0,0,0,0">
                    <ItemsControl ItemsSource="{Binding PrivacyLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                    <TextBlock Text="•"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource GlassAccent}"
                                               Margin="0,0,9,0"/>
                                    <TextBlock Text="{Binding}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               LineHeight="20"
                                               Foreground="{DynamicResource GlassFrost}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
