<!--
  AboutLicenseCard — 2026-09-15 iOS-26 full restyle (approved mockup 02).

  Exact mockup layout, single-width card stack:
    1. STATUS  — green shield disc + status badge + description,
                 activation-status block on the right (trial countdown
                 bar for trials, license window for permanent keys).
    2. LICENSE DETAILS — one label/value row per field, hairlines
                 between rows, grey value pills + copy buttons for the
                 license id and the machine fingerprint.
    3. FEATURES — granted features as soft-blue chips (wildcard grants
                 render "All Modules" — never a literal "*").
  A slim muted footer keeps the license source, trusted issuer ring
  and optional issuer notes visible (data preserved, mockup look kept).

  Self-contained iOS-26 palette (Ios26* keys — the app theme is
  deliberately ignored on this module). Every value comes from the
  LicenseStatusViewModel singleton (DataContext set in code-behind).

  DATA CONTEXT CONTRACT (2026-09-15 root-cause fix — "License still
  looks empty"): this card keeps its license VM on the INNER
  <StackPanel x:Name="CardRoot">, never on the UserControl root. The
  root used to be re-pointed at LicenseStatusViewModel.Instance, which
  re-targeted the SHELL's tab-switch binding (an element's bindings
  resolve against its own DataContext) — the trigger could never fire and
  the whole License section stayed collapsed behind a working tab.
  Locked by AboutModuleAuditTests
  .About_views_do_not_hijack_a_hosted_section_datacontext.

  TYPOGRAPHY (2026-09-15 pass): every size comes from the About type
  scale (Ios26FontSize* — whole pixels only) and every weight from
  Weight.Regular / Weight.SemiBold / Weight.Bold. The detail rows use the
  shared Ios26FieldLabelStyle / Ios26FieldValueStyle roles: quiet 13 px
  Regular labels, 14 px Bold values.

  CRASH CONTRACTS PRESERVED:
    • ERR-3C0789 — ProgressBar.Value/Maximum are display-only and bound
      Mode=OneWay (DaysRemaining / TrialTotalDays are read-only).
    • Audit literals: LicenseWindowDisplay / ActivationModeDisplay /
      LicenseSourceDisplay / TrustedIssuerDisplay / About.COPYID /
      About.COPYFingerprint.
-->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.AboutLicenseCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Granted-feature chip (Features card). -->
            <Style x:Key="LicenseFeatureChipStyle" TargetType="Border"
                   BasedOn="{StaticResource Ios26ChipSoftStyle}">
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
            </Style>

            <DataTemplate x:Key="LicenseFeatureChipTemplate">
                <Border Style="{StaticResource LicenseFeatureChipStyle}">
                    <TextBlock Text="{Binding}"
                               FontSize="{DynamicResource Ios26FontSizeBody}"
                               FontWeight="{DynamicResource Weight.SemiBold}"
                               Foreground="{DynamicResource Ios26AccentSoftTextBrush}"
                               IsHitTestVisible="False"/>
                </Border>
            </DataTemplate>

            <!-- Small ghost copy button (mockup: icon-only square). -->
            <Style x:Key="LicenseCopyButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource AboutPillButtonStyle}">
                <Setter Property="Padding" Value="7,3"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- x:Name is REQUIRED: the shell's tab switch binds to the shell's own
         DataContext, so this card is allowed to keep its license VM on this
         INNER element only. The root element's DataContext is never touched
         (that hijack is what made the License tab render permanently empty —
         see AboutView.xaml, section content note). -->
    <StackPanel x:Name="CardRoot">

        <!-- 2026-09-15 senior fix: the card must NEVER look silently
             empty. If the license VM singleton is unavailable, the
             code-behind shows this explicit note instead (and the
             incident is in the app log). -->
        <Border x:Name="VmUnavailableNote"
                Style="{StaticResource Ios26CardStyle}"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <TextBlock FontSize="{DynamicResource Ios26FontSizeBody}"
                       Foreground="{DynamicResource Ios26TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Text="License data is temporarily unavailable — the license service did not respond in time. This card fills in automatically once it does. The exact incident is written to the app log (Help → Diagnostics)."/>
        </Border>

        <!-- ═══ HERO · LICENSE & WORKSTATION ENTITLEMENTS (Screen 02) ═══ -->
        <Border Style="{StaticResource Ios26CardStyle}" Margin="0,0,0,14">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48"
                            Style="{StaticResource Ios26IconTileStyle}"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BA;"
                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource Ios26FontSizeCardTitle}"
                                   Foreground="{DynamicResource Ios26AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="License &amp; Workstation Entitlements"
                                   FontSize="{DynamicResource Ios26FontSizeCardTitle}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                        <TextBlock Text="Cryptographically verified offline workstation authorization"
                                   FontSize="{DynamicResource Ios26FontSizeSmall}"
                                   Foreground="{DynamicResource Ios26TextMutedBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="3" Background="{DynamicResource Ios26AccentSoftBrush}"
                            BorderBrush="{DynamicResource Ios26AccentBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource Ios26RadiusSmall}"
                            Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EditionDisplay}"
                                   FontSize="{DynamicResource Ios26FontSizeSmall}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource Ios26AccentBrush}"/>
                    </Border>
                </Grid>

                <WrapPanel>
                    <Border Style="{StaticResource Ios26InnerTileStyle}" Padding="12,8" Margin="0,0,8,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7F8;" FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource Ios26FontSizeBody}"
                                       Foreground="{DynamicResource Ios26AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Unlimited Workstations" FontSize="{DynamicResource Ios26FontSizeSmall}"
                                       FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource Ios26TextTitleBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Ios26InnerTileStyle}" Padding="12,8" Margin="0,0,8,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE787;" FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource Ios26FontSizeBody}"
                                       Foreground="{DynamicResource Ios26SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Perpetual Validity" FontSize="{DynamicResource Ios26FontSizeSmall}"
                                       FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource Ios26TextTitleBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Ios26InnerTileStyle}" Padding="12,8" Margin="0,0,8,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE74C;" FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource Ios26FontSizeBody}"
                                       Foreground="{DynamicResource Ios26AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="All 12 Modules Unlocked" FontSize="{DynamicResource Ios26FontSizeSmall}"
                                       FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource Ios26TextTitleBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═══ 1 · STATUS ═══ -->
        <Border Style="{StaticResource Ios26CardStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon disc: soft-green when valid/expiring soon,
                     quiet otherwise. Fill/foreground come from Style
                     triggers only (a local value would beat the
                     trigger in WPF precedence). -->
                <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Ellipse Width="44" Height="44">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill"
                                        Value="{DynamicResource Ios26ValuePillBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsValid}" Value="True">
                                        <Setter Property="Fill"
                                                Value="{DynamicResource Ios26SuccessSoftBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="&#xE977;"
                               FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="{DynamicResource Ios26FontSizeGlyph}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Ios26TextFaintBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsValid}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource Ios26SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Badge + description. -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusBadge}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeH2}"/>
                                <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Ios26TextTitleBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsValid}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource Ios26SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusDescription}"
                               FontSize="{DynamicResource Ios26FontSizeSmall}"
                               Foreground="{DynamicResource Ios26TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               MaxWidth="520"/>

                    <!-- 2026-09-15: with no license payload there is no
                         Details card, so the tab would show a single block.
                         LicenseSourceDisplay already explains the next step
                         for exactly this state ("paste a vendor-signed key
                         in Settings → License") — surface it here instead
                         of hiding it inside the card that cannot render. -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,0"
                                Visibility="{Binding HasPayloadDetails, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="&#xE946;"
                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource Ios26FontSizeSmall}"
                                   Foreground="{DynamicResource Ios26AccentBrush}"
                                   VerticalAlignment="Top"
                                   Margin="0,2,7,0"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding LicenseSourceDisplay}"
                                   FontSize="{DynamicResource Ios26FontSizeBody}"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource Ios26TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="520"/>
                    </StackPanel>
                </StackPanel>

                <!-- Activation status block (right). Trials count days
                     down; permanent licences show the license window.
                     ERR-3C0789: ProgressBar Value/Maximum are
                     display-only → bind OneWay. -->
                <StackPanel Grid.Column="2"
                            MinWidth="240"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasPayloadDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Trial countdown strip. -->
                    <StackPanel Visibility="{Binding IsTrial, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{DynamicResource About.ActivationStatus}"
                                       FontSize="{DynamicResource Ios26FontSizeBody}"
                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                       Foreground="{DynamicResource Ios26TextBodyBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource About.DaysRemainingLabel}"
                                           FontSize="{DynamicResource Ios26FontSizeBody}"
                                           Foreground="{DynamicResource Ios26TextMutedBrush}"/>
                                <TextBlock Text="{Binding DaysRemaining}"
                                           FontSize="{DynamicResource Ios26FontSizeSubtitle}"
                                           FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource Ios26TextTitleBrush}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar Style="{StaticResource Ios26BarStyle}"
                                     Maximum="{Binding TrialTotalDays, Mode=OneWay}"
                                     Value="{Binding DaysRemaining, Mode=OneWay}"/>
                    </StackPanel>

                    <!-- Permanent license window. -->
                    <StackPanel Visibility="{Binding IsNotTrial, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource About.LicenseWindow}"
                                   FontSize="{DynamicResource Ios26FontSizeBody}"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource Ios26TextBodyBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding LicenseWindowDisplay}"
                                   FontSize="{DynamicResource Ios26FontSizeValue}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource Ios26TextTitleBrush}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 2 · LICENSE DETAILS ═══ -->
        <Border Style="{StaticResource Ios26CardStyle}"
                Visibility="{Binding HasPayloadDetails, Converter={StaticResource BoolToVisibilityConverter}}"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource About.LicenseDetails}"
                           Style="{StaticResource Ios26CardTitleStyle}"
                           Margin="0,0,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Common.Customer}"
                               Style="{StaticResource Ios26FieldLabelStyle}"
                               Margin="0,0,0,11"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CustomerDisplay}"
                               Style="{StaticResource Ios26FieldValueStyle}"
                               Margin="0,0,0,11"
                               ToolTip="{Binding CustomerDisplay}"/>
                    <Border Grid.Row="0" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                            Background="{DynamicResource Ios26HairlineBrush}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Common.Company}"
                               Style="{StaticResource Ios26FieldLabelStyle}"
                               Margin="0,11,0,11"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CompanyDisplay}"
                               Style="{StaticResource Ios26FieldValueStyle}"
                               Margin="0,11,0,11"
                               ToolTip="{Binding CompanyDisplay}"/>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                            Background="{DynamicResource Ios26HairlineBrush}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource About.ActivationMODE}"
                               Style="{StaticResource Ios26FieldLabelStyle}"
                               Margin="0,11,0,11"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActivationModeDisplay}"
                               Style="{StaticResource Ios26FieldValueStyle}"
                               Margin="0,11,0,11"
                               ToolTip="{Binding ActivationModeDisplay}"/>
                    <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                            Background="{DynamicResource Ios26HairlineBrush}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource About.Issued}"
                               Style="{StaticResource Ios26FieldLabelStyle}"
                               Margin="0,11,0,11"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding IssuedDisplay}"
                               Style="{StaticResource Ios26FieldValueStyle}"
                               Margin="0,11,0,11"
                               ToolTip="{Binding IssuedDisplay}"/>
                    <Border Grid.Row="3" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                            Background="{DynamicResource Ios26HairlineBrush}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource About.Expires}"
                               Style="{StaticResource Ios26FieldLabelStyle}"
                               Margin="0,11,0,11"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ExpiresDisplay}"
                               Style="{StaticResource Ios26FieldValueStyle}"
                               Margin="0,11,0,11"
                               ToolTip="{Binding ExpiresDisplay}"/>
                    <Border Grid.Row="4" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                            Background="{DynamicResource Ios26HairlineBrush}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource About.LicenseID}"
                               Style="{StaticResource Ios26FieldLabelStyle}"
                               Margin="0,11,0,11"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,11,0,11">
                        <Border Style="{StaticResource Ios26ValuePillStyle}">
                            <TextBlock Text="{Binding LicenseIdDisplay}"
                                       FontSize="{DynamicResource Ios26FontSizeSmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                       Foreground="{DynamicResource Ios26TextSecondaryBrush}"
                                       MaxWidth="300" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding LicenseIdDisplay}"/>
                        </Border>
                        <Button Style="{StaticResource LicenseCopyButtonStyle}"
                                Margin="8,0,0,0"
                                Click="CopyLicenseIdButton_Click"
                                AutomationProperties.Name="{DynamicResource About.COPYID}"
                                AutomationProperties.HelpText="{Binding LicenseIdDisplay}"
                                ToolTip="{DynamicResource About.COPYID}">
                            <TextBlock Text="&#xE8C8;"
                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource Ios26FontSizeSmall}"
                                       Foreground="{DynamicResource Ios26TextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="5" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                            Background="{DynamicResource Ios26HairlineBrush}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource About.MachineFingerprint}"
                               Style="{StaticResource Ios26FieldLabelStyle}"
                               Margin="0,11,0,11"/>
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,11,0,11">
                        <Border Style="{StaticResource Ios26ValuePillStyle}">
                            <TextBlock Text="{Binding MachineFingerprint}"
                                       FontSize="{DynamicResource Ios26FontSizeSmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                       Foreground="{DynamicResource Ios26TextSecondaryBrush}"
                                       MaxWidth="300" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding MachineFingerprint}"/>
                        </Border>
                        <Button Style="{StaticResource LicenseCopyButtonStyle}"
                                Margin="8,0,0,0"
                                Click="CopyFingerprintButton_Click"
                                AutomationProperties.Name="{DynamicResource About.COPYFingerprint}"
                                AutomationProperties.HelpText="{Binding MachineFingerprint}"
                                ToolTip="{DynamicResource About.COPYFingerprint}">
                            <TextBlock Text="&#xE8C8;"
                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource Ios26FontSizeSmall}"
                                       Foreground="{DynamicResource Ios26TextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="6" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                            Background="{DynamicResource Ios26HairlineBrush}"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource About.LicenseWindow}"
                               Style="{StaticResource Ios26FieldLabelStyle}"
                               Margin="0,11,0,0"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding LicenseWindowDisplay}"
                               Style="{StaticResource Ios26FieldValueStyle}"
                               Margin="0,11,0,0"
                               ToolTip="{Binding LicenseWindowDisplay}"/>
                </Grid>

                <!-- Slim data-preserving footer: license source +
                     trusted issuer ring (kept visible, mockup-quiet). -->
                <TextBlock Text="{Binding LicenseSourceDisplay}"
                           FontSize="{DynamicResource Ios26FontSizeLabel}"
                           Foreground="{DynamicResource Ios26TextFaintBrush}"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0"/>
                <TextBlock FontSize="{DynamicResource Ios26FontSizeLabel}"
                           Foreground="{DynamicResource Ios26TextFaintBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0">
                    <Run Text="{DynamicResource About.IssuerRing}"/>
                    <Run Text="&#x2009;"/>
                    <Run Text="{Binding TrustedIssuerDisplay, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ═══ 3 · FEATURES ═══ -->
        <Border Style="{StaticResource Ios26CardStyle}"
                Visibility="{Binding HasPayloadDetails, Converter={StaticResource BoolToVisibilityConverter}}"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Settings.SecFeatures}"
                           Style="{StaticResource Ios26CardTitleStyle}"
                           Margin="0,0,0,14"/>
                <ItemsControl ItemsSource="{Binding FeatureChips}"
                              ItemTemplate="{StaticResource LicenseFeatureChipTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="{Binding FeatureSummaryDisplay}"
                           FontSize="{DynamicResource Ios26FontSizeLabel}"
                           Foreground="{DynamicResource Ios26TextFaintBrush}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ═══ ISSUER NOTES (only when present) ═══ -->
        <Border Style="{StaticResource Ios26CardStyle}"
                Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource About.IssuerNotes}"
                           Style="{StaticResource Ios26CardTitleStyle}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding NotesDisplay}"
                           FontSize="{DynamicResource Ios26FontSizeBody}"
                           Foreground="{DynamicResource Ios26TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="19"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
