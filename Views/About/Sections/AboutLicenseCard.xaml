<!--
  AboutLicenseCard — polished licensing diagnostics for the About page.
  Layout goals:
    • one clean header with a single status badge
    • aligned summary metrics in a 2×2 industrial grid
    • consistent left/right field columns
    • separate code-style strips for license id / fingerprints
    • optional issuer notes only when present
-->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.AboutLicenseCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LicensePanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AboutInteractiveBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AboutInteractiveBorderBrush}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
                <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
                <Setter Property="Padding" Value="18,16"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="LicenseMetricCardStyle" TargetType="Border" BasedOn="{StaticResource LicensePanelStyle}">
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="Margin" Value="0,0,12,12"/>
            </Style>

            <Style x:Key="LicenseMetricLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource GlassCerulean}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>

            <Style x:Key="LicenseMetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource GlassSnow}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>

            <Style x:Key="LicenseCodeValueStyle" TargetType="TextBlock" BasedOn="{StaticResource LicenseFieldValueStyle}">
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource GlassSnow}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource AboutCardStyle}">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="License"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Activation health, issuer trust ring and machine scope"
                               Style="{StaticResource SectionSubtitleStyle}"
                               Margin="0,0,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="14,7"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource AboutInteractiveHoverBrush}"
                        BorderBrush="{DynamicResource AboutInteractiveBorderStrongBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding StatusBadge}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource GlassAccent}"/>
                </Border>
            </Grid>

            <Border Style="{StaticResource LicensePanelStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{Binding StatusDescription}"
                               FontSize="12"
                               Foreground="{DynamicResource GlassFrost}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SupportSummary}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource GlassSnow}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource LicenseMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="EDITION" Style="{StaticResource LicenseMetricLabelStyle}"/>
                        <TextBlock Text="{Binding EditionDisplay}" Style="{StaticResource LicenseMetricValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource LicenseMetricCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="DAYS REMAINING" Style="{StaticResource LicenseMetricLabelStyle}"/>
                        <TextBlock Text="{Binding DaysRemainingDisplay}" Style="{StaticResource LicenseMetricValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource LicenseMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ACTIVATION MODE" Style="{StaticResource LicenseMetricLabelStyle}"/>
                        <TextBlock Text="{Binding ActivationModeDisplay}" Style="{StaticResource LicenseMetricValueStyle}" FontSize="13"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource LicenseMetricCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="LICENSE WINDOW" Style="{StaticResource LicenseMetricLabelStyle}"/>
                        <TextBlock Text="{Binding LicenseWindowDisplay}" Style="{StaticResource LicenseMetricValueStyle}" FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Visibility="{Binding HasPayloadDetails, Converter={StaticResource BoolToVis}}"
                  Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource LicensePanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer" Style="{StaticResource LicenseFieldLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CustomerDisplay}" Style="{StaticResource LicenseFieldValueStyle}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Company" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CompanyDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,10,12,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Issued" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IssuedDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,10,12,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Expires" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExpiresDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,10,12,0"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource LicensePanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="License source" Style="{StaticResource LicenseFieldLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseSourceDisplay}" Style="{StaticResource LicenseFieldValueStyle}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Issuer ring" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TrustedIssuerDisplay}" Style="{StaticResource LicenseCodeValueStyle}" Margin="0,10,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Feature scope" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FeatureSummaryDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,10,12,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Features" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FeaturesDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,10,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource LicensePanelStyle}"
                    Visibility="{Binding HasPayloadDetails, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="License ID" Style="{StaticResource LicenseFieldLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseIdDisplay}" Style="{StaticResource LicenseCodeValueStyle}"/>
                    <Button Grid.Row="0" Grid.Column="2"
                            Style="{StaticResource AboutPillButtonStyle}"
                            Click="CopyLicenseIdButton_Click"
                            Margin="14,0,0,0"
                            VerticalAlignment="Top"
                            Content="COPY ID"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Licensed to" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,14,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MachineFingerprint}" Style="{StaticResource LicenseCodeValueStyle}" Margin="0,14,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="This machine" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,14,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentFingerprint}" Style="{StaticResource LicenseCodeValueStyle}" Margin="0,14,0,0"/>
                    <Button Grid.Row="2" Grid.Column="2"
                            Style="{StaticResource AboutPillButtonStyle}"
                            Click="CopyFingerprintButton_Click"
                            Margin="14,14,0,0"
                            VerticalAlignment="Top"
                            Content="COPY FINGERPRINT"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource LicensePanelStyle}"
                    Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Issuer notes"
                               Style="{StaticResource LicenseFieldLabelStyle}"/>
                    <TextBlock Text="{Binding NotesDisplay}"
                               Style="{StaticResource LicenseFieldValueStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
