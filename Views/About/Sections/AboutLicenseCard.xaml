<!--
  AboutLicenseCard — live licensing diagnostics for the About page.
  Binds to LicenseStatusViewModel.Instance and shows:
    • current status
    • license window (start → end)
    • activation mode / scope
    • trusted issuer ring
    • feature summary and notes
    • both licensed and current machine fingerprints
-->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.AboutLicenseCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource AboutCardStyle}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="License"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Activation health, trusted issuer ring and machine scope"
                               Style="{StaticResource SectionSubtitleStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Border Padding="10,5"
                            Margin="0,0,8,0"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Background="{DynamicResource AboutInteractiveHoverBrush}"
                            BorderBrush="{DynamicResource AboutInteractiveBorderStrongBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}">
                        <TextBlock Text="{Binding StatusBadge}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource GlassAccent}"/>
                    </Border>
                    <Border Padding="10,5"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Background="{DynamicResource AboutInteractiveBrush}"
                            BorderBrush="{DynamicResource AboutInteractiveBorderStrongBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}">
                        <TextBlock Text="{Binding FeatureSummaryDisplay}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlassSnow}"/>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StatusDescription}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Margin="0,12,0,12"
                       Foreground="{DynamicResource GlassFrost}"/>

            <Border Background="{DynamicResource AboutInteractiveBrush}"
                    BorderBrush="{DynamicResource AboutInteractiveBorderBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="16,14"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="License window"
                               Style="{StaticResource LicenseFieldLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseWindowDisplay}"
                               Style="{StaticResource LicenseFieldValueStyle}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Activation mode"
                               Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,8,0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActivationModeDisplay}"
                               Style="{StaticResource LicenseFieldValueStyle}" Margin="0,8,12,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="License source"
                               Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,8,0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseSourceDisplay}"
                               Style="{StaticResource LicenseFieldValueStyle}" Margin="0,8,12,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Trusted issuer ring"
                               Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TrustedIssuerDisplay}"
                               Style="{StaticResource LicenseFieldValueStyle}"
                               Margin="0,8,12,0"
                               FontFamily="Consolas, Cascadia Mono, Courier New"/>
                </Grid>
            </Border>

            <Grid Visibility="{Binding HasPayloadDetails, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Edition"
                           Style="{StaticResource LicenseFieldLabelStyle}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EditionDisplay}"
                           Style="{StaticResource LicenseFieldValueStyle}"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Days remaining"
                           Style="{StaticResource LicenseFieldLabelStyle}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding DaysRemainingDisplay}"
                           Style="{StaticResource LicenseFieldValueStyle}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer"
                           Style="{StaticResource LicenseFieldLabelStyle}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CustomerDisplay}"
                           Style="{StaticResource LicenseFieldValueStyle}"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Issued"
                           Style="{StaticResource LicenseFieldLabelStyle}"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding IssuedDisplay}"
                           Style="{StaticResource LicenseFieldValueStyle}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Company"
                           Style="{StaticResource LicenseFieldLabelStyle}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CompanyDisplay}"
                           Style="{StaticResource LicenseFieldValueStyle}"/>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="Expires"
                           Style="{StaticResource LicenseFieldLabelStyle}"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding ExpiresDisplay}"
                           Style="{StaticResource LicenseFieldValueStyle}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="License id"
                           Style="{StaticResource LicenseFieldLabelStyle}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                           Text="{Binding LicenseIdDisplay}"
                           Style="{StaticResource LicenseFieldValueStyle}"
                           FontFamily="Consolas, Cascadia Mono, Courier New"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Features"
                           Style="{StaticResource LicenseFieldLabelStyle}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                           Text="{Binding FeaturesDisplay}"
                           Style="{StaticResource LicenseFieldValueStyle}"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </Grid>

            <Border Background="{DynamicResource AboutInteractiveBrush}"
                    BorderBrush="{DynamicResource AboutInteractiveBorderBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="16,14"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Issuer notes"
                               Style="{StaticResource LicenseFieldLabelStyle}"/>
                    <TextBlock Text="{Binding NotesDisplay}"
                               Style="{StaticResource LicenseFieldValueStyle}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Licensed to"
                           Style="{StaticResource LicenseFieldLabelStyle}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding MachineFingerprint}"
                           FontFamily="Consolas, Cascadia Mono, Courier New"
                           FontSize="11"
                           Foreground="{DynamicResource GlassSnow}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="This machine"
                           Style="{StaticResource LicenseFieldLabelStyle}"
                           VerticalAlignment="Center"
                           Margin="0,6,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding CurrentFingerprint}"
                           FontFamily="Consolas, Cascadia Mono, Courier New"
                           FontSize="11"
                           Foreground="{DynamicResource GlassSnow}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,6,0,0"/>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource AboutPillButtonStyle}"
                            Click="CopyFingerprintButton_Click"
                            Margin="0,0,0,8"
                            Content="COPY FINGERPRINT"/>
                    <Button Style="{StaticResource AboutPillButtonStyle}"
                            Click="CopyLicenseIdButton_Click"
                            Content="COPY LICENSE ID"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
