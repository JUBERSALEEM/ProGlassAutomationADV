<!--
  AboutLicenseCard — final balanced licensing diagnostics for the About page.
  Layout goals:
    • full-width header and health summary
    • four evenly balanced commercial metrics
    • clean two-panel detail split
    • dedicated machine / identifier strip with aligned copy actions
    • optional issuer notes preserved without changing logic
-->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.AboutLicenseCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LicensePanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AboutInteractiveBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AboutInteractiveBorderBrush}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
                <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
                <Setter Property="Padding" Value="20,18"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="LicenseMetricCardStyle" TargetType="Border" BasedOn="{StaticResource LicensePanelStyle}">
                <Setter Property="MinHeight" Value="96"/>
                <Setter Property="Margin" Value="6"/>
            </Style>

            <Style x:Key="LicenseMetricLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource GlassCerulean}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>

            <Style x:Key="LicenseMetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource GlassSnow}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,8,0,0"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>

            <Style x:Key="LicenseCodeValueStyle" TargetType="TextBlock" BasedOn="{StaticResource LicenseFieldValueStyle}">
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource GlassSnow}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource AboutCardStyle}">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="License"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Activation health, issuer trust ring and machine scope"
                               Style="{StaticResource SectionSubtitleStyle}"
                               Margin="0,0,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        MinWidth="168"
                        Padding="16,8"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource AboutInteractiveHoverBrush}"
                        BorderBrush="{DynamicResource AboutInteractiveBorderStrongBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding StatusBadge}"
                               FontSize="12"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               Foreground="{DynamicResource GlassAccent}"/>
                </Border>
            </Grid>

            <Border Style="{StaticResource LicensePanelStyle}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="LICENSE HEALTH"
                                   Style="{StaticResource AboutPanelKickerStyle}"/>
                        <TextBlock Text="{Binding StatusDescription}"
                                   FontSize="12"
                                   Foreground="{DynamicResource GlassFrost}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Style="{StaticResource AboutCodeStripStyle}"
                            Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="SUPPORT SUMMARY"
                                       Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Text="{Binding SupportSummary}"
                                       Style="{StaticResource InfoValueStyle}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="-6,0,-6,12">
                <Border Style="{StaticResource LicenseMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="EDITION" Style="{StaticResource LicenseMetricLabelStyle}"/>
                        <TextBlock Text="{Binding EditionDisplay}" Style="{StaticResource LicenseMetricValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource LicenseMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="DAYS REMAINING" Style="{StaticResource LicenseMetricLabelStyle}"/>
                        <TextBlock Text="{Binding DaysRemainingDisplay}" Style="{StaticResource LicenseMetricValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource LicenseMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ACTIVATION MODE" Style="{StaticResource LicenseMetricLabelStyle}"/>
                        <TextBlock Text="{Binding ActivationModeDisplay}" Style="{StaticResource LicenseMetricValueStyle}" FontSize="13"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource LicenseMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="LICENSE WINDOW" Style="{StaticResource LicenseMetricLabelStyle}"/>
                        <TextBlock Text="{Binding LicenseWindowDisplay}" Style="{StaticResource LicenseMetricValueStyle}" FontSize="13"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Visibility="{Binding HasPayloadDetails, Converter={StaticResource BoolToVis}}"
                  Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource LicensePanelStyle}">
                    <StackPanel>
                        <TextBlock Text="ACCOUNT &amp; WINDOW"
                                   Style="{StaticResource AboutPanelKickerStyle}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer" Style="{StaticResource LicenseFieldLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CustomerDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Company" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CompanyDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,12,0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Issued" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IssuedDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,12,0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Expires" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExpiresDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,12,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource LicensePanelStyle}">
                    <StackPanel>
                        <TextBlock Text="TRUST &amp; ENTITLEMENTS"
                                   Style="{StaticResource AboutPanelKickerStyle}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="License source" Style="{StaticResource LicenseFieldLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseSourceDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Issuer ring" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TrustedIssuerDisplay}" Style="{StaticResource LicenseCodeValueStyle}" Margin="0,12,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Feature scope" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FeatureSummaryDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,12,0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Features" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FeaturesDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,12,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource LicensePanelStyle}"
                    Visibility="{Binding HasPayloadDetails, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="IDENTIFIERS &amp; MACHINE SCOPE"
                               Style="{StaticResource AboutPanelKickerStyle}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="License ID" Style="{StaticResource LicenseFieldLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseIdDisplay}" Style="{StaticResource LicenseCodeValueStyle}" Margin="0,0,0,0"/>
                        <Button Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource AboutPillButtonStyle}"
                                Click="CopyLicenseIdButton_Click"
                                Margin="14,0,0,0"
                                VerticalAlignment="Top"
                                Content="COPY ID"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Licensed to" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,14,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MachineFingerprint}" Style="{StaticResource LicenseCodeValueStyle}" Margin="0,14,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="This machine" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,14,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentFingerprint}" Style="{StaticResource LicenseCodeValueStyle}" Margin="0,14,0,0"/>
                        <Button Grid.Row="2" Grid.Column="2"
                                Style="{StaticResource AboutPillButtonStyle}"
                                Click="CopyFingerprintButton_Click"
                                Margin="14,14,0,0"
                                VerticalAlignment="Top"
                                Content="COPY FINGERPRINT"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource LicensePanelStyle}"
                    Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="ISSUER NOTES"
                               Style="{StaticResource AboutPanelKickerStyle}"/>
                    <TextBlock Text="{Binding NotesDisplay}"
                               Style="{StaticResource LicenseFieldValueStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
