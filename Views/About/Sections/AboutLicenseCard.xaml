<!--
  AboutLicenseCard — final balanced licensing diagnostics for the About page.
  Layout goals:
    • full-width header and health summary
    • four evenly balanced commercial metrics
    • clean two-panel detail split
    • dedicated machine / identifier strip with aligned copy actions
    • optional issuer notes preserved without changing logic
-->
<UserControl x:Class="ProGlassAutomation.Views.About.Sections.AboutLicenseCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            

            

            

            

            
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SurfacePrimaryStyle}">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource About.License}"
                               Style="{StaticResource Typography.H2}"/>
                    <TextBlock Text="{DynamicResource About.ActivationHealthIssuerTrustRingMachineScope}"
                               Style="{StaticResource Typography.BodySmall}"
                               Margin="0,0,0,0"/>
                </StackPanel>

                <!-- 2026-09-14: status badge keeps its own chrome — the
                     SurfacePrimaryStyle on top of it was double chrome. -->
                <Border Grid.Column="1"
                        MinWidth="168"
                        Padding="16,8"
                        CornerRadius="{DynamicResource Surface.Detail.CornerRadius}"
                        Background="{DynamicResource Surface.Detail.BackgroundBrush}"
                        BorderBrush="{DynamicResource Surface.Primary.BorderBrush}"
                        BorderThickness="{DynamicResource Surface.Detail.BorderThickness}"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding StatusBadge}"
                               FontSize="{DynamicResource FontSize.Body}"
                               FontWeight="{DynamicResource Weight.Bold}"
                               TextAlignment="Center"
                               Foreground="{DynamicResource LiquidAccent}"/>
                </Border>
            </Grid>

            <!-- 2026-09-14: this card sat inside the outer L1 card with its
                 OWN L1 chrome (card-in-card) → L2. -->
            <Border Style="{StaticResource AboutInsetStyle}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource About.LicenseHealth}"
                                   Style="{StaticResource AboutPanelKickerStyle}"/>
                        <TextBlock Text="{Binding StatusDescription}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource LiquidFrost}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Style="{StaticResource SurfaceDetailStyle}"
                            Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource About.SupportSummary}"
                                       Style="{StaticResource Typography.Label}"/>
                            <TextBlock Text="{Binding SupportSummary}"
                                       Style="{StaticResource Typography.Body}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2026-09-14: the row used Margin="-6,0,-6,12" expecting
                 6px tile margins that SurfaceKpiStyle does not define —
                 the four KPI tiles touched edge-to-edge and bled 6px
                 past the card padding ("cards overlapping"). Proper
                 6px gutters now, inside the card. -->
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource SurfaceKpiStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About.Edition}" Style="{StaticResource Typography.Label}"/>
                        <TextBlock Text="{Binding EditionDisplay}" Style="{StaticResource Typography.Kpi}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SurfaceKpiStyle}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About.DAYSRemaining}" Style="{StaticResource Typography.Label}"/>
                        <TextBlock Text="{Binding DaysRemainingDisplay}" Style="{StaticResource Typography.Kpi}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SurfaceKpiStyle}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About.ActivationMODE}" Style="{StaticResource Typography.Label}"/>
                        <TextBlock Text="{Binding ActivationModeDisplay}" Style="{StaticResource Typography.Kpi}" FontSize="{DynamicResource FontSize.Title}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SurfaceKpiStyle}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About.LicenseWindow}" Style="{StaticResource Typography.Label}"/>
                        <TextBlock Text="{Binding LicenseWindowDisplay}" Style="{StaticResource Typography.Kpi}" FontSize="{DynamicResource FontSize.Title}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Visibility="{Binding HasPayloadDetails, Converter={StaticResource BoolToVisibilityConverter}}"
                  Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AboutInsetStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About.AccountWindow}"
                                   Style="{StaticResource AboutPanelKickerStyle}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Common.Customer}" Style="{StaticResource LicenseFieldLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CustomerDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Common.Company}" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CompanyDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,12,0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource About.Issued}" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IssuedDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,12,0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource About.Expires}" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExpiresDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,12,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource AboutInsetStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About.TrustEntitlements}"
                                   Style="{StaticResource AboutPanelKickerStyle}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource About.LicenseSource}" Style="{StaticResource LicenseFieldLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseSourceDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource About.IssuerRing}" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TrustedIssuerDisplay}" Style="{StaticResource Typography.Caption}" Margin="0,12,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource About.FeatureScope}" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FeatureSummaryDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,12,0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Settings.SecFeatures}" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FeaturesDisplay}" Style="{StaticResource LicenseFieldValueStyle}" Margin="0,12,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource AboutInsetStyle}"
                    Visibility="{Binding HasPayloadDetails, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.IdentifiersMachineScope}"
                               Style="{StaticResource AboutPanelKickerStyle}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource About.LicenseID}" Style="{StaticResource LicenseFieldLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseIdDisplay}" Style="{StaticResource Typography.Caption}" Margin="0,0,0,0"/>
                        <Button Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource AboutPillButtonStyle}"
                                Click="CopyLicenseIdButton_Click"
                                Margin="14,0,0,0"
                                VerticalAlignment="Top"
                                Content="{DynamicResource About.COPYID}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource About.Licensed}" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,14,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MachineFingerprint}" Style="{StaticResource Typography.Caption}" Margin="0,14,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource About.Machine}" Style="{StaticResource LicenseFieldLabelStyle}" Margin="0,14,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentFingerprint}" Style="{StaticResource Typography.Caption}" Margin="0,14,0,0"/>
                        <Button Grid.Row="2" Grid.Column="2"
                                Style="{StaticResource AboutPillButtonStyle}"
                                Click="CopyFingerprintButton_Click"
                                Margin="14,14,0,0"
                                VerticalAlignment="Top"
                                Content="{DynamicResource About.COPYFingerprint}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AboutInsetStyle}"
                    Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.IssuerNotes}"
                               Style="{StaticResource AboutPanelKickerStyle}"/>
                    <TextBlock Text="{Binding NotesDisplay}"
                               Style="{StaticResource LicenseFieldValueStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
