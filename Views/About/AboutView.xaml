<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/AboutView.xaml
     PROJECT: ProGlassAutomation
     MODULE: About — tabbed glass shell (v6)

     Glass identity (matches Splash / Login):
       • deep-navy aurora stage with soft orbs
       • frosted glass hero + segmented tabs + section cards
       • light glass text (Ice / Frost / Cerulean / Snow)

     Structure:
       • compact glass hero (icon + identity + version/build)
       • segmented top tab strip: About · Modules · Developer
       • content area switches between three section UserControls
         (one XAML file per section, edited independently)

     PRESERVED:
       • AboutViewModel bindings (AppName, AppTagline, Version, Build,
         DeveloperName, Country, Email, Copyright, PrivacyLines,
         LeftPillars, RightPillars, SalesCycle, ProductionStages,
         DispatchBilling, Modules, TechStack, CapabilitiesTop/Bottom)
       • RootScrollViewer x:Name + SmoothScrollBehavior
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:aboutSections="clr-namespace:ProGlassAutomation.Views.About.Sections"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══ SEGMENTED GLASS TAB STRIP ═══ -->
            <Style x:Key="AboutTabListStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AboutTabItemStyle" TargetType="ListBoxItem">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{StaticResource GlassFrost}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="TabBg"
                                    Background="#14FFFFFF"
                                    BorderBrush="#40BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="18,9"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBg" Property="Background" Value="#26FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBg" Property="Background" Value="{StaticResource GlassAccentDeep}"/>
                                    <Setter TargetName="TabBg" Property="BorderBrush" Value="{StaticResource GlassAccent}"/>
                                    <Setter Property="Foreground" Value="{StaticResource GlassSnow}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ═══ ROOT — glass stage ═══
         2026-08-25 senior fix: the stage background and aurora orbs used
         to come from AboutStyles.xaml via StaticResource. If that merged
         dictionary failed to load (or resolved late), the stage rendered
         TRANSPARENT — the "transparent About section" symptom — and the
         lookup failure could take the whole view down. The stage is now
         painted with inline brushes: zero resource dependencies, so the
         About stage can never render transparent again. -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1026" Offset="0.0"/>
                <GradientStop Color="#102A56" Offset="0.5"/>
                <GradientStop Color="#0B1026" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Ellipse Width="560" Height="560"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-180,-140,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#4D82F6FF" Offset="0.0"/>
                    <GradientStop Color="#1D4ED84D" Offset="0.55"/>
                    <GradientStop Color="#1D4ED800" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="420" Height="420"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-120,0,0,-120" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#60A5FA66" Offset="0.0"/>
                    <GradientStop Color="#3B82F633" Offset="0.55"/>
                    <GradientStop Color="#3B82F600" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer x:Name="RootScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="40,40,40,40">

                <!-- ═══ HERO — frosted identity strip ═══ -->
                <Border Style="{StaticResource HeroCardStyle}">
                    <Grid>
                        <Border Background="{StaticResource GlassSheen}"
                                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                                IsHitTestVisible="False"/>

                        <Grid Margin="30,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- App icon -->
                            <Grid Grid.Column="0" Margin="0,0,24,0">
                                <Ellipse Width="104" Height="104"
                                         Stroke="{StaticResource GlassAccent}"
                                         StrokeThickness="1" StrokeDashArray="4 6"
                                         Opacity="0.5" IsHitTestVisible="False"/>
                                <Border Width="84" Height="84"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        Background="#26FFFFFF"
                                        BorderBrush="#66BFDBFE"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <Border Width="76" Height="76"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            ClipToBounds="True">
                                        <Border.Background>
                                            <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                                        Stretch="UniformToFill"
                                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border.Background>
                                    </Border>
                                </Border>
                            </Grid>

                            <!-- Identity -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppName}"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource GlassSnow}"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="{Binding AppTagline}"
                                           FontSize="13"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource GlassCerulean}"
                                           IsHitTestVisible="False"/>
                            </StackPanel>

                            <!-- Version / build / edition -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <Border Background="{StaticResource GlassAccentDeep}"
                                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,8"
                                        HorizontalAlignment="Right"
                                        BorderBrush="#66BFDBFE" BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <TextBlock Text="{Binding Version}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="White"
                                               IsHitTestVisible="False"/>
                                </Border>
                                <Border Style="{StaticResource ChipStyle}" Margin="0,8,0,0"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Build}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource GlassAccent}"
                                               IsHitTestVisible="False"/>
                                </Border>
                                <!--
                                  Edition badge — bound to the
                                  live LicenseStatusViewModel.
                                  The badge shows the current
                                  edition (Trial / Business /
                                  etc.) and a status hint when
                                  the licence is in grace
                                  period or expiring soon.
                                  The full detail (customer,
                                  expiry, fingerprint) lives in
                                  the License card in the About
                                  section below.
                                -->
                                <Border Style="{StaticResource ChipStyle}" Margin="0,8,0,0"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding LicenseStatus.EditionDisplay}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource GlassAccent}"
                                               IsHitTestVisible="False"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═══ TAB STRIP ═══ -->
                <ListBox ItemsSource="{Binding Tabs}"
                         SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                         Style="{StaticResource AboutTabListStyle}"
                         ItemContainerStyle="{StaticResource AboutTabItemStyle}"
                         Margin="0,0,0,20"/>

                <!-- ═══ SECTION CONTENT (switched by SelectedTabIndex) ═══ -->
                <Grid>
                    <aboutSections:AboutOverviewSection>
                        <aboutSections:AboutOverviewSection.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </aboutSections:AboutOverviewSection.Style>
                    </aboutSections:AboutOverviewSection>

                    <aboutSections:ModulesSection>
                        <aboutSections:ModulesSection.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </aboutSections:ModulesSection.Style>
                    </aboutSections:ModulesSection>

                    <aboutSections:DeveloperSection>
                        <aboutSections:DeveloperSection.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </aboutSections:DeveloperSection.Style>
                    </aboutSections:DeveloperSection>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
