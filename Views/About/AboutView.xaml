<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/AboutView.xaml
     PROJECT: ProGlassAutomation
     MODULE: About — tabbed glass shell (v6)
     Glass identity (matches Splash / Login):
       • deep-navy aurora stage with soft orbs
       • frosted glass hero + segmented tabs + section cards
       • light glass text (Ice / Frost / Cerulean / Snow)
     Structure:
       • compact glass hero (icon + identity + version/build)
       • segmented top tab strip: About · Modules · Developer
       • content area switches between three section UserControls
         (one XAML file per section, edited independently)
     PRESERVED:
       • AboutViewModel bindings (AppName, AppTagline, Version, Build,
         DeveloperName, Email, Copyright, PrivacyLines,
         LeftPillars, RightPillars, SalesCycle, ProductionStages,
         DispatchBilling, Modules, TechStack, CapabilitiesTop/Bottom)
       • RootScrollViewer x:Name + SmoothScrollBehavior
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:aboutSections="clr-namespace:ProGlassAutomation.Views.About.Sections"
             xmlns:viewsAbout="clr-namespace:ProGlassAutomation.Views.About"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══ SEGMENTED GLASS TAB STRIP ═══ -->
            

            <Style x:Key="AboutTabItemStyle" TargetType="ListBoxItem">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{DynamicResource LiquidFrost}"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}"/>
                <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                        <!-- 2026-09-14: 16px pill corner + conflicting
                             SurfacePrimaryStyle → 10px standard corner, no
                             double chrome (the template owns this Border). -->
                        <Border x:Name="TabBg"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Medium}"
                                Padding="18,7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBg" Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBg" Property="Background" Value="{DynamicResource LiquidAccentDeep}"/>
                                    <Setter TargetName="TabBg" Property="BorderBrush" Value="{DynamicResource LiquidAccent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ═══ ROOT — DYNAMIC glass stage (2026-08-25) ═══
         The stage is deliberately TRANSPARENT: the content card in
         MainWindow already paints, behind every module's content,
           • ModuleWallpaperBrush  — the per-module wallpaper when one
                                     is configured for "About" in
                                     Settings → Appearance, otherwise the
                                     system-wide wallpaper (or nothing)
           • ModuleBackgroundBrush — the theme/family module surface,
                                     made translucent by the theme engine
                                     when a wallpaper is active.
         So the About page now behaves exactly like every other module:
         Light/Dark swap, visual family (Normal / Monet / Ios-17pm),
         accent changes and wallpaper layering all re-tint the page live
         through DynamicResource — in ALL THREE sections
         (About / Modules / Developer share the Liquid* palette).

         The only stage-specific decoration is the two soft aurora orbs
         (theme-aware brushes LiquidOrbA / LiquidOrbB, defined per theme
         in Themes/DarkTheme.xaml + LightTheme.xaml).

         Transparency is safe by construction: the host card ALWAYS
         paints ModuleBackgroundBrush underneath, so the page can never
         render empty. (The old fixed-navy inline gradient was a
         stopgap from the "make transparency impossible" pass — it is
         also exactly what made the page ignore Settings → Appearance.)
         -->
    <Grid>
        <!-- 2026-09-10 fluid upgrade — CRASH-SAFE REWRITE (ERR-D71810).
             AboutView is instantiated inside a DataTemplate (MainWindow
             L147) and therefore loads through WPF's OPTIMISED template path
             (LoadOptimizedTemplateContent), which wraps the whole subtree in
             a single BeginInit/EndInit. ANY Storyboard/BeginStoryboard placed
             inline in this visual tree — whether via <Ellipse.Triggers> OR an
             inline <Ellipse.Style> Style.Triggers — is a Freezable that the
             loader tries to BeginInit while the subtree is already mid-init,
             throwing "Cannot have nested BeginInit calls on the same instance"
             (plus a TypeConverterMarkupExtension failure). The earlier attempt
             to move the loops into inline Styles did NOT help for exactly this
             reason. The robust fix: NO inline storyboards at all. Every
             ambient/entrance animation is now started imperatively from the
             code-behind Loaded handler (AboutView.xaml.cs), wrapped in
             try/catch so it can never crash the page. The transforms below are
             named so the code-behind can drive them. -->
        <!-- 2026-09-10 iOS-26 stage: full-bleed pastel mesh (light) /
             deep-navy aurora (dark) behind the glass. Theme-token driven
             (AboutWallpaperBrush) so Light / Dark / dynamic families all
             re-tint it live. Painted under the orbs and the glass slabs. -->
        <Border Background="{DynamicResource AboutWallpaperBrush}"
                IsHitTestVisible="False"/>

        <Ellipse Width="560" Height="560"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-180,-140,0" IsHitTestVisible="False"
                 Fill="{DynamicResource LiquidOrbA}"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="OrbAScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="OrbATranslate" X="0" Y="0"/>
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="420" Height="420"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-120,0,0,-120" IsHitTestVisible="False"
                 Fill="{DynamicResource LiquidOrbB}"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="OrbBScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="OrbBTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>


        <ScrollViewer x:Name="RootScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="26,22,26,26">

                <!-- ═══ HERO — frosted identity strip ═══ -->
                <Border Style="{StaticResource SurfaceElevatedStyle}">
                    <Grid>
                        <!-- 2026-09-14: sheen overlay must not carry a second
                             surface style (double chrome). -->
                        <Border Background="{DynamicResource LiquidSheen}"
                                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                                IsHitTestVisible="False"/>

                        <Grid Margin="24,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="210"/>
                            </Grid.ColumnDefinitions>

                            <!-- App icon — larger frosted brand tile with a
                                 soft accent halo + slow dashed orbit ring, so
                                 the About hero mirrors the splash brand moment. -->
                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,22,0">
                                <!-- accent halo bloom -->
                                <Ellipse Width="86" Height="86"
                                         Fill="{DynamicResource LiquidAccent}"
                                         Opacity="0.22" IsHitTestVisible="False">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="26"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Width="80" Height="80"
                                         Stroke="{DynamicResource LiquidAccent}"
                                         StrokeThickness="1" StrokeDashArray="4 6"
                                         Opacity="0.5" IsHitTestVisible="False"
                                         RenderTransformOrigin="0.5,0.5">
                                    <!-- Slow orbit ring. Animated imperatively from
                                         the code-behind Loaded handler (see the
                                         crash note on the aurora orbs above): no
                                         inline storyboard, so the optimised template
                                         load can never hit nested BeginInit. -->
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="IconRingRotate" Angle="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <!-- 2026-09-14: was a 64px card wrapping a 54px
                                     card (two overlapping tiles) → ONE 64px L3
                                     tile with the icon paint. -->
                                <Border Width="64" Height="64"
                                        Style="{StaticResource SurfaceDetailStyle}">
                                    <!--
                                      Shared frozen app icon
                                      (AppIconResource): decoded once
                                      per process instead of per
                                      About open — see the freeze
                                      note in AppIconResource.cs.
                                    -->
                                    <Border.Background>
                                        <ImageBrush ImageSource="{x:Static viewsAbout:AppIconResource.Icon}"
                                                    Stretch="UniformToFill"
                                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <!-- Identity -->
                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        MaxWidth="560">
                                <TextBlock Text="{Binding AppName}"
                                           FontSize="{DynamicResource FontSize.Kpi}"
                                           FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource LiquidSnow}"
                                           TextWrapping="Wrap"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="{Binding AppTagline}"
                                           FontSize="{DynamicResource FontSize.Title}"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource LiquidCerulean}"
                                           TextWrapping="Wrap"
                                           IsHitTestVisible="False"/>
                            </StackPanel>

                            <!-- Version / build / edition — iOS-26: one compact
                                 version pill + a horizontal flow of glass chips
                                 (was a 210px vertical stack of 5 boxes). -->
                            <StackPanel Grid.Row="0"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <!-- 2026-09-14: accent badge keeps its own
                                     chrome — the SurfacePrimaryStyle on top of
                                     it was double chrome. -->
                                <Border Background="{DynamicResource LiquidAccentDeep}"
                                        CornerRadius="{DynamicResource Radius.Card}"
                                        Padding="14,6"
                                        HorizontalAlignment="Right"
                                        BorderBrush="{DynamicResource AboutGlassSlabStroke}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <TextBlock Text="{Binding Version}"
                                               FontSize="{DynamicResource FontSize.Body}"
                                               FontWeight="{DynamicResource Weight.Bold}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                                               IsHitTestVisible="False"/>
                                </Border>
                                <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Border Style="{StaticResource Chip.Primary}" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding WhatsNew}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{DynamicResource LiquidAccent}"
                                                   IsHitTestVisible="False"/>
                                    </Border>
                                    <Border Style="{StaticResource Chip.Primary}" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding Build}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{DynamicResource LiquidAccent}"
                                                   IsHitTestVisible="False"/>
                                    </Border>
                                    <!-- 2026-09-14: edition restored in the
                                         hero (audit contract — AboutModuleAuditTests
                                         requires the shared license binding here;
                                         previously the edition only appeared in
                                         the Developer tab). -->
                                    <Border Style="{StaticResource Chip.Primary}" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding LicenseStatus.EditionDisplay}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{DynamicResource LiquidAccent}"
                                                   IsHitTestVisible="False"/>
                                    </Border>
                                    <Border Style="{StaticResource Chip.Primary}" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding LicenseStatus.StatusBadge}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource LiquidSnow}"
                                                   IsHitTestVisible="False"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Hero metrics restored: bind the shared pillar collections
                                 so the header once again exposes module count, databases,
                                 offline-first posture and AI readiness. -->
                            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ItemsControl Grid.Column="0"
                                              ItemsSource="{Binding LeftPillars}"
                                              ItemTemplate="{StaticResource HeroPillarTemplate}"
                                              HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <ItemsControl Grid.Column="2"
                                              ItemsSource="{Binding RightPillars}"
                                              ItemTemplate="{StaticResource HeroPillarTemplate}"
                                              HorizontalAlignment="Right">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Right"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═══ TAB STRIP — segmented control. FUNCTIONAL
                     NAVIGATION: never visibility-gated (2026-09-11 — the
                     chrome gate hid the ONLY path to Modules/Developer in
                     non-iOS26 families and under a dead engine; the owner
                     literally could not find the screens). Centered per the
                     approved mockup.
                     2026-09-14: the 999-radius glass capsule (Radius.Full) is
                     gone — standard 12px segmented control on the surface
                     system, matching every other module. ═══ -->
                <Border HorizontalAlignment="Center"
                        Style="{StaticResource SurfaceSecondaryStyle}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="6,5"
                        Margin="0,2,0,20"
                        SnapsToDevicePixels="True">
                    <!-- 2026-09-14: the ListBox defaulted to its VERTICAL
                         ItemsPanel, so the three tabs stacked top-to-bottom
                         at uneven widths. A 1×3 UniformGrid renders them in
                         one row, equal width, in order About → Modules →
                         Developer. -->
                    <ListBox ItemsSource="{Binding Tabs}"
                             SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                             Style="{StaticResource SurfaceSecondaryListBoxStyle}"
                             ItemContainerStyle="{StaticResource Tab.InactiveItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Border>

                <!-- ═══ SECTION CONTENT (switched by SelectedTabIndex) ═══
                     2026-09-10 fluid upgrade: each section now fades and
                     slides up smoothly as it becomes the selected tab
                     (IsVisible-driven storyboard on a per-section
                     TranslateTransform + Opacity). The switch is instant
                     to the user's click but reads as a polished, gentle
                     reveal instead of a hard cut. -->
                <!-- Each section is shown/hidden by SelectedTabIndex through a
                     plain DataTrigger Setter (a Style with only setters is not a
                     Freezable, so it is safe under the optimised template load).
                     The gentle fade+slide reveal is applied imperatively in the
                     code-behind (AboutView.xaml.cs) via IsVisibleChanged — NO
                     inline Storyboard, which is what crashed the page before
                     (ERR-D71810). Transforms are named so code-behind can drive
                     them. -->
                <Grid>
                    <aboutSections:AboutOverviewSection x:Name="OverviewSection"
                                                        RenderTransformOrigin="0.5,0.5">
                        <!-- The RenderTransform is NOT named: a section is a
                             UserControl with its own (sealed) NameScope, so
                             naming a transform set as its RenderTransform throws
                             MC3093. Code-behind reaches it via
                             OverviewSection.RenderTransform instead. -->
                        <aboutSections:AboutOverviewSection.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </aboutSections:AboutOverviewSection.RenderTransform>
                        <aboutSections:AboutOverviewSection.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </aboutSections:AboutOverviewSection.Style>
                    </aboutSections:AboutOverviewSection>

                    <aboutSections:ModulesSection x:Name="ModulesSectionHost"
                                                  RenderTransformOrigin="0.5,0.5">
                        <aboutSections:ModulesSection.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </aboutSections:ModulesSection.RenderTransform>
                        <aboutSections:ModulesSection.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </aboutSections:ModulesSection.Style>
                    </aboutSections:ModulesSection>

                    <aboutSections:DeveloperSection x:Name="DeveloperSectionHost"
                                                    RenderTransformOrigin="0.5,0.5">
                        <aboutSections:DeveloperSection.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </aboutSections:DeveloperSection.RenderTransform>
                        <aboutSections:DeveloperSection.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </aboutSections:DeveloperSection.Style>
                    </aboutSections:DeveloperSection>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
