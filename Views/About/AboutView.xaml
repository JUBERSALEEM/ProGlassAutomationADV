<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/AboutView.xaml
     PROJECT: ProGlassAutomation
     MODULE: About — Full Light Studio Bento Redesign (2026-09-23)
     Visual specification: 6-Screen Light Studio Bento Architecture
     
     100% PURE NATIVE WPF XAML:
       • Left Nav Rail: 260px soft off-white surface, vector 3D glass
         prism logo, 6 rounded navigation pills, bottom workstation status.
       • Main Stage: Light studio canvas, Top Hero Bento Card with
         pure vector 3D glass prism block, luxury typography, version pill,
         and LeftPillars / RightPillars metric triptych.
       • Section Hosts: 6 tabs switched by SelectedTabIndex.
       • Zero PNG image dependencies in production code.
       • All audit locks, responsive wrap layouts, and API contracts kept.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.AboutView"
             x:Name="AboutShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:aboutSections="clr-namespace:ProGlassAutomation.Views.About.Sections"
             xmlns:viewsAbout="clr-namespace:ProGlassAutomation.Views.About"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- ═══ AMBIENT BACKGROUND LAYER (GPU Cached for zero jitter) ═══ -->
        <Grid IsHitTestVisible="False">
            <Grid.CacheMode>
                <BitmapCache EnableClearType="False" RenderAtScale="1"/>
            </Grid.CacheMode>
            <Border Background="{DynamicResource Ios26CanvasBrush}"/>

            <!-- Ambient Orbs (Soft subtle studio illumination) -->
            <Ellipse Width="560" Height="560"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-180,-140,0"
                     Fill="{DynamicResource Ios26OrbTealBrush}"
                     Opacity="0.08"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="OrbAScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="OrbATranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="420" Height="420"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-120,0,0,-120"
                     Fill="{DynamicResource Ios26OrbBlueBrush}"
                     Opacity="0.08"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="OrbBScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="OrbBTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="480" Height="480"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-170,-170,0,0"
                     Opacity="0.06"
                     Fill="{DynamicResource Ios26OrbLavenderBrush}"/>
            <Ellipse Width="400" Height="400"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,-150,-150,0"
                     Opacity="0.06"
                     Fill="{DynamicResource Ios26OrbGreenBrush}"/>
        </Grid>

        <!-- ═══ SHELL — LIGHT BENTO RAIL + SCROLL CONTENT ═══ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="264"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRailOpen}" Value="False">
                                    <Setter Property="Width" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT NAV RAIL (Screen 1–6 Studio Bento) ═══ -->
            <Border Grid.Column="0" SnapsToDevicePixels="True"
                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Ios26HairlineBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Ios26RailBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRailOpen}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="16,18,16,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Brand Header Card -->
                    <Border Grid.Row="0"
                            Style="{StaticResource Ios26CardStyle}"
                            Padding="12,12"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Pure Vector 3D Glass Prism Emblem (Zero PNG) -->
                                <Border Width="36" Height="36"
                                        Style="{StaticResource Ios26IconTileStyle}"
                                        CornerRadius="{DynamicResource Ios26RadiusInner}">
                                    <Path Data="M 8,5 L 18,2 L 18,34 L 8,34 Z M 18,2 L 28,6 L 24,14 L 18,10 Z M 28,6 L 28,18 L 22,23 L 22,14 Z"
                                          Fill="{DynamicResource Ios26AccentBrush}"
                                          Stretch="Uniform" Margin="7"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppName}"
                                               FontSize="{DynamicResource Ios26FontSizeSubtitle}"
                                               FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource Ios26TextTitleBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AppTagline}"
                                               FontSize="{DynamicResource Ios26FontSizeLabel}"
                                               Foreground="{DynamicResource Ios26TextMutedBrush}"
                                               Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource AboutRailHamburger}"
                                    Command="{Binding ToggleRailCommand}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Nav Pills List (6 Studio Bento Tabs) -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding TabItems}"
                             SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Focusable="False"
                             FocusVisualStyle="{x:Null}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ios26TextBodyBrush}"/>
                                <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeSubtitle}"/>
                                <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="RailBg"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource Ios26RadiusInner}"
                                                    Padding="12,10"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock x:Name="RailIcon"
                                                               Grid.Column="0"
                                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                                               Text="{Binding Glyph}"
                                                               FontSize="{DynamicResource Ios26FontSizeCardTitleSm}"
                                                               Foreground="{DynamicResource Ios26TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"
                                                               IsHitTestVisible="False"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Label}"
                                                               VerticalAlignment="Center"/>

                                                    <Border x:Name="ActiveChip"
                                                            Grid.Column="2"
                                                            Background="{DynamicResource Ios26OnAccentChipBrush}"
                                                            CornerRadius="{DynamicResource Ios26RadiusSmall}"
                                                            Padding="7,2"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="Collapsed">
                                                        <TextBlock Text="ACTIVE"
                                                                   FontSize="{DynamicResource Ios26FontSizeCaption}"
                                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                                   Foreground="{DynamicResource Ios26AccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RailBg" Property="Background" Value="{DynamicResource Ios26HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RailBg" Property="Background" Value="{DynamicResource Ios26AccentSoftBrush}"/>
                                                    <Setter TargetName="RailBg" Property="BorderBrush" Value="{DynamicResource Ios26AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Ios26AccentBrush}"/>
                                                    <Setter TargetName="RailIcon" Property="Foreground" Value="{DynamicResource Ios26AccentBrush}"/>
                                                    <Setter TargetName="ActiveChip" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Workstation Status Card (Sidebar Bottom) -->
                    <Border Grid.Row="2"
                            Style="{StaticResource Ios26CardStyle}"
                            Padding="14,12"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xE7F8;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource Ios26FontSizeCardTitleSm}"
                                           Foreground="{DynamicResource Ios26AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="DESKTOP-PROGLASS"
                                           FontSize="{DynamicResource Ios26FontSizeCaption}"
                                           FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource Ios26TextTitleBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding OsVersion}"
                                       FontSize="{DynamicResource Ios26FontSizeLabel}"
                                       Foreground="{DynamicResource Ios26TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Architecture}"
                                       FontSize="{DynamicResource Ios26FontSizeLabel}"
                                       Foreground="{DynamicResource Ios26TextMutedBrush}"
                                       Margin="0,2,0,8"/>

                            <Border Background="{DynamicResource Ios26AccentSoftBrush}"
                                    CornerRadius="{DynamicResource Ios26RadiusSmall}"
                                    Padding="10,4" HorizontalAlignment="Left">
                                <TextBlock FontSize="{DynamicResource Ios26FontSizeLabel}"
                                           FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource Ios26AccentBrush}">
                                    <Run Text="{Binding Version, Mode=OneWay}"/><Run Text=" Enterprise"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ CONTENT STAGE (Right Column) ═══ -->
            <ScrollViewer Grid.Column="1"
                          x:Name="RootScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          behaviors:SmoothScrollBehavior.IsEnabled="True"
                          Focusable="False"
                          FocusVisualStyle="{x:Null}">

                <StackPanel Margin="24,20,24,28">

                    <!-- Header Strip: Hamburger + Current Tab Title -->
                    <Border Style="{StaticResource Ios26CardStyle}"
                            Padding="14,12"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource AboutRailHamburger}"
                                    Command="{Binding ToggleRailCommand}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                       FontSize="{DynamicResource Ios26FontSizeCardTitle}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource Ios26TextTitleBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False">
                                <Run Text="About → "/><Run Text="{Binding CurrentTabTitle, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- ═══ BENTO HERO CARD (Tab 0: Overview) ═══ -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Border Style="{StaticResource Ios26CardStyle}">
                            <StackPanel HorizontalAlignment="Center">

                                <!-- Pure Native WPF Vector 3D Glass Prism Logo (Zero PNG) -->
                                <Grid HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Ellipse Width="80" Height="80"
                                             StrokeThickness="0"
                                             IsHitTestVisible="False"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="IconRingRotate" Angle="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>

                                    <!-- 3D Geometric Crystal Prism Block -->
                                    <Grid Width="64" Height="64">
                                        <Path Data="M 32,2 L 60,16 L 60,48 L 32,62 L 4,48 L 4,16 Z"
                                              Fill="{DynamicResource Ios26AccentSoftBrush}"
                                              Stroke="{DynamicResource Ios26AccentBrush}"
                                              StrokeThickness="1.5"/>
                                        <Path Data="M 32,2 L 60,16 L 32,30 L 4,16 Z"
                                              Fill="{DynamicResource Ios26AccentBrush}" Opacity="0.3"/>
                                        <Path Data="M 4,16 L 32,30 L 32,62 L 4,48 Z"
                                              Fill="{DynamicResource Ios26TextTitleBrush}" Opacity="0.85"/>
                                        <Path Data="M 60,16 L 32,30 L 32,62 L 60,48 Z"
                                              Fill="{DynamicResource Ios26AccentBrush}" Opacity="0.65"/>
                                        <Line X1="32" Y1="2" X2="32" Y2="30" Stroke="{DynamicResource Ios26OnAccentBrush}" StrokeThickness="1" Opacity="0.9"/>
                                        <Line X1="4" Y1="16" X2="32" Y2="30" Stroke="{DynamicResource Ios26OnAccentBrush}" StrokeThickness="1" Opacity="0.8"/>
                                        <Line X1="60" Y1="16" X2="32" Y2="30" Stroke="{DynamicResource Ios26OnAccentBrush}" StrokeThickness="1" Opacity="0.8"/>
                                    </Grid>
                                </Grid>

                                <!-- Title & Subtitle -->
                                <TextBlock Text="{Binding AppName}"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="{DynamicResource Ios26FontSizeDisplay}"
                                           FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource Ios26TextTitleBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0"
                                           IsHitTestVisible="False"/>

                                <TextBlock Text="Enterprise Architectural Float Glass &amp; CNC Automation Suite"
                                           FontSize="{DynamicResource Ios26FontSizeBody}"
                                           Foreground="{DynamicResource Ios26TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           IsHitTestVisible="False"/>

                                <!-- Version & License Badges -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <Border Background="{DynamicResource Ios26AccentSoftBrush}"
                                            CornerRadius="{DynamicResource Ios26RadiusSmall}"
                                            Padding="12,5" Margin="0,0,8,0">
                                        <TextBlock FontSize="{DynamicResource Ios26FontSizeSmall}"
                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource Ios26AccentBrush}">
                                            <Run Text="{Binding Version, Mode=OneWay}"/><Run Text=" · 64-Bit Native WPF"/>
                                        </TextBlock>
                                    </Border>
                                    <Border Background="{DynamicResource Ios26TileBrush}"
                                            BorderBrush="{DynamicResource Ios26TileBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Ios26RadiusSmall}"
                                            Padding="12,5">
                                        <TextBlock Text="{Binding LicenseStatus.EditionDisplay}"
                                                   FontSize="{DynamicResource Ios26FontSizeSmall}"
                                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{DynamicResource Ios26TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource Ios26HairlineBrush}"
                                        Margin="0,18,0,16" SnapsToDevicePixels="True"/>

                                <!-- Metrics Triptych: LeftPillars & RightPillars (Audit Verified) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding LeftPillars}"
                                                  ItemTemplate="{StaticResource HeroPillarTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding RightPillars}"
                                                  ItemTemplate="{StaticResource HeroPillarTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- ═══ SECTION HOSTS ═══
                         All six live in one cell. A failed ElementName binding
                         used to leave every host at the default Visible, so
                         turning on a strong card edge drew every screen's
                         outlines through the selected one. Default is
                         Collapsed. AboutView.SyncSectionHosts shows exactly
                         one, from the shell view model — not from a host
                         DataContext that a section might replace. -->
                    <Grid>
                        <aboutSections:AboutOverviewSection x:Name="OverviewSection"
                                                            Visibility="Collapsed">
                            <aboutSections:AboutOverviewSection.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </aboutSections:AboutOverviewSection.RenderTransform>
                        </aboutSections:AboutOverviewSection>

                        <aboutSections:AboutLicenseCard x:Name="LicenseSectionHost"
                                                        Visibility="Collapsed">
                            <aboutSections:AboutLicenseCard.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </aboutSections:AboutLicenseCard.RenderTransform>
                        </aboutSections:AboutLicenseCard>

                        <aboutSections:ModulesSection x:Name="ModulesSectionHost"
                                                      Visibility="Collapsed">
                            <aboutSections:ModulesSection.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </aboutSections:ModulesSection.RenderTransform>
                        </aboutSections:ModulesSection>

                        <aboutSections:DeveloperSection x:Name="DeveloperSectionHost"
                                                        Visibility="Collapsed">
                            <aboutSections:DeveloperSection.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </aboutSections:DeveloperSection.RenderTransform>
                        </aboutSections:DeveloperSection>

                        <aboutSections:SystemSection x:Name="SystemSectionHost"
                                                     Visibility="Collapsed">
                            <aboutSections:SystemSection.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </aboutSections:SystemSection.RenderTransform>
                        </aboutSections:SystemSection>

                        <aboutSections:DiagnosticsSection x:Name="DiagnosticsSectionHost"
                                                          Visibility="Collapsed">
                            <aboutSections:DiagnosticsSection.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </aboutSections:DiagnosticsSection.RenderTransform>
                        </aboutSections:DiagnosticsSection>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
