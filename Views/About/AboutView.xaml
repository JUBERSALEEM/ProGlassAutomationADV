<UserControl x:Class="ProGlassAutomation.Views.About.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="24,20"/>
            <Setter Property="Margin"          Value="0,0,0,20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4338CA"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,20"/>
        </Style>

        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="14"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="WorkflowNodeStyle" TargetType="Border">
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="MinWidth"        Value="120"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModuleChipStyle" TargetType="Border">
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="16,14"/>
            <Setter Property="Margin"          Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style x:Key="StatTileStyle" TargetType="Border">
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="16,14"/>
            <Setter Property="Margin"          Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <ScrollViewer x:Name="RootScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      IsDeferredScrollingEnabled="False"
                      PanningMode="None"
                      Focusable="True"
                      FocusVisualStyle="{x:Null}"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="40,40,40,40">

                <!-- ═══════════════════════════════════════════════════════
                     HERO HEADER
                ═══════════════════════════════════════════════════════ -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">

                    <Border Width="130" Height="130"
                            CornerRadius="24"
                            HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4338CA" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.CacheMode>
                            <BitmapCache RenderAtScale="1" EnableClearType="False"/>
                        </Border.CacheMode>
                        <TextBlock Text="PG"
                                   Foreground="White"
                                   FontSize="54"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{Binding AppName}"
                               FontSize="42"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                    <TextBlock Text="{Binding AppTagline}"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,0">
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="14"
                                Padding="16,8"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding Version}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <Border Background="#EEF2FF"
                                BorderBrush="#4338CA"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,8">
                            <TextBlock Text="Enterprise Edition"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#4338CA"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════
                     AT-A-GLANCE STATS
                ═══════════════════════════════════════════════════════ -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatTileStyle}"
                            Background="#ECFDF5" BorderBrush="#A7F3D0">
                        <StackPanel>
                            <TextBlock Text="🧩" FontSize="20"/>
                            <TextBlock Text="8" FontSize="28" FontWeight="Bold"
                                       Foreground="#047857" Margin="0,4,0,0"/>
                            <TextBlock Text="MODULES SHIPPED" FontSize="10"
                                       FontWeight="Bold" Foreground="#047857"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StatTileStyle}"
                            Background="#EFF6FF" BorderBrush="#BFDBFE">
                        <StackPanel>
                            <TextBlock Text="💾" FontSize="20"/>
                            <TextBlock Text="5" FontSize="28" FontWeight="Bold"
                                       Foreground="#1E40AF" Margin="0,4,0,0"/>
                            <TextBlock Text="ISOLATED DATABASES" FontSize="10"
                                       FontWeight="Bold" Foreground="#1E40AF"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatTileStyle}"
                            Background="#FFFBEB" BorderBrush="#FDE68A">
                        <StackPanel>
                            <TextBlock Text="📤" FontSize="20"/>
                            <TextBlock Text="3" FontSize="28" FontWeight="Bold"
                                       Foreground="#B45309" Margin="0,4,0,0"/>
                            <TextBlock Text="EXPORT FORMATS" FontSize="10"
                                       FontWeight="Bold" Foreground="#B45309"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource StatTileStyle}"
                            Background="#EEF2FF" BorderBrush="#C7D2FE">
                        <StackPanel>
                            <TextBlock Text="🤖" FontSize="20"/>
                            <TextBlock Text="AI" FontSize="28" FontWeight="Bold"
                                       Foreground="#4338CA" Margin="0,4,0,0"/>
                            <TextBlock Text="GEMINI POWERED" FontSize="10"
                                       FontWeight="Bold" Foreground="#4338CA"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════
                     ABOUT THE APP
                ═══════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="About ProGlass Automation"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Purpose-built ERP for UAE glass manufacturing"
                                   Style="{StaticResource SectionSubtitleStyle}"/>

                        <TextBlock TextWrapping="Wrap"
                                   LineHeight="24"
                                   FontSize="14"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}">
                            <Run Text="ProGlass Automation is a purpose-built Windows desktop application designed specifically for "/>
                            <Run Text="UAE-based glass manufacturing companies" FontWeight="SemiBold"/>
                            <Run Text=". It replaces spreadsheet-driven workflows with a fully integrated system covering raw material inventory, quoting, production planning, delivery tracking, and financial reporting — all in one place."/>
                            <LineBreak/><LineBreak/>
                            <Run Text="The system is engineered around three principles: "/>
                            <Run Text="deterministic calculations" FontWeight="SemiBold"/>
                            <Run Text=" (every formula produces the same result every time), "/>
                            <Run Text="modular isolation" FontWeight="SemiBold"/>
                            <Run Text=" (each business domain has its own database and cannot corrupt another), and "/>
                            <Run Text="AI-safe architecture" FontWeight="SemiBold"/>
                            <Run Text=" (strict conventions ensure the codebase remains extensible for years)."/>
                            <LineBreak/><LineBreak/>
                            <Run Text="All monetary values in AED. UAE 5% VAT built-in with zero-rated export support. Standalone .exe deployment — no cloud dependencies, no subscription fees, no data leaves your machine."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     WORKFLOW DIAGRAM
                ═══════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="End-to-End Production Workflow"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="From raw glass sheets to tax invoice — every stage tracked"
                                   Style="{StaticResource SectionSubtitleStyle}"/>

                        <TextBlock Text="SALES CYCLE"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#4338CA"
                                   Margin="0,4,0,8"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,20">

                            <Border Style="{StaticResource WorkflowNodeStyle}"
                                    Background="#ECFDF5" BorderBrush="#A7F3D0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📦" FontSize="18"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Sheet Store"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#047857"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="→" FontSize="20" VerticalAlignment="Center"
                                       Margin="8,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                            <Border Style="{StaticResource WorkflowNodeStyle}"
                                    Background="#EFF6FF" BorderBrush="#BFDBFE">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📄" FontSize="18"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Proforma Invoice"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#1E40AF"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="→" FontSize="20" VerticalAlignment="Center"
                                       Margin="8,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                            <Border Style="{StaticResource WorkflowNodeStyle}"
                                    Background="#FFFBEB" BorderBrush="#FDE68A">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🏭" FontSize="18"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Job Order"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#B45309"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="PRODUCTION STAGES (upcoming)"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#B45309"
                                   Margin="0,4,0,8"/>
                        <WrapPanel HorizontalAlignment="Center"
                                   Margin="0,0,0,20">

                            <Border Style="{StaticResource WorkflowNodeStyle}"
                                    Background="{DynamicResource MenuHoverBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Margin="4">
                                <TextBlock Text="Cutting" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </Border>
                            <Border Style="{StaticResource WorkflowNodeStyle}"
                                    Background="{DynamicResource MenuHoverBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Margin="4">
                                <TextBlock Text="Holes / Cutouts" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </Border>
                            <Border Style="{StaticResource WorkflowNodeStyle}"
                                    Background="{DynamicResource MenuHoverBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Margin="4">
                                <TextBlock Text="Polish" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </Border>
                            <Border Style="{StaticResource WorkflowNodeStyle}"
                                    Background="{DynamicResource MenuHoverBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Margin="4">
                                <TextBlock Text="Edge Deletion" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </Border>
                            <Border Style="{StaticResource WorkflowNodeStyle}"
                                    Background="{DynamicResource MenuHoverBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Margin="4">
                                <TextBlock Text="Mitring" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </Border>
                            <Border Style="{StaticResource WorkflowNodeStyle}"
                                    Background="{DynamicResource MenuHoverBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Margin="4">
                                <TextBlock Text="Tempering" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </Border>
                            <Border Style="{StaticResource WorkflowNodeStyle}"
                                    Background="{DynamicResource MenuHoverBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Margin="4">
                                <TextBlock Text="Pairing" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </Border>
                            <Border Style="{StaticResource WorkflowNodeStyle}"
                                    Background="{DynamicResource MenuHoverBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Margin="4">
                                <TextBlock Text="Doubling / DGU" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="DISPATCH &amp; BILLING"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#4338CA"
                                   Margin="0,4,0,8"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Border Style="{StaticResource WorkflowNodeStyle}"
                                    Background="#FFFBEB" BorderBrush="#FDE68A">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🚚" FontSize="18"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Delivery Note"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#B45309"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="→" FontSize="20" VerticalAlignment="Center"
                                       Margin="8,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                            <Border Style="{StaticResource WorkflowNodeStyle}"
                                    Background="#FEF2F2" BorderBrush="#FECACA">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🧾" FontSize="18"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Tax Invoice"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#B91C1C"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="→" FontSize="20" VerticalAlignment="Center"
                                       Margin="8,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                            <Border Style="{StaticResource WorkflowNodeStyle}"
                                    Background="#ECFDF5" BorderBrush="#A7F3D0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="18"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Sales Report"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#047857"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     ACTIVE MODULES
                ═══════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Active Modules"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Fully functional and battle-tested — ready for daily use"
                                   Style="{StaticResource SectionSubtitleStyle}"/>

                        <UniformGrid Rows="4" Columns="2">

                            <Border Style="{StaticResource ModuleChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="22" VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Sheet Store"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="Raw glass inventory · SQM pricing · Buy/Use tracking"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModuleChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" FontSize="22" VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Proforma Invoice"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="7-step wizard · SGU/DGU/LAM · Excel-like paste"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModuleChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏭" FontSize="22" VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Job Order"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="Convert PI · Priority · Status tracking · Factory sheet"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModuleChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚚" FontSize="22" VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Delivery Note"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="Partial deliveries · Sibling chain · Photo proof"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModuleChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="22" VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Multi-page Dashboard"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="Real-time KPIs · Activity feed · Cross-module stats"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModuleChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📤" FontSize="22" VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Shared Export Engine"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="PDF (QuestPDF) · Excel (ClosedXML) · CSV · Print"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModuleChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🤖" FontSize="22" VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="AI Assistant"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="Gemini-powered · Glass industry expertise · Chat"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModuleChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎨" FontSize="22" VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Light + Dark Themes"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="Instant swap · 25 brushes · Design system foundation"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     TECHNOLOGY STACK
                ═══════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Technology Stack"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Built on battle-tested Microsoft + open-source technology"
                                   Style="{StaticResource SectionSubtitleStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,20,20">
                                <TextBlock Text="PLATFORM" Style="{StaticResource InfoLabelStyle}"/>
                                <TextBlock Text=".NET 8 · WPF" Style="{StaticResource InfoValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,20,20">
                                <TextBlock Text="DATABASE" Style="{StaticResource InfoLabelStyle}"/>
                                <TextBlock Text="SQLite · EF Core 8" Style="{StaticResource InfoValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,20,20">
                                <TextBlock Text="PATTERN" Style="{StaticResource InfoLabelStyle}"/>
                                <TextBlock Text="MVVM Strict" Style="{StaticResource InfoValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="LANGUAGE" Style="{StaticResource InfoLabelStyle}"/>
                                <TextBlock Text="C# 9+" Style="{StaticResource InfoValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,20,0">
                                <TextBlock Text="PDF ENGINE" Style="{StaticResource InfoLabelStyle}"/>
                                <TextBlock Text="QuestPDF 2024.12" Style="{StaticResource InfoValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,20,0">
                                <TextBlock Text="EXCEL ENGINE" Style="{StaticResource InfoLabelStyle}"/>
                                <TextBlock Text="ClosedXML 0.105" Style="{StaticResource InfoValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,20,0">
                                <TextBlock Text="CSV ENGINE" Style="{StaticResource InfoLabelStyle}"/>
                                <TextBlock Text="CsvHelper 33.1" Style="{StaticResource InfoValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Grid.Row="1">
                                <TextBlock Text="AI PROVIDER" Style="{StaticResource InfoLabelStyle}"/>
                                <TextBlock Text="Google Gemini" Style="{StaticResource InfoValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     KEY CAPABILITIES
                ═══════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Key Capabilities"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="What sets ProGlass Automation apart"
                                   Style="{StaticResource SectionSubtitleStyle}"/>

                        <UniformGrid Rows="3" Columns="2">
                            <StackPanel Orientation="Horizontal" Margin="0,8,20,12">
                                <TextBlock Text="✅" FontSize="18" VerticalAlignment="Top"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Deterministic Calculations"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="Every formula produces the same result every time. No hidden state."
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,20,12">
                                <TextBlock Text="✅" FontSize="18" VerticalAlignment="Top"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Excel-Like Data Entry"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="Paste 150+ rows from Excel · Tab/Enter navigation · Auto-numbering"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,20,12">
                                <TextBlock Text="✅" FontSize="18" VerticalAlignment="Top"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Sibling Delivery Chain"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="Track partial deliveries · Auto-create Dummy DNs for balance qty"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,20,12">
                                <TextBlock Text="✅" FontSize="18" VerticalAlignment="Top"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Photo Proof of Delivery"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="Attach signed copies + site photos to every delivery note"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,20,12">
                                <TextBlock Text="✅" FontSize="18" VerticalAlignment="Top"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Instant Theme Swap"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="Light + Dark modes with 25-brush palette — swap without reload"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,20,12">
                                <TextBlock Text="✅" FontSize="18" VerticalAlignment="Top"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Auto Backup on Exit"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="Keeps last 7 database copies · Never lose a day of work"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     DEVELOPER INFO
                ═══════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Developer Information"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Built and maintained by a single dedicated engineer"
                                   Style="{StaticResource SectionSubtitleStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="72" Height="72"
                                    CornerRadius="36"
                                    Margin="0,0,20,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4338CA" Offset="0"/>
                                        <GradientStop Color="#6366F1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.CacheMode>
                                    <BitmapCache RenderAtScale="1" EnableClearType="False"/>
                                </Border.CacheMode>
                                <TextBlock Text="JS"
                                           Foreground="White"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="DEVELOPER"
                                               Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Text="{Binding DeveloperName}"
                                               Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                    <TextBlock Text="COUNTRY"
                                               Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Text="{Binding Country}"
                                               Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="EMAIL"
                                               Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Style="{StaticResource InfoValueStyle}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Cursor="Hand"
                                               TextDecorations="Underline"
                                               MouseLeftButtonDown="Email_MouseLeftButtonDown"
                                               Text="{Binding Email}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     FOOTER
                ═══════════════════════════════════════════════════════ -->
                <StackPanel HorizontalAlignment="Center" Margin="0,10,0,20">
                    <TextBlock Text="Made with ❤ in India · For UAE glass manufacturers"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <TextBlock Text="{Binding Copyright}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>