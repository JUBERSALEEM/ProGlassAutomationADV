<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/AboutView.xaml
     PROJECT: ProGlassAutomation
     MODULE: About — iOS-26 Liquid Glass shell (2026-09-15 full
     restyle, approved mockups 01–06)

     Self-contained look (owner directive: "I want exactly liquid
     glass style ... ignore the current theme"): fixed pastel canvas
     + frosted rail + frosted 26 px cards, all from the Ios26*
     palette in AboutIos26Theme.xaml — NOT the live app theme.

     PRESERVED (crash-safety + audit contracts):
       • NO inline Storyboards (ERR-D71810 — optimised template load);
         all motion is driven imperatively from AboutView.xaml.cs.
       • Named transforms OrbAScale/OrbATranslate/OrbBScale/
         OrbBTranslate + IconRingRotate (ambient motion targets).
       • RootScrollViewer x:Name + SmoothScrollBehavior.
       • Section hosts OverviewSection / LicenseSectionHost /
         ModulesSectionHost / DeveloperSectionHost /
         SystemSectionHost / DiagnosticsSectionHost (unnamed
         RenderTransforms — MC3093 sealed NameScope rule).
       • Hero bindings ItemsSource LeftPillars / RightPillars and
         Text="{Binding LicenseStatus.EditionDisplay}" (audit lock).
       • Rail glyph DataTriggers for all six tabs.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:aboutSections="clr-namespace:ProGlassAutomation.Views.About.Sections"
             xmlns:viewsAbout="clr-namespace:ProGlassAutomation.Views.About"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ═══ ROOT — fixed iOS-26 pastel stage (2026-09-15) ═══
         The stage is now OPAQUE: the mockups show the About page as a
         self-contained liquid-glass surface, independent of the app
         theme / wallpaper. Two orbs are named so the code-behind can
         keep animating them (imperative, Freezable-safe); the other
         two are static fillers for the mesh. -->
    <Grid>
        <Border Background="{DynamicResource Ios26CanvasBrush}"
                IsHitTestVisible="False"/>

        <Ellipse Width="560" Height="560"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-180,-140,0" IsHitTestVisible="False"
                 Fill="{DynamicResource Ios26OrbTealBrush}"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="OrbAScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="OrbATranslate" X="0" Y="0"/>
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="420" Height="420"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-120,0,0,-120" IsHitTestVisible="False"
                 Fill="{DynamicResource Ios26OrbBlueBrush}"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="OrbBScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="OrbBTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="480" Height="480"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-170,-170,0,0" IsHitTestVisible="False"
                 Fill="{DynamicResource Ios26OrbLavenderBrush}"/>
        <Ellipse Width="400" Height="400"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,-150,-150,0" IsHitTestVisible="False"
                 Fill="{DynamicResource Ios26OrbGreenBrush}"/>

        <!-- ═══ SHELL — frosted left rail (fixed) + scroll content ═══ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT NAV RAIL (mockup 01) ═══
                 Frosted panel + brand block + six nav pills.
                 Active item = deep-blue pill + white text + ACTIVE
                 chip. Simple triggers only — no Storyboard. -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Ios26RailBrush}"
                    BorderBrush="{DynamicResource Ios26HairlineBrush}"
                    BorderThickness="0,0,1,0"
                    SnapsToDevicePixels="True">
                <DockPanel Margin="16,18,16,18">
                    <!-- Brand -->
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="6,0,0,20">
                        <Border Width="40" Height="40"
                                Style="{StaticResource Ios26IconTileStyle}"
                                CornerRadius="{DynamicResource Ios26RadiusInner}">
                            <Border.Background>
                                <ImageBrush ImageSource="{x:Static viewsAbout:AppIconResource.Icon}"
                                            Stretch="UniformToFill"
                                            RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border.Background>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppName}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Ios26TextTitleBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding AppTagline}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Ios26TextMutedBrush}"
                                       Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Nav list (Overview / License / Modules /
                         Developer / System / Diagnostics) -->
                    <ListBox ItemsSource="{Binding Tabs}"
                             SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Focusable="False"
                             FocusVisualStyle="{x:Null}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ios26TextBodyBrush}"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="RailBg"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource Ios26RadiusInner}"
                                                    Padding="13,10"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="RailIcon"
                                                               Grid.Column="0"
                                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                                               Text="&#xE80F;"
                                                               FontSize="16"
                                                               Foreground="{DynamicResource Ios26TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,1,12,0"
                                                               IsHitTestVisible="False"/>
                                                    <ContentPresenter Grid.Column="1"
                                                                      VerticalAlignment="Center"/>
                                                    <!-- "ACTIVE" chip —
                                                         visible on the
                                                         selected pill
                                                         only (mockup). -->
                                                    <Border x:Name="ActiveChip"
                                                            Grid.Column="2"
                                                            Background="{DynamicResource Ios26OnAccentChipBrush}"
                                                            CornerRadius="{DynamicResource Ios26RadiusPill}"
                                                            Padding="8,2"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="Collapsed">
                                                        <TextBlock Text="ACTIVE"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource Ios26OnAccentBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Default glyph E80F (home)
                                                     = Overview; the other
                                                     labels swap it. -->
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}" Value="License">
                                                    <Setter TargetName="RailIcon" Property="Text" Value="&#xE72E;"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}" Value="Modules">
                                                    <Setter TargetName="RailIcon" Property="Text" Value="&#xE80A;"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}" Value="Developer">
                                                    <Setter TargetName="RailIcon" Property="Text" Value="&#xE90A;"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}" Value="System">
                                                    <Setter TargetName="RailIcon" Property="Text" Value="&#xE713;"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}" Value="Diagnostics">
                                                    <Setter TargetName="RailIcon" Property="Text" Value="&#xE9A9;"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RailBg" Property="Background" Value="{DynamicResource Ios26HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RailBg" Property="Background" Value="{DynamicResource Ios26AccentBrush}"/>
                                                    <Setter TargetName="RailBg" Property="BorderBrush" Value="{DynamicResource Ios26AccentBrush}"/>
                                                    <Setter TargetName="RailIcon" Property="Foreground" Value="{DynamicResource Ios26OnAccentBrush}"/>
                                                    <Setter TargetName="ActiveChip" Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Ios26OnAccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ═══ CONTENT COLUMN (scrolls; rail stays fixed) ═══ -->
            <ScrollViewer x:Name="RootScrollViewer"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          Focusable="False"
                          FocusVisualStyle="{x:Null}"
                          Background="Transparent"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <StackPanel Margin="32,26,32,32">

                    <!-- Page title — "About → {active tab}" (mockups). -->
                    <TextBlock FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Ios26TextTitleBrush}"
                               Margin="0,0,0,16"
                               IsHitTestVisible="False">
                        <Run Text="About → "/><Run Text="{Binding CurrentTabTitle}"/>
                    </TextBlock>

                    <!-- ═══ HERO — brand card, Overview tab only
                         (mockup 01: centered icon + title + tagline +
                         hairline + centered stat row). Wrapper Border
                         owns the visibility trigger (setters only —
                         Freezable-safe, ERR-D71810). -->
                    <Border Margin="0,0,0,18">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border Style="{StaticResource Ios26CardStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Brand tile (orbit ring kept but
                                     invisible — its name feeds the
                                     code-behind ambient motion). -->
                                <Grid HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Ellipse Width="80" Height="80"
                                             StrokeThickness="0"
                                             IsHitTestVisible="False"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="IconRingRotate" Angle="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Border Width="64" Height="64"
                                            Style="{StaticResource Ios26IconTileStyle}"
                                            CornerRadius="{DynamicResource Ios26RadiusInner}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Static viewsAbout:AppIconResource.Icon}"
                                                        Stretch="UniformToFill"
                                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding AppName}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Ios26TextTitleBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,14,0,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="{Binding AppTagline}"
                                           FontSize="14.5"
                                           Foreground="{DynamicResource Ios26TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           IsHitTestVisible="False"/>

                                <!-- Hairline -->
                                <Border Height="1"
                                        Background="{DynamicResource Ios26HairlineBrush}"
                                        Margin="32,18,32,0"/>

                                <!-- Centered stat row: Version · Build ·
                                     Edition (the edition value binds the
                                     shared license surface — audit). -->
                                <WrapPanel HorizontalAlignment="Center"
                                           Margin="0,16,0,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,10">
                                        <Border Width="26" Height="26"
                                                Style="{StaticResource Ios26IconTileStyle}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE946;"
                                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Ios26AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource About.Version}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource Ios26TextMutedBrush}"/>
                                            <TextBlock Text="{Binding Version}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,10">
                                        <Border Width="26" Height="26"
                                                Style="{StaticResource Ios26IconTileStyle}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE713;"
                                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Ios26AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource About.Build}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource Ios26TextMutedBrush}"/>
                                            <TextBlock Text="{Binding Build}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                        <Border Width="26" Height="26"
                                                Style="{StaticResource Ios26IconTileStyle}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7F4;"
                                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Ios26AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource About.Edition}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource Ios26TextMutedBrush}"/>
                                            <TextBlock Text="{Binding LicenseStatus.EditionDisplay}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                        <Border Width="26" Height="26"
                                                Style="{StaticResource Ios26IconTileStyle}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE73E;"
                                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Ios26SuccessBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Common.Status}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource Ios26TextMutedBrush}"/>
                                            <TextBlock Text="{Binding LicenseStatus.StatusBadge}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Ios26TextTitleBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Hero pillar chips — the live Left/Right pillar
                         metrics (audit bindings), centered between the
                         hero and the first card row (mockup chip
                         language). Overview tab only. -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <WrapPanel HorizontalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding LeftPillars}"
                                          ItemTemplate="{StaticResource HeroPillarTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding RightPillars}"
                                          ItemTemplate="{StaticResource HeroPillarTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </WrapPanel>
                    </StackPanel>

                    <!-- ═══ SECTION CONTENT (switched by SelectedTabIndex) ═══
                         Show/hide = plain DataTrigger Setters (Freezable-safe,
                         ERR-D71810); the gentle fade+slide reveal is driven
                         imperatively from AboutView.xaml.cs (IsVisibleChanged).
                         Transforms are NOT named — MC3093 sealed NameScope. -->
                    <Grid>
                        <aboutSections:AboutOverviewSection x:Name="OverviewSection"
                                                            RenderTransformOrigin="0.5,0.5">
                            <aboutSections:AboutOverviewSection.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </aboutSections:AboutOverviewSection.RenderTransform>
                            <aboutSections:AboutOverviewSection.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </aboutSections:AboutOverviewSection.Style>
                        </aboutSections:AboutOverviewSection>

                        <!-- License (index 1). The card's constructor
                             points its DataContext at
                             LicenseStatusViewModel.Instance — no extra
                             wiring. -->
                        <aboutSections:AboutLicenseCard x:Name="LicenseSectionHost"
                                                        RenderTransformOrigin="0.5,0.5">
                            <aboutSections:AboutLicenseCard.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </aboutSections:AboutLicenseCard.RenderTransform>
                            <aboutSections:AboutLicenseCard.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </aboutSections:AboutLicenseCard.Style>
                        </aboutSections:AboutLicenseCard>

                        <aboutSections:ModulesSection x:Name="ModulesSectionHost"
                                                      RenderTransformOrigin="0.5,0.5">
                            <aboutSections:ModulesSection.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </aboutSections:ModulesSection.RenderTransform>
                            <aboutSections:ModulesSection.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </aboutSections:ModulesSection.Style>
                        </aboutSections:ModulesSection>

                        <aboutSections:DeveloperSection x:Name="DeveloperSectionHost"
                                                        RenderTransformOrigin="0.5,0.5">
                            <aboutSections:DeveloperSection.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </aboutSections:DeveloperSection.RenderTransform>
                            <aboutSections:DeveloperSection.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </aboutSections:DeveloperSection.Style>
                        </aboutSections:DeveloperSection>

                        <!-- System (index 4) — live machine / runtime /
                             theme / perf / encoder / storage data. -->
                        <aboutSections:SystemSection x:Name="SystemSectionHost"
                                                     RenderTransformOrigin="0.5,0.5">
                            <aboutSections:SystemSection.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </aboutSections:SystemSection.RenderTransform>
                            <aboutSections:SystemSection.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </aboutSections:SystemSection.Style>
                        </aboutSections:SystemSection>

                        <!-- Diagnostics (index 5) — crash reports +
                             recording health + app log. -->
                        <aboutSections:DiagnosticsSection x:Name="DiagnosticsSectionHost"
                                                          RenderTransformOrigin="0.5,0.5">
                            <aboutSections:DiagnosticsSection.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </aboutSections:DiagnosticsSection.RenderTransform>
                            <aboutSections:DiagnosticsSection.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </aboutSections:DiagnosticsSection.Style>
                        </aboutSections:DiagnosticsSection>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
