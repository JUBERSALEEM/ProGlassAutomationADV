<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/AboutView.xaml
     PROJECT: ProGlassAutomation
     MODULE: About — v4 professional redesign

     Full redesign: theme-adaptive hero with the real application icon,
     developer identity card, and every section restyled on the shared
     theme brushes (works in Light, Dark, Monet and Professional).

     PRESERVED:
       • AboutViewModel bindings (AppName, AppTagline, Version, Build,
         DeveloperName, Country, Email, Copyright, PrivacyLines,
         LeftPillars, RightPillars, SalesCycle, ProductionStages,
         DispatchBilling, Modules, TechStack, CapabilitiesTop/Bottom)
       • Email_MouseLeftButtonDown handler on the email pill
       • RootScrollViewer x:Name + SmoothScrollBehavior
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══ SHARED CARD / TYPOGRAPHY (theme-adaptive) ═══ -->
        <Style x:Key="AboutCardStyle" TargetType="Border">
            <Setter Property="Background"          Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"         Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness"     Value="1.5"/>
            <Setter Property="CornerRadius"        Value="{DynamicResource CardCornerRadiusLarge}"/>
            <Setter Property="Padding"             Value="30,26"/>
            <Setter Property="Margin"              Value="0,0,0,20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
        </Style>

        <!-- The accent border is INTENTIONAL and must stay. It is what makes
             the hero read as a rounded, framed card instead of loose text on
             the page. AccentBrush is theme-aware (#1D4ED8 light / #3B82F6
             dark) and is re-written by ThemeManager for the selected accent
             preset, so this frame follows the theme rather than fighting it.
             A previous edit swapped this for the neutral OutlineBrush and
             flattened the card - do not repeat that. -->
        <Style x:Key="HeroCardStyle" TargetType="Border"
               BasedOn="{StaticResource AboutCardStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadiusLarge}"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="19"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin"            Value="0,0,0,4"/>
            <Setter Property="IsHitTestVisible"  Value="False"/>
        </Style>

        <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Foreground"        Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin"            Value="0,0,0,18"/>
            <Setter Property="IsHitTestVisible"  Value="False"/>
        </Style>

        <Style x:Key="SubHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin"            Value="0,16,0,8"/>
            <Setter Property="IsHitTestVisible"  Value="False"/>
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping"      Value="Wrap"/>
            <Setter Property="LineHeight"        Value="24"/>
            <Setter Property="FontSize"          Value="13.5"/>
            <Setter Property="Foreground"        Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="IsHitTestVisible"  Value="False"/>
        </Style>

        <Style x:Key="WorkflowGroupLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin"            Value="0,0,0,8"/>
            <Setter Property="IsHitTestVisible"  Value="False"/>
        </Style>

        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="9"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="IsHitTestVisible"  Value="False"/>
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="IsHitTestVisible"  Value="False"/>
        </Style>

        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="Background"        Value="{DynamicResource TintIndigoBrush}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="CornerRadius"      Value="14"/>
            <Setter Property="Padding"           Value="16,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="IconTileStyle" TargetType="Border">
            <Setter Property="Background"        Value="{DynamicResource TintIndigoBrush}"/>
            <Setter Property="CornerRadius"      Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="GlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily"        Value="Segoe MDL2 Assets"/>
            <Setter Property="Foreground"        Value="{DynamicResource AccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible"  Value="False"/>
        </Style>

        <!-- ═══ TEMPLATES ═══ -->

        <!-- HERO PILLAR -->
        <DataTemplate x:Key="HeroPillarTemplate">
            <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="14,12" Margin="0,0,0,10"
                    MinWidth="120" BorderThickness="{DynamicResource CardBorderThickness}"
                    Background="{DynamicResource TintIndigoBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    SnapsToDevicePixels="True">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Value}"
                               FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Label}"
                               FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource AccentBrush}"
                               IsHitTestVisible="False"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- MODULE CHIP -->
        <DataTemplate x:Key="ModuleChipTemplate">
            <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,14" Margin="6"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource IconTileStyle}"
                            Width="44" Height="44"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Style="{StaticResource GlyphStyle}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,10,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   IsHitTestVisible="False"/>
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Column="2"
                            Background="{DynamicResource TintIndigoBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,3"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="ACTIVE" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   IsHitTestVisible="False"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- TECH STACK ITEM -->
        <DataTemplate x:Key="TechItemTemplate">
            <Border CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,12" Margin="6"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    Background="{DynamicResource TintIndigoBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               IsHitTestVisible="False"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}"
                                   Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock Text="{Binding Value}"
                                   Style="{StaticResource InfoValueStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- CAPABILITY CARD -->
        <DataTemplate x:Key="CapabilityCardTemplate">
            <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,20" Margin="8"
                    MinWidth="230" MaxWidth="280" BorderThickness="{DynamicResource CardBorderThickness}"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    SnapsToDevicePixels="True">
                <StackPanel HorizontalAlignment="Center">
                    <Border Style="{StaticResource IconTileStyle}"
                            Width="52" Height="52"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Style="{StaticResource GlyphStyle}"/>
                    </Border>
                    <TextBlock Text="{Binding Title}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,12,0,6"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Description}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               IsHitTestVisible="False"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- WORKFLOW STAGE CARD -->
        <DataTemplate x:Key="WorkflowCardTemplate">
            <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,20" Margin="8"
                    MinWidth="200" MaxWidth="240" BorderThickness="{DynamicResource CardBorderThickness}"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    SnapsToDevicePixels="True">
                <StackPanel HorizontalAlignment="Center">
                    <Border Style="{StaticResource IconTileStyle}"
                            Width="48" Height="48"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Style="{StaticResource GlyphStyle}"/>
                    </Border>
                    <TextBlock Text="{Binding Name}"
                               FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,10,0,4"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Description}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               IsHitTestVisible="False"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ═══ ROOT ═══ -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          Focusable="False">

        <ScrollViewer x:Name="RootScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="40,40,40,40">

                <!-- ═══ HERO — app icon + identity ═══ -->
                <Border Style="{StaticResource HeroCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ItemsControl Grid.Column="0"
                                      ItemsSource="{Binding LeftPillars}"
                                      ItemTemplate="{StaticResource HeroPillarTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">

                            <!-- THE APP ICON — big, with halo ring -->
                            <Grid HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Ellipse Width="190" Height="190"
                                         Stroke="{DynamicResource AccentBrush}"
                                         StrokeThickness="1"
                                         Opacity="0.35"
                                         IsHitTestVisible="False"/>
                                <Border Width="150" Height="150"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding AppName}"
                                       FontSize="36" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,22,0,0"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       IsHitTestVisible="False"/>

                            <TextBlock Text="{Binding AppTagline}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextAlignment="Center"
                                       IsHitTestVisible="False"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,18,0,0">
                                <Border Background="{DynamicResource AccentBrush}"
                                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,8"
                                        Margin="0,0,8,0"
                                        SnapsToDevicePixels="True">
                                    <TextBlock Text="{Binding Version}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                                               IsHitTestVisible="False"/>
                                </Border>
                                <Border Style="{StaticResource PillStyle}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Build}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               IsHitTestVisible="False"/>
                                </Border>
                                <Border Style="{StaticResource PillStyle}">
                                    <TextBlock Text="Enterprise Edition"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               IsHitTestVisible="False"/>
                                </Border>
                            </StackPanel>

                            <Border Height="1" Width="240"
                                    Margin="0,26,0,22"
                                    Background="{DynamicResource BorderBrush}"
                                    IsHitTestVisible="False"/>

                            <TextBlock Text="DEVELOPED BY"
                                       FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       IsHitTestVisible="False"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0">
                                <Border Width="52" Height="52"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="14,0,0,0">
                                    <TextBlock Text="{Binding DeveloperName}"
                                               FontSize="17" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="{Binding Country}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               Margin="0,2,0,0"
                                               IsHitTestVisible="False"/>
                                </StackPanel>
                            </StackPanel>

                            <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="18,10"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Center"
                                    Cursor="Hand"
                                    SnapsToDevicePixels="True"
                                    Background="{DynamicResource TintIndigoBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    MouseLeftButtonDown="Email_MouseLeftButtonDown">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE715;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Email}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <ItemsControl Grid.Column="2"
                                      ItemsSource="{Binding RightPillars}"
                                      ItemTemplate="{StaticResource HeroPillarTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                    </Grid>
                </Border>

                <!-- ═══ ABOUT ══ -->
                <Border Style="{StaticResource AboutCardStyle}">
                    <StackPanel>
                        <TextBlock Text="About ProGlass Automation"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Purpose-built ERP for UAE glass manufacturing"
                                   Style="{StaticResource SectionSubtitleStyle}"/>

                        <TextBlock Text="OVERVIEW" Style="{StaticResource SubHeadingStyle}"/>
                        <TextBlock Style="{StaticResource BodyTextStyle}">
                            <Run Text="ProGlass Automation is a purpose-built Windows desktop application designed specifically for "/>
                            <Run Text="UAE-based glass manufacturing companies" FontWeight="Bold"/>
                            <Run Text=". It replaces spreadsheet-driven workflows with a fully integrated system covering raw material inventory, quoting, production planning, delivery tracking, and financial reporting — all in one place."/>
                        </TextBlock>

                        <TextBlock Text="ENGINEERING PRINCIPLES" Style="{StaticResource SubHeadingStyle}"/>
                        <TextBlock Style="{StaticResource BodyTextStyle}">
                            <Run Text="The system is engineered around three core principles:"/>
                            <LineBreak/><LineBreak/>
                            <Run Text="• Deterministic calculations —" FontWeight="Bold"/>
                            <Run Text=" every formula produces the same result every time, with no hidden state or race conditions. Financial and production totals are always reproducible."/>
                            <LineBreak/><LineBreak/>
                            <Run Text="• Modular isolation —" FontWeight="Bold"/>
                            <Run Text=" each business domain (Sheet Store, Proforma Invoice, Job Order, Delivery Note, Tax Invoice) has its own database. A bug in one module cannot corrupt data in another."/>
                            <LineBreak/><LineBreak/>
                            <Run Text="• AI-safe architecture —" FontWeight="Bold"/>
                            <Run Text=" strict MVVM conventions, naming rules, and code organization ensure the codebase remains extensible and maintainable for years — whether extended by a human or an AI assistant."/>
                        </TextBlock>

                        <TextBlock Text="FINANCIAL &amp; COMPLIANCE" Style="{StaticResource SubHeadingStyle}"/>
                        <TextBlock Style="{StaticResource BodyTextStyle}">
                            <Run Text="All monetary values are stored and displayed in "/>
                            <Run Text="AED (UAE Dirham)" FontWeight="Bold"/>
                            <Run Text=" with full precision. UAE 5% VAT is built in with zero-rated export support and full audit trails on every calculation. Tax invoices comply with FTA (Federal Tax Authority) format requirements including sequential numbering, VAT registration number, and mandatory bilingual field labels."/>
                        </TextBlock>

                        <TextBlock Text="DATA OWNERSHIP &amp; DEPLOYMENT" Style="{StaticResource SubHeadingStyle}"/>
                        <TextBlock Style="{StaticResource BodyTextStyle}">
                            <Run Text="Standalone .exe deployment — no cloud dependencies, no subscription fees, no data leaves your machine. All customer records, invoices, delivery photos, and financial data remain on your local Windows PC, backed up automatically on each application exit (last 7 database copies retained). Perfect for offline factory environments and full data-sovereignty requirements."/>
                        </TextBlock>

                        <TextBlock Text="EXTENSIBILITY &amp; FUTURE" Style="{StaticResource SubHeadingStyle}"/>
                        <TextBlock Style="{StaticResource BodyTextStyle}">
                            <Run Text="The current release ships with 8 active modules covering the full production lifecycle. Upcoming production-stage modules (Cutting, Holes/Cutouts, Polish, Edge Deletion, Mitring, Tempering, Pairing, Doubling/DGU) will slot into the existing shell without any database migration. Optional AI Assistant (Google Gemini) provides in-app glass-industry expertise and workflow guidance — fully user-controlled, disable-able, and using only user-provided API keys."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ═══ WORKFLOW ═══ -->
                <Border Style="{StaticResource AboutCardStyle}">
                    <StackPanel>
                        <TextBlock Text="End-to-End Production Workflow"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="From raw glass sheets to tax invoice — every stage tracked"
                                   Style="{StaticResource SectionSubtitleStyle}"/>

                        <TextBlock Text="SALES CYCLE" Style="{StaticResource WorkflowGroupLabelStyle}"/>
                        <ItemsControl ItemsSource="{Binding SalesCycle}"
                                      ItemTemplate="{StaticResource WorkflowCardTemplate}"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="PRODUCTION STAGES (upcoming)" Style="{StaticResource WorkflowGroupLabelStyle}"/>
                        <ItemsControl ItemsSource="{Binding ProductionStages}"
                                      ItemTemplate="{StaticResource WorkflowCardTemplate}"
                                      Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="DISPATCH &amp; BILLING" Style="{StaticResource WorkflowGroupLabelStyle}"/>
                        <ItemsControl ItemsSource="{Binding DispatchBilling}"
                                      ItemTemplate="{StaticResource WorkflowCardTemplate}"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══ MODULES ═══ -->
                <Border Style="{StaticResource AboutCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Active Modules"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Fully functional and battle-tested — ready for daily use"
                                   Style="{StaticResource SectionSubtitleStyle}"/>
                        <ItemsControl ItemsSource="{Binding Modules}"
                                      ItemTemplate="{StaticResource ModuleChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══ TECH STACK ═══ -->
                <Border Style="{StaticResource AboutCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Technology Stack"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Built on battle-tested Microsoft + open-source technology"
                                   Style="{StaticResource SectionSubtitleStyle}"/>
                        <ItemsControl ItemsSource="{Binding TechStack}"
                                      ItemTemplate="{StaticResource TechItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══ CAPABILITIES ═══ -->
                <Border Style="{StaticResource AboutCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Key Capabilities"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="What sets ProGlass Automation apart"
                                   Style="{StaticResource SectionSubtitleStyle}"/>
                        <ItemsControl ItemsSource="{Binding CapabilitiesTop}"
                                      ItemTemplate="{StaticResource CapabilityCardTemplate}"
                                      HorizontalAlignment="Center"
                                      Margin="0,4,0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding CapabilitiesBottom}"
                                      ItemTemplate="{StaticResource CapabilityCardTemplate}"
                                      HorizontalAlignment="Center"
                                      Margin="0,12,0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══ PRIVACY ═══ -->
                <Border Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        Padding="26,20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE72E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Privacy"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding PrivacyLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,7">
                                        <TextBlock Text="•"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,0,9,0"/>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══ FOOTER ═══ -->
                <StackPanel HorizontalAlignment="Center" Margin="0,10,0,20">
                    <Border Background="{DynamicResource ModuleBackgroundBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="28,18"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="ProGlass Automation — Enterprise ERP for UAE glass manufacturing"
                                       FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="{Binding Copyright}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
