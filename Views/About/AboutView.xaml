<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/About/AboutView.xaml
     PROJECT: ProGlassAutomation
     MODULE: About — tabbed shell (v5)

     The single oversized About page is now a shell:
       • compact hero (icon + identity + version/build)
       • a segmented top tab strip: About · Modules · Developer
       • a content area that switches between three separate section
         UserControls (one XAML file per section, edited independently)

     PRESERVED:
       • AboutViewModel bindings (AppName, AppTagline, Version, Build,
         DeveloperName, Country, Email, Copyright, PrivacyLines,
         LeftPillars, RightPillars, SalesCycle, ProductionStages,
         DispatchBilling, Modules, TechStack, CapabilitiesTop/Bottom)
       • RootScrollViewer x:Name + SmoothScrollBehavior
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.About.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:aboutSections="clr-namespace:ProGlassAutomation.Views.About.Sections"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══ SEGMENTED TAB STRIP ═══ -->
            <Style x:Key="AboutTabListStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AboutTabItemStyle" TargetType="ListBoxItem">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="TabBg"
                                    Background="{DynamicResource ModuleBackgroundBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="18,9"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBg" Property="Background"
                                            Value="{DynamicResource MenuHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBg" Property="Background"
                                            Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="TabBg" Property="BorderBrush"
                                            Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource OnAccentForegroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ═══ ROOT ═══ -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          Focusable="False">

        <ScrollViewer x:Name="RootScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="40,40,40,40">

                <!-- ═══ HERO — compact identity strip ═══ -->
                <Border Style="{StaticResource HeroCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- App icon -->
                        <Grid Grid.Column="0" Margin="0,0,24,0">
                            <Ellipse Width="104" Height="104"
                                     Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="1" StrokeDashArray="4 6"
                                     Opacity="0.4" IsHitTestVisible="False"/>
                            <Border Width="84" Height="84"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    Background="{DynamicResource TintIndigoBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Border Width="76" Height="76"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        ClipToBounds="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Border>
                        </Grid>

                        <!-- Identity -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppName}"
                                       FontSize="30" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="{Binding AppTagline}"
                                       FontSize="13"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       IsHitTestVisible="False"/>
                        </StackPanel>

                        <!-- Version / build / edition -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <Border Background="{DynamicResource AccentBrush}"
                                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,8"
                                    HorizontalAlignment="Right"
                                    SnapsToDevicePixels="True">
                                <TextBlock Text="{Binding Version}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           IsHitTestVisible="False"/>
                            </Border>
                            <Border Style="{StaticResource ChipStyle}" Margin="0,8,0,0"
                                    HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Build}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           IsHitTestVisible="False"/>
                            </Border>
                            <Border Style="{StaticResource ChipStyle}" Margin="0,8,0,0"
                                    HorizontalAlignment="Right">
                                <TextBlock Text="Enterprise Edition"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           IsHitTestVisible="False"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ TAB STRIP ═══ -->
                <ListBox ItemsSource="{Binding Tabs}"
                         SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                         Style="{StaticResource AboutTabListStyle}"
                         ItemContainerStyle="{StaticResource AboutTabItemStyle}"
                         Margin="0,0,0,20"/>

                <!-- ═══ SECTION CONTENT (switched by SelectedTabIndex) ═══ -->
                <Grid>
                    <aboutSections:AboutOverviewSection>
                        <aboutSections:AboutOverviewSection.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </aboutSections:AboutOverviewSection.Style>
                    </aboutSections:AboutOverviewSection>

                    <aboutSections:ModulesSection>
                        <aboutSections:ModulesSection.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </aboutSections:ModulesSection.Style>
                    </aboutSections:ModulesSection>

                    <aboutSections:DeveloperSection>
                        <aboutSections:DeveloperSection.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </aboutSections:DeveloperSection.Style>
                    </aboutSections:DeveloperSection>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
