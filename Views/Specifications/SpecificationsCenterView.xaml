<UserControl x:Class="ProGlassAutomation.Views.Specifications.SpecificationsCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!--
            Column header. Uppercase + letter-spacing via FontWeight only;
            the muted foreground keeps it subordinate to the data, which is
            what stops a header row from competing with the rows under it.
        -->
        <!-- Migrated SpecColumnHeaderStyle to global Typography.Label -->
    
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border behaviors:ClickToCommandBehavior.Command="{Binding DataContext.SelectSpecCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        behaviors:ClickToCommandBehavior.CommandParameter="{Binding}"
                                        Style="{StaticResource InteractiveListRowCardStyle}"
                                        Margin="10,5" Padding="14,11">
                                    <Grid>
                                        <!-- Widths MUST match the header grid above. -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Glass type chip -->
                                        <Border Grid.Column="0"
                                                Background="{DynamicResource TintIndigoBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="6,3" VerticalAlignment="Center"
                                                HorizontalAlignment="Left" Style="{StaticResource SurfacePrimaryStyle}">
                                            <TextBlock Text="{Binding GlassType}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SpecName}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Color, Mode=OneWay}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Margin="0,2,0,0"/>
                                            <!-- Draft/library entry: built or imported, but not
                                                 quoted on any saved invoice yet. Visibility lives
                                                 in the style (never a local value) so the trigger
                                                 can control it. -->
                                            <TextBlock Text="{DynamicResource Specifications.DraftOnly}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       FontStyle="Italic"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UsageCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Usage count -->
                                        <TextBlock Grid.Column="2"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <Run Text="{Binding UsageCount, Mode=OneWay}"/>
                                            <Run Text="×"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding PricePerSqm, Mode=OneWay, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,10,0"
                                                   Foreground="{DynamicResource SuccessBrush}"/>

                                        <Button Grid.Column="4"
                                                Command="{Binding DataContext.DeleteSpecCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Content="&#xE74D;"
                                                FontFamily="{DynamicResource FontFamily.Icon}"
                                                Width="28" Height="28"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                Foreground="{DynamicResource DangerBrush}"
                                                BorderThickness="{DynamicResource Border.NoneThickness}"
                                                ToolTip="{DynamicResource Common.Delete}" Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE8F1;"
                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.Display}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Text="{DynamicResource Specifications.EmptyTitle}"
                                   FontSize="{DynamicResource FontSize.Title}"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Specifications.EmptyHint}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ DETAIL PANE ══ -->
            <Border Grid.Column="1"
                    Style="{StaticResource SoftCardStyle}"
                    Margin="14,0,0,0"
                    Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedSpec.SpecName}"
                                   FontSize="{DynamicResource FontSize.Title}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button Grid.Column="1"
                                Command="{Binding CloseDetailCommand}"
                                Content="&#xE711;"
                                FontFamily="{DynamicResource FontFamily.Icon}"
                                Width="28" Height="28" Cursor="Hand"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                Foreground="{DynamicResource TextTertiaryBrush}"
                                BorderThickness="{DynamicResource Border.NoneThickness}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <!--
                        PER-PANE SHEET MATCHES (read-only).

                        A specification is not one piece of glass:
                        "6mm HD Grey FT Glass + 12mm ASP + 6mm Clear FT Glass"
                        is TWO panes, and each is cut from its own Sheet Store
                        sheet — HD Grey may only be stocked as 3210 x 2250
                        while Clear comes as 3660 x 2440. One width/height on
                        the spec could only ever describe the outer leaf,
                        which is why sizes looked missing or wrong.

                        Each pane gets its own box with its glass name and its
                        own width/height.
                    -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource Specifications.MatchedSheet}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>

                        <ItemsControl ItemsSource="{Binding Panes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="12,10" Margin="0,0,0,8" Style="{StaticResource SurfacePrimaryStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding GlassLabel}"
                                                           FontSize="{DynamicResource FontSize.Body}"
                                                           FontWeight="{DynamicResource Weight.Bold}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ThicknessDisplay}"
                                                           FontSize="{DynamicResource FontSize.Body}"
                                                           FontWeight="{DynamicResource Weight.SemiBold}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </Grid>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Specifications.Width}"
                                                               FontSize="{DynamicResource FontSize.Body}"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding WidthDisplay}"
                                                               FontSize="{DynamicResource FontSize.Title}"
                                                               FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{DynamicResource Specifications.Height}"
                                                               FontSize="{DynamicResource FontSize.Body}"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding HeightDisplay}"
                                                               FontSize="{DynamicResource FontSize.Title}"
                                                               FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Explicit miss: never invent a size. -->
                                            <TextBlock Text="{DynamicResource Specifications.NoSheetMatch}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource WarningBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSheet}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Name could not be parsed into panes at all. -->
                        <TextBlock Text="{DynamicResource Specifications.NoPanes}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPanes}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Usage history + price bands -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <!--
                                PRICE BANDS.

                                One specification can be quoted at several
                                rates: SaveOrUpdateAsync overwrites
                                PricePerSqm on every Step 4 apply, so the
                                catalogue row holds only the LATEST rate
                                while each usage row holds what that invoice
                                actually paid. Showing only the latest would
                                misrepresent history, so the distinct rates
                                are listed with the proformas that used them.
                                Hidden when every use was at the same rate.
                            -->
                            <ItemsControl ItemsSource="{Binding PriceBands}" Margin="0,0,0,12">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPriceVariation}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,7" Margin="0,0,0,6"
                                                Background="{DynamicResource TintIndigoBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}" Style="{StaticResource SurfacePrimaryStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding PricePerSqm, Mode=OneWay, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                                                           FontSize="{DynamicResource FontSize.Body}"
                                                           FontWeight="{DynamicResource Weight.Bold}"
                                                           Margin="0,0,10,0"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProformaList}"
                                                           FontSize="{DynamicResource FontSize.Body}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding UsageCountDisplay}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding UsageHistory}"
                                 Background="Transparent"
                                 BorderThickness="{DynamicResource Border.NoneThickness}"
                                 HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="200,400"
                                 VirtualizingPanel.CacheLengthUnit="Pixel"
                                 ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,0,0,6"
                                            Background="{DynamicResource SurfacePrimaryBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}" Style="{StaticResource SurfacePrimaryStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProformaDisplay}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding ContextDisplay}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock FontSize="{DynamicResource FontSize.Body}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Margin="0,2,0,0">
                                                <Run Text="{Binding UsedAtDisplay, Mode=OneWay}"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding PricePerSqm, Mode=OneWay, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
