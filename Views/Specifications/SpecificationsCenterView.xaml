<UserControl x:Class="ProGlassAutomation.Views.Specifications.SpecificationsCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!--
            Column header. Uppercase + letter-spacing via FontWeight only;
            the muted foreground keeps it subordinate to the data, which is
            what stops a header row from competing with the rows under it.
        -->
        <Style x:Key="SpecColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <!--
        SPECIFICATIONS CENTER

        A ledger of saved specifications, laid out like Sheet Store:
        KPI cards, filters, list, and a detail pane that slides in on
        row click showing the sheet that was matched plus every
        proforma that used the spec.

        Read-oriented by design. Step 4 is the only place a spec is
        built and priced, so there is no add/edit dialog here; the one
        mutation is Delete, for pruning the catalogue.
    -->

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Nav.Specifications}"
                           FontSize="{StaticResource TextSection}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <TextBlock Text="{DynamicResource Specifications.Subtitle}"
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ImportCsvCommand}"
                        Content="{DynamicResource Common.ImportCsv}"
                        Height="34" Padding="16,0" Cursor="Hand" Margin="0,0,8,0"
                        Background="{DynamicResource GlassSurfaceElevated}"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}"/>
                <Button Command="{Binding ExportCsvCommand}"
                        Content="{DynamicResource Common.ExportCsv}"
                        Height="34" Padding="16,0" Cursor="Hand" Margin="0,0,8,0"
                        Background="{DynamicResource GlassSurfaceElevated}"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}"/>
                <Button Command="{Binding ExportExcelCommand}"
                        Content="{DynamicResource Common.ExportExcel}"
                        Height="34" Padding="16,0" Cursor="Hand" Margin="0,0,8,0"
                        Background="{DynamicResource GlassSurfaceElevated}"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}"/>
                <Button Command="{Binding ExportPdfCommand}"
                        Content="{DynamicResource Common.ExportPdf}"
                        Height="34" Padding="16,0" Cursor="Hand" Margin="0,0,8,0"
                        Background="{DynamicResource GlassSurfaceElevated}"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}"/>
                <Button Command="{Binding ShareCommand}"
                        Content="{DynamicResource Sharing.Share}"
                        ToolTip="{DynamicResource Sharing.Share}"
                        Height="34" Padding="16,0" Cursor="Hand" Margin="0,0,8,0"
                        Background="{DynamicResource GlassSurfaceElevated}"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}"/>
                <Button Command="{Binding RefreshCommand}"
                        Content="{DynamicResource Common.Refresh}"
                        Height="34" Padding="16,0" Cursor="Hand"
                        Background="{DynamicResource GlassSurfaceElevated}"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}"/>
            </StackPanel>
        </Grid>

        <!-- ══ KPI CARDS ══ -->
        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,14">
            <Border Style="{StaticResource InteractiveStatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Specifications.TotalSpecs}"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalSpecs, Mode=OneWay}"
                               FontSize="{StaticResource TextSection}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InteractiveStatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Specifications.TotalUses}"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalUses, Mode=OneWay}"
                               FontSize="{StaticResource TextSection}" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InteractiveStatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Specifications.AvgRate}"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding AveragePricePerSqm, Mode=OneWay, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                               FontSize="{StaticResource TextSection}" FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InteractiveStatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Specifications.SheetLinked}"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding LinkedSheetCount, Mode=OneWay}"
                               FontSize="{StaticResource TextSection}" FontWeight="Bold"
                               Foreground="{DynamicResource InfoBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InteractiveStatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Specifications.MostUsed}"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding MostUsedSpecName, Mode=OneWay}"
                               FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!--
                LAST ACTIVITY. The most recent ledger-verified use: which
                spec, on which saved invoice for which company, and when.
                Global (not filter-scoped) — it answers "last used anywhere".
            -->
            <Border Style="{StaticResource InteractiveStatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Specifications.LastActivity}"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding LastActivitySpec, Mode=OneWay}"
                               FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LastActivityInvoice, Mode=OneWay}"
                               FontSize="{StaticResource TextBody}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding LastActivityDate, Mode=OneWay}"
                               FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ══ FILTER BAR ══ -->
        <Border Grid.Row="2"
                Style="{StaticResource SoftCardStyle}"
                Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         Height="32" VerticalContentAlignment="Center"
                         Margin="0,0,10,0"
                         Background="{DynamicResource GlassSurfaceElevated}"
                         Foreground="{DynamicResource PrimaryForegroundBrush}"
                         BorderBrush="{DynamicResource OutlineBrush}"
                         BorderThickness="{DynamicResource Border.HairlineThickness}"
                         ToolTip="{DynamicResource Specifications.SearchHint}"/>

                <ComboBox Grid.Column="1" Width="130" Height="32" Margin="0,0,10,0"
                          ItemsSource="{Binding GlassTypeOptions}"
                          SelectedItem="{Binding GlassTypeFilter}"
                          ToolTip="{DynamicResource Specifications.FilterGlassType}"/>

                <ComboBox Grid.Column="2" Width="130" Height="32" Margin="0,0,10,0"
                          ItemsSource="{Binding ColorOptions}"
                          SelectedItem="{Binding ColorFilter}"
                          ToolTip="{DynamicResource Specifications.FilterColor}"/>

                <ComboBox Grid.Column="3" Width="160" Height="32" Margin="0,0,10,0"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SortBy}"
                          ToolTip="{DynamicResource Specifications.Sort}"/>

                <Button Grid.Column="4"
                        Command="{Binding ClearFiltersCommand}"
                        Content="{DynamicResource Common.Clear}"
                        Height="32" Padding="14,0" Cursor="Hand"
                        Background="Transparent"
                        Foreground="{DynamicResource MutedForegroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}"/>
            </Grid>
        </Border>

        <!-- ══ LIST + DETAIL ══ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding DetailColumnWidth}"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SoftCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!--
                        COLUMN HEADER.

                        Widths are duplicated verbatim in the row template
                        below. WPF has no shared-size scope across a ListBox
                        item boundary (SharedSizeGroup does not cross the
                        ItemsPanel), so the only way header and rows line up
                        is identical fixed definitions in both places. If you
                        change one, change the other.

                        Spacing: the header uses the SAME 14,11 padding and
                        10,5 margin as the row cards, so the label sits
                        directly over its column instead of drifting.
                    -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource GlassSurfaceElevated}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                            Padding="24,10">
                        <Grid>
                            <!--
                                Sheet size intentionally NOT a column.
                                A specification has one size PER PANE, and a
                                DGU's two leaves can differ (HD Grey
                                3210x2250, Clear 3660x2440). A single cell
                                could only ever show one of them, which is
                                why it read "—". Per-pane sizes live in the
                                detail sidebar where each glass has its own
                                width and height.
                            -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource Specifications.ColType}"
                                       Style="{StaticResource SpecColumnHeaderStyle}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Specifications.ColSpecification}"
                                       Style="{StaticResource SpecColumnHeaderStyle}" Margin="12,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Specifications.ColUsed}"
                                       Style="{StaticResource SpecColumnHeaderStyle}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource Specifications.ColRate}"
                                       Style="{StaticResource SpecColumnHeaderStyle}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text=""
                                       Style="{StaticResource SpecColumnHeaderStyle}"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Specifications}"
                             Background="Transparent"
                             BorderThickness="{DynamicResource Border.NoneThickness}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="400,800"
                             VirtualizingPanel.CacheLengthUnit="Pixel"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border behaviors:ClickToCommandBehavior.Command="{Binding DataContext.SelectSpecCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        behaviors:ClickToCommandBehavior.CommandParameter="{Binding}"
                                        Style="{StaticResource InteractiveListRowCardStyle}"
                                        Margin="10,5" Padding="14,11">
                                    <Grid>
                                        <!-- Widths MUST match the header grid above. -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Glass type chip -->
                                        <Border Grid.Column="0"
                                                Background="{DynamicResource TintIndigoBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="6,3" VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding GlassType}"
                                                       FontSize="{StaticResource TextBody}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SpecName}"
                                                       FontSize="{StaticResource TextBody}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <TextBlock Text="{Binding Color, Mode=OneWay}"
                                                       FontSize="{StaticResource TextBody}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       Margin="0,2,0,0"/>
                                            <!-- Draft/library entry: built or imported, but not
                                                 quoted on any saved invoice yet. Visibility lives
                                                 in the style (never a local value) so the trigger
                                                 can control it. -->
                                            <TextBlock Text="{DynamicResource Specifications.DraftOnly}"
                                                       FontSize="{StaticResource TextCaption}"
                                                       FontStyle="Italic"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UsageCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Usage count -->
                                        <TextBlock Grid.Column="2"
                                                   FontSize="{StaticResource TextBody}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <Run Text="{Binding UsageCount, Mode=OneWay}"/>
                                            <Run Text="×"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding PricePerSqm, Mode=OneWay, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                                                   FontSize="{StaticResource TextBody}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,10,0"
                                                   Foreground="{DynamicResource SuccessBrush}"/>

                                        <Button Grid.Column="4"
                                                Command="{Binding DataContext.DeleteSpecCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Content="&#xE74D;"
                                                FontFamily="Segoe MDL2 Assets"
                                                Width="28" Height="28"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                Foreground="{DynamicResource DangerBrush}"
                                                BorderThickness="{DynamicResource Border.NoneThickness}"
                                                ToolTip="{DynamicResource Common.Delete}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE8F1;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextDisplayLarge}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource Specifications.EmptyTitle}"
                                   FontSize="{StaticResource TextBodyLarge}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource Specifications.EmptyHint}"
                                   FontSize="{StaticResource TextBody}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ DETAIL PANE ══ -->
            <Border Grid.Column="1"
                    Style="{StaticResource SoftCardStyle}"
                    Margin="14,0,0,0"
                    Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedSpec.SpecName}"
                                   FontSize="{StaticResource TextBodyLarge}"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <Button Grid.Column="1"
                                Command="{Binding CloseDetailCommand}"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                Width="28" Height="28" Cursor="Hand"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                Foreground="{DynamicResource MutedForegroundBrush}"
                                BorderThickness="{DynamicResource Border.NoneThickness}"/>
                    </Grid>

                    <!--
                        PER-PANE SHEET MATCHES (read-only).

                        A specification is not one piece of glass:
                        "6mm HD Grey FT Glass + 12mm ASP + 6mm Clear FT Glass"
                        is TWO panes, and each is cut from its own Sheet Store
                        sheet — HD Grey may only be stocked as 3210 x 2250
                        while Clear comes as 3660 x 2440. One width/height on
                        the spec could only ever describe the outer leaf,
                        which is why sizes looked missing or wrong.

                        Each pane gets its own box with its glass name and its
                        own width/height.
                    -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource Specifications.MatchedSheet}"
                                   FontSize="{StaticResource TextBody}"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>

                        <ItemsControl ItemsSource="{Binding Panes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource GlassSurfaceElevated}"
                                            BorderBrush="{DynamicResource OutlineBrush}"
                                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding GlassLabel}"
                                                           FontSize="{StaticResource TextBody}"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ThicknessDisplay}"
                                                           FontSize="{StaticResource TextBody}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </Grid>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Specifications.Width}"
                                                               FontSize="{StaticResource TextBody}"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                    <TextBlock Text="{Binding WidthDisplay}"
                                                               FontSize="{StaticResource TextBodyLarge}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{DynamicResource Specifications.Height}"
                                                               FontSize="{StaticResource TextBody}"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                    <TextBlock Text="{Binding HeightDisplay}"
                                                               FontSize="{StaticResource TextBodyLarge}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Explicit miss: never invent a size. -->
                                            <TextBlock Text="{DynamicResource Specifications.NoSheetMatch}"
                                                       FontSize="{StaticResource TextBody}"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource WarningBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSheet}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Name could not be parsed into panes at all. -->
                        <TextBlock Text="{DynamicResource Specifications.NoPanes}"
                                   FontSize="{StaticResource TextBody}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPanes}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Usage history + price bands -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <!--
                                PRICE BANDS.

                                One specification can be quoted at several
                                rates: SaveOrUpdateAsync overwrites
                                PricePerSqm on every Step 4 apply, so the
                                catalogue row holds only the LATEST rate
                                while each usage row holds what that invoice
                                actually paid. Showing only the latest would
                                misrepresent history, so the distinct rates
                                are listed with the proformas that used them.
                                Hidden when every use was at the same rate.
                            -->
                            <ItemsControl ItemsSource="{Binding PriceBands}" Margin="0,0,0,12">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPriceVariation}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,7" Margin="0,0,0,6"
                                                Background="{DynamicResource TintIndigoBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding PricePerSqm, Mode=OneWay, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                                                           FontSize="{StaticResource TextBody}"
                                                           FontWeight="Bold"
                                                           Margin="0,0,10,0"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProformaList}"
                                                           FontSize="{StaticResource TextBody}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding UsageCountDisplay}"
                                       FontSize="{StaticResource TextBody}"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding UsageHistory}"
                                 Background="Transparent"
                                 BorderThickness="{DynamicResource Border.NoneThickness}"
                                 HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="200,400"
                                 VirtualizingPanel.CacheLengthUnit="Pixel"
                                 ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,0,0,6"
                                            Background="{DynamicResource GlassUltraClearBrush}"
                                            BorderBrush="{DynamicResource GlassBorderSoft}"
                                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProformaDisplay}"
                                                       FontSize="{StaticResource TextBody}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding ContextDisplay}"
                                                       FontSize="{StaticResource TextBody}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       Margin="0,2,0,0">
                                                <Run Text="{Binding UsedAtDisplay, Mode=OneWay}"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding PricePerSqm, Mode=OneWay, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
