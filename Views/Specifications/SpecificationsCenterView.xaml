<!-- Specifications Center — Studio Bento list, same visual contract as
     the Proforma Invoice list (SavedInvoicesListView): Sl.* hero/KPI
     band, filter card, soft table header, virtualized rows and a
     slide-free detail pane. Original collections, commands and detail
     bindings retained. -->
<UserControl x:Class="ProGlassAutomation.Views.Specifications.SpecificationsCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:layout="clr-namespace:ProGlassAutomation.Views.Dashboard"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource Ov.Canvas}"
             Foreground="{DynamicResource Ov.Ink}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Shared/Lists/StudioListResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ 1 · BENTO TOOLBAR ═════════════════════════════════════ -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" Focusable="False">
            <layout:IndigoDashboardPanel MaxColumns="3" MinimumColumnWidth="270" Gap="14">
                <!-- Hero: average rate -->
                <Border Style="{StaticResource Sl.Hero}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Specifications.AvgRate}" Style="{StaticResource Sl.Label}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Ov.OnAccent}"/>
                        <TextBlock Text="{Binding AveragePricePerSqm, Mode=OneWay, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                                   Style="{StaticResource Sl.Value}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Ov.OnAccent}"
                                   Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="{DynamicResource Specifications.Subtitle}" Style="{StaticResource Sl.Subtitle}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Ov.OnAccentMuted}"/>
                    </StackPanel>
                </Border>

                <!-- KPI trio -->
                <layout:IndigoDashboardPanel MaxColumns="3" MinimumColumnWidth="120" Gap="10">
                    <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Specifications.TotalSpecs}" Style="{StaticResource Sl.Label}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TotalSpecs, Mode=OneWay}" Style="{StaticResource Sl.Value}"
                                       Typography.NumeralAlignment="Tabular" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Specifications.TotalUses}" Style="{StaticResource Sl.Label}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TotalUses, Mode=OneWay}" Style="{StaticResource Sl.Value}"
                                       Typography.NumeralAlignment="Tabular" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Specifications.SheetLinked}" Style="{StaticResource Sl.Label}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding LinkedSheetCount, Mode=OneWay}" Style="{StaticResource Sl.Value}"
                                       Typography.NumeralAlignment="Tabular" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </layout:IndigoDashboardPanel>

                <!-- Actions -->
                <Border Style="{StaticResource Sl.Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Common.Actions}" Style="{StaticResource Sl.Label}"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource Sl.Button}" Command="{Binding ImportCsvCommand}"
                                    Tag="&#xE896;" Content="{DynamicResource Common.ImportCsv}" Margin="0,0,6,4"/>
                            <Button Style="{StaticResource Sl.Button}" Command="{Binding ExportCsvCommand}"
                                    Tag="&#xE72D;" Content="{DynamicResource Common.ExportCsv}" Margin="0,0,6,4"/>
                            <Button Style="{StaticResource Sl.Button}" Command="{Binding ExportExcelCommand}"
                                    Tag="&#xE9F9;" Content="{DynamicResource Common.ExportExcel}" Margin="0,0,6,4"/>
                            <Button Style="{StaticResource Sl.Button}" Command="{Binding ExportPdfCommand}"
                                    Tag="&#xE8A5;" Content="{DynamicResource Common.ExportPdf}" Margin="0,0,6,4"/>
                            <Button Style="{StaticResource Sl.Button}" Command="{Binding ShareCommand}"
                                    Tag="&#xE72D;" Content="{DynamicResource Sharing.Share}"
                                    ToolTip="{DynamicResource Sharing.Share}" Margin="0,0,6,4"/>
                            <Button Style="{StaticResource Sl.PrimaryButton}" Command="{Binding RefreshCommand}"
                                    Tag="&#xE72C;" Content="{DynamicResource Common.Refresh}" Margin="0,0,0,4"/>
                        </WrapPanel>
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="{DynamicResource Specifications.MostUsed}" Style="{StaticResource Sl.Label}"/>
                            <TextBlock Text="{Binding MostUsedSpecName, Mode=OneWay}" Style="{StaticResource Sl.Subtitle}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding MostUsedSpecName, Mode=OneWay}"/>
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Sl.Label}"
                                       Text="{DynamicResource Specifications.LastActivity}"/>
                            <TextBlock Style="{StaticResource Sl.Subtitle}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding LastActivitySpec, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding LastActivityInvoice, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding LastActivityDate, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </layout:IndigoDashboardPanel>
        </ScrollViewer>

        <!-- ══ 2 · FILTER CARD ═══════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource Sl.FilterBar}" Margin="0,10,0,10">
            <WrapPanel>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Action.Search}" Style="{StaticResource Sl.Label}" Margin="0,0,0,3"/>
                    <TextBox Margin="0,0,8,4" Width="280"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             Style="{StaticResource Sl.Input}"
                             ToolTip="{DynamicResource Specifications.SearchHint}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Specifications.FilterGlassType}" Style="{StaticResource Sl.Label}" Margin="0,0,0,3"/>
                    <ComboBox Margin="0,0,8,4" Width="150"
                              ItemsSource="{Binding GlassTypeOptions}"
                              SelectedItem="{Binding GlassTypeFilter}"
                              Style="{StaticResource Sl.Combo}"
                              ToolTip="{DynamicResource Specifications.FilterGlassType}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Specifications.FilterColor}" Style="{StaticResource Sl.Label}" Margin="0,0,0,3"/>
                    <ComboBox Margin="0,0,8,4" Width="150"
                              ItemsSource="{Binding ColorOptions}"
                              SelectedItem="{Binding ColorFilter}"
                              Style="{StaticResource Sl.Combo}"
                              ToolTip="{DynamicResource Specifications.FilterColor}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Specifications.Sort}" Style="{StaticResource Sl.Label}" Margin="0,0,0,3"/>
                    <ComboBox Margin="0,0,8,4" Width="170"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SortBy}"
                              Style="{StaticResource Sl.Combo}"
                              ToolTip="{DynamicResource Specifications.Sort}"/>
                </StackPanel>
                <Button Style="{StaticResource Sl.Button}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                        Command="{Binding ClearFiltersCommand}"
                        Tag="&#xE711;" Content="{DynamicResource Common.Clear}" MinWidth="92"/>
            </WrapPanel>
        </Border>

        <!-- ══ 3 · LIST + DETAIL ═════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding DetailColumnWidth}"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Sl.Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table header -->
                    <Border Grid.Row="0" Style="{StaticResource Sl.TableHeader}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Specifications.ColType}"
                                       Style="{StaticResource Sl.ColumnLabel}" Margin="12,0"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Specifications.ColSpecification}"
                                       Style="{StaticResource Sl.ColumnLabel}" Margin="12,0"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Specifications.ColUsed}"
                                       Style="{StaticResource Sl.ColumnLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource Specifications.ColRate}"
                                       Style="{StaticResource Sl.ColumnLabel}" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        </Grid>
                    </Border>

                    <!-- Virtualized spec rows -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Specifications}"
                             ItemContainerStyle="{StaticResource Sl.ListItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="400,800"
                             VirtualizingPanel.CacheLengthUnit="Pixel"
                             ScrollViewer.CanContentScroll="False"
                             behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border behaviors:ClickToCommandBehavior.Command="{Binding DataContext.SelectSpecCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        behaviors:ClickToCommandBehavior.CommandParameter="{Binding}"
                                        Style="{StaticResource Sl.Row}" Cursor="Hand" MinHeight="56">
                                    <Grid>
                                        <!-- Widths MUST match the header grid above. -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Glass type chip -->
                                        <Border Grid.Column="0" Margin="12,0,0,0"
                                                Background="{DynamicResource Ov.Soft}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="8,4" VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding GlassType}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource Ov.Accent}"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SpecName}"
                                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Ov.Ink}"/>
                                            <TextBlock Text="{Binding Color, Mode=OneWay}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Ov.Muted}"
                                                       Margin="0,2,0,0"/>
                                            <!-- Draft/library entry: built or imported, but not
                                                 quoted on any saved invoice yet. -->
                                            <TextBlock Text="{DynamicResource Specifications.DraftOnly}"
                                                       FontSize="{DynamicResource FontSize.Caption}"
                                                       FontStyle="Italic"
                                                       Foreground="{DynamicResource Ov.Warning}"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UsageCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Usage count -->
                                        <TextBlock Grid.Column="2"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Ov.Muted}"
                                                   Typography.NumeralAlignment="Tabular">
                                            <Run Text="{Binding UsageCount, Mode=OneWay}"/>
                                            <Run Text="×"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding PricePerSqm, Mode=OneWay, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,12,0"
                                                   Foreground="{DynamicResource Ov.Success}"
                                                   Typography.NumeralAlignment="Tabular"/>

                                        <Button Grid.Column="4"
                                                Style="{StaticResource Sl.DangerButton}"
                                                Command="{Binding DataContext.DeleteSpecCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Content="&#xE74D;"
                                                FontFamily="{DynamicResource FontFamily.Icon}"
                                                Width="30" Height="30" MinWidth="30" MinHeight="30" Padding="0"
                                                VerticalAlignment="Center"
                                                ToolTip="{DynamicResource Common.Delete}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Grid.Row="1" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE8F1;"
                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.Display}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Ov.Muted}"/>
                        <TextBlock Text="{DynamicResource Specifications.EmptyTitle}"
                                   FontSize="{DynamicResource FontSize.Title}"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource Ov.Ink}"/>
                        <TextBlock Text="{DynamicResource Specifications.EmptyHint}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource Ov.Muted}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ DETAIL PANE ══ -->
            <Border Grid.Column="1"
                    Style="{StaticResource Sl.Card}"
                    Margin="14,0,0,0"
                    Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Specifications.ColSpecification}"
                                       FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource Ov.Accent}"/>
                            <TextBlock Text="{Binding SelectedSpec.SpecName}"
                                       FontSize="{DynamicResource FontSize.Title}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Ov.Ink}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource Sl.Button}"
                                Command="{Binding CloseDetailCommand}"
                                Content="✕" Width="30" Height="30" MinWidth="30" Padding="0"
                                VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Per-pane sheet matches (read-only). Each pane has
                         its own glass name and its own width/height. -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource Specifications.MatchedSheet}"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource Ov.Muted}"/>

                        <ItemsControl ItemsSource="{Binding Panes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Ov.Soft}"
                                            BorderBrush="{DynamicResource Ov.Line}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius.Medium}"
                                            Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding GlassLabel}"
                                                           FontSize="{DynamicResource FontSize.Body}"
                                                           FontWeight="{DynamicResource Weight.Bold}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Ov.Ink}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ThicknessDisplay}"
                                                           FontSize="{DynamicResource FontSize.Body}"
                                                           FontWeight="{DynamicResource Weight.SemiBold}"
                                                           Foreground="{DynamicResource Ov.Muted}"/>
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Specifications.Width}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource Ov.Muted}"/>
                                                    <TextBlock Text="{Binding WidthDisplay}"
                                                               FontSize="{DynamicResource FontSize.Title}"
                                                               FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource Ov.Accent}"
                                                               Typography.NumeralAlignment="Tabular"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{DynamicResource Specifications.Height}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource Ov.Muted}"/>
                                                    <TextBlock Text="{Binding HeightDisplay}"
                                                               FontSize="{DynamicResource FontSize.Title}"
                                                               FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource Ov.Accent}"
                                                               Typography.NumeralAlignment="Tabular"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Explicit miss: never invent a size. -->
                                            <TextBlock Text="{DynamicResource Specifications.NoSheetMatch}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Margin="0,8,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Ov.Warning}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSheet}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Name could not be parsed into panes at all. -->
                        <TextBlock Text="{DynamicResource Specifications.NoPanes}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Ov.Muted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPanes}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Usage history + price bands -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <!-- Price bands: one spec can be quoted at several
                                 rates; each usage row keeps what that invoice
                                 actually paid. Hidden at a single rate. -->
                            <ItemsControl ItemsSource="{Binding PriceBands}" Margin="0,0,0,12">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPriceVariation}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,0,0,6"
                                                Background="{DynamicResource Ov.Soft}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding PricePerSqm, Mode=OneWay, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                                                           FontSize="{DynamicResource FontSize.Body}"
                                                           FontWeight="{DynamicResource Weight.Bold}"
                                                           Margin="0,0,10,0"
                                                           Foreground="{DynamicResource Ov.Accent}"
                                                           Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProformaList}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Ov.Muted}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding UsageCountDisplay}"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       Margin="0,0,0,8"
                                       Foreground="{DynamicResource Ov.Muted}"/>
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding UsageHistory}"
                                 ItemContainerStyle="{StaticResource Sl.ListItem}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="200,400"
                                 VirtualizingPanel.CacheLengthUnit="Pixel"
                                 ScrollViewer.CanContentScroll="False">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" Margin="0,0,0,6"
                                            Background="{DynamicResource Ov.Surface}"
                                            BorderBrush="{DynamicResource Ov.Line}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius.Medium}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProformaDisplay}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                                       Foreground="{DynamicResource Ov.Accent}"/>
                                            <TextBlock Text="{Binding ContextDisplay}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Ov.Ink}"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Foreground="{DynamicResource Ov.Muted}"
                                                       Margin="0,2,0,0"
                                                       Typography.NumeralAlignment="Tabular">
                                                <Run Text="{Binding UsedAtDisplay, Mode=OneWay}"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding PricePerSqm, Mode=OneWay, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
