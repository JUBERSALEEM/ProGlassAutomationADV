<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Diagnostics/DiagnosticsView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Logs & Activity

     Separate stylish diagnostics page:
       🛠 App Log | 📜 All Activity | one tab per module section …
     Tabs reuse shared VMs — AppLogPanelViewModel (technical log) and
     SectionActivityViewModel (audit feed per section).
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Diagnostics.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ProGlassAutomation.Views.Shared"
             xmlns:diagVm="clr-namespace:ProGlassAutomation.ViewModels.Diagnostics"
             xmlns:sharedVm="clr-namespace:ProGlassAutomation.ViewModels.Shared"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:statCard="clr-namespace:ProGlassAutomation.Controls.StatCard"
    xmlns:conv="clr-namespace:ProGlassAutomation.Converters"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource ModuleBackgroundBrush}">

    <UserControl.Resources>
        <conv:EmojiToGlyphConverter x:Key="EmojiToGlyph"/>

        <!-- Content routing: which panel renders each tab's VM -->
        <DataTemplate DataType="{x:Type sharedVm:SectionActivityViewModel}">
            <shared:SectionActivityView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type diagVm:AppLogPanelViewModel}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,12">

                    <TextBlock Text="Level:"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <ComboBox ItemsSource="{Binding LevelOptions}"
                              SelectedItem="{Binding SelectedLevel}"
                              Margin="8,0,0,0"
                              MinWidth="170"
                              Padding="10,6"
                              FontSize="12"
                              VerticalAlignment="Center"/>

                    <Button Command="{Binding OpenLogsFolderCommand}"
                            Style="{StaticResource PrimaryPillButton}"
                            Margin="12,0,0,0"
                            Tag="&#xE8B7;" Content="OPEN LOG FOLDER"
                            ToolTip="Open the application log folder"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- v2: column headers with tooltips -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="270"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TIME"
                                           Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="White"
                                           ToolTip="When the event was logged"/>
                                <TextBlock Grid.Column="1" Text="LEVEL"
                                           Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="White"
                                           ToolTip="Severity: INFO / WARN / ERROR / CRITICAL"/>
                                <TextBlock Grid.Column="2" Text="MODULE / FUNCTION"
                                           Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="White"
                                           ToolTip="Module › Class › Method where it happened"/>
                                <TextBlock Grid.Column="3" Text="MESSAGE"
                                           Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="White"
                                           Margin="10,0,0,0"
                                           ToolTip="What happened"/>
                            </Grid>
                        </Border>

                        <!-- Empty state -->
                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="36"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" Opacity="0.6"/>
                            <TextBlock Text="No log entries yet"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,3"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Startup, warnings, errors and crashes will appear here."
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>

                        <!-- Virtualized log feed (1000+ entries safe) -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl ItemsSource="{Binding Entries}"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,8"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="0,0,0,1"
                                                ToolTip="{Binding RowTooltip}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="95"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="270"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding TimeDisplay}"
                                                           FontSize="11"
                                                           FontFamily="Consolas"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>

                                                <Border Grid.Column="1"
                                                        CornerRadius="8"
                                                        Padding="7,2"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource TintBlueBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LevelDisplay}" Value="WARN">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource TintAmberBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LevelDisplay}" Value="ERROR">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource TintRedBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LevelDisplay}" Value="CRITICAL">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource TintRedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding LevelDisplay}"
                                                               FontSize="9" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource InfoBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LevelDisplay}" Value="WARN">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LevelDisplay}" Value="ERROR">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LevelDisplay}" Value="CRITICAL">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <TextBlock Grid.Column="2"
                                                           Margin="10,0"
                                                           Text="{Binding ContextDisplay}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ContextDisplay}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                                <TextBlock Grid.Column="3"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                    <Run Text="{Binding Message, Mode=OneWay}"/>
                                                    <Run Text="{Binding ErrorIdDisplay, Mode=OneWay}"
                                                         FontWeight="Bold"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         MIGRATION LOG — Button Standardization (master prompt v1.0)
         Date: 2026-08-15
         • Open log folder -> PrimaryPillButton (folder glyph E8B7,
           map extension) + ToolTip; legacy ModuleToolbarPrimary removed
         • Tab strip -> STEP D two-button pattern; VM emoji icons routed
           through EmojiToGlyphConverter to Segoe MDL2 Assets
         • Empty-state stethoscope emoji -> MDL2 E946
         Commands/bindings preserved; no ViewModel changes.
    ═══════════════════════════════════════════════════════════════ -->

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ═════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🩺  Logs &amp; Activity"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
            <TextBlock Text="Technical diagnostics and per-module user activity — live"
                       FontSize="12" Margin="0,3,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </StackPanel>

        <!-- ══ LIVE STATISTICS (shared StatCardControl, §11) ══════════ -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,14">
            <statCard:StatCardControl Icon="🛠" Title="LOG ENTRIES"
                                      Value="{Binding TotalEntries}"
                                      TrendText="last 500 kept in memory"
                                      Margin="0,0,12,0"/>
            <statCard:StatCardControl Icon="⛔" Title="ERRORS"
                                      Value="{Binding ErrorCount}"
                                      State="Error"
                                      TrendText="incl. critical"
                                      Margin="0,0,12,0"/>
            <statCard:StatCardControl Icon="⚠️" Title="WARNINGS"
                                      Value="{Binding WarningCount}"
                                      State="Warning"
                                      Margin="0,0,12,0"/>
            <statCard:StatCardControl Icon="👤" Title="SIGNED IN AS"
                                      Value="{Binding ActiveUser}"
                                      State="Success"/>
        </WrapPanel>

        <!-- ══ TAB PILLS ══════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Margin="0,0,0,14">
            <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- STEP D two-button visibility pattern -->
                        <Button Command="{Binding DataContext.SwitchTabCommand,
                                            RelativeSource={RelativeSource
                                                AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Tag="{Binding Icon, Converter={StaticResource EmojiToGlyph}}"
                                Content="{Binding Label}"
                                ToolTip="{Binding Label}"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding DataContext.SwitchTabCommand,
                                            RelativeSource={RelativeSource
                                                AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Tag="{Binding Icon, Converter={StaticResource EmojiToGlyph}}"
                                Content="{Binding Label}"
                                ToolTip="{Binding Label}"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ══ ACTIVE TAB CONTENT ═════════════════════════════════════ -->
        <ContentControl Grid.Row="3"
                        Content="{Binding ActiveContent}"/>
    </Grid>
</UserControl>
