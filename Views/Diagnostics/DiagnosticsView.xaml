<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Diagnostics/DiagnosticsView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Logs & Activity

     Separate stylish diagnostics page:
       🛠 App Log | 📜 All Activity | one tab per module section …
     Tabs reuse shared VMs — AppLogPanelViewModel (technical log) and
     SectionActivityViewModel (audit feed per section).
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Diagnostics.DiagnosticsView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ProGlassAutomation.Views.Shared"
             xmlns:diagVm="clr-namespace:ProGlassAutomation.ViewModels.Diagnostics"
             xmlns:sharedVm="clr-namespace:ProGlassAutomation.ViewModels.Shared"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:statCard="clr-namespace:ProGlassAutomation.Controls.StatCard"
    xmlns:conv="clr-namespace:ProGlassAutomation.Converters"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="Transparent">

    <UserControl.Resources>
        <conv:EmojiToGlyphConverter x:Key="EmojiToGlyph"/>

        <!-- Content routing: which panel renders each tab's VM -->
        <DataTemplate DataType="{x:Type sharedVm:SectionActivityViewModel}">
            <shared:SectionActivityView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type diagVm:AppLogPanelViewModel}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,12">

                    <TextBlock Text="{DynamicResource Diagnostics.Level}"
                               FontSize="{DynamicResource FontSize.Body}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <ComboBox ItemsSource="{Binding LevelOptions}"
                              SelectedItem="{Binding SelectedLevel}"
                              Margin="8,0,0,0"
                              MinWidth="170"
                              Padding="10,6"
                              FontSize="{DynamicResource FontSize.Body}"
                              VerticalAlignment="Center" Style="{StaticResource ComboBoxStyle}"/>

                    <Button Command="{Binding OpenLogsFolderCommand}"
                            Style="{StaticResource PrimaryPillButton}"
                            Margin="12,0,0,0"
                            Tag="&#xE8B7;" Content="{DynamicResource Diagnostics.OPENLOGFolder}"
                            ToolTip="{DynamicResource Diagnostics.OpenApplicationLogFolder}"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- v2: column headers with tooltips -->
                        <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="0"
                                Background="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                                Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="270"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Diagnostics.TIME}"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           ToolTip="{DynamicResource Diagnostics.WhenEventLogged}"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Diagnostics.Level}"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           ToolTip="{DynamicResource Diagnostics.SeverityINFOWARNErrorCritical}"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Diagnostics.ModuleFunction}"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           ToolTip="{DynamicResource Diagnostics.ModuleClassMethodWhereHappened}"/>
                                <TextBlock Grid.Column="3" Text="{DynamicResource CrashReports.Message}"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           Margin="10,0,0,0"
                                           ToolTip="{DynamicResource Diagnostics.WhatHappened}"/>
                            </Grid>
                        </Border>

                        <!-- Empty state -->
                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE946;" FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource FontSize.Display}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" Opacity="0.6"/>
                            <TextBlock Text="{DynamicResource Diagnostics.NoLogEntriesYet}"
                                       FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.SemiBold}"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,3"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Diagnostics.StartupWarningsErrorsCrashesAppearHere}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>

                        <!-- Virtualized log feed (1000+ entries safe) -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl ItemsSource="{Binding Entries}"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          VirtualizingPanel.CacheLength="200,400"
                                          VirtualizingPanel.CacheLengthUnit="Pixel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="14,8"
                                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                                                ToolTip="{Binding RowTooltip}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="95"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="270"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding TimeDisplay}"
                                                           FontSize="{DynamicResource FontSize.Body}"
                                                           FontFamily="{DynamicResource FontFamily.Code}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>

                                                <Border Grid.Column="1"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Padding="7,2"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource TintBlueBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LevelDisplay}" Value="WARN">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource TintAmberBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LevelDisplay}" Value="ERROR">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource TintRedBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LevelDisplay}" Value="CRITICAL">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource TintRedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding LevelDisplay}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource InfoBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LevelDisplay}" Value="WARN">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LevelDisplay}" Value="ERROR">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LevelDisplay}" Value="CRITICAL">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <TextBlock Grid.Column="2"
                                                           Margin="10,0"
                                                           Text="{Binding ContextDisplay}"
                                                           FontSize="{DynamicResource FontSize.Body}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ContextDisplay}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                                <TextBlock Grid.Column="3"
                                                           FontSize="{DynamicResource FontSize.Body}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                                    <Run Text="{Binding Message, Mode=OneWay}"/>
                                                    <Run Text="{Binding ErrorIdDisplay, Mode=OneWay}"
                                                         FontWeight="{DynamicResource Weight.Bold}"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         MIGRATION LOG — Button Standardization (master prompt v1.0)
         Date: 2026-08-15
         • Open log folder -> PrimaryPillButton (folder glyph E8B7,
           map extension) + ToolTip; legacy ModuleToolbarPrimary removed
         • Tab strip -> STEP D two-button pattern; VM emoji icons routed
           through EmojiToGlyphConverter to Segoe MDL2 Assets
         • Empty-state stethoscope emoji -> MDL2 E946
         Commands/bindings preserved; no ViewModel changes.
    ═══════════════════════════════════════════════════════════════ -->

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ═════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="{DynamicResource FontFamily.Icon}"
                           FontSize="{DynamicResource FontSize.H2}"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource Nav.LogsActivity}"
                           FontSize="{DynamicResource FontSize.H1}" FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource Diagnostics.TechnicalDiagnosticsModuleUserActivityLive}"
                       FontSize="{DynamicResource FontSize.Body}" Margin="0,3,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </StackPanel>

        <!-- ══ LIVE STATISTICS (shared StatCardControl, §11) ══════════ -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,14">
            <statCard:StatCardControl Icon="&#xE713;" Title="{DynamicResource Diagnostics.LOGEntries}"
                                      Value="{Binding TotalEntries}"
                                      TrendText="{DynamicResource Diagnostics.Last500KeptMemory}"
                                      Margin="0,0,12,0"/>
            <statCard:StatCardControl Icon="&#xE7BA;" Title="{DynamicResource Diagnostics.Errors}"
                                      Value="{Binding ErrorCount}"
                                      State="Error"
                                      TrendText="{DynamicResource Diagnostics.InclCritical}"
                                      Margin="0,0,12,0"/>
            <statCard:StatCardControl Icon="&#xE7BA;" Title="{DynamicResource Diagnostics.Warnings}"
                                      Value="{Binding WarningCount}"
                                      State="Warning"
                                      Margin="0,0,12,0"/>
            <statCard:StatCardControl Icon="&#xE77B;" Title="{DynamicResource Shell.UserHint}"
                                      Value="{Binding ActiveUser}"
                                      State="Success"/>
        </WrapPanel>

        <!-- ══ TAB PILLS ══════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Margin="0,0,0,14">
            <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- STEP D two-button visibility pattern
                             (wrapped: DataTemplate allows one child) -->
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding DataContext.SwitchTabCommand,
                                                RelativeSource={RelativeSource
                                                    AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Tag="{Binding Icon, Converter={StaticResource EmojiToGlyph}}"
                                    Content="{Binding Label}"
                                    ToolTip="{Binding Label}"
                                    Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding DataContext.SwitchTabCommand,
                                                RelativeSource={RelativeSource
                                                    AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Tag="{Binding Icon, Converter={StaticResource EmojiToGlyph}}"
                                    Content="{Binding Label}"
                                    ToolTip="{Binding Label}"
                                    Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                    
                        </StackPanel>
</DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ══ ACTIVE TAB CONTENT ═════════════════════════════════════ -->
        <ContentControl Grid.Row="3"
                        Content="{Binding ActiveContent}"/>
    </Grid>
</UserControl>
