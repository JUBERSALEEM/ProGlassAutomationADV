<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/UserCenter/UserCenterView.xaml
     PROJECT: ProGlassAutomation
     MODULE: User Center — Full Studio Bento Redesign (2026-09-23)
     Adopts Overview Dashboard aesthetic: compact bento cards, clean shapes,
     smart multi-column placement, zero oversized monolithic containers.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl Style="{StaticResource ErpPageRootStyle}"
             x:Class="ProGlassAutomation.Views.UserCenter.UserCenterView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Bento card container style matching Overview Dashboard aesthetic -->
        <Style x:Key="UserCenterCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource Border.HairlineThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Bento header icon tile style -->
        <Style x:Key="UserCenterIconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Meter segment pill for password strength -->
        <Style x:Key="MeterSegmentStyle" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Background="Transparent"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="28,24,28,32">

            <!-- ═══ DEFAULT CREDENTIAL WARNING ═══ -->
            <Border Margin="0,0,0,16" Padding="16,14" CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                    Visibility="{Binding IsDefaultPasswordInUse,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource TintAmberBrush}" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.H2}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource UserCenter.DefaultAdministratorPasswordStillUse}"
                                   FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="{DynamicResource UserCenter.SeededAdminAccountStillUsesDefaultPassword}"
                                   FontSize="{DynamicResource FontSize.Body}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ BENTO HERO HEADER STRIP ═══ -->
            <Border Style="{StaticResource UserCenterCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource TintIndigoBrush}" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.H2}" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Module.UserCenter}"
                                   FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock FontSize="{DynamicResource FontSize.Body}" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{DynamicResource Shell.UserHint}"/>
                            <Run Text="{Binding CurrentUserName, Mode=OneWay}" FontWeight="{DynamicResource Weight.Bold}"/>
                            <Run Text=" · "/>
                            <Run Text="{DynamicResource UserCenter.ActiveUserSignsAuditEntriesFillsDocument}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource TintGreenBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="10,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource SuccessBrush}"
                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Session Active" FontSize="{DynamicResource FontSize.BodySmall}"
                                           FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource SuccessBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource OutlinedPillButton}"
                                Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                                Command="{Binding RefreshCommand}"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ TWO-COLUMN BENTO STAGE ═══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════════════════════════════════════
                     LEFT COLUMN: WORKSTATION ACCOUNTS LIST
                     ═══════════════════════════════════════════════════ -->
                <Border Grid.Column="0" Style="{StaticResource UserCenterCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource UserCenterIconTileStyle}" Margin="0,0,10,0">
                                <TextBlock Text="&#xE716;" FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="User Accounts" FontSize="{DynamicResource FontSize.Title}"
                                           FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Workstation operators" FontSize="{DynamicResource FontSize.Caption}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource TintBlueBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Users.Count, StringFormat='{}{0} Total'}"
                                           FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Users}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="{DynamicResource Radius.Medium}"
                                            Cursor="Hand" BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                                            Background="{DynamicResource SurfaceSecondaryBrush}"
                                            behaviors:ClickToCommandBehavior.Command="{Binding SelectUserCommand}"
                                            behaviors:ClickToCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Tag="{Binding}" SnapsToDevicePixels="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar Circle -->
                                            <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource DividerBrush}"
                                                    BorderThickness="1" Width="40" Height="40" CornerRadius="20"
                                                    VerticalAlignment="Center" Background="{DynamicResource SurfacePrimaryBrush}">
                                                <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource FontFamily.Icon}"
                                                           FontSize="{DynamicResource FontSize.Title}" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- User Details -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource FontSize.Body}"
                                                           FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="{DynamicResource FontSize.Caption}" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextTertiaryBrush}">
                                                    <Run Text="@"/><Run Text="{Binding Username, Mode=OneWay}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Quick Toggle Active Status -->
                                            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource RowOutlinedButton}"
                                                    Height="28" Width="32" Padding="0" Tag="&#xE716;" Content=""
                                                    ToolTip="{DynamicResource UserCenter.ActivateDeactivate}"
                                                    Command="{Binding DataContext.ToggleActiveCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Center"/>

                                            <!-- Chips Strip -->
                                            <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Padding="8,4"
                                                    Background="{DynamicResource SurfacePrimaryBrush}"
                                                    CornerRadius="{DynamicResource Radius.Small}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource TintBlueBrush}" CornerRadius="{DynamicResource Radius.Small}"
                                                                Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Role, Mode=OneWay}" FontSize="{DynamicResource FontSize.Badge}"
                                                                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                        </Border>
                                                        <!-- Active Session Indicator -->
                                                        <Border Background="{DynamicResource TintGreenBrush}" CornerRadius="{DynamicResource Radius.Small}" Padding="6,2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="Active Session" FontSize="{DynamicResource FontSize.Badge}"
                                                                       FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="{DynamicResource FontSize.Label}"
                                                               FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════
                     RIGHT COLUMN: MODULAR BENTO ACTION SUITE
                     ═══════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="2">

                    <!-- ── BENTO CARD 1: FAST ACTIVE USER SWITCH ── -->
                    <Border Style="{StaticResource UserCenterCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource UserCenterIconTileStyle}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE895;" FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource SystemCenter.SwitchActiveUser}"
                                               FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{DynamicResource UserCenter.SelectUserCardEnterPasswordSignPrepared}"
                                               FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="SwitchPasswordBox" Grid.Column="0"
                                             Style="{StaticResource Input.PasswordBox}"
                                             Height="36" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryPillButton}"
                                        Tag="&#xE895;" Content="{DynamicResource UserCenter.SIGNSelected}"
                                        Click="SwitchUser_Click" Height="36" Padding="18,0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── BENTO CARD 2: SELECTED USER CONTACT & DISPATCH ── -->
                    <Border Style="{StaticResource UserCenterCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource UserCenterIconTileStyle}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE715;" FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Sharing.Title}"
                                               FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Selected operator's WhatsApp mobile and email for outbound PDF dispatch"
                                               FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Style="{StaticResource Field.Panel}">
                                    <TextBlock Text="{DynamicResource UserCenter.Mobile}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding SelectedMobile, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Style="{StaticResource Field.Panel}">
                                    <TextBlock Text="{DynamicResource UserCenter.Email}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding SelectedEmail, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>

                                <Button Grid.Column="4" Style="{StaticResource PrimaryPillButton}"
                                        Tag="&#xE74E;" Content="{DynamicResource UserCenter.SaveContact}"
                                        Click="SaveContact_Click" VerticalAlignment="Bottom" Height="36" Padding="16,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── BENTO CARD 3: CREATE NEW WORKSTATION USER ── -->
                    <Border Style="{StaticResource UserCenterCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource UserCenterIconTileStyle}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE710;" FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource SystemCenter.CreateUSER}"
                                               FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Configure credentials, role permissions, and contact details for a new operator"
                                               FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Username & Display Name -->
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource UserCenter.Username}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource UserCenter.DisplayNAME}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>

                                <!-- Row 2: Role & Password -->
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource SystemCenter.ROLE}" Style="{StaticResource Field.Label}"/>
                                    <ComboBox ItemsSource="{Binding RoleOptions}"
                                              SelectedItem="{Binding SelectedRole}"
                                              FontSize="{DynamicResource FontSize.Title}"
                                              VerticalContentAlignment="Center" Style="{StaticResource ComboBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource UserCenter.Password}" Style="{StaticResource Field.Label}"/>
                                    <PasswordBox x:Name="NewPasswordBox"
                                                 Style="{StaticResource Input.PasswordBox}"
                                                 PasswordChanged="NewPasswordBox_PasswordChanged"/>
                                    <!-- Strength meter -->
                                    <StackPanel x:Name="NewPasswordMeter" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <TextBlock x:Name="NewPasswordMeterLabel"
                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="NewPasswordGuidance"
                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>

                                <!-- Row 4: Confirm Password & Audit Reason Note -->
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource UserCenter.ConfirmPassword}" Style="{StaticResource Field.Label}"/>
                                    <PasswordBox x:Name="ConfirmPasswordBox"
                                                 Style="{StaticResource Input.PasswordBox}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="4" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource CompanyCenter.WHYNOTEOptionalRecordedAuditTrail}"
                                               Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding ReasonNote, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"
                                             ToolTip="{DynamicResource UserCenter.ReasonCreatingUserEGNewEstimatorJoinedDubai}"/>
                                </StackPanel>

                                <!-- Row 6: Contact Mobile & Email -->
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="6" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource UserCenter.Mobile}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="6" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource UserCenter.Email}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>

                                <!-- Row 8: Action CTA -->
                                <StackPanel Grid.Row="8" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <Button Style="{StaticResource SuccessPillButton}"
                                            Tag="&#xE710;" Content="{DynamicResource SystemCenter.CreateUSER}"
                                            Click="CreateUser_Click" Height="36" Padding="20,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── BENTO CARD 4: ROTATE USER PASSWORD ── -->
                    <Border Style="{StaticResource UserCenterCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource UserCenterIconTileStyle}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource UserCenter.ChangePassword}"
                                               FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{DynamicResource UserCenter.SelectUserCardProveCurrentPasswordThenSetNew}"
                                               FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Style="{StaticResource Field.Panel}">
                                    <TextBlock Text="{DynamicResource Login.CurrentPassword}" Style="{StaticResource Field.Label}"/>
                                    <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource Input.PasswordBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Style="{StaticResource Field.Panel}">
                                    <TextBlock Text="{DynamicResource Login.NEWPassword}" Style="{StaticResource Field.Label}"/>
                                    <PasswordBox x:Name="ChangeNewPasswordBox" Style="{StaticResource Input.PasswordBox}"
                                                 PasswordChanged="ChangeNewPasswordBox_PasswordChanged"/>
                                    <!-- Strength meter -->
                                    <StackPanel x:Name="ChangePasswordMeter" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <TextBlock x:Name="ChangePasswordMeterLabel"
                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ChangePasswordGuidance"
                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Style="{StaticResource Field.Panel}">
                                    <TextBlock Text="{DynamicResource UserCenter.ConfirmNEW}" Style="{StaticResource Field.Label}"/>
                                    <PasswordBox x:Name="ChangeConfirmPasswordBox" Style="{StaticResource Input.PasswordBox}"/>
                                </StackPanel>

                                <Button Grid.Column="6" Style="{StaticResource PrimaryPillButton}"
                                        Tag="&#xE72E;" Content="{DynamicResource UserCenter.ChangePassword}"
                                        Click="ChangePassword_Click" VerticalAlignment="Bottom" Height="36" Padding="16,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Dynamic Status Banner -->
                    <Border CornerRadius="{DynamicResource Radius.Small}" Background="{DynamicResource TintIndigoBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                            Padding="14,10" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Status}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
