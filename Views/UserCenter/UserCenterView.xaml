<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/UserCenter/UserCenterView.xaml
     PROJECT: ProGlassAutomation
     MODULE: User Center (Phase 1)

     Left: user cards (role, active/current badges).
     Right: create user + switch active user (passwords stay in
     PasswordBoxes; code-behand hands them straight to the VM).
     The active user auto-fills "Document Prepared By" in PI Step 2
     and signs every audit entry.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.UserCenter.UserCenterView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="UcFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="UcTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="UcPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Background="Transparent">
        <StackPanel Margin="32,26,32,32">

            <!-- A-3 — DEFAULT CREDENTIAL WARNING -->
            <Border Margin="0,0,0,16" Padding="16,12" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsDefaultPasswordInUse,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextTitle}" VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource WarningBrush}"/>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource UserCenter.DefaultAdministratorPasswordStillUse}"
                                   FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="{DynamicResource UserCenter.SeededAdminAccountStillUsesDefaultPassword}"
                                   FontSize="{StaticResource TextBody}" Margin="0,3,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- HEADER -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Module.UserCenter}"
                               FontSize="{StaticResource TextDisplay}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock FontSize="{StaticResource TextBody}" Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}">
                        <Run Text="{DynamicResource Shell.UserHint}"/>
                        <Run Text="{Binding CurrentUserName, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text="{DynamicResource UserCenter.ActiveUserSignsAuditEntriesFillsDocument}"/>
                    </TextBlock>
                </StackPanel>
                <Button Style="{StaticResource OutlinedPillButton}"
                        Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── USER CARDS ── -->
                <ItemsControl Grid.Column="0" ItemsSource="{Binding Users}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="14,12"
                                    CornerRadius="{DynamicResource CardCornerRadius}" Cursor="Hand"
                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                                    Background="{DynamicResource ModuleBackgroundBrush}"
                                    behaviors:ClickToCommandBehavior.Command="{Binding SelectUserCommand}"
                                        behaviors:ClickToCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                    Tag="{Binding}"
                                    SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource OutlineBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" Width="44" Height="44"
                                            CornerRadius="{DynamicResource CardCornerRadius}"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TintIndigoBrush}">
                                        <TextBlock Text="&#xE77B;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{StaticResource TextTitle}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,8,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="{StaticResource TextCaption}" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <Run Text="{Binding Username, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding Role, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource TintIndigoBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{DynamicResource UserCenter.Signed}" FontSize="{StaticResource TextCaption}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <Button Style="{StaticResource RowOutlinedButton}"
                                                Tag="&#xE716;" Content=""
                                                ToolTip="{DynamicResource UserCenter.ActivateDeactivate}"
                                                Command="{Binding DataContext.ToggleActiveCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ── RIGHT PANEL ── -->
                <Border Grid.Column="2"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="24,20">
                    <StackPanel>

                        <TextBlock Text="{DynamicResource SystemCenter.CreateUSER}"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <!-- PHASE D: WHY note row -->
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{DynamicResource UserCenter.Username}" Style="{StaticResource UcFieldLabel}"/>
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource UcTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="{DynamicResource UserCenter.DisplayNAME}" Style="{StaticResource UcFieldLabel}"/>
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource UcTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="{DynamicResource SystemCenter.ROLE}" Style="{StaticResource UcFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding RoleOptions}"
                                          SelectedItem="{Binding SelectedRole}"
                                          Height="38" FontSize="{StaticResource TextBodyLarge}"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="{DynamicResource UserCenter.Password}" Style="{StaticResource UcFieldLabel}"/>
                                <PasswordBox x:Name="NewPasswordBox"
                                             Style="{StaticResource UcPasswordBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                                <TextBlock Text="{DynamicResource UserCenter.ConfirmPassword}" Style="{StaticResource UcFieldLabel}"/>
                                <PasswordBox x:Name="ConfirmPasswordBox"
                                             Style="{StaticResource UcPasswordBox}"/>
                            </StackPanel>

                            <!-- PHASE D — WHY note recorded with the audit entry -->
                            <StackPanel Grid.Row="6" Grid.ColumnSpan="3">
                                <TextBlock Text="{DynamicResource CompanyCenter.WHYNOTEOptionalRecordedAuditTrail}"
                                           Style="{StaticResource UcFieldLabel}"/>
                                <TextBox Text="{Binding ReasonNote, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource UcTextBox}"
                                         ToolTip="{DynamicResource UserCenter.ReasonCreatingUserEGNewEstimatorJoinedDubai}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="8" Grid.ColumnSpan="3"
                                        Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Style="{StaticResource SuccessPillButton}"
                                        Tag="&#xE710;" Content="{DynamicResource SystemCenter.CreateUSER}"
                                        Click="CreateUser_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Margin="0,20,0,20"
                                Background="{DynamicResource DividerBrush}"/>

                        <TextBlock Text="{DynamicResource SystemCenter.SwitchActiveUser}"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource UserCenter.SelectUserCardEnterPasswordSignPrepared}"
                                   Style="{StaticResource UcFieldLabel}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <PasswordBox x:Name="SwitchPasswordBox"
                                         Width="240"
                                         Style="{StaticResource UcPasswordBox}"/>
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE895;" Content="{DynamicResource UserCenter.SIGNSelected}"
                                    Click="SwitchUser_Click"
                                    Margin="12,0,0,0"/>
                        </StackPanel>

                        <Border Height="1" Margin="0,20,0,20"
                                Background="{DynamicResource DividerBrush}"/>

                        <!-- A-3 — CHANGE PASSWORD -->
                        <TextBlock Text="{DynamicResource UserCenter.ChangePassword}"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource UserCenter.SelectUserCardProveCurrentPasswordThenSetNew}"
                                   Style="{StaticResource UcFieldLabel}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Login.CurrentPassword}"
                                           Style="{StaticResource UcFieldLabel}"/>
                                <PasswordBox x:Name="CurrentPasswordBox"
                                             Width="200"
                                             Style="{StaticResource UcPasswordBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Login.NEWPassword}"
                                           Style="{StaticResource UcFieldLabel}"/>
                                <PasswordBox x:Name="ChangeNewPasswordBox"
                                             Width="200"
                                             Style="{StaticResource UcPasswordBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource UserCenter.ConfirmNEW}"
                                           Style="{StaticResource UcFieldLabel}"/>
                                <PasswordBox x:Name="ChangeConfirmPasswordBox"
                                             Width="200"
                                             Style="{StaticResource UcPasswordBox}"/>
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE72E;" Content="{DynamicResource UserCenter.ChangePassword}"
                                    Click="ChangePassword_Click"
                                    VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Status}"
                                   FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                   Margin="0,14,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
