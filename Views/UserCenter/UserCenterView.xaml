<!-- User Center — Studio Bento fresh UI, same visual contract as the
     Proforma Invoice list (SavedInvoicesListView): Sl.* hero band,
     cards, inputs and buttons. All user-list, switch, contact,
     create-user and password-rotation bindings plus every code-behind
     x:Name / handler retained. No private card styles. -->
<UserControl x:Class="ProGlassAutomation.Views.UserCenter.UserCenterView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource Ov.Canvas}"
             Foreground="{DynamicResource Ov.Ink}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Shared/Lists/StudioListResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Meter segment pill for password strength -->
            <Style x:Key="MeterSegmentStyle" TargetType="Border">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="4"/>
                <Setter Property="CornerRadius" Value="{DynamicResource Radius.XSmall}"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="Background" Value="{DynamicResource Ov.Line}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Background="Transparent"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="20,16,20,24">

            <!-- ═══ DEFAULT CREDENTIAL WARNING ═══ -->
            <Border Margin="0,0,0,14" Padding="16,14" CornerRadius="{DynamicResource Radius.Large}"
                    Background="{DynamicResource Ov.WarningSoft}"
                    BorderBrush="{DynamicResource Ov.Warning}"
                    BorderThickness="1"
                    Visibility="{Binding IsDefaultPasswordInUse,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{DynamicResource Radius.Medium}"
                            Background="{DynamicResource Ov.Surface}" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.H2}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Ov.Warning}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource UserCenter.DefaultAdministratorPasswordStillUse}"
                                   FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource Ov.Warning}"/>
                        <TextBlock Text="{DynamicResource UserCenter.SeededAdminAccountStillUsesDefaultPassword}"
                                   FontSize="{DynamicResource FontSize.Body}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Ov.Ink}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ HERO BAND ═══ -->
            <Border Style="{StaticResource Sl.Hero}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Module.UserCenter}"
                                   Style="{StaticResource Sl.Label}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Ov.OnAccent}"/>
                        <TextBlock Style="{StaticResource Sl.Subtitle}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Ov.OnAccentMuted}">
                            <Run Text="{DynamicResource Shell.UserHint}"/>
                            <Run Text="{Binding CurrentUserName, Mode=OneWay}" FontWeight="{DynamicResource Weight.Bold}"/>
                            <Run Text=" · "/>
                            <Run Text="{DynamicResource UserCenter.ActiveUserSignsAuditEntriesFillsDocument}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Ov.SuccessSoft}" CornerRadius="{DynamicResource Radius.Small}"
                                Padding="10,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource Ov.Success}"
                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Session Active" FontSize="{DynamicResource FontSize.BodySmall}"
                                           FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Success}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource Sl.Button}"
                                Background="{DynamicResource Ov.Surface}"
                                Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                                Command="{Binding RefreshCommand}"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ TWO-COLUMN STAGE ═══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── LEFT: WORKSTATION ACCOUNTS ── -->
                <Border Grid.Column="0" Style="{StaticResource Sl.Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="{DynamicResource Radius.Medium}"
                                    Background="{DynamicResource Ov.Soft}" Margin="0,0,10,0">
                                <TextBlock Text="&#xE716;" FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Ov.Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource SystemCenter.Users}" Style="{StaticResource Sl.Label}"/>
                                <TextBlock Text="Workstation operators"
                                           Style="{StaticResource Sl.Subtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource Ov.Soft}"
                                    CornerRadius="{DynamicResource Radius.Small}" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Users.Count, StringFormat='{}{0} Total'}"
                                           FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource Ov.Accent}"
                                           Typography.NumeralAlignment="Tabular"/>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Users}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="{DynamicResource Radius.Medium}"
                                            Cursor="Hand" BorderBrush="{DynamicResource Ov.Line}"
                                            BorderThickness="1"
                                            Background="{DynamicResource Ov.Surface}"
                                            behaviors:ClickToCommandBehavior.Command="{Binding SelectUserCommand}"
                                            behaviors:ClickToCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Tag="{Binding}" SnapsToDevicePixels="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Ov.Line}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
                                                        <Setter Property="Background" Value="{DynamicResource Ov.Soft}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar circle -->
                                            <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource Ov.Line}"
                                                    BorderThickness="1" Width="40" Height="40" CornerRadius="{DynamicResource Radius.2XLarge}"
                                                    VerticalAlignment="Center" Background="{DynamicResource Ov.Surface}">
                                                <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource FontFamily.Icon}"
                                                           FontSize="{DynamicResource FontSize.Title}" Foreground="{DynamicResource Ov.Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- User details -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource FontSize.Body}"
                                                           FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Ink}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="{DynamicResource FontSize.Caption}" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource Ov.Muted}">
                                                    <Run Text="@"/><Run Text="{Binding Username, Mode=OneWay}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Toggle active -->
                                            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource Sl.Button}"
                                                    MinHeight="32" Width="32" Padding="0" Tag="&#xE716;" Content=""
                                                    ToolTip="{DynamicResource UserCenter.ActivateDeactivate}"
                                                    Command="{Binding DataContext.ToggleActiveCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Center"/>

                                            <!-- Chips strip -->
                                            <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="8,5"
                                                    Background="{DynamicResource Ov.Soft}"
                                                    CornerRadius="{DynamicResource Radius.Small}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource Ov.Surface}" CornerRadius="{DynamicResource Radius.Small}"
                                                                Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Role, Mode=OneWay}" FontSize="{DynamicResource FontSize.Caption}"
                                                                       FontWeight="Bold" Foreground="{DynamicResource Ov.Accent}"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource Ov.SuccessSoft}" CornerRadius="{DynamicResource Radius.Small}" Padding="6,2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="Session Active" FontSize="{DynamicResource FontSize.Caption}"
                                                                       FontWeight="Bold" Foreground="{DynamicResource Ov.Success}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="{DynamicResource FontSize.Caption}"
                                                               FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource Ov.Muted}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── RIGHT: ACTION SUITE ── -->
                <StackPanel Grid.Column="2">

                    <!-- Fast active user switch -->
                    <Border Style="{StaticResource Sl.Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="{DynamicResource Radius.Medium}"
                                        Background="{DynamicResource Ov.Soft}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE895;" FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Ov.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource SystemCenter.SwitchActiveUser}" Style="{StaticResource Sl.Label}"/>
                                    <TextBlock Text="{DynamicResource UserCenter.SelectUserCardEnterPasswordSignPrepared}"
                                               Style="{StaticResource Sl.Subtitle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="SwitchPasswordBox" Grid.Column="0"
                                             Style="{StaticResource Input.PasswordBox}"
                                             Height="38" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource Sl.PrimaryButton}"
                                        Tag="&#xE895;" Content="{DynamicResource UserCenter.SIGNSelected}"
                                        Click="SwitchUser_Click" MinHeight="38" Padding="18,8"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Selected user contact & dispatch -->
                    <Border Style="{StaticResource Sl.Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="{DynamicResource Radius.Medium}"
                                        Background="{DynamicResource Ov.Soft}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE715;" FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Ov.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Sharing.Title}" Style="{StaticResource Sl.Label}"/>
                                    <TextBlock Text="Selected operator's WhatsApp mobile and email for outbound PDF dispatch"
                                               Style="{StaticResource Sl.Subtitle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Style="{StaticResource Field.Panel}">
                                    <TextBlock Text="{DynamicResource UserCenter.Mobile}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding SelectedMobile, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Style="{StaticResource Field.Panel}">
                                    <TextBlock Text="{DynamicResource UserCenter.Email}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding SelectedEmail, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>

                                <Button Grid.Column="4" Style="{StaticResource Sl.PrimaryButton}"
                                        Tag="&#xE74E;" Content="{DynamicResource UserCenter.SaveContact}"
                                        Click="SaveContact_Click" VerticalAlignment="Bottom" MinHeight="38" Padding="16,8"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Create new workstation user -->
                    <Border Style="{StaticResource Sl.Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="{DynamicResource Radius.Medium}"
                                        Background="{DynamicResource Ov.Soft}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE710;" FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Ov.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource SystemCenter.CreateUSER}" Style="{StaticResource Sl.Label}"/>
                                    <TextBlock Text="Configure credentials, role permissions, and contact details for a new operator"
                                               Style="{StaticResource Sl.Subtitle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource UserCenter.Username}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource UserCenter.DisplayNAME}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>

                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource SystemCenter.ROLE}" Style="{StaticResource Field.Label}"/>
                                    <ComboBox ItemsSource="{Binding RoleOptions}"
                                              SelectedItem="{Binding SelectedRole}"
                                              VerticalContentAlignment="Center" Style="{StaticResource ComboBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource UserCenter.Password}" Style="{StaticResource Field.Label}"/>
                                    <PasswordBox x:Name="NewPasswordBox"
                                                 Style="{StaticResource Input.PasswordBox}"
                                                 PasswordChanged="NewPasswordBox_PasswordChanged"/>
                                    <!-- Strength meter -->
                                    <StackPanel x:Name="NewPasswordMeter" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <TextBlock x:Name="NewPasswordMeterLabel"
                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="NewPasswordGuidance"
                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                               Foreground="{DynamicResource Ov.Muted}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>

                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource UserCenter.ConfirmPassword}" Style="{StaticResource Field.Label}"/>
                                    <PasswordBox x:Name="ConfirmPasswordBox"
                                                 Style="{StaticResource Input.PasswordBox}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="4" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource CompanyCenter.WHYNOTEOptionalRecordedAuditTrail}"
                                               Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding ReasonNote, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"
                                             ToolTip="{DynamicResource UserCenter.ReasonCreatingUserEGNewEstimatorJoinedDubai}"/>
                                </StackPanel>

                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="6" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource UserCenter.Mobile}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field.Panel}" Grid.Row="6" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource UserCenter.Email}" Style="{StaticResource Field.Label}"/>
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Input.TextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="8" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <Button Style="{StaticResource Sl.SuccessButton}"
                                            Tag="&#xE710;" Content="{DynamicResource SystemCenter.CreateUSER}"
                                            Click="CreateUser_Click" MinHeight="38" Padding="20,8"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Rotate user password -->
                    <Border Style="{StaticResource Sl.Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="{DynamicResource Radius.Medium}"
                                        Background="{DynamicResource Ov.Soft}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Ov.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource UserCenter.ChangePassword}" Style="{StaticResource Sl.Label}"/>
                                    <TextBlock Text="{DynamicResource UserCenter.SelectUserCardProveCurrentPasswordThenSetNew}"
                                               Style="{StaticResource Sl.Subtitle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Style="{StaticResource Field.Panel}">
                                    <TextBlock Text="{DynamicResource Login.CurrentPassword}" Style="{StaticResource Field.Label}"/>
                                    <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource Input.PasswordBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Style="{StaticResource Field.Panel}">
                                    <TextBlock Text="{DynamicResource Login.NEWPassword}" Style="{StaticResource Field.Label}"/>
                                    <PasswordBox x:Name="ChangeNewPasswordBox" Style="{StaticResource Input.PasswordBox}"
                                                 PasswordChanged="ChangeNewPasswordBox_PasswordChanged"/>
                                    <!-- Strength meter -->
                                    <StackPanel x:Name="ChangePasswordMeter" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <Border Style="{StaticResource MeterSegmentStyle}"/>
                                        <TextBlock x:Name="ChangePasswordMeterLabel"
                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ChangePasswordGuidance"
                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                               Foreground="{DynamicResource Ov.Muted}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Style="{StaticResource Field.Panel}">
                                    <TextBlock Text="{DynamicResource UserCenter.ConfirmNEW}" Style="{StaticResource Field.Label}"/>
                                    <PasswordBox x:Name="ChangeConfirmPasswordBox" Style="{StaticResource Input.PasswordBox}"/>
                                </StackPanel>

                                <Button Grid.Column="6" Style="{StaticResource Sl.PrimaryButton}"
                                        Tag="&#xE72E;" Content="{DynamicResource UserCenter.ChangePassword}"
                                        Click="ChangePassword_Click" VerticalAlignment="Bottom" MinHeight="38" Padding="16,8"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Dynamic status banner -->
                    <Border CornerRadius="{DynamicResource Radius.Medium}" Background="{DynamicResource Ov.Soft}"
                            BorderBrush="{DynamicResource Ov.Accent}" BorderThickness="1"
                            Padding="14,10" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Status}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource Ov.Accent}" TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
