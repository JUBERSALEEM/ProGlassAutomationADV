<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/UserCenter/UserCenterView.xaml
     PROJECT: ProGlassAutomation
     MODULE: User Center (Phase 1)

     Left: user cards (role, active/current badges).
     Right: create user + switch active user (passwords stay in
     PasswordBoxes; code-behand hands them straight to the VM).
     The active user auto-fills "Document Prepared By" in PI Step 2
     and signs every audit entry.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.UserCenter.UserCenterView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        
        
        
        <!-- Strength-meter segment: 4 per meter, lit left-to-right by score. -->
        
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Background="Transparent">
        <StackPanel Margin="32,26,32,32">

            <!-- A-3 — DEFAULT CREDENTIAL WARNING -->
            <Border Margin="0,0,0,16" Padding="16,12" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                    Visibility="{Binding IsDefaultPasswordInUse,
                                 Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="{DynamicResource FontSize.H2}" VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource WarningBrush}"/>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource UserCenter.DefaultAdministratorPasswordStillUse}"
                                   FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="{DynamicResource UserCenter.SeededAdminAccountStillUsesDefaultPassword}"
                                   FontSize="{DynamicResource FontSize.Body}" Margin="0,3,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- HEADER -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Module.UserCenter}"
                               FontSize="{DynamicResource FontSize.Kpi}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock FontSize="{DynamicResource FontSize.Body}" Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}">
                        <Run Text="{DynamicResource Shell.UserHint}"/>
                        <Run Text="{Binding CurrentUserName, Mode=OneWay}" FontWeight="{DynamicResource Weight.Bold}"/>
                        <Run Text="{DynamicResource UserCenter.ActiveUserSignsAuditEntriesFillsDocument}"/>
                    </TextBlock>
                </StackPanel>
                <Button Style="{StaticResource OutlinedPillButton}"
                        Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── USER CARDS ── -->
                <ItemsControl Grid.Column="0" ItemsSource="{Binding Users}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="14,12"
                                    CornerRadius="{DynamicResource CardCornerRadius}" Cursor="Hand"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                                    Background="{DynamicResource SurfacePrimaryBrush}"
                                    behaviors:ClickToCommandBehavior.Command="{Binding SelectUserCommand}"
                                        behaviors:ClickToCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                    Tag="{Binding}"
                                    SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource BorderDefaultBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}" Width="44" Height="44"
                                            CornerRadius="{DynamicResource CardCornerRadius}"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TintIndigoBrush}" Style="{StaticResource SurfacePrimaryStyle}">
                                        <TextBlock Text="&#xE77B;"
                                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                                   FontSize="{DynamicResource FontSize.H2}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,8,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="{DynamicResource FontSize.BodySmall}" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <Run Text="{Binding Username, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding Role, Mode=OneWay}"/>
                                        </TextBlock>
                                        <!-- Sharing Center contact (blank when none on file). -->
                                        <TextBlock Text="{Binding ContactLine}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource TintIndigoBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,3" Style="{StaticResource SurfacePrimaryStyle}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{DynamicResource UserCenter.Signed}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                       FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <Button Style="{StaticResource RowOutlinedButton}"
                                                Tag="&#xE716;" Content=""
                                                ToolTip="{DynamicResource UserCenter.ActivateDeactivate}"
                                                Command="{Binding DataContext.ToggleActiveCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ── RIGHT PANEL ── -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="24,20" Style="{StaticResource SurfacePrimaryStyle}">
                    <StackPanel>

                        <TextBlock Text="{DynamicResource SystemCenter.CreateUSER}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <!-- PHASE D: WHY note row -->
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <!-- Sharing Center contact row -->
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{DynamicResource UserCenter.Username}" Style="{StaticResource Typography.Label}"/>
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="{DynamicResource UserCenter.DisplayNAME}" Style="{StaticResource Typography.Label}"/>
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="{DynamicResource SystemCenter.ROLE}" Style="{StaticResource Typography.Label}"/>
                                <ComboBox ItemsSource="{Binding RoleOptions}"
                                          SelectedItem="{Binding SelectedRole}"
                                          Height="38" FontSize="{DynamicResource FontSize.Title}"
                                          VerticalContentAlignment="Center" Style="{StaticResource ComboBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="{DynamicResource UserCenter.Password}" Style="{StaticResource Typography.Label}"/>
                                <PasswordBox x:Name="NewPasswordBox"
                                             Style="{StaticResource Input.TextBox}"
                                             PasswordChanged="NewPasswordBox_PasswordChanged"/>
                                <!-- Strength meter: lit by PasswordMeterHelper. -->
                                <StackPanel x:Name="NewPasswordMeter" Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Style="{StaticResource SurfaceDetailStyle}"/>
                                    <Border Style="{StaticResource SurfaceDetailStyle}"/>
                                    <Border Style="{StaticResource SurfaceDetailStyle}"/>
                                    <Border Style="{StaticResource SurfaceDetailStyle}"/>
                                    <TextBlock x:Name="NewPasswordMeterLabel"
                                               FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="NewPasswordGuidance"
                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                                <TextBlock Text="{DynamicResource UserCenter.ConfirmPassword}" Style="{StaticResource Typography.Label}"/>
                                <PasswordBox x:Name="ConfirmPasswordBox"
                                             Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>

                            <!-- PHASE D — WHY note recorded with the audit entry -->
                            <StackPanel Grid.Row="6" Grid.ColumnSpan="3">
                                <TextBlock Text="{DynamicResource CompanyCenter.WHYNOTEOptionalRecordedAuditTrail}"
                                           Style="{StaticResource Typography.Label}"/>
                                <TextBox Text="{Binding ReasonNote, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input.TextBox}"
                                         ToolTip="{DynamicResource UserCenter.ReasonCreatingUserEGNewEstimatorJoinedDubai}"/>
                            </StackPanel>

                            <!-- Sharing Center FROM contact (optional). -->
                            <StackPanel Grid.Row="8" Grid.Column="0">
                                <TextBlock Text="{DynamicResource UserCenter.Mobile}" Style="{StaticResource Typography.Label}"/>
                                <TextBox Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="8" Grid.Column="2">
                                <TextBlock Text="{DynamicResource UserCenter.Email}" Style="{StaticResource Typography.Label}"/>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="10" Grid.ColumnSpan="3"
                                        Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Style="{StaticResource SuccessPillButton}"
                                        Tag="&#xE710;" Content="{DynamicResource SystemCenter.CreateUSER}"
                                        Click="CreateUser_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Margin="0,20,0,20"
                                Background="{DynamicResource DividerBrush}"/>

                        <TextBlock Text="{DynamicResource SystemCenter.SwitchActiveUser}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource UserCenter.SelectUserCardEnterPasswordSignPrepared}"
                                   Style="{StaticResource Typography.Label}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <PasswordBox x:Name="SwitchPasswordBox"
                                         Width="240"
                                         Style="{StaticResource Input.TextBox}"/>
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE895;" Content="{DynamicResource UserCenter.SIGNSelected}"
                                    Click="SwitchUser_Click"
                                    Margin="12,0,0,0"/>
                        </StackPanel>

                        <Border Height="1" Margin="0,20,0,20"
                                Background="{DynamicResource DividerBrush}"/>

                        <!-- A-3 — CHANGE PASSWORD -->
                        <TextBlock Text="{DynamicResource UserCenter.ChangePassword}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource UserCenter.SelectUserCardProveCurrentPasswordThenSetNew}"
                                   Style="{StaticResource Typography.Label}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Login.CurrentPassword}"
                                           Style="{StaticResource Typography.Label}"/>
                                <PasswordBox x:Name="CurrentPasswordBox"
                                             Width="200"
                                             Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Login.NEWPassword}"
                                           Style="{StaticResource Typography.Label}"/>
                                <PasswordBox x:Name="ChangeNewPasswordBox"
                                             Width="200"
                                             Style="{StaticResource Input.TextBox}"
                                             PasswordChanged="ChangeNewPasswordBox_PasswordChanged"/>
                                <!-- Strength meter: lit by PasswordMeterHelper. -->
                                <StackPanel x:Name="ChangePasswordMeter" Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Style="{StaticResource SurfaceDetailStyle}"/>
                                    <Border Style="{StaticResource SurfaceDetailStyle}"/>
                                    <Border Style="{StaticResource SurfaceDetailStyle}"/>
                                    <Border Style="{StaticResource SurfaceDetailStyle}"/>
                                    <TextBlock x:Name="ChangePasswordMeterLabel"
                                               FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ChangePasswordGuidance"
                                           Width="200"
                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource UserCenter.ConfirmNEW}"
                                           Style="{StaticResource Typography.Label}"/>
                                <PasswordBox x:Name="ChangeConfirmPasswordBox"
                                             Width="200"
                                             Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE72E;" Content="{DynamicResource UserCenter.ChangePassword}"
                                    Click="ChangePassword_Click"
                                    VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <Border Height="1" Margin="0,20,0,20"
                                Background="{DynamicResource DividerBrush}"/>

                        <!-- Sharing Center contact for the SELECTED card. -->
                        <TextBlock Text="{DynamicResource Sharing.Title}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource UserCenter.Mobile}"
                                           Style="{StaticResource Typography.Label}"/>
                                <TextBox Text="{Binding SelectedMobile, UpdateSourceTrigger=PropertyChanged}"
                                         Width="200"
                                         Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource UserCenter.Email}"
                                           Style="{StaticResource Typography.Label}"/>
                                <TextBox Text="{Binding SelectedEmail, UpdateSourceTrigger=PropertyChanged}"
                                         Width="240"
                                         Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE74E;" Content="{DynamicResource UserCenter.SaveContact}"
                                    Click="SaveContact_Click"
                                    VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Status}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   Margin="0,14,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
