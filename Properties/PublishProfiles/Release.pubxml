<?xml version="1.0" encoding="utf-8"?>
<!--
  ════════════════════════════════════════════════════════════════════
  FILE: Properties/PublishProfiles/Release.pubxml
  PROJECT: ProGlass Automation
  MODULE: Installer pipeline — dotnet publish profile

  Used by both:
    • tools/build-installer.ps1  (local build on a Windows dev box)
    • .github/workflows/release.yml (the vpk-pack job in CI)

  The profile produces a SELF-CONTAINED win-x64 output that:
    - bundles the .NET 8 desktop runtime (no customer-side install),
    - is single-file-per-assembly (matches Velopack's delta expectations),
    - carries the authoritative <Version> from ProGlassAutomation.csproj,
    - keeps PDBs out of the installer (they ship separately as symbols).

  Run it directly with:
    dotnet publish ProGlassAutomation.csproj -c Release ^
        -r win-x64 --self-contained true ^
        -p:PublishProfile=Release ^
        -p:PublishDir=publish\

  The Version-prefix defaults to nothing; CI overrides via
  -p:Version=2.0.1 to bump the assembly identity on a tag.
  ════════════════════════════════════════════════════════════════════
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>AnyCPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <NoWarn>$(NoWarn);NU1603;NU1605;CA1515;CA1305</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      ContinuousIntegrationBuild keeps the deterministic-build flags on
      during publish, so the hash reported by Velopack is reproducible
      byte-for-byte from the same inputs.
    -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!--
      PublishDir points at the folder vpk pack reads with --packDir.
      The build script and the CI workflow both rely on this exact
      relative path; do not rename without updating both.
    -->
    <PublishDir>publish\</PublishDir>
  </PropertyGroup>
</Project>
