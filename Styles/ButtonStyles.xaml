<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Styles/ButtonStyles.xaml
     PROJECT: ProGlassAutomation
     PURPOSE: Centralized button design system.
              Every button in every view uses one of these 5 styles.
              To change how ALL buttons look, edit this file only.

     STYLES PROVIDED:
       • PrimaryPillButton    — solid indigo, main actions
       • SuccessPillButton    — solid green, export/confirm
       • OutlinedPillButton   — white bg + indigo border, secondary
       • DangerButton         — red outlined, delete/deactivate
       • TabPillButton        — nav tabs (alias of OutlinedPillButton)

     USAGE (in any view):
       <Button Style="{StaticResource PrimaryPillButton}"
               Command="{Binding SaveCommand}"
               Tag="&#xE74E;"
               Content="SAVE"
               ToolTip="Save the current record"/>

       - Tag holds the Segoe MDL2 glyph code (icon)
       - Content holds the UPPERCASE label text
       - Icon renders left, text renders right, auto-centered
       - Omit Tag for text-only buttons
═══════════════════════════════════════════════════════════════════ -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared base -->
    <Style x:Key="PillButtonBase" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="MinWidth" Value="{DynamicResource DensityButtonMinWidth}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- VARIANT 1 — PrimaryPillButton -->
    <Style x:Key="PrimaryPillButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="{DynamicResource DensityButtonHeight}"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{DynamicResource AccentBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="Icon"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextBodyLarge}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.FontSize="{StaticResource TextBody}"
                                              TextElement.FontWeight="Bold"
                                              TextElement.Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource OnAccentForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- VARIANT 2 — SuccessPillButton -->
    <Style x:Key="SuccessPillButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="{DynamicResource DensityButtonHeight}"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{DynamicResource SuccessBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="Icon"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextBodyLarge}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.FontSize="{StaticResource TextBody}"
                                              TextElement.FontWeight="Bold"
                                              TextElement.Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- VARIANT 3 — OutlinedPillButton -->
    <Style x:Key="OutlinedPillButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="{DynamicResource DensityButtonHeight}"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{DynamicResource ModuleBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="Icon"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextBodyLarge}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.FontSize="{StaticResource TextBody}"
                                              TextElement.FontWeight="Bold"
                                              TextElement.Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- VARIANT 4 — DangerButton -->
    <Style x:Key="DangerButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinWidth" Value="92"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="Icon"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.FontSize="{StaticResource TextBody}"
                                              TextElement.FontWeight="Bold"
                                              TextElement.Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TintRedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TintRedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- VARIANT 5 — TabPillButton (alias of OutlinedPillButton for semantics) -->
    <Style x:Key="TabPillButton" TargetType="Button"
           BasedOn="{StaticResource OutlinedPillButton}"/>


    <!-- ═════════════════════════════════════════════════════════════
         COMPACT ROW VARIANTS (extension per spec "HOW TO EXTEND")
         Unified rectangle family (R8, H26) for in-row actions so all
         row buttons share ONE shape language. Colors per role.
    ════════════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="RowButtonTemplate" TargetType="Button">
        <Border x:Name="Bg"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Padding="{TemplateBinding Padding}"
                Height="{TemplateBinding Height}"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Tag}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="{StaticResource TextCaption}"
                           Foreground="{TemplateBinding Foreground}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ContentPresenter VerticalAlignment="Center"
                                  TextElement.FontSize="{StaticResource TextCaption}"
                                  TextElement.FontWeight="Bold"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="White"/>
                <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="RowSuccessButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinWidth" Value="46"/>
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template" Value="{StaticResource RowButtonTemplate}"/>
    </Style>

    <Style x:Key="RowPrimaryButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinWidth" Value="46"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template" Value="{StaticResource RowButtonTemplate}"/>
    </Style>

    <Style x:Key="RowOutlinedButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinWidth" Value="46"/>
        <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template" Value="{StaticResource RowButtonTemplate}"/>
    </Style>

    <Style x:Key="RowDangerButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Template" Value="{StaticResource RowButtonTemplate}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         REPORT TOOLBAR BUTTONS — single source of truth for the
         Reports module's filter / export / pagination chrome.
         One size (32px actions, 30px pagination), one spacing rhythm
         (6px between toolbar buttons, 8px between pagination buttons),
         so every report screen looks professionally consistent.
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- Apply — the primary filter action -->
    <Style x:Key="ReportToolbarPrimaryButton" TargetType="Button"
           BasedOn="{StaticResource RowPrimaryButton}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinWidth" Value="76"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- Clear — secondary filter action -->
    <Style x:Key="ReportToolbarOutlinedButton" TargetType="Button"
           BasedOn="{StaticResource RowOutlinedButton}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinWidth" Value="76"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- Export CSV / Excel -->
    <Style x:Key="ReportExportOutlinedButton" TargetType="Button"
           BasedOn="{StaticResource RowOutlinedButton}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- Export PDF — the primary export action -->
    <Style x:Key="ReportExportPrimaryButton" TargetType="Button"
           BasedOn="{StaticResource PrimaryPillButton}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinWidth" Value="64"/>
    </Style>

    <!-- Pagination Prev / Next -->
    <Style x:Key="ReportPaginationButton" TargetType="Button"
           BasedOn="{StaticResource RowOutlinedButton}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- Retry on the error state -->
    <Style x:Key="ReportRetryButton" TargetType="Button"
           BasedOn="{StaticResource RowPrimaryButton}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="MinWidth" Value="88"/>
    </Style>

</ResourceDictionary>
