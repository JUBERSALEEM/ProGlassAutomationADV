<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Styles/ButtonStyles.xaml
     PROJECT: ProGlassAutomation
     PURPOSE: Centralized button design system — Liquid Glass (2026-08-29).
              Every button in every view uses one of these styles.
              All materials resolve to the canonical reference
              (Themes/Styles/LiquidGlassDesign.xaml): frosted glass
              fills, white top glare, glass shadows, press squish.

     STYLES PROVIDED:
       • PrimaryPillButton    — blue liquid glass, main actions
       • SuccessPillButton    — green liquid glass, export/confirm
       • OutlinedPillButton   — frosted glass, secondary
       • DangerButton         — frosted glass + red edge
       • TabPillButton        — nav tabs (alias of OutlinedPillButton)
       • Row* compact variants + Report toolbar variants

     USAGE (unchanged):
       <Button Style="{StaticResource PrimaryPillButton}"
               Command="{Binding SaveCommand}"
               Tag="&#xE74E;" Content="SAVE"/>
═══════════════════════════════════════════════════════════════════ -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared base -->
    <Style x:Key="PillButtonBase" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="MinWidth" Value="{DynamicResource DensityButtonMinWidth}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Shared glass template with Tag-glyph + label, press squish and
         white top glare — the reference button look, icon-aware. -->
    <ControlTemplate x:Key="GlassPillButtonTemplate" TargetType="Button">
        <Grid x:Name="RootGrid">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5"/>
            </Grid.RenderTransform>
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    Height="{TemplateBinding Height}"
                    Effect="{DynamicResource GlassShadowSoftBorder}"
                    SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="Icon"
                               Text="{TemplateBinding Tag}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextBodyLarge}"
                               Foreground="{TemplateBinding Foreground}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ContentPresenter VerticalAlignment="Center"
                                      TextElement.FontSize="{StaticResource TextBody}"
                                      TextElement.FontWeight="Bold"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                </StackPanel>
            </Border>
            <!-- white top highlight: the frosted glass catch-light -->
            <Border x:Name="Glare"
                    Height="12"
                    CornerRadius="12,12,0,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource GlassTopReflection}"
                    Opacity="0.55"
                    Margin="1,1,1,0"
                    IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassSurfaceElevated}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.96" Duration="0:0:0.05"/>
                            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.96" Duration="0:0:0.05"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.05"/>
                            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.05"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GlassBorderBright}"/>
                <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- VARIANT 1 — PrimaryPillButton: blue liquid glass -->
    <Style x:Key="PrimaryPillButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="{DynamicResource DensityButtonHeight}"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource GlassGradientActive}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBright}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template" Value="{StaticResource GlassPillButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.96"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- VARIANT 2 — SuccessPillButton: green liquid glass -->
    <Style x:Key="SuccessPillButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="{DynamicResource DensityButtonHeight}"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource GlassGradientActive}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBright}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template" Value="{StaticResource GlassPillButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.9"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- VARIANT 3 — OutlinedPillButton: frosted glass -->
    <Style x:Key="OutlinedPillButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="{DynamicResource DensityButtonHeight}"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GlassGradientIdle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template" Value="{StaticResource GlassPillButtonTemplate}"/>
    </Style>

    <!-- VARIANT 4 — DangerButton: frosted glass + red edge -->
    <Style x:Key="DangerButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinWidth" Value="92"/>
        <Setter Property="Foreground" Value="{DynamicResource GlassDangerBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GlassGradientIdle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassDangerBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template" Value="{StaticResource GlassPillButtonTemplate}"/>
    </Style>

    <!-- VARIANT 5 — TabPillButton (alias of OutlinedPillButton for semantics) -->
    <Style x:Key="TabPillButton" TargetType="Button"
           BasedOn="{StaticResource OutlinedPillButton}"/>


    <!-- ═════════════════════════════════════════════════════════════
         COMPACT ROW VARIANTS — one glass shape (corner radius from the
         theme), colours per role, top glare retained.
    ════════════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="RowButtonTemplate" TargetType="Button">
        <Grid x:Name="RootGrid">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5"/>
            </Grid.RenderTransform>
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    Height="{TemplateBinding Height}"
                    Effect="{DynamicResource GlassShadowSoftBorder}"
                    SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="{TemplateBinding Tag}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextCaption}"
                               Foreground="{TemplateBinding Foreground}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ContentPresenter VerticalAlignment="Center"
                                      TextElement.FontSize="{StaticResource TextCaption}"
                                      TextElement.FontWeight="Bold"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                </StackPanel>
            </Border>
            <Border Height="8" CornerRadius="8,8,0,0" VerticalAlignment="Top"
                    Background="{DynamicResource GlassTopReflection}"
                    Opacity="0.5" Margin="1,1,1,0" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassSurfaceElevated}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.96" Duration="0:0:0.05"/>
                            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.96" Duration="0:0:0.05"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.05"/>
                            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.05"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GlassBorderBright}"/>
                <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="RowSuccessButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinWidth" Value="46"/>
        <Setter Property="Background" Value="{DynamicResource GlassGradientActive}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBright}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template" Value="{StaticResource RowButtonTemplate}"/>
    </Style>

    <Style x:Key="RowPrimaryButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinWidth" Value="46"/>
        <Setter Property="Background" Value="{DynamicResource GlassGradientActive}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBright}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template" Value="{StaticResource RowButtonTemplate}"/>
    </Style>

    <Style x:Key="RowOutlinedButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinWidth" Value="46"/>
        <Setter Property="Background" Value="{DynamicResource GlassGradientIdle}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template" Value="{StaticResource RowButtonTemplate}"/>
    </Style>

    <Style x:Key="RowDangerButton" TargetType="Button"
           BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Background" Value="{DynamicResource GlassGradientIdle}"/>
        <Setter Property="Foreground" Value="{DynamicResource GlassDangerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassDangerBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template" Value="{StaticResource RowButtonTemplate}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         REPORT TOOLBAR BUTTONS — glass, one size, one spacing rhythm.
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- Apply — the primary filter action -->
    <Style x:Key="ReportToolbarPrimaryButton" TargetType="Button"
           BasedOn="{StaticResource RowPrimaryButton}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinWidth" Value="76"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- Clear — secondary filter action -->
    <Style x:Key="ReportToolbarOutlinedButton" TargetType="Button"
           BasedOn="{StaticResource RowOutlinedButton}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinWidth" Value="76"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- Export CSV / Excel -->
    <Style x:Key="ReportExportOutlinedButton" TargetType="Button"
           BasedOn="{StaticResource RowOutlinedButton}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- Export PDF — the primary export action -->
    <Style x:Key="ReportExportPrimaryButton" TargetType="Button"
           BasedOn="{StaticResource PrimaryPillButton}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinWidth" Value="64"/>
    </Style>

    <!-- Pagination Prev / Next -->
    <Style x:Key="ReportPaginationButton" TargetType="Button"
           BasedOn="{StaticResource RowOutlinedButton}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- Retry on the error state -->
    <Style x:Key="ReportRetryButton" TargetType="Button"
           BasedOn="{StaticResource RowPrimaryButton}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="MinWidth" Value="88"/>
    </Style>

</ResourceDictionary>
