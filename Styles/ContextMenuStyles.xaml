<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ═══════════════════════════════════════════════════════════════════
         MODERN CONTEXT MENU — shared professional look for every module's
         right-click menu (Proforma, Job Order, Delivery Note, Tax Invoice).

         Design:
           • Rounded card (radius 12) with a theme surface + border + soft
             shadow, so it reads as a floating panel, not the OS default.
           • MenuItem hover = accent-tinted rounded highlight; a thin accent
             keyline appears on the left when hovered.
           • Slightly larger, comfortable hit targets and Segoe UI type.
           • A sub-menu marker is drawn with the MDL2 chevron.
         All colours resolve through DynamicResource so Light/Dark/Monet/
         Professional all work.
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── ContextMenu ─────────────────────────────────────────────────── -->
    <Style x:Key="ModernContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="6"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4"
                                              Direction="270" Opacity="0.25"
                                              Color="#000000"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── MenuItem (root + sub) ───────────────────────────────────────── -->
    <Style x:Key="ModernMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Margin" Value="2,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid x:Name="Root" Background="Transparent">
                        <!-- Accent keyline (shown on hover / open / selected) -->
                        <Border x:Name="Keyline"
                                Width="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Margin="0,4"
                                CornerRadius="1.5"
                                Background="{DynamicResource AccentBrush}"
                                Opacity="0"/>
                        <!-- Item chrome -->
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="4,2"
                                Margin="3,0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Content"
                                                  Grid.Column="0"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <!-- Sub-menu chevron -->
                                <TextBlock x:Name="SubChevron"
                                           Grid.Column="1"
                                           Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextXSmall}"
                                           Margin="16,0,4,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <!-- Sub-menu popup (required or child items never open) -->
                        <Popup IsOpen="{TemplateBinding IsSubmenuOpen}"
                               Placement="Right"
                               HorizontalOffset="-4"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    Padding="6"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4"
                                                      Direction="270" Opacity="0.22"
                                                      Color="#000000"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubChevron" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            <Setter TargetName="Keyline" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            <Setter TargetName="Keyline" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="SubChevron" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── MenuItem checkable (used for status/priority lists) ─────────── -->
    <Style x:Key="ModernCheckableMenuItemStyle"
           TargetType="MenuItem"
           BasedOn="{StaticResource ModernMenuItemStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Keyline"
                                Width="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Margin="0,4"
                                CornerRadius="1.5"
                                Background="{DynamicResource AccentBrush}"
                                Opacity="0"/>
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="4,2"
                                Margin="3,0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Check mark -->
                                <TextBlock x:Name="Check"
                                           Grid.Column="0"
                                           Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextBody}"
                                           Width="18"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Visibility="Hidden"/>
                                <ContentPresenter x:Name="Content"
                                                  Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <TextBlock x:Name="SubChevron"
                                           Grid.Column="2"
                                           Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextXSmall}"
                                           Margin="16,0,4,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <!-- Sub-menu popup (required or child items never open) -->
                        <Popup IsOpen="{TemplateBinding IsSubmenuOpen}"
                               Placement="Right"
                               HorizontalOffset="-4"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    Padding="6"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4"
                                                      Direction="270" Opacity="0.22"
                                                      Color="#000000"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubChevron" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            <Setter TargetName="Keyline" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Separator ───────────────────────────────────────────────────── -->
    <Style x:Key="ModernMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="10,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Margin="10,5"
                            Background="{DynamicResource OutlineBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
