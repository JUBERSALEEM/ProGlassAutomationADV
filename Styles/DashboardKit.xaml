<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Styles/DashboardKit.xaml
     PROJECT: ProGlassAutomation

     THE DASHBOARD GRAMMAR — one language for all seven dashboards.

     WHY THIS FILE EXISTS
     ────────────────────
     Styles/DashboardStyles.xaml had grown three stacked generations of
     dashboard design language: Dash* (Phase 8), Soft* (soft-glass pass)
     and IndustrialDashboard* (2026 pass). The result was that the seven
     dashboards did not agree with each other:

         4 card styles        DashCardStyle / CardStyle / SoftCardStyle
                              / IndustrialDashboardCardStyle
         4 KPI templates      DashKpiTileTemplate / KpiTemplate
                              / SoftKpiCardTemplate / SoftKpiTileTemplate
         3 page paddings      DashPagePadding / SoftPagePadding
                              / IndustrialDashboardPageMargin
         2 type scales        DashFont* (6 keys) / SoftFont* (8 keys)

     Each page picked a different subset, so switching tabs changed the
     page margin, the card weight, the KPI tile shape AND the type scale.
     That — not any single screen being badly drawn — is what made the
     dashboard set read as unfinished.

     This file replaces all of it with ONE grammar. Every key is prefixed
     Db so there is no ambiguity about which language a page is speaking:
     a page either uses Db* everywhere or it is not on the grammar.

     THE CONTRACT EVERY PAGE FOLLOWS
     ───────────────────────────────
         row 0   DbHero            title · subtitle · live chip · stamp
         row 1   DbStateBand       loading / error (both, always present)
         row 2   DbKpiBand         UniformGrid of DbKpiTileTemplate
         row 3   primary visual    DbChartWellStyle + chart control
         row 4   detail            DbRowCardStyle feed or table

     All four states — loading, error, empty, data — exist on every page.
     A page that can show data must also be able to say "there is none
     yet" instead of rendering an empty card, which is what made several
     dashboards look broken rather than merely unfilled.

     RULES THIS FILE ENFORCES
     ────────────────────────
       • One type scale: the app's Text* tokens only. No DashFont*, no
         SoftFont*, no literal FontSize anywhere in a dashboard page.
       • One card: DbCardStyle, on SurfacePrimaryStyle.
       • One KPI tile: DbKpiTileTemplate, serving BOTH Kpi models (see
         KpiTileModel, which now exposes Title/SubLabel/BadgeColor as
         aliases so one template covers both POCOs).
       • Every colour is a DynamicResource, so Light/Dark swaps live.
       • No cross-system leaks: the previous feed row borrowed
         GlassBorderGradientCrystal from the Crystal design system, so a
         "soft/industrial" card had a crystal edge. Gone.
═══════════════════════════════════════════════════════════════════════ -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════════
         1 · SPATIAL RHYTHM
         One page margin, one card padding, one gutter. Every gap on a
         dashboard page is one of these three numbers or a multiple of
         the gutter, which is what makes the seven pages align.
    ═══════════════════════════════════════════════════════════════ -->
    <Thickness x:Key="DbPageMargin">20,16,20,20</Thickness>
    <Thickness x:Key="DbCardPadding">18,16</Thickness>
    <Thickness x:Key="DbTilePadding">14,13</Thickness>
    <sys:Double x:Key="DbGutter">14</sys:Double>
    <!--
      A Thickness, NOT a sys:Double. Margin is a Thickness property, and WPF
      does not type-convert the result of a StaticResource lookup — assigning a
      Double to it throws at measure time, not at parse time:

          InvalidOperationException: '7' is not a valid value for
          property 'Margin'

      That was a real crash (ERR-F4C120, 2026-09-09): DbKpiBandStyle set a
      ContentPresenter Margin from a Double token, so every dashboard carrying a
      KPI band took the app down during layout, after sign-in and after the
      VAT figures had already loaded. The value 7 in the message was this token.

      Kept as a separate token from DbGutter above because the two have
      different types for different consumers: DbGutter is a scalar rhythm unit
      for widths and offsets, this one is a margin. Tests/Theme/
      ResourceTokenTypeTests.cs fails the build if any typed Setter is fed a
      resource of the wrong type, which is the check that was missing.
    -->
    <Thickness x:Key="DbGutterHalfMargin">7</Thickness>
    <sys:Double x:Key="DbKpiTileMinHeight">100</sys:Double>
    <sys:Double x:Key="DbChartMinHeight">212</sys:Double>

    <!-- ═══════════════════════════════════════════════════════════════
         2 · TYPE
         Every text role on a dashboard has exactly one style. Font sizes
         come from the shared Text* tokens so the dashboards scale with
         the app's typography settings instead of fighting them.
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="DbTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextTitleLarge}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="DbSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="DbSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSubhead}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="DbSectionSubStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="DbMetaStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DbKpiLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="MaxHeight" Value="30"/>
    </Style>

    <Style x:Key="DbKpiValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextDisplay}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <Style x:Key="DbKpiFootStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextXSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="DbGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="{StaticResource TextSection}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         3 · SURFACES
         One card, one tile, one chart well, one row. Nothing else is
         allowed to draw a box on a dashboard.
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="DbCardStyle" TargetType="Border"
           BasedOn="{StaticResource SurfacePrimaryStyle}">
        <Setter Property="Padding" Value="{DynamicResource DbCardPadding}"/>
        <!-- Inherit Surface.Primary.CornerRadius from Appearance. Do not
             re-set CardCornerRadius here — that froze the slider. -->
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- The KPI tile sits inside a card, so it is inset rather than
         elevated: flat surface, hairline edge, no shadow. Stacking two
         shadows (card + tile) is what made the old tiles look muddy. -->
    <Style x:Key="DbTileStyle" TargetType="Border"
           BasedOn="{StaticResource SurfaceDetailStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.HairlineThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Surface.Primary.CornerRadius}"/>
        <Setter Property="Padding" Value="{DynamicResource DbTilePadding}"/>
        <Setter Property="MinHeight" Value="{DynamicResource DbKpiTileMinHeight}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
    </Style>

    <Style x:Key="DbChartWellStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.HairlineThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Surface.Primary.CornerRadius}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="MinHeight" Value="{DynamicResource DbChartMinHeight}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="DbRowCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.HairlineThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Surface.Primary.CornerRadius}"/>
        <Setter Property="Padding" Value="13,11"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="DbSectionHeadStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         4 · CHIPS, BADGES, PILLS
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="DbChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.HairlineThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Surface.Primary.CornerRadius}"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DbBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Surface.Primary.CornerRadius}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="DbPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TintGrayBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Surface.Primary.CornerRadius}"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="DbPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextXSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
    </Style>

    <!-- ── action buttons ──────────────────────────────────────────────
         Tag carries an optional MDL2 glyph; when empty the glyph
         collapses so a text-only pill has no phantom gap. -->
    <Style x:Key="DbActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Surface.Primary.CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="Glyph"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.84"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DbActionButtonAccentStyle" TargetType="Button"
           BasedOn="{StaticResource DbActionButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         5 · THE ONE KPI TILE

         Serves BOTH KPI models. KpiTileModel now exposes Title, SubLabel
         and BadgeColor as aliases over its own Label / Accent, so this
         single template renders Overview and Tax Invoice (KpiTileModel)
         and Sheet Store / PI / JO / DN / Statement (KpiCardModel) with
         identical geometry. Previously that split forced two templates
         with different margins, which is why the KPI bands did not line
         up between tabs.

         The value is wrapped in a Viewbox with StretchDirection=DownOnly:
         a short count renders at the full 24px, while a long currency
         value scales DOWN to fit instead of clipping. Money on a
         dashboard must never be truncated.
    ═══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="DbKpiTileTemplate">
        <Border Style="{StaticResource DbTileStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- label row, with the colour-coded badge glyph to the
                     right; the label is inset so it cannot run under it -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title}"
                               Style="{StaticResource DbKpiLabelStyle}"/>
                    <Border Grid.Column="1"
                            Style="{StaticResource DbBadgeStyle}"
                            Margin="8,0,0,0"
                            Background="{Binding BadgeColor,
                                         Converter={StaticResource BrushKeyConverter}}">
                        <TextBlock Text="{Binding Icon}"
                                   Style="{StaticResource DbGlyphStyle}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    </Border>
                </Grid>

                <Viewbox Grid.Row="1"
                         HorizontalAlignment="Left"
                         Stretch="Uniform"
                         StretchDirection="DownOnly"
                         Margin="0,7,0,0">
                    <TextBlock Text="{Binding DisplayValue}"
                               Style="{StaticResource DbKpiValueStyle}"/>
                </Viewbox>

                <TextBlock Grid.Row="2"
                           Text="{Binding SubLabel}"
                           Style="{StaticResource DbKpiFootStyle}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- KPI band host. A 2-row UniformGrid so a 4-tile band reads as a
         2×2 block of legible tiles rather than four thin slivers, and
         the tile margin supplies the gutter. -->
    <ItemsPanelTemplate x:Key="DbKpiBandPanel">
        <UniformGrid Rows="2"/>
    </ItemsPanelTemplate>

    <Style x:Key="DbKpiBandStyle" TargetType="ItemsControl">
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="{DynamicResource DbGutterHalfMargin}"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         6 · THE ONE FEED ROW
         Bound to ActivityFeedItem (Icon, Title, SubTitle, ValueDisplay,
         StatusLabel, StatusColor, TintColor). StatusColor and TintColor
         hold theme brush KEYS, resolved by BrushKeyConverter.
    ═══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="DbFeedRowTemplate">
        <Border Style="{StaticResource DbRowCardStyle}"
                Background="{Binding TintColor,
                             Converter={StaticResource BrushKeyConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="32" Height="32"
                        CornerRadius="{DynamicResource Surface.Primary.CornerRadius}"
                        VerticalAlignment="Top"
                        Margin="0,0,11,0"
                        Background="{Binding StatusColor,
                                     Converter={StaticResource BrushKeyConverter}}">
                    <TextBlock Text="{Binding Icon}"
                               Style="{StaticResource DbGlyphStyle}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Title}"
                               FontSize="{DynamicResource FontSize.Body}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding SubTitle}"
                               FontSize="{DynamicResource FontSize.BodySmall}"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ValueDisplay}"
                               FontSize="{DynamicResource FontSize.Body}"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Border Style="{StaticResource DbPillStyle}"
                            Margin="0,5,0,0"
                            Background="{Binding StatusColor,
                                         Converter={StaticResource BrushKeyConverter}}">
                        <TextBlock Text="{Binding StatusLabel}"
                                   Style="{StaticResource DbPillTextStyle}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <Style x:Key="DbFeedItemsStyle" TargetType="ItemsControl">
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         7 · THE FOUR STATES

         Every dashboard page has all four, in this order, and every page
         presents them the same way. A page that only handled "data"
         rendered a blank card when its table was empty, which reads as a
         crash rather than as an empty store — that was true of Overview,
         which had no empty state at all.
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="DbStateBandStyle" TargetType="Border"
           BasedOn="{StaticResource DbCardStyle}">
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <Style x:Key="DbStateTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
    </Style>

    <Style x:Key="DbErrorTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource DbStateTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <Style x:Key="DbEmptyGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <Style x:Key="DbEmptyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         8 · WORKFLOW PIPELINE (Overview only)

         The order-to-cash spine: Quote → Production → Delivery →
         Invoice → Payment. Rendered as one connected rail of stage
         cards with a connector between them, so the whole book of work
         is readable in a single glance and you can see where it is
         piling up.

         Bound to WorkflowStageModel (Glyph, Name, ValueDisplay, Foot,
         AccentKey, IsActive). AccentKey is a theme brush KEY resolved by
         BrushKeyConverter, so stage colour follows the theme.
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="DbPipelineCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.HairlineThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Surface.Primary.CornerRadius}"/>
        <Setter Property="Padding" Value="13,12"/>
        <Setter Property="MinHeight" Value="96"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- The connector between two stages. A hairline that stops short of
         both cards so the rail reads as a flow, not a table. -->
    <Style x:Key="DbPipelineConnectorStyle" TargetType="Border">
        <Setter Property="Height" Value="2"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="CornerRadius" Value="1"/>
    </Style>

    <Style x:Key="DbPipelineNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="9,0,0,0"/>
    </Style>

    <Style x:Key="DbPipelineValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextTitleLarge}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,7,0,0"/>
    </Style>

    <Style x:Key="DbPipelineFootStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextXSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- One stage. The connector column is a fixed width in EVERY cell and
         only the line inside it is collapsed for the first stage, so all
         five cards stay exactly the same width — collapsing the column
         itself would make the first card wider than the rest and the rail
         would stop reading as a flow. -->
    <DataTemplate x:Key="DbPipelineStageTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource DbPipelineConnectorStyle}"
                    Visibility="{Binding IsFirst,
                                 Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

            <Border Grid.Column="1" Style="{StaticResource DbPipelineCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26"
                                CornerRadius="{DynamicResource Surface.Primary.CornerRadius}"
                                VerticalAlignment="Center"
                                Background="{Binding AccentKey,
                                             Converter={StaticResource BrushKeyConverter}}">
                            <TextBlock Text="{Binding Glyph}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding Name}"
                                   Style="{StaticResource DbPipelineNameStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ValueDisplay}"
                               Style="{StaticResource DbPipelineValueStyle}"/>
                    <TextBlock Text="{Binding Foot}"
                               Style="{StaticResource DbPipelineFootStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- RESPONSIVE PIPELINE (2026-09-13): WrapPanel lets 5 stage cards flow
         to 2 rows on narrow screens. Each presenter has MinWidth 160 so
         cards never become unreadable. The ItemsControl template wraps the
         presenter in a horizontal ScrollViewer as fallback, so the rail
         scrolls instead of clipping on <900px widths. -->
    <ItemsPanelTemplate x:Key="DbPipelinePanel">
        <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
    </ItemsPanelTemplate>

    <ItemsPanelTemplate x:Key="DbPipelinePanelUniform">
        <UniformGrid Columns="5"/>
    </ItemsPanelTemplate>

    <Style x:Key="DbPipelineItemsStyle" TargetType="ItemsControl">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="MinWidth" Value="160"/>
                    <Setter Property="Margin" Value="0,0,8,8"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  PanningMode="HorizontalOnly"
                                  Focusable="False">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SKELETON variant of the pipeline band. The loading band hosts
         explicit <ContentControl> children instead of a bound ItemsSource;
         a UIElement item is its OWN container (ItemsControl uses the item
         directly), so the container style must target ContentControl —
         targeting the generated ContentPresenter throws
         "A style intended for type X cannot be applied to type Y". -->
    <Style x:Key="DbPipelineSkeletonItemsStyle" TargetType="ItemsControl"
           BasedOn="{StaticResource DbPipelineItemsStyle}">
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentControl">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="MinWidth" Value="160"/>
                    <Setter Property="Margin" Value="0,0,8,8"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════════════════════════════════════════════
         9 · SKELETON LOADING (2026-09-13)

         Shimmer-free skeleton that works in Light/Dark and respects
         Surface.Primary.CornerRadius. Used when IsLoading=true instead
         of plain text. Each dashboard shows:
           • KPI band skeleton (4 tiles with blocks)
           • Chart well skeleton (bars)
           • Feed row skeleton (avatar + lines)

         Animation is a simple opacity pulse (0.35→0.75, 0.9s) — no
         custom shader, no extra NuGet, pure WPF storyboard. Respects
         ReducedMotion via Opacity only (no translation).
    ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="DbSkeletonBlockStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Opacity" Value="0.55"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0.35" To="0.75" Duration="0:0:0.9">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DbSkeletonCircleStyle" TargetType="Border"
           BasedOn="{StaticResource DbSkeletonBlockStyle}">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
    </Style>

    <Style x:Key="DbSkeletonCardStyle" TargetType="Border"
           BasedOn="{StaticResource DbCardStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    <!-- KPI tile skeleton -->
    <DataTemplate x:Key="DbSkeletonKpiTileTemplate">
        <Border Style="{StaticResource DbTileStyle}" Opacity="0.95">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="12" Width="72" HorizontalAlignment="Left"/>
                    <Border Grid.Column="1" Style="{StaticResource DbSkeletonCircleStyle}" Width="28" Height="28"/>
                </Grid>
                <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="22" Width="88" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="120" Margin="0,10,0,0" HorizontalAlignment="Left" Opacity="0.4"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="DbSkeletonKpiBandPanel">
        <UniformGrid Rows="2"/>
    </ItemsPanelTemplate>

    <Style x:Key="DbSkeletonKpiBandStyle" TargetType="ItemsControl"
           BasedOn="{StaticResource DbKpiBandStyle}"/>

    <!-- Chart well skeleton -->
    <DataTemplate x:Key="DbSkeletonChartTemplate">
        <Border Style="{StaticResource DbChartWellStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid VerticalAlignment="Bottom" Height="120">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource DbSkeletonBlockStyle}" Width="22" Height="40" VerticalAlignment="Bottom" Margin="0,0,6,0"/>
                    <Border Grid.Column="1" Style="{StaticResource DbSkeletonBlockStyle}" Width="22" Height="72" VerticalAlignment="Bottom" Margin="0,0,6,0"/>
                    <Border Grid.Column="2" Style="{StaticResource DbSkeletonBlockStyle}" Width="22" Height="56" VerticalAlignment="Bottom" Margin="0,0,6,0"/>
                    <Border Grid.Column="3" Style="{StaticResource DbSkeletonBlockStyle}" Width="22" Height="90" VerticalAlignment="Bottom" Margin="0,0,6,0"/>
                    <Border Grid.Column="4" Style="{StaticResource DbSkeletonBlockStyle}" Width="22" Height="64" VerticalAlignment="Bottom" Margin="0,0,6,0"/>
                    <Border Grid.Column="5" Style="{StaticResource DbSkeletonBlockStyle}" Width="22" Height="100" VerticalAlignment="Bottom"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="8" Width="48" Margin="0,0,12,0"/>
                    <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="8" Width="48" Margin="0,0,12,0"/>
                    <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="8" Width="48"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Feed row skeleton -->
    <DataTemplate x:Key="DbSkeletonFeedRowTemplate">
        <Border Style="{StaticResource DbRowCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource DbSkeletonCircleStyle}" Margin="0,0,11,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="13" Width="140" HorizontalAlignment="Left"/>
                    <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="180" Margin="0,6,0,0" HorizontalAlignment="Left" Opacity="0.5"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="13" Width="56" HorizontalAlignment="Right"/>
                    <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="16" Width="48" Margin="0,6,0,0" HorizontalAlignment="Right" CornerRadius="{DynamicResource Surface.Primary.CornerRadius}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Pipeline stage skeleton -->
    <DataTemplate x:Key="DbSkeletonPipelineStageTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource DbPipelineConnectorStyle}" Opacity="0.3"/>
            <Border Grid.Column="1" Style="{StaticResource DbPipelineCardStyle}" MinWidth="140">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" Style="{StaticResource DbSkeletonCircleStyle}"/>
                        <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="11" Width="64" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="18" Width="72" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                    <Border Style="{StaticResource DbSkeletonBlockStyle}" Height="10" Width="96" Margin="0,6,0,0" HorizontalAlignment="Left" Opacity="0.5"/>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Full dashboard skeleton container -->
    <Style x:Key="DbSkeletonBandStyle" TargetType="Border" BasedOn="{StaticResource DbCardStyle}">
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

</ResourceDictionary>
