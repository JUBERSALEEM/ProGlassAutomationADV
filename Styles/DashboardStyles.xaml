<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Styles/DashboardStyles.xaml
     PROJECT: ProGlassAutomation

     MERIDIAN PHASE 7 — RETIRED, 2026-09-18
     ───────────────────────────────────────
     This file was the 2026 dashboard kit (Dash*/Soft*/Industrial*
     grammar) for the 7 module dashboards. Every dashboard has since
     been rewritten on the MERIDIAN design system
     (Themes/Professional/ProfessionalCore.xaml — Pg* grammar), and
     every dead key was deleted from here.

     What remains, and why it stays:
       • SectionTitle   — consumed by Views/Reports/OrderReport/
                          Review/ReviewStep.xaml
       • SoftCardStyle  — consumed by Controls/Reporting/MixPanel.xaml,
                          Views/Reports/DeliveryReport/DeliveryReportView.xaml,
                          Views/Specifications/SpecificationsCenterView.xaml
       • DashFontLabel / SoftCardPadding — private support tokens for
        the two survivors above.

     When those three non-dashboard consumers migrate to Pg* grammar,
     this file and its App.xaml merge can be deleted outright.
═══════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Support token for SectionTitle (label rank of the old type scale). -->
    <sys:Double x:Key="DashFontLabel">11</sys:Double>

    <!-- Support token for SoftCardStyle. -->
    <Thickness x:Key="SoftCardPadding">20</Thickness>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DashFontLabel}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource DashAccentTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="6,14,6,6"/>
    </Style>

    <Style x:Key="SoftCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
        <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
        <Setter Property="Padding" Value="{StaticResource SoftCardPadding}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect" Value="{StaticResource ShadowSoft}"/>
    </Style>

</ResourceDictionary>
