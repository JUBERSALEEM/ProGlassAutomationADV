<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Styles/DashboardStyles.xaml
     PROJECT: ProGlassAutomation

     2026 SaaS DASHBOARD DESIGN SYSTEM — single source of truth for all
     7 module dashboards (Overview, Sheet Store, Proforma, Job Order,
     Delivery Note, Tax Invoice, Statement).

     ═══════════════════════════════════════════════════════════════
     SENIOR UI/UX ANALYSIS — what was wrong and what this fixes
     ═══════════════════════════════════════════════════════════════

     1. NO TYPE SCALE.
        The dashboards used 14 different font sizes (9,10,11,12,13,14,
        15,16,18,19,20,22,36,48) chosen ad hoc. Nothing established
        rank, so everything competed and the page read as noise.
        FIX: a 6-step scale below. Nothing outside it.

     2. DUPLICATED, DRIFTING CHROME.
        CardStyle / SectionTitle / SectionSubtitle / KpiTemplate were
        redefined independently in 5 view files. They had already
        diverged (SheetStore's CardStyle grew an extra Effect). Any
        design change meant editing five places and missing one.
        FIX: defined once here; the views consume, never redeclare.

     3. CARDS TOO HEAVY FOR THE DATA.
        CornerRadius=16, Padding=24, Margin=8 on every card. On a
        1366px screen that is ~30% of the surface spent on padding and
        rounding. The earlier compaction pass missed these because
        they live in per-file local styles, not the shared dictionary.
        FIX: radius 10, padding 14,12, margin 5 — dense but breathable.

     4. EMOJI AS UI FURNITURE.
        25 emoji remained in the views (48px empty-state glyphs) plus
        one in a ViewModel. Emoji render through a colour font, ignore
        Foreground, and look like clip-art next to real UI. House rule
        is Segoe MDL2 Assets only.
        FIX: MDL2 throughout; DashGlyphStyle hard-sets the FontFamily
        so no view can smuggle an emoji back in through a binding.

     5. FLAT HIERARCHY INSIDE KPI CARDS.
        Label was 13 Bold and the value 19 Bold — nearly equal weight,
        so the eye had nothing to land on. In the reference console the
        NUMBER is unmistakably the subject and the label is a quiet
        caption above it.
        FIX: label 10 SemiBold uppercase muted; value 24 Bold primary.

     THEME CORRECTNESS
     ─────────────────
     Every colour resolves through DynamicResource against keys that
     exist in BOTH Themes/DarkTheme.xaml and Themes/LightTheme.xaml.
     ThemeManager.ApplyTheme swaps the theme dictionary at RUNTIME, so
     StaticResource would freeze a card on whichever theme was active
     at startup — the original "few boxes dynamic, few not" bug.
═══════════════════════════════════════════════════════════════════════ -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════════
         TYPE SCALE — 6 steps. Every dashboard text uses one of these.
         Display  24  the KPI number, the one thing you read first
         Title    15  page / card title
         Body     12  normal text, table cells
         Label    11  secondary text
         Caption  10  muted metadata, uppercase section labels
         Micro     9  pill text, axis ticks
    ═══════════════════════════════════════════════════════════════ -->
    <sys:Double x:Key="DashFontDisplay">24</sys:Double>
    <sys:Double x:Key="DashFontTitle">15</sys:Double>
    <sys:Double x:Key="DashFontBody">12</sys:Double>
    <sys:Double x:Key="DashFontLabel">11</sys:Double>
    <sys:Double x:Key="DashFontCaption">10</sys:Double>
    <sys:Double x:Key="DashFontMicro">9</sys:Double>

    <!-- SPACING SCALE — 4px base grid. -->
    <Thickness x:Key="DashCardPadding">14,12</Thickness>
    <Thickness x:Key="DashCardMargin">5</Thickness>
    <Thickness x:Key="DashPagePadding">14,12,14,14</Thickness>

    <!-- Radii are now sourced from the theme tokens ControlCornerRadius /
         CardCornerRadius / CardCornerRadiusLarge so every dashboard respects
         the global radius slider (formerly StaticResource DashCardRadius=10,
         DashTileRadius=8, DashPillRadius=6 — retired in the Phase-3 pass). -->

    <!-- ═══════════════════════════════════════════════════════════════
         SURFACES
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Primary card. DashLiquid* are defined in both themes
         (#FFFFFF light / #273449 dark) so one style serves both. -->
    <Style x:Key="DashCardStyle" TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource GlassUltraClearBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource GlassBorderGradientCrystal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource DashCardPadding}"/>
        <Setter Property="Margin" Value="{StaticResource DashCardMargin}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Alias kept so the six module dashboards can drop their local
         copies without renaming every consumer in the markup. -->
    <Style x:Key="CardStyle" TargetType="Border"
           BasedOn="{StaticResource DashCardStyle}"/>

    <!-- Inner tile: sits inside a card, one step more elevated. -->
    <Style x:Key="DashTileStyle" TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource GlassUltraClearBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderGradientCrystal}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    

    <!-- ═══════════════════════════════════════════════════════════════
         TYPOGRAPHY
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Page title — one per dashboard, top-left. -->
    <Style x:Key="DashPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DashFontTitle}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>

    <!-- Small ALL-CAPS section label. Replaces the old SectionTitle,
         which was a 20px heading competing with the KPI numbers. -->
    <Style x:Key="DashSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DashFontLabel}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource DashAccentTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock"
           BasedOn="{StaticResource DashSectionLabelStyle}">
        <Setter Property="Margin" Value="6,14,6,6"/>
    </Style>

    <Style x:Key="SectionSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DashFontCaption}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="Margin" Value="6,0,6,8"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- The KPI number. Tabular figures stop digits jittering as live
         values refresh, which matters on an auto-updating dashboard. -->
    <Style x:Key="DashKpiValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DashFontDisplay}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Value that turns red when the card is alerting. -->
    <Style x:Key="DashKpiValueAccentStyle" TargetType="TextBlock"
           BasedOn="{StaticResource DashKpiValueStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAlert}" Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource DangerBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Quiet caption ABOVE the number. Uppercase + muted so the value
         dominates; this is the hierarchy fix. -->
    <Style x:Key="DashKpiLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DashFontCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="DashCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DashFontCaption}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="DashBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DashFontBody}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="DashColumnHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DashFontCaption}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- MDL2 glyph. FontFamily is fixed here so no view can pass an
         emoji through a binding and have it render as clip-art. -->
    <Style x:Key="DashGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="{StaticResource DashFontBody}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground"
                Value="{DynamicResource OnAccentForegroundBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         ACCENT SYSTEM

         Colour-coding lives on a 3px rail and a small icon chip, never
         on the card surface. Tinting a whole card with a pale hex is
         what made the old dashboards unreadable in dark theme: the
         tint was a light-only colour. A neutral themed surface plus a
         semantic rail reads correctly in both themes.

         Driven by KpiTileModel.Accent / KpiCardModel.BadgeColor:
         Green | Blue | Amber | Red | (default accent).
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="DashAccentRailStyle" TargetType="Border">
        <Setter Property="Width" Value="3"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Accent}" Value="Green">
                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Blue">
                <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Amber">
                <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Red">
                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAlert}" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DashIconChipStyle" TargetType="Border">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Accent}" Value="Green">
                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Blue">
                <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Amber">
                <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Red">
                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAlert}" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         STATUS PILL
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="DashPillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="Background" Value="{DynamicResource TintGrayBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="DashPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DashFontMicro}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         BUTTONS — dashboard scale (H30), house pill rules otherwise.
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="DashActionButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{DynamicResource GlassSurfaceBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Height="30"
                            Padding="12,0"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextBody}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="{StaticResource TextBody}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource MenuHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DashActionButtonPrimaryStyle" TargetType="Button"
           BasedOn="{StaticResource DashActionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{DynamicResource AccentBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Height="30"
                            Padding="12,0"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextBody}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="{StaticResource TextBody}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         KPI TILE — bound to KpiTileModel
         (Icon, Label, DisplayValue, Accent, IsAlert).
    ═══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="DashKpiTileTemplate">
        <Border Style="{StaticResource DashTileStyle}"
                Margin="6,6,6,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource DashAccentRailStyle}"/>

                <Border Grid.Column="1"
                        Style="{StaticResource DashIconChipStyle}"
                        Margin="0,0,10,0">
                    <TextBlock Text="{Binding Icon}"
                               Style="{StaticResource DashGlyphStyle}"/>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}"
                               Style="{StaticResource DashKpiLabelStyle}"/>
                    <TextBlock Text="{Binding DisplayValue}"
                               Style="{StaticResource DashKpiValueAccentStyle}"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════════════════════
         KPI CARD — bound to KpiCardModel
         (Icon, Title, DisplayValue, SubLabel, BadgeColor, IsAlert).

         BadgeColor holds a THEME BRUSH KEY ("AccentBrush"), resolved by
         BrushKeyConverter, so the chip follows the theme. That
         converter is registered globally in App.xaml.
    ═══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="KpiTemplate">
        <Border Style="{StaticResource DashTileStyle}"
                Margin="{StaticResource DashCardMargin}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="28" Height="28"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        VerticalAlignment="Top"
                        Margin="0,0,10,0"
                        Background="{Binding BadgeColor,
                                     Converter={StaticResource BrushKeyConverter}}">
                    <TextBlock Text="{Binding Icon}"
                               Style="{StaticResource DashGlyphStyle}"
                               FontSize="{StaticResource TextBodyLarge}"/>
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource DashKpiLabelStyle}"/>
                    <TextBlock Text="{Binding DisplayValue}"
                               Style="{StaticResource DashKpiValueAccentStyle}"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding SubLabel}"
                               Style="{StaticResource DashCaptionStyle}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════════════════════
         EMPTY STATE — replaces the 48px emoji blocks.
         Bind Tag to an MDL2 glyph and Content to the message.
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="DashEmptyStateGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="{StaticResource TextHeadline}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground"
                Value="{DynamicResource MutedForegroundBrush}"/>
    </Style>

    <Style x:Key="DashEmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DashFontBody}"/>
        <Setter Property="Margin" Value="0,7,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground"
                Value="{DynamicResource MutedForegroundBrush}"/>
    </Style>

    <!-- Horizontal wrap host for KPI tiles — reflows on resize. -->
    <ItemsPanelTemplate x:Key="DashTileWrapPanel">
        <WrapPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>

    <!-- ═══════════════════════════════════════════════════════════════
         ════════  "SOFT CARD" LANGUAGE — user-supplied reference  ══════
         ═══════════════════════════════════════════════════════════════

         The user supplied a full DashboardView markup as the target
         look and asked for it to be adopted across all 7 dashboards.
         Its defining traits, extracted from that markup:

           • Big soft cards: CornerRadius 18, Padding 20, Margin 0,0,0,20
           • Hairline border #E2E8F0 + DropShadow(Blur 10, Depth 2, .08)
           • Hero band: 30px Bold title, 13px muted subtitle, radius 22
           • A 4px full-bleed colour cap across the TOP of each KPI card
             (Margin="-20,-20,-20,12" so it bleeds past the padding)
           • KPI: 11px muted label, 28px Bold value, 12px status line
           • A 40x40 radius-10 tinted square badge, top-RIGHT
           • Pill buttons: radius 10, padding 14,8, opacity hover/press
           • Page background #F1F5F9, cards White

         TWO DELIBERATE DEVIATIONS FROM THE SUPPLIED MARKUP
         ──────────────────────────────────────────────────
         1. COLOUR. The reference hardcodes hex (#F1F5F9 page, White
            card, #0F172A text, #64748B label). ThemeManager swaps the
            theme dictionary at RUNTIME, so a hardcoded card stays
            white in Dark theme with near-invisible text — the exact
            "few boxes dynamic, few not" bug already fixed once in this
            codebase. Every colour below therefore resolves through
            DynamicResource. Verified: all 51 keys exist in BOTH
            Themes/LightTheme.xaml and Themes/DarkTheme.xaml, and in
            light theme they evaluate to the reference's own values
            (ElevatedSurfaceBrush #FFFFFF, PrimaryForegroundBrush
            #0F172A, SecondaryForegroundBrush #6B7280, BorderBrush
            #E5E7EB ≈ #E2E8F0). So light theme LOOKS like the
            reference; dark theme also works.

         2. CHARTS. The reference binds lvc:CartesianChart
            (LiveChartsCore). That package is NOT referenced by
            ProGlassAutomation.csproj and NuGet is not reachable from
            the build sandbox, so importing it would break the build.
            The existing TrendChartControl draws the same bar/line plot
            and is already wired to these ViewModels. DashChartWellStyle
            reproduces the reference's recessed #F8FAFC chart well so
            the framing is identical.

         SCOPE NOTE: these are NEW keys. The pre-existing compact keys
         (DashCardStyle, CardStyle, KpiTemplate, …) are left untouched
         because CardStyle is also consumed by four Tax Invoice DETAIL
         screens outside the dashboard area:
           Views/TaxInvoice/TaxInvoiceDetail/TaxInvoiceDetailView.xaml
           …/Sections/TiOverviewSection.xaml, TiFamilySection.xaml,
           …/Sections/TiAttachmentsSection.xaml
         Redefining CardStyle would silently restyle those too.
    ═══════════════════════════════════════════════════════════════ -->

    <!-- ── Geometry from the reference ─────────────────────────────── -->
    <!-- Radii retired: SoftCardRadius/SoftHeroRadius/SoftPillRadius/
         SoftBadgeRadius now resolve to the theme radius tokens. -->
    <Thickness    x:Key="SoftCardPadding">20</Thickness>
    <Thickness    x:Key="SoftPagePadding">24</Thickness>

    <!-- Type scale from the reference markup. -->
    <sys:Double x:Key="SoftFontHero">30</sys:Double>
    <sys:Double x:Key="SoftFontKpi">28</sys:Double>
    <sys:Double x:Key="SoftFontStat">22</sys:Double>
    <sys:Double x:Key="SoftFontSection">16</sys:Double>
    <sys:Double x:Key="SoftFontGroup">14</sys:Double>
    <sys:Double x:Key="SoftFontBody">13</sys:Double>
    <sys:Double x:Key="SoftFontMeta">12</sys:Double>
    <sys:Double x:Key="SoftFontLabel">11</sys:Double>

    <!-- The reference shadow: BlurRadius 10, ShadowDepth 2, Opacity .08.
         Frozen: a shadow is re-rendered per card, and these appear
         dozens of times per page. -->
    <DropShadowEffect x:Key="SoftCardShadow"
                      BlurRadius="10"
                      ShadowDepth="2"
                      Opacity="0.08"
                      Direction="270"
                      Color="#0F172A"
                      po:Freeze="True"/>

    <!-- ── Surfaces ────────────────────────────────────────────────── -->

    <!-- The reference's SectionBorderStyle. -->
    <Style x:Key="SoftCardStyle" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource GlassUltraClearBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource GlassBorderGradientCrystal}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
        <Setter Property="CornerRadius"    Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="Padding"         Value="{StaticResource SoftCardPadding}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect"          Value="{DynamicResource ShadowSoft}"/>
    </Style>

    <!-- Same card with the reference's 0,0,0,20 stacking margin. -->
    <Style x:Key="SoftSectionStyle" TargetType="Border"
           BasedOn="{StaticResource SoftCardStyle}">
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <!-- PERF-3 — flat variant for the small KPI tiles.
         A WPF Effect is a pixel shader that WPF re-runs, and re-allocates an
         intermediate GPU texture for, on EVERY frame the element is redrawn.
         Overview alone renders 17 KPI tiles; during a scroll animation that
         was 17 extra shader passes per frame on top of the 6 section cards.
         po:Freeze on the effect does NOT help: freezing makes the effect
         OBJECT immutable, it does not cache the RENDERED blur.
         An Effect also applies to every CHILD, so each tile was pushing its
         own label and value text through the blur.
         Small tiles read fine on a 1px border alone, so they drop the
         shadow; the 6 large section cards keep theirs and still carry the
         page's depth. 23 shader passes per frame -> 6.
         BitmapCache was considered and rejected: RenderAtScale defaults to
         1.0, so on a 125%/150% display it would rasterise at 1x and upscale,
         softening the very numbers this dashboard exists to show. -->
    <Style x:Key="SoftTileStyle" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource GlassUltraClearBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource GlassBorderGradientCrystal}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
        <Setter Property="CornerRadius"    Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="Padding"         Value="16,14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Hero band — radius 22, no border, per the reference. -->
    <Style x:Key="SoftHeroStyle" TargetType="Border">
        <Setter Property="BorderBrush"     Value="{DynamicResource GlassBorderGradientCrystal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background"   Value="{DynamicResource GlassUltraClearBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="Padding"      Value="24"/>
        <Setter Property="Margin"       Value="0,0,0,18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect"       Value="{DynamicResource ShadowElevated}"/>
    </Style>

    <!-- Recessed chart well — the reference's #F8FAFC radius-12 inset. -->
    <Style x:Key="SoftChartWellStyle" TargetType="Border">
        <Setter Property="BorderBrush"     Value="{DynamicResource GlassBorderGradientCrystal}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
        <Setter Property="Background"   Value="{DynamicResource GlassUltraClearBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="Padding"      Value="10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Inner neutral tile (sales-team chips, list rows). -->
    <Style x:Key="SoftInsetStyle" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource GlassUltraClearBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource GlassBorderGradientCrystal}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
        <Setter Property="CornerRadius"    Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="Padding"         Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ── Typography ──────────────────────────────────────────────── -->

    <Style x:Key="SoftHeroTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource SoftFontHero}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>

    <Style x:Key="SoftHeroSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource SoftFontBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="Margin"     Value="0,6,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- 16px SemiBold card heading (reference "Production Trend"). -->
    <Style x:Key="SoftSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource SoftFontSection}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>

    <!-- 12px muted line under a card heading. -->
    <Style x:Key="SoftSectionSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource SoftFontMeta}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="Margin"     Value="0,2,0,16"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- 14px SemiBold standalone group heading above a grid of cards. -->
    <Style x:Key="SoftGroupHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource SoftFontGroup}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Margin"     Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SoftKpiLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource SoftFontLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- The KPI number. Tabular figures stop digits jittering when a
         live value refreshes under a fixed-width column. -->
    <Style x:Key="SoftKpiValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource SoftFontKpi}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin"     Value="0,8,0,4"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Secondary stat number (reference's 22px 3-up splits). -->
    <Style x:Key="SoftStatValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource SoftFontStat}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="SoftStatLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"      Value="{StaticResource SoftFontLabel}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Foreground"    Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="TextTrimming"  Value="CharacterEllipsis"/>
    </Style>

    <!-- 12px status line under a KPI value. -->
    <Style x:Key="SoftKpiFootStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource SoftFontMeta}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="SoftMetaStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource SoftFontLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ── Ornaments ───────────────────────────────────────────────── -->

    <!-- 40x40 tinted badge, top-right of a KPI card. -->
    <Style x:Key="SoftBadgeStyle" TargetType="Border">
        <Setter Property="Width"               Value="40"/>
        <Setter Property="Height"              Value="40"/>
        <Setter Property="CornerRadius"        Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment"   Value="Top"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Glyph inside a filled badge. MDL2 is hard-set so no view can
         smuggle an emoji in through a binding — the reference used
         literal "✓", "↩" and "⏳" characters, which render through a
         colour font, ignore Foreground and look like clip-art. -->
    <Style x:Key="SoftBadgeGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"          Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="{StaticResource TextTitle}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="Foreground"          Value="{DynamicResource OnAccentForegroundBrush}"/>
    </Style>

    <!-- Small live/status chip (reference's green "Live" pill). -->
    <Style x:Key="SoftChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding"      Value="12,6"/>
        <Setter Property="Background"   Value="{DynamicResource TintGreenBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ── Pill button (reference PillButtonStyle) ─────────────────── -->
    <Style x:Key="SoftPillButtonStyle" TargetType="Button">
        <Setter Property="Padding"          Value="14,8"/>
        <Setter Property="Margin"           Value="0,0,8,0"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Background"       Value="{DynamicResource MenuHoverBrush}"/>
        <Setter Property="Foreground"       Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="FontSize"         Value="{StaticResource SoftFontMeta}"/>
        <Setter Property="FontWeight"       Value="SemiBold"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <!-- Tag carries an optional MDL2 glyph. When
                                 empty the TextBlock collapses, so a
                                 text-only pill has no phantom gap. -->
                            <TextBlock x:Name="Glyph"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextBody}"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.84"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SoftPillAccentStyle" TargetType="Button"
           BasedOn="{StaticResource SoftPillButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="SoftPillSuccessStyle" TargetType="Button"
           BasedOn="{StaticResource SoftPillButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         KPI CARD in the reference's soft style, bound to KpiCardModel
         (Icon, Title, DisplayValue, BadgeColor, TintColor, SubLabel,
         IsAlert) — the SAME model the compact KpiTemplate uses, so a
         view swaps templates without any ViewModel change.

         BadgeColor / TintColor hold theme brush KEYS resolved by
         BrushKeyConverter, so the cap and badge follow the theme and
         the per-card colour identity comes from the ViewModel rather
         than being hardcoded per column as in the reference markup.
    ═══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="SoftKpiCardTemplate">
        <Border Style="{StaticResource SoftTileStyle}" Margin="6,6,6,6">
            <Grid>
                <StackPanel Margin="0,0,48,0">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource SoftKpiLabelStyle}"/>
                    <!-- Viewbox + StretchDirection=DownOnly: a short value
                         renders at the full 28px, while a long currency
                         value ("AED 1,234,567.89" needs ~260px but a
                         1280px window only gives this column ~210px)
                         scales DOWN to fit instead of clipping. Money
                         must never be truncated. -->
                    <Viewbox HorizontalAlignment="Left"
                             Stretch="Uniform"
                             StretchDirection="DownOnly"
                             Margin="0,8,0,4">
                        <TextBlock Text="{Binding DisplayValue}"
                                   Style="{StaticResource SoftKpiValueStyle}"
                                   Margin="0"/>
                    </Viewbox>
                    <TextBlock Text="{Binding SubLabel}"
                               Style="{StaticResource SoftKpiFootStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Style="{StaticResource SoftBadgeStyle}"
                        Background="{Binding BadgeColor,
                                     Converter={StaticResource BrushKeyConverter}}">
                    <TextBlock Text="{Binding Icon}"
                               Style="{StaticResource SoftBadgeGlyphStyle}"/>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Same card for KpiTileModel (Icon, Label, DisplayValue, Accent,
         IsAlert). Accent is a WORD (Green|Blue|Amber|Red), not a brush
         key, so the cap colour comes from triggers instead. -->
    <DataTemplate x:Key="SoftKpiTileTemplate">
        <!-- Margin 5,0,5,6: equal horizontal gutter plus a small vertical
             gap so the 2×2 KPI band reads as separate cards. MinHeight keeps
             the label + value + icon slot from colliding when the band is
             narrowed. -->
        <Border Style="{StaticResource SoftTileStyle}"
                Margin="6,6,6,6">
            <Grid>
                <StackPanel Margin="0,0,48,0">
                    <TextBlock Text="{Binding Label}"
                               Style="{StaticResource SoftKpiLabelStyle}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource TextBody}"
                               LineHeight="15"/>
                    <Viewbox HorizontalAlignment="Left"
                             Stretch="Uniform"
                             StretchDirection="DownOnly"
                             Margin="0,8,0,0">
                        <TextBlock Text="{Binding DisplayValue}"
                                   Style="{StaticResource SoftKpiValueStyle}"
                                   Margin="0"/>
                    </Viewbox>
                </StackPanel>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SoftBadgeStyle}">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Accent}" Value="Green">
                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Accent}" Value="Blue">
                                    <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Accent}" Value="Amber">
                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Accent}" Value="Red">
                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Icon}"
                               Style="{StaticResource SoftBadgeGlyphStyle}"/>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- KPI row host: equal columns, reference's 10px gutter handled by
         the card margin below. UniformGrid keeps columns equal at any
         width, which is what makes the row read as one band.
         Two rows (Rows="2") so a 4-tile band becomes a 2×2 grid of larger,
         more legible tiles rather than 4 thin tiles crammed in one line. -->
    <ItemsPanelTemplate x:Key="SoftKpiRowPanel">
        <UniformGrid Rows="2"/>
    </ItemsPanelTemplate>

    <!-- ═══════════════════════════════════════════════════════════════
         ACTIVITY / FEED ROW in the soft language. Bound to
         ActivityFeedItem (Icon, Title, SubTitle, ValueDisplay,
         StatusLabel, StatusColor, TintColor).
    ═══════════════════════════════════════════════════════════════ -->
    <!-- Recent Activity rows. These had a tint fill and no edge at all, so
         on the Overview dashboard they read as coloured bands rather than
         cards. Same accent keyline and weight as every other card. -->
    <DataTemplate x:Key="SoftFeedRowTemplate">
        <Border Background="{Binding TintColor,
                             Converter={StaticResource BrushKeyConverter}}"
                BorderBrush="{DynamicResource GlassBorderGradientCrystal}"
                BorderThickness="1.5"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Padding="12,10"
                Margin="0,0,0,8"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="34" Height="34"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        VerticalAlignment="Top"
                        Margin="0,0,12,0"
                        Background="{Binding StatusColor,
                                     Converter={StaticResource BrushKeyConverter}}">
                    <TextBlock Text="{Binding Icon}"
                               Style="{StaticResource SoftBadgeGlyphStyle}"
                               FontSize="{StaticResource TextSection}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="{StaticResource SoftFontMeta}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding SubTitle}"
                               FontSize="{StaticResource SoftFontLabel}"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <TextBlock Text="{Binding ValueDisplay}"
                               FontSize="{StaticResource SoftFontMeta}"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <Border CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="7,2"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Right"
                            Background="{Binding StatusColor,
                                         Converter={StaticResource BrushKeyConverter}}">
                        <TextBlock Text="{Binding StatusLabel}"
                                   FontSize="{StaticResource DashFontMicro}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
