<!-- ═══════════════════════════════════════════════════════════════════════
     FILE: MainWindow.xaml
     PROJECT: ProGlassAutomation
     MODULE: Main Shell
     SYSTEM: Concept 30 PORCELAIN FLOW (Study 07 Editorial Wordmark)

     ART DIRECTION:
       - Continuous porcelain-white (#FCFCFE) L-shaped surface forming the
         top header and open left sidebar, joined top-left by a large rounded
         INNER elbow (smooth concave fillet).
       - Nested thin keylines (#D9D5E6 double hairlines) following the L edges.
       - Black-violet ink #211D31 typography on straight baselines.
       - PRIMARY TOP ROW:
           • Thin hamburger icon (ToggleMenuCommand)
           • OVERSIZED elegant serif-display wordmark "ProGlass" (about three
             times normal size, typographic hero) with tiny letter-spaced caps
             "AUTOMATION SUITE" aligned to its right on the same baseline
           • Rounded outline dropdown labeled exactly "All Modules" (A-l-l)
             with tiny down chevron
           • Wide rounded white inset search field with placeholder
             "Search anything…" and fine purple (#8E82D8) focus rim
           • Far right exact text "22 Sep 2026 / 10:30", one thin crescent
             moon icon, user chip circle "U" with tiny stacked "User" and "Role"
       - SECONDARY UTILITY RIBBON:
           • Slim inset soft lavender (#E6E1F4) rounded inlay following the
             full horizontal leg of the L below the primary row
           • Eight labeled actions with tiny elegant thin-line icons & exact labels:
             "AI Chat", "AI Agent", "Activity", "Settings", "Screenshot",
             "Record", "About", "Experience"
           • Far right: one neutral grey network node glyph (no status color)
       - OPEN LEFT SIDEBAR:
           • Continuous porcelain surface through the inner elbow
           • "Menu" + one X close icon only (no logo)
           • Editorial scale menu labels with thin icons:
             "Dashboard", "Sheet Store", "Specifications"
           • "Sales & Orders" with one chevron, EXPANDED:
             "Inquiry", "Proforma Invoice" (SINGLE SELECTED ROW: dark-violet
             #443A86 filled rounded row, white text), "Job Order", "Tax Invoice"
           • Collapsed groups, one chevron each:
             "Production", "Dispatch", "Finance & Accounting",
             "Reports", "Master Data", "System"
           • Sidebar footer: tiny "Local storage —" and "View breakdown", NO meter
       - MODULE REGION:
           • Blank very pale grey (#F5F5F8)
           • Bottom-right small caption "30 / PORCELAIN FLOW"
       - STRICT EXCLUSIONS:
           • Flat opaque surfaces only: NO 3D, shadows, blur, translucency,
             fabric, wavy text, gradients.
           • No extra controls, no plus signs, no badges, no avatar photos,
             no status indicators, no extra rails, no body cards.
═══════════════════════════════════════════════════════════════════════ -->

<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        xmlns:globalSearch="clr-namespace:ProGlassAutomation.Controls.GlobalSearch"
        xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
        xmlns:vmLicensing="clr-namespace:ProGlassAutomation.ViewModels.Licensing"
        xmlns:vmDashboard="clr-namespace:ProGlassAutomation.ViewModels.Dashboard"
        xmlns:vmProforma="clr-namespace:ProGlassAutomation.ViewModels.ProformaInvoice"
        xmlns:vmInquiry="clr-namespace:ProGlassAutomation.ViewModels.Inquiry"
        xmlns:viewsInquiry="clr-namespace:ProGlassAutomation.Views.Inquiry"
        xmlns:vmAbout="clr-namespace:ProGlassAutomation.ViewModels.About"
        xmlns:vmSettings="clr-namespace:ProGlassAutomation.ViewModels.Settings"
        xmlns:vmSheetStore="clr-namespace:ProGlassAutomation.ViewModels.SheetStore"
        xmlns:vmSpecifications="clr-namespace:ProGlassAutomation.ViewModels.Specifications"
        xmlns:vmJobOrder="clr-namespace:ProGlassAutomation.ViewModels.JobOrder"
        xmlns:vmOptimization="clr-namespace:ProGlassAutomation.ViewModels.Optimization"
        xmlns:vmProduction="clr-namespace:ProGlassAutomation.ViewModels.Production"
        xmlns:vmDelivery="clr-namespace:ProGlassAutomation.ViewModels.DeliveryNote"
        xmlns:vmTaxInvoice="clr-namespace:ProGlassAutomation.ViewModels.TaxInvoice"
        xmlns:vmReports="clr-namespace:ProGlassAutomation.ViewModels.Reports"
        xmlns:vmOrderReport="clr-namespace:ProGlassAutomation.ViewModels.Reports.OrderReport"
        xmlns:vmSystem="clr-namespace:ProGlassAutomation.ViewModels.SystemCenter"
        xmlns:vmCompany="clr-namespace:ProGlassAutomation.ViewModels.CompanyCenter"
        xmlns:vmUsers="clr-namespace:ProGlassAutomation.ViewModels.UserCenter"
        xmlns:vmJobProfit="clr-namespace:ProGlassAutomation.ViewModels.JobProfitability"
        xmlns:vmDiagnostics="clr-namespace:ProGlassAutomation.ViewModels.Diagnostics"
        xmlns:vmVatSubmission="clr-namespace:ProGlassAutomation.ViewModels.Reports.VatSubmission"
        xmlns:viewsDashboard="clr-namespace:ProGlassAutomation.Views.Dashboard"
        xmlns:viewsProforma="clr-namespace:ProGlassAutomation.Views.ProformaInvoice"
        xmlns:viewsAbout="clr-namespace:ProGlassAutomation.Views.About"
        xmlns:viewsLicensing="clr-namespace:ProGlassAutomation.Views.Licensing"
        xmlns:viewsSettings="clr-namespace:ProGlassAutomation.Views.Settings"
        xmlns:viewsSheetStore="clr-namespace:ProGlassAutomation.Views.SheetStore"
        xmlns:viewsSpecifications="clr-namespace:ProGlassAutomation.Views.Specifications"
        xmlns:viewsJobOrder="clr-namespace:ProGlassAutomation.Views.JobOrder"
        xmlns:viewsOptimization="clr-namespace:ProGlassAutomation.Views.Optimization"
        xmlns:viewsProduction="clr-namespace:ProGlassAutomation.Views.Production"
        xmlns:viewsDelivery="clr-namespace:ProGlassAutomation.Views.DeliveryNote"
        xmlns:viewsTaxInvoice="clr-namespace:ProGlassAutomation.Views.TaxInvoice"
        xmlns:viewsReports="clr-namespace:ProGlassAutomation.Views.Reports"
        xmlns:viewsStatementModule="clr-namespace:ProGlassAutomation.Views.Reports.StatementModule"
        xmlns:viewsOrderReport="clr-namespace:ProGlassAutomation.Views.Reports.OrderReport"
        xmlns:viewsAi="clr-namespace:ProGlassAutomation.Views.AI"
        xmlns:viewsPersonal="clr-namespace:ProGlassAutomation.Views.Personal"
        xmlns:viewsShared="clr-namespace:ProGlassAutomation.Views.Shared"
        xmlns:agentUi="clr-namespace:ProGlassAutomation.Agent.UI"
        xmlns:viewsSystem="clr-namespace:ProGlassAutomation.Views.SystemCenter"
        xmlns:viewsCompany="clr-namespace:ProGlassAutomation.Views.CompanyCenter"
        xmlns:viewsUsers="clr-namespace:ProGlassAutomation.Views.UserCenter"
        xmlns:viewsJobProfit="clr-namespace:ProGlassAutomation.Views.JobProfitability"
        xmlns:viewsDiagnostics="clr-namespace:ProGlassAutomation.Views.Diagnostics"
        xmlns:viewsVatSubmission="clr-namespace:ProGlassAutomation.Views.Reports.VatSubmission"
        Title="{DynamicResource Shell.AppTitle}"
        Height="820" Width="1280"
        MinHeight="480" MinWidth="800"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource AppFontFamily}"
        Style="{StaticResource LiquidGlassWindow}"
        FontWeight="{DynamicResource AppFontWeight}"
        FontStyle="{DynamicResource AppFontStyle}"
        Icon="pack://application:,,,/favicon.ico"
        Background="{DynamicResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Auto"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════
         MODULE DATA TEMPLATES (zero regression — all 31 preserved)
    ═══════════════════════════════════════════════════════════════ -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vmDashboard:DashboardViewModel}">
            <viewsDashboard:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmInquiry:InquiryListViewModel}">
            <viewsInquiry:InquiryListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProforma:ProformaInvoiceViewModel}">
            <viewsProforma:ProformaInvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmAbout:AboutViewModel}">
            <viewsAbout:AboutView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSettings:SettingsViewModel}">
            <viewsSettings:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSheetStore:SheetStoreViewModel}">
            <viewsSheetStore:SheetStoreView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSpecifications:SpecificationsCenterViewModel}">
            <viewsSpecifications:SpecificationsCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmJobOrder:JobOrderViewModel}">
            <viewsJobOrder:JobOrderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmOptimization:OptimizationViewModel}">
            <viewsOptimization:OptimizationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:ProductionControlCenterViewModel}">
            <viewsProduction:ProductionControlCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:ProcessWorkCenterViewModel}">
            <viewsProduction:ProcessWorkCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:CuttingWorkCenterViewModel}">
            <viewsProduction:CuttingWorkCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:CuttingViewModel}">
            <viewsProduction:CuttingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:HolesCutoutsViewModel}">
            <viewsProduction:HolesCutoutsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:PolishViewModel}">
            <viewsProduction:PolishView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:EdgeDeletionViewModel}">
            <viewsProduction:EdgeDeletionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:MitringViewModel}">
            <viewsProduction:MitringView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:TemperingViewModel}">
            <viewsProduction:TemperingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:PairingViewModel}">
            <viewsProduction:PairingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:DoublingLaminationViewModel}">
            <viewsProduction:DoublingLaminationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmDelivery:DeliveryNoteViewModel}">
            <viewsDelivery:DeliveryNoteView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmTaxInvoice:TaxInvoiceViewModel}">
            <viewsTaxInvoice:TaxInvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmReports:SalesReportViewModel}">
            <viewsReports:SalesReportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmReports:StatementModuleViewModel}">
            <viewsStatementModule:StatementModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmOrderReport:OrderReportModuleViewModel}">
            <viewsOrderReport:OrderReportModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSystem:SystemCenterViewModel}">
            <viewsSystem:SystemCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmCompany:CompanyCenterViewModel}">
            <viewsCompany:CompanyCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmUsers:UserCenterViewModel}">
            <viewsUsers:UserCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmJobProfit:JobProfitabilityViewModel}">
            <viewsJobProfit:JobProfitabilityView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmVatSubmission:VatSubmissionViewModel}">
            <viewsVatSubmission:VatSubmissionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmDiagnostics:DiagnosticsViewModel}">
            <viewsDiagnostics:DiagnosticsView/>
        </DataTemplate>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT LAYOUT (Row 0: Top Header, Row 1: Sidebar + Module)
    ═══════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Base stage background -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="{DynamicResource BackgroundBrush}"
                IsHitTestVisible="False"/>

        <!-- Glass Blush Personal shell (visible only when IsPersonalExperience is true) -->
        <viewsPersonal:GlassShell Grid.Row="0" Grid.RowSpan="2"
                                  Panel.ZIndex="30"
                                  Visibility="{Binding IsPersonalExperience,
                                    Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- ═══════════════════════════════════════════════════════════════
             SINGLE FLOATING BENTO HAMBURGER PILL (OFF / ZEN IMMERSION TRIGGER)
             When shell is closed, this is the ONLY trigger button on screen.
             Claims zero layout space (floats on top), toggles shell open/close.
        ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,16,0,0"
                Panel.ZIndex="600"
                Background="{DynamicResource SurfacePrimaryBrush}"
                BorderBrush="{DynamicResource AccentPrimaryBrush}"
                BorderThickness="1.5"
                CornerRadius="18"
                Padding="10,5,14,5"
                SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#211D31" BlurRadius="16" ShadowDepth="3" Opacity="0.12"/>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- Visible ONLY when shell is closed (IsMenuOpen == False) and in Professional mode -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMenuOpen}" Value="False"/>
                                <Condition Binding="{Binding IsPersonalExperience}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Button Command="{Binding ToggleMenuCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}"
                    ToolTip="{DynamicResource ToolTip.ToggleMenu}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE700;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Ellipse Width="4" Height="4" Margin="8,0,8,0"
                             Fill="{DynamicResource BorderDefaultBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="ProGlass"
                               FontFamily="{StaticResource PrimaryFontFamily}"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             TOP HEADER — CONCEPT 30 PORCELAIN FLOW (Study 07 Editorial Wordmark)
             Continuous porcelain-white (#FCFCFE) surface
             Primary Top Row (52px) + Secondary Utility Ribbon (36px)
             + Nested double keylines along bottom edge (#D9D5E6)
        ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Style="{StaticResource PgTopBarStyle}"
                Panel.ZIndex="300"
                SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource PgTopBarStyle}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPersonalExperience}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMenuOpen}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Background="{DynamicResource SurfacePrimaryBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                </Grid.RowDefinitions>

                <!-- PRIMARY TOP ROW (left to right) -->
                <Grid Grid.Row="0" Margin="14,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><!-- 1. Hamburger -->
                        <ColumnDefinition Width="Auto"/><!-- 2. Oversized serif wordmark ProGlass + AUTOMATION SUITE -->
                        <ColumnDefinition Width="*"/><!-- 3. Module main heading & sub text (Centered in hamburger row) -->
                        <ColumnDefinition Width="Auto"/><!-- 4. Search island -->
                        <ColumnDefinition Width="Auto"/><!-- 5. Right cluster: Date/time + Crescent moon + User initials chip -->
                    </Grid.ColumnDefinitions>

                    <!-- 1. THIN HAMBURGER ICON -->
                    <Button Grid.Column="0"
                            Style="{StaticResource PgTopIconButtonStyle}"
                            Content="&#xE700;"
                            Command="{Binding ToggleMenuCommand}"
                            ToolTip="{DynamicResource ToolTip.ToggleMenu}"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            Panel.ZIndex="80"
                            IsHitTestVisible="True"
                            Focusable="True"/>

                    <!-- 2. OVERSIZED ELEGANT SERIF-DISPLAY WORDMARK "ProGlass" + TINY LETTER-SPACED CAPS "AUTOMATION SUITE" -->
                    <StackPanel x:Name="LogoPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,18,0"
                                Cursor="Hand"
                                behaviors:ClickToCommandBehavior.Command="{Binding LogoClickCommand}"
                                ToolTip="{DynamicResource ToolTip.About}">
                        <TextBlock Text="ProGlass"
                                   Style="{StaticResource PgBrandTitleStyle}"/>
                        <TextBlock Text="AUTOMATION SUITE"
                                   Style="{StaticResource PgBrandSubStyle}"/>
                    </StackPanel>

                    <!-- 3. MODULE MAIN HEADING & SUB TEXT (Centered in the Hamburger Row) -->
                    <StackPanel Grid.Column="2"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="12,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CurrentModuleHeaderTitle, FallbackValue='Plant Operations Overview'}"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="14.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Border Margin="10,0,0,0"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="7,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Live Active"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentModuleSubText, FallbackValue='Real-time production metrics, live dispatch schedules &amp; glass inventory yield'}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="10"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="520"/>
                    </StackPanel>

                    <!-- 4. SEARCH ISLAND — wide rounded white inset with fine purple (#8E82D8) focus rim and "All Modules" dropdown -->
                    <globalSearch:GlobalSearchBar Grid.Column="3"
                                                   MinWidth="180"
                                                   MaxWidth="260"
                                                   HorizontalAlignment="Right"
                                                   Margin="10,0,16,0"
                                                   VerticalAlignment="Center"
                                                   DataContext="{Binding GlobalSearchVM}"/>

                    <!-- 5. RIGHT CLUSTER: "22 Sep 2026 / 10:30", Crescent Moon, User Chip Circle "U" -->
                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,0,0">

                        <!-- Exact text: "22 Sep 2026 / 10:30" -->
                        <Border Margin="0,0,14,0" VerticalAlignment="Center"
                                ToolTip="{DynamicResource ToolTip.DateTime}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentDateText, FallbackValue='22 Sep 2026'}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" / "
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentTimeText, FallbackValue='10:30'}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- ONE THIN CRESCENT MOON ICON -->
                        <Button x:Name="DarkModeButton"
                                Margin="0,0,12,0"
                                ToolTip="{DynamicResource ToolTip.ToggleTheme}"
                                Command="{Binding ToggleThemeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PgTopIconButtonStyle}">
                                    <Setter Property="Content" Value="&#xE708;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                            <Setter Property="Content" Value="&#xE706;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- USER CHIP CIRCLE "U" with tiny stacked "User" and "Role" -->
                        <Button x:Name="UserCardButton"
                                Style="{StaticResource PgUserCardStyle}"
                                Command="{Binding TogglePopupCommand}" CommandParameter="UserSwitch"
                                ToolTip="{DynamicResource ToolTip.SwitchUser}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource PgAvatarStyle}"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{Binding CurrentUserInitials, FallbackValue='U'}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUserDisplayName, FallbackValue='User'}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="100"/>
                                    <TextBlock Text="{Binding CurrentUserRole, FallbackValue='Role'}"
                                               FontSize="9.5"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="100"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>

                <!-- SECONDARY UTILITY RIBBON (soft lavender #E6E1F4 rounded inlay) -->
                <Border Grid.Row="1"
                        Height="34"
                        Margin="12,0,14,6"
                        Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="6,0"
                        SnapsToDevicePixels="True">
                    <DockPanel LastChildFill="False">
                        <!-- Left-aligned actions: Operational AI & Activity -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <!-- 1. AI Chat -->
                            <Button x:Name="AiBotButton"
                                    Style="{StaticResource PgRibbonActionStyle}"
                                    Command="{Binding AiChatVM.ToggleChatCommand}"
                                    ToolTip="{DynamicResource ToolTip.AiChat}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE99A;" Style="{StaticResource PgRibbonIconStyle}"/>
                                    <TextBlock Text="AI Chat" Style="{StaticResource PgRibbonLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. AI Agent -->
                            <Button x:Name="AgentPillButton"
                                    Style="{StaticResource PgRibbonActionStyle}"
                                    Command="{Binding ToggleAgentChatCommand}"
                                    ToolTip="{DynamicResource ToolTip.Agent}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource PgRibbonIconStyle}"/>
                                    <TextBlock Text="AI Agent" Style="{StaticResource PgRibbonLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. Activity -->
                            <Button x:Name="NotificationButton"
                                    Style="{StaticResource PgRibbonActionStyle}"
                                    Command="{Binding TogglePopupCommand}" CommandParameter="Notifications"
                                    ToolTip="{DynamicResource ToolTip.RecentActivity}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEA8F;" Style="{StaticResource PgRibbonIconStyle}"/>
                                    <TextBlock Text="Activity" Style="{StaticResource PgRibbonLabelStyle}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Right-aligned actions: System Utilities (Settings, Screenshot, Record, About, Experience) + Network status -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <!-- 4. Settings -->
                            <Button x:Name="SettingsButton"
                                    Style="{StaticResource PgRibbonActionStyle}"
                                    Command="{Binding TogglePopupCommand}" CommandParameter="Settings"
                                    ToolTip="{DynamicResource ToolTip.Settings}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource PgRibbonIconStyle}"/>
                                    <TextBlock Text="Settings" Style="{StaticResource PgRibbonLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <!-- 5. Screenshot -->
                            <Button x:Name="ScreenshotButton"
                                    Style="{StaticResource PgRibbonActionStyle}"
                                    Command="{Binding TogglePopupCommand}" CommandParameter="Screenshot"
                                    ToolTip="{DynamicResource ToolTip.Screenshot}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEB9F;" Style="{StaticResource PgRibbonIconStyle}"/>
                                    <TextBlock Text="Screenshot" Style="{StaticResource PgRibbonLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <!-- 6. Record -->
                            <Button x:Name="RecordButton"
                                    Style="{StaticResource PgRibbonActionStyle}"
                                    Command="{Binding TogglePopupCommand}" CommandParameter="ScreenRecord"
                                    ToolTip="{DynamicResource ToolTip.ScreenRecording}"
                                    AutomationProperties.AutomationId="Shell.ScreenRecord">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE714;" Style="{StaticResource PgRibbonIconStyle}"/>
                                    <TextBlock Text="Record" Style="{StaticResource PgRibbonLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <!-- 7. About -->
                            <Button x:Name="AboutButton"
                                    Style="{StaticResource PgRibbonActionStyle}"
                                    Command="{Binding ShowAboutCommand}"
                                    ToolTip="{DynamicResource ToolTip.About}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE949;" Style="{StaticResource PgRibbonIconStyle}"/>
                                    <TextBlock Text="About" Style="{StaticResource PgRibbonLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <!-- 8. Experience -->
                            <Button x:Name="ExperienceSwitchButton"
                                    Style="{StaticResource PgRibbonActionStyle}"
                                    Command="{Binding ToggleExperienceCommand}"
                                    ToolTip="Personal UI (Glass Blush)"
                                    AutomationProperties.AutomationId="Shell.ExperienceSwitch">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE771;" Style="{StaticResource PgRibbonIconStyle}"/>
                                    <TextBlock Text="Experience" Style="{StaticResource PgRibbonLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <!-- Neutral grey network node glyph (no status color) -->
                            <Border VerticalAlignment="Center" Margin="8,0,6,0"
                                    ToolTip="{Binding ConnectivityLabel, FallbackValue='Network node'}">
                                <TextBlock Text="&#xE701;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- NESTED DOUBLE KEYLINES along bottom of Top Header (#D9D5E6) -->
                <Grid Grid.Row="2" VerticalAlignment="Bottom" Height="3">
                    <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource BorderDefaultBrush}" SnapsToDevicePixels="True"/>
                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderDefaultBrush}" SnapsToDevicePixels="True"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             MAIN ROW (Row 1): SIDEBAR (Col 0) + MODULE REGION (Col 1)
             Joined by the large rounded INNER elbow fillet
        ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsPersonalExperience,
                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><!-- Column 0: Open Left Sidebar -->
                <ColumnDefinition Width="*"/><!-- Column 1: Module Content Region -->
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════════
                 OPEN LEFT SIDEBAR (through the inner elbow)
                 Continuous porcelain-white (#FCFCFE) surface
                 "Menu" + one X close icon only (no logo)
                 Nested double keylines along right edge (#D9D5E6)
            ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Width="260"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    Panel.ZIndex="10"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMenuOpen}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Background="{DynamicResource SurfacePrimaryBrush}">
                    <!-- Right edge nested double keylines -->
                    <Grid Width="3" HorizontalAlignment="Right" Panel.ZIndex="15">
                        <Border Width="1" HorizontalAlignment="Left" Background="{DynamicResource BorderDefaultBrush}" SnapsToDevicePixels="True"/>
                        <Border Width="1" HorizontalAlignment="Right" Background="{DynamicResource BorderDefaultBrush}" SnapsToDevicePixels="True"/>
                    </Grid>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Sidebar header — "Menu" + one X close icon only (NO LOGO) -->
                        <Grid Grid.Row="0" Margin="16,14,12,8">
                            <TextBlock Text="{DynamicResource Shell.Menu}"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource PgTopIconButtonStyle}"
                                    Content="&#xE711;"
                                    Command="{Binding ToggleMenuCommand}"
                                    ToolTip="{DynamicResource Shell.DrawerClose}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Navigation items (Scrollable) -->
                        <ScrollViewer Grid.Row="1"
                                      x:Name="MenuScrollViewer"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      IsDeferredScrollingEnabled="False"
                                      PanningMode="VerticalOnly"
                                      Focusable="False"
                                      FocusVisualStyle="{x:Null}"
                                      behaviors:SmoothScrollBehavior.IsEnabled="True">
                            <StackPanel Margin="0,4,0,16">

                                <!-- Editorial scale menu labels with thin icons -->
                                <!-- 1. Dashboard -->
                                <Button Style="{StaticResource PgSidebarItemStyle}"
                                        Content="{DynamicResource Nav.Dashboard}"
                                        Tag="&#xE80F;"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="Dashboard"/>

                                <!-- 2. Sheet Store -->
                                <Button Style="{StaticResource PgSidebarItemStyle}"
                                        Content="{DynamicResource Nav.SheetStore}"
                                        Tag="&#xE7B8;"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="SheetStore"/>

                                <!-- 3. Specifications -->
                                <Button Style="{StaticResource PgSidebarItemStyle}"
                                        Content="{DynamicResource Nav.Specifications}"
                                        Tag="&#xE8F1;"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="Specifications"/>

                                <!-- SALES & ORDERS (EXPANDED with one chevron) -->
                                <StackPanel x:Name="SalesGroupHost" Margin="0,4,0,0">
                                    <ToggleButton x:Name="SalesGroup"
                                                  Style="{StaticResource PgSidebarGroupToggleStyle}"
                                                  Content="{DynamicResource Nav.SalesOrders}"
                                                  Tag="&#xE8A5;"
                                                  IsChecked="True"
                                                  behaviors:AccordionBehavior.Group="Sidebar"/>
                                    <Border Style="{StaticResource PgSidebarSubListStyle}"
                                            Visibility="{Binding IsChecked, ElementName=SalesGroup,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <!-- Inquiry -->
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.Inquiry}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="Inquiry"/>

                                            <!-- Proforma Invoice — SINGLE SELECTED ROW: dark-violet (#443A86) filled rounded row, white text -->
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.ProformaInvoice}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="ProformaInvoice"/>

                                            <!-- Job Order -->
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.JobOrder}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="JobOrder"/>

                                            <!-- Tax Invoice -->
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.TaxInvoice}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="TaxInvoice"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- PRODUCTION (Collapsed group, one chevron) -->
                                <StackPanel x:Name="ProductionGroupHost">
                                    <ToggleButton x:Name="ProductionGroup"
                                                  Style="{StaticResource PgSidebarGroupToggleStyle}"
                                                  Content="{DynamicResource Nav.ProductionItems}"
                                                  Tag="&#xE8C6;"
                                                  behaviors:AccordionBehavior.Group="Sidebar"/>
                                    <Border Style="{StaticResource PgSidebarSubListStyle}"
                                            Visibility="{Binding IsChecked, ElementName=ProductionGroup,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.Optimization}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="Optimization"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="Process Work Center"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="ProcessWorkCenter"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="Production Control Center"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="ProductionControlCenter"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.Cutting}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="Cutting"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.HolesCutouts}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="HolesCutouts"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.Polish}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="Polish"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.EdgeDeletion}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="EdgeDeletion"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.Mitring}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="Mitring"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.Tempering}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="Tempering"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.Pairing}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="Pairing"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.DoublingLamination}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="DoublingLamination"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- DISPATCH (Collapsed group, one chevron) -->
                                <StackPanel x:Name="DispatchGroupHost">
                                    <ToggleButton x:Name="DispatchGroup"
                                                  Style="{StaticResource PgSidebarGroupToggleStyle}"
                                                  Content="{DynamicResource Nav.Dispatch}"
                                                  Tag="&#xE7F4;"
                                                  behaviors:AccordionBehavior.Group="Sidebar"/>
                                    <Border Style="{StaticResource PgSidebarSubListStyle}"
                                            Visibility="{Binding IsChecked, ElementName=DispatchGroup,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.DeliveryNote}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="DeliveryNote"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- FINANCE & ACCOUNTING (Collapsed group, one chevron) -->
                                <StackPanel x:Name="FinanceGroupHost">
                                    <ToggleButton x:Name="FinanceGroup"
                                                  Style="{StaticResource PgSidebarGroupToggleStyle}"
                                                  Content="{DynamicResource Nav.FinanceAccounting}"
                                                  Tag="&#xE90E;"
                                                  behaviors:AccordionBehavior.Group="Sidebar"/>
                                    <Border Style="{StaticResource PgSidebarSubListStyle}"
                                            Visibility="{Binding IsChecked, ElementName=FinanceGroup,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.StatementGenerator}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="StatementGenerator"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="Report Generator"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="OrderReport"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.JobProfitability}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="JobProfitability"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.VatSubmission}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="VatSubmission"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- REPORTS (Collapsed group, one chevron) -->
                                <StackPanel x:Name="ReportsGroupHost">
                                    <ToggleButton x:Name="ReportsGroup"
                                                  Style="{StaticResource PgSidebarGroupToggleStyle}"
                                                  Content="{DynamicResource Nav.Reports}"
                                                  Tag="&#xE9F9;"
                                                  behaviors:AccordionBehavior.Group="Sidebar"/>
                                    <Border Style="{StaticResource PgSidebarSubListStyle}"
                                            Visibility="{Binding IsChecked, ElementName=ReportsGroup,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.Overview}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="SalesReport"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.ProformaInvoice}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="PiReport"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.JobOrder}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="JoReport"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.Delivery}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="DeliveryReport"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.TaxInvoice}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="TaxInvoiceReport"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.Statement}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="StatementReport"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- MASTER DATA (Collapsed group, one chevron) -->
                                <StackPanel x:Name="MasterDataGroupHost">
                                    <ToggleButton x:Name="MasterDataGroup"
                                                  Style="{StaticResource PgSidebarGroupToggleStyle}"
                                                  Content="{DynamicResource Nav.MasterDataItems}"
                                                  Tag="&#xE822;"
                                                  behaviors:AccordionBehavior.Group="Sidebar"/>
                                    <Border Style="{StaticResource PgSidebarSubListStyle}"
                                            Visibility="{Binding IsChecked, ElementName=MasterDataGroup,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.CompanyCenter}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="CompanyCenter"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.UserCenter}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="UserCenter"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- SYSTEM (Collapsed group, one chevron) -->
                                <StackPanel x:Name="SystemGroupHost">
                                    <ToggleButton x:Name="SystemGroup"
                                                  Style="{StaticResource PgSidebarGroupToggleStyle}"
                                                  Content="{DynamicResource Nav.System}"
                                                  Tag="&#xE713;"
                                                  behaviors:AccordionBehavior.Group="Sidebar"/>
                                    <Border Style="{StaticResource PgSidebarSubListStyle}"
                                            Visibility="{Binding IsChecked, ElementName=SystemGroup,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.SystemCenter}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="SystemCenter"/>
                                            <Button Style="{StaticResource PgSidebarSubItemStyle}"
                                                    Content="{DynamicResource Nav.LogsActivity}"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="Diagnostics"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- SIDEBAR FOOTER: tiny "Local storage —" and "View breakdown", NO meter -->
                        <viewsShared:StorageSidebarCard x:Name="StorageCard"
                                                        Grid.Row="2"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 MODULE REGION (Column 1)
                 Full Light Studio Bento Workspace
            ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1" Background="{DynamicResource BackgroundBrush}">

                <ContentControl Content="{Binding ProfessionalContent}"
                                behaviors:ContentTransitionBehavior.IsEnabled="True"
                                Margin="0">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <!-- READ-ONLY BANNER (trial ended / grace period) -->
                <Border x:Name="ReadOnlyBanner"
                        Panel.ZIndex="50"
                        Margin="16,16,16,0"
                        VerticalAlignment="Top"
                        Padding="16,10"
                        CornerRadius="8"
                        Background="#FFFBEB"
                        BorderBrush="#F59E0B"
                        BorderThickness="1"
                        SnapsToDevicePixels="True"
                        Visibility="{Binding IsReadOnly,
                            Source={x:Static vmLicensing:LicenseStatusViewModel.Instance},
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xE7BA;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Shell.ReadOnly}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding StatusDescription,
                                              Source={x:Static vmLicensing:LicenseStatusViewModel.Instance}}"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="{DynamicResource Shell.ActivateLicense}"
                                Padding="14,6"
                                VerticalAlignment="Center"
                                Command="{Binding OpenLicenseSettingsCommand}"
                                Background="#F59E0B"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- LICENSE ACTIVATION OVERLAY -->
                <Border x:Name="LicenseOverlay"
                        Panel.ZIndex="100"
                        Margin="16"
                        CornerRadius="10"
                        Background="#FFFFFF"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2"
                        SnapsToDevicePixels="True"
                        Visibility="{Binding IsLicenseRequired,
                            Source={x:Static vmLicensing:LicenseStatusViewModel.Instance},
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <viewsLicensing:LicenseActivationView Grid.Row="1"
                                                              x:Name="LicenseActivationHost"
                                                              IsClosable="False"/>
                    </Grid>
                </Border>

                <!-- AI CHAT OVERLAY -->
                <viewsAi:AiChatView x:Name="ProAiChatView"
                                    DataContext="{Binding AiChatVM}"
                                    Panel.ZIndex="200">
                    <viewsAi:AiChatView.Style>
                        <Style TargetType="viewsAi:AiChatView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsOpen}" Value="True"/>
                                        <Condition Binding="{Binding DataContext.IsPersonalExperience, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </viewsAi:AiChatView.Style>
                </viewsAi:AiChatView>

                <!-- AGENT CHAT FLOATING CARD (Bento Indigo Surface) -->
                <Border x:Name="ProAgentChatHost"
                        Panel.ZIndex="210"
                        Width="560"
                        Height="680"
                        MaxHeight="{Binding ActualHeight,
                                    RelativeSource={RelativeSource AncestorType=Window},
                                    Converter={StaticResource WindowInsetConverter},
                                    ConverterParameter=120}"
                        Margin="0,16,24,24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        CornerRadius="14"
                        ClipToBounds="False"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource SurfacePrimaryBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4"
                                          Opacity="0.14" Color="{DynamicResource LiquidShadowColor}" Direction="270"/>
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsAgentChatOpen}" Value="True"/>
                                        <Condition Binding="{Binding IsPersonalExperience}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border CornerRadius="12"
                            ClipToBounds="True"
                            Background="#FFFFFF">
                        <agentUi:AgentChatView DataContext="{Binding AgentChatVM}"/>
                    </Border>
                </Border>

            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             NON-BLOCKING POPUPS (anchored to top-bar and sidebar controls)
        ═══════════════════════════════════════════════════════════════ -->

        <!-- USER-SWITCH POPUP -->
        <Popup x:Name="UserSwitchPopup"
               PlacementTarget="{Binding ElementName=UserCardButton}"
               Placement="Bottom"
               VerticalOffset="8"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               Opened="UserSwitchPopup_Opened"
               Closed="UserSwitchPopup_Closed">
            <Popup.IsOpen>
                <MultiBinding Converter="{StaticResource ExperienceGatedConverter}">
                    <Binding Path="IsUserSwitchOpen"/>
                    <Binding Path="IsPersonalExperience"/>
                </MultiBinding>
            </Popup.IsOpen>
            <viewsShared:UserSwitchPanel x:Name="UserSwitchPanelHost" Width="360"/>
        </Popup>

        <!-- QUICK-SETTINGS POPUP -->
        <Popup x:Name="SettingsPopup"
               PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Bottom"
               HorizontalOffset="-200"
               VerticalOffset="8"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}">
            <viewsShared:QuickSettingsPanel x:Name="SettingsPanelHost" Width="360"/>
        </Popup>

        <!-- NOTIFICATIONS / ACTIVITY POPUP -->
        <Popup x:Name="NotificationsPopup"
               PlacementTarget="{Binding ElementName=NotificationButton}"
               Placement="Bottom"
               VerticalOffset="8"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               Opened="NotificationsPopup_Opened">
            <Popup.IsOpen>
                <MultiBinding Converter="{StaticResource ExperienceGatedConverter}">
                    <Binding Path="IsNotificationsOpen"/>
                    <Binding Path="IsPersonalExperience"/>
                </MultiBinding>
            </Popup.IsOpen>
            <viewsShared:ActivityPanel x:Name="ActivityPanelHost"/>
        </Popup>

        <!-- SCREENSHOT POPUP -->
        <Popup x:Name="ScreenshotPopup"
               PlacementTarget="{Binding ElementName=ScreenshotButton}"
               Placement="Bottom"
               HorizontalOffset="-160"
               VerticalOffset="0"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Popup.IsOpen>
                <MultiBinding Converter="{StaticResource ExperienceGatedConverter}">
                    <Binding Path="IsScreenshotOpen"/>
                    <Binding Path="IsPersonalExperience"/>
                </MultiBinding>
            </Popup.IsOpen>
            <viewsShared:ScreenshotPanel x:Name="ScreenshotPanelHost"/>
        </Popup>

        <!-- SCREEN RECORD POPUP -->
        <Popup x:Name="ScreenRecordPopup"
               PlacementTarget="{Binding ElementName=RecordButton}"
               Placement="Bottom"
               HorizontalOffset="-160"
               VerticalOffset="8"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Popup.IsOpen>
                <MultiBinding Converter="{StaticResource ExperienceGatedConverter}">
                    <Binding Path="IsScreenRecordOpen"/>
                    <Binding Path="IsPersonalExperience"/>
                </MultiBinding>
            </Popup.IsOpen>
            <viewsShared:ScreenRecordPanel x:Name="ScreenRecordPanelHost"/>
        </Popup>

        <!-- STORAGE BREAKDOWN POPUP -->
        <Popup x:Name="StoragePopup"
               PlacementTarget="{Binding ElementName=StorageCard}"
               Placement="Top"
               VerticalOffset="-8"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsStorageOpen, Mode=TwoWay}">
            <viewsShared:StorageDetailsPanel x:Name="StoragePanelHost" Width="380"/>
        </Popup>

    </Grid>
</Window>
