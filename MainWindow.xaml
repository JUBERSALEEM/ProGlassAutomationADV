<!-- ═══════════════════════════════════════════════════════════════════
     FILE: MainWindow.xaml
     PROJECT: ProGlassAutomation
     MODULE: Main Shell (Chat 24 v4.0 — theme-based redesign)

     VERSION: Chat 24 v4.0 — Full visual redesign matching the reference
     shell, adapted to the app's theme system (no hardcoded indigo).

     CHANGES vs v3.1:
       ✓ Top bar RESTRUCTURED to the modern SaaS pattern:
         Hamburger → Logo → Module Badge → Search →
         AI Agent pill → DateTime → Connectivity → Notifications →
         Settings → About → User card
       ✓ Sidebar sub-groups EXPAND/COLLAPSE with a rotating chevron and
         nested rounded card containers (Sales, Production, Dispatch,
         Reports, Master Data, System)
       ✓ Consistent 16px card radius + 1px border line across the shell
       ✓ Theme-based brushes (AccentBrush / tints / foregrounds) so every
         surface follows Light/Dark and the Monet/Professional families
       ✓ User card navigates to the USERS module (was Settings)

     PRESERVED (zero regression):
       ✓ All 23 DataTemplate module mappings (verbatim)
       ✓ All bindings, commands and property paths on MainViewModel
       ✓ All 3 code-behind handlers (names/signatures unchanged)
       ✓ Drawer model (hamburger toggles IsMenuOpen)
       ✓ Elevation caster pattern (empty Border for the shadow)
       ✓ Menu scroll ↔ slider sync (MenuScrollViewer + ScrollSlider names)
       ✓ AI Chat overlay + Agent Chat overlay
       ✓ Glassy vertical slider + thumb
═══════════════════════════════════════════════════════════════════ -->

<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        xmlns:globalSearch="clr-namespace:ProGlassAutomation.Controls.GlobalSearch"
        xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
        xmlns:vmDashboard="clr-namespace:ProGlassAutomation.ViewModels.Dashboard"
        xmlns:vmProforma="clr-namespace:ProGlassAutomation.ViewModels.ProformaInvoice"
        xmlns:vmAbout="clr-namespace:ProGlassAutomation.ViewModels.About"
        xmlns:vmSettings="clr-namespace:ProGlassAutomation.ViewModels.Settings"
        xmlns:vmSheetStore="clr-namespace:ProGlassAutomation.ViewModels.SheetStore"
        xmlns:vmJobOrder="clr-namespace:ProGlassAutomation.ViewModels.JobOrder"
        xmlns:vmOptimization="clr-namespace:ProGlassAutomation.ViewModels.Optimization"
        xmlns:vmProduction="clr-namespace:ProGlassAutomation.ViewModels.Production"
        xmlns:vmDelivery="clr-namespace:ProGlassAutomation.ViewModels.DeliveryNote"
        xmlns:vmTaxInvoice="clr-namespace:ProGlassAutomation.ViewModels.TaxInvoice"
        xmlns:vmReports="clr-namespace:ProGlassAutomation.ViewModels.Reports"
        xmlns:vmSystem="clr-namespace:ProGlassAutomation.ViewModels.SystemCenter"
        xmlns:vmCompany="clr-namespace:ProGlassAutomation.ViewModels.CompanyCenter"
        xmlns:vmUsers="clr-namespace:ProGlassAutomation.ViewModels.UserCenter"
        xmlns:vmJobProfit="clr-namespace:ProGlassAutomation.ViewModels.JobProfitability"
        xmlns:vmDiagnostics="clr-namespace:ProGlassAutomation.ViewModels.Diagnostics"
        xmlns:viewsDashboard="clr-namespace:ProGlassAutomation.Views.Dashboard"
        xmlns:viewsProforma="clr-namespace:ProGlassAutomation.Views.ProformaInvoice"
        xmlns:viewsAbout="clr-namespace:ProGlassAutomation.Views.About"
        xmlns:viewsSettings="clr-namespace:ProGlassAutomation.Views.Settings"
        xmlns:viewsSheetStore="clr-namespace:ProGlassAutomation.Views.SheetStore"
        xmlns:viewsJobOrder="clr-namespace:ProGlassAutomation.Views.JobOrder"
        xmlns:viewsOptimization="clr-namespace:ProGlassAutomation.Views.Optimization"
        xmlns:viewsProduction="clr-namespace:ProGlassAutomation.Views.Production"
        xmlns:viewsDelivery="clr-namespace:ProGlassAutomation.Views.DeliveryNote"
        xmlns:viewsTaxInvoice="clr-namespace:ProGlassAutomation.Views.TaxInvoice"
        xmlns:viewsReports="clr-namespace:ProGlassAutomation.Views.Reports"
        xmlns:viewsAi="clr-namespace:ProGlassAutomation.Views.AI"
        xmlns:viewsShared="clr-namespace:ProGlassAutomation.Views.Shared"
        xmlns:agentUi="clr-namespace:ProGlassAutomation.Agent.UI"
        xmlns:viewsSystem="clr-namespace:ProGlassAutomation.Views.SystemCenter"
        xmlns:viewsCompany="clr-namespace:ProGlassAutomation.Views.CompanyCenter"
        xmlns:viewsUsers="clr-namespace:ProGlassAutomation.Views.UserCenter"
        xmlns:viewsJobProfit="clr-namespace:ProGlassAutomation.Views.JobProfitability"
        xmlns:viewsDiagnostics="clr-namespace:ProGlassAutomation.Views.Diagnostics"
        Title="ProGlass Automation"
        Height="820" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/favicon.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>

        <!-- ═══════════════════════════════════════════════════════════════
             FROZEN SHADOWS &amp; GRADIENTS (theme-based accent)
        ═══════════════════════════════════════════════════════════════ -->

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="18" ShadowDepth="3"
                          Opacity="0.08" Color="#0F172A" Direction="270"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="TopBarShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Opacity="0.06" Color="Black" Direction="270"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="LogoGlow"
                          BlurRadius="10" ShadowDepth="3"
                          Opacity="0.30" Color="{DynamicResource AccentColor}"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="DrawerLeftShadow"
                          BlurRadius="30" ShadowDepth="6"
                          Opacity="0.15" Color="Black" Direction="0"
                          po:Freeze="True"/>

        <!-- Theme-based accent gradients (use AccentColor resources so they
             follow the chosen accent + Light/Dark). -->
        <LinearGradientBrush x:Key="LogoBrandGradient"
                             StartPoint="0,0" EndPoint="1,1"
                             po:Freeze="True">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AvatarGradient"
                             StartPoint="0,0" EndPoint="1,1"
                             po:Freeze="True">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DateTimeIconGradient"
                             StartPoint="0,0" EndPoint="1,1"
                             po:Freeze="True">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AiPillGradient"
                             StartPoint="0,0" EndPoint="1,1"
                             po:Freeze="True">
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="StorageBarGradient"
                             StartPoint="0,0" EndPoint="1,0"
                             po:Freeze="True">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="StorageCardGradient"
                             StartPoint="0,0" EndPoint="1,1"
                             po:Freeze="True">
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarActiveGradient"
                             StartPoint="0,0" EndPoint="1,1"
                             po:Freeze="True">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════════════════════════════════════════════════════════
             ViewModel → View mappings (23 modules — preserved verbatim)
        ═══════════════════════════════════════════════════════════════ -->

        <DataTemplate DataType="{x:Type vmDashboard:DashboardViewModel}">
            <viewsDashboard:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProforma:ProformaInvoiceViewModel}">
            <viewsProforma:ProformaInvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmAbout:AboutViewModel}">
            <viewsAbout:AboutView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSettings:SettingsViewModel}">
            <viewsSettings:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSheetStore:SheetStoreViewModel}">
            <viewsSheetStore:SheetStoreView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmJobOrder:JobOrderViewModel}">
            <viewsJobOrder:JobOrderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmOptimization:OptimizationViewModel}">
            <viewsOptimization:OptimizationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:CuttingViewModel}">
            <viewsProduction:CuttingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:HolesCutoutsViewModel}">
            <viewsProduction:HolesCutoutsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:PolishViewModel}">
            <viewsProduction:PolishView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:EdgeDeletionViewModel}">
            <viewsProduction:EdgeDeletionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:MitringViewModel}">
            <viewsProduction:MitringView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:TemperingViewModel}">
            <viewsProduction:TemperingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:PairingViewModel}">
            <viewsProduction:PairingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:DoublingLaminationViewModel}">
            <viewsProduction:DoublingLaminationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmDelivery:DeliveryNoteViewModel}">
            <viewsDelivery:DeliveryNoteView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmTaxInvoice:TaxInvoiceViewModel}">
            <viewsTaxInvoice:TaxInvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmReports:SalesReportViewModel}">
            <viewsReports:SalesReportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSystem:SystemCenterViewModel}">
            <viewsSystem:SystemCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmCompany:CompanyCenterViewModel}">
            <viewsCompany:CompanyCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmUsers:UserCenterViewModel}">
            <viewsUsers:UserCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmJobProfit:JobProfitabilityViewModel}">
            <viewsJobProfit:JobProfitabilityView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmDiagnostics:DiagnosticsViewModel}">
            <viewsDiagnostics:DiagnosticsView/>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════════
             TOP-BAR ICON BUTTON (40×40 rounded, theme-based)
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="TopIconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             SIDEBAR GROUP LABEL (MAIN / SALES / etc.)
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="SidebarGroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="20,16,20,8"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             SIDEBAR NAV ITEM (single, no children) — Button-based
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="SidebarNavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="12,2,12,2"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Accent"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Margin="0,8,0,8"
                                    CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <Border x:Name="Bg"
                                    Background="Transparent"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="12,0"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="Icon"
                                               Text="{TemplateBinding Tag}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Width="20"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <TextBlock x:Name="Label"
                                               Text="{TemplateBinding Content}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             SIDEBAR GROUP TOGGLE HEADER (expandable, rotating chevron)
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="SidebarGroupToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="12,2,12,2"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="12,0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="Icon"
                                               Text="{TemplateBinding Tag}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Width="20"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <TextBlock x:Name="Label"
                                               Text="{TemplateBinding Content}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="Chevron"
                                           Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="ChevronRotate" Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="90" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             SIDEBAR SUB-MENU CONTAINER (nested rounded card)
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="SidebarSubMenuCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SidebarCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Margin" Value="20,4,20,6"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             SIDEBAR SUB-ITEM (bullet dot + text)
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="SidebarSubItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="12,0"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot"
                                         Width="5" Height="5"
                                         Fill="{DynamicResource MutedForegroundBrush}"
                                         Margin="0,0,12,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             GLASSY VERTICAL SLIDER (preserved, theme-based track)
        ═══════════════════════════════════════════════════════════════ -->

        <LinearGradientBrush x:Key="SliderTrackFillGradient"
                             StartPoint="0,0" EndPoint="0,1"
                             po:Freeze="True">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SliderThumbInnerGradient"
                             StartPoint="0,0" EndPoint="1,1"
                             po:Freeze="True">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="GlassySliderThumbStyle" TargetType="Thumb">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Width="20" Height="20" Fill="{DynamicResource ModuleBackgroundBrush}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6"
                                                      ShadowDepth="1"
                                                      Opacity="0.2"
                                                      Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="8" Height="8"
                                     Fill="{StaticResource SliderThumbInnerGradient}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvisibleRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassyVerticalSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">
                            <Border Width="6" CornerRadius="3" Background="{DynamicResource BorderBrush}"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleRepeatButton}"
                                                  Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource GlassySliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleRepeatButton}"
                                                  Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT LAYOUT
    ═══════════════════════════════════════════════════════════════ -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             TOP BAR — RESTRUCTURED
        ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Panel.ZIndex="50"
                Effect="{StaticResource TopBarShadow}"
                SnapsToDevicePixels="True">

            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><!-- Hamburger -->
                    <ColumnDefinition Width="Auto"/><!-- Logo -->
                    <ColumnDefinition Width="Auto"/><!-- Module Badge -->
                    <ColumnDefinition Width="*"/><!-- Search -->
                    <ColumnDefinition Width="Auto"/><!-- Right cluster -->
                </Grid.ColumnDefinitions>

                <!-- HAMBURGER -->
                <Button Grid.Column="0"
                        Style="{StaticResource TopIconButton}"
                        Content="&#xE700;"
                        Command="{Binding ToggleMenuCommand}"
                        ToolTip="Toggle menu"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"/>

                <!-- LOGO -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Border Width="38" Height="38"
                            CornerRadius="10"
                            Effect="{StaticResource LogoGlow}"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                        Stretch="UniformToFill"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="ProGlass"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="AUTOMATION SUITE"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- MODULE BADGE -->
                <Border Grid.Column="2"
                        Height="40"
                        CornerRadius="20"
                        Padding="18,0"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0"
                        Background="{StaticResource SidebarActiveGradient}"
                        BorderBrush="#4DFFFFFF"
                        BorderThickness="1"
                        SnapsToDevicePixels="True"
                        ToolTip="Active module">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8A9;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding CurrentModuleTitle,
                                       FallbackValue=MODULE,
                                       TargetNullValue=MODULE}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="200"/>
                    </StackPanel>
                </Border>

                <!-- SEARCH — hosts the GlobalSearchBar -->
                <Border Grid.Column="3"
                        MaxWidth="480"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                    <globalSearch:GlobalSearchBar DataContext="{Binding GlobalSearchVM}"/>
                </Border>

                <!-- RIGHT CLUSTER -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">

                    <!-- AI AGENT PULSE PILL (theme-based accent) -->
                    <Border Height="40"
                            CornerRadius="20"
                            Padding="14,0"
                            Margin="0,0,10,0"
                            Background="{DynamicResource TintBlueBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            SnapsToDevicePixels="True"
                            ToolTip="ProGlass Agent — local assistant you can teach">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding ToggleAgentChatCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="12" Height="12" Margin="0,0,10,0">
                                <Ellipse Fill="{DynamicResource SuccessBrush}" Opacity="0.4">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="AiPulseScale"
                                                        ScaleX="1" ScaleY="1"
                                                        CenterX="6" CenterY="6"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="AiPulseScale"
                                                        Storyboard.TargetProperty="ScaleX"
                                                        From="1" To="2.5" Duration="0:0:2"/>
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="AiPulseScale"
                                                        Storyboard.TargetProperty="ScaleY"
                                                        From="1" To="2.5" Duration="0:0:2"/>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="0.5" To="0" Duration="0:0:2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Width="10" Height="10"
                                         Fill="{DynamicResource SuccessBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="AI AGENT"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Assistant"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DATE/TIME PILL -->
                    <Border Height="40"
                            Background="{DynamicResource MenuHoverBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,0"
                            Margin="0,0,10,0"
                            SnapsToDevicePixels="True"
                            ToolTip="Current date and time">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28"
                                    CornerRadius="7"
                                    Background="{StaticResource DateTimeIconGradient}"
                                    Margin="0,0,10,0">
                                <TextBlock Text="&#xE787;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentDateText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           FontWeight="Medium"/>
                                <TextBlock Text="{Binding CurrentTimeText}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CONNECTIVITY PILL -->
                    <Border Height="40"
                            CornerRadius="20"
                            Padding="14,0"
                            Margin="0,0,10,0"
                            BorderBrush="#4DFFFFFF"
                            BorderThickness="1"
                            SnapsToDevicePixels="True"
                            ToolTip="Internet connection state">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE701;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                <Setter Property="Text" Value="&#xE8CD;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ConnectivityLabel}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- NOTIFICATION BELL (routes to Logs & Activity) -->
                    <Grid Margin="0,0,10,0">
                        <Button Style="{StaticResource TopIconButton}"
                                Content="&#xEA8F;"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Diagnostics"
                                ToolTip="Logs &amp; Activity"/>
                        <Ellipse Width="10" Height="10"
                                 Fill="{DynamicResource DangerBrush}"
                                 Stroke="White"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,6,6,0"
                                 IsHitTestVisible="False"/>
                    </Grid>

                    <!-- SETTINGS -->
                    <Button Style="{StaticResource TopIconButton}"
                            Content="&#xE713;"
                            Command="{Binding ShowSettingsCommand}"
                            ToolTip="Settings"
                            Margin="0,0,10,0"/>

                    <!-- ABOUT / HELP -->
                    <Button Style="{StaticResource TopIconButton}"
                            Content="&#xE946;"
                            Command="{Binding ShowAboutCommand}"
                            ToolTip="About"
                            Margin="0,0,10,0"/>

                    <!-- USER CARD — opens a NON-BLOCKING user-switch popup.
                         Single click opens; double-click (or clicking another
                         module) closes. The popup floats over the shell and
                         never blocks the module content behind it. -->
                    <Button x:Name="UserCardButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Click="UserCardButton_Click"
                            PreviewMouseLeftButtonDown="UserCardButton_PreviewMouseLeftButtonDown"
                            ToolTip="Switch user — click to open, double-click to close">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg"
                                        Height="40"
                                        Background="{DynamicResource MenuHoverBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="6,0,14,0"
                                        SnapsToDevicePixels="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="30" Height="30"
                                                CornerRadius="15"
                                                Background="{StaticResource AvatarGradient}"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="{Binding CurrentUserInitials, FallbackValue=&apos;?&apos;}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentUserDisplayName, FallbackValue=&apos;User&apos;}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="120"/>
                                            <TextBlock Text="{Binding CurrentUserRole, FallbackValue=&apos;User&apos;}"
                                                       FontSize="9"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="120"/>
                                        </StackPanel>
                                        <TextBlock Text="&#xE70D;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT AREA
        ═══════════════════════════════════════════════════════════════ -->

        <Grid Grid.Row="1">

            <!-- ELEVATION CASTER (empty shadow-only Border) -->
            <Border Margin="16"
                    CornerRadius="16"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    Effect="{StaticResource CardShadow}"
                    IsHitTestVisible="False"
                    SnapsToDevicePixels="True"/>

            <!-- CONTENT CARD -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Margin="16"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Border CornerRadius="16"
                            Background="{DynamicResource ModuleWallpaperBrush}"
                            IsHitTestVisible="False"/>
                    <ContentControl Content="{Binding CurrentViewModel}"/>
                </Grid>
            </Border>

            <!-- DIM OVERLAY (only when the drawer is open) -->
            <Rectangle Fill="Black" Opacity="0.35"
                       MouseLeftButtonDown="DimOverlay_MouseLeftButtonDown">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>

            <!-- ═══════════════════════════════════════════════════════
                 LEFT DRAWER — REDESIGNED SIDEBAR (all groups expandable)
            ═══════════════════════════════════════════════════════════ -->

            <Border Width="300"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="0,16,16,0"
                    Panel.ZIndex="10"
                    Effect="{StaticResource DrawerLeftShadow}"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer x:Name="MenuScrollViewer"
                                      Grid.Column="0"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      IsDeferredScrollingEnabled="False"
                                      PanningMode="VerticalOnly"
                                      Focusable="False"
                                      FocusVisualStyle="{x:Null}"
                                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                                      ScrollChanged="MenuScrollViewer_ScrollChanged">
                            <StackPanel Margin="0,12,0,16">

                                <!-- MAIN -->
                                <TextBlock Text="MAIN"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <Button Style="{StaticResource SidebarNavItem}"
                                        Content="Dashboard"
                                        Tag="&#xE80F;"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="Dashboard"/>

                                <!-- INVENTORY -->
                                <TextBlock Text="INVENTORY"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <Button Style="{StaticResource SidebarNavItem}"
                                        Content="Sheet Store"
                                        Tag="&#xE7B8;"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="SheetStore"/>

                                <!-- SALES (expandable) -->
                                <TextBlock Text="SALES"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <ToggleButton x:Name="SalesGroup"
                                              Style="{StaticResource SidebarGroupToggle}"
                                              Content="Sales &amp; Orders"
                                              Tag="&#xE8A5;"
                                              IsChecked="True"/>
                                <Border Style="{StaticResource SidebarSubMenuCard}"
                                        Visibility="{Binding IsChecked, ElementName=SalesGroup,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Proforma Invoice"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="ProformaInvoice"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Job Order"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="JobOrder"/>
                                    </StackPanel>
                                </Border>

                                <!-- PRODUCTION (expandable) -->
                                <TextBlock Text="PRODUCTION"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <ToggleButton x:Name="ProductionGroup"
                                              Style="{StaticResource SidebarGroupToggle}"
                                              Content="Production"
                                              Tag="&#xE7B8;"/>
                                <Border Style="{StaticResource SidebarSubMenuCard}"
                                        Visibility="{Binding IsChecked, ElementName=ProductionGroup,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Optimization"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Optimization"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Cutting"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Cutting"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Holes &amp; Cutouts"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="HolesCutouts"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Polish"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Polish"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Edge Deletion"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="EdgeDeletion"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Mitring"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Mitring"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Tempering"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Tempering"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Pairing"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Pairing"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Doubling / Lamination"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="DoublingLamination"/>
                                    </StackPanel>
                                </Border>

                                <!-- DISPATCH (expandable) -->
                                <TextBlock Text="DISPATCH"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <ToggleButton x:Name="DispatchGroup"
                                              Style="{StaticResource SidebarGroupToggle}"
                                              Content="Dispatch"
                                              Tag="&#xE7F4;"/>
                                <Border Style="{StaticResource SidebarSubMenuCard}"
                                        Visibility="{Binding IsChecked, ElementName=DispatchGroup,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Delivery Note"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="DeliveryNote"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Tax Invoice"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="TaxInvoice"/>
                                    </StackPanel>
                                </Border>

                                <!-- REPORTS (expandable) -->
                                <TextBlock Text="REPORTS"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <ToggleButton x:Name="ReportsGroup"
                                              Style="{StaticResource SidebarGroupToggle}"
                                              Content="Reports"
                                              Tag="&#xE9F9;"/>
                                <Border Style="{StaticResource SidebarSubMenuCard}"
                                        Visibility="{Binding IsChecked, ElementName=ReportsGroup,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Sales Report"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="SalesReport"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Job Profitability"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="JobProfitability"/>
                                    </StackPanel>
                                </Border>

                                <!-- MASTER DATA (expandable) -->
                                <TextBlock Text="MASTER DATA"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <ToggleButton x:Name="MasterDataGroup"
                                              Style="{StaticResource SidebarGroupToggle}"
                                              Content="Master Data"
                                              Tag="&#xE822;"/>
                                <Border Style="{StaticResource SidebarSubMenuCard}"
                                        Visibility="{Binding IsChecked, ElementName=MasterDataGroup,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Company Center"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="CompanyCenter"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="User Center"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="UserCenter"/>
                                    </StackPanel>
                                </Border>

                                <!-- SYSTEM (expandable) -->
                                <TextBlock Text="SYSTEM"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <ToggleButton x:Name="SystemGroup"
                                              Style="{StaticResource SidebarGroupToggle}"
                                              Content="System"
                                              Tag="&#xE713;"/>
                                <Border Style="{StaticResource SidebarSubMenuCard}"
                                        Visibility="{Binding IsChecked, ElementName=SystemGroup,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="System Center"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="SystemCenter"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Logs &amp; Activity"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Diagnostics"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Vertical scroll slider (preserved) -->
                        <Slider x:Name="ScrollSlider"
                                Grid.Column="1"
                                Style="{StaticResource GlassyVerticalSliderStyle}"
                                Margin="2,20,10,20"
                                Minimum="0" Maximum="1"
                                SmallChange="0.05" LargeChange="0.15"
                                ValueChanged="ScrollSlider_ValueChanged"/>
                    </Grid>

                    <!-- STORAGE FOOTER -->
                    <Border Grid.Row="1"
                            Margin="12,0,12,14"
                            Padding="14,12"
                            CornerRadius="12"
                            Background="{StaticResource StorageCardGradient}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="STORAGE"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock Text="{Binding StorageDisplay, FallbackValue=&apos;--&apos;}"
                                           HorizontalAlignment="Right"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </Grid>
                            <Border Height="6"
                                    Background="{DynamicResource BorderBrush}"
                                    CornerRadius="3">
                                <Border Width="180"
                                        HorizontalAlignment="Left"
                                        CornerRadius="3"
                                        Background="{StaticResource StorageBarGradient}"/>
                            </Border>
                            <TextBlock Text="{Binding StorageSubtitle, FallbackValue=&apos;Storage unavailable&apos;}"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- AI CHAT OVERLAY (preserved) -->
            <viewsAi:AiChatView DataContext="{Binding AiChatVM}"
                                Panel.ZIndex="200"/>

            <!-- AGENT CHAT OVERLAY (preserved) -->
            <Border Panel.ZIndex="210"
                    Width="520"
                    Margin="0,0,24,24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    MaxHeight="720"
                    CornerRadius="16"
                    ClipToBounds="True"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1.5"
                    Effect="{StaticResource DrawerLeftShadow}"
                    Visibility="{Binding IsAgentChatOpen,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <agentUi:AgentChatView DataContext="{Binding AgentChatVM}"/>
            </Border>

        </Grid>
    
        <!-- NON-BLOCKING USER-SWITCH POPUP. Floats over the shell; it is a
             single Popup inside the root Grid (not a second Window child),
             so StaysOpen=False lets clicking any module dismiss it. -->
        <Popup x:Name="UserSwitchPopup"
               PlacementTarget="{Binding ElementName=UserCardButton}"
               Placement="Bottom"
               VerticalOffset="10"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               IsOpen="{Binding IsUserSwitchOpen, Mode=TwoWay}"
               Opened="UserSwitchPopup_Opened"
               Closed="UserSwitchPopup_Closed">
            <viewsShared:UserSwitchPanel x:Name="UserSwitchPanelHost" Width="360"/>
        </Popup>
</Grid>
</Window>
