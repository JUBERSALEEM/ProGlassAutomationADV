<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
        xmlns:vmDashboard="clr-namespace:ProGlassAutomation.ViewModels.Dashboard"
        xmlns:vmProforma="clr-namespace:ProGlassAutomation.ViewModels.ProformaInvoice"
        xmlns:vmAbout="clr-namespace:ProGlassAutomation.ViewModels.About"
        xmlns:viewsDashboard="clr-namespace:ProGlassAutomation.Views.Dashboard"
        xmlns:viewsProforma="clr-namespace:ProGlassAutomation.Views.ProformaInvoice"
        xmlns:viewsAbout="clr-namespace:ProGlassAutomation.Views.About"
        Title="ProGlass Automation"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- ViewModel-to-View mapping -->
        <DataTemplate DataType="{x:Type vmDashboard:DashboardViewModel}">
            <viewsDashboard:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProforma:ProformaInvoiceViewModel}">
            <viewsProforma:ProformaInvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmAbout:AboutViewModel}">
            <viewsAbout:AboutView/>
        </DataTemplate>

        <!-- Floating circular button style -->
        <Style x:Key="FloatingButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="{DynamicResource OverlayButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OverlayButtonForegroundBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="25">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Opacity="0.35"
                                                  Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Menu Item Style -->
        <Style x:Key="SidebarMenuItemStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,3,10,3"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Current module fills entire window -->
        <ContentControl Content="{Binding CurrentViewModel}"/>

        <!-- Dim overlay -->
        <Rectangle Fill="Black" Opacity="0.4"
                   MouseLeftButtonDown="DimOverlay_MouseLeftButtonDown">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>

        <!-- Left Drawer (Menu) -->
        <Border Width="270"
                HorizontalAlignment="Left"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                CornerRadius="0,18,18,0"
                Panel.ZIndex="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.35" Color="Black"/>
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Margin="0,90,0,0">
                <TextBlock Text="MENU"
                           Margin="22,0,0,14"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                <Button Style="{StaticResource SidebarMenuItemStyle}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Dashboard">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="18,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#128200;" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Dashboard" Margin="14,0,0,0" FontSize="14" FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Style="{StaticResource SidebarMenuItemStyle}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="ProformaInvoice">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="18,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#128221;" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Proforma Invoice" Margin="14,0,0,0" FontSize="14" FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- Right Drawer (Settings) -->
        <Border Width="300"
                HorizontalAlignment="Right"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                Panel.ZIndex="10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Margin="20,80,20,0">
                <TextBlock Text="SETTINGS" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,0,0,20"/>
                <DockPanel Margin="0,0,0,15">
                    <TextBlock Text="Dark Mode" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <ToggleButton HorizontalAlignment="Right"
                                  IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                  Width="50" Height="24" Cursor="Hand"/>
                </DockPanel>
                <Separator Margin="0,10"/>
                <Button Content="Close Settings" Height="40" Margin="0,10,0,0"
                        Background="{DynamicResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Command="{Binding ToggleSettingsCommand}"/>
            </StackPanel>
        </Border>

        <!-- Floating Hamburger Button -->
        <Button Style="{StaticResource FloatingButtonStyle}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="15" Content="&#9776;"
                Command="{Binding ToggleMenuCommand}"
                ToolTip="Menu" Panel.ZIndex="100"/>

        <!-- Floating Top-Right Group: Logo + Info Button -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="15" Panel.ZIndex="100">
            <Button Style="{StaticResource FloatingButtonStyle}"
                    Width="90" Content="ProGlass" FontSize="13"
                    Command="{Binding ToggleSettingsCommand}"
                    ToolTip="Settings" Margin="0,0,10,0"/>
            <Button Style="{StaticResource FloatingButtonStyle}"
                    Content="&#8505;" FontSize="24"
                    Command="{Binding ShowAboutCommand}"
                    ToolTip="About"/>
        </StackPanel>
    </Grid>
</Window>