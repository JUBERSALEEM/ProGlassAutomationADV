<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
        xmlns:vmDashboard="clr-namespace:ProGlassAutomation.ViewModels.Dashboard"
        xmlns:vmProforma="clr-namespace:ProGlassAutomation.ViewModels.ProformaInvoice"
        xmlns:vmAbout="clr-namespace:ProGlassAutomation.ViewModels.About"
        xmlns:vmSheetStore="clr-namespace:ProGlassAutomation.ViewModels.SheetStore"
        xmlns:vmJobOrder="clr-namespace:ProGlassAutomation.ViewModels.JobOrder"
        xmlns:vmOptimization="clr-namespace:ProGlassAutomation.ViewModels.Optimization"
        xmlns:vmProduction="clr-namespace:ProGlassAutomation.ViewModels.Production"
        xmlns:vmDelivery="clr-namespace:ProGlassAutomation.ViewModels.DeliveryNote"
        xmlns:vmTaxInvoice="clr-namespace:ProGlassAutomation.ViewModels.TaxInvoice"
        xmlns:vmReports="clr-namespace:ProGlassAutomation.ViewModels.Reports"
        xmlns:viewsDashboard="clr-namespace:ProGlassAutomation.Views.Dashboard"
        xmlns:viewsProforma="clr-namespace:ProGlassAutomation.Views.ProformaInvoice"
        xmlns:viewsAbout="clr-namespace:ProGlassAutomation.Views.About"
        xmlns:viewsSheetStore="clr-namespace:ProGlassAutomation.Views.SheetStore"
        xmlns:viewsJobOrder="clr-namespace:ProGlassAutomation.Views.JobOrder"
        xmlns:viewsOptimization="clr-namespace:ProGlassAutomation.Views.Optimization"
        xmlns:viewsProduction="clr-namespace:ProGlassAutomation.Views.Production"
        xmlns:viewsDelivery="clr-namespace:ProGlassAutomation.Views.DeliveryNote"
        xmlns:viewsTaxInvoice="clr-namespace:ProGlassAutomation.Views.TaxInvoice"
        xmlns:viewsReports="clr-namespace:ProGlassAutomation.Views.Reports"
        xmlns:viewsAi="clr-namespace:ProGlassAutomation.Views.AI"
        Title="ProGlass Automation"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/favicon.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- ============ ViewModel -> View mappings ============ -->
        <DataTemplate DataType="{x:Type vmDashboard:DashboardViewModel}">
            <viewsDashboard:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProforma:ProformaInvoiceViewModel}">
            <viewsProforma:ProformaInvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmAbout:AboutViewModel}">
            <viewsAbout:AboutView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSheetStore:SheetStoreViewModel}">
            <viewsSheetStore:SheetStoreView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmJobOrder:JobOrderViewModel}">
            <viewsJobOrder:JobOrderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmOptimization:OptimizationViewModel}">
            <viewsOptimization:OptimizationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:CuttingViewModel}">
            <viewsProduction:CuttingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:HolesCutoutsViewModel}">
            <viewsProduction:HolesCutoutsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:PolishViewModel}">
            <viewsProduction:PolishView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:EdgeDeletionViewModel}">
            <viewsProduction:EdgeDeletionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:MitringViewModel}">
            <viewsProduction:MitringView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:TemperingViewModel}">
            <viewsProduction:TemperingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:PairingViewModel}">
            <viewsProduction:PairingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:DoublingLaminationViewModel}">
            <viewsProduction:DoublingLaminationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmDelivery:DeliveryNoteViewModel}">
            <viewsDelivery:DeliveryNoteView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmTaxInvoice:TaxInvoiceViewModel}">
            <viewsTaxInvoice:TaxInvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmReports:SalesReportViewModel}">
            <viewsReports:SalesReportView/>
        </DataTemplate>

        <!-- ============ TOP BAR ICON BUTTON ============ -->
        <Style x:Key="TopBarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity"
                                        Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ SIDEBAR ITEM STYLES ============ -->
        <Style x:Key="SidebarGroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="22,20,0,8"/>
        </Style>

        <ControlTemplate x:Key="SidebarItemTemplate" TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{TemplateBinding Tag}"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{TemplateBinding Content}"
                               Margin="14,0,0,0"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background"
                            Value="{DynamicResource MenuHoverBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="SidebarItemStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,3,10,3"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template"
                    Value="{StaticResource SidebarItemTemplate}"/>
        </Style>

        <!-- =========================================================== -->
        <!-- GLASSY VERTICAL SLIDER                                        -->
        <!-- =========================================================== -->
        <Style x:Key="GlassySliderThumbStyle" TargetType="Thumb">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Width="22" Height="22" Fill="White"/>
                            <Ellipse Width="8" Height="8">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0"
                                                         EndPoint="1,1">
                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                        <GradientStop Color="#EC4899" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvisibleRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassyVerticalSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">
                            <Border Width="14" CornerRadius="7"
                                    Background="{DynamicResource MenuHoverBrush}"
                                    Opacity="0.6"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="14"
                                        CornerRadius="7,7,0,0"
                                        Height="{Binding ElementName=PART_Track,
                                            Path=Thumb.ActualHeight,
                                            FallbackValue=22}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0"
                                                             EndPoint="0,1">
                                            <GradientStop Color="#8B5CF6" Offset="0"/>
                                            <GradientStop Color="#EC4899" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Style="{StaticResource InvisibleRepeatButton}"
                                        Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource GlassySliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        Style="{StaticResource InvisibleRepeatButton}"
                                        Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================================================== -->
        <!-- MODERN iOS-STYLE TOGGLE SWITCH                               -->
        <!-- =========================================================== -->
        <Style x:Key="ModernToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track"
                                    CornerRadius="14"
                                    Background="{TemplateBinding Background}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0"
                                                      Opacity="0.15" Color="Black"/>
                                </Border.Effect>
                            </Border>
                            <TextBlock x:Name="OffLabel" Text="OFF"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,0"/>
                            <TextBlock x:Name="OnLabel" Text="ON"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="9,0,0,0"
                                       Opacity="0"/>
                            <Ellipse x:Name="Thumb"
                                     Width="22" Height="22" Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1"
                                                      Opacity="0.3" Color="Black"/>
                                </Ellipse.Effect>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ThumbTransform"
                                                Storyboard.TargetProperty="X"
                                                To="28" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetName="OffLabel"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation
                                                Storyboard.TargetName="OnLabel"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1" Duration="0:0:0.15"/>
                                            <ColorAnimation
                                                Storyboard.TargetName="Track"
                                                Storyboard.TargetProperty=
                                                    "(Border.Background).(SolidColorBrush.Color)"
                                                To="#10B981" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ThumbTransform"
                                                Storyboard.TargetProperty="X"
                                                To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetName="OffLabel"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation
                                                Storyboard.TargetName="OnLabel"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0" Duration="0:0:0.15"/>
                                            <ColorAnimation
                                                Storyboard.TargetName="Track"
                                                Storyboard.TargetProperty=
                                                    "(Border.Background).(SolidColorBrush.Color)"
                                                To="#CBD5E1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ SETTINGS SECTION HEADER ============ -->
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ============ SETTINGS SECONDARY BUTTON ============ -->
        <Style x:Key="SettingsSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background"
                    Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="8"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ SETTINGS PRIMARY BUTTON ============ -->
        <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background"
                    Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity"
                                        Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity"
                                        Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════
             TOP BAR
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}"
                Panel.ZIndex="50">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2"
                                  Opacity="0.15" Color="Black" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Hamburger -->
                <Button Grid.Column="0"
                        Style="{StaticResource TopBarIconButtonStyle}"
                        Content="&#9776;"
                        Command="{Binding ToggleMenuCommand}"
                        ToolTip="Menu"
                        Margin="12,0,4,0"/>

                <!-- Logo + Brand -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <Grid Width="36" Height="36" VerticalAlignment="Center">
                        <Grid.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0"
                                              Opacity="0.35" Color="#4338CA"/>
                        </Grid.Effect>
                        <Border CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4338CA" Offset="0"/>
                                    <GradientStop Color="#6366F1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Path Stroke="White" StrokeThickness="1.8"
                              Fill="#33FFFFFF"
                              Data="M 18,7 L 27,18 L 18,29 L 9,18 Z"
                              StrokeLineJoin="Round"/>
                        <Path Stroke="White" StrokeThickness="1" Opacity="0.8"
                              Data="M 18,7 L 18,29 M 9,18 L 27,18"
                              StrokeLineJoin="Round"/>
                        <Ellipse Width="5" Height="5" Fill="#10B981"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,3,3,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0"
                                                  Opacity="0.9" Color="#10B981"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="PROGLASS"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="AUTOMATION"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Module Badge -->
                <Border Grid.Column="2"
                        Background="#047857"
                        CornerRadius="12"
                        Padding="12,4"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0">
                    <TextBlock Text="MODULE"
                               FontSize="11" FontWeight="Bold"
                               Foreground="White"/>
                </Border>

                <!-- Right: Settings + About -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Style="{StaticResource TopBarIconButtonStyle}"
                            Content="&#9881;" FontSize="20"
                            Command="{Binding ToggleSettingsCommand}"
                            ToolTip="Settings"
                            Margin="0,0,4,0"/>
                    <Button Style="{StaticResource TopBarIconButtonStyle}"
                            Content="&#8505;" FontSize="20"
                            Command="{Binding ShowAboutCommand}"
                            ToolTip="About"
                            Margin="0,0,4,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             MAIN CONTENT AREA
        ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- Current module -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}">
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </Border>

            <!-- Dim overlay -->
            <Rectangle Fill="Black" Opacity="0.45"
                       MouseLeftButtonDown="DimOverlay_MouseLeftButtonDown">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMenuOpen}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSettingsOpen}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>

            <!-- ════════════════════════════════════════════════
                 LEFT DRAWER — NAVIGATION MENU
                 NEW ORDER:
                   MAIN        → Dashboard
                   INVENTORY   → Sheet Store
                   SALES       → Proforma Invoice
                                 Job Order
                   PRODUCTION  → Optimization
                                 Cutting
                                 Holes & Cutouts
                                 Polish
                                 Edge Deletion
                                 Mitring
                                 Tempering
                                 Pairing
                                 Doubling / Lamination
                   DISPATCH    → Delivery Note
                                 Tax Invoice
                   REPORTS     → Sales Report
            ════════════════════════════════════════════════ -->
            <Border Width="290"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    CornerRadius="0,16,16,0"
                    Panel.ZIndex="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4"
                                      Opacity="0.2" Color="Black" Direction="0"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMenuOpen}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer x:Name="MenuScrollViewer"
                                  Grid.Column="0"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  ScrollChanged="MenuScrollViewer_ScrollChanged">
                        <StackPanel Margin="0,20,0,20">

                            <!-- ─── MAIN ─── -->
                            <TextBlock Text="MAIN"
                                       Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Dashboard" Tag="&#128200;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Dashboard"/>

                            <!-- ─── INVENTORY ─── -->
                            <TextBlock Text="INVENTORY"
                                       Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Sheet Store" Tag="&#128230;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="SheetStore"/>

                            <!-- ─── SALES ─── -->
                            <TextBlock Text="SALES"
                                       Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Proforma Invoice" Tag="&#128221;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="ProformaInvoice"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Job Order" Tag="&#128203;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="JobOrder"/>

                            <!-- ─── PRODUCTION ─── -->
                            <TextBlock Text="PRODUCTION"
                                       Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Optimization" Tag="&#9881;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Optimization"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Cutting" Tag="&#9986;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Cutting"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Holes &amp; Cutouts" Tag="&#128371;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="HolesCutouts"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Polish" Tag="&#10024;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Polish"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Edge Deletion" Tag="&#128208;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="EdgeDeletion"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Mitring" Tag="&#128314;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Mitring"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Tempering" Tag="&#128293;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Tempering"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Pairing" Tag="&#128279;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Pairing"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Doubling / Lamination" Tag="&#128218;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="DoublingLamination"/>

                            <!-- ─── DISPATCH ─── -->
                            <TextBlock Text="DISPATCH"
                                       Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Delivery Note" Tag="&#128666;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="DeliveryNote"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Tax Invoice" Tag="&#129534;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="TaxInvoice"/>

                            <!-- ─── REPORTS ─── -->
                            <TextBlock Text="REPORTS"
                                       Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Sales Report" Tag="&#128202;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="SalesReport"/>

                        </StackPanel>
                    </ScrollViewer>

                    <Slider x:Name="ScrollSlider"
                            Grid.Column="1"
                            Style="{StaticResource GlassyVerticalSliderStyle}"
                            Margin="4,20,10,20"
                            Minimum="0" Maximum="1"
                            SmallChange="0.05" LargeChange="0.15"
                            ValueChanged="ScrollSlider_ValueChanged"/>
                </Grid>
            </Border>

            <!-- ============ RIGHT DRAWER (SETTINGS) ============ -->
            <Border Width="320"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    CornerRadius="16,0,0,16"
                    Panel.ZIndex="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4"
                                      Opacity="0.2" Color="Black" Direction="180"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsOpen}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,24,24,24">

                        <TextBlock Text="SETTINGS"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Margin="0,0,0,24"/>

                        <!-- APPEARANCE -->
                        <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="APPEARANCE"
                                           Style="{StaticResource SettingsSectionHeaderStyle}"/>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="☀" FontSize="16"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Dark Mode"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </StackPanel>
                                    <ToggleButton HorizontalAlignment="Right"
                                                  IsChecked="{Binding IsDarkTheme,
                                                      Mode=TwoWay}"
                                                  Style="{StaticResource ModernToggleSwitch}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- AI ASSISTANT -->
                        <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="AI ASSISTANT"
                                           Style="{StaticResource SettingsSectionHeaderStyle}"/>

                                <DockPanel Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="🤖" FontSize="16"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Enable AI"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </StackPanel>
                                    <ToggleButton HorizontalAlignment="Right"
                                                  IsChecked="{Binding IsAiEnabled,
                                                      Mode=TwoWay}"
                                                  Style="{StaticResource ModernToggleSwitch}"/>
                                </DockPanel>

                                <TextBlock Text="GEMINI API KEY"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           Margin="0,0,0,6"/>
                                <PasswordBox x:Name="ApiKeyBox"
                                             Height="38" FontSize="12"
                                             Padding="10,8"
                                             PasswordChanged="ApiKeyBox_PasswordChanged"
                                             Background="{DynamicResource MenuHoverBrush}"
                                             Foreground="{DynamicResource PrimaryForegroundBrush}"
                                             BorderThickness="1"
                                             BorderBrush="{DynamicResource BorderBrush}"/>
                                <TextBlock Text="Get free key at aistudio.google.com"
                                           FontSize="10" FontStyle="Italic"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           Margin="0,6,0,12"/>

                                <Button Content="TEST CONNECTION"
                                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                                        Command="{Binding TestAiConnectionCommand}"
                                        Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding AiTestStatus}"
                                           FontSize="11" FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="CLOSE SETTINGS"
                                Style="{StaticResource SettingsPrimaryButtonStyle}"
                                Command="{Binding ToggleSettingsCommand}"
                                Margin="0,8,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- AI CHAT -->
            <viewsAi:AiChatView DataContext="{Binding AiChatVM}"
                                Panel.ZIndex="200"/>
        </Grid>
    </Grid>
</Window>