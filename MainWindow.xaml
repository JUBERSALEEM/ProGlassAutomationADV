<!-- ═══════════════════════════════════════════════════════════════════
     FILE: MainWindow.xaml
     PROJECT: ProGlassAutomation
     MODULE: Main Shell (Chat 24 v4.0 — theme-based redesign)

     VERSION: Chat 24 v4.0 — Full visual redesign matching the reference
     shell, adapted to the app's theme system (no hardcoded indigo).

     CHANGES vs v3.1:
       ✓ Top bar RESTRUCTURED to the modern SaaS pattern:
         Hamburger → Logo → Module Badge → Search →
         AI Agent pill → DateTime → Connectivity → Notifications →
         Settings → About → User card
       ✓ Sidebar sub-groups EXPAND/COLLAPSE with a rotating chevron and
         nested rounded card containers (Sales, Production, Dispatch,
         Reports, Master Data, System)
       ✓ Consistent 16px card radius + 1px border line across the shell
       ✓ Theme-based brushes (AccentBrush / tints / foregrounds) so every
         surface follows Light/Dark and the Monet/Professional families
       ✓ User card navigates to the USERS module (was Settings)

     PRESERVED (zero regression):
       ✓ All 23 DataTemplate module mappings (verbatim)
       ✓ All bindings, commands and property paths on MainViewModel
       ✓ All 3 code-behind handlers (names/signatures unchanged)
       ✓ Drawer model (hamburger toggles IsMenuOpen)
       ✓ Elevation caster pattern (empty Border for the shadow)
       ✓ AI Chat overlay + Agent Chat overlay
═══════════════════════════════════════════════════════════════════ -->

<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        xmlns:globalSearch="clr-namespace:ProGlassAutomation.Controls.GlobalSearch"
        xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
        xmlns:vmLicensing="clr-namespace:ProGlassAutomation.ViewModels.Licensing"
        xmlns:vmDashboard="clr-namespace:ProGlassAutomation.ViewModels.Dashboard"
        xmlns:vmProforma="clr-namespace:ProGlassAutomation.ViewModels.ProformaInvoice"
        xmlns:vmInquiry="clr-namespace:ProGlassAutomation.ViewModels.Inquiry"
        xmlns:viewsInquiry="clr-namespace:ProGlassAutomation.Views.Inquiry"
        xmlns:vmAbout="clr-namespace:ProGlassAutomation.ViewModels.About"
        xmlns:vmSettings="clr-namespace:ProGlassAutomation.ViewModels.Settings"
        xmlns:vmSheetStore="clr-namespace:ProGlassAutomation.ViewModels.SheetStore"
        xmlns:vmSpecifications="clr-namespace:ProGlassAutomation.ViewModels.Specifications"
        xmlns:vmJobOrder="clr-namespace:ProGlassAutomation.ViewModels.JobOrder"
        xmlns:vmOptimization="clr-namespace:ProGlassAutomation.ViewModels.Optimization"
        xmlns:vmProduction="clr-namespace:ProGlassAutomation.ViewModels.Production"
        xmlns:vmDelivery="clr-namespace:ProGlassAutomation.ViewModels.DeliveryNote"
        xmlns:vmTaxInvoice="clr-namespace:ProGlassAutomation.ViewModels.TaxInvoice"
        xmlns:vmReports="clr-namespace:ProGlassAutomation.ViewModels.Reports"
        xmlns:vmOrderReport="clr-namespace:ProGlassAutomation.ViewModels.Reports.OrderReport"
        xmlns:vmSystem="clr-namespace:ProGlassAutomation.ViewModels.SystemCenter"
        xmlns:vmCompany="clr-namespace:ProGlassAutomation.ViewModels.CompanyCenter"
        xmlns:vmUsers="clr-namespace:ProGlassAutomation.ViewModels.UserCenter"
        xmlns:vmJobProfit="clr-namespace:ProGlassAutomation.ViewModels.JobProfitability"
        xmlns:vmDiagnostics="clr-namespace:ProGlassAutomation.ViewModels.Diagnostics"
        xmlns:vmVatSubmission="clr-namespace:ProGlassAutomation.ViewModels.Reports.VatSubmission"
        xmlns:viewsDashboard="clr-namespace:ProGlassAutomation.Views.Dashboard"
        xmlns:viewsProforma="clr-namespace:ProGlassAutomation.Views.ProformaInvoice"
        xmlns:viewsAbout="clr-namespace:ProGlassAutomation.Views.About"
        xmlns:viewsLicensing="clr-namespace:ProGlassAutomation.Views.Licensing"
        xmlns:viewsSettings="clr-namespace:ProGlassAutomation.Views.Settings"
        xmlns:viewsSheetStore="clr-namespace:ProGlassAutomation.Views.SheetStore"
        xmlns:viewsSpecifications="clr-namespace:ProGlassAutomation.Views.Specifications"
        xmlns:viewsJobOrder="clr-namespace:ProGlassAutomation.Views.JobOrder"
        xmlns:viewsOptimization="clr-namespace:ProGlassAutomation.Views.Optimization"
        xmlns:viewsProduction="clr-namespace:ProGlassAutomation.Views.Production"
        xmlns:viewsDelivery="clr-namespace:ProGlassAutomation.Views.DeliveryNote"
        xmlns:viewsTaxInvoice="clr-namespace:ProGlassAutomation.Views.TaxInvoice"
        xmlns:viewsReports="clr-namespace:ProGlassAutomation.Views.Reports"
        xmlns:viewsStatementModule="clr-namespace:ProGlassAutomation.Views.Reports.StatementModule"
        xmlns:viewsOrderReport="clr-namespace:ProGlassAutomation.Views.Reports.OrderReport"
        xmlns:viewsAi="clr-namespace:ProGlassAutomation.Views.AI"
        xmlns:viewsShared="clr-namespace:ProGlassAutomation.Views.Shared"
        xmlns:agentUi="clr-namespace:ProGlassAutomation.Agent.UI"
        xmlns:viewsSystem="clr-namespace:ProGlassAutomation.Views.SystemCenter"
        xmlns:viewsCompany="clr-namespace:ProGlassAutomation.Views.CompanyCenter"
        xmlns:viewsUsers="clr-namespace:ProGlassAutomation.Views.UserCenter"
        xmlns:viewsJobProfit="clr-namespace:ProGlassAutomation.Views.JobProfitability"
        xmlns:viewsDiagnostics="clr-namespace:ProGlassAutomation.Views.Diagnostics"
        xmlns:viewsVatSubmission="clr-namespace:ProGlassAutomation.Views.Reports.VatSubmission"
        Title="{DynamicResource Shell.AppTitle}"
        Height="820" Width="1280"
        MinHeight="480" MinWidth="800"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource AppFontFamily}"
        Style="{StaticResource LiquidGlassWindow}"
        FontWeight="{DynamicResource AppFontWeight}"
        FontStyle="{DynamicResource AppFontStyle}"
        Icon="pack://application:,,,/favicon.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Auto"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════
         2026-09-02 — the XAML-instantiated DataContext was REMOVED.

         `<vm:MainViewModel/>` here made the BAML loader construct a
         SECOND, throw-away MainViewModel on every MainWindow creation,
         even though App.StartupCore already resolved one through DI and
         assigns it immediately after `new MainWindow()`. Two concrete
         consequences, both observed in production:

           1. CRASH ERR-633EEB — the XAML-built VM used the parameterless
              ctor, whose failures surface as TargetInvocationException
              from InitializeComponent() and kill startup. The DI path's
              own failure was already handled gracefully; this one was
              not recoverable because it happens inside XAML load.

           2. SPLASH COLOUR BOUNCE — MainViewModel's ctor calls
              ApplyModuleWallpaper("Dashboard") → VisualThemeEngine
              .ApplyModule(), which does ClearOverrides() then rebuilds
              the family. Every extra VM meant one extra full theme
              teardown/rebuild while the (Topmost, DynamicResource-bound)
              splash was on screen — the visible colour flash.

         DataContext is now assigned exactly once, in code: by
         App.StartupCore (DI instance) or by the MainWindow ctor fallback.
    ═══════════════════════════════════════════════════════════════ -->

    <Window.Resources>

        <!-- ═══════════════════════════════════════════════════════════════
             Shell styles extracted to Themes/Styles/ShellStyles.xaml
             (registered in App.xaml merged dictionaries).
             Only DataTemplates remain here (depend on local xmlns).
        ═══════════════════════════════════════════════════════════════ -->

        <DataTemplate DataType="{x:Type vmDashboard:DashboardViewModel}">
            <viewsDashboard:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmInquiry:InquiryListViewModel}">
            <viewsInquiry:InquiryListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProforma:ProformaInvoiceViewModel}">
            <viewsProforma:ProformaInvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmAbout:AboutViewModel}">
            <viewsAbout:AboutView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSettings:SettingsViewModel}">
            <viewsSettings:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSheetStore:SheetStoreViewModel}">
            <viewsSheetStore:SheetStoreView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSpecifications:SpecificationsCenterViewModel}">
            <viewsSpecifications:SpecificationsCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmJobOrder:JobOrderViewModel}">
            <viewsJobOrder:JobOrderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmOptimization:OptimizationViewModel}">
            <viewsOptimization:OptimizationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:CuttingViewModel}">
            <viewsProduction:CuttingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:HolesCutoutsViewModel}">
            <viewsProduction:HolesCutoutsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:PolishViewModel}">
            <viewsProduction:PolishView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:EdgeDeletionViewModel}">
            <viewsProduction:EdgeDeletionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:MitringViewModel}">
            <viewsProduction:MitringView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:TemperingViewModel}">
            <viewsProduction:TemperingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:PairingViewModel}">
            <viewsProduction:PairingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:DoublingLaminationViewModel}">
            <viewsProduction:DoublingLaminationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmDelivery:DeliveryNoteViewModel}">
            <viewsDelivery:DeliveryNoteView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmTaxInvoice:TaxInvoiceViewModel}">
            <viewsTaxInvoice:TaxInvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmReports:SalesReportViewModel}">
            <viewsReports:SalesReportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmReports:StatementModuleViewModel}">
            <viewsStatementModule:StatementModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmOrderReport:OrderReportModuleViewModel}">
            <viewsOrderReport:OrderReportModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSystem:SystemCenterViewModel}">
            <viewsSystem:SystemCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmCompany:CompanyCenterViewModel}">
            <viewsCompany:CompanyCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmUsers:UserCenterViewModel}">
            <viewsUsers:UserCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmJobProfit:JobProfitabilityViewModel}">
            <viewsJobProfit:JobProfitabilityView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmVatSubmission:VatSubmissionViewModel}">
            <viewsVatSubmission:VatSubmissionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmDiagnostics:DiagnosticsViewModel}">
            <viewsDiagnostics:DiagnosticsView/>
        </DataTemplate>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT LAYOUT
    ═══════════════════════════════════════════════════════════════ -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             TOP PANEL — single dark bar of rounded 14px pills:
             hamburger · logo · search · theme · AI agent · date/time ·
             connectivity · notifications · settings · screenshot ·
             record · user card.
        ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Height="48"
                Background="{DynamicResource GlassSurfaceElevated}"
                BorderBrush="{DynamicResource GlassBorderGradientSoft}"
                BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                Panel.ZIndex="50"
                SnapsToDevicePixels="True">
            <!-- Top bar glass composition: specular highlight at top edge -->
            <Grid>
                <Border Height="1" VerticalAlignment="Top"
                        Background="{DynamicResource GlassSpecularHighlight}"
                        Opacity="0.5" IsHitTestVisible="False"/>
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><!-- Hamburger -->
                        <ColumnDefinition Width="Auto"/><!-- Logo -->
                        <ColumnDefinition Width="*"/><!-- Search -->
                        <ColumnDefinition Width="Auto"/><!-- Right cluster -->
                    </Grid.ColumnDefinitions>

                    <!-- HAMBURGER -->
                    <Button Grid.Column="0"
                            Style="{StaticResource TopIconButton}"
                            Content="&#xE700;"
                            Command="{Binding ToggleMenuCommand}"
                            ToolTip="{DynamicResource ToolTip.ToggleMenu}"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Panel.ZIndex="80"
                            IsHitTestVisible="True"
                            Focusable="True"/>

                <!-- LOGO — click to open the About panel -->
                <StackPanel x:Name="LogoPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0"
                            Cursor="Hand"
                            behaviors:ClickToCommandBehavior.Command="{Binding LogoClickCommand}"
                            ToolTip="{DynamicResource ToolTip.About}">
                    <Border Width="36" Height="36"
                            CornerRadius="{StaticResource TopPillCornerRadius}"
                            Effect="{StaticResource LogoGlow}"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                        Stretch="UniformToFill"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{DynamicResource Shell.AppBrand}"
                                   FontSize="{StaticResource TextSubhead}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource Shell.AppSuiteTagline}"
                                   FontSize="{StaticResource TextXSmall}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- SEARCH — clearly visible: fills the middle column, framed
                     by the module-switch strip below. -->
                <Border Grid.Column="2"
                        MinWidth="280"
                        MaxWidth="520"
                        HorizontalAlignment="Stretch"
                        Margin="8,0"
                        VerticalAlignment="Center">
                    <globalSearch:GlobalSearchBar DataContext="{Binding GlobalSearchVM}"/>
                </Border>

                <!-- RIGHT CLUSTER -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">

                    <!-- Subtle divider before the action icons -->
                    <Border Width="1" Height="28" VerticalAlignment="Center"
                            Background="{DynamicResource DividerBrush}"
                            Margin="0,0,16,0"/>

                    <!-- DARK MODE TOGGLE — moved from Appearance to the top
                         bar, before the AI agent pill. -->
                    <Button x:Name="DarkModeButton"
                            Margin="0,0,10,0"
                            ToolTip="{DynamicResource ToolTip.ToggleTheme}"
                            Command="{Binding ToggleThemeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TopIconButton}">
                                <Setter Property="Content" Value="&#xE708;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                        <Setter Property="Content" Value="&#xE706;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- AI BOT ICON — opens the floating AI chat.
                         2026-08-25: moved here from the bottom-right
                         FloatingBot. That button's custom mouse-capture
                         drag code crashed the app on some machines and
                         its translate-transform clamp made it look
                         "fixed" (it never moved). As a top-panel button
                         it cannot crash the shell or get lost, and it
                         sits right before the AI AGENT pill. -->
                    <Button x:Name="AiBotButton"
                            Margin="0,0,10,0"
                            ToolTip="{DynamicResource ToolTip.AiChat}"
                            Command="{Binding AiChatVM.ToggleChatCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TopIconButton}">
                                <Setter Property="Content" Value="&#xE99A;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AiChatVM.IsOpen}" Value="True">
                                        <Setter Property="Content" Value="&#xE711;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- AI AGENT PILL — a real Button (theme-based accent) -->
                    <Button Style="{StaticResource TopAiPillStyle}"
                            Margin="0,0,10,0"
                            Command="{Binding ToggleAgentChatCommand}"
                            ToolTip="{DynamicResource ToolTip.Agent}"/>

                    <!-- DATE/TIME PILL -->
                    <Border Height="36"
                            Background="{DynamicResource MenuHoverBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                            CornerRadius="{StaticResource TopPillCornerRadius}"
                            Padding="10,0"
                            Margin="0,0,10,0"
                            SnapsToDevicePixels="True"
                            ToolTip="{DynamicResource ToolTip.DateTime}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource TopPillCornerRadius}"
                                    Background="{DynamicResource DateTimeIconGradient}"
                                    Margin="0,0,10,0">
                                <TextBlock Text="&#xE787;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextBodyLarge}"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentDateText}"
                                           Style="{StaticResource TopPillCaptionStyle}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBlock Text="{Binding CurrentTimeText}"
                                           Style="{StaticResource TopPillTitleStyle}"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CONNECTIVITY PILL -->
                    <Border Height="36"
                            CornerRadius="{StaticResource TopPillCornerRadius}"
                            Padding="12,0"
                            Margin="0,0,10,0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                            SnapsToDevicePixels="True"
                            ToolTip="{DynamicResource ToolTip.NetworkState}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextBodyLarge}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE701;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                <Setter Property="Text" Value="&#xE8CD;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ConnectivityLabel}"
                                       Style="{StaticResource TopPillTitleStyle}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- NOTIFICATION BELL — hover to peek, click to toggle -->
                    <Grid Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Button x:Name="NotificationButton"
                                Style="{StaticResource TopIconButton}"
                                Content="&#xEA8F;"
                                Command="{Binding TogglePopupCommand}" CommandParameter="Notifications"
                                ToolTip="{DynamicResource ToolTip.RecentActivity}"/>
                        <Ellipse Width="10" Height="10"
                                 Fill="{DynamicResource DangerBrush}"
                                 Stroke="{DynamicResource OnAccentForegroundBrush}"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,6,6,0"
                                 IsHitTestVisible="False"/>
                    </Grid>

                    <!-- SETTINGS — hover to peek, click to toggle -->
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource TopIconButton}"
                            Content="&#xE713;"
                            Command="{Binding TogglePopupCommand}" CommandParameter="Settings"
                            ToolTip="{DynamicResource ToolTip.Settings}"
                            Margin="0,0,10,0"/>

                    <!-- SCREENSHOT — dedicated capture (separate from About) -->
                    <Button x:Name="ScreenshotButton"
                            Style="{StaticResource TopIconButton}"
                            Content="&#xEB9F;"
                            Command="{Binding TogglePopupCommand}" CommandParameter="Screenshot"
                            ToolTip="{DynamicResource ToolTip.Screenshot}"
                            Margin="0,0,10,0"/>

                    <!-- SCREEN RECORD — independent of Demo Center walks -->
                    <Button x:Name="RecordButton"
                            Command="{Binding TogglePopupCommand}" CommandParameter="ScreenRecord"
                            ToolTip="{DynamicResource ToolTip.ScreenRecording}"
                            AutomationProperties.AutomationId="Shell.ScreenRecord"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TopIconButton}">
                                <Setter Property="Content" Value="&#xE714;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScreenRecordVM.IsRecording}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- USER CARD — opens a NON-BLOCKING user-switch popup.
                         Single click opens; double-click (or clicking another
                         module) closes. The popup floats over the shell and
                         never blocks the module content behind it. -->
                    <Button x:Name="UserCardButton"
                            Background="Transparent"
                            BorderThickness="{DynamicResource Border.NoneThickness}"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Command="{Binding TogglePopupCommand}" CommandParameter="UserSwitch"
                            ToolTip="{DynamicResource ToolTip.SwitchUser}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg"
                                        Height="36"
                                        Background="{DynamicResource MenuHoverBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="{DynamicResource Border.HairlineThickness}"
                                        CornerRadius="{StaticResource TopPillCornerRadius}"
                                        Padding="6,0,14,0"
                                        SnapsToDevicePixels="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="30" Height="30"
                                                CornerRadius="{StaticResource TopPillCornerRadius}"
                                                Background="{DynamicResource AvatarGradient}"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="{Binding CurrentUserInitials, FallbackValue=&apos;?&apos;}"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                       FontSize="{StaticResource TextBody}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentUserDisplayName, FallbackValue=&apos;User&apos;}"
                                                       Style="{StaticResource TopPillTitleStyle}"
                                                       FontSize="{StaticResource TextBody}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="120"/>
                                            <TextBlock Text="{Binding CurrentUserRole, FallbackValue=&apos;User&apos;}"
                                                       Style="{StaticResource TopPillCaptionStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="120"/>
                                        </StackPanel>
                                        <TextBlock Text="&#xE70D;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT AREA
        ═══════════════════════════════════════════════════════════════ -->

        <Grid Grid.Row="1">

            <!-- ELEVATION CASTER — removed for edge-to-edge iOS glass -->

            <!-- CONTENT CARD — iOS glass: transparent, minimal margin -->
            <Border Background="Transparent"
                    BorderBrush="{DynamicResource GlassBorderSoft}"
                    BorderThickness="{DynamicResource Border.NoneThickness}"
                    CornerRadius="{DynamicResource Radius.None}"
                    Margin="0"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Border CornerRadius="{DynamicResource CardCornerRadius}"
                            Background="{DynamicResource ModuleWallpaperBrush}"
                            IsHitTestVisible="False"/>
                    <!-- Phase 4: Smooth fade-in transition on module navigation.
                         ContentTransitionBehavior fades the new view in with a
                         subtle upward drift (150ms, QuinticEase), giving
                         navigation a polished, modern feel. -->
                    <ContentControl Content="{Binding CurrentViewModel}"
                                    behaviors:ContentTransitionBehavior.IsEnabled="True">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Opacity" Value="1"/>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </Border>

            <!-- DIM OVERLAY (only when the drawer is open) -->
            <Rectangle Fill="{DynamicResource LiquidOverlayBrush}" Opacity="0.35"
                       behaviors:ClickToCommandBehavior.Command="{Binding CloseAllPopupsCommand}">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>

            <!-- ═══════════════════════════════════════════════════════
                 LEFT DRAWER — REDESIGNED SIDEBAR (all groups expandable)
            ═══════════════════════════════════════════════════════════ -->

            <Border Width="292"
                    HorizontalAlignment="Left"
                    Margin="12"
                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                    CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                    Background="{DynamicResource ShellLiquidBrush}"
                    BorderBrush="{DynamicResource GlassBorderGradientCrystal}"
                    Panel.ZIndex="10"
                    Effect="{DynamicResource ShadowElevated}"
                    SnapsToDevicePixels="True"
                    ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top sheen (clipped by the drawer radius) -->
                    <Border Grid.RowSpan="2" Height="1" VerticalAlignment="Top"
                            Background="{DynamicResource ShellSheenBrush}"
                            IsHitTestVisible="False"/>

                <!-- Accent edge — modern 2050 top accent line -->
                <Border Grid.Row="0" VerticalAlignment="Top" Height="3"
                        CornerRadius="{DynamicResource Radius.XSmall}"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Drawer header — brand mark + close affordance
                     (uses the long-available Shell.Menu / Shell.DrawerClose
                     keys that the original drawer design planned). The
                     header sits in row 0 so the accent edge stays pinned
                     to the very top of the panel. -->
                <Grid Grid.Row="0" Margin="16,10,12,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource AvatarGradient}"
                                Margin="0,0,10,0"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="&#xE700;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Shell.Menu}"
                                       FontSize="{StaticResource TextBody}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="{DynamicResource Shell.AppSuiteTagline}"
                                       FontSize="{StaticResource TextXSmall}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource TopIconButton}"
                            Content="&#xE711;"
                            Command="{Binding ToggleMenuCommand}"
                            ToolTip="{DynamicResource Shell.DrawerClose}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <ScrollViewer x:Name="MenuScrollViewer"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      IsDeferredScrollingEnabled="False"
                                      PanningMode="VerticalOnly"
                                      Focusable="False"
                                      FocusVisualStyle="{x:Null}"
                                      behaviors:SmoothScrollBehavior.IsEnabled="True">
                            <StackPanel Margin="0,6,0,16">

                                <!-- MAIN -->
                                <TextBlock Text="{DynamicResource Nav.GroupMain}"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <Button Style="{StaticResource SidebarNavItem}"
                                        Content="{DynamicResource Nav.Dashboard}"
                                        Tag="&#xE80F;"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="Dashboard"/>

                                <!-- INVENTORY -->
                                <TextBlock Text="{DynamicResource Nav.GroupInventory}"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <Button Style="{StaticResource SidebarNavItem}"
                                        Content="{DynamicResource Nav.SheetStore}"
                                        Tag="&#xE7B8;"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="SheetStore"/>
                                <Button Style="{StaticResource SidebarNavItem}"
                                        Content="{DynamicResource Nav.Specifications}"
                                        Tag="&#xE8F1;"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="Specifications"/>

                                <!-- SALES (expandable) -->
                                <TextBlock Text="{DynamicResource Nav.GroupSales}"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <StackPanel x:Name="SalesGroupHost">
                                <ToggleButton x:Name="SalesGroup"
                                              Style="{StaticResource SidebarGroupToggle}"
                                              Content="{DynamicResource Nav.SalesOrders}"
                                              Tag="&#xE8A5;"
                                              behaviors:AccordionBehavior.Group="Sidebar"/>
                                <Border Style="{StaticResource SidebarSubMenuCard}"
                                        Visibility="{Binding IsChecked, ElementName=SalesGroup,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.Inquiry}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Inquiry"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.ProformaInvoice}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="ProformaInvoice"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.JobOrder}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="JobOrder"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.TaxInvoice}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="TaxInvoice"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- PRODUCTION (expandable) -->
                                <TextBlock Text="{DynamicResource Nav.GroupProduction}"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <StackPanel x:Name="ProductionGroupHost">
                                <ToggleButton x:Name="ProductionGroup"
                                              Style="{StaticResource SidebarGroupToggle}"
                                              Content="{DynamicResource Nav.ProductionItems}"
                                              Tag="&#xE8C6;"
                                              behaviors:AccordionBehavior.Group="Sidebar"/>
                                <Border Style="{StaticResource SidebarSubMenuCard}"
                                        Visibility="{Binding IsChecked, ElementName=ProductionGroup,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.Optimization}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Optimization"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.Cutting}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Cutting"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.HolesCutouts}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="HolesCutouts"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.Polish}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Polish"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.EdgeDeletion}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="EdgeDeletion"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.Mitring}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Mitring"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.Tempering}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Tempering"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.Pairing}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Pairing"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.DoublingLamination}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="DoublingLamination"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- DISPATCH (expandable) -->
                                <TextBlock Text="{DynamicResource Nav.GroupDispatch}"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <StackPanel x:Name="DispatchGroupHost">
                                <ToggleButton x:Name="DispatchGroup"
                                              Style="{StaticResource SidebarGroupToggle}"
                                              Content="{DynamicResource Nav.Dispatch}"
                                              Tag="&#xE7F4;"
                                              behaviors:AccordionBehavior.Group="Sidebar"/>
                                <Border Style="{StaticResource SidebarSubMenuCard}"
                                        Visibility="{Binding IsChecked, ElementName=DispatchGroup,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.DeliveryNote}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="DeliveryNote"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- FINANCE (expandable) -->
                                <TextBlock Text="{DynamicResource Nav.GroupFinance}"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <StackPanel x:Name="FinanceGroupHost">
                                <ToggleButton x:Name="FinanceGroup"
                                              Style="{StaticResource SidebarGroupToggle}"
                                              Content="{DynamicResource Nav.FinanceAccounting}"
                                              Tag="&#xE90E;"
                                              behaviors:AccordionBehavior.Group="Sidebar"/>
                                <Border Style="{StaticResource SidebarSubMenuCard}"
                                        Visibility="{Binding IsChecked, ElementName=FinanceGroup,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.StatementGenerator}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="StatementGenerator"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="Report Generator"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="OrderReport"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.JobProfitability}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="JobProfitability"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.VatSubmission}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="VatSubmission"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- REPORTS (expandable) -->
                                <TextBlock Text="{DynamicResource Nav.GroupReports}"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <StackPanel x:Name="ReportsGroupHost">
                                <ToggleButton x:Name="ReportsGroup"
                                              Style="{StaticResource SidebarGroupToggle}"
                                              Content="{DynamicResource Nav.Reports}"
                                              Tag="&#xE9F9;"
                                              behaviors:AccordionBehavior.Group="Sidebar"/>
                                <Border Style="{StaticResource SidebarSubMenuCard}"
                                        Visibility="{Binding IsChecked, ElementName=ReportsGroup,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.Overview}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="SalesReport"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.ProformaInvoice}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="PiReport"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.JobOrder}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="JoReport"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.Delivery}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="DeliveryReport"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.TaxInvoice}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="TaxInvoiceReport"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.Statement}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="StatementReport"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- MASTER DATA (expandable) -->
                                <TextBlock Text="{DynamicResource Nav.GroupMasterData}"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <StackPanel x:Name="MasterDataGroupHost">
                                <ToggleButton x:Name="MasterDataGroup"
                                              Style="{StaticResource SidebarGroupToggle}"
                                              Content="{DynamicResource Nav.MasterDataItems}"
                                              Tag="&#xE822;"
                                              behaviors:AccordionBehavior.Group="Sidebar"/>
                                <Border Style="{StaticResource SidebarSubMenuCard}"
                                        Visibility="{Binding IsChecked, ElementName=MasterDataGroup,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.CompanyCenter}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="CompanyCenter"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.UserCenter}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="UserCenter"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- SYSTEM (expandable) -->
                                <TextBlock Text="{DynamicResource Nav.GroupSystem}"
                                           Style="{StaticResource SidebarGroupLabel}"/>
                                <StackPanel x:Name="SystemGroupHost">
                                <ToggleButton x:Name="SystemGroup"
                                              Style="{StaticResource SidebarGroupToggle}"
                                              Content="{DynamicResource Nav.System}"
                                              Tag="&#xE713;"
                                              behaviors:AccordionBehavior.Group="Sidebar"/>
                                <Border Style="{StaticResource SidebarSubMenuCard}"
                                        Visibility="{Binding IsChecked, ElementName=SystemGroup,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.SystemCenter}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="SystemCenter"/>
                                        <Button Style="{StaticResource SidebarSubItem}"
                                                Content="{DynamicResource Nav.LogsActivity}"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Diagnostics"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                    </Grid>

                    <!-- STORAGE FOOTER — extracted to
                         Views/Shared/StorageSidebarCard.xaml (clickable:
                         opens the storage breakdown popup). The accent
                         gradient lives only in the thin bar, not the
                         whole card. -->
                    <viewsShared:StorageSidebarCard x:Name="StorageCard"
                                                    Grid.Row="1"/>
                </Grid>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 READ-ONLY BANNER (trial ended / grace period)

                 A slim, top-anchored strip that appears whenever
                 LicenseService.Current.ReadOnly is true — i.e. the
                 30-day trial has ended OR a paid license is in its
                 post-expiry grace period. The app is still fully
                 navigable (all data preserved), but write commands
                 are gated by ReadOnlyGate. The banner links straight
                 to Settings → License so the user can paste a
                 renewed key without hunting for the page.
                 ZIndex 5 sits ABOVE the module content card (implicit
                 ZIndex 0) but BELOW the sidebar drawer (ZIndex 10),
                 the license activation overlay (100), the AI chat
                 (200) and the agent chat (210), so the drawer and
                 any modal surface cover the banner cleanly when open
                 without the banner poking through their top edge.
            ═══════════════════════════════════════════════════════════ -->
            <Border x:Name="ReadOnlyBanner"
                    Panel.ZIndex="5"
                    Margin="16,16,16,0"
                    VerticalAlignment="Top"
                    Padding="16,10"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource TintAmberBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                    SnapsToDevicePixels="True"
                    Visibility="{Binding IsReadOnly,
                        Source={x:Static vmLicensing:LicenseStatusViewModel.Instance},
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextTitle}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Shell.ReadOnly}"
                                   FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding StatusDescription,
                                          Source={x:Static vmLicensing:LicenseStatusViewModel.Instance}}"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="{DynamicResource Shell.ActivateLicense}"
                            Padding="14,6"
                            VerticalAlignment="Center"
                            Command="{Binding OpenLicenseSettingsCommand}"
                            Background="{DynamicResource WarningBrush}"
                            Foreground="{DynamicResource OnAccentForegroundBrush}"
                            BorderThickness="{DynamicResource Border.NoneThickness}"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 LICENSE ACTIVATION OVERLAY (Commit 4 of the
                 licensing refactor)

                 Shown ONLY when LicenseStatusViewModel.IsLicenseRequired
                 is true — i.e. the licence is in a hard-broken state
                 (invalid signature/state, machine-mismatch, clock
                 rollback, or an expired paid license outside its signed
                 grace policy AND outside the machine's automatic trial
                 DORMANT SAFETY NET (2026-08-29): the app never
                 hard-blocks on a license state. LicenseService
                 normalizes every startup result to a runnable state
                 (valid license → automatic trial → read-only with data
                 preserved), so LicenseStatusViewModel.IsLicenseRequired
                 is always false and this overlay never appears. It is
                 kept only as a dormant safety net in case a future
                 status enum value falls through unnormalized.

                 Visibility is bound to
                 LicenseStatusViewModel.Instance.IsLicenseRequired
                 via x:Static. The VM is a singleton that
                 subscribes to LicenseService.StatusChanged,
                 so the overlay shows / hides automatically
                 when the user installs / removes a license —
                 no main-window code-behind glue needed.
            ═══════════════════════════════════════════════════════════ -->
            <Border x:Name="LicenseOverlay"
                    Panel.ZIndex="100"
                    Margin="16"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="{DynamicResource Border.StrongThickness}"
                    SnapsToDevicePixels="True"
                    Visibility="{Binding IsLicenseRequired,
                        Source={x:Static vmLicensing:LicenseStatusViewModel.Instance},
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!--
                      The activation view is itself a UserControl with
                      its own padding and chrome, so we just drop it
                      into the second row. The view's own StatusChanged
                      subscription keeps its current-license card up
                      to date; when the user successfully activates,
                      LicenseService.StatusChanged fires, the VM's
                      IsLicenseRequired flips to false, and the
                      overlay's Visibility binding hides this Border.
                    -->
                    <viewsLicensing:LicenseActivationView Grid.Row="1"
                                                          x:Name="LicenseActivationHost"
                                                          IsClosable="False"/>
                </Grid>
            </Border>

            <!-- AI CHAT OVERLAY (preserved) -->
            <viewsAi:AiChatView DataContext="{Binding AiChatVM}"
                                Panel.ZIndex="200"/>

            <!-- AGENT CHAT — floating card, bottom-right.
                 Outer border owns the drop shadow (must not ClipToBounds).
                 Inner border clips the chat chrome to the 16px radius so
                 the square UserControl fill cannot square-off the corners. -->
            <Border Panel.ZIndex="210"
                    Width="560"
                    Height="680"
                    MaxHeight="{Binding ActualHeight,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource WindowInsetConverter},
                                ConverterParameter=120}"
                    Margin="0,16,24,24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                    ClipToBounds="False"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    Effect="{DynamicResource ShadowElevated}"
                    Visibility="{Binding IsAgentChatOpen,
                        Converter={StaticResource BoolToVisibilityConverter},
                        FallbackValue=Collapsed,
                        TargetNullValue=Collapsed}">
                <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        ClipToBounds="True"
                        Background="{DynamicResource ModuleBackgroundBrush}">
                    <agentUi:AgentChatView DataContext="{Binding AgentChatVM}"/>
                </Border>
            </Border>

        </Grid>
    
        <!-- NON-BLOCKING USER-SWITCH POPUP. Floats over the shell; it is a
             single Popup inside the root Grid (not a second Window child),
             StaysOpen=True + the shell's click-outside handler lets clicking
             any module dismiss it. -->
        <Popup x:Name="UserSwitchPopup"
               PlacementTarget="{Binding ElementName=UserCardButton}"
               Placement="Bottom"
               VerticalOffset="8"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsUserSwitchOpen, Mode=TwoWay}"
               Opened="UserSwitchPopup_Opened"
               Closed="UserSwitchPopup_Closed">
            <viewsShared:UserSwitchPanel x:Name="UserSwitchPanelHost" Width="360"
                                        />
        </Popup>

        <!-- Quick-settings popup (non-blocking, same pattern as user card) -->
        <Popup x:Name="SettingsPopup"
               PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Bottom"
               VerticalOffset="8"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}">
            <viewsShared:QuickSettingsPanel x:Name="SettingsPanelHost" Width="360"
                                            />
        </Popup>

        <!-- About is NOT a popup: clicking the logo (LogoPanel) opens the full
             About module (rich AboutView) via ClickToCommandBehavior. -->

        <!-- Notifications / activity popup (non-blocking) -->
        <Popup x:Name="NotificationsPopup"
               PlacementTarget="{Binding ElementName=NotificationButton}"
               Placement="Bottom"
               VerticalOffset="8"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsNotificationsOpen, Mode=TwoWay}"
               Opened="NotificationsPopup_Opened">
            <viewsShared:ActivityPanel x:Name="ActivityPanelHost"
                                        />
        </Popup>

        <!-- Screenshot popup (dedicated, separate from About) -->
        <Popup x:Name="ScreenshotPopup"
               PlacementTarget="{Binding ElementName=ScreenshotButton}"
               Placement="Bottom"
               VerticalOffset="0"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsScreenshotOpen, Mode=TwoWay}">
            <viewsShared:ScreenshotPanel x:Name="ScreenshotPanelHost"
                                         />
        </Popup>

        <!-- Screen record popup (independent of Demo Center) -->
        <Popup x:Name="ScreenRecordPopup"
               PlacementTarget="{Binding ElementName=RecordButton}"
               Placement="Bottom"
               VerticalOffset="8"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsScreenRecordOpen, Mode=TwoWay}">
            <viewsShared:ScreenRecordPanel x:Name="ScreenRecordPanelHost"
                                           />
        </Popup>

        <!-- Storage breakdown popup — anchored to the sidebar storage
             card. Shows exactly which thing holds the storage fill
             (icon · module · covered storage). Click-outside guarded
             in MainWindow.xaml.cs, like the top-bar popups. -->
        <Popup x:Name="StoragePopup"
               PlacementTarget="{Binding ElementName=StorageCard}"
               Placement="Top"
               VerticalOffset="-8"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsStorageOpen, Mode=TwoWay}">
            <viewsShared:StorageDetailsPanel x:Name="StoragePanelHost"
                                             Width="380"/>
        </Popup>

        <!-- Liquid Glass catch-light removed — the top bar and sidebar
             now have their own layered glass composition. -->
</Grid>
</Window>
