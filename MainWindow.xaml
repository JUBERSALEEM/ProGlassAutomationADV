<!-- ═══════════════════════════════════════════════════════════════════
     FILE: MainWindow.xaml
     PROJECT: ProGlassAutomation
     MODULE: Main Shell (Chat 23 v3.1)
     VERSION: Chat 23 v3.1 — Settings extracted + sidebar pill hover

     CHANGES vs v3.0:
       ✓ REMOVED right settings drawer entirely (~200 lines of XAML)
       ✓ REMOVED settings-related styles that were only used in the
         drawer (ModernToggleSwitch, SettingsSectionHeaderStyle,
         SettingsSecondaryButtonStyle, SettingsPrimaryButtonStyle)
         — now live inside SettingsView.xaml as local resources
       ✓ Settings gear button on top bar now navigates to Settings
         MODULE (like About) instead of toggling a drawer
       ✓ Added DataTemplate mapping SettingsViewModel → SettingsView
       ✓ Sidebar items redesigned with PILL hover (per user request):
           • 4px left accent bar appears on hover
           • Background switches to tinted blue
           • CornerRadius 8 → 12 for softer pill feel
       ✓ Dim overlay still triggers on IsMenuOpen (settings no longer
         uses drawer, so IsSettingsOpen data trigger removed from overlay)

     PRESERVED (zero regression):
       • All 17 DataTemplate module mappings (+ new SettingsView)
       • Top bar layout (hamburger + logo + MODULE badge + settings/about icons)
       • Left drawer navigation menu (all 17 sidebar items)
       • Menu scroll ↔ slider sync (MenuScrollViewer + ScrollSlider names)
       • Glassy slider + thumb styles
       • Module frame border (from v3.0)
       • Ambient blue palette + frozen shadows/gradients
       • AI chat view floats above everything (Panel.ZIndex=200)
       • All code-behind handler names + signatures (except ApiKey handler
         which moves to SettingsView with same name)

     REGRESSION RISK: LOW
       Right drawer removal is clean — nothing else referenced it.
       Settings gear button re-wired to NavigateCommand("Settings").
       ApiKeyBox moved to SettingsView with its own handler.
═══════════════════════════════════════════════════════════════════════ -->

<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        xmlns:globalSearch="clr-namespace:ProGlassAutomation.Controls.GlobalSearch"
        xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
        xmlns:vmDashboard="clr-namespace:ProGlassAutomation.ViewModels.Dashboard"
        xmlns:vmProforma="clr-namespace:ProGlassAutomation.ViewModels.ProformaInvoice"
        xmlns:vmAbout="clr-namespace:ProGlassAutomation.ViewModels.About"
        xmlns:vmSettings="clr-namespace:ProGlassAutomation.ViewModels.Settings"
        xmlns:vmSheetStore="clr-namespace:ProGlassAutomation.ViewModels.SheetStore"
        xmlns:vmJobOrder="clr-namespace:ProGlassAutomation.ViewModels.JobOrder"
        xmlns:vmOptimization="clr-namespace:ProGlassAutomation.ViewModels.Optimization"
        xmlns:vmProduction="clr-namespace:ProGlassAutomation.ViewModels.Production"
        xmlns:vmDelivery="clr-namespace:ProGlassAutomation.ViewModels.DeliveryNote"
        xmlns:vmTaxInvoice="clr-namespace:ProGlassAutomation.ViewModels.TaxInvoice"
        xmlns:vmReports="clr-namespace:ProGlassAutomation.ViewModels.Reports"
        xmlns:vmSystem="clr-namespace:ProGlassAutomation.ViewModels.SystemCenter"
             xmlns:vmCompany="clr-namespace:ProGlassAutomation.ViewModels.CompanyCenter"
             xmlns:vmUsers="clr-namespace:ProGlassAutomation.ViewModels.UserCenter"
             xmlns:vmJobProfit="clr-namespace:ProGlassAutomation.ViewModels.JobProfitability"
        xmlns:vmDiagnostics="clr-namespace:ProGlassAutomation.ViewModels.Diagnostics"
        xmlns:viewsDashboard="clr-namespace:ProGlassAutomation.Views.Dashboard"
        xmlns:viewsProforma="clr-namespace:ProGlassAutomation.Views.ProformaInvoice"
        xmlns:viewsAbout="clr-namespace:ProGlassAutomation.Views.About"
        xmlns:viewsSettings="clr-namespace:ProGlassAutomation.Views.Settings"
        xmlns:viewsSheetStore="clr-namespace:ProGlassAutomation.Views.SheetStore"
        xmlns:viewsJobOrder="clr-namespace:ProGlassAutomation.Views.JobOrder"
        xmlns:viewsOptimization="clr-namespace:ProGlassAutomation.Views.Optimization"
        xmlns:viewsProduction="clr-namespace:ProGlassAutomation.Views.Production"
        xmlns:viewsDelivery="clr-namespace:ProGlassAutomation.Views.DeliveryNote"
        xmlns:viewsTaxInvoice="clr-namespace:ProGlassAutomation.Views.TaxInvoice"
        xmlns:viewsReports="clr-namespace:ProGlassAutomation.Views.Reports"
        xmlns:viewsAi="clr-namespace:ProGlassAutomation.Views.AI"
             xmlns:agentUi="clr-namespace:ProGlassAutomation.Agent.UI"
        xmlns:viewsSystem="clr-namespace:ProGlassAutomation.Views.SystemCenter"
             xmlns:viewsCompany="clr-namespace:ProGlassAutomation.Views.CompanyCenter"
             xmlns:viewsUsers="clr-namespace:ProGlassAutomation.Views.UserCenter"
             xmlns:viewsJobProfit="clr-namespace:ProGlassAutomation.Views.JobProfitability"
        xmlns:viewsDiagnostics="clr-namespace:ProGlassAutomation.Views.Diagnostics"
        Title="ProGlass Automation"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/favicon.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>

        <!-- ═══════════════════════════════════════════════════════════════
             INDUSTRIAL BLUE PALETTE (frozen once)
        ═══════════════════════════════════════════════════════════════ -->

        <SolidColorBrush x:Key="Navy"     Color="#1E3A8A" po:Freeze="True"/>
        <SolidColorBrush x:Key="Royal"    Color="#1D4ED8" po:Freeze="True"/>
        <SolidColorBrush x:Key="Sapphire" Color="#3B82F6" po:Freeze="True"/>
        <SolidColorBrush x:Key="Ice"      Color="#DBEAFE" po:Freeze="True"/>
        <SolidColorBrush x:Key="Frost"    Color="#BFDBFE" po:Freeze="True"/>
        <SolidColorBrush x:Key="ModuleFrameBorder"
                         Color="#C4D6ED" po:Freeze="True"/>

        <LinearGradientBrush x:Key="LogoBrandGradient"
                             StartPoint="0,0" EndPoint="1,1"
                             po:Freeze="True">
            <GradientStop Color="#1E3A8A" Offset="0"/>
            <GradientStop Color="#1D4ED8" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SliderTrackFillGradient"
                             StartPoint="0,0" EndPoint="0,1"
                             po:Freeze="True">
            <GradientStop Color="#1D4ED8" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SliderThumbInnerGradient"
                             StartPoint="0,0" EndPoint="1,1"
                             po:Freeze="True">
            <GradientStop Color="#1D4ED8" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════════════════════════════════════════════════════════
             SHARED FROZEN SHADOWS
        ═══════════════════════════════════════════════════════════════ -->

        <DropShadowEffect x:Key="TopBarShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Opacity="0.15" Color="Black" Direction="270"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="LogoGlow"
                          BlurRadius="8" ShadowDepth="0"
                          Opacity="0.35" Color="#1D4ED8"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="StatusDotGlow"
                          BlurRadius="4" ShadowDepth="0"
                          Opacity="0.9" Color="#3B82F6"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="DrawerLeftShadow"
                          BlurRadius="24" ShadowDepth="4"
                          Opacity="0.2" Color="Black" Direction="0"
                          po:Freeze="True"/>

        <!-- ═══════════════════════════════════════════════════════════════
             ViewModel → View mappings (17 modules + About + Settings)
        ═══════════════════════════════════════════════════════════════ -->

        <DataTemplate DataType="{x:Type vmDashboard:DashboardViewModel}">
            <viewsDashboard:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProforma:ProformaInvoiceViewModel}">
            <viewsProforma:ProformaInvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmAbout:AboutViewModel}">
            <viewsAbout:AboutView/>
        </DataTemplate>

        <!-- NEW v3.1: Settings module mapping -->
        <DataTemplate DataType="{x:Type vmSettings:SettingsViewModel}">
            <viewsSettings:SettingsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmSheetStore:SheetStoreViewModel}">
            <viewsSheetStore:SheetStoreView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmJobOrder:JobOrderViewModel}">
            <viewsJobOrder:JobOrderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmOptimization:OptimizationViewModel}">
            <viewsOptimization:OptimizationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:CuttingViewModel}">
            <viewsProduction:CuttingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:HolesCutoutsViewModel}">
            <viewsProduction:HolesCutoutsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:PolishViewModel}">
            <viewsProduction:PolishView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:EdgeDeletionViewModel}">
            <viewsProduction:EdgeDeletionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:MitringViewModel}">
            <viewsProduction:MitringView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:TemperingViewModel}">
            <viewsProduction:TemperingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:PairingViewModel}">
            <viewsProduction:PairingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:DoublingLaminationViewModel}">
            <viewsProduction:DoublingLaminationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmDelivery:DeliveryNoteViewModel}">
            <viewsDelivery:DeliveryNoteView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmTaxInvoice:TaxInvoiceViewModel}">
            <viewsTaxInvoice:TaxInvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmReports:SalesReportViewModel}">
            <viewsReports:SalesReportView/>
        </DataTemplate>

        <!-- NEW: System Center — user management + audit trail -->
        <DataTemplate DataType="{x:Type vmSystem:SystemCenterViewModel}">
            <viewsSystem:SystemCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmCompany:CompanyCenterViewModel}">
            <viewsCompany:CompanyCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmUsers:UserCenterViewModel}">
            <viewsUsers:UserCenterView/>
        </DataTemplate>

        <!-- PHASE C: Job Profitability — per-invoice profit portfolio -->
        <DataTemplate DataType="{x:Type vmJobProfit:JobProfitabilityViewModel}">
            <viewsJobProfit:JobProfitabilityView/>
        </DataTemplate>

        <!-- NEW: Logs & Activity — technical log + per-module activity -->
        <DataTemplate DataType="{x:Type vmDiagnostics:DiagnosticsViewModel}">
            <viewsDiagnostics:DiagnosticsView/>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════════
             TOP BAR ICON BUTTON
        ═══════════════════════════════════════════════════════════════ -->

        <!-- ═══════════════════════════════════════════════════════════
             TOP-BAR PILL BUTTONS  (spec supplied by the user)

             CornerRadius 20 · Height 40 · MinWidth 130 · Padding 22,0
             BorderBrush #4DFFFFFF @1 on solid pills
             Segoe MDL2 icons only - never emoji
             UPPERCASE text, FontSize 12, Bold, icon 13px, margin 0,0,10,0
             All four state triggers: hover / pressed / focus / disabled

             ICON-ONLY VARIANT: the top bar's settings, about and agent
             buttons carry a glyph and no label. They use the same shape
             and triggers with MinWidth 44 and symmetric padding, so they
             read as the same family rather than as leftover round
             buttons.
        ═══════════════════════════════════════════════════════════════ -->

        <!-- TopBarPillPrimary (labelled variant) intentionally NOT defined
             here: the top bar currently has no labelled buttons, and an
             unused style is dead code. The full labelled/Success/Outlined/
             Danger variants live in Styles/ButtonStyles.xaml where the rest
             of the app consumes them. -->

        <!-- Icon-only member of the same family (no label). -->
        <Style x:Key="TopBarPillIcon" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{DynamicResource MenuHoverBrush}"
                                BorderBrush="#33000000"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="0"
                                Height="40"
                                MinWidth="44"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#80FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3730A3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Legacy TopBarIconButtonStyle removed: every top-bar button
             now uses TopBarPillPrimary / TopBarPillIcon. Rule 7 of the
             pill spec - do not keep legacy toolbar/tab button styles. -->

        <!-- ═══════════════════════════════════════════════════════════════
             SIDEBAR ITEM — v3.1 PILL HOVER (per user request)
             Left accent bar (4px) appears on hover + tinted bg + rounded 12
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="SidebarGroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="22,20,0,8"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- v2: professional sidebar item — icon in a tinted badge inside a
             subtle card; hover lifts the card and shows the accent bar. -->
        <ControlTemplate x:Key="SidebarItemTemplate" TargetType="Button">
            <Grid>
                <Border x:Name="border"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,0"
                        SnapsToDevicePixels="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icon badge (tinted rounded square) -->
                        <Border x:Name="iconBadge"
                                Width="28" Height="28"
                                CornerRadius="8"
                                Background="{DynamicResource TintIndigoBrush}"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="{TemplateBinding Content}"
                                   Margin="12,0,0,0"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 4px left accent bar (visible on hover only) -->
                <Border x:Name="accentBar"
                        Width="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Margin="0,8,0,8"
                        CornerRadius="2"
                        Background="{DynamicResource AccentBrush}"
                        Opacity="0"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background"
                            Value="{DynamicResource MenuHoverBrush}"/>
                    <Setter TargetName="accentBar" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="SidebarItemStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,3,10,3"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template"
                    Value="{StaticResource SidebarItemTemplate}"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             GLASSY VERTICAL SLIDER
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="GlassySliderThumbStyle" TargetType="Thumb">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Width="22" Height="22" Fill="White"/>
                            <Ellipse Width="8" Height="8"
                                     Fill="{StaticResource SliderThumbInnerGradient}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvisibleRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassyVerticalSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">
                            <Border Width="14" CornerRadius="7"
                                    Background="{DynamicResource MenuHoverBrush}"
                                    Opacity="0.6"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="14"
                                        CornerRadius="7,7,0,0"
                                        Background="{StaticResource SliderTrackFillGradient}"
                                        Height="{Binding ElementName=PART_Track,
                                            Path=Thumb.ActualHeight,
                                            FallbackValue=22}"/>
                            </Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Style="{StaticResource InvisibleRepeatButton}"
                                        Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource GlassySliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        Style="{StaticResource InvisibleRepeatButton}"
                                        Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════
             TOP BAR
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}"
                Panel.ZIndex="50"
                Effect="{StaticResource TopBarShadow}"
                SnapsToDevicePixels="True">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Hamburger -->
                <!-- Rule 3: MDL2 hamburger (E700), not the U+9776 text glyph. -->
                <Button Grid.Column="0"
                        Style="{StaticResource TopBarPillIcon}"
                        Content="&#xE700;"
                        Command="{Binding ToggleMenuCommand}"
                        ToolTip="Menu"
                        Margin="12,0,4,0"/>

                <!-- Logo + Brand -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <!-- Real application icon. Replaces the hand-drawn Path
                         diamond that used to stand in for the brand mark.
                         Resources/proglass_icon_256.png is already declared
                         as a <Resource> in the csproj, so the pack URI
                         resolves without any build change. Clipped to a
                         rounded square so it matches the pill language of
                         the rest of the top bar. -->
                    <Border Width="36" Height="36"
                            CornerRadius="9"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True"
                            Effect="{StaticResource LogoGlow}">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                        Stretch="UniformToFill"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="PROGLASS"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="AUTOMATION"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,-2,0,0"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                </StackPanel>

                <!-- MODULE badge -->
                <!-- Active-module pill. Restyled to match the date/time and
                     connectivity pills on the right: full 999 radius, tinted
                     translucent background rather than a flat solid block, a
                     hairline border and a leading accent dot. It also shows
                     the CURRENT module instead of the static word "MODULE",
                     which carried no information. -->
                <Border Grid.Column="2"
                        CornerRadius="999"
                        Padding="12,4"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0"
                        Background="{DynamicResource TintIndigoBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True"
                        ToolTip="Active module">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0"
                                 IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding CurrentModuleTitle,
                                       FallbackValue=MODULE,
                                       TargetNullValue=MODULE}"
                                   FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="180"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                </Border>

                <!-- Right: connectivity pill + Settings + About
                     v3.1: Settings button now navigates to Settings module
                     via ShowSettingsCommand (like ShowAboutCommand) -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">

                    <!-- PHASE E: cross-module global search -->
                    <globalSearch:GlobalSearchBar DataContext="{Binding GlobalSearchVM}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"/>

                    <!-- Live date/time (auto-updating every second) -->
                    <Border CornerRadius="999"
                            Padding="12,4"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource MenuHoverBrush}"
                            ToolTip="Current date and time">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <!-- Rule 3: Segoe MDL2 only, never emoji. -->
                            <TextBlock Text="&#xE787;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="{Binding CurrentDateText}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="  ·  " FontSize="11"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="{Binding CurrentTimeText}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>

                    <!-- Internet connectivity pill (live — AI, updates) -->
                    <Border CornerRadius="999"
                            Padding="10,4"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            ToolTip="Internet connection state — AI and updates need internet">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#2210B981"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter Property="Background" Value="#22EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#10B981"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                <Setter Property="Fill" Value="#EF4444"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectivityLabel}"
                                       FontSize="10" FontWeight="Bold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#10B981"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                <Setter Property="Foreground" Value="#EF4444"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- PHASE L: ProGlass Agent chat -->
                    <Button Style="{StaticResource TopBarPillIcon}"
                            Content="&#xE99A;"
                            Command="{Binding ToggleAgentChatCommand}"
                            ToolTip="ProGlass Agent — local assistant you can teach"
                            Margin="0,0,8,0"/>

                    <Button Style="{StaticResource TopBarPillIcon}"
                            Content="&#xE713;"
                            Command="{Binding ShowSettingsCommand}"
                            ToolTip="Settings"
                            Margin="0,0,8,0"/>

                    <Button Style="{StaticResource TopBarPillIcon}"
                            Content="&#xE946;"
                            Command="{Binding ShowAboutCommand}"
                            ToolTip="About"
                            Margin="0,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             MAIN CONTENT AREA
        ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- Framed module container (v3.0 preserved).
                 v2 §9: ModuleWallpaperBrush sits BEHIND the module —
                 set per module by VisualThemeEngine, Transparent when
                 the active module has no wallpaper. -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{StaticResource ModuleFrameBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="12,12,12,12"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Border Background="{DynamicResource ModuleWallpaperBrush}"
                            IsHitTestVisible="False"/>
                    <ContentControl Content="{Binding CurrentViewModel}"/>
                </Grid>
            </Border>

            <!-- Dim overlay — only triggers on IsMenuOpen now
                 (settings is a module, not a drawer, so no IsSettingsOpen trigger) -->
            <Rectangle Fill="Black" Opacity="0.45"
                       MouseLeftButtonDown="DimOverlay_MouseLeftButtonDown">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMenuOpen}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>

            <!-- LEFT DRAWER — NAVIGATION MENU -->
            <Border Width="290"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    CornerRadius="0,16,16,0"
                    Panel.ZIndex="10"
                    Effect="{StaticResource DrawerLeftShadow}"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMenuOpen}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer x:Name="MenuScrollViewer"
                                  Grid.Column="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  IsDeferredScrollingEnabled="False"
                                  PanningMode="VerticalOnly"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                                  ScrollChanged="MenuScrollViewer_ScrollChanged">
                        <StackPanel Margin="0,20,0,20">

                            <TextBlock Text="MAIN"
                                       Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Dashboard" Tag="&#xE80F;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Dashboard"/>

                            <TextBlock Text="INVENTORY"
                                       Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Sheet Store" Tag="&#xE7B8;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="SheetStore"/>

                            <TextBlock Text="SALES"
                                       Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Proforma Invoice" Tag="&#xE8A5;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="ProformaInvoice"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Job Order" Tag="&#xE8C8;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="JobOrder"/>

                            <TextBlock Text="PRODUCTION"
                                       Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Optimization" Tag="&#xE713;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Optimization"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Cutting" Tag="&#xE8C6;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Cutting"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Holes &amp; Cutouts" Tag="&#xE71D;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="HolesCutouts"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Polish" Tag="&#xE895;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Polish"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Edge Deletion" Tag="&#xE774;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="EdgeDeletion"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Mitring" Tag="&#xE7E8;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Mitring"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Tempering" Tag="&#xE728;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Tempering"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Pairing" Tag="&#xE71B;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Pairing"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Doubling / Lamination" Tag="&#xE81C;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="DoublingLamination"/>

                            <TextBlock Text="DISPATCH"
                                       Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Delivery Note" Tag="&#xE7F4;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="DeliveryNote"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Tax Invoice" Tag="&#xE7BF;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="TaxInvoice"/>

                            <TextBlock Text="REPORTS"
                                       Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Sales Report" Tag="&#xE9F9;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="SalesReport"/>

                            <TextBlock Text="MASTER DATA"
                                       Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Company Center" Tag="&#xE822;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="CompanyCenter"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="User Center" Tag="&#xE716;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="UserCenter"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Job Profitability" Tag="&#xE7BF;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="JobProfitability"/>

                            <TextBlock Text="SYSTEM"
                                       Style="{StaticResource SidebarGroupHeaderStyle}"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="System Center" Tag="&#xE713;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="SystemCenter"/>
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Content="Logs &amp; Activity" Tag="&#xE81C;"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Diagnostics"/>

                        </StackPanel>
                    </ScrollViewer>

                    <Slider x:Name="ScrollSlider"
                            Grid.Column="1"
                            Style="{StaticResource GlassyVerticalSliderStyle}"
                            Margin="4,20,10,20"
                            Minimum="0" Maximum="1"
                            SmallChange="0.05" LargeChange="0.15"
                            ValueChanged="ScrollSlider_ValueChanged"/>
                </Grid>
            </Border>

            <!-- v3.1: RIGHT DRAWER (SETTINGS) REMOVED
                 Settings is now a full-screen module. Gear button in top bar
                 navigates to it via ShowSettingsCommand. -->

            <!-- AI CHAT -->
            <viewsAi:AiChatView DataContext="{Binding AiChatVM}"
                                Panel.ZIndex="200"/>

            <!-- ══════════════════════════════════════════════════════════
                 PHASE L — PROGLASS AGENT CHAT
                 A separate surface from the AI assistant above: this one
                 talks to the LOCAL agent, which reads ERP data through
                 permission-gated tools and can be taught new phrases.
                 Collapsed until the user opens it, so it costs nothing.
            ══════════════════════════════════════════════════════════ -->
            <Border Panel.ZIndex="210"
                    Width="520"
                    Margin="0,0,24,24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    MaxHeight="720"
                    CornerRadius="16"
                    ClipToBounds="True"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1.5"
                    Effect="{StaticResource DrawerLeftShadow}"
                    Visibility="{Binding IsAgentChatOpen,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <agentUi:AgentChatView DataContext="{Binding AgentChatVM}"/>
            </Border>
        </Grid>
    </Grid>
</Window>