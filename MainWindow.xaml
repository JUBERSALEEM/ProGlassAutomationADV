<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
        xmlns:vmDashboard="clr-namespace:ProGlassAutomation.ViewModels.Dashboard"
        xmlns:vmProforma="clr-namespace:ProGlassAutomation.ViewModels.ProformaInvoice"
        xmlns:vmAbout="clr-namespace:ProGlassAutomation.ViewModels.About"
        xmlns:vmSheetStore="clr-namespace:ProGlassAutomation.ViewModels.SheetStore"
        xmlns:vmJobOrder="clr-namespace:ProGlassAutomation.ViewModels.JobOrder"
        xmlns:vmOptimization="clr-namespace:ProGlassAutomation.ViewModels.Optimization"
        xmlns:vmProduction="clr-namespace:ProGlassAutomation.ViewModels.Production"
        xmlns:vmDelivery="clr-namespace:ProGlassAutomation.ViewModels.DeliveryNote"
        xmlns:vmTaxInvoice="clr-namespace:ProGlassAutomation.ViewModels.TaxInvoice"
        xmlns:vmReports="clr-namespace:ProGlassAutomation.ViewModels.Reports"
        xmlns:viewsDashboard="clr-namespace:ProGlassAutomation.Views.Dashboard"
        xmlns:viewsProforma="clr-namespace:ProGlassAutomation.Views.ProformaInvoice"
        xmlns:viewsAbout="clr-namespace:ProGlassAutomation.Views.About"
        xmlns:viewsSheetStore="clr-namespace:ProGlassAutomation.Views.SheetStore"
        xmlns:viewsJobOrder="clr-namespace:ProGlassAutomation.Views.JobOrder"
        xmlns:viewsOptimization="clr-namespace:ProGlassAutomation.Views.Optimization"
        xmlns:viewsProduction="clr-namespace:ProGlassAutomation.Views.Production"
        xmlns:viewsDelivery="clr-namespace:ProGlassAutomation.Views.DeliveryNote"
        xmlns:viewsTaxInvoice="clr-namespace:ProGlassAutomation.Views.TaxInvoice"
        xmlns:viewsReports="clr-namespace:ProGlassAutomation.Views.Reports"
        Title="ProGlass Automation"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- ============ ViewModel -> View mappings ============ -->
        <DataTemplate DataType="{x:Type vmDashboard:DashboardViewModel}">
            <viewsDashboard:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProforma:ProformaInvoiceViewModel}">
            <viewsProforma:ProformaInvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmAbout:AboutViewModel}">
            <viewsAbout:AboutView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSheetStore:SheetStoreViewModel}">
            <viewsSheetStore:SheetStoreView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmJobOrder:JobOrderViewModel}">
            <viewsJobOrder:JobOrderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmOptimization:OptimizationViewModel}">
            <viewsOptimization:OptimizationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:CuttingViewModel}">
            <viewsProduction:CuttingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:HolesCutoutsViewModel}">
            <viewsProduction:HolesCutoutsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:PolishViewModel}">
            <viewsProduction:PolishView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:EdgeDeletionViewModel}">
            <viewsProduction:EdgeDeletionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:MitringViewModel}">
            <viewsProduction:MitringView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:TemperingViewModel}">
            <viewsProduction:TemperingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:PairingViewModel}">
            <viewsProduction:PairingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProduction:DoublingLaminationViewModel}">
            <viewsProduction:DoublingLaminationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmDelivery:DeliveryNoteViewModel}">
            <viewsDelivery:DeliveryNoteView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmTaxInvoice:TaxInvoiceViewModel}">
            <viewsTaxInvoice:TaxInvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmReports:SalesReportViewModel}">
            <viewsReports:SalesReportView/>
        </DataTemplate>

        <!-- ============ FLOATING BUTTON ============ -->
        <Style x:Key="FloatingButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="{DynamicResource OverlayButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OverlayButtonForegroundBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="25">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ SIDEBAR ITEM STYLES (NO SHADOWS - FAST) ============ -->
        <Style x:Key="SidebarGroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="22,18,0,8"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <ControlTemplate x:Key="SidebarItemTemplate" TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{TemplateBinding Tag}" FontSize="15"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{TemplateBinding Content}" Margin="14,0,0,0"
                               FontSize="13" FontWeight="Medium"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="SidebarItemStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,2,10,2"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template" Value="{StaticResource SidebarItemTemplate}"/>
        </Style>

        <!-- =========================================================== -->
        <!-- GLASSY VERTICAL SLIDER (SCROLL INDICATOR)                    -->
        <!-- =========================================================== -->

        <!-- Round thumb with gradient dot -->
        <Style x:Key="GlassySliderThumbStyle" TargetType="Thumb">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Width="22" Height="22" Fill="White"/>
                            <Ellipse Width="8" Height="8">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                        <GradientStop Color="#EC4899" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invisible track buttons -->
        <Style x:Key="InvisibleRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VERTICAL glassy slider -->
        <Style x:Key="GlassyVerticalSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">

                            <!-- Track pill background -->
                            <Border Width="14"
                                    CornerRadius="7"
                                    Background="{DynamicResource MenuHoverBrush}"
                                    Opacity="0.6"/>

                            <!-- Progress fill (top -> thumb position) with gradient -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Width="14"
                                        CornerRadius="7,7,0,0"
                                        Height="{Binding ElementName=PART_Track, Path=Thumb.ActualHeight, FallbackValue=22}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#8B5CF6" Offset="0"/>
                                            <GradientStop Color="#EC4899" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <!-- Real track with thumb -->
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleRepeatButton}"
                                                  Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource GlassySliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleRepeatButton}"
                                                  Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Current module -->
        <ContentControl Content="{Binding CurrentViewModel}"/>

        <!-- Dim overlay -->
        <Rectangle Fill="Black" Opacity="0.4"
                   MouseLeftButtonDown="DimOverlay_MouseLeftButtonDown">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>

        <!-- ============ LEFT DRAWER (GROUPED MENU) — NO SHADOW FOR PERFORMANCE ============ -->
        <Border Width="290"
                HorizontalAlignment="Left"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                CornerRadius="0,18,18,0"
                Panel.ZIndex="10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <!-- Two columns: menu (scrollable) + slider (right edge) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Scrollable menu (native scrollbar hidden) -->
                <ScrollViewer x:Name="MenuScrollViewer"
                              Grid.Column="0"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              ScrollChanged="MenuScrollViewer_ScrollChanged">
                    <StackPanel Margin="0,80,0,20">

                        <!-- MAIN -->
                        <TextBlock Text="MAIN" Style="{StaticResource SidebarGroupHeaderStyle}"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Dashboard" Tag="&#128200;"
                                Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>

                        <!-- INVENTORY -->
                        <TextBlock Text="INVENTORY" Style="{StaticResource SidebarGroupHeaderStyle}"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Sheet Store" Tag="&#128230;"
                                Command="{Binding NavigateCommand}" CommandParameter="SheetStore"/>

                        <!-- SALES & REPORTS -->
                        <TextBlock Text="SALES &amp; REPORTS" Style="{StaticResource SidebarGroupHeaderStyle}"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Proforma Invoice" Tag="&#128221;"
                                Command="{Binding NavigateCommand}" CommandParameter="ProformaInvoice"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Job Order" Tag="&#128203;"
                                Command="{Binding NavigateCommand}" CommandParameter="JobOrder"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Optimization" Tag="&#9881;"
                                Command="{Binding NavigateCommand}" CommandParameter="Optimization"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Sales Report" Tag="&#128202;"
                                Command="{Binding NavigateCommand}" CommandParameter="SalesReport"/>

                        <!-- PRODUCTION (raw glass processing) -->
                        <TextBlock Text="PRODUCTION" Style="{StaticResource SidebarGroupHeaderStyle}"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Cutting" Tag="&#9986;"
                                Command="{Binding NavigateCommand}" CommandParameter="Cutting"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Holes &amp; Cutouts" Tag="&#128371;"
                                Command="{Binding NavigateCommand}" CommandParameter="HolesCutouts"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Polish" Tag="&#10024;"
                                Command="{Binding NavigateCommand}" CommandParameter="Polish"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Edge Deletion" Tag="&#128208;"
                                Command="{Binding NavigateCommand}" CommandParameter="EdgeDeletion"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Mitring" Tag="&#128314;"
                                Command="{Binding NavigateCommand}" CommandParameter="Mitring"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Tempering" Tag="&#128293;"
                                Command="{Binding NavigateCommand}" CommandParameter="Tempering"/>

                        <!-- DISPATCH (assembly + delivery pipeline) -->
                        <TextBlock Text="DISPATCH" Style="{StaticResource SidebarGroupHeaderStyle}"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Pairing" Tag="&#128279;"
                                Command="{Binding NavigateCommand}" CommandParameter="Pairing"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Doubling / Lamination" Tag="&#128218;"
                                Command="{Binding NavigateCommand}" CommandParameter="DoublingLamination"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Delivery Note" Tag="&#128666;"
                                Command="{Binding NavigateCommand}" CommandParameter="DeliveryNote"/>
                        <Button Style="{StaticResource SidebarItemStyle}" Content="Tax Invoice" Tag="&#129534;"
                                Command="{Binding NavigateCommand}" CommandParameter="TaxInvoice"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- Vertical glassy slider (right edge, full height) -->
                <Slider x:Name="ScrollSlider"
                        Grid.Column="1"
                        Style="{StaticResource GlassyVerticalSliderStyle}"
                        Margin="4,80,10,20"
                        Minimum="0"
                        Maximum="1"
                        SmallChange="0.05"
                        LargeChange="0.15"
                        ValueChanged="ScrollSlider_ValueChanged"/>
            </Grid>
        </Border>

        <!-- ============ RIGHT DRAWER (SETTINGS) ============ -->
        <Border Width="300"
                HorizontalAlignment="Right"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                Panel.ZIndex="10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Margin="20,80,20,0">
                <TextBlock Text="SETTINGS" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,0,0,20"/>
                <DockPanel Margin="0,0,0,15">
                    <TextBlock Text="Dark Mode" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <ToggleButton HorizontalAlignment="Right"
                                  IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                  Width="50" Height="24" Cursor="Hand"/>
                </DockPanel>
                <Separator Margin="0,10"/>
                <Button Content="Close Settings" Height="40" Margin="0,10,0,0"
                        Background="{DynamicResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Command="{Binding ToggleSettingsCommand}"/>
            </StackPanel>
        </Border>

        <!-- Hamburger -->
        <Button Style="{StaticResource FloatingButtonStyle}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="15" Content="&#9776;"
                Command="{Binding ToggleMenuCommand}"
                ToolTip="Menu" Panel.ZIndex="100"/>

        <!-- Logo + Info -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="15" Panel.ZIndex="100">
            <Button Style="{StaticResource FloatingButtonStyle}"
                    Width="90" Content="ProGlass" FontSize="13"
                    Command="{Binding ToggleSettingsCommand}"
                    ToolTip="Settings" Margin="0,0,10,0"/>
            <Button Style="{StaticResource FloatingButtonStyle}"
                    Content="&#8505;" FontSize="24"
                    Command="{Binding ShowAboutCommand}"
                    ToolTip="About"/>
        </StackPanel>
    </Grid>
</Window>