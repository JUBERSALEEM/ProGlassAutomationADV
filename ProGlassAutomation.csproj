<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>favicon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="QuestPDF" Version="2024.12.2" />
		<PackageReference Include="PdfSharp-WPF" Version="6.1.1" />
		<PackageReference Include="SkiaSharp" Version="2.88.8" />
		<PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.8" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Microsoft.VisualBasic" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="favicon.ico" />
	</ItemGroup>

	<!-- ═══════════════════════════════════════════════════════════
	     Phase 8.3 — Explicit registration for Controls folder
	═══════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<Page Update="Controls\**\*.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Controls\**\*.xaml.cs">
			<DependentUpon>%(Filename)</DependentUpon>
			<SubType>Code</SubType>
		</Compile>
	</ItemGroup>

	<!-- Themes/Styles folder -->
	<ItemGroup>
		<Page Update="Themes\Styles\**\*.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Themes\Styles\**\*.xaml.cs">
			<DependentUpon>%(Filename)</DependentUpon>
			<SubType>Code</SubType>
		</Compile>
	</ItemGroup>

	<!-- ═══════════════════════════════════════════════════════════
	     Chat 16 — Sales Report + Statement List
	═══════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<Page Update="Views\Reports\SalesReportView.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Views\Reports\SalesReportView.xaml.cs">
			<DependentUpon>SalesReportView.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>

		<Page Update="Views\Reports\StatementList\StatementListView.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Views\Reports\StatementList\StatementListView.xaml.cs">
			<DependentUpon>StatementListView.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>

		<Page Update="Views\Dashboard\Statement\StDashboardView.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Views\Dashboard\Statement\StDashboardView.xaml.cs">
			<DependentUpon>StDashboardView.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>
	</ItemGroup>

	<!-- ═══════════════════════════════════════════════════════════
	     Chat 21 v3 — Statement Generator WIZARD (4 steps)
	     
	     Folder structure:
	       Views/Reports/StatementGenerator/
	         Shell/     → Wizard shell (composition root)
	         Filter/    → Step 1: Configure filters
	         Preview/   → Step 2: Select invoices
	         Pipeline/  → Step 3: Execute pipeline (live)
	         Review/    → Step 4: Review & download PDF
	         Styles/    → Wizard-specific shared styles
	     
	     DELETED in v3:
	       Hero/ folder (marketing content, no place in ERP)
	       *Section.xaml files (renamed to *Step.xaml)
	       StatementGeneratorStyles.xaml (renamed to WizardStyles.xaml)
	═══════════════════════════════════════════════════════════ -->
	<ItemGroup>

		<!-- Shell (wizard composition root) -->
		<Page Update="Views\Reports\StatementGenerator\Shell\StatementGeneratorView.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Views\Reports\StatementGenerator\Shell\StatementGeneratorView.xaml.cs">
			<DependentUpon>StatementGeneratorView.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>

		<!-- Step 1: Filter -->
		<Page Update="Views\Reports\StatementGenerator\Filter\FilterStep.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Views\Reports\StatementGenerator\Filter\FilterStep.xaml.cs">
			<DependentUpon>FilterStep.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>

		<!-- Step 2: Preview -->
		<Page Update="Views\Reports\StatementGenerator\Preview\PreviewStep.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Views\Reports\StatementGenerator\Preview\PreviewStep.xaml.cs">
			<DependentUpon>PreviewStep.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>

		<!-- Step 3: Execute (Pipeline) -->
		<Page Update="Views\Reports\StatementGenerator\Pipeline\ExecuteStep.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Views\Reports\StatementGenerator\Pipeline\ExecuteStep.xaml.cs">
			<DependentUpon>ExecuteStep.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>

		<!-- Step 4: Review -->
		<Page Update="Views\Reports\StatementGenerator\Review\ReviewStep.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Views\Reports\StatementGenerator\Review\ReviewStep.xaml.cs">
			<DependentUpon>ReviewStep.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>

		<!-- Shared wizard styles resource dictionary -->
		<Page Update="Views\Reports\StatementGenerator\Styles\WizardStyles.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>

	</ItemGroup>

</Project>