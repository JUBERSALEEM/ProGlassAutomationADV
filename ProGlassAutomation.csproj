<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>favicon.ico</ApplicationIcon>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- Non-blocking warnings: nullable analysis (CS86xx/CS876x), obsolete members (CS0618),
		     fire-and-forget (CS4014), unused fields (CS0414/CS0649), and NuGet/analyzer noise.
		     These stay visible as warnings but never fail the build. -->
		<WarningsNotAsErrors>CS0618;CS0414;CS0649;CS4014;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8619;CS8620;CS8621;CS8622;CS8625;CS8629;CS8632;CS8765;CS8766;CS8767;CS8768;IDE0059;NU1603;NU1605;NU1701;CA1515;CA1305;CA1307;CA1310;CA1311</WarningsNotAsErrors>
		<NoWarn>$(NoWarn);NU1603;NU1605;CA1515;CA1305</NoWarn>
		<RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<Deterministic>true</Deterministic>

		<!-- ── ONE authoritative version source (OTA spec §5) ────────
		     About / Settings / update checker / installer / releases all
		     read this via AppInfo (assembly identity). Bump HERE only:
		     MAJOR.MINOR.PATCH  →  2.0.0 → 2.0.1 → 2.1.0 ...

		     RC-014 (2026-09-20): this sat at 2.0.1 from d6fb00e7
		     (2026-09-10) through 6c7224f1 and e32f0caf (2026-09-19).
		     UpdateService.IsNewer is a STRICT greater-than compare, so
		     every one of those behaviour-changing builds was
		     indistinguishable to OTA and to About — a machine on an
		     older 2.0.1 was never offered the fix, and no log excerpt
		     could say which 2.0.1 produced it. Bump the PATCH digit on
		     every behavioural fix; that is what makes the update
		     reachable and the build identifiable.          -->
		<Version>2.0.2</Version>
		<AssemblyVersion>2.0.2.0</AssemblyVersion>
		<FileVersion>2.0.2.0</FileVersion>
	</PropertyGroup>

	<!-- ══════════════════════════════════════════════════════════════
	     CS0029 hardening — explicit System.Threading.Tasks import.

	     The previous build broke with four CS0029 errors at the
	     right-click per-stage navigation lambdas in MainViewModel
	     (Task → InquiryListRow). ImplicitUsings normally injects
	     System.Threading.Tasks for net8.0-windows SDK-style projects,
	     but the IDE IntelliSense / Roslyn incremental parser can lose
	     the implicit using during partial edits. The explicit
	     <Using> below guarantees the namespace is in scope in every
	     .cs file regardless of IDE state. Combined with the
	     fully-qualified System.Threading.Tasks.Task references in
	     the affected lambdas, the build is robust.
	══════════════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<Using Include="System.Threading.Tasks" />
	</ItemGroup>

	<!-- ═══════════════════════════════════════════════════════════════
	     VELOPACK MAIN — App.xaml is treated as a Page, not the
	     implicit WPF ApplicationDefinition, so we can supply our own
	     [STAThread] static Main() (see App.xaml.cs) that calls
	     VelopackApp.Build().Run() as the very first line. WPF then
	     boots the same way it would from the auto-generated entry
	     point: InitializeComponent() loads the merged dictionaries
	     and wires the Startup="Application_Startup" handler; Run()
	     starts the dispatcher.

	     Without this, the SDK auto-generates a Main() that calls
	     App.Run() and the Velopack hook has to live inside the
	     WPF Startup handler — which vpk logs as a warning
	     ("VelopackApp.Run() was found in method
	     StartupCoreAsync.MoveNext(), which does not look like
	     your application's entry point"). Moving the hook to
	     Main() silences the warning and lets Velopack's
	     install / update / uninstall fast-exit hooks terminate
	     the process before any WPF / DB / DI cost is paid.
	══════════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<ApplicationDefinition Remove="App.xaml" />
		<Page Include="App.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
	</ItemGroup>

	<!-- ══════════════════════════════════════════════════════════════
	     PHASE P — keep the test project out of the app project.

	     The app project lives at the repository ROOT, so SDK-style default
	     globbing would otherwise compile Tests/**/*.cs into the
	     application itself. That would drag xUnit into the shipped binary
	     and create a circular reference, because the test project already
	     references this one.
	══════════════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<Compile Remove="Tests/**" />
		<None Remove="Tests/**" />
		<Page Remove="Tests/**" />
		<Resource Remove="Tests/**" />
		<!--
		  The licensing contract lives under Licensing/ as its OWN project
		  (ProGlass.Licensing.csproj). SDK-style default globbing would
		  otherwise compile Licensing/Contracts/*.cs and the xUnit test file
		  directly into the app — dragging xUnit in and breaking the build
		  with CS0246. The app references ProGlass.Licensing as a library
		  (see the ProjectReference above); it never recompiles its sources.
		-->
		<Compile Remove="Licensing/**" />
		<None Remove="Licensing/**" />
		<Page Remove="Licensing/**" />
		<Resource Remove="Licensing/**" />
		<!--
		  PHASE L — keep the developer-only tool out of the
		  app project.

		  The license generator lives under Tools/ and is a
		  separate console executable. If SDK-style default
		  globbing pulled Tools\**\*.cs into the app
		  project, we'd get CS5001 (multiple entry points)
		  and CS0234 (Program type already defined) on
		  every build of the shipped app.
		-->
		<Compile Remove="Tools/**" />
		<None Remove="Tools/**" />
		<Page Remove="Tools/**" />
		<Resource Remove="Tools/**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NAudio" Version="2.2.1" />
		<!-- QuestPDF 2025.12.4 (upgraded from 2024.12.2): pulls in the
		     2025.1.3 Table layout fix, the 2025.4.0 redesigned Column
		     implementation + small-maxWidth text-measuring fix, and the
		     2025.12 layout-debugging improvements — the three areas that
		     produce the "conflicting size constraints" DocumentLayoutException
		     on tall/narrow table layouts. -->
		<PackageReference Include="QuestPDF" Version="2025.12.4" />
		<PackageReference Include="PdfSharp-WPF" Version="6.1.1" />
		<PackageReference Include="SkiaSharp" Version="2.88.8" />
		<PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.8" />
		<!-- Windows DPAPI (ProtectedData) — used by Services/Security/SecretVault
		     to keep API keys out of plain-text config files. -->
		<PackageReference Include="System.Management" Version="8.0.0" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
		<PackageReference Include="System.Speech" Version="8.0.0" />

		<!--
		     ═══════════════════════════════════════════════════════════
		     WHISPER.NET — Local neural Speech-to-Text (offline)

		     PACKAGE NAME CORRECTION vs previous versions:
		       WRONG (does not exist on NuGet):
		         Whisper.net.Runtime.Cpu  ← NU1101 error
		       CORRECT for Whisper.net 1.7.x:
		         Whisper.net.Runtime      ← bundled native runtimes

		     Whisper.net         — managed C# API wrapper
		     Whisper.net.Runtime — native GGML inference engine
		                          (CPU + GPU auto-select, Windows x64)
		                          Without this, WhisperFactory throws
		                          DllNotFoundException at runtime.

		     Both packages MUST be the same version.
		     ═══════════════════════════════════════════════════════════
		-->
		<PackageReference Include="LLamaSharp" Version="0.22.0" />
		<!-- CPU-only backend: no GPU driver requirements (factory PCs ship
		     stock Intel graphics). Native binaries are bundled by the
		     backend package and unpacked next to the app automatically. -->
		<PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.22.0" />
		<PackageReference Include="Whisper.net" Version="1.7.4" />
		<PackageReference Include="Velopack" Version="1.2.0" />
		<PackageReference Include="Whisper.net.Runtime" Version="1.7.4" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />

	</ItemGroup>

	<ItemGroup>
		<Resource Include="favicon.ico" />
		<!-- Windows-native separators: the XAML DESIGNER indexes resources
		     conservatively and has reported XDG0003 for forward-slash paths
		     even though runtime packing accepts them (2026-09-05).
		     Single Resource entry only — duplicate entries with different
		     LogicalName cause RG1000 'same key already added' in WinFX.targets.
		     The SDK lower-cases the logical name to resources/... internally,
		     so both /Resources/... and /resources/... pack URIs resolve. -->
		<Resource Include="Resources\proglass_icon_256.png" />
		<Resource Include="Resources\Glass3D\sgu-3d.png" />
		<Resource Include="Resources\Glass3D\dgu-3d.png" />
		<Resource Include="Resources\Glass3D\lam-3d.png" />
		<Resource Include="Resources\Glass3D\dgulam-3d.png" />
	</ItemGroup>

	<!-- Fallback on-disk copy for AppIconResource disk fallback path.
	     If Resource packing ever fails (e.g., SDK globbing on Linux),
	     the PNG still exists next to the exe and the app shows the icon
	     instead of crashing. -->
	<ItemGroup>
		<Content Include="Resources\proglass_icon_256.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!--
	  The permanent licensing contract. ProGlassAutomation verifies
	  .proglasslicense files through ProGlass.Licensing. This is the ONLY
	  place license format/signature logic lives; the app NEVER re-implements
	  signing/verification and NEVER contains a private signing key.
	  The LicenseGenerator (a separate project) signs against the SAME
	  library; the two do not reference each other.
	-->
	<ItemGroup>
		<ProjectReference Include="Licensing\ProGlass.Licensing.csproj" />
	</ItemGroup>

