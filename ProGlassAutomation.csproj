<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>favicon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="QuestPDF" Version="2024.12.2" />
		<PackageReference Include="PdfSharp-WPF" Version="6.1.1" />
		<PackageReference Include="SkiaSharp" Version="2.88.8" />
		<PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.8" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Microsoft.VisualBasic" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="favicon.ico" />
	</ItemGroup>

	<!-- ═══════════════════════════════════════════════════════════
	     Phase 8.3 — Explicit registration for Controls folder
	     Uses Update (not Include) — SDK already auto-includes.
	     Update only sets build properties on already-included files.
	═══════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<Page Update="Controls\**\*.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Controls\**\*.xaml.cs">
			<DependentUpon>%(Filename)</DependentUpon>
			<SubType>Code</SubType>
		</Compile>
	</ItemGroup>

	<!-- Themes/Styles folder -->
	<ItemGroup>
		<Page Update="Themes\Styles\**\*.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Themes\Styles\**\*.xaml.cs">
			<DependentUpon>%(Filename)</DependentUpon>
			<SubType>Code</SubType>
		</Compile>
	</ItemGroup>

	<!-- ═══════════════════════════════════════════════════════════
	     Chat 16 — Set build properties on new Chat 16 XAML files.
	     Uses Update (not Include) — SDK auto-includes all .xaml
	     and .cs files in project directory by default.
	     Update ensures correct Generator + DependentUpon linkage
	     so XAML designer recognizes the code-behind correctly.
	═══════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<Page Update="Views\Reports\SalesReportView.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Views\Reports\SalesReportView.xaml.cs">
			<DependentUpon>SalesReportView.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>

		<Page Update="Views\Reports\StatementList\StatementListView.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Views\Reports\StatementList\StatementListView.xaml.cs">
			<DependentUpon>StatementListView.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>

		<Page Update="Views\Reports\StatementGenerator\StatementGeneratorView.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Views\Reports\StatementGenerator\StatementGeneratorView.xaml.cs">
			<DependentUpon>StatementGeneratorView.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>

		<Page Update="Views\Dashboard\Statement\StDashboardView.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Views\Dashboard\Statement\StDashboardView.xaml.cs">
			<DependentUpon>StDashboardView.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>
	</ItemGroup>

</Project>