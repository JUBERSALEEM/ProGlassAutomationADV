<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>favicon.ico</ApplicationIcon>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsNotAsErrors>CS8618;CS8625;IDE0059;CS8601;CS8602;CS8604;NU1603;NU1605;NU1701;CA1515;CA1305;CA1307;CA1310;CA1311</WarningsNotAsErrors>
		<NoWarn>$(NoWarn);NU1603;NU1605;CA1515;CA1305</NoWarn>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>
		<RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<Deterministic>true</Deterministic>

		<!-- ── ONE authoritative version source (OTA spec §5) ────────
		     About / Settings / update checker / installer / releases all
		     read this via AppInfo (assembly identity). Bump HERE only:
		     MAJOR.MINOR.PATCH  →  2.0.0 → 2.0.1 → 2.1.0 ...          -->
		<Version>2.0.0</Version>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
	</PropertyGroup>

	<!-- ══════════════════════════════════════════════════════════════
	     PHASE P — keep the test project out of the app project.

	     The app project lives at the repository ROOT, so SDK-style default
	     globbing would otherwise compile Tests/**/*.cs into the
	     application itself. That would drag xUnit into the shipped binary
	     and create a circular reference, because the test project already
	     references this one.
	══════════════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<Compile Remove="Tests/**" />
		<None Remove="Tests/**" />
		<Page Remove="Tests/**" />
		<Resource Remove="Tests/**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="QuestPDF" Version="2024.12.2" />
		<PackageReference Include="PdfSharp-WPF" Version="6.1.1" />
		<PackageReference Include="SkiaSharp" Version="2.88.8" />
		<PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.8" />
		<!-- Windows DPAPI (ProtectedData) — used by Services/Security/SecretVault
		     to keep API keys out of plain-text config files. -->
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
		<PackageReference Include="System.Speech" Version="8.0.0" />

		<!--
		     ═══════════════════════════════════════════════════════════
		     WHISPER.NET — Local neural Speech-to-Text (offline)

		     PACKAGE NAME CORRECTION vs previous versions:
		       WRONG (does not exist on NuGet):
		         Whisper.net.Runtime.Cpu  ← NU1101 error
		       CORRECT for Whisper.net 1.7.x:
		         Whisper.net.Runtime      ← bundled native runtimes

		     Whisper.net         — managed C# API wrapper
		     Whisper.net.Runtime — native GGML inference engine
		                          (CPU + GPU auto-select, Windows x64)
		                          Without this, WhisperFactory throws
		                          DllNotFoundException at runtime.

		     Both packages MUST be the same version.
		     ═══════════════════════════════════════════════════════════
		-->
		<PackageReference Include="Whisper.net" Version="1.7.4" />
		<PackageReference Include="Velopack" Version="1.2.0" />
		<PackageReference Include="Whisper.net.Runtime" Version="1.7.4" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />

	</ItemGroup>

	<ItemGroup>
		<Reference Include="Microsoft.VisualBasic" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="favicon.ico" />
		<Resource Include="Resources/proglass_icon_256.png" />
		<Resource Include="Resources/Glass3D/sgu-3d.png" />
		<Resource Include="Resources/Glass3D/dgu-3d.png" />
		<Resource Include="Resources/Glass3D/lam-3d.png" />
		<Resource Include="Resources/Glass3D/dgulam-3d.png" />
	</ItemGroup>

	<!-- ═══════════════════════════════════════════════════════════════
	     Phase 8.3 — Explicit registration for Controls folder
	═══════════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<Page Update="Controls\**\*.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Controls\**\*.xaml.cs">
			<DependentUpon>%(Filename)</DependentUpon>
			<SubType>Code</SubType>
		</Compile>
	</ItemGroup>

